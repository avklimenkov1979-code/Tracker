	Имена = Новый Соответствие;
	Имена.Вставить("Организации", "Организация");
	Имена.Вставить("Контрагенты", "Контрагент");
	Имена.Вставить("Партнеры", "Партнёр");
	Имена.Вставить("ФизическиеЛица", "Человек");
	Имена.Вставить("Сотрудники", "Человек");
	Имена.Вставить("КонтактныеЛицаПартнеров", "Человек");
	Имена.Вставить("Пользователи", "Пользователь");
	Имена.Вставить("Номенклатура", "Номенклатура");
	Имена.Вставить("ХарактеристикиНоменклатуры", "Характеристика");
	Имена.Вставить("ДоговорыКонтрагентов", "Договор");
	Имена.Вставить("НаправленияДеятельности", "Контракт");
	Имена.Вставить("БанковскиеСчетаОрганизаций", "Счёт");
	Имена.Вставить("БанковскиеСчетаКонтрагентов", "Счёт");
	Имена.Вставить("Кассы", "Касса");
	Имена.Вставить("Склады", "Склад");
	Имена.Вставить("СтруктураПредприятия", "Подразделение");
	Имена.Вставить("ПодразделенияОрганизаций", "Подразделение");
	Имена.Вставить("КлассификаторБанков", "Банк");
	Имена.Вставить("СтатьиКалькуляции", "Статья калькуляции");
	Имена.Вставить("СтатьиРасходов", "Статья расходов");
	Имена.Вставить("СтатьиДвиженияДенежныхСредств", "Статья ДДС");
	Имена.Вставить("ДоговорыКредитовИДепозитов", "Договор кредита");
	Вид = Имена[МетаЗначения.Имя];
	Возврат ?(Вид = Неопределено, МетаЗначения.Имя, Вид);

КонецФункции

// Последний фильтр перед сохранением файла для чата.
{D}
Функция ОбезлТекст(Знач Текст, Контекст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Замены = Новый ТаблицаЗначений;
	Замены.Колонки.Добавить("Что", Новый ОписаниеТипов("Строка"));
	Замены.Колонки.Добавить("НаЧто", Новый ОписаниеТипов("Строка"));
	Замены.Колонки.Добавить("Длина", Новый ОписаниеТипов("Число"));

	// слова текста — чтобы быстро отбросить названия, которых в тексте точно нет
	Разделители = " ,.;:()[]{}«»""'|/\!?=+*<>" + Символы.ПС + Символы.ВК + Символы.Таб + Символы.НПП;
	Слова = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(НРег(Текст), Разделители, Ложь) Цикл
		Слова.Вставить(Слово, Истина);
	КонецЦикла;

	// 1. названия и реквизиты объектов
	Для Каждого ИмяСправочника Из СтрРазделить("Организации,Контрагенты,Партнеры,ФизическиеЛица,Сотрудники,КонтактныеЛицаПартнеров,Пользователи,"
		+ "Номенклатура,ХарактеристикиНоменклатуры,ДоговорыКонтрагентов,НаправленияДеятельности,БанковскиеСчетаОрганизаций,"
		+ "БанковскиеСчетаКонтрагентов,Кассы,Склады,СтруктураПредприятия,ПодразделенияОрганизаций,КлассификаторБанков,ДоговорыКредитовИДепозитов", ",") Цикл
		МетаСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
		Если МетаСправочника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поля = Новый Массив;
		Поля.Добавить("Наименование");
		Для Каждого ИмяРеквизита Из СтрРазделить("НаименованиеПолное,НаименованиеСокращенное,ИНН,КПП,ОГРН,НомерСчета,Артикул,КодПоОКПО,Фамилия", ",") Цикл
			МетаРеквизита = МетаСправочника.Реквизиты.Найти(ИмяРеквизита);
			Если МетаРеквизита <> Неопределено И МетаРеквизита.Тип.СодержитТип(Тип("Строка")) Тогда
				Поля.Добавить(ИмяРеквизита);
			КонецЕсли;
		КонецЦикла;
		ТекстПолей = "";
		Для Каждого ИмяПоля Из Поля Цикл
			ТекстПолей = ТекстПолей + ", Т." + ИмяПоля + " КАК " + ИмяПоля;
		КонецЦикла;
		Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка" + ТекстПолей + " ИЗ Справочник." + ИмяСправочника + " КАК Т");
		Попытка
			Таблица = Запрос.Выполнить().Выгрузить();
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Для Каждого ИмяПоля Из Поля Цикл
				Значение = СокрЛП(СтрокаТаблицы[ИмяПоля]);
				Если СтрДлина(Значение) < 4 Тогда
					Продолжить;
				КонецЕсли;
				ЧастиИмени = СтрРазделить(НРег(Значение), Разделители, Ложь);
				Если ЧастиИмени.Количество() = 0 ИЛИ Слова[ЧастиИмени[0]] = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если СтрНайти(Текст, Значение) = 0 Тогда
					Продолжить;
				КонецЕсли;
				Замена = Замены.Добавить();
				Замена.Что = Значение;
				Замена.НаЧто = ОбезлКод(СтрокаТаблицы.Ссылка, Контекст);
				Замена.Длина = СтрДлина(Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// 2. пользователи 1С, компьютер, сервер и база
	ИменаЛюдей = Новый Массив;
	ИменаЛюдей.Добавить(ИмяПользователя());
	ИменаЛюдей.Добавить(ПолноеИмяПользователя());
	Попытка
		Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			ИменаЛюдей.Добавить(ПользовательИБ.Имя);
			ИменаЛюдей.Добавить(ПользовательИБ.ПолноеИмя);
		КонецЦикла;
	Исключение
		// без прав администратора список пользователей недоступен — заменяем хотя бы текущего
		ИменаЛюдей.Добавить(ИмяПользователя());
	КонецПопытки;
	Для Каждого ИмяЧеловека Из ИменаЛюдей Цикл
		Если СтрДлина(СокрЛП(ИмяЧеловека)) >= 3 И СтрНайти(Текст, СокрЛП(ИмяЧеловека)) > 0 Тогда
			Замена = Замены.Добавить();
			Замена.Что = СокрЛП(ИмяЧеловека);
			Замена.НаЧто = "Пользователь-" + ОбезлХеш("Пользователь" + Замена.Что, Контекст);
			Замена.Длина = СтрДлина(Замена.Что);
		КонецЕсли;
	КонецЦикла;
	Служебные = Новый Массив;
	Попытка
		Служебные.Добавить(ИмяКомпьютера());
	Исключение
		Служебные.Добавить("");
	КонецПопытки;
	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 Тогда
			Служебные.Добавить(СтрЗаменить(Сред(Часть, Позиция + 1), """", ""));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Значение Из Служебные Цикл
		Если СтрДлина(СокрЛП(Значение)) >= 3 И СтрНайти(Текст, СокрЛП(Значение)) > 0 Тогда
			Замена = Замены.Добавить();
			Замена.Что = СокрЛП(Значение);
			Замена.НаЧто = "[скрыто]";
			Замена.Длина = СтрДлина(Замена.Что);
		КонецЕсли;
	КонецЦикла;

	Замены.Сортировать("Длина Убыв");
	Для Каждого Замена Из Замены Цикл
		Текст = СтрЗаменить(Текст, Замена.Что, Замена.НаЧто);
	КонецЦикла;
	Текст = ОбезлЦифры(Текст);
	Текст = ОбезлПочта(Текст);
	Возврат Текст;

КонецФункции

// 9 и более цифр подряд -> звёздочки той же длины.
{D}
Функция ОбезлЦифры(Текст)

	Цифры = "0123456789";
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Начало = 1;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Если СтрНайти(Цифры, Сред(Текст, Позиция, 1)) = 0 Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Конец = Позиция;
		Пока Конец <= Длина И СтрНайти(Цифры, Сред(Текст, Конец, 1)) > 0 Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Если Конец - Позиция >= 9 Тогда
			Части.Добавить(Сред(Текст, Начало, Позиция - Начало));
			Звезды = "";
			Для Н = 1 По Конец - Позиция Цикл
				Звезды = Звезды + "*";
			КонецЦикла;
			Части.Добавить(Звезды);
			Начало = Конец;
		КонецЕсли;
		Позиция = Конец;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Начало));
	Возврат СтрСоединить(Части, "");

КонецФункции

{D}
Функция ОбезлПочта(Текст)

	Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-+";
	Позиция = СтрНайти(Текст, "@");
	Пока Позиция > 0 Цикл
		Левая = Позиция;
		Пока Левая > 1 И СтрНайти(Допустимые, Сред(Текст, Левая - 1, 1)) > 0 Цикл
			Левая = Левая - 1;
		КонецЦикла;
		Правая = Позиция;
		Пока Правая < СтрДлина(Текст) И СтрНайти(Допустимые, Сред(Текст, Правая + 1, 1)) > 0 Цикл
			Правая = Правая + 1;
		КонецЦикла;
		Если Левая < Позиция И Правая > Позиция Тогда
			Текст = Лев(Текст, Левая - 1) + "[e-mail]" + Сред(Текст, Правая + 1);
			Следующая = Левая + 8;
		Иначе
			Следующая = Позиция + 1;
		КонецЕсли;
		Позиция = ?(Следующая > СтрДлина(Текст), 0, СтрНайти(Текст, "@", НаправлениеПоиска.СНачала, Следующая));
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Сохранить новые коды в словарь этого пользователя (для кнопки «Расшифровать код»).
{D}
Процедура ОбезлСохранитьСловарь(Контекст)

	Если Контекст.Словарь.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Словарь = ХранилищеОбщихНастроек.Загрузить("ОбезличиваниеДляЧата", "Словарь");
		Если ТипЗнч(Словарь) <> Тип("Соответствие") Тогда
			Словарь = Новый Соответствие;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Контекст.Словарь Цикл
			Словарь.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		ХранилищеОбщихНастроек.Сохранить("ОбезличиваниеДляЧата", "Словарь", Словарь);
	Исключение
		// не критично: файл уже обезличен, не получится только расшифровка
		Контекст.Словарь.Очистить();
	КонецПопытки;

КонецПроцедуры

// Весь путь для файла в чат: обезличить и запомнить коды.
{D}
Функция ОбезличитьДляЧата(Текст){E}

	Контекст = ОбезлКонтекст();
	Результат = ОбезлТекст(Текст, Контекст);
	ОбезлСохранитьСловарь(Контекст);
	Возврат "ОБЕЗЛИЧЕНО: названия заменены кодами, длинные номера скрыты. Расшифровка кодов — только в вашей базе (кнопка «Расшифровать код»)."
		+ Символы.ПС + Результат;

КонецФункции

// Что скрывается за кодом из ответа в чате. Работает только в той базе и у того пользователя, где сделан файл.
{D}
Функция ОбезлРасшифровать(Знач Код){E}

	Код = СокрЛП(Код);
	Если ПустаяСтрока(Код) Тогда
		Возврат "Введите код, например «Контрагент-3fa91c».";
	КонецЕсли;
	Словарь = Неопределено;
	Попытка
		Словарь = ХранилищеОбщихНастроек.Загрузить("ОбезличиваниеДляЧата", "Словарь");
	Исключение
		Словарь = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Словарь) <> Тип("Соответствие") Тогда
		Возврат "Словарь кодов пуст: в этой базе этим пользователем файлы для чата ещё не сохранялись.";
	КонецЕсли;
	Значение = Словарь[Код];
	Если Значение = Неопределено Тогда
		Для Каждого КлючИЗначение Из Словарь Цикл
			Если НРег(КлючИЗначение.Ключ) = НРег(Код) Тогда
				Значение = КлючИЗначение.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "Код «" + Код + "» не найден. Коды «Пользователь-…» не расшифровываются; остальные — только в той базе и у того пользователя, где сохранён файл.";
	КонецЕсли;
	Попытка
		Возврат Код + " = " + Строка(Значение) + " (" + Значение.Метаданные().Синоним + ")";
	Исключение
		Возврат Код + " = " + Строка(Значение);
	КонецПопытки;

КонецФункции

#КонецОбласти
