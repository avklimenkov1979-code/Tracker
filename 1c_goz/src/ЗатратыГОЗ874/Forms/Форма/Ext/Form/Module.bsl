	Возврат "1.2 от 25.11.2026";

КонецФункции

&НаКлиенте
Процедура ЗапомнитьОшибку(Где, Инфо)

	Запись = "[" + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + Где + ":" + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо);
	ЭтотОбъект.ЖурналОшибок = ?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), Запись, ЭтотОбъект.ЖурналОшибок + Символы.ПС + Символы.ПС + Запись);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьОрганизации()

	Возврат Метаданные.Справочники.Найти("Организации") <> Неопределено;

КонецФункции

#КонецОбласти

#Область ПостроениеФормы

&НаСервере
Процедура СоздатьРеквизиты()

	Обработка = РеквизитФормыВЗначение("Объект");
	С = Обработка.СтруктураУчета();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипБулево = Новый ОписаниеТипов("Булево");

	ИменаСтатей = Новый Массив;
	Для Каждого ИмяСправочника Из С.ИменаСправочниковСтатей Цикл
		ИменаСтатей.Добавить("СправочникСсылка." + ИмяСправочника);
	КонецЦикла;
	ТипСтатьи = ?(ИменаСтатей.Количество() = 0, ТипСтрока, Новый ОписаниеТипов(СтрСоединить(ИменаСтатей, ",")));
	ТипКонтракта = ?(С.ИмяСправочникаКонтракта = "", ТипСтрока, Новый ОписаниеТипов("СправочникСсылка." + С.ИмяСправочникаКонтракта));

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ТекстГотовности", ТипСтрока, , "Результат проверки"));
	Реквизиты.Добавить(Новый РеквизитФормы("ЖурналОшибок", ТипСтрока));
	Реквизиты.Добавить(Новый РеквизитФормы("ИмяТекста", ТипСтрока));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоказыватьНаименования", ТипБулево, , "Показать настоящие наименования (только на экране, файл не пересылать)"));
	Реквизиты.Добавить(Новый РеквизитФормы("АУРВСебестоимость", ТипБулево, ,
		"АУР включаются в себестоимость по статье 1600, счёт 26 закрывается на 90.08 (сноска 2 к прил. 2; п. 24 ФСБУ 10/2026)"));
	Реквизиты.Добавить(Новый РеквизитФормы("НачалоУчета", ТипДата, , "Учёт по новым правилам с"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПапкаВыгрузки", ТипСтрока, , "Папка на сервере для комплекта по расписанию"));
	Если ЕстьОрганизации() Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация (пусто — все)"));
	КонецЕсли;

	Реквизиты.Добавить(Новый РеквизитФормы("Сопоставление", Новый ОписаниеТипов("ТаблицаЗначений"), , "Статьи"));
	Реквизиты.Добавить(Новый РеквизитФормы("Статья", ТипСтатьи, "Сопоставление", "Статья ERP"));
	Реквизиты.Добавить(Новый РеквизитФормы("Источник", ТипСтрока, "Сопоставление", "Справочник"));
	Реквизиты.Добавить(Новый РеквизитФормы("Код", ТипСтрока, "Сопоставление", "Статья калькуляции ПП 874"));
	Реквизиты.Добавить(Новый РеквизитФормы("Обособленно", ТипБулево, "Сопоставление", "Учитывается обособленно (не включается в цену по ПП 1465)"));
	Реквизиты.Добавить(Новый РеквизитФормы("Привнесенная", ТипБулево, "Сопоставление", "Привнесённые (кооперация)"));
	Реквизиты.Добавить(Новый РеквизитФормы("Предложено", ТипБулево, "Сопоставление", "Код предложен автоматически"));

	Реквизиты.Добавить(Новый РеквизитФормы("Месяц", ТипДата, , "Месяц справки"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаОтчета", ТипДата, , "Отчёт по контракту на дату"));
	Реквизиты.Добавить(Новый РеквизитФормы("Контракт", ТипКонтракта, , "Контракт"));
	Реквизиты.Добавить(Новый РеквизитФормы("Результат", Новый ОписаниеТипов("ТабличныйДокумент"), , "Результат"));
	Реквизиты.Добавить(Новый РеквизитФормы("ИмяРезультата", ТипСтрока));
	ИзменитьРеквизиты(Реквизиты);

КонецПроцедуры

