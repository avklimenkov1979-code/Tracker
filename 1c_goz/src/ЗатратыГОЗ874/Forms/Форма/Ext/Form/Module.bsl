// Форма обработки «ГОЗ: затраты по ПП 874» (1С:ERP 2.5).
//
// Закладка «Готовность»: что в базе мешает формировать отчёты по ПП 874 (версия ERP, закрытие месяца,
// субконто контракта и статей, ИГК, признак контракта в первичке, сопоставление статей). Ничего не меняет.
// Закладка «Статьи и настройки»: сопоставление статей ERP с кодами 0101–1600 (прил. 2), вариант по АУР,
// дата начала учёта по новым правилам, папка для регламентного комплекта.
// Закладка «Отчёты»: справка о распределении затрат за месяц (прил. 3), отчёт о фактических затратах
// по контракту (прил. 1), комплект по всем контрактам одним архивом.
//
// Расчёты — в модуле объекта (там же регламентная команда). Реквизиты и элементы формы создаются
// в ПриСозданииНаСервере, поэтому Form.xml почти пустой.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();
	Заголовок = "ГОЗ: затраты по ПП 874";
	ЭтотОбъект.Месяц = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -1);
	ЭтотОбъект.ДатаОтчета = КонецМесяца(ЭтотОбъект.Месяц);
	ЗагрузитьНастройкиВФорму();

КонецПроцедуры

#КонецОбласти

#Область Готовность

&НаКлиенте
Процедура ПроверитьГотовность(Команда)

	Состояние("Проверяю базу: счета, субконто, документы, закрытие месяца...");
	Попытка
		ПроверитьГотовностьНаСервере();
	Исключение
		ЗапомнитьОшибку("Проверка готовности", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Проверка не выполнилась:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПроверитьГотовностьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ЭтотОбъект.ТекстГотовности = Обработка.Диагностика();
	ЭтотОбъект.ИмяТекста = "Готовность_ПП874_";

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаДляАнализа(Команда)

	Состояние("Собираю выгрузку: счета, обороты за 6 месяцев, статьи, контракты, документы, регистры — 1–10 минут...");
	Попытка
		ВыгрузкаДляАнализаНаСервере();
	Исключение
		ЗапомнитьОшибку("Выгрузка для анализа", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Выгрузка не собралась:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
		Возврат;
	КонецПопытки;
	ПоказатьОповещениеПользователя("Выгрузка готова", , "Нажмите «Сохранить в файл» и пришлите файл в чат");

КонецПроцедуры

&НаСервере
Процедура ВыгрузкаДляАнализаНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ЭтотОбъект.ТекстГотовности = Обработка.ВыгрузкаДляАнализа(ЭтотОбъект.ПоказыватьНаименования);
	ЭтотОбъект.ИмяТекста = ?(ЭтотОбъект.ПоказыватьНаименования, "НЕ_ПЕРЕСЫЛАТЬ_Выгрузка_ПП874_", "Выгрузка_ПП874_");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьГотовность(Команда)

	Если ПустаяСтрока(ЭтотОбъект.ТекстГотовности) Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Проверить готовность» или «Выгрузка для анализа».");
		Возврат;
	КонецЕсли;
	СохранитьДанные(ПоместитьТекстВХранилище(ЭтотОбъект.ТекстГотовности), ЭтотОбъект.ИмяТекста + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".txt");

КонецПроцедуры

#КонецОбласти

#Область СтатьиИНастройки

&НаКлиенте
Процедура ЗаполнитьСтатьи(Команда)

	Состояние("Читаю статьи калькуляции и расходов...");
	Попытка
		ЗаполнитьСтатьиНаСервере();
	Исключение
		ЗапомнитьОшибку("Заполнение статей", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Статьи не прочитались:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ПоказатьОповещениеПользователя("Статьи заполнены", , "Проверьте коды (жёлтым — предложены автоматически) и нажмите «Сохранить настройки»");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатьиНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Таблица = Обработка.СтатьиДляСопоставления(НастройкиИзФормы());
	ЭтотОбъект.Сопоставление.Очистить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(ЭтотОбъект.Сопоставление.Добавить(), СтрокаТаблицы);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиКоманда(Команда)

	Пустых = 0;
	Для Каждого СтрокаСоп Из ЭтотОбъект.Сопоставление Цикл
		Если ПустаяСтрока(СтрокаСоп.Код) Тогда
			Пустых = Пустых + 1;
		КонецЕсли;
	КонецЦикла;
	Итог = СохранитьНастройкиНаСервере();
	ПоказатьПредупреждение(, Итог + ?(Пустых > 0, Символы.ПС + Символы.ПС + "Без кода осталось статей: " + Пустых
		+ ". Их суммы попадут в статью по счёту кредита (материалы — 0101, зарплата — 0201, иначе 1100 «Прочие прямые»).", ""));

КонецПроцедуры

&НаСервере
Функция СохранитьНастройкиНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.СохранитьНастройки(НастройкиИзФормы());

КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиВФорму()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = Обработка.ЗагрузитьНастройки();
	ЭтотОбъект.АУРВСебестоимость = Настройки.АУРВСебестоимость;
	ЭтотОбъект.НачалоУчета = Настройки.НачалоУчета;
	ЭтотОбъект.ПапкаВыгрузки = Настройки.ПапкаВыгрузки;
	Если ЕстьОрганизации() Тогда
		ЭтотОбъект.Организация = Настройки.Организация;
	КонецЕсли;
	Попытка
		Таблица = Обработка.СтатьиДляСопоставления(Настройки);
		ЭтотОбъект.Сопоставление.Очистить();
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			ЗаполнитьЗначенияСвойств(ЭтотОбъект.Сопоставление.Добавить(), СтрокаТаблицы);
		КонецЦикла;
	Исключение
		// статьи заполнятся кнопкой; ошибку покажет «Проверить готовность»
		ЭтотОбъект.ЖурналОшибок = "Статьи при открытии: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция НастройкиИзФормы()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = Обработка.НовыеНастройки();
	Настройки.АУРВСебестоимость = ЭтотОбъект.АУРВСебестоимость;
	Настройки.НачалоУчета = ?(ЗначениеЗаполнено(ЭтотОбъект.НачалоУчета), ЭтотОбъект.НачалоУчета, Дата(2027, 1, 1));
	Настройки.ПапкаВыгрузки = СокрЛП(ЭтотОбъект.ПапкаВыгрузки);
	Если ЕстьОрганизации() Тогда
		Настройки.Организация = ЭтотОбъект.Организация;
	КонецЕсли;
	Для Каждого СтрокаСоп Из ЭтотОбъект.Сопоставление Цикл
		Если ПустаяСтрока(СтрокаСоп.Код) И НЕ СтрокаСоп.Обособленно Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Настройки.Сопоставление.Добавить();
		НоваяСтрока.Статья = СтрокаСоп.Статья;
		НоваяСтрока.Код = СтрокаСоп.Код;
		НоваяСтрока.Обособленно = СтрокаСоп.Обособленно;
		НоваяСтрока.Привнесенная = СтрокаСоп.Привнесенная;
	КонецЦикла;
	Возврат Настройки;

КонецФункции

&НаКлиенте
Процедура СопоставлениеКодПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Сопоставление.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Предложено = Ложь;
		Код = Лев(ТекущиеДанные.Код, 4);
		ТекущиеДанные.Привнесенная = (Код = "0102" ИЛИ Код = "0104" ИЛИ Код = "0105" ИЛИ Код = "1200");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Отчеты

&НаКлиенте
Процедура СформироватьСправку(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Месяц) Тогда
		ПоказатьПредупреждение(, "Укажите месяц.");
		Возврат;
	КонецЕсли;
	Состояние("Формирую справку о распределении затрат за месяц...");
	Попытка
		Расхождений = СформироватьСправкуНаСервере();
	Исключение
		ЗапомнитьОшибку("Справка прил. 3", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Справка не сформировалась:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
		Возврат;
	КонецПопытки;
	Если Расхождений > 0 Тогда
		ПоказатьПредупреждение(, "Справка готова. Есть расхождения расчёта с бухучётом (" + Расхождений
			+ ") — к справке нужна пояснительная записка. Список — внизу справки.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьСправкуНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.СправкаПрил3(ЭтотОбъект.Месяц, НастройкиИзФормы());
	ЭтотОбъект.Результат = Результат.Документ;
	ЭтотОбъект.ИмяРезультата = "Справка_прил3_" + Формат(ЭтотОбъект.Месяц, "ДФ=yyyy_MM");
	Возврат Результат.Расхождения.Количество();

КонецФункции

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Контракт) Тогда
		ПоказатьПредупреждение(, "Выберите контракт (направление деятельности с ИГК) или нажмите «Найти контракты».");
		Возврат;
	КонецЕсли;
	Состояние("Формирую отчёт о фактических затратах по контракту...");
	Попытка
		СформироватьОтчетНаСервере();
	Исключение
		ЗапомнитьОшибку("Отчёт прил. 1", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Отчёт не сформировался:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ОтчетПрил1(ЭтотОбъект.Контракт, ЭтотОбъект.ДатаОтчета, НастройкиИзФормы());
	ЭтотОбъект.Результат = Результат.Документ;
	ЭтотОбъект.ИмяРезультата = "Отчет_прил1_" + СтрЗаменить(Обработка.ИГК(ЭтотОбъект.Контракт), " ", "_") + "_" + Формат(ЭтотОбъект.ДатаОтчета, "ДФ=yyyy_MM_dd");

КонецПроцедуры

&НаКлиенте
Процедура НайтиКонтракты(Команда)

	Состояние("Ищу контракты с ИГК, по которым были затраты...");
	Попытка
		Найдено = НайтиКонтрактыНаСервере();
	Исключение
		ЗапомнитьОшибку("Поиск контрактов", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Не получилось найти контракты:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если Найдено = 0 Тогда
		ПоказатьПредупреждение(, "Контрактов с ИГК и затратами на счёте 20 за период не найдено. Проверьте закладку «Готовность».");
	Иначе
		ПоказатьОповещениеПользователя("Найдено контрактов: " + Найдено, , "Выберите контракт из списка в поле «Контракт»");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НайтиКонтрактыНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = НастройкиИзФормы();
	Контракты = Обработка.КонтрактыСЗатратами(Настройки.НачалоУчета, КонецДня(ЭтотОбъект.ДатаОтчета), Настройки);
	Поле = Элементы.Контракт;
	Поле.СписокВыбора.Очистить();
	Для Каждого Контракт Из Контракты Цикл
		Поле.СписокВыбора.Добавить(Контракт, Обработка.ИГК(Контракт) + " — " + Строка(Контракт));
	КонецЦикла;
	Если Контракты.Количество() > 0 И НЕ ЗначениеЗаполнено(ЭтотОбъект.Контракт) Тогда
		ЭтотОбъект.Контракт = Контракты[0];
	КонецЕсли;
	Возврат Контракты.Количество();

КонецФункции

&НаКлиенте
Процедура СкачатьКомплект(Команда)

	Состояние("Формирую справку и отчёты по всем контрактам — это может занять несколько минут...");
	Попытка
		Адрес = КомплектНаСервере();
	Исключение
		ЗапомнитьОшибку("Комплект", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Комплект не сформировался:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	СохранитьДанные(Адрес, "ГОЗ_874_" + Формат(ЭтотОбъект.Месяц, "ДФ=yyyy_MM") + ".zip");

КонецПроцедуры

&НаСервере
Функция КомплектНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат ПоместитьВоВременноеХранилище(Обработка.КомплектАрхивом(ЭтотОбъект.Месяц, НастройкиИзФормы()), УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура СохранитьВExcel(Команда)

	Если ПустаяСтрока(ЭтотОбъект.ИмяРезультата) Тогда
		ПоказатьПредупреждение(, "Сначала сформируйте справку или отчёт.");
		Возврат;
	КонецЕсли;
	СохранитьДанные(РезультатВХранилище(), ЭтотОбъект.ИмяРезультата + ".xlsx");

КонецПроцедуры

&НаСервере
Функция РезультатВХранилище()

	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	ЭтотОбъект.Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	Данные = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти

#Область Общее

&НаКлиенте
Процедура СообщитьОбОшибке(Команда)

	СисИнфо = Новый СистемнаяИнформация;
	Строки = Новый Массив;
	Строки.Добавить("СООБЩЕНИЕ ОБ ОШИБКЕ: ГОЗ: затраты по ПП 874, версия " + ВерсияПрограммы());
	Строки.Добавить("1С на компьютере: " + СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + "); " + СисИнфо.ВерсияОС);
	Строки.Добавить(СведенияОБазе());
	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ");
	Строки.Добавить(?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), "  нет", ЭтотОбъект.ЖурналОшибок));
	Для Каждого СообщениеЭкрана Из ПолучитьСообщенияПользователю(Ложь) Цикл
		Строки.Добавить("Сообщение: " + СообщениеЭкрана.Текст);
	КонецЦикла;
	Текст = СтрСоединить(Строки, Символы.ПС);
	СохранитьДанные(ПоместитьТекстВХранилище(Текст), "Ошибка_ГОЗ874_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmm") + ".txt");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанные(Адрес, ИмяФайлаДанных)

	ПоказатьОповещениеПользователя("Сохранение файла", , ИмяФайлаДанных);
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайлаДанных);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПоместитьТекстВХранилище(Текст)

	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция СведенияОБазе()

	СисИнфо = Новый СистемнаяИнформация;
	Возврат "Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + "; 1С на сервере: " + СисИнфо.ВерсияПриложения;

КонецФункции

&НаСервереБезКонтекста
