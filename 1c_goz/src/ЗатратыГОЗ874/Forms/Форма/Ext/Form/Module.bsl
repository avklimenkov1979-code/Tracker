	ДобавитьКоманду("ЗаполнитьСтатьи", "Заполнить статьи", "Прочитать статьи ERP и предложить коды ПП 874");
	ДобавитьКоманду("СохранитьНастройкиКоманда", "Сохранить настройки", "Сохранить сопоставление статей и настройки");
	ДобавитьКоманду("НайтиКонтракты", "Найти контракты", "Контракты с ИГК, по которым были затраты");
	ДобавитьКоманду("СформироватьСправку", "Справка за месяц (прил. 3)", "Справка по результатам распределения затрат за месяц");
	ДобавитьКоманду("СформироватьОтчет", "Отчёт по контракту (прил. 1)", "Отчёт о фактических затратах по контракту нарастающим итогом");
	ДобавитьКоманду("СкачатьКомплект", "Комплект за месяц (zip)", "Справка за месяц и отчёты по всем контрактам одним архивом");
	ДобавитьКоманду("СохранитьВExcel", "Сохранить в Excel", "Сохранить показанный документ в файл xlsx");
	ДобавитьКоманду("СообщитьОбОшибке", "Сообщить об ошибке", "Собрать тексты ошибок в файл, чтобы прислать в чат");

	Кнопка = Элементы.Добавить("КнопкаСообщитьОбОшибке", Тип("КнопкаФормы"), КоманднаяПанель);
	Кнопка.ИмяКоманды = "СообщитьОбОшибке";

КонецПроцедуры

&НаСервере
Процедура ДобавитьКоманду(Имя, ТекстЗаголовка, ТекстПодсказки)

	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = ТекстЗаголовка;
	Команда.Действие = Имя;
	Если НЕ ПустаяСтрока(ТекстПодсказки) Тогда
		Команда.Подсказка = ТекстПодсказки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементы()

	Обработка = РеквизитФормыВЗначение("Объект");
	Страницы = ДобавитьГруппу("Страницы", ЭтотОбъект, ВидГруппыФормы.Страницы);

	// --- Готовность
	СтраницаГотовность = ДобавитьГруппу("СтраницаГотовность", Страницы, ВидГруппыФормы.Страница, "Готовность");
	ДобавитьНадпись("ПодсказкаГотовность", СтраницаГотовность,
		"Проверка базы перед отчётами по ПП 874: версия ERP и встроенные отчёты ГОЗ, закрытие месяца, субконто контракта и статей на счетах, "
		+ "ИГК, признак контракта в документах, сопоставление статей. Ничего не меняет. В начале — список «что сделать». "
		+ "Нажмите «Проверить готовность», затем «Сохранить в файл» и пришлите файл в чат. "
		+ "«Выгрузка для анализа» — подробнее: обороты по счетам за 6 месяцев, статьи, контракты, заполненность документов (в том числе зарплатных), "
		+ "структура регистров. Наименований в файле нет — вместо них коды «Контракт-1», «Статья калькуляции-5».");
	ГруппаКнопки = ДобавитьГруппу("ГруппаКнопкиГотовность", СтраницаГотовность, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьКнопку("ПроверитьГотовность", ГруппаКнопки);
	ДобавитьКнопку("ВыгрузкаДляАнализа", ГруппаКнопки).КнопкаПоУмолчанию = Истина;
	ДобавитьКнопку("СохранитьГотовность", ГруппаКнопки);
	Поле = ДобавитьПоле("ПоказыватьНаименования", "ПоказыватьНаименования", ГруппаКнопки, ВидПоляФормы.ПолеФлажка);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Поле = ДобавитьПоле("ТекстГотовности", "ТекстГотовности", СтраницаГотовность);
	Поле.МногострочныйРежим = Истина;
	Поле.ТолькоПросмотр = Истина;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоВертикали = Истина;
	Поле.РастягиватьПоГоризонтали = Истина;

	// --- Статьи и настройки
	СтраницаСтатьи = ДобавитьГруппу("СтраницаСтатьи", Страницы, ВидГруппыФормы.Страница, "Статьи и настройки");
	ДобавитьНадпись("ПодсказкаСтатьи", СтраницаСтатьи,
		"Каждой статье калькуляции и расходов ERP укажите статью ПП 874 (прил. 2). Коды предложены по названию — проверьте их. "
		+ "«Обособленно» — затраты, не включаемые в себестоимость по ПП 1465 (в отчёте отдельной колонкой, в распределение не входят). "
		+ "«Привнесённые» — покупное у кооперации. Сохраняйте настройки под администратором: тогда они общие и для регламентного задания.");
	ГруппаНастройки = ДобавитьГруппу("ГруппаНастройки", СтраницаСтатьи, ВидГруппыФормы.ОбычнаяГруппа);
	Поле = ДобавитьПоле("АУРВСебестоимость", "АУРВСебестоимость", ГруппаНастройки, ВидПоляФормы.ПолеФлажка);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ГруппаСтрока = ДобавитьГруппу("ГруппаНастройкиСтрока", ГруппаНастройки, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("НачалоУчета", "НачалоУчета", ГруппаСтрока);
	Если ЕстьОрганизации() Тогда
		ДобавитьПоле("Организация", "Организация", ГруппаСтрока);
	КонецЕсли;
	ДобавитьПоле("ПапкаВыгрузки", "ПапкаВыгрузки", ГруппаНастройки).РастягиватьПоГоризонтали = Истина;
	ГруппаКнопки = ДобавитьГруппу("ГруппаКнопкиСтатьи", СтраницаСтатьи, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьКнопку("ЗаполнитьСтатьи", ГруппаКнопки);
	ДобавитьКнопку("СохранитьНастройкиКоманда", ГруппаКнопки);

	ТаблицаСтатей = Элементы.Добавить("Сопоставление", Тип("ТаблицаФормы"), СтраницаСтатьи);
	ТаблицаСтатей.ПутьКДанным = "Сопоставление";
	ТаблицаСтатей.ИзменятьСоставСтрок = Ложь;
	ТаблицаСтатей.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Для Каждого Колонка Из СтрРазделить("Статья,Источник,Код,Обособленно,Привнесенная,Предложено", ",") Цикл
		ВидПоля = ?(Колонка = "Обособленно" ИЛИ Колонка = "Привнесенная" ИЛИ Колонка = "Предложено", ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода);
		Поле = ДобавитьПоле("Сопоставление" + Колонка, "Сопоставление." + Колонка, ТаблицаСтатей, ВидПоля);
		Если Колонка = "Статья" ИЛИ Колонка = "Источник" ИЛИ Колонка = "Предложено" Тогда
			Поле.ТолькоПросмотр = Истина;
		КонецЕсли;
		Если Колонка = "Код" Тогда
			Для Каждого Вариант Из Обработка.КодыДляВыбора() Цикл
				Поле.СписокВыбора.Добавить(Вариант);
			КонецЦикла;
			Поле.РежимВыбораИзСписка = Истина;
			Поле.КнопкаОчистки = Истина;
			Поле.УстановитьДействие("ПриИзменении", "СопоставлениеКодПриИзменении");
		КонецЕсли;
	КонецЦикла;

	// подсветка автоматически предложенных кодов
	Оформление = УсловноеОформление.Элементы.Добавить();
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЖелтыйЗолотистый);
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Сопоставление.Предложено");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	ПолеОформления = Оформление.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("СопоставлениеКод");

	// --- Отчёты
	СтраницаОтчеты = ДобавитьГруппу("СтраницаОтчеты", Страницы, ВидГруппыФормы.Страница, "Отчёты");
	ДобавитьНадпись("ПодсказкаОтчеты", СтраницаОтчеты,
		"Данные — из регламентированного учёта после закрытия месяца. Справка — за месяц, по всем контрактам (прил. 3). "
		+ "Отчёт — по одному контракту нарастающим итогом с даты начала учёта по новым правилам, по партиям реализации (прил. 1). "
		+ "«Комплект» — справка и отчёты по всем контрактам одним архивом xlsx.");
	ГруппаСправка = ДобавитьГруппу("ГруппаСправка", СтраницаОтчеты, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("Месяц", "Месяц", ГруппаСправка);
	ДобавитьКнопку("СформироватьСправку", ГруппаСправка);
	ДобавитьКнопку("СкачатьКомплект", ГруппаСправка);
	ГруппаОтчет = ДобавитьГруппу("ГруппаОтчет", СтраницаОтчеты, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("ДатаОтчета", "ДатаОтчета", ГруппаОтчет);
	ДобавитьПоле("Контракт", "Контракт", ГруппаОтчет).РастягиватьПоГоризонтали = Истина;
	ДобавитьКнопку("НайтиКонтракты", ГруппаОтчет);
	ДобавитьКнопку("СформироватьОтчет", ГруппаОтчет);
	ДобавитьКнопку("СохранитьВExcel", ГруппаОтчет);
	Поле = ДобавитьПоле("Результат", "Результат", СтраницаОтчеты, ВидПоляФормы.ПолеТабличногоДокумента);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьНадпись(Имя, Родитель, Текст)

	Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = Текст;
	Надпись.РастягиватьПоГоризонтали = Истина;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Родитель, ВидГруппы, ТекстЗаголовка = "", Горизонтальная = Ложь)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппы;
	Если ВидГруппы = ВидГруппыФормы.ОбычнаяГруппа Тогда
		Группа.ОтображатьЗаголовок = НЕ ПустаяСтрока(ТекстЗаголовка);
		Группа.Группировка = ?(Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстЗаголовка) Тогда
		Группа.Заголовок = ТекстЗаголовка;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
Функция ДобавитьПоле(Имя, ПутьКДанным, Родитель, ВидПоля = Неопределено)

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Вид = ?(ВидПоля = Неопределено, ВидПоляФормы.ПолеВвода, ВидПоля);
	Возврат Поле;

КонецФункции

&НаСервере
Функция ДобавитьКнопку(ИмяКомандыКнопки, Родитель)

	Кнопка = Элементы.Добавить("Кнопка" + ИмяКомандыКнопки, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = ИмяКомандыКнопки;
	Возврат Кнопка;

КонецФункции

#КонецОбласти
