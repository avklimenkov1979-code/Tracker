// Все статьи ERP (калькуляции и расходов) с текущим сопоставлением; несопоставленным предлагается код.
Функция СтатьиДляСопоставления(Настройки) Экспорт

	Т = НоваяТаблицаСопоставления();
	Т.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Предложено", Новый ОписаниеТипов("Булево"));
	С = СтруктураУчета();
	Для Каждого ИмяСправочника Из С.ИменаСправочниковСтатей Цикл
		МетаСправочника = Метаданные.Справочники[ИмяСправочника];
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ С.Ссылка КАК Ссылка, С.Наименование КАК Наименование ИЗ Справочник." + ИмяСправочника
			+ " КАК С ГДЕ НЕ С.ПометкаУдаления" + ?(МетаСправочника.Иерархический И МетаСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов,
			" И НЕ С.ЭтоГруппа", "") + " УПОРЯДОЧИТЬ ПО С.Наименование";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = Т.Добавить();
			Стр.Статья = Выборка.Ссылка;
			Стр.Источник = МетаСправочника.Синоним;
			Сохраненная = Настройки.Сопоставление.Найти(Выборка.Ссылка, "Статья");
			Если Сохраненная <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Стр, Сохраненная, "Код, Обособленно, Привнесенная");
			Иначе
				КодСтатьи = ПредложитьКод(Выборка.Наименование);
				Стр.Привнесенная = ПривнесеннаяПоУмолчанию(КодСтатьи);
				Стр.Код = ПолныйКод(КодСтатьи);
				Стр.Предложено = НЕ ПустаяСтрока(Стр.Код);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Т;

