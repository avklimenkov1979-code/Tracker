// Справка за месяц + отчёты по всем контрактам ГОЗ с затратами — файлами xlsx в папку на сервере.
Функция СохранитьКомплектВПапку(Месяц, Настройки, Папка) Экспорт

	Разделитель = ПолучитьРазделительПути();
	Если Прав(Папка, 1) <> Разделитель Тогда
		Папка = Папка + Разделитель;
	КонецЕсли;
	Суффикс = Формат(Месяц, "ДФ=yyyy_MM");
	Справка = СправкаПрил3(Месяц, Настройки);
	Справка.Документ.Записать(Папка + "Справка_прил3_" + Суффикс + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
	Файлов = 1;
	Для Каждого Контракт Из КонтрактыСЗатратами(Настройки.НачалоУчета, КонецМесяца(Месяц), Настройки) Цикл
		Отчет = ОтчетПрил1(Контракт, КонецМесяца(Месяц), Настройки);
		Отчет.Документ.Записать(Папка + "Отчет_прил1_" + ИмяФайла(ИГК(Контракт)) + "_" + Суффикс + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
		Файлов = Файлов + 1;
	КонецЦикла;
	Возврат "ГОЗ 874: за " + Формат(Месяц, "ДФ='MMMM yyyy'") + " сохранено файлов: " + Файлов + " в " + Папка
		+ ?(Справка.Расхождения.Количество() > 0, ". В справке есть расхождения — нужна пояснительная записка.", "");

КонецФункции

// Тот же комплект одним zip-архивом (для кнопки в форме). Возвращает двоичные данные.
Функция КомплектАрхивом(Месяц, Настройки) Экспорт

	Каталог = ПолучитьИмяВременногоФайла("goz874");
	СоздатьКаталог(Каталог);
	СохранитьКомплектВПапку(Месяц, Настройки, Каталог);
	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
	Архив = Новый ЗаписьZipФайла(ИмяАрхива);
	Архив.Добавить(Каталог + ПолучитьРазделительПути() + "*.xlsx", РежимСохраненияПутейZIP.НеСохранятьПути);
	Архив.Записать();
	Данные = Новый ДвоичныеДанные(ИмяАрхива);
	УдалитьФайлы(Каталог);
	УдалитьФайлы(ИмяАрхива);
	Возврат Данные;

