// Прямые затраты: Дт 20 (кроме внутренних оборотов 20—20) по контракту и статье. Плюс возвратные отходы Кт 20 Дт 10.
// Результат: таблица Контракт, Код, Обособленно, Привнесенная, Сумма.
Функция ПрямыеЗатраты(Начало, Конец, Настройки, С)

	Итог = НоваяТаблицаЗатрат();
	Если С.Счета.Счет20 = Неопределено ИЛИ С.ВидКонтракта = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;
	ВидыДт = Новый Массив;
	ВидыДт.Добавить(С.ВидКонтракта);
	ПолеСтатьи = "НЕОПРЕДЕЛЕНО";
	Если С.ВидСтатьи20 <> Неопределено Тогда
		ВидыДт.Добавить(С.ВидСтатьи20);
		ПолеСтатьи = "О.СубконтоДт2";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	О.СубконтоДт1 КАК Контракт,
		|	" + ПолеСтатьи + " КАК Статья,
		|	О.СчетКт КАК СчетКт,
		|	СУММА(О.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&Начало, &Конец, , СчетДт В ИЕРАРХИИ (&Счет20), &ВидыДт,
		|		НЕ СчетКт В ИЕРАРХИИ (&Счет20), , " + УсловиеОрганизации(Настройки.Организация) + ") КАК О
		|СГРУППИРОВАТЬ ПО
		|	О.СубконтоДт1,
		|	" + ?(ПолеСтатьи = "НЕОПРЕДЕЛЕНО", "", ПолеСтатьи + ",") + "
		|	О.СчетКт";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Счет20", С.Счета.Счет20);
	Запрос.УстановитьПараметр("ВидыДт", ВидыДт);
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Признаки = КодСтроки(Выборка.Статья, Выборка.СчетКт, Настройки.Сопоставление, С);
		ДобавитьЗатраты(Итог, Выборка.Контракт, Признаки, Выборка.Сумма);
	КонецЦикла;

	// возвратные отходы: Кт 20 Дт 10 — уменьшают материальные затраты
	Если С.Счета.Счет10 <> Неопределено Тогда
		ВидыКт = Новый Массив;
		ВидыКт.Добавить(С.ВидКонтракта);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	О.СубконтоКт1 КАК Контракт,
			|	СУММА(О.СуммаОборот) КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&Начало, &Конец, , СчетДт В ИЕРАРХИИ (&Счет10), ,
			|		СчетКт В ИЕРАРХИИ (&Счет20), &ВидыКт, " + УсловиеОрганизации(Настройки.Организация) + ") КАК О
			|СГРУППИРОВАТЬ ПО
			|	О.СубконтоКт1";
		Запрос.УстановитьПараметр("Начало", Начало);
		Запрос.УстановитьПараметр("Конец", Конец);
		Запрос.УстановитьПараметр("Счет10", С.Счета.Счет10);
		Запрос.УстановитьПараметр("Счет20", С.Счета.Счет20);
		Запрос.УстановитьПараметр("ВидыКт", ВидыКт);
		Запрос.УстановитьПараметр("Организация", Настройки.Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДобавитьЗатраты(Итог, Выборка.Контракт, Новый Структура("Код, Обособленно, Привнесенная", "0103", Ложь, Ложь), Выборка.Сумма);
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

