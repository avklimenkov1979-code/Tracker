КонецФункции

// Сначала общие настройки (одни на всех, их читает и регламентное задание), потом свои.
Функция ЗагрузитьНастройки() Экспорт

	Настройки = НовыеНастройки();
	Сохраненные = Неопределено;
	Попытка
		Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Общие", , "ГОЗ874");
	Исключение
		Сохраненные = Неопределено;
	КонецПопытки;
	Если Сохраненные = Неопределено Тогда
		Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Общие");
	КонецЕсли;
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Сохраненные Цикл
			Если Настройки.Свойство(КлючИЗначение.Ключ) Тогда
				Настройки[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Настройки;

КонецФункции

// Возвращает текст: где сохранены настройки.
Функция СохранитьНастройки(Настройки) Экспорт

	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Общие", Настройки);
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Общие", Настройки, , "ГОЗ874");
		Возврат "Настройки сохранены для всех пользователей.";
	Исключение
		Возврат "Настройки сохранены только для вас: для общих настроек (их читает регламентное задание) нужны права администратора.";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СтруктураУчета

// Что есть в этой базе: план счетов, счета, виды субконто для контракта, статьи, подразделения.
// Ничего не предполагаем заранее: всё ищем по метаданным и типам значений субконто.
Функция СтруктураУчета() Экспорт

	С = Новый Структура;
	С.Вставить("ЕстьХозрасчетный", Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") <> Неопределено
		И Метаданные.ПланыСчетов.Найти("Хозрасчетный") <> Неопределено);
	С.Вставить("Счета", Новый Структура);
	С.Вставить("ВидКонтракта", Неопределено);
	С.Вставить("ИмяСправочникаКонтракта", "");
	С.Вставить("ВидСтатьи20", Неопределено);
	С.Вставить("ВидСтатьи25", Неопределено);
	С.Вставить("ВидСтатьи26", Неопределено);
	С.Вставить("ВидСтатьи90", Неопределено);
	С.Вставить("ВидПодразделения25", Неопределено);
	С.Вставить("ВидПодразделения20", Неопределено);
	С.Вставить("ИменаСправочниковСтатей", Новый Массив);
	С.Вставить("Замечания", Новый Массив);
	Если НЕ С.ЕстьХозрасчетный Тогда
		С.Замечания.Добавить("В конфигурации нет плана счетов «Хозрасчетный»: регламентированного учёта нет.");
		Возврат С;
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить("Счет10:10,Счет20:20,Счет21:21,Счет23:23,Счет25:25,Счет26:26,Счет43:43,Счет69:69,Счет70:70,"
		+ "Счет90_02:90.02,Счет90_07:90.07,Счет90_08:90.08,Счет91_02:91.02", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		С.Счета.Вставить(Части[0], НайтиСчет(Части[1]));
	КонецЦикла;

	ИменаКонтракта = СтрРазделить("НаправленияДеятельности,ДоговорыКонтрагентов,ДоговорыСКлиентами", ",");
	ИменаСтатей = СтрРазделить("СтатьиКалькуляции,СтатьиРасходов,СтатьиЗатрат", ",");
	ИменаПодразделений = СтрРазделить("СтруктураПредприятия,ПодразделенияОрганизаций,Подразделения", ",");
	Для Каждого ИмяСправочника Из ИменаСтатей Цикл
		Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
			С.ИменаСправочниковСтатей.Добавить(ИмяСправочника);
		КонецЕсли;
	КонецЦикла;

	Найдено = ВидСубконтоПоТипу(С.Счета.Счет20, ИменаКонтракта);
	Если Найдено <> Неопределено Тогда
		С.ВидКонтракта = Найдено.Вид;
		С.ИмяСправочникаКонтракта = Найдено.ИмяСправочника;
	Иначе
		С.Замечания.Добавить("На счёте 20 нет субконто «контракт» (направление деятельности или договор): затраты нельзя разделить по контрактам ГОЗ.");
	КонецЕсли;
	С.ВидСтатьи20 = ВидИзНайденного(ВидСубконтоПоТипу(С.Счета.Счет20, ИменаСтатей));
	С.ВидСтатьи25 = ВидИзНайденного(ВидСубконтоПоТипу(С.Счета.Счет25, ИменаСтатей));
	С.ВидСтатьи26 = ВидИзНайденного(ВидСубконтоПоТипу(С.Счета.Счет26, ИменаСтатей));
	С.ВидСтатьи90 = ВидИзНайденного(ВидСубконтоПоТипу(С.Счета.Счет90_08, ИменаСтатей));
	С.ВидПодразделения25 = ВидИзНайденного(ВидСубконтоПоТипу(С.Счета.Счет25, ИменаПодразделений));
	С.ВидПодразделения20 = ВидИзНайденного(ВидСубконтоПоТипу(С.Счета.Счет20, ИменаПодразделений));
	Если С.ВидСтатьи20 = Неопределено Тогда
		С.Замечания.Добавить("На счёте 20 нет субконто «статья калькуляции/затрат»: статьи определяются только по корреспондирующему счёту (грубо).");
	КонецЕсли;
	Возврат С;

КонецФункции

Функция ВидИзНайденного(Найдено)

	Возврат ?(Найдено = Неопределено, Неопределено, Найдено.Вид);

КонецФункции

Функция НайтиСчет(Код)

	Попытка
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(Счет), Счет, Неопределено);

КонецФункции

// Ищет среди видов субконто счёта и его субсчетов вид, в типе которого есть справочник из списка (по приоритету списка).
Функция ВидСубконтоПоТипу(Счет, ИменаСправочников)

	Если Счет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВС.ВидСубконто КАК Вид
		|ИЗ
		|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ВС
		|ГДЕ
		|	ВС.Ссылка В ИЕРАРХИИ (&Счет)";
	Запрос.УстановитьПараметр("Счет", Счет);
	Виды = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Вид");
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипСсылки = Тип("СправочникСсылка." + ИмяСправочника);
		Для Каждого Вид Из Виды Цикл
			Если Вид.ТипЗначения.СодержитТип(ТипСсылки) Тогда
				Возврат Новый Структура("Вид, ИмяСправочника", Вид, ИмяСправочника);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// ИГК контракта: ищем реквизит с идентификатором госконтракта в справочнике контракта.
Функция ИГК(Контракт) Экспорт

	Если НЕ ЗначениеЗаполнено(Контракт) Тогда
		Возврат "";
	КонецЕсли;
	МетаКонтракта = Контракт.Метаданные();
	ИмяРеквизита = ИмяРеквизитаИГК(МетаКонтракта);
	Если ИмяРеквизита = "" Тогда
		Возврат "";
	КонецЕсли;
	Значение = Контракт[ИмяРеквизита];
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ИмяРеквизитаИГК(МетаКонтракта) Экспорт

	Для Каждого ИмяРеквизита Из СтрРазделить("ИдентификаторГосударственногоКонтракта,ИдентификаторГосКонтракта,ИГК,ГосударственныйКонтракт", ",") Цикл
		Если МетаКонтракта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Реквизит Из МетаКонтракта.Реквизиты Цикл
		Если СтрНайти(Реквизит.Имя, "Идентификатор") > 0 И СтрНайти(Реквизит.Имя, "Контракт") > 0 Тогда
			Возврат Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Диагностика

// Проверка готовности базы к ПП 874. Ничего не меняет. Наименований контрагентов в тексте нет.
Функция Диагностика() Экспорт

	Строки = Новый Массив;
	Рекомендации = Новый Массив;
	СисИнфо = Новый СистемнаяИнформация;
	Строки.Добавить("ГОТОВНОСТЬ К ПП 874 — обработка «ГОЗ: затраты по ПП 874», версия " + ВерсияОбработки());
	Строки.Добавить("Сформировано: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + "; 1С: " + СисИнфо.ВерсияПриложения);
	Строки.Добавить("");

	// 1. Версия ERP и встроенные отчёты ГОЗ
	Строки.Добавить("1. ВСТРОЕННЫЕ СРЕДСТВА ГОЗ В ERP");
	Версия = Метаданные.Версия;
	Строки.Добавить("   Версия ERP: " + Версия + ". Отчёт по прил. 1 есть с 2.5.27.98 / 2.6.2.68, справка по прил. 3 — с 2.5.27.107 / 2.6.2.72 (по данным 1С-партнёров).");
	Если СравнитьВерсии(Версия, "2.5.27.107") < 0 Тогда
		Рекомендации.Добавить("СРОЧНО. Обновить ERP до 2.5.27.107 или новее (лучше 2.6.2.72+): в типовой появились «Фактические затраты ГОЗ» и справка о распределении. Это главный способ, обработка — проверка и запасной путь.");
	КонецЕсли;
	НайденоОтчетов = 0;
	Для Каждого МетаОтчета Из Метаданные.Отчеты Цикл
		Если СтрНайти(НРег(МетаОтчета.Имя), "гоз") > 0 ИЛИ СтрНайти(НРег(МетаОтчета.Синоним), "гоз") > 0
			ИЛИ СтрНайти(НРег(МетаОтчета.Синоним), "оборонн") > 0 Тогда
			Строки.Добавить("   отчёт: " + МетаОтчета.Синоним + " (" + МетаОтчета.Имя + ")");
			НайденоОтчетов = НайденоОтчетов + 1;
		КонецЕсли;
	КонецЦикла;
	Если НайденоОтчетов = 0 Тогда
		Строки.Добавить("   отчётов ГОЗ в конфигурации нет");
	КонецЕсли;
	Для Каждого МетаОпции Из Метаданные.ФункциональныеОпции Цикл
		ИмяОпции = НРег(МетаОпции.Имя);
		Если СтрНайти(ИмяОпции, "гоз") > 0 ИЛИ СтрНайти(ИмяОпции, "оборонн") > 0 ИЛИ СтрНайти(ИмяОпции, "направленияд") > 0
			ИЛИ СтрНайти(ИмяОпции, "раздельн") > 0 ИЛИ СтрНайти(ИмяОпции, "детализац") > 0 Тогда
			Значение = "?";
			Попытка
				Значение = ?(ПолучитьФункциональнуюОпцию(МетаОпции.Имя), "включена", "ВЫКЛЮЧЕНА");
			Исключение
				Значение = "не прочиталась";
			КонецПопытки;
			Строки.Добавить("   функция " + МетаОпции.Синоним + " (" + МетаОпции.Имя + "): " + Значение);
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("");

	// 2. Регламентированный учёт и субконто
	Строки.Добавить("2. РЕГЛАМЕНТИРОВАННЫЙ УЧЁТ: ЧТО ЕСТЬ НА СЧЕТАХ");
	С = СтруктураУчета();
	Если С.ЕстьХозрасчетный Тогда
		Для Каждого КлючИЗначение Из С.Счета Цикл
			Строки.Добавить("   " + Лев(КлючИЗначение.Ключ + "          ", 10) + ": " + ?(КлючИЗначение.Значение = Неопределено, "НЕТ СЧЁТА",
				КлючИЗначение.Значение.Код + " " + КлючИЗначение.Значение.Наименование + " — субконто: " + СубконтоСчета(КлючИЗначение.Значение)));
		КонецЦикла;
		Строки.Добавить("   Контракт на счёте 20: " + ?(С.ВидКонтракта = Неопределено, "НЕ НАЙДЕН", Строка(С.ВидКонтракта) + " (" + С.ИмяСправочникаКонтракта + ")"));
		Строки.Добавить("   Статья на счёте 20: " + ?(С.ВидСтатьи20 = Неопределено, "НЕ НАЙДЕНА", Строка(С.ВидСтатьи20)));
		Строки.Добавить("   Статья на 25 / 26 / 90.08: " + Строка(С.ВидСтатьи25) + " / " + Строка(С.ВидСтатьи26) + " / " + Строка(С.ВидСтатьи90));
		Строки.Добавить("   Подразделение на 20 / 25: " + Строка(С.ВидПодразделения20) + " / " + Строка(С.ВидПодразделения25));
	КонецЕсли;
	Для Каждого Замечание Из С.Замечания Цикл
		Строки.Добавить("   ! " + Замечание);
		Рекомендации.Добавить("ВАЖНО. " + Замечание);
	КонецЦикла;
	Строки.Добавить("");

	// 3. Контракты и ИГК
	Строки.Добавить("3. КОНТРАКТЫ И ИГК");
	Если С.ИмяСправочникаКонтракта <> "" Тогда
		МетаКонтракта = Метаданные.Справочники[С.ИмяСправочникаКонтракта];
		ИмяИГК = ИмяРеквизитаИГК(МетаКонтракта);
		Строки.Добавить("   Справочник контрактов: " + МетаКонтракта.Синоним + "; реквизит ИГК: " + ?(ИмяИГК = "", "НЕ НАЙДЕН", ИмяИГК));
		Если ИмяИГК = "" Тогда
			Рекомендации.Добавить("ВАЖНО. В справочнике «" + МетаКонтракта.Синоним + "» нет реквизита с ИГК. Включите учёт ГОЗ в ERP или добавьте реквизит расширением (см. ПРОЕКТ.md).");
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, СУММА(ВЫБОР КОГДА К." + ИмяИГК + " = &Пусто ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК СИГК
				|ИЗ Справочник." + С.ИмяСправочникаКонтракта + " КАК К ГДЕ НЕ К.ПометкаУдаления";
			Попытка
				ТипИГК = МетаКонтракта.Реквизиты[ИмяИГК].Тип;
				Запрос.УстановитьПараметр("Пусто", ТипИГК.ПривестиЗначение(Неопределено));
				Выборка = Запрос.Выполнить().Выбрать();
				Выборка.Следующий();
				Строки.Добавить("   элементов: " + Выборка.Всего + ", с заполненным ИГК: " + Выборка.СИГК);
			Исключение
				Строки.Добавить("   не удалось посчитать: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Строки.Добавить("");

	// 4. Признак контракта в первичке
	Строки.Добавить("4. ПРИЗНАК КОНТРАКТА В ПЕРВИЧНЫХ ДОКУМЕНТАХ (п. 3 Правил), последние 3 месяца");
	Если С.ИмяСправочникаКонтракта <> "" Тогда
		ТипКонтракта = Тип("СправочникСсылка." + С.ИмяСправочникаКонтракта);
		Начало = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -3);
		Для Каждого ИмяДокумента Из СтрРазделить("ПоступлениеТоваровУслуг,ПриобретениеУслугПрочихАктивов,ПередачаМатериаловВПроизводство,"
			+ "ВнутреннееПотребление,ПроизводствоБезЗаказа,ЭтапПроизводства2_2,ВыпускПродукции,РеализацияТоваровУслуг,ЗаказНаПроизводство2_2,ЗаказКлиента", ",") Цикл
			Строки.Добавить("   " + ЗаполненностьКонтракта(ИмяДокумента, ТипКонтракта, С.ИмяСправочникаКонтракта, Начало));
		КонецЦикла;
		Рекомендации.Добавить("ВАЖНО. Признак контракта (направление деятельности с ИГК) должен быть в каждом документе по ГОЗ (п. 3 Правил). Где доля ниже 100% — настроить заполнение по умолчанию и проверку при проведении (расширение, см. ПРОЕКТ.md).");
	КонецЕсли;
	Строки.Добавить("");

	// 5. Закрытие месяца
	Строки.Добавить("5. ЗАКРЫТИЕ МЕСЯЦА (без него в регламентированном учёте нет фактических затрат)");
	ЗакрытыхМесяцев = 0;
	Для Н = 1 По 3 Цикл
		Мес = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -Н);
		Сумма20 = 0;
		Если С.ЕстьХозрасчетный И С.Счета.Счет20 <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ЕСТЬNULL(СУММА(О.СуммаОборотДт), 0) КАК Дт, ЕСТЬNULL(СУММА(О.СуммаОборотКт), 0) КАК Кт
				|ИЗ РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Счет), , , , ) КАК О";
			Запрос.УстановитьПараметр("Начало", Мес);
			Запрос.УстановитьПараметр("Конец", КонецМесяца(Мес));
			Запрос.УстановитьПараметр("Счет", С.Счета.Счет20);
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			Сумма20 = Выборка.Дт;
			Строки.Добавить("   " + Формат(Мес, "ДФ='MMMM yyyy'") + ": оборот Дт 20 = " + Формат(Выборка.Дт, "ЧДЦ=0; ЧН=0; ЧГ=3,0")
				+ ", Кт 20 = " + Формат(Выборка.Кт, "ЧДЦ=0; ЧН=0; ЧГ=3,0"));
		КонецЕсли;
		Если Сумма20 > 0 Тогда
			ЗакрытыхМесяцев = ЗакрытыхМесяцев + 1;
		КонецЕсли;
	КонецЦикла;
	Если ЗакрытыхМесяцев < 3 Тогда
		Рекомендации.Вставить(0, "СРОЧНО. Закрывать месяц в ERP каждый месяц (Финансовый результат и контроллинг → Закрытие месяца), включая «Отражение документов в регламентированном учёте». Без этого отчёт по ПП 874 будет пустым — ни типовой, ни этой обработкой.");
	КонецЕсли;
	Строки.Добавить("");

	// 6. Статьи
	Строки.Добавить("6. СТАТЬИ ERP И СОПОСТАВЛЕНИЕ С ПП 874");
	Настройки = ЗагрузитьНастройки();
	Сопоставлено = 0;
	Для Каждого СтрокаСоп Из Настройки.Сопоставление Цикл
		Если НЕ ПустаяСтрока(СтрокаСоп.Код) Тогда
			Сопоставлено = Сопоставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяСправочника Из С.ИменаСправочниковСтатей Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник." + ИмяСправочника + " КАК С ГДЕ НЕ С.ПометкаУдаления И НЕ С.ЭтоГруппа");
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			Строки.Добавить("   " + Метаданные.Справочники[ИмяСправочника].Синоним + ": " + Выборка.Всего + " статей");
		Исключение
			Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник." + ИмяСправочника + " КАК С ГДЕ НЕ С.ПометкаУдаления");
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			Строки.Добавить("   " + Метаданные.Справочники[ИмяСправочника].Синоним + ": " + Выборка.Всего + " статей");
		КонецПопытки;
	КонецЦикла;
	Строки.Добавить("   сопоставлено с кодами ПП 874 в настройках обработки: " + Сопоставлено);
	Если Сопоставлено = 0 Тогда
		Рекомендации.Добавить("ВАЖНО. Сопоставить статьи ERP с кодами 0101–1600 (закладка «Статьи»). Лучше — завести статьи калькуляции ERP один к одному по прил. 2 и хранить код в самой статье (расширение, см. ПРОЕКТ.md).");
	КонецЕсли;
	Строки.Добавить("");

	Строки.Вставить(4, "");
	Строки.Вставить(4, "ЧТО СДЕЛАТЬ (по важности):");
	Номер = 0;
	Для Каждого Рекомендация Из Рекомендации Цикл
		Номер = Номер + 1;
		Строки.Вставить(4 + Номер, "  " + Номер + ". " + Рекомендация);
	КонецЦикла;
	Строки.Вставить(5 + Номер, "");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СубконтоСчета(Счет)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВС.ВидСубконто КАК Вид
		|ИЗ
		|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ВС
		|ГДЕ
		|	ВС.Ссылка В ИЕРАРХИИ (&Счет)";
	Запрос.УстановитьПараметр("Счет", Счет);
	Имена = Новый Массив;
	Для Каждого Вид Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Вид") Цикл
		Имена.Добавить(Строка(Вид));
	КонецЦикла;
	Возврат ?(Имена.Количество() = 0, "нет", СтрСоединить(Имена, ", "));

КонецФункции

Функция ЗаполненностьКонтракта(ИмяДокумента, ТипКонтракта, ИмяСправочника, Начало)

	МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаДокумента = Неопределено Тогда
		Возврат ИмяДокумента + ": документа нет в конфигурации";
	КонецЕсли;
	ИмяРеквизита = "";
	Для Каждого Реквизит Из МетаДокумента.Реквизиты Цикл
		Если Реквизит.Тип.СодержитТип(ТипКонтракта) Тогда
			ИмяРеквизита = Реквизит.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИмяРеквизита = "" Тогда
		Возврат МетаДокумента.Синоним + ": в шапке нет реквизита-контракта";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА Д." + ИмяРеквизита + " = &Пусто ИЛИ Д." + ИмяРеквизита + " ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК Заполнено
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И Д.Дата >= &Начало";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Пусто", Справочники[ИмяСправочника].ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Всего = ?(Выборка.Всего = NULL, 0, Выборка.Всего);
	Заполнено = ?(Выборка.Заполнено = NULL, 0, Выборка.Заполнено);
	Возврат МетаДокумента.Синоним + " (" + ИмяРеквизита + "): " + Всего + " документов, контракт заполнен в " + Заполнено
		+ ?(Всего > 0, " (" + Формат(Заполнено / Всего * 100, "ЧДЦ=0") + "%)", "");

КонецФункции

Функция СравнитьВерсии(Версия1, Версия2)

	Ч1 = СтрРазделить(Версия1, ".");
	Ч2 = СтрРазделить(Версия2, ".");
	Для Н = 0 По Мин(Ч1.Количество(), Ч2.Количество()) - 1 Цикл
		Попытка
			А = Число(Ч1[Н]);
			Б = Число(Ч2[Н]);
		Исключение
			Возврат 0;
		КонецПопытки;
		Если А <> Б Тогда
			Возврат ?(А < Б, -1, 1);
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

#КонецОбласти

#Область ВыгрузкаДляАнализа

// Подробная выгрузка структуры учёта для настройки отчётов по ПП 874. Ничего не меняет в базе.
// Наименований нет: контракты, статьи, подразделения, договоры, организации и т.п. заменяются кодами
// «Контракт-3», «Статья калькуляции-12». Один объект в пределах файла всегда получает один код.
// Остаются: имена и синонимы объектов конфигурации, коды и названия счетов плана счетов,
// значения перечислений, имена предопределённых элементов ERP, суммы, количества и даты.
Функция ВыгрузкаДляАнализа(ПоказыватьНаименования) Экспорт

	П = Новый Структура("Показывать, Коды, Счетчики", ПоказыватьНаименования, Новый Соответствие, Новый Соответствие);
	Строки = Новый Массив;
	Если ПоказыватьНаименования Тогда
		Строки.Добавить("!!! В ФАЙЛЕ НАСТОЯЩИЕ НАИМЕНОВАНИЯ — НЕ ПЕРЕСЫЛАТЬ. Снимите галочку и сформируйте выгрузку заново.");
		Строки.Добавить("");
	КонецЕсли;
	Строки.Добавить("ВЫГРУЗКА ДЛЯ АНАЛИЗА — обработка «ГОЗ: затраты по ПП 874», версия " + ВерсияОбработки());
	Строки.Добавить("Наименования заменены кодами. Сформировано: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	Строки.Добавить("");
	Строки.Добавить("================ ЧАСТЬ 1. ПРОВЕРКА ГОТОВНОСТИ ================");
	Строки.Добавить(Диагностика());
	Строки.Добавить("");
	С = СтруктураУчета();
	Конец = КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	Начало = НачалоМесяца(ДобавитьМесяц(Конец, -5));
	Строки.Добавить("Период оборотов: " + Формат(Начало, "ДФ=dd.MM.yyyy") + " — " + Формат(Конец, "ДФ=dd.MM.yyyy"));
	Строки.Добавить("");

	Разделы = СтрРазделить("ВыгрузитьФункциональныеОпции,ВыгрузитьУчетнуюПолитику,ВыгрузитьОборотыСчетов,ВыгрузитьСтатьи,"
		+ "ВыгрузитьКонтракты,ВыгрузитьДокументы,ВыгрузитьРегистры", ",");
	Номер = 1;
	Для Каждого ИмяРаздела Из Разделы Цикл
		Номер = Номер + 1;
		Строки.Добавить("================ ЧАСТЬ " + Номер + " ================");
		Попытка
			Если ИмяРаздела = "ВыгрузитьФункциональныеОпции" Тогда
				ВыгрузитьФункциональныеОпции(Строки);
			ИначеЕсли ИмяРаздела = "ВыгрузитьУчетнуюПолитику" Тогда
				ВыгрузитьУчетнуюПолитику(Строки, П);
			ИначеЕсли ИмяРаздела = "ВыгрузитьОборотыСчетов" Тогда
				ВыгрузитьОборотыСчетов(Строки, С, Начало, Конец);
			ИначеЕсли ИмяРаздела = "ВыгрузитьСтатьи" Тогда
				ВыгрузитьСтатьи(Строки, С, Начало, Конец, П);
			ИначеЕсли ИмяРаздела = "ВыгрузитьКонтракты" Тогда
				ВыгрузитьКонтракты(Строки, С, Начало, Конец, П);
			ИначеЕсли ИмяРаздела = "ВыгрузитьДокументы" Тогда
				ВыгрузитьДокументы(Строки, С, ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -3));
			ИначеЕсли ИмяРаздела = "ВыгрузитьРегистры" Тогда
				ВыгрузитьРегистры(Строки);
			КонецЕсли;
		Исключение
			Строки.Добавить("   ! раздел не собрался: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Строки.Добавить("     " + СтрЗаменить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " | "));
		КонецПопытки;
		Строки.Добавить("");
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция КодЗначения(Значение, П)

	Если Значение = NULL ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "не указан";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаЗначения = Неопределено Тогда
		Возврат ?(П.Показывать, Строка(Значение), "значение");
	КонецЕсли;
	Если Метаданные.Перечисления.Содержит(МетаЗначения) ИЛИ Метаданные.ПланыСчетов.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если Метаданные.ПланыВидовХарактеристик.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение); // виды субконто — стандартные названия
	КонецЕсли;
	Предопределенный = "";
	Попытка
		Если Значение.Предопределенный Тогда
			Предопределенный = " [" + Значение.ИмяПредопределенныхДанных + "]";
		КонецЕсли;
	Исключение
		Предопределенный = "";
	КонецПопытки;
	Если П.Показывать Тогда
		Возврат Строка(Значение) + Предопределенный;
	КонецЕсли;
	Найдено = П.Коды[Значение];
	Если Найдено <> Неопределено Тогда
		Возврат Найдено;
	КонецЕсли;
	Вид = ВидДляКода(МетаЗначения);
	Номер = ?(П.Счетчики[Вид] = Неопределено, 0, П.Счетчики[Вид]) + 1;
	П.Счетчики.Вставить(Вид, Номер);
	Найдено = Вид + "-" + Номер + Предопределенный;
	П.Коды.Вставить(Значение, Найдено);
	Возврат Найдено;

КонецФункции

Функция ВидДляКода(МетаЗначения)

	Имена = Новый Соответствие;
	Имена.Вставить("НаправленияДеятельности", "Контракт");
	Имена.Вставить("ДоговорыКонтрагентов", "Договор");
	Имена.Вставить("СтатьиКалькуляции", "Статья калькуляции");
	Имена.Вставить("СтатьиРасходов", "Статья расходов");
	Имена.Вставить("СтруктураПредприятия", "Подразделение");
	Имена.Вставить("Организации", "Организация");
	Имена.Вставить("БанковскиеСчетаОрганизаций", "Банковский счёт");
	Имена.Вставить("Номенклатура", "Номенклатура");
	Имена.Вставить("УчетныеПолитикиОрганизаций", "Учётная политика");
	Вид = Имена[МетаЗначения.Имя];
	Возврат ?(Вид = Неопределено, МетаЗначения.Имя, Вид);

КонецФункции

Функция ФорматЧисла(Число)

	Возврат Формат(Число, "ЧДЦ=0; ЧН=0; ЧГ=3,0");

КонецФункции

Функция Колонка(Знач Текст, Ширина)

	Текст = Лев(Строка(Текст), Ширина);
	Возврат Текст + Лев("                                                                                ", Макс(0, Ширина - СтрДлина(Текст)));

КонецФункции

Процедура ВыгрузитьФункциональныеОпции(Строки)

	Строки.Добавить("ФУНКЦИОНАЛЬНЫЕ ОПЦИИ ERP (учёт затрат, себестоимость, производство, зарплата, ГОЗ)");
	Слова = СтрРазделить("затрат,себестоим,партион,направлен,гоз,оборон,зарплат,сдельн,производств,регламент,детализ,подразделен,распредел,наряд,выработ,калькуляц", ",");
	Для Каждого МетаОпции Из Метаданные.ФункциональныеОпции Цикл
		ИмяОпции = НРег(МетаОпции.Имя);
		Подходит = Ложь;
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(ИмяОпции, Слово) > 0 Тогда
				Подходит = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Подходит Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значение = ПолучитьФункциональнуюОпцию(МетаОпции.Имя);
			Текст = ?(ТипЗнч(Значение) = Тип("Булево"), ?(Значение, "да", "нет"), Строка(Значение));
		Исключение
			Текст = "(с параметрами)";
		КонецПопытки;
		Строки.Добавить("   " + Колонка(МетаОпции.Имя, 60) + Текст);
	КонецЦикла;

КонецПроцедуры

Процедура ВыгрузитьУчетнуюПолитику(Строки, П)

	Строки.Добавить("УЧЁТНАЯ ПОЛИТИКА (только флажки, перечисления и числа)");
	Для Каждого ИмяСправочника Из СтрРазделить("УчетныеПолитикиОрганизаций,НастройкиСистемыНалогообложения", ",") Цикл
		МетаСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
		Если МетаСправочника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Выборка = Справочники[ИмяСправочника].Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить("   " + МетаСправочника.Синоним + ": " + КодЗначения(Выборка.Ссылка, П));
			Для Каждого Реквизит Из МетаСправочника.Реквизиты Цикл
				Значение = Выборка[Реквизит.Имя];
				ТипЗначения = ТипЗнч(Значение);
				МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
				Если ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Число")
					ИЛИ (МетаЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаЗначения)) Тогда
					Строки.Добавить("      " + Колонка(Реквизит.Имя, 60) + Строка(Значение));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	// регистры сведений с учётной политикой — только имена и периодичность
	Для Каждого МетаРегистра Из Метаданные.РегистрыСведений Цикл
		Если СтрНайти(МетаРегистра.Имя, "УчетнаяПолитика") > 0 ИЛИ СтрНайти(МетаРегистра.Имя, "НастройкиУчета") > 0 Тогда
			Строки.Добавить("   регистр " + МетаРегистра.Имя + ": измерения " + ИменаПолей(МетаРегистра.Измерения) + "; ресурсы " + ИменаПолей(МетаРегистра.Ресурсы));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Обороты по парам счетов Дт/Кт по месяцам: видно, куда закрываются 25 и 26, как отражается зарплата, есть ли 20 → 43 → 90.02.
Процедура ВыгрузитьОборотыСчетов(Строки, С, Начало, Конец)

	Строки.Добавить("ОБОРОТЫ ПО ПАРАМ СЧЕТОВ (по месяцам, руб.), регламентированный учёт");
	Если НЕ С.ЕстьХозрасчетный Тогда
		Строки.Добавить("   нет плана счетов Хозрасчетный");
		Возврат;
	КонецЕсли;
	Счета = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Счет20,Счет21,Счет23,Счет25,Счет26,Счет43,Счет90_02,Счет90_07,Счет90_08", ",") Цикл
		Если С.Счета[Имя] <> Неопределено Тогда
			Счета.Добавить(С.Счета[Имя]);
		КонецЕсли;
	КонецЦикла;
	Месяцы = Новый Массив;
	Мес = Начало;
	Пока Мес <= Конец Цикл
		Месяцы.Добавить(Мес);
		Мес = ДобавитьМесяц(Мес, 1);
	КонецЦикла;
	Для Каждого Сторона Из СтрРазделить("Дт,Кт", ",") Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	О.Период КАК Период,
			|	О.СчетДт.Код КАК Дт,
			|	О.СчетКт.Код КАК Кт,
			|	СУММА(О.СуммаОборот) КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&Начало, &Конец, Месяц, "
			+ ?(Сторона = "Дт", "Счет" + "Дт В ИЕРАРХИИ (&Счета), , , , ", ", , Счет" + "Кт В ИЕРАРХИИ (&Счета), , ") + ") КАК О
			|СГРУППИРОВАТЬ ПО
			|	О.Период,
			|	О.СчетДт.Код,
			|	О.СчетКт.Код";
		Запрос.УстановитьПараметр("Начало", Начало);
		Запрос.УстановитьПараметр("Конец", Конец);
		Запрос.УстановитьПараметр("Счета", Счета);
		Таблица = Запрос.Выполнить().Выгрузить();
		Строки.Добавить("   " + ?(Сторона = "Дт", "Дебет счетов 20, 21, 23, 25, 26, 43, 90.02, 90.07, 90.08", "Кредит счетов 20, 21, 23, 25, 26, 43, 90.02, 90.07, 90.08"));
		Шапка = "   " + Колонка("Дт", 10) + Колонка("Кт", 10);
		Для Каждого Мес Из Месяцы Цикл
			Шапка = Шапка + Колонка(Формат(Мес, "ДФ=MM.yy"), 14);
		КонецЦикла;
		Строки.Добавить(Шапка);
		Пары = Таблица.Скопировать(, "Дт, Кт");
		Пары.Свернуть("Дт, Кт");
		Пары.Сортировать("Дт, Кт");
		Для Каждого Пара Из Пары Цикл
			Текст = "   " + Колонка(Пара.Дт, 10) + Колонка(Пара.Кт, 10);
			Для Каждого Мес Из Месяцы Цикл
				Сумма = 0;
				Для Каждого СтрокаТ Из Таблица.НайтиСтроки(Новый Структура("Дт, Кт", Пара.Дт, Пара.Кт)) Цикл
					Если НачалоМесяца(СтрокаТ.Период) = Мес Тогда
						Сумма = Сумма + СтрокаТ.Сумма;
					КонецЕсли;
				КонецЦикла;
				Текст = Текст + Колонка(?(Сумма = 0, "·", ФорматЧисла(Сумма)), 14);
			КонецЦикла;
			Строки.Добавить(Текст);
		КонецЦикла;
		Если Пары.Количество() = 0 Тогда
			Строки.Добавить("   оборотов нет");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Статьи калькуляции и расходов: реквизиты справочника, коды-заменители, предложенный код ПП 874, обороты на 20/25/26/90.08.
Процедура ВыгрузитьСтатьи(Строки, С, Начало, Конец, П)

	Строки.Добавить("СТАТЬИ КАЛЬКУЛЯЦИИ И РАСХОДОВ");
	Настройки = ЗагрузитьНастройки();
	Обороты = Новый Соответствие; // Статья -> Структура(Д20, Д25, Д26, Д90)
	Для Каждого Пара Из СтрРазделить("Д20:Счет20:ВидСтатьи20,Д25:Счет25:ВидСтатьи25,Д26:Счет26:ВидСтатьи26,Д90:Счет90_08:ВидСтатьи90", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Счет = С.Счета[Части[1]];
		Вид = С[Части[2]];
		Если Счет = Неопределено ИЛИ Вид = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виды = Новый Массив;
		Виды.Добавить(Вид);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ О.Субконто1 КАК Статья, СУММА(О.СуммаОборотДт) КАК Сумма
			|ИЗ РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Счет), &Виды, , , ) КАК О
			|СГРУППИРОВАТЬ ПО О.Субконто1";
		Запрос.УстановитьПараметр("Начало", Начало);
		Запрос.УстановитьПараметр("Конец", Конец);
		Запрос.УстановитьПараметр("Счет", Счет);
		Запрос.УстановитьПараметр("Виды", Виды);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = ?(Выборка.Статья = NULL, "пусто", Выборка.Статья);
			Если Обороты[Ключ] = Неопределено Тогда
				Обороты.Вставить(Ключ, Новый Структура("Д20, Д25, Д26, Д90", 0, 0, 0, 0));
			КонецЕсли;
			Обороты[Ключ][Части[0]] = Обороты[Ключ][Части[0]] + ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
		КонецЦикла;
	КонецЦикла;

	Для Каждого ИмяСправочника Из С.ИменаСправочниковСтатей Цикл
		МетаСправочника = Метаданные.Справочники[ИмяСправочника];
		Строки.Добавить("   Справочник " + МетаСправочника.Синоним + " (" + ИмяСправочника + "); реквизиты: " + ИменаПолей(МетаСправочника.Реквизиты));
		Строки.Добавить("   " + Колонка("Код статьи", 32) + Колонка("ПП874 предл.", 13) + Колонка("ПП874 в настр.", 15) + Колонка("Дт 20", 14) + Колонка("Дт 25", 14)
			+ Колонка("Дт 26", 14) + Колонка("Дт 90.08", 14) + "Перечисления и флажки статьи");
		Выборка = Справочники[ИмяСправочника].Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Если Выборка.ЭтоГруппа Тогда
					Продолжить;
				КонецЕсли;
			Исключение
				// справочник без групп
			КонецПопытки;
			Сохраненная = Настройки.Сопоставление.Найти(Выборка.Ссылка, "Статья");
			Об = Обороты[Выборка.Ссылка];
			Свойства = Новый Массив;
			Для Каждого Реквизит Из МетаСправочника.Реквизиты Цикл
				Значение = Выборка[Реквизит.Имя];
				МетаЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
				Если ТипЗнч(Значение) = Тип("Булево") И Значение Тогда
					Свойства.Добавить(Реквизит.Имя);
				ИначеЕсли МетаЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаЗначения) И ЗначениеЗаполнено(Значение) Тогда
					Свойства.Добавить(Реквизит.Имя + "=" + Строка(Значение));
				ИначеЕсли МетаЗначения <> Неопределено И Метаданные.ПланыСчетов.Содержит(МетаЗначения) И ЗначениеЗаполнено(Значение) Тогда
					Свойства.Добавить(Реквизит.Имя + "=" + Значение.Код);
				КонецЕсли;
			КонецЦикла;
			Строки.Добавить("   " + Колонка(КодЗначения(Выборка.Ссылка, П), 32) + Колонка(ПредложитьКод(Выборка.Наименование), 13)
				+ Колонка(?(Сохраненная = Неопределено, "", Лев(Сохраненная.Код, 4) + ?(Сохраненная.Обособленно, " об", "")), 15)
				+ Колонка(?(Об = Неопределено, "·", ФорматЧисла(Об.Д20)), 14) + Колонка(?(Об = Неопределено, "·", ФорматЧисла(Об.Д25)), 14)
				+ Колонка(?(Об = Неопределено, "·", ФорматЧисла(Об.Д26)), 14) + Колонка(?(Об = Неопределено, "·", ФорматЧисла(Об.Д90)), 14)
				+ СтрСоединить(Свойства, ", "));
		КонецЦикла;
	КонецЦикла;
	Если Обороты["пусто"] <> Неопределено Тогда
		Об = Обороты["пусто"];
		Строки.Добавить("   БЕЗ СТАТЬИ: Дт 20 " + ФорматЧисла(Об.Д20) + ", Дт 25 " + ФорматЧисла(Об.Д25) + ", Дт 26 " + ФорматЧисла(Об.Д26) + ", Дт 90.08 " + ФорматЧисла(Об.Д90));
	КонецЕсли;

КонецПроцедуры

// Контракты (направления деятельности или договоры): ИГК есть/нет и формат, отдельный счёт, затраты, отгрузки.
Процедура ВыгрузитьКонтракты(Строки, С, Начало, Конец, П)

	Строки.Добавить("КОНТРАКТЫ");
	Если С.ИмяСправочникаКонтракта = "" Тогда
		Строки.Добавить("   справочник контрактов на счёте 20 не найден");
		Возврат;
	КонецЕсли;
	МетаКонтракта = Метаданные.Справочники[С.ИмяСправочникаКонтракта];
	ИмяИГК = ИмяРеквизитаИГК(МетаКонтракта);
	Строки.Добавить("   Справочник " + МетаКонтракта.Синоним + "; реквизиты: " + ИменаПолей(МетаКонтракта.Реквизиты));
	Если МетаКонтракта.ТабличныеЧасти.Количество() > 0 Тогда
		Для Каждого МетаТЧ Из МетаКонтракта.ТабличныеЧасти Цикл
			Строки.Добавить("   табличная часть " + МетаТЧ.Имя + ": " + ИменаПолей(МетаТЧ.Реквизиты));
		КонецЦикла;
	КонецЕсли;
	Прямые = ПрямыеЗатраты(Начало, Конец, НовыеНастройки(), С);
	ЗатратыПо = Новый Соответствие;
	БезКонтракта = 0;
	Для Каждого СтрокаТ Из Прямые Цикл
		Если ЗначениеЗаполнено(СтрокаТ.Контракт) Тогда
			ЗатратыПо[СтрокаТ.Контракт] = ?(ЗатратыПо[СтрокаТ.Контракт] = Неопределено, 0, ЗатратыПо[СтрокаТ.Контракт]) + СтрокаТ.Сумма;
		Иначе
			БезКонтракта = БезКонтракта + СтрокаТ.Сумма;
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("   " + Колонка("Код", 22) + Колонка("ИГК", 20) + Колонка("Дт 20 за период", 18) + "Ссылочные и флажковые реквизиты (заполнены)");
	Выборка = Справочники[С.ИмяСправочникаКонтракта].Выбрать();
	Всего = 0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			// без групп
		КонецПопытки;
		Всего = Всего + 1;
		Если Всего > 300 Тогда
			Строки.Добавить("   ... дальше не выводится (больше 300)");
			Прервать;
		КонецЕсли;
		ТекстИГК = "нет реквизита";
		Если ИмяИГК <> "" Тогда
			ЗначениеИГК = СокрЛП(Строка(Выборка[ИмяИГК]));
			ТекстИГК = ?(ЗначениеИГК = "", "пусто", "есть, " + СтрДлина(ЗначениеИГК) + " симв.");
		КонецЕсли;
		Заполнены = Новый Массив;
		Для Каждого Реквизит Из МетаКонтракта.Реквизиты Цикл
			Значение = Выборка[Реквизит.Имя];
			Если ТипЗнч(Значение) = Тип("Булево") Тогда
				Если Значение Тогда
					Заполнены.Добавить(Реквизит.Имя);
				КонецЕсли;
			ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") И ТипЗнч(Значение) <> Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
				МетаЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
				Заполнены.Добавить(Реквизит.Имя + ?(МетаЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаЗначения), "=" + Строка(Значение), ""));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить("   " + Колонка(КодЗначения(Выборка.Ссылка, П), 22) + Колонка(ТекстИГК, 20)
			+ Колонка(?(ЗатратыПо[Выборка.Ссылка] = Неопределено, "·", ФорматЧисла(ЗатратыПо[Выборка.Ссылка])), 18) + СтрСоединить(Заполнены, ", "));
	КонецЦикла;
	Строки.Добавить("   Дт 20 без контракта за период: " + ФорматЧисла(БезКонтракта));

КонецПроцедуры

// Документы: сколько проведено за 3 месяца и как заполнены контракт, статьи, подразделения в шапке и строках.
Процедура ВыгрузитьДокументы(Строки, С, Начало)

	Строки.Добавить("ДОКУМЕНТЫ ЗА 3 МЕСЯЦА: заполненность контракта, статей и подразделений (шапка и табличные части)");
	ТипыИнтереса = Новый Массив;
	ИменаТипов = Новый Массив;
	Если С.ИмяСправочникаКонтракта <> "" Тогда
		ИменаТипов.Добавить(С.ИмяСправочникаКонтракта);
	КонецЕсли;
	Для Каждого ИмяСправочника Из С.ИменаСправочниковСтатей Цикл
		ИменаТипов.Добавить(ИмяСправочника);
	КонецЦикла;
	Для Каждого ИмяСправочника Из СтрРазделить("СтруктураПредприятия,ПодразделенияОрганизаций", ",") Цикл
		Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
			ИменаТипов.Добавить(ИмяСправочника);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяСправочника Из ИменаТипов Цикл
		ТипыИнтереса.Добавить(Тип("СправочникСсылка." + ИмяСправочника));
	КонецЦикла;

	ИменаДокументов = СтрРазделить("ПоступлениеТоваровУслуг,ПриобретениеУслугПрочихАктивов,ПередачаМатериаловВПроизводство,ВнутреннееПотребление,"
		+ "ПроизводствоБезЗаказа,ЭтапПроизводства2_2,ВыпускПродукции,ЗаказНаПроизводство2_2,ЗаказКлиента,РеализацияТоваровУслуг,"
		+ "РаспределениеПроизводственныхЗатрат,РаспределениеПрочихЗатрат,РасчетСебестоимостиТоваров,ОтражениеЗарплатыВФинансовомУчете", ",");
	Слова = СтрРазделить("Зарплат,Наряд,Выработк,Начислени,Сдельн,Табел", ",");
	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(МетаДокумента.Имя, Слово) > 0 И ИменаДокументов.Найти(МетаДокумента.Имя) = Неопределено Тогда
				ИменаДокументов.Добавить(МетаДокумента.Имя);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Документ." + ИмяДокумента + " КАК Д ГДЕ Д.Проведен И Д.Дата >= &Начало");
		Запрос.УстановитьПараметр("Начало", Начало);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Если Выборка.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("   " + МетаДокумента.Синоним + " (" + ИмяДокумента + "): проведено " + Выборка.Всего);
		Для Каждого Реквизит Из МетаДокумента.Реквизиты Цикл
			Если ЭтоТипИнтереса(Реквизит.Тип, ТипыИнтереса) Тогда
				Строки.Добавить("      шапка." + Реквизит.Имя + ": " + Заполненность("Документ." + ИмяДокумента, "Т", Реквизит, "Т.Проведен И Т.Дата >= &Начало", Начало));
			КонецЕсли;
		КонецЦикла;
		Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
			Для Каждого Реквизит Из МетаТЧ.Реквизиты Цикл
				Если ЭтоТипИнтереса(Реквизит.Тип, ТипыИнтереса) Тогда
					Строки.Добавить("      " + МетаТЧ.Имя + "." + Реквизит.Имя + ": " + Заполненность("Документ." + ИмяДокумента + "." + МетаТЧ.Имя, "Т", Реквизит,
						"Т.Ссылка.Проведен И Т.Ссылка.Дата >= &Начало", Начало));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоТипИнтереса(ОписаниеТипа, ТипыИнтереса)

	Для Каждого ТипИнтереса Из ТипыИнтереса Цикл
		Если ОписаниеТипа.СодержитТип(ТипИнтереса) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Заполненность(ИмяТаблицы, Псевдоним, Реквизит, Условие, Начало)

	Пусто = Реквизит.Тип.ПривестиЗначение(Неопределено);
	Поле = Псевдоним + "." + Реквизит.Имя;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА " + Поле + " ЕСТЬ NULL ТОГДА 0 КОГДА " + Поле + " = &Пусто ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК Заполнено
		|ИЗ
		|	" + ИмяТаблицы + " КАК " + Псевдоним + "
		|ГДЕ
		|	" + Условие;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Пусто", Пусто);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Всего = ?(Выборка.Всего = NULL, 0, Выборка.Всего);
		Заполнено = ?(Выборка.Заполнено = NULL, 0, Выборка.Заполнено);
		Возврат "строк " + Всего + ", заполнено " + Заполнено + ?(Всего > 0, " (" + Формат(Заполнено / Всего * 100, "ЧДЦ=0; ЧН=0") + "%)", "");
	Исключение
		Возврат "не посчиталось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Структура регистров себестоимости, затрат, выручки и зарплаты — только имена полей (без данных).
Процедура ВыгрузитьРегистры(Строки)

	Строки.Добавить("СТРУКТУРА РЕГИСТРОВ (имена полей, без данных)");
	Слова = СтрРазделить("Себестоим,Затрат,Выручк,Партии,Зарплат,Начислен,Калькуляц,Выработк,Распредел", ",");
	Для Каждого МетаРегистра Из Метаданные.РегистрыНакопления Цикл
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(МетаРегистра.Имя, Слово) > 0 Тогда
				Строки.Добавить("   РН." + МетаРегистра.Имя + ": измерения " + ИменаПолей(МетаРегистра.Измерения) + "; ресурсы " + ИменаПолей(МетаРегистра.Ресурсы)
					+ "; реквизиты " + ИменаПолей(МетаРегистра.Реквизиты));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого МетаРегистра Из Метаданные.РегистрыСведений Цикл
		Если СтрНайти(МетаРегистра.Имя, "Распредел") > 0 ИЛИ СтрНайти(МетаРегистра.Имя, "Калькуляц") > 0 ИЛИ СтрНайти(МетаРегистра.Имя, "ГОЗ") > 0
			ИЛИ СтрНайти(МетаРегистра.Имя, "СпособыОтражения") > 0 Тогда
			Строки.Добавить("   РС." + МетаРегистра.Имя + ": измерения " + ИменаПолей(МетаРегистра.Измерения) + "; ресурсы " + ИменаПолей(МетаРегистра.Ресурсы));
		КонецЕсли;
	КонецЦикла;
	МетаХозрасчетный = Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный");
	Если МетаХозрасчетный <> Неопределено Тогда
		Строки.Добавить("   РБ.Хозрасчетный: измерения " + ИменаПолей(МетаХозрасчетный.Измерения) + "; ресурсы " + ИменаПолей(МетаХозрасчетный.Ресурсы)
			+ "; макс. субконто " + Метаданные.ПланыСчетов.Хозрасчетный.МаксКоличествоСубконто);
	КонецЕсли;
	Для Каждого МетаСправочника Из Метаданные.Справочники Цикл
		Если СтрНайти(МетаСправочника.Имя, "Распредел") > 0 ИЛИ СтрНайти(МетаСправочника.Имя, "ГОЗ") > 0 ИЛИ СтрНайти(МетаСправочника.Имя, "Калькуляц") > 0
			ИЛИ СтрНайти(МетаСправочника.Имя, "ГосударственныеКонтракты") > 0 ИЛИ СтрНайти(МетаСправочника.Имя, "СпособыОтражения") > 0 Тогда
			Строки.Добавить("   Справочник." + МетаСправочника.Имя + ": реквизиты " + ИменаПолей(МетаСправочника.Реквизиты));
		КонецЕсли;
	КонецЦикла;

