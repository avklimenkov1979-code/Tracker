#Область Расчет

// Код ПП 874 для строки проводки: сначала по статье, потом по счёту кредита.
Функция КодСтроки(Статья, СчетКт, Сопоставление, С)

	Если ЗначениеЗаполнено(СчетКт) Тогда
		Если С.Счета.Счет25 <> Неопределено И СчетВИерархии(СчетКт, С.Счета.Счет25) Тогда
			Возврат Новый Структура("Код, Обособленно, Привнесенная", "0800", Ложь, Ложь);
		КонецЕсли;
		Если С.Счета.Счет26 <> Неопределено И СчетВИерархии(СчетКт, С.Счета.Счет26) Тогда
			Возврат Новый Структура("Код, Обособленно, Привнесенная", "0900", Ложь, Ложь);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Статья) Тогда
		Найдено = Сопоставление.Найти(Статья, "Статья");
		Если Найдено <> Неопределено И НЕ ПустаяСтрока(Найдено.Код) Тогда
			Возврат Новый Структура("Код, Обособленно, Привнесенная", Лев(Найдено.Код, 4), Найдено.Обособленно, Найдено.Привнесенная);
		КонецЕсли;
	КонецЕсли;
	Код = "1100";
	Если ЗначениеЗаполнено(СчетКт) Тогда
		КодСчета = Лев(СчетКт.Код, 2);
		Если КодСчета = "10" ИЛИ КодСчета = "41" Тогда
			Код = "0101";
		ИначеЕсли КодСчета = "21" Тогда
			Код = "0110";
		ИначеЕсли КодСчета = "69" Тогда
			Код = "0300";
		ИначеЕсли КодСчета = "70" Тогда
			Код = "0201";
		ИначеЕсли КодСчета = "60" Тогда
			Код = "0105";
		ИначеЕсли КодСчета = "71" Тогда
			Код = "1000";
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Код, Обособленно, Привнесенная", Код, Ложь, ПривнесеннаяПоУмолчанию(Код));

