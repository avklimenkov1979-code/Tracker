// Модуль объекта внешней обработки «ГОЗ: затраты по ПП 874» (1С:ERP 2.5).
//
// Здесь вся серверная логика: поиск структуры учёта в базе, диагностика готовности,
// сопоставление статей ERP со статьями калькуляции ПП РФ № 874 (прил. 2),
// расчёт Справки о распределении затрат (прил. 3) и Отчёта о фактических затратах (прил. 1).
// Форма только вызывает эти функции. Регламентная команда «Комплект за прошлый месяц»
// вызывается БСП по расписанию (Дополнительные отчёты и обработки → Расписание).
//
// Источник данных — регламентированный учёт (РегистрБухгалтерии.Хозрасчетный):
// Правила требуют сопоставимости отчёта с бухгалтерским учётом (п. 5 Правил).
// Поэтому суммы появляются только после закрытия месяца в ERP.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Регистрация

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Информация = "Отчёт о фактических затратах по контракту ГОЗ и справка о распределении затрат по ПП РФ № 874.";

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "ГОЗ: затраты по ПП 874";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "ГОЗ: комплект отчётов за прошлый месяц в папку (по расписанию)";
	Команда.Идентификатор = "КомплектЗаПрошлыйМесяц";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Вызывается БСП для команды «КомплектЗаПрошлыйМесяц», в том числе по расписанию.
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения) Экспорт

	Если ИдентификаторКоманды <> "КомплектЗаПрошлыйМесяц" Тогда
		Возврат;
	КонецЕсли;
	Настройки = ЗагрузитьНастройки();
	Если ПустаяСтрока(Настройки.ПапкаВыгрузки) Тогда
		ВызватьИсключение "ГОЗ 874: в настройках обработки не указана папка на сервере для комплекта отчётов.";
	КонецЕсли;
	Месяц = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -1);
	Итог = СохранитьКомплектВПапку(Месяц, Настройки, Настройки.ПапкаВыгрузки);
	ЗаписьЖурналаРегистрации("ГОЗ 874", УровеньЖурналаРегистрации.Информация, , , Итог);

КонецПроцедуры

Функция ВерсияОбработки() Экспорт

	Возврат "1.2";

КонецФункции

#КонецОбласти

#Область СтатьиПП874

// Статьи калькуляции по прил. 2 к Правилам (ПП РФ от 13.07.2026 № 874).
// Итог = Истина — строка считается из других строк, сопоставлять её со статьями ERP не нужно.
