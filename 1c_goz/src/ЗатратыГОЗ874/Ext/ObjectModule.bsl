Функция НовыеНастройки() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Сопоставление", НоваяТаблицаСопоставления());
	Настройки.Вставить("АУРВСебестоимость", Истина); // сноска 2 к прил. 2: 26 → 90.08, статья 1600, а 0900 не применяется
	Настройки.Вставить("НачалоУчета", Дата(2027, 1, 1)); // п. 41 Правил: с этой даты детализация по новым правилам
	Настройки.Вставить("ПапкаВыгрузки", "");
	Настройки.Вставить("Организация", Неопределено);
	Возврат Настройки;

