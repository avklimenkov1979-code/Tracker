	Правила.Добавить("оснастк|0500");
	Правила.Добавить("специальн|0700");
	Правила.Добавить("общепроизводств|0800");
	Правила.Добавить("опр|0800");
	Правила.Добавить("общехозяйств|0900");
	Правила.Добавить("охр|0900");
	Правила.Добавить("командиров|1000");
	Правила.Добавить("коммерческ|1400");
	Правила.Добавить("сбыт|1400");
	Правила.Добавить("процент|1500");
	Правила.Добавить("административ|1600");
	Правила.Добавить("управленческ|1600");
	Правила.Добавить("аур|1600");
	Правила.Добавить("сторонн|0105");
	Правила.Добавить("услуг|0105");
	Правила.Добавить("окраск|0105");
	Правила.Добавить("гальван|0105");
	Правила.Добавить("заработн|0201");
	Правила.Добавить("зарплат|0201");
	Правила.Добавить("оплата труда|0201");
