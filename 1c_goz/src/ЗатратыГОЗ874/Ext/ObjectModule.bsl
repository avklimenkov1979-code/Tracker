#Область Справка

// Справка по результатам распределения затрат за месяц (прил. 3). Возвращает структуру:
// Документ — ТабличныйДокумент; Расхождения — массив строк (нужна пояснительная записка, п. 2 правил заполнения).
Функция СправкаПрил3(Месяц, Настройки) Экспорт

	С = СтруктураУчета();
	Начало = НачалоМесяца(Месяц);
	Конец = КонецМесяца(Месяц);
	Прямые = ПрямыеЗатраты(Начало, Конец, Настройки, С);

	// база распределения: основная зарплата основных работников (0201) по контрактам
	База = Новый Соответствие;
	БазаВсего = 0;
	БазаПрочие = 0;
	ФактОПР = Новый Соответствие;
	ФактОХР = Новый Соответствие;
	Для Каждого Стр Из Прямые Цикл
		Ключ = ?(КонтрактГОЗ(Стр.Контракт), Стр.Контракт, "Прочие");
		Если Стр.Код = "0201" И НЕ Стр.Обособленно Тогда
			База[Ключ] = ?(База[Ключ] = Неопределено, 0, База[Ключ]) + Стр.Сумма;
			БазаВсего = БазаВсего + Стр.Сумма;
		ИначеЕсли Стр.Код = "0800" Тогда
			ФактОПР[Ключ] = ?(ФактОПР[Ключ] = Неопределено, 0, ФактОПР[Ключ]) + Стр.Сумма;
		ИначеЕсли Стр.Код = "0900" Тогда
			ФактОХР[Ключ] = ?(ФактОХР[Ключ] = Неопределено, 0, ФактОХР[Ключ]) + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	ОПР = ОборотДтСчета(С.Счета.Счет25, Начало, Конец, Настройки, С, С.ВидСтатьи25);
	ОХР = ОборотДтСчета(С.Счета.Счет26, Начало, Конец, Настройки, С, С.ВидСтатьи26);
	ОПРВсего = 0;
	Для Каждого Стр Из ОПР Цикл
		Если НЕ ЭтоОбособленная(Стр.Статья, Настройки.Сопоставление) Тогда
			ОПРВсего = ОПРВсего + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	ОХРВсего = 0;
	ОХРПоСтатьям = Новый Соответствие;
	Для Каждого Стр Из ОХР Цикл
		Если НЕ ЭтоОбособленная(Стр.Статья, Настройки.Сопоставление) Тогда
			ОХРВсего = ОХРВсего + Стр.Сумма;
			Ключ = ?(ЗначениеЗаполнено(Стр.Статья), Стр.Статья, "Без статьи");
			ОХРПоСтатьям[Ключ] = ?(ОХРПоСтатьям[Ключ] = Неопределено, 0, ОХРПоСтатьям[Ключ]) + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	ТД = Новый ТабличныйДокумент;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Вывод = НовыйВывод(ТД);
	ВывестиСтроку(Вывод, "ПРИЛОЖЕНИЕ № 3 к Правилам калькулирования себестоимости продукции, поставляемой по ГОЗ (ПП РФ от 13.07.2026 № 874)", Ложь, Истина);
	ВывестиСтроку(Вывод, "СПРАВКА по результатам распределения затрат организации, выполняющей государственный оборонный заказ, за месяц", Истина);
	ВывестиСтроку(Вывод, "за " + Формат(Начало, "ДФ='MMMM yyyy'") + " г.", Истина);
	ВывестиСтроку(Вывод, "База распределения: основная заработная плата основных работников (п. 28 Правил).", Ложь, Истина);
	ВывестиСтроку(Вывод, "");

	// Таблица 1
	ВывестиСтроку(Вывод, "Основной раздел. Таблица 1", Истина);
	Заголовки = СтрРазделить("№|Объект калькулирования (ИГК)|Основная зарплата основных работников, руб.|Коэффициент распределения|Общепроизводственные затраты, руб.|Общехозяйственные затраты и АУР, руб.", "|");
	Строки = Новый Массив;
	Номер = 0;
	Для Каждого КлючИЗначение Из База Цикл
		Если КлючИЗначение.Ключ = "Прочие" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		Коэф = ?(БазаВсего = 0, 0, КлючИЗначение.Значение / БазаВсего);
		Строки.Добавить(МассивЗначений(Номер, ИГК(КлючИЗначение.Ключ), КлючИЗначение.Значение, Коэф, ОПРВсего * Коэф, ОХРВсего * Коэф));
	КонецЦикла;
	Если База["Прочие"] <> Неопределено Тогда
		Номер = Номер + 1;
		Коэф = ?(БазаВсего = 0, 0, База["Прочие"] / БазаВсего);
		Строки.Добавить(МассивЗначений(Номер, "Прочая продукция", База["Прочие"], Коэф, ОПРВсего * Коэф, ОХРВсего * Коэф));
	КонецЕсли;
	Строки.Добавить(МассивЗначений("", "Всего", БазаВсего, ?(БазаВсего = 0, 0, 1), ОПРВсего, ОХРВсего));
	ВывестиТаблицу(Вывод, Заголовки, Строки, "4,40,20,14,20,20");
	ВывестиСтроку(Вывод, "");

	// Таблица 2 — по подразделениям (если подразделения ведутся на 25 счёте)
	ВывестиСтроку(Вывод, "Аналитика распределения общепроизводственных затрат по структурным подразделениям. Таблица 2", Истина);
	Если С.ВидПодразделения25 = Неопределено Тогда
		ВывестиСтроку(Вывод, "На счёте 25 подразделения не ведутся: таблица не заполняется (п. 32 Правил: в зависимости от наличия подразделений и технической возможности).", Ложь, Истина);
	Иначе
		ОПРПодр = Новый Соответствие;
		Для Каждого Стр Из ОПР Цикл
			Если НЕ ЭтоОбособленная(Стр.Статья, Настройки.Сопоставление) Тогда
				Ключ = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, "Без подразделения");
				ОПРПодр[Ключ] = ?(ОПРПодр[Ключ] = Неопределено, 0, ОПРПодр[Ключ]) + Стр.Сумма;
			КонецЕсли;
		КонецЦикла;
		Заголовки = СтрРазделить("№|Объект калькулирования (ИГК)|Структурное подразделение|Основная зарплата основных работников, руб.|Коэффициент распределения|Распределяемые косвенные затраты, руб.", "|");
		Строки = Новый Массив;
		Номер = 0;
		Для Каждого КлючИЗначение Из База Цикл
			Номер = Номер + 1;
			Коэф = ?(БазаВсего = 0, 0, КлючИЗначение.Значение / БазаВсего);
			ОбъектКальк = ?(КлючИЗначение.Ключ = "Прочие", "Прочая продукция", ИГК(КлючИЗначение.Ключ));
			Для Каждого Подр Из ОПРПодр Цикл
				Строки.Добавить(МассивЗначений(Номер, ОбъектКальк, Строка(Подр.Ключ), КлючИЗначение.Значение, Коэф, Подр.Значение * Коэф));
			КонецЦикла;
		КонецЦикла;
		Для Каждого Подр Из ОПРПодр Цикл
			Строки.Добавить(МассивЗначений("", "Всего по организации", Строка(Подр.Ключ), БазаВсего, 1, Подр.Значение));
		КонецЦикла;
		ВывестиТаблицу(Вывод, Заголовки, Строки, "4,30,26,20,14,20");
		ВывестиСтроку(Вывод, "Упрощение версии 1.0: коэффициент считается по организации в целом, база по подразделениям не разделяется. См. ПРОЕКТ.md.", Ложь, Истина);
	КонецЕсли;
	ВывестиСтроку(Вывод, "");

	// Таблица 3 — ОХР и АУР по статьям
	ВывестиСтроку(Вывод, "Аналитика распределения общехозяйственных затрат и административно-управленческих расходов. Таблица 3", Истина);
	Заголовки = СтрРазделить("№|Объект калькулирования (ИГК)|Статья (вид) расходов|Основная зарплата основных работников, руб.|Коэффициент распределения|Сумма распределяемых косвенных затрат по статье, руб.", "|");
	Строки = Новый Массив;
	Номер = 0;
	Для Каждого КлючИЗначение Из База Цикл
		Номер = Номер + 1;
		Коэф = ?(БазаВсего = 0, 0, КлючИЗначение.Значение / БазаВсего);
		ОбъектКальк = ?(КлючИЗначение.Ключ = "Прочие", "Прочая продукция", ИГК(КлючИЗначение.Ключ));
		Для Каждого Ст Из ОХРПоСтатьям Цикл
			Строки.Добавить(МассивЗначений(Номер, ОбъектКальк, Строка(Ст.Ключ), "", "", Ст.Значение * Коэф));
		КонецЦикла;
	КонецЦикла;
	Строки.Добавить(МассивЗначений("", "Всего", "", БазаВсего, 1, ОХРВсего));
	ВывестиТаблицу(Вывод, Заголовки, Строки, "4,30,30,20,14,24");
	ВывестиСтроку(Вывод, "");

	// Сверка расчёта с бухучётом
	Расхождения = Новый Массив;
	Для Каждого КлючИЗначение Из База Цикл
		Коэф = ?(БазаВсего = 0, 0, КлючИЗначение.Значение / БазаВсего);
		ОбъектКальк = ?(КлючИЗначение.Ключ = "Прочие", "Прочая продукция", ИГК(КлючИЗначение.Ключ));
		ПроверитьРасхождение(Расхождения, ОбъектКальк, "ОПР (0800)", ОПРВсего * Коэф, ФактОПР[КлючИЗначение.Ключ]);
		Если НЕ Настройки.АУРВСебестоимость Тогда
			ПроверитьРасхождение(Расхождения, ОбъектКальк, "ОХР (0900)", ОХРВсего * Коэф, ФактОХР[КлючИЗначение.Ключ]);
		КонецЕсли;
	КонецЦикла;
	ВывестиСтроку(Вывод, "Сверка с бухгалтерским учётом (Кт 25/26 → Дт 20 по контрактам):", Истина);
	Если Расхождения.Количество() = 0 Тогда
		ВывестиСтроку(Вывод, "расхождений нет", Ложь, Истина);
	Иначе
		ВывестиСтроку(Вывод, "Есть расхождения — к справке нужна пояснительная записка с обоснованием (п. 2 правил заполнения справки):", Ложь, Истина);
		Для Каждого Текст Из Расхождения Цикл
			ВывестиСтроку(Вывод, "  " + Текст, Ложь, Истина);
		КонецЦикла;
	КонецЕсли;
	ВывестиПодпись(Вывод);
	Возврат Новый Структура("Документ, Расхождения", ТД, Расхождения);

КонецФункции

Процедура ПроверитьРасхождение(Расхождения, ОбъектКальк, Что, Расчет, Факт)

	ФактЧисло = ?(Факт = Неопределено, 0, Факт);
	Если Окр(Расчет - ФактЧисло, 0) <> 0 Тогда
		Расхождения.Добавить(ОбъектКальк + ", " + Что + ": расчёт " + ФорматСуммы(Расчет) + ", в учёте " + ФорматСуммы(ФактЧисло)
			+ ", разница " + ФорматСуммы(ФактЧисло - Расчет));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОтчетПрил1

// Список контрактов ГОЗ (с ИГК), по которым были затраты на 20 счёте за период.
Функция КонтрактыСЗатратами(Начало, Конец, Настройки) Экспорт

	Результат = Новый Массив;
	С = СтруктураУчета();
	Прямые = ПрямыеЗатраты(Начало, Конец, Настройки, С);
	Для Каждого Контракт Из Уникальные(Прямые.ВыгрузитьКолонку("Контракт")) Цикл
		Если КонтрактГОЗ(Контракт) Тогда
			Результат.Добавить(Контракт);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отчёт о фактических затратах по контракту (прил. 1), нарастающим итогом с НачалоУчета по ДатаОтчета.
Функция ОтчетПрил1(Контракт, ДатаОтчета, Настройки) Экспорт

	С = СтруктураУчета();
	Начало = Настройки.НачалоУчета;
	Конец = КонецДня(ДатаОтчета);
	Замечания = Новый Массив;

	// 1. Затраты по статьям нарастающим итогом
	Суммы = Новый Соответствие;      // Код -> Структура(Всего, Учит, Обос, Привн)
	Прямые = ПрямыеЗатраты(Начало, Конец, Настройки, С);
	Для Каждого Стр Из Прямые Цикл
		Если Стр.Контракт = Контракт Тогда
			Добавить(Суммы, Стр.Код, Стр.Сумма, Стр.Обособленно, Стр.Привнесенная);
		КонецЕсли;
	КонецЦикла;
	Если Суммы["0900"] <> Неопределено И Настройки.АУРВСебестоимость Тогда
		Замечания.Добавить("В учёте есть списание 26 → 20 (статья 0900), а в настройках выбран вариант «АУР по статье 1600». По сноске 2 к прил. 2 статья 0900 при этом не применяется: проверьте учётную политику.");
	КонецЕсли;

	// 2. Коммерческие (90.07), АУР (90.08), проценты (91.02): по контракту, а если субконто контракта нет — по базе распределения по месяцам
	ДобавитьСчетРасходов(Суммы, Замечания, "1400", С.Счета.Счет90_07, Контракт, Начало, Конец, Настройки, С, Истина);
	Если Настройки.АУРВСебестоимость Тогда
		ДобавитьСчетРасходов(Суммы, Замечания, "1600", С.Счета.Счет90_08, Контракт, Начало, Конец, Настройки, С, Истина);
	КонецЕсли;
	ДобавитьСчетРасходов(Суммы, Замечания, "1500", С.Счета.Счет91_02, Контракт, Начало, Конец, Настройки, С, Ложь);
	ПосчитатьИтоги(Суммы);

	// 3. Партии реализации: документы реализации по контракту
	Партии = ПартииРеализации(Контракт, Начало, Конец, С, Настройки);
	КоличествоВсего = 0;
	СебестоимостьОтгруженного = 0;
	Для Каждого Партия Из Партии Цикл
		КоличествоВсего = КоличествоВсего + Партия.Количество;
		СебестоимостьОтгруженного = СебестоимостьОтгруженного + Партия.Себестоимость;
	КонецЦикла;
	Производственная = ЗначениеСуммы(Суммы, "1300", "Всего");
	Для Каждого Партия Из Партии Цикл
		Если СебестоимостьОтгруженного > 0 И Производственная > 0 Тогда
			Партия.Доля = Партия.Себестоимость / Производственная;
		ИначеЕсли КоличествоВсего > 0 Тогда
			Партия.Доля = Партия.Количество / КоличествоВсего;
		КонецЕсли;
	КонецЦикла;
	Если Партии.Количество() > 0 Тогда
		Замечания.Добавить("Затраты по партиям распределены пропорционально себестоимости отгрузки (или количеству) по структуре затрат контракта:"
			+ " ERP не хранит статьи калькуляции в себестоимости каждой отгрузки. Точная разбивка — после настройки детализации регламентированного учёта по ГОЗ (см. ПРОЕКТ.md).");
	Иначе
		Замечания.Добавить("Отгрузок по контракту за период не найдено: показана только общая сумма затрат (всё в незавершённом производстве или на складе).");
	КонецЕсли;
	Если Начало >= Дата(2027, 1, 1) Тогда
		Замечания.Добавить("Затраты до " + Формат(Начало, "ДФ=dd.MM.yyyy") + " (НЗП на 01.01.2027) не включены: их детализация — по локальному документу (п. 41 Правил).");
	КонецЕсли;

	// 4. Вывод в форме прил. 1
	ТД = Новый ТабличныйДокумент;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТД.АвтоМасштаб = Истина;
	Вывод = НовыйВывод(ТД);
	ВывестиСтроку(Вывод, "ПРИЛОЖЕНИЕ № 1 к Правилам калькулирования себестоимости продукции, поставляемой по ГОЗ (ПП РФ от 13.07.2026 № 874)", Ложь, Истина);
	ВывестиСтроку(Вывод, "ОТЧЁТ о фактических затратах по государственному контракту, контракту, заключённому в рамках государственного оборонного заказа", Истина);
	ВывестиСтроку(Вывод, "Контракт: " + Строка(Контракт) + "; ИГК: " + ИГК(Контракт), Истина);
	ВывестиСтроку(Вывод, "Нарастающим итогом с " + Формат(Начало, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"), Ложь, Истина);
	ВывестиСтроку(Вывод, "");

	// количество продукции
	Заголовки = Новый Массив;
	Заголовки.Добавить("Номенклатура продукции");
	Заголовки.Добавить("Ед. изм.");
	Заголовки.Добавить("Количество всего");
	Для Каждого Партия Из Партии Цикл
		Заголовки.Добавить(Формат(Партия.Дата, "ДФ=yyyy") + " г., партия № " + Партия.Номер);
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого Номенклатура Из Уникальные(ВсяНоменклатура(Партии)) Цикл
		СтрокаКол = Новый Массив;
		СтрокаКол.Добавить(Строка(Номенклатура));
		СтрокаКол.Добавить(ЕдиницаНоменклатуры(Номенклатура));
		Всего = 0;
		Для Каждого Партия Из Партии Цикл
			Всего = Всего + ?(Партия.ПоНоменклатуре[Номенклатура] = Неопределено, 0, Партия.ПоНоменклатуре[Номенклатура]);
		КонецЦикла;
		СтрокаКол.Добавить(Всего);
		Для Каждого Партия Из Партии Цикл
			СтрокаКол.Добавить(?(Партия.ПоНоменклатуре[Номенклатура] = Неопределено, 0, Партия.ПоНоменклатуре[Номенклатура]));
		КонецЦикла;
		Строки.Добавить(СтрокаКол);
	КонецЦикла;
	Если Строки.Количество() > 0 Тогда
		ВывестиТаблицу(Вывод, Заголовки, Строки, "");
		ВывестиСтроку(Вывод, "");
	КонецЕсли;

	// затраты
	Заголовки = Новый Массив;
	Заголовки.Добавить("Статья");
	Заголовки.Добавить("Наименование статьи калькуляции");
	Для Каждого Партия Из Партии Цикл
		Подпись = "Партия № " + Партия.Номер + " (" + Формат(Партия.Дата, "ДФ=dd.MM.yy") + ")";
		Заголовки.Добавить(Подпись + ": всего");
		Заголовки.Добавить(Подпись + ": учитываемые");
		Заголовки.Добавить(Подпись + ": учитываемые обособленно");
	КонецЦикла;
	Для Каждого Подпись Из СтрРазделить("Общая сумма: всего|на единицу|учитываемые: всего|на единицу|обособленно: всего|на единицу|исключённые: всего|на единицу", "|") Цикл
		Заголовки.Добавить(Подпись);
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого СтатьяПП Из СтатьиКалькуляции874() Цикл
		Значения = Новый Массив;
		Значения.Добавить(СтатьяПП.Код);
		Значения.Добавить(?(СтатьяПП.Вложенная, "   ", "") + СтатьяПП.Наименование);
		Всего = ЗначениеСуммы(Суммы, СтатьяПП.Код, "Всего");
		Учит = ЗначениеСуммы(Суммы, СтатьяПП.Код, "Учит");
		Обос = ЗначениеСуммы(Суммы, СтатьяПП.Код, "Обос");
		Для Каждого Партия Из Партии Цикл
			Если СтатьяПП.Код = "1400" ИЛИ СтатьяПП.Код = "1500" ИЛИ СтатьяПП.Код = "1600" ИЛИ СтатьяПП.Код = "1700" Тогда
				ДоляПартии = ?(КоличествоВсего = 0, 0, Партия.Количество / КоличествоВсего);
			Иначе
				ДоляПартии = Партия.Доля;
			КонецЕсли;
			Значения.Добавить(Всего * ДоляПартии);
			Значения.Добавить(Учит * ДоляПартии);
			Значения.Добавить(Обос * ДоляПартии);
		КонецЦикла;
		Значения.Добавить(Всего);
		Значения.Добавить(?(КоличествоВсего = 0, "", Всего / КоличествоВсего));
		Значения.Добавить(Учит);
		Значения.Добавить(?(КоличествоВсего = 0, "", Учит / КоличествоВсего));
		Значения.Добавить(Обос);
		Значения.Добавить(?(КоличествоВсего = 0, "", Обос / КоличествоВсего));
		Значения.Добавить(0);
		Значения.Добавить("");
		Строки.Добавить(Значения);
	КонецЦикла;
	Привн = 0;
	Для Каждого КлючИЗначение Из Суммы Цикл
		Если КлючИЗначение.Ключ <> "1500" Тогда // проценты в себестоимость не входят (п. 9 Правил)
			Привн = Привн + КлючИЗначение.Значение.Привн;
		КонецЕсли;
	КонецЦикла;
	Себестоимость = ЗначениеСуммы(Суммы, "1700", "Всего");
	Строки.Добавить(СтрокаИтога("В том числе: привнесённые затраты", Привн, Партии, КоличествоВсего));
	Строки.Добавить(СтрокаИтога("собственные затраты", Себестоимость - Привн, Партии, КоличествоВсего));
	ВывестиТаблицу(Вывод, Заголовки, Строки, "6,46");
	ВывестиСтроку(Вывод, "");
	ВывестиСтроку(Вывод, "Исключённые затраты (не согласованные госзаказчиком по ПП № 1465) вводятся после заключения ВП/заказчика: в версии 1.0 — вручную в файле.", Ложь, Истина);
	Для Каждого Текст Из Замечания Цикл
		ВывестиСтроку(Вывод, "Примечание: " + Текст, Ложь, Истина);
	КонецЦикла;
	ВывестиПодпись(Вывод);
	Возврат Новый Структура("Документ, Замечания", ТД, Замечания);

КонецФункции

Функция СтрокаИтога(Подпись, Сумма, Партии, КоличествоВсего)

	Значения = Новый Массив;
	Значения.Добавить("");
	Значения.Добавить(Подпись);
	Для Каждого Партия Из Партии Цикл
		ДоляПартии = ?(КоличествоВсего = 0, 0, Партия.Количество / КоличествоВсего);
		Значения.Добавить(Сумма * ДоляПартии);
		Значения.Добавить("");
		Значения.Добавить("");
	КонецЦикла;
	Значения.Добавить(Сумма);
	Значения.Добавить(?(КоличествоВсего = 0, "", Сумма / КоличествоВсего));
	Для Н = 1 По 6 Цикл
		Значения.Добавить("");
	КонецЦикла;
	Возврат Значения;

КонецФункции

Процедура Добавить(Суммы, Код, Сумма, Обособленно, Привнесенная)

	Если Суммы[Код] = Неопределено Тогда
		Суммы.Вставить(Код, Новый Структура("Всего, Учит, Обос, Привн", 0, 0, 0, 0));
	КонецЕсли;
	З = Суммы[Код];
	З.Всего = З.Всего + Сумма;
	Если Обособленно Тогда
		З.Обос = З.Обос + Сумма;
	Иначе
		З.Учит = З.Учит + Сумма;
	КонецЕсли;
	Если Привнесенная Тогда
		З.Привн = З.Привн + Сумма;
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеСуммы(Суммы, Код, Поле)

	З = Суммы[Код];
	Возврат ?(З = Неопределено, 0, З[Поле]);

КонецФункции

// Итоговые строки по п. 8, 9 Правил: 0100, 0200, 0400, 1300 = 0100…1200, 1700 = 1300 + 1400 + 1600.
Процедура ПосчитатьИтоги(Суммы)

	Для Каждого Поле Из СтрРазделить("Всего,Учит,Обос", ",") Цикл
		Материалы = 0;
		Для Каждого Код Из СтрРазделить("0101,0102,0104,0105,0106,0107,0108,0109,0110", ",") Цикл
			Материалы = Материалы + ЗначениеСуммы(Суммы, Код, Поле);
		КонецЦикла;
		Материалы = Материалы - ЗначениеСуммы(Суммы, "0103", Поле);
		УстановитьИтог(Суммы, "0100", Поле, Материалы);
		УстановитьИтог(Суммы, "0200", Поле, ЗначениеСуммы(Суммы, "0201", Поле) + ЗначениеСуммы(Суммы, "0202", Поле));
		УстановитьИтог(Суммы, "0400", Поле, ЗначениеСуммы(Суммы, "0401", Поле) + ЗначениеСуммы(Суммы, "0402", Поле));
		Производственная = 0;
		Для Каждого Код Из СтрРазделить("0100,0200,0300,0400,0500,0600,0700,0800,0900,1000,1100,1200", ",") Цикл
			Производственная = Производственная + ЗначениеСуммы(Суммы, Код, Поле);
		КонецЦикла;
		УстановитьИтог(Суммы, "1300", Поле, Производственная);
		УстановитьИтог(Суммы, "1700", Поле, Производственная + ЗначениеСуммы(Суммы, "1400", Поле) + ЗначениеСуммы(Суммы, "1600", Поле));
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьИтог(Суммы, Код, Поле, Значение)

	Если Суммы[Код] = Неопределено Тогда
		Суммы.Вставить(Код, Новый Структура("Всего, Учит, Обос, Привн", 0, 0, 0, 0));
	КонецЕсли;
	Суммы[Код][Поле] = Значение;

КонецПроцедуры

// Расходы на 90.07 / 90.08 / 91.02. Если на счёте есть субконто контракта — берём по контракту;
// иначе (и если Распределять) — распределяем по базе (0201) помесячно, как в справке.
Процедура ДобавитьСчетРасходов(Суммы, Замечания, Код, Счет, Контракт, Начало, Конец, Настройки, С, Распределять)

	Если Счет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Мес = НачалоМесяца(Начало);
	Распределено = Ложь;
	Пока Мес <= Конец Цикл
		КонецМес = Мин(КонецМесяца(Мес), Конец);
		Обороты = ОборотДтСчета(Счет, Мес, КонецМес, Настройки, С, ?(Код = "1600", С.ВидСтатьи90, Неопределено));
		БезКонтракта = 0;
		Для Каждого Стр Из Обороты Цикл
			Если ЭтоОбособленная(Стр.Статья, Настройки.Сопоставление) Тогда
				Если Стр.Контракт = Контракт Тогда
					Добавить(Суммы, Код, Стр.Сумма, Истина, Ложь);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Контракт) Тогда
				Если Стр.Контракт = Контракт Тогда
					Добавить(Суммы, Код, Стр.Сумма, Ложь, Ложь);
				КонецЕсли;
			Иначе
				БезКонтракта = БезКонтракта + Стр.Сумма;
			КонецЕсли;
		КонецЦикла;
		Если БезКонтракта <> 0 И Распределять Тогда
			Прямые = ПрямыеЗатраты(Мес, КонецМес, Настройки, С);
			БазаКонтракта = 0;
			БазаВсего = 0;
			Для Каждого Стр Из Прямые Цикл
				Если Стр.Код = "0201" И НЕ Стр.Обособленно Тогда
					БазаВсего = БазаВсего + Стр.Сумма;
					Если Стр.Контракт = Контракт Тогда
						БазаКонтракта = БазаКонтракта + Стр.Сумма;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если БазаВсего <> 0 Тогда
				Добавить(Суммы, Код, БезКонтракта * БазаКонтракта / БазаВсего, Ложь, Ложь);
				Распределено = Истина;
			КонецЕсли;
		КонецЕсли;
		Мес = ДобавитьМесяц(Мес, 1);
	КонецЦикла;
	Если Распределено Тогда
		Замечания.Добавить("Статья " + Код + ": на счёте " + Счет.Код + " нет контракта, сумма распределена по основной зарплате основных работников помесячно (п. 28 Правил).");
	КонецЕсли;

КонецПроцедуры

// Документы реализации по контракту = партии реализации (п. 2 Правил).
Функция ПартииРеализации(Контракт, Начало, Конец, С, Настройки)

	Партии = Новый ТаблицаЗначений;
	Партии.Колонки.Добавить("Документ");
	Партии.Колонки.Добавить("Номер");
	Партии.Колонки.Добавить("Дата");
	Партии.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Партии.Колонки.Добавить("Себестоимость", Новый ОписаниеТипов("Число"));
	Партии.Колонки.Добавить("Доля", Новый ОписаниеТипов("Число"));
	Партии.Колонки.Добавить("ПоНоменклатуре");
	МетаДокумента = Метаданные.Документы.Найти("РеализацияТоваровУслуг");
	Если МетаДокумента = Неопределено ИЛИ С.ИмяСправочникаКонтракта = "" Тогда
		Возврат Партии;
	КонецЕсли;
	ТипКонтракта = Тип("СправочникСсылка." + С.ИмяСправочникаКонтракта);
	МетаТЧ = МетаДокумента.ТабличныеЧасти.Найти("Товары");
	Если МетаТЧ = Неопределено Тогда
		Возврат Партии;
	КонецЕсли;
	УсловиеКонтракта = "";
	Для Каждого Реквизит Из МетаДокумента.Реквизиты Цикл
		Если Реквизит.Тип.СодержитТип(ТипКонтракта) Тогда
			УсловиеКонтракта = "Т.Ссылка." + Реквизит.Имя + " = &Контракт";
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если УсловиеКонтракта = "" Тогда
		Для Каждого Реквизит Из МетаТЧ.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипКонтракта) Тогда
				УсловиеКонтракта = "Т." + Реквизит.Имя + " = &Контракт";
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если УсловиеКонтракта = "" ИЛИ МетаТЧ.Реквизиты.Найти("Количество") = Неопределено Тогда
		Возврат Партии;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Документ,
		|	Т.Ссылка.Дата КАК Дата,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т.Количество) КАК Количество
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
		|	И " + УсловиеКонтракта + "
		|СГРУППИРОВАТЬ ПО
		|	Т.Ссылка,
		|	Т.Ссылка.Дата,
		|	Т.Номенклатура
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Контракт", Контракт);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Партия = Партии.Найти(Выборка.Документ, "Документ");
		Если Партия = Неопределено Тогда
			Партия = Партии.Добавить();
			Партия.Документ = Выборка.Документ;
			Партия.Дата = Выборка.Дата;
			Партия.Номер = Партии.Количество();
			Партия.ПоНоменклатуре = Новый Соответствие;
		КонецЕсли;
		Партия.Количество = Партия.Количество + Выборка.Количество;
		Было = Партия.ПоНоменклатуре[Выборка.Номенклатура];
		Партия.ПоНоменклатуре.Вставить(Выборка.Номенклатура, ?(Было = Неопределено, 0, Было) + Выборка.Количество);
	КонецЦикла;

	// себестоимость каждой отгрузки — из проводок Дт 90.02 документа
	Если Партии.Количество() > 0 И С.Счета.Счет90_02 <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Х.Регистратор КАК Документ,
			|	СУММА(Х.Сумма) КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный КАК Х
			|ГДЕ
			|	Х.Регистратор В (&Документы)
			|	И Х.СчетДт В ИЕРАРХИИ (&Счет)
			|СГРУППИРОВАТЬ ПО
			|	Х.Регистратор";
		Запрос.УстановитьПараметр("Документы", Партии.ВыгрузитьКолонку("Документ"));
		Запрос.УстановитьПараметр("Счет", С.Счета.Счет90_02);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Партия = Партии.Найти(Выборка.Документ, "Документ");
			Если Партия <> Неопределено Тогда
				Партия.Себестоимость = Выборка.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Партии;

