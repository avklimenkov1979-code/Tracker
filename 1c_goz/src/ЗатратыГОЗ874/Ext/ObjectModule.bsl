Функция НоваяТаблицаСопоставления() Экспорт

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Статья");
	Т.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Обособленно", Новый ОписаниеТипов("Булево"));
	Т.Колонки.Добавить("Привнесенная", Новый ОписаниеТипов("Булево"));
