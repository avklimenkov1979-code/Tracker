// Ширины — строка «6,40,…» для первых колонок; остальные по 14.
Процедура ВывестиТаблицу(Вывод, Заголовки, Строки, Ширины)

	ТД = Вывод.ТД;
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	МассивШирин = ?(ПустаяСтрока(Ширины), Новый Массив, СтрРазделить(Ширины, ","));
	Для Н = 1 По Заголовки.Количество() Цикл
		Ширина = ?(Н <= МассивШирин.Количество(), Число(МассивШирин[Н - 1]), 14);
		Если ТД.Область(, Н, , Н).ШиринаКолонки < Ширина Тогда
			ТД.Область(, Н, , Н).ШиринаКолонки = Ширина;
		КонецЕсли;
		Ячейка = ТД.Область(Вывод.Строка, Н, Вывод.Строка, Н);
		Ячейка.Текст = Заголовки[Н - 1];
		Ячейка.Шрифт = Новый Шрифт(, 8, Истина);
		Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Ячейка.Обвести(Линия, Линия, Линия, Линия);
	КонецЦикла;
	Вывод.Строка = Вывод.Строка + 1;
	Для Каждого Значения Из Строки Цикл
		Для Н = 1 По Значения.Количество() Цикл
			Ячейка = ТД.Область(Вывод.Строка, Н, Вывод.Строка, Н);
			Значение = Значения[Н - 1];
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Ячейка.Текст = ?(Значение = 0, "", Формат(Значение, ?(Значение <> Цел(Значение) И Макс(Значение, -Значение) < 10, "ЧДЦ=4", "ЧДЦ=2; ЧГ=3,0")));
				Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			Иначе
				Ячейка.Текст = Строка(Значение);
			КонецЕсли;
			Ячейка.Шрифт = Новый Шрифт(, 8);
			Ячейка.Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
		Вывод.Строка = Вывод.Строка + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиПодпись(Вывод)

	ВывестиСтроку(Вывод, "");
	ВывестиСтроку(Вывод, "Руководитель организации или иное уполномоченное лицо  ____________________ / ____________________ / ____________________");
	ВывестиСтроку(Вывод, "                                                        (должность)            (подпись)              (расшифровка подписи)", Ложь, Истина);
	ВывестиСтроку(Вывод, """____"" ______________ 20___ г.");
	ВывестиСтроку(Вывод, "Сформировано обработкой «ГОЗ: затраты по ПП 874» " + ВерсияОбработки() + " " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")
		+ " по данным регламентированного учёта. Перед подписанием сверить с регистрами учёта.", Ложь, Истина);

КонецПроцедуры

Функция МассивЗначений(З1, З2, З3, З4, З5, З6)

	М = Новый Массив;
	М.Добавить(З1);
	М.Добавить(З2);
	М.Добавить(З3);
	М.Добавить(З4);
	М.Добавить(З5);
	М.Добавить(З6);
	Возврат М;

КонецФункции

Функция ФорматСуммы(Сумма)

	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0; ЧГ=3,0");

КонецФункции

