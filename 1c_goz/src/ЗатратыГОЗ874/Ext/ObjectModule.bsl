// «0101» -> «0101 приобретение сырья, …» (как в списке выбора формы).
Функция ПолныйКод(Код) Экспорт

	Если ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Вариант Из КодыДляВыбора() Цикл
		Если Лев(Вариант, 4) = Лев(Код, 4) Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Возврат Код;

КонецФункции

