Процедура ВывестиСтроку(Вывод, Текст, Жирный = Ложь, Мелкий = Ложь)

	Область = Вывод.ТД.Область(Вывод.Строка, 1, Вывод.Строка, 1);
	Область.Текст = Текст;
	Если Жирный Тогда
		Область.Шрифт = Новый Шрифт(, 10, Истина);
	ИначеЕсли Мелкий Тогда
		Область.Шрифт = Новый Шрифт(, 8);
