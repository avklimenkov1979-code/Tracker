КонецПроцедуры

// Оборот Дт счёта (25, 26, 90.07, 90.08, 91.02) за период: по контракту (если есть такое субконто) и по статье.
Функция ОборотДтСчета(Счет, Начало, Конец, Настройки, С, ВидСтатьи)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Контракт");
	Т.Колонки.Добавить("Статья");
	Т.Колонки.Добавить("Подразделение");
	Т.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Если Счет = Неопределено Тогда
		Возврат Т;
	КонецЕсли;
	ВидыДт = Новый Массив;
	Поля = Новый Массив;
	Если С.ВидКонтракта <> Неопределено Тогда
		ВидыДт.Добавить(С.ВидКонтракта);
		Поля.Добавить("О.Субконто" + ВидыДт.Количество() + " КАК Контракт");
	Иначе
		Поля.Добавить("НЕОПРЕДЕЛЕНО КАК Контракт");
	КонецЕсли;
	Если ВидСтатьи <> Неопределено Тогда
		ВидыДт.Добавить(ВидСтатьи);
		Поля.Добавить("О.Субконто" + ВидыДт.Количество() + " КАК Статья");
	Иначе
		Поля.Добавить("НЕОПРЕДЕЛЕНО КАК Статья");
	КонецЕсли;
	Если С.ВидПодразделения25 <> Неопределено И ВидыДт.Количество() < 3 Тогда
		ВидыДт.Добавить(С.ВидПодразделения25);
		Поля.Добавить("О.Субконто" + ВидыДт.Количество() + " КАК Подразделение");
	Иначе
		Поля.Добавить("НЕОПРЕДЕЛЕНО КАК Подразделение");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(Поля, "," + Символы.ПС + "	") + ",
		|	О.СуммаОборотДт КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Счет), &ВидыДт, "
		+ УсловиеОрганизации(Настройки.Организация) + ", , ) КАК О
		|ГДЕ
		|	О.СуммаОборотДт <> 0";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("ВидыДт", ВидыДт);
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Т.Добавить();
		Стр.Контракт = ?(Выборка.Контракт = NULL, Неопределено, Выборка.Контракт);
		Стр.Статья = ?(Выборка.Статья = NULL, Неопределено, Выборка.Статья);
		Стр.Подразделение = ?(Выборка.Подразделение = NULL, Неопределено, Выборка.Подразделение);
		Стр.Сумма = Выборка.Сумма;
	КонецЦикла;
	Возврат Т;

КонецФункции

// Обособленные (не учитываемые по Положению) суммы по статьям исключаются из распределяемой базы (правила заполнения прил. 3).
Функция ЭтоОбособленная(Статья, Сопоставление)

	Если НЕ ЗначениеЗаполнено(Статья) Тогда
		Возврат Ложь;
	КонецЕсли;
	Найдено = Сопоставление.Найти(Статья, "Статья");
	Возврат Найдено <> Неопределено И Найдено.Обособленно;

