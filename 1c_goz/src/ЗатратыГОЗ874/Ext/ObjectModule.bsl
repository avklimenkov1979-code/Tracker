Процедура ДобавитьСтатью(Т, Код, Наименование, Итог, Вложенная)

	Стр = Т.Добавить();
	Стр.Код = Код;
	Стр.Наименование = Наименование;
	Стр.Итог = Итог;
	Стр.Вложенная = Вложенная;

КонецПроцедуры

// Коды, которые можно выбрать при сопоставлении (без итоговых строк).
Функция КодыДляВыбора() Экспорт

	Коды = Новый Массив;
	Для Каждого СтрокаСтатьи Из СтатьиКалькуляции874() Цикл
		Если НЕ СтрокаСтатьи.Итог Тогда
			Коды.Добавить(СтрокаСтатьи.Код + " " + СтрокаСтатьи.Наименование);
		КонецЕсли;
	КонецЦикла;
	Возврат Коды;

КонецФункции

// Предложить код по наименованию статьи ERP. Пустая строка — не угадали.
Функция ПредложитьКод(Знач Наименование) Экспорт

	Н = НРег(Наименование);
	Правила = Новый Массив;
	// порядок важен: более узкие правила раньше
	Правила.Добавить("возвратн|0103");
	Правила.Добавить("отход|0103");
	Правила.Добавить("полуфабрикат|0102");
	Правила.Добавить("комплектующ|0104");
	Правила.Добавить("покупн|0104");
	Правила.Добавить("транспортно-заготов|0106");
	Правила.Добавить("тзр|0106");
	Правила.Добавить("доставк|0106");
	Правила.Добавить("топлив|0107");
	Правила.Добавить("электроэнерг|0108");
	Правила.Добавить("энерг|0108");
	Правила.Добавить("газ|0108");
	Правила.Добавить("тара|0109");
	Правила.Добавить("упаков|0109");
	Правила.Добавить("собственного производства|0110");
	Правила.Добавить("дополнительн|0202");
	Правила.Добавить("отпуск|0202");
	Правила.Добавить("взнос|0300");
	Правила.Добавить("страхов|0300");
