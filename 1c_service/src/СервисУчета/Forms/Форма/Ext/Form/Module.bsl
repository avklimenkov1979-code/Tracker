// Форма обработки «Сервис учёта» (1С:ERP 2.5).
//
// Закладка «Аудит ручной работы»: сколько документов каждого вида вводится вручную, кем,
// сколько в них строк, какие наборы строк повторяются (кандидаты в шаблоны), какие платежи
// регулярные, в какие дни не введены суточные рапорты. Ничего не меняет в базе.
//
// Закладка «Старые заказы»: незакрытые заказы любых видов (клиентов, поставщикам, материалов
// в производство, на производство и т.д.) старше N дней, по которым давно не было движения.
// Отмеченные закрываются статусом «Закрыт».
//
// Реквизиты и элементы формы создаются в ПриСозданииНаСервере, поэтому Form.xml почти пустой.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();

	ЭтотОбъект.ДатаОкончания = НачалоДня(ТекущаяДатаСеанса());
	ЭтотОбъект.ДатаНачала = ДобавитьМесяц(ЭтотОбъект.ДатаОкончания, -3);
	ЭтотОбъект.СтаршеДней = 180;
	Заголовок = "Сервис учёта";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СобратьАудит(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаНачала) ИЛИ ЭтотОбъект.ДатаОкончания < ЭтотОбъект.ДатаНачала Тогда
		ПоказатьПредупреждение(, "Укажите период аудита.");
		Возврат;
	КонецЕсли;
	Состояние("Собираю аудит: просматриваю все виды документов, это 1–3 минуты...");
	Попытка
		СобратьАудитНаСервере();
	Исключение
		ЗапомнитьОшибку("Аудит", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Аудит не собрался:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
		Возврат;
	КонецПопытки;
	ПоказатьОповещениеПользователя("Аудит готов", , "Нажмите «Сохранить в файл» и пришлите файл в чат");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьАудит(Команда)

	Если ПустаяСтрока(ЭтотОбъект.ТекстАудита) Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Собрать аудит».");
		Возврат;
	КонецЕсли;
	СохранитьТекст(ЭтотОбъект.ТекстАудита, "Аудит_ручной_работы_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".txt");

КонецПроцедуры

&НаКлиенте
Процедура НайтиЗаказы(Команда)

	Состояние("Ищу старые незакрытые заказы...");
	Попытка
		НайтиЗаказыНаСервере();
	Исключение
		ЗапомнитьОшибку("Поиск заказов", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Не получилось найти заказы:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если ЭтотОбъект.Заказы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Старых незакрытых заказов не найдено.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		СтрокаЗаказа.Пометка = ПустаяСтрока(СтрокаЗаказа.Результат);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		СтрокаЗаказа.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОтмеченные(Команда)

	Отмечено = 0;
	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		Если СтрокаЗаказа.Пометка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте галочкой заказы, которые нужно закрыть.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЗакрытьОтмеченныеПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Закрыть отмеченные заказы (" + Отмечено + " шт.)?" + Символы.ПС + Символы.ПС
		+ "Заказу ставится статус «Закрыт», неотгруженные строки отменяются. Отгрузки и оплаты не меняются."
		+ " Вернуть заказ можно вручную: открыть его и поменять статус." + Символы.ПС + Символы.ПС
		+ "Совет: в первый раз отметьте 1–2 заказа и проверьте результат.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОтмеченныеПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние("Закрываю заказы...");
	Итог = ЗакрытьОтмеченныеНаСервере();
	ПоказатьПредупреждение(, "Закрыто: " + Итог.Закрыто + ". Не удалось: " + Итог.Ошибки + "."
		+ ?(Итог.Ошибки > 0, Символы.ПС + "Причина — в колонке «Результат». Такие заказы откройте и закройте вручную"
		+ " или нажмите «Сообщить об ошибке».", ""));

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаЗаказа = ЭтотОбъект.Заказы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаЗаказа <> Неопределено Тогда
		ПоказатьЗначение(, СтрокаЗаказа.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибке(Команда)

	СисИнфо = Новый СистемнаяИнформация;
	Строки = Новый Массив;
	Строки.Добавить("СООБЩЕНИЕ ОБ ОШИБКЕ: Сервис учёта, версия " + ВерсияПрограммы());
	Строки.Добавить("1С на компьютере: " + СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + "); " + СисИнфо.ВерсияОС);
	Строки.Добавить(СведенияОБазе());
	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ");
	Строки.Добавить(?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), "  нет", ЭтотОбъект.ЖурналОшибок));
	Для Каждого СообщениеЭкрана Из ПолучитьСообщенияПользователю(Ложь) Цикл
		Строки.Добавить("Сообщение: " + СообщениеЭкрана.Текст);
	КонецЦикла;
	СохранитьТекст(СтрСоединить(Строки, Символы.ПС), "Ошибка_сервис_учета_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmm") + ".txt");

КонецПроцедуры

#КонецОбласти

#Область Общее

&НаКлиенте
Процедура СохранитьТекст(Текст, ИмяФайлаТекста)

	Адрес = ПоместитьТекстВХранилище(Текст);
	ПоказатьОповещениеПользователя("Сохраните файл и пришлите его в чат", , ИмяФайлаТекста);
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайлаТекста);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПоместитьТекстВХранилище(Текст)

	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция СведенияОБазе()

	СисИнфо = Новый СистемнаяИнформация;
	Возврат "Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + "; 1С на сервере: " + СисИнфо.ВерсияПриложения;

КонецФункции

&НаСервереБезКонтекста
Функция ВерсияПрограммы()

	Возврат "1.1 от 24.11.2026";

КонецФункции

&НаКлиенте
Процедура ЗапомнитьОшибку(Где, Инфо)

	Запись = "[" + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + Где + ":" + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо);
	ЭтотОбъект.ЖурналОшибок = ?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), Запись, ЭтотОбъект.ЖурналОшибок + Символы.ПС + Символы.ПС + Запись);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьРеквизит(МетаОбъекта, ИмяРеквизита)

	Если МетаОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Возврат МетаОбъекта.СтандартныеРеквизиты.Найти(ИмяРеквизита) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПервыйРеквизит(МетаОбъекта, СписокИмен)

	Для Каждого ИмяРеквизита Из СтрРазделить(СписокИмен, ",") Цикл
		Если МетаОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ОсновнаяТабличнаяЧасть(МетаДокумента)

	// табличная часть с номенклатурой: сначала по привычным именам, потом любая с реквизитом «Номенклатура»
	Для Каждого ИмяТЧ Из СтрРазделить("Товары,Материалы,МатериалыИРаботы,ИзрасходованныеМатериалы,Продукция,Комплектующие", ",") Цикл
		МетаТЧ = МетаДокумента.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаТЧ <> Неопределено И МетаТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда
			Возврат МетаТЧ;
		КонецЕсли;
	КонецЦикла;
	Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
		Если МетаТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда
			Возврат МетаТЧ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ФорматЧисла(Число)

	Возврат Формат(Число, "ЧДЦ=0; ЧН=0; ЧГ=3,0");

КонецФункции

&НаСервереБезКонтекста
Функция Дополнить(Знач Текст, Ширина)

	Текст = Лев(Строка(Текст), Ширина);
	Возврат Текст + Лев("                                                                                ", Макс(0, Ширина - СтрДлина(Текст)));

КонецФункции

#КонецОбласти

#Область Обезличивание

// В файл аудита по умолчанию не попадает ни одно наименование: контрагенты, номенклатура, пользователи,
// склады и т.п. заменяются кодами «Контрагент-3», «Номенклатура-12». Один и тот же объект в пределах
// файла всегда получает один код, поэтому повторы и закономерности остаются видны.
// Значения перечислений (хоз. операции, статусы) — это стандартные названия ERP, они остаются.
&НаСервереБезКонтекста
Функция НовыеПсевдонимы(ПоказыватьНаименования)

	Возврат Новый Структура("Показывать, Коды, Счетчики", ПоказыватьНаименования, Новый Соответствие, Новый Соответствие);

КонецФункции

&НаСервереБезКонтекста
Функция Псевдоним(Значение, Псевдонимы)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "не указан";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если Псевдонимы.Показывать Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Код = Псевдонимы.Коды[Значение];
	Если Код <> Неопределено Тогда
		Возврат Код;
	КонецЕсли;
	Вид = ВидОбъектаДляКода(МетаЗначения);
	Номер = ?(Псевдонимы.Счетчики[Вид] = Неопределено, 0, Псевдонимы.Счетчики[Вид]) + 1;
	Псевдонимы.Счетчики.Вставить(Вид, Номер);
	Код = Вид + "-" + Номер;
	Псевдонимы.Коды.Вставить(Значение, Код);
	Возврат Код;

КонецФункции

&НаСервереБезКонтекста
Функция ВидОбъектаДляКода(МетаЗначения)

	Если МетаЗначения = Неопределено Тогда
		Возврат "Значение";
	КонецЕсли;
	Имена = Новый Соответствие;
	Имена.Вставить("Контрагенты", "Контрагент");
	Имена.Вставить("Партнеры", "Партнёр");
	Имена.Вставить("Номенклатура", "Номенклатура");
	Имена.Вставить("Пользователи", "Пользователь");
	Имена.Вставить("ФизическиеЛица", "Человек");
	Имена.Вставить("Сотрудники", "Человек");
	Имена.Вставить("Склады", "Склад");
	Имена.Вставить("СтруктураПредприятия", "Подразделение");
	Имена.Вставить("Организации", "Организация");
	Имена.Вставить("СтатьиРасходов", "Статья расходов");
	Имена.Вставить("СтатьиДвиженияДенежныхСредств", "Статья ДДС");
	Имена.Вставить("ДоговорыКонтрагентов", "Договор");
	Имена.Вставить("БанковскиеСчетаОрганизаций", "Счёт");
	Вид = Имена[МетаЗначения.Имя];
	Возврат ?(Вид = Неопределено, МетаЗначения.Синоним, Вид);

КонецФункции

#КонецОбласти

#Область Аудит

&НаСервере
Процедура СобратьАудитНаСервере()

	Начало = НачалоДня(ЭтотОбъект.ДатаНачала);
	Конец = КонецДня(ЭтотОбъект.ДатаОкончания);
	Дней = Макс(1, Окр((Конец - Начало) / 86400));
	РабочихДней = Макс(1, Окр(Дней * 5 / 7));

	Строки = Новый Массив;
	Строки.Добавить("АУДИТ РУЧНОЙ РАБОТЫ В 1С (Сервис учёта " + ВерсияПрограммы() + ")");
	Строки.Добавить(СведенияОБазе());
	Строки.Добавить("Период: " + Формат(Начало, "ДФ=dd.MM.yyyy") + " — " + Формат(Конец, "ДФ=dd.MM.yyyy")
		+ " (" + Дней + " дн., около " + РабочихДней + " рабочих)");
	Псевдонимы = НовыеПсевдонимы(ЭтотОбъект.ПоказыватьНаименования);
	Если ЭтотОбъект.ПоказыватьНаименования Тогда
		Строки.Добавить("ВНИМАНИЕ: включены настоящие наименования — такой файл не пересылайте. Для отправки снимите галочку и соберите аудит заново.");
	Иначе
		Строки.Добавить("Наименований в файле нет: контрагенты, номенклатура, пользователи, склады заменены кодами (Контрагент-1, Номенклатура-2...).");
		Строки.Добавить("Один и тот же объект везде получает один код. Суммы и количества — настоящие.");
	КонецЕсли;

	// 1. сколько документов каждого вида
	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("Имя");
	Сводка.Колонки.Добавить("Представление");
	Сводка.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Сводка.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	Сводка.Колонки.Добавить("Авторы");
	Сводка.Колонки.Добавить("ПоМесяцам");
	Ошибки = Новый Массив;

	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		Попытка
			Количество = КоличествоДокументов(МетаДокумента, Начало, Конец);
		Исключение
			Ошибки.Добавить(МетаДокумента.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСводки = Сводка.Добавить();
		СтрокаСводки.Имя = МетаДокумента.Имя;
		СтрокаСводки.Представление = МетаДокумента.Синоним;
		СтрокаСводки.Количество = Количество;
		Попытка
			ПодробностиВида(МетаДокумента, Начало, Конец, СтрокаСводки, Псевдонимы);
		Исключение
			Ошибки.Добавить(МетаДокумента.Имя + " (подробности): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Сводка.Сортировать("Количество Убыв");

	Всего = Сводка.Итог("Количество");
	Строки.Добавить("");
	Строки.Добавить("==== 1. СКОЛЬКО ДОКУМЕНТОВ ВВОДИТСЯ ====");
	Строки.Добавить("Всего документов: " + ФорматЧисла(Всего) + ", в рабочий день около " + ФорматЧисла(Всего / РабочихДней)
		+ ". Видов документов в работе: " + Сводка.Количество());
	Строки.Добавить("");
	Строки.Добавить(Дополнить("Документ", 46) + Дополнить("всего", 8) + Дополнить("в день", 8) + Дополнить("строк в ср.", 12)
		+ Дополнить("по месяцам", 24) + "кто вводит");
	Для Каждого СтрокаСводки Из Сводка Цикл
		Строки.Добавить(Дополнить(СтрокаСводки.Представление, 46) + Дополнить(ФорматЧисла(СтрокаСводки.Количество), 8)
			+ Дополнить(Формат(СтрокаСводки.Количество / РабочихДней, "ЧДЦ=1; ЧН=0"), 8)
			+ Дополнить(?(СтрокаСводки.Строк = 0, "—", Формат(СтрокаСводки.Строк / СтрокаСводки.Количество, "ЧДЦ=1")), 12)
			+ Дополнить(СтрокаСводки.ПоМесяцам, 24) + СтрокаСводки.Авторы);
	КонецЦикла;

	// 2. подробности по видам, где больше всего ручной работы
	Строки.Добавить("");
	Строки.Добавить("==== 2. ЧТО ИМЕННО ВВОДИТСЯ (главные виды документов) ====");
	Подробно = Новый Массив;
	Для Каждого ИмяВида Из СтрРазделить("ВнутреннееПотребление,ПеремещениеТоваров,ДвижениеПродукцииИМатериалов,СборкаТоваров,"
		+ "ПроизводствоБезЗаказа,РеализацияТоваровУслуг,ПриобретениеТоваровУслуг,СписаниеБезналичныхДенежныхСредств,"
		+ "ПоступлениеБезналичныхДенежныхСредств,ЗаказМатериаловВПроизводство", ",") Цикл
		Если Сводка.Найти(ИмяВида, "Имя") <> Неопределено Тогда
			Подробно.Добавить(ИмяВида);
		КонецЕсли;
	КонецЦикла;
	Номер = 0;
	Для Каждого СтрокаСводки Из Сводка Цикл
		Номер = Номер + 1;
		Если Номер > 8 Тогда
			Прервать;
		КонецЕсли;
		Если Подробно.Найти(СтрокаСводки.Имя) = Неопределено Тогда
			Подробно.Добавить(СтрокаСводки.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяВида Из Подробно Цикл
		МетаДокумента = Метаданные.Документы[ИмяВида];
		Строки.Добавить("");
		Строки.Добавить("---- " + МетаДокумента.Синоним + " (" + ФорматЧисла(Сводка.Найти(ИмяВида, "Имя").Количество) + " шт.) ----");
		Попытка
			ОписатьВид(МетаДокумента, Начало, Конец, Строки, Псевдонимы);
		Исключение
			Строки.Добавить("   не получилось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// 3. пропуски суточных рапортов
	Строки.Добавить("");
	Строки.Добавить("==== 3. ДНИ БЕЗ СУТОЧНЫХ РАПОРТОВ (Производство без заказа), последние 30 дней ====");
	Попытка
		ДниБезРапортов(Строки);
	Исключение
		Строки.Добавить("   не получилось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 4. старые незакрытые заказы — коротко
	Строки.Добавить("");
	Строки.Добавить("==== 4. СТАРЫЕ НЕЗАКРЫТЫЕ ЗАКАЗЫ (старше " + ЭтотОбъект.СтаршеДней + " дней без движения) ====");
	Попытка
		НайтиЗаказыНаСервере();
		ИтогиЗаказов = Новый Соответствие;
		Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
			ИтогиЗаказов.Вставить(СтрокаЗаказа.ВидЗаказа, ?(ИтогиЗаказов[СтрокаЗаказа.ВидЗаказа] = Неопределено, 0, ИтогиЗаказов[СтрокаЗаказа.ВидЗаказа]) + 1);
		КонецЦикла;
		Если ИтогиЗаказов.Количество() = 0 Тогда
			Строки.Добавить("   нет");
		КонецЕсли;
		Для Каждого КлючИЗначение Из ИтогиЗаказов Цикл
			Строки.Добавить("   " + КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение + " шт.");
		КонецЦикла;
		Строки.Добавить("   Список и закрытие — на закладке «Старые заказы».");
	Исключение
		Строки.Добавить("   не получилось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Ошибки.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить("==== ОШИБКИ ПРИ СБОРЕ (для настройки) ====");
		Для Каждого ТекстОшибки Из Ошибки Цикл
			Строки.Добавить("   " + ТекстОшибки);
		КонецЦикла;
	КонецЕсли;

	ЭтотОбъект.ТекстАудита = СтрСоединить(Строки, Символы.ПС);
	ВывестиТекст(Строки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоДокументов(МетаДокумента, Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ." + МетаДокумента.Имя + " КАК Д
		|ГДЕ
		|	Д.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Д.ПометкаУдаления";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

&НаСервереБезКонтекста
Процедура ПодробностиВида(МетаДокумента, Начало, Конец, СтрокаСводки, Псевдонимы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	// по месяцам
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) КАК Месяц,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ." + МетаДокумента.Имя + " КАК Д
		|ГДЕ
		|	Д.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Д.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)
		|УПОРЯДОЧИТЬ ПО
		|	Месяц";
	ПоМесяцам = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоМесяцам.Добавить(Формат(Выборка.Месяц, "ДФ=MMM") + " " + Выборка.Количество);
	КонецЦикла;
	СтрокаСводки.ПоМесяцам = СтрСоединить(ПоМесяцам, ", ");

	// кто вводит
	ПолеАвтора = ПервыйРеквизит(МетаДокумента, "Автор,Ответственный,Менеджер");
	Если ЗначениеЗаполнено(ПолеАвтора) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 3
			|	Д." + ПолеАвтора + " КАК Автор,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Документ." + МетаДокумента.Имя + " КАК Д
			|ГДЕ
			|	Д.Дата МЕЖДУ &Начало И &Конец
			|	И НЕ Д.ПометкаУдаления
			|СГРУППИРОВАТЬ ПО
			|	Д." + ПолеАвтора + "
			|УПОРЯДОЧИТЬ ПО
			|	Количество УБЫВ";
		Авторы = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Авторы.Добавить(Псевдоним(Выборка.Автор, Псевдонимы) + " " + Выборка.Количество);
		КонецЦикла;
		СтрокаСводки.Авторы = СтрСоединить(Авторы, ", ");
	КонецЕсли;

	// строк в документах — сколько набирать руками
	МетаТЧ = ОсновнаяТабличнаяЧасть(МетаДокумента);
	Если МетаТЧ <> Неопределено Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Документ." + МетаДокумента.Имя + "." + МетаТЧ.Имя + " КАК Т
			|ГДЕ
			|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
			|	И НЕ Т.Ссылка.ПометкаУдаления";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтрокаСводки.Строк = Выборка.Количество;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОписатьВид(МетаДокумента, Начало, Конец, Строки, Псевдонимы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	ИмяТаблицы = "Документ." + МетаДокумента.Имя;

	// типичные сочетания реквизитов шапки: откуда, куда, операция, статья
	ПоляШапки = Новый Массив;
	Для Каждого ИмяРеквизита Из СтрРазделить("ХозяйственнаяОперация,Склад,СкладОтправитель,СкладПолучатель,Отправитель,Получатель,"
		+ "Подразделение,СтатьяРасходов,СтатьяДвиженияДенежныхСредств,Контрагент", ",") Цикл
		Если ПоляШапки.Количество() < 3 И МетаДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			ПоляШапки.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	ЕстьСумма = МетаДокумента.Реквизиты.Найти("СуммаДокумента") <> Неопределено;
	Если ПоляШапки.Количество() > 0 Тогда
		СписокПолей = Новый Массив;
		Для Каждого ИмяРеквизита Из ПоляШапки Цикл
			СписокПолей.Добавить("Д." + ИмяРеквизита);
		КонецЦикла;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 10
			|	" + СтрСоединить(СписокПолей, ", ") + ",
			|	КОЛИЧЕСТВО(*) КАК Количество,
			|	" + ?(ЕстьСумма, "СУММА(Д.СуммаДокумента)", "0") + " КАК Сумма
			|ИЗ
			|	" + ИмяТаблицы + " КАК Д
			|ГДЕ
			|	Д.Дата МЕЖДУ &Начало И &Конец
			|	И НЕ Д.ПометкаУдаления
			|СГРУППИРОВАТЬ ПО
			|	" + СтрСоединить(СписокПолей, ", ") + "
			|УПОРЯДОЧИТЬ ПО
			|	Количество УБЫВ";
		Строки.Добавить("   Чаще всего (" + СтрСоединить(ПоляШапки, " / ") + "):");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Значения = Новый Массив;
			Для Каждого ИмяРеквизита Из ПоляШапки Цикл
				Значения.Добавить(Псевдоним(Выборка[ИмяРеквизита], Псевдонимы));
			КонецЦикла;
			Строки.Добавить("      " + Дополнить(ФорматЧисла(Выборка.Количество) + " шт.", 9) + СтрСоединить(Значения, " / ")
				+ ?(ЕстьСумма И Выборка.Сумма <> 0, "  на " + ФорматЧисла(Выборка.Сумма), ""));
		КонецЦикла;
	КонецЕсли;

	// регулярные платежи и получатели: контрагент есть в каждом месяце периода
	Если ЕстьСумма И МетаДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	В.Контрагент КАК Контрагент,
			|	СУММА(В.Количество) КАК Количество,
			|	КОЛИЧЕСТВО(*) КАК Месяцев,
			|	СУММА(В.Сумма) КАК Сумма
			|ИЗ
			|	(ВЫБРАТЬ
			|		Д.Контрагент КАК Контрагент,
			|		НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) КАК Месяц,
			|		КОЛИЧЕСТВО(*) КАК Количество,
			|		СУММА(Д.СуммаДокумента) КАК Сумма
			|	ИЗ
			|		" + ИмяТаблицы + " КАК Д
			|	ГДЕ
			|		Д.Дата МЕЖДУ &Начало И &Конец
			|		И НЕ Д.ПометкаУдаления
			|	СГРУППИРОВАТЬ ПО
			|		Д.Контрагент,
			|		НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)) КАК В
			|СГРУППИРОВАТЬ ПО
			|	В.Контрагент
			|ИМЕЮЩИЕ
			|	СУММА(В.Количество) >= 3
			|УПОРЯДОЧИТЬ ПО
			|	Количество УБЫВ";
		Таблица = Запрос.Выполнить().Выгрузить();
		ВсегоМесяцев = 1 + Месяц(Конец) - Месяц(Начало) + 12 * (Год(Конец) - Год(Начало));
		Регулярные = Новый Массив;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.Контрагент) И СтрокаТаблицы.Месяцев >= Мин(3, ВсегоМесяцев) И Регулярные.Количество() < 15 Тогда
				Регулярные.Добавить("      " + Дополнить(ФорматЧисла(СтрокаТаблицы.Количество) + " шт.", 9)
					+ Псевдоним(СтрокаТаблицы.Контрагент, Псевдонимы) + " — в " + СтрокаТаблицы.Месяцев + " мес., на " + ФорматЧисла(СтрокаТаблицы.Сумма));
			КонецЕсли;
		КонецЦикла;
		Если Регулярные.Количество() > 0 Тогда
			Строки.Добавить("   Повторяются каждый месяц (кандидаты в шаблоны и автозаполнение):");
			Для Каждого ТекстСтроки Из Регулярные Цикл
				Строки.Добавить(ТекстСтроки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	МетаТЧ = ОсновнаяТабличнаяЧасть(МетаДокумента);
	Если МетаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяТЧ = ИмяТаблицы + "." + МетаТЧ.Имя;
	ЕстьКоличество = МетаТЧ.Реквизиты.Найти("Количество") <> Неопределено;

	// чаще всего встречающаяся номенклатура
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 15
		|	Т.Номенклатура КАК Номенклатура,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК Документов,
		|	" + ?(ЕстьКоличество, "СУММА(Т.Количество)", "0") + " КАК Количество
		|ИЗ
		|	" + ИмяТЧ + " КАК Т
		|ГДЕ
		|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Т.Ссылка.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура
		|УПОРЯДОЧИТЬ ПО
		|	Документов УБЫВ";
	Строки.Добавить("   Чаще всего в строках (в скольких документах, сколько всего):");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("      " + Дополнить(ФорматЧисла(Выборка.Документов) + " док.", 10) + Псевдоним(Выборка.Номенклатура, Псевдонимы)
			+ ?(ЕстьКоличество, " — " + Формат(Выборка.Количество, "ЧДЦ=3; ЧН=0; ЧГ=3,0"), ""));
	КонецЦикла;

	// одинаковые наборы строк: такие документы можно создавать по шаблону
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номенклатура КАК Номенклатура
		|ИЗ
		|	" + ИмяТЧ + " КАК Т
		|ГДЕ
		|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Т.Ссылка.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Т.Ссылка,
		|	Т.Номенклатура";
	Наборы = Новый Соответствие;
	Примеры = Новый Соответствие;
	ТекущийДокумент = Неопределено;
	Ключи = Новый Массив;
	Названия = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Истина Цикл
		ЕстьСтрока = Выборка.Следующий();
		Если НЕ ЕстьСтрока ИЛИ Выборка.Ссылка <> ТекущийДокумент Тогда
			Если ТекущийДокумент <> Неопределено И Ключи.Количество() > 0 Тогда
				КлючНабора = СтрСоединить(Ключи, ";");
				Наборы.Вставить(КлючНабора, ?(Наборы[КлючНабора] = Неопределено, 0, Наборы[КлючНабора]) + 1);
				Если Примеры[КлючНабора] = Неопределено Тогда
					Примеры.Вставить(КлючНабора, Названия);
				КонецЕсли;
			КонецЕсли;
			Если НЕ ЕстьСтрока Тогда
				Прервать;
			КонецЕсли;
			ТекущийДокумент = Выборка.Ссылка;
			Ключи = Новый Массив;
			Названия = Новый Массив;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			КлючСтроки = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
			Если Ключи.Найти(КлючСтроки) = Неопределено Тогда
				Ключи.Добавить(КлючСтроки);
				Названия.Добавить(Псевдоним(Выборка.Номенклатура, Псевдонимы));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Повторы = Новый ТаблицаЗначений;
	Повторы.Колонки.Добавить("Раз", Новый ОписаниеТипов("Число"));
	Повторы.Колонки.Добавить("Названия");
	Для Каждого КлючИЗначение Из Наборы Цикл
		Если КлючИЗначение.Значение >= 3 Тогда
			СтрокаПовтора = Повторы.Добавить();
			СтрокаПовтора.Раз = КлючИЗначение.Значение;
			СтрокаПовтора.Названия = Примеры[КлючИЗначение.Ключ];
		КонецЕсли;
	КонецЦикла;
	Повторы.Сортировать("Раз Убыв");
	Если Повторы.Количество() > 0 Тогда
		Строки.Добавить("   Одинаковый состав строк повторяется (можно вводить по шаблону):");
		Номер = 0;
		Для Каждого СтрокаПовтора Из Повторы Цикл
			Номер = Номер + 1;
			Если Номер > 10 Тогда
				Прервать;
			КонецЕсли;
			Состав = Новый Массив;
			Для Индекс = 0 По Мин(5, СтрокаПовтора.Названия.Количество()) - 1 Цикл
				Состав.Добавить(СтрокаПовтора.Названия[Индекс]);
			КонецЦикла;
			Строки.Добавить("      " + Дополнить(СтрокаПовтора.Раз + " раз", 9) + "(" + СтрокаПовтора.Названия.Количество() + " поз.) "
				+ СтрСоединить(Состав, "; ") + ?(СтрокаПовтора.Названия.Количество() > 5, "; …", ""));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДниБезРапортов(Строки)

	Если Метаданные.Документы.Найти("ПроизводствоБезЗаказа") = Неопределено Тогда
		Строки.Добавить("   в конфигурации нет документа «Производство без заказа»");
		Возврат;
	КонецЕсли;
	Конец = НачалоДня(ТекущаяДатаСеанса());
	Начало = Конец - 29 * 86400;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ) КАК День
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа КАК Д
		|ГДЕ
		|	Д.Дата МЕЖДУ &Начало И &Конец
		|	И Д.Проведен";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	ЕстьРапорт = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЕстьРапорт.Вставить(Выборка.День, Истина);
	КонецЦикла;
	Пропуски = Новый Массив;
	День = Начало;
	Пока День <= Конец Цикл
		Если ДеньНедели(День) <= 5 И ЕстьРапорт[День] = Неопределено Тогда
			Пропуски.Добавить(Формат(День, "ДФ=dd.MM"));
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
	Строки.Добавить("   Дней с рапортами: " + ЕстьРапорт.Количество() + " из 30. Будни без рапорта: "
		+ ?(Пропуски.Количество() = 0, "нет", СтрСоединить(Пропуски, ", ")));

КонецПроцедуры

&НаСервере
Процедура ВывестиТекст(Строки)

	ТД = Новый ТабличныйДокумент;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ШрифтТекста = Новый Шрифт("Courier New", 9);
	Номер = 0;
	Для Каждого ТекстСтроки Из Строки Цикл
		Номер = Номер + 1;
		Обл = ТД.Область(Номер, 1, Номер, 1);
		Обл.Текст = ТекстСтроки;
		Обл.Шрифт = ШрифтТекста;
		Если СтрНачинаетсяС(ТекстСтроки, "====") Тогда
			Обл.Шрифт = Новый Шрифт("Courier New", 10, Истина);
		КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.ДокументАудита = ТД;

КонецПроцедуры

#КонецОбласти

#Область СтарыеЗаказы

// Виды заказов: документы, у которых реквизит «Статус» — перечисление со значением «Закрыт».
&НаСервереБезКонтекста
Функция ВидыЗаказов()

	Виды = Новый Массив;
	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		Если НЕ СтрНачинаетсяС(МетаДокумента.Имя, "Заказ") Тогда
			Продолжить;
		КонецЕсли;
		МетаСтатуса = МетаДокумента.Реквизиты.Найти("Статус");
		Если МетаСтатуса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Типы = МетаСтатуса.Тип.Типы();
		Если Типы.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;
		МетаПеречисления = Метаданные.НайтиПоТипу(Типы[0]);
		Если МетаПеречисления = Неопределено ИЛИ НЕ Метаданные.Перечисления.Содержит(МетаПеречисления)
			ИЛИ МетаПеречисления.ЗначенияПеречисления.Найти("Закрыт") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вид = Новый Структура("Мета, Закрыт", МетаДокумента, Перечисления[МетаПеречисления.Имя].Закрыт);
		Виды.Добавить(Вид);
	КонецЦикла;
	Возврат Виды;

КонецФункции

// Последнее движение по заказу: дата последней отгрузки (для заказов клиентов) или поступления (для заказов поставщикам).
&НаСервереБезКонтекста
Функция ПоследниеДвижения(МетаЗаказа, Ссылки)

	Результат = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если МетаЗаказа.Имя = "ЗаказКлиента" Тогда
		Источники = "РеализацияТоваровУслуг";
	ИначеЕсли МетаЗаказа.Имя = "ЗаказПоставщику" Тогда
		Источники = "ПриобретениеТоваровУслуг";
	ИначеЕсли МетаЗаказа.Имя = "ЗаказМатериаловВПроизводство" Тогда
		Источники = "ПередачаМатериаловВПроизводство,ПроизводствоБезЗаказа";
	Иначе
		Возврат Результат;
	КонецЕсли;
	Для Каждого ИмяИсточника Из СтрРазделить(Источники, ",") Цикл
		МетаИсточника = Метаданные.Документы.Найти(ИмяИсточника);
		Если МетаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Таблица = "";
		Для Каждого МетаТЧ Из МетаИсточника.ТабличныеЧасти Цикл
			Если МетаТЧ.Реквизиты.Найти(МетаЗаказа.Имя) <> Неопределено Тогда
				Таблица = "Документ." + ИмяИсточника + "." + МетаТЧ.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Таблица = "" И МетаИсточника.Реквизиты.Найти(МетаЗаказа.Имя) <> Неопределено Тогда
			Таблица = "Документ." + ИмяИсточника;
		КонецЕсли;
		Если Таблица = "" Тогда
			Продолжить;
		КонецЕсли;
		ПолеДокумента = ?(СтрЧислоВхождений(Таблица, ".") = 2, "Т.Ссылка", "Т");
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т." + МетаЗаказа.Имя + " КАК Заказ,
			|	МАКСИМУМ(" + ПолеДокумента + ".Дата) КАК Дата
			|ИЗ
			|	" + Таблица + " КАК Т
			|ГДЕ
			|	Т." + МетаЗаказа.Имя + " В (&Ссылки)
			|	И " + ПолеДокумента + ".Проведен
			|СГРУППИРОВАТЬ ПО
			|	Т." + МетаЗаказа.Имя;
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Было = Результат[Выборка.Заказ];
			Если Было = Неопределено ИЛИ Выборка.Дата > Было Тогда
				Результат.Вставить(Выборка.Заказ, Выборка.Дата);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура НайтиЗаказыНаСервере()

	ЭтотОбъект.Заказы.Очистить();
	Граница = НачалоДня(ТекущаяДатаСеанса()) - Макс(30, ЭтотОбъект.СтаршеДней) * 86400;
	Для Каждого Вид Из ВидыЗаказов() Цикл
		МетаДокумента = Вид.Мета;
		ПолеКто = ПервыйРеквизит(МетаДокумента, "Контрагент,Партнер,Подразделение,Склад");
		ЕстьСумма = МетаДокумента.Реквизиты.Найти("СуммаДокумента") <> Неопределено;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Д.Ссылка КАК Ссылка,
			|	Д.Дата КАК Дата,
			|	" + ?(ПолеКто = "", "НЕОПРЕДЕЛЕНО", "Д." + ПолеКто) + " КАК Кто,
			|	" + ?(ЕстьСумма, "Д.СуммаДокумента", "0") + " КАК Сумма,
			|	Д.Статус КАК Статус
			|ИЗ
			|	Документ." + МетаДокумента.Имя + " КАК Д
			|ГДЕ
			|	Д.Проведен
			|	И Д.Статус <> &Закрыт
			|	И Д.Дата < &Граница
			|УПОРЯДОЧИТЬ ПО
			|	Д.Дата";
		Запрос.УстановитьПараметр("Закрыт", Вид.Закрыт);
		Запрос.УстановитьПараметр("Граница", Граница);
		Таблица = Запрос.Выполнить().Выгрузить();
		Движения = ПоследниеДвижения(МетаДокумента, Таблица.ВыгрузитьКолонку("Ссылка"));
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Последнее = Движения[СтрокаТаблицы.Ссылка];
			Если Последнее <> Неопределено И Последнее >= Граница Тогда
				Продолжить; // по заказу недавно были отгрузки или поступления — он живой
			КонецЕсли;
			СтрокаЗаказа = ЭтотОбъект.Заказы.Добавить();
			СтрокаЗаказа.ВидЗаказа = МетаДокумента.Синоним;
			СтрокаЗаказа.Заказ = СтрокаТаблицы.Ссылка;
			СтрокаЗаказа.ДатаЗаказа = СтрокаТаблицы.Дата;
			СтрокаЗаказа.Кто = ?(ЗначениеЗаполнено(СтрокаТаблицы.Кто), Строка(СтрокаТаблицы.Кто), "");
			СтрокаЗаказа.Сумма = СтрокаТаблицы.Сумма;
			СтрокаЗаказа.Статус = Строка(СтрокаТаблицы.Статус);
			СтрокаЗаказа.ПоследнееДвижение = ?(Последнее = Неопределено, Дата(1, 1, 1), Последнее);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗакрытьОтмеченныеНаСервере()

	Итог = Новый Структура("Закрыто, Ошибки", 0, 0);
	ЗначенияЗакрыт = Новый Соответствие;
	Для Каждого Вид Из ВидыЗаказов() Цикл
		ЗначенияЗакрыт.Вставить(Вид.Мета.ПолноеИмя(), Вид.Закрыт);
	КонецЦикла;
	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		Если НЕ СтрокаЗаказа.Пометка Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗаказа.Пометка = Ложь;
		МетаДокумента = СтрокаЗаказа.Заказ.Метаданные();
		Закрыт = ЗначенияЗакрыт[МетаДокумента.ПолноеИмя()];
		// 1) как в форме заказа: только статус «Закрыт»
		Попытка
			ОбъектЗаказа = СтрокаЗаказа.Заказ.ПолучитьОбъект();
			ОбъектЗаказа.Статус = Закрыт;
			ОбъектЗаказа.Записать(РежимЗаписиДокумента.Проведение);
			СтрокаЗаказа.Результат = "закрыт";
			СтрокаЗаказа.Статус = Строка(Закрыт);
			Итог.Закрыто = Итог.Закрыто + 1;
			Продолжить;
		Исключение
			ПерваяОшибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		// 2) ERP не даёт закрыть с неотгруженными строками — отменяем их с причиной отмены
		Попытка
			ОбъектЗаказа = СтрокаЗаказа.Заказ.ПолучитьОбъект();
			Отменено = ОтменитьСтроки(ОбъектЗаказа, МетаДокумента);
			ОбъектЗаказа.Статус = Закрыт;
			ОбъектЗаказа.Записать(РежимЗаписиДокумента.Проведение);
			СтрокаЗаказа.Результат = "закрыт, отменено строк: " + Отменено;
			СтрокаЗаказа.Статус = Строка(Закрыт);
			Итог.Закрыто = Итог.Закрыто + 1;
		Исключение
			СтрокаЗаказа.Результат = "НЕ ЗАКРЫТ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЭтотОбъект.ЖурналОшибок = ЭтотОбъект.ЖурналОшибок + Символы.ПС + Строка(СтрокаЗаказа.Заказ) + ": " + ПерваяОшибка
				+ " / " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Итог.Ошибки = Итог.Ошибки + 1;
		КонецПопытки;
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаСервере
Функция ОтменитьСтроки(ОбъектЗаказа, МетаДокумента)

	Отменено = 0;
	Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
		Если МетаТЧ.Реквизиты.Найти("Отменено") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЕстьПричина = МетаТЧ.Реквизиты.Найти("ПричинаОтмены") <> Неопределено;
		Причина = ?(ЕстьПричина, ПричинаОтмены(МетаТЧ.Реквизиты.ПричинаОтмены), Неопределено);
		Для Каждого СтрокаТЧ Из ОбъектЗаказа[МетаТЧ.Имя] Цикл
			Если НЕ СтрокаТЧ.Отменено Тогда
				СтрокаТЧ.Отменено = Истина;
				Если ЕстьПричина И НЕ ЗначениеЗаполнено(СтрокаТЧ.ПричинаОтмены) И Причина <> Неопределено Тогда
					СтрокаТЧ.ПричинаОтмены = Причина;
				КонецЕсли;
				Отменено = Отменено + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Отменено;

КонецФункции

// Первая причина отмены из справочника; если справочник пуст — создаётся «Неактуальный заказ».
&НаСервере
Функция ПричинаОтмены(МетаРеквизита)

	Типы = МетаРеквизита.Тип.Типы();
	Если Типы.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаСправочника = Метаданные.НайтиПоТипу(Типы[0]);
	Если МетаСправочника = Неопределено ИЛИ НЕ Метаданные.Справочники.Содержит(МетаСправочника) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	С.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + МетаСправочника.Имя + " КАК С
		|ГДЕ
		|	НЕ С.ПометкаУдаления
		|	" + ?(МетаСправочника.Иерархический И МетаСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов, "И НЕ С.ЭтоГруппа", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	С.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	НоваяПричина = Справочники[МетаСправочника.Имя].СоздатьЭлемент();
	НоваяПричина.Наименование = "Неактуальный заказ";
	НоваяПричина.Записать();
	Возврат НоваяПричина.Ссылка;

КонецФункции

#КонецОбласти

#Область ПостроениеФормы

&НаСервере
Процедура СоздатьРеквизиты()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаНачала", ТипДата, , "С"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаОкончания", ТипДата, , "по"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДокументАудита", Новый ОписаниеТипов("ТабличныйДокумент"), , "Аудит"));
	Реквизиты.Добавить(Новый РеквизитФормы("ТекстАудита", ТипСтрока));
	Реквизиты.Добавить(Новый РеквизитФормы("ЖурналОшибок", ТипСтрока));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоказыватьНаименования", Новый ОписаниеТипов("Булево"), , "Показать настоящие наименования (только на экране, файл не пересылать)"));
	Реквизиты.Добавить(Новый РеквизитФормы("СтаршеДней", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный)), ,
		"Без движения больше, дней"));

	Реквизиты.Добавить(Новый РеквизитФормы("Заказы", Новый ОписаниеТипов("ТаблицаЗначений"), , "Старые заказы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Пометка", Новый ОписаниеТипов("Булево"), "Заказы", " "));
	Реквизиты.Добавить(Новый РеквизитФормы("ВидЗаказа", ТипСтрока, "Заказы", "Вид"));
	Реквизиты.Добавить(Новый РеквизитФормы("Заказ", Новый ОписаниеТипов(ТипыЗаказов()), "Заказы", "Заказ"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаЗаказа", ТипДата, "Заказы", "Дата"));
	Реквизиты.Добавить(Новый РеквизитФормы("Кто", ТипСтрока, "Заказы", "Контрагент / подразделение"));
	Реквизиты.Добавить(Новый РеквизитФормы("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)), "Заказы", "Сумма"));
	Реквизиты.Добавить(Новый РеквизитФормы("Статус", ТипСтрока, "Заказы", "Статус"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоследнееДвижение", ТипДата, "Заказы", "Последняя отгрузка / поступление"));
	Реквизиты.Добавить(Новый РеквизитФормы("Результат", ТипСтрока, "Заказы", "Результат"));
	ИзменитьРеквизиты(Реквизиты);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипыЗаказов()

	Имена = Новый Массив;
	Для Каждого Вид Из ВидыЗаказов() Цикл
		Имена.Добавить("ДокументСсылка." + Вид.Мета.Имя);
	КонецЦикла;
	Если Имена.Количество() = 0 Тогда
		Имена.Добавить("ДокументСсылка.ЗаказКлиента");
	КонецЕсли;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

&НаСервере
Процедура СоздатьКоманды()

	ДобавитьКоманду("СобратьАудит", "Собрать аудит", "Посчитать, какие документы и сколько вводятся вручную");
	ДобавитьКоманду("СохранитьАудит", "Сохранить в файл", "Сохранить аудит в текстовый файл, чтобы прислать в чат");
	ДобавитьКоманду("НайтиЗаказы", "Найти старые заказы", "Незакрытые заказы без движения дольше указанного срока");
	ДобавитьКоманду("ОтметитьВсе", "Отметить все", "");
	ДобавитьКоманду("СнятьОтметки", "Снять отметки", "");
	ДобавитьКоманду("ЗакрытьОтмеченные", "Закрыть отмеченные", "Поставить отмеченным заказам статус «Закрыт»");
	ДобавитьКоманду("СообщитьОбОшибке", "Сообщить об ошибке", "Собрать тексты ошибок в файл, чтобы прислать в чат");

	Кнопка = Элементы.Добавить("КнопкаСообщитьОбОшибке", Тип("КнопкаФормы"), КоманднаяПанель);
	Кнопка.ИмяКоманды = "СообщитьОбОшибке";

КонецПроцедуры

&НаСервере
Процедура ДобавитьКоманду(Имя, ТекстЗаголовка, ТекстПодсказки)

	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = ТекстЗаголовка;
	Команда.Действие = Имя;
	Если НЕ ПустаяСтрока(ТекстПодсказки) Тогда
		Команда.Подсказка = ТекстПодсказки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементы()

	Страницы = ДобавитьГруппу("Страницы", ЭтотОбъект, ВидГруппыФормы.Страницы);

	// --- Аудит
	СтраницаАудит = ДобавитьГруппу("СтраницаАудит", Страницы, ВидГруппыФормы.Страница, "Аудит ручной работы");
	Надпись = Элементы.Добавить("ПодсказкаАудит", Тип("ДекорацияФормы"), СтраницаАудит);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = "Показывает, какие документы, кто и сколько вводит вручную, какие строки и платежи повторяются, "
		+ "в какие дни нет суточных рапортов. Ничего не меняет в базе. Наименований в файле нет — вместо них коды. Нажмите «Собрать аудит», затем «Сохранить в файл» и пришлите файл в чат.";
	Надпись.РастягиватьПоГоризонтали = Истина;
	ГруппаПериод = ДобавитьГруппу("ГруппаПериод", СтраницаАудит, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("ДатаНачала", "ДатаНачала", ГруппаПериод);
	ДобавитьПоле("ДатаОкончания", "ДатаОкончания", ГруппаПериод);
	Поле = ДобавитьПоле("ПоказыватьНаименования", "ПоказыватьНаименования", ГруппаПериод, ВидПоляФормы.ПолеФлажка);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ДобавитьКнопку("СобратьАудит", ГруппаПериод).КнопкаПоУмолчанию = Истина;
	ДобавитьКнопку("СохранитьАудит", ГруппаПериод);
	Поле = ДобавитьПоле("ДокументАудита", "ДокументАудита", СтраницаАудит, ВидПоляФормы.ПолеТабличногоДокумента);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;

	// --- Старые заказы
	СтраницаЗаказы = ДобавитьГруппу("СтраницаЗаказы", Страницы, ВидГруппыФормы.Страница, "Старые заказы");
	Надпись = Элементы.Добавить("ПодсказкаЗаказы", Тип("ДекорацияФормы"), СтраницаЗаказы);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = "Незакрытые заказы всех видов, по которым давно не было отгрузок и поступлений. Они засоряют списки, "
		+ "обеспечение и «в пути». Двойной щелчок открывает заказ. Отметьте ненужные и нажмите «Закрыть отмеченные». "
		+ "В первый раз проверьте на 1–2 заказах.";
	Надпись.РастягиватьПоГоризонтали = Истина;
	ГруппаКнопки = ДобавитьГруппу("ГруппаКнопкиЗаказов", СтраницаЗаказы, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("СтаршеДней", "СтаршеДней", ГруппаКнопки);
	ДобавитьКнопку("НайтиЗаказы", ГруппаКнопки);
	ДобавитьКнопку("ОтметитьВсе", ГруппаКнопки);
	ДобавитьКнопку("СнятьОтметки", ГруппаКнопки);
	ДобавитьКнопку("ЗакрытьОтмеченные", ГруппаКнопки);

	ТаблицаЗаказов = Элементы.Добавить("Заказы", Тип("ТаблицаФормы"), СтраницаЗаказы);
	ТаблицаЗаказов.ПутьКДанным = "Заказы";
	ТаблицаЗаказов.ИзменятьСоставСтрок = Ложь;
	ТаблицаЗаказов.ИзменятьПорядокСтрок = Ложь;
	ТаблицаЗаказов.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ТаблицаЗаказов.УстановитьДействие("Выбор", "ЗаказыВыбор");
	Для Каждого Колонка Из СтрРазделить("Пометка,ВидЗаказа,Заказ,ДатаЗаказа,Кто,Сумма,Статус,ПоследнееДвижение,Результат", ",") Цикл
		Поле = ДобавитьПоле("Заказы" + Колонка, "Заказы." + Колонка, ТаблицаЗаказов,
			?(Колонка = "Пометка", ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода));
		Если Колонка <> "Пометка" Тогда
			Поле.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Родитель, ВидГруппы, ТекстЗаголовка = "", Горизонтальная = Ложь)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппы;
	Если ВидГруппы = ВидГруппыФормы.ОбычнаяГруппа Тогда
		Группа.ОтображатьЗаголовок = НЕ ПустаяСтрока(ТекстЗаголовка);
		Группа.Группировка = ?(Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстЗаголовка) Тогда
		Группа.Заголовок = ТекстЗаголовка;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
Функция ДобавитьПоле(Имя, ПутьКДанным, Родитель, ВидПоля = Неопределено)

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Вид = ?(ВидПоля = Неопределено, ВидПоляФормы.ПолеВвода, ВидПоля);
	Возврат Поле;

КонецФункции

&НаСервере
Функция ДобавитьКнопку(ИмяКомандыКнопки, Родитель)

	Кнопка = Элементы.Добавить("Кнопка" + ИмяКомандыКнопки, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = ИмяКомандыКнопки;
	Возврат Кнопка;

КонецФункции

#КонецОбласти
