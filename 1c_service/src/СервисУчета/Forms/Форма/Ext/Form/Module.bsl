// Форма обработки «Сервис учёта» (1С:ERP 2.5).
//
// Закладка «Аудит ручной работы»: сколько документов каждого вида вводится вручную, кем,
// сколько в них строк, какие наборы строк повторяются (кандидаты в шаблоны), какие платежи
// регулярные, в какие дни не введены суточные рапорты. Ничего не меняет в базе.
//
// Закладка «Старые заказы»: незакрытые заказы любых видов (клиентов, поставщикам, материалов
// в производство, на производство и т.д.) старше N дней, по которым давно не было движения.
// Отмеченные закрываются статусом «Закрыт».
//
// Реквизиты и элементы формы создаются в ПриСозданииНаСервере, поэтому Form.xml почти пустой.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();

	ЭтотОбъект.ДатаОкончания = НачалоДня(ТекущаяДатаСеанса());
	ЭтотОбъект.ДатаНачала = ДобавитьМесяц(ЭтотОбъект.ДатаОкончания, -3);
	ЭтотОбъект.СтаршеДней = 180;
	Заголовок = "Сервис учёта";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СобратьАудит(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаНачала) ИЛИ ЭтотОбъект.ДатаОкончания < ЭтотОбъект.ДатаНачала Тогда
		ПоказатьПредупреждение(, "Укажите период аудита.");
		Возврат;
	КонецЕсли;
	Состояние("Собираю полный аудит: просматриваю все документы и справочники, это 3–15 минут...");
	Попытка
		СобратьАудитНаСервере();
	Исключение
		ЗапомнитьОшибку("Аудит", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Аудит не собрался:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
		Возврат;
	КонецПопытки;
	ПоказатьОповещениеПользователя("Аудит готов", , "Нажмите «Сохранить в файл» и пришлите файл в чат");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьАудит(Команда)

	Если ПустаяСтрока(ЭтотОбъект.ТекстАудита) Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Собрать аудит».");
		Возврат;
	КонецЕсли;
	СохранитьТекст(ЭтотОбъект.ТекстАудита, ?(ЭтотОбъект.ПоказыватьНаименования, "НЕ_ПЕРЕСЫЛАТЬ_", "") + "Аудит_ручной_работы_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".txt");

КонецПроцедуры

&НаКлиенте
Процедура НайтиЗаказы(Команда)

	Состояние("Ищу старые незакрытые заказы...");
	Попытка
		НайтиЗаказыНаСервере();
	Исключение
		ЗапомнитьОшибку("Поиск заказов", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Не получилось найти заказы:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если ЭтотОбъект.Заказы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Старых незакрытых заказов не найдено.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		СтрокаЗаказа.Пометка = ПустаяСтрока(СтрокаЗаказа.Результат);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		СтрокаЗаказа.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОтмеченные(Команда)

	Отмечено = 0;
	Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
		Если СтрокаЗаказа.Пометка Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте галочкой заказы, которые нужно закрыть.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЗакрытьОтмеченныеПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Закрыть отмеченные заказы (" + Отмечено + " шт.)?" + Символы.ПС + Символы.ПС
		+ "Заказу ставится статус «Закрыт», неотгруженные строки отменяются. Отгрузки и оплаты не меняются."
		+ " Вернуть заказ можно вручную: открыть его и поменять статус." + Символы.ПС + Символы.ПС
		+ "Совет: в первый раз отметьте 1–2 заказа и проверьте результат.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОтмеченныеПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние("Закрываю заказы...");
	Итог = ЗакрытьОтмеченныеНаСервере();
	ПоказатьПредупреждение(, "Закрыто: " + Итог.Закрыто + ". Не удалось: " + Итог.Ошибки + "."
		+ ?(Итог.Ошибки > 0, Символы.ПС + "Причина — в колонке «Результат». Такие заказы откройте и закройте вручную"
		+ " или нажмите «Сообщить об ошибке».", ""));

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаЗаказа = ЭтотОбъект.Заказы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаЗаказа <> Неопределено Тогда
		ПоказатьЗначение(, СтрокаЗаказа.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибке(Команда)

	СисИнфо = Новый СистемнаяИнформация;
	Строки = Новый Массив;
	Строки.Добавить("СООБЩЕНИЕ ОБ ОШИБКЕ: Сервис учёта, версия " + ВерсияПрограммы());
	Строки.Добавить("1С на компьютере: " + СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + "); " + СисИнфо.ВерсияОС);
	Строки.Добавить(СведенияОБазе());
	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ");
	Строки.Добавить(?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), "  нет", ЭтотОбъект.ЖурналОшибок));
	СохранитьТекст(СтрСоединить(Строки, Символы.ПС), "Ошибка_сервис_учета_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmm") + ".txt");

КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьКод(Команда)

	ПоказатьПредупреждение(, ОбезлРасшифровать(ЭтотОбъект.КодДляРасшифровки));

КонецПроцедуры

#КонецОбласти

#Область Общее

&НаКлиенте
Процедура СохранитьТекст(Текст, ИмяФайлаТекста)

	Адрес = ПоместитьТекстВХранилище(Текст, Лев(ИмяФайлаТекста, 13) <> "НЕ_ПЕРЕСЫЛАТЬ");
	ПоказатьОповещениеПользователя("Сохраните файл и пришлите его в чат", , ИмяФайлаТекста);
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайлаТекста);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПоместитьТекстВХранилище(Знач Текст, Обезличить)

	// всё, что уходит в чат, обезличивается здесь: названия -> коды, длинные номера -> звёздочки
	Если Обезличить Тогда
		Текст = ОбезличитьДляЧата(Текст);
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция СведенияОБазе()

	СисИнфо = Новый СистемнаяИнформация;
	Возврат "Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + "; 1С на сервере: " + СисИнфо.ВерсияПриложения;

КонецФункции

&НаСервереБезКонтекста
Функция ВерсияПрограммы()

	Возврат "2.2 от 25.11.2026";

КонецФункции

&НаКлиенте
Процедура ЗапомнитьОшибку(Где, Инфо)

	Запись = "[" + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + Где + ":" + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо);
	ЭтотОбъект.ЖурналОшибок = ?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), Запись, ЭтотОбъект.ЖурналОшибок + Символы.ПС + Символы.ПС + Запись);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьРеквизит(МетаОбъекта, ИмяРеквизита)

	Если МетаОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Возврат МетаОбъекта.СтандартныеРеквизиты.Найти(ИмяРеквизита) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПервыйРеквизит(МетаОбъекта, СписокИмен)

	Для Каждого ИмяРеквизита Из СтрРазделить(СписокИмен, ",") Цикл
		Если МетаОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ОсновнаяТабличнаяЧасть(МетаДокумента)

	// табличная часть с номенклатурой: сначала по привычным именам, потом любая с реквизитом «Номенклатура»
	Для Каждого ИмяТЧ Из СтрРазделить("Товары,Материалы,МатериалыИРаботы,ИзрасходованныеМатериалы,Продукция,Комплектующие", ",") Цикл
		МетаТЧ = МетаДокумента.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаТЧ <> Неопределено И МетаТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда
			Возврат МетаТЧ;
		КонецЕсли;
	КонецЦикла;
	Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
		Если МетаТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда
			Возврат МетаТЧ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ФорматЧисла(Число)

	Возврат Формат(Число, "ЧДЦ=0; ЧН=0; ЧГ=3,0");

КонецФункции

&НаСервереБезКонтекста
Функция Дополнить(Знач Текст, Ширина)

	Текст = Лев(Строка(Текст), Ширина);
	Возврат Текст + Лев("                                                                                ", Макс(0, Ширина - СтрДлина(Текст)));

КонецФункции

#КонецОбласти

#Область Обезличивание

// В файл аудита по умолчанию не попадает ни одно наименование: контрагенты, номенклатура, пользователи,
// склады и т.п. заменяются кодами «Контрагент-3», «Номенклатура-12». Один и тот же объект в пределах
// файла всегда получает один код, поэтому повторы и закономерности остаются видны.
// Значения перечислений (хоз. операции, статусы) — это стандартные названия ERP, они остаются.
&НаСервереБезКонтекста
Функция НовыеПсевдонимы(ПоказыватьНаименования)

	Возврат Новый Структура("Показывать, Коды, Счетчики, К", ПоказыватьНаименования, Новый Соответствие, Новый Соответствие, ОбезлКонтекст());

КонецФункции

&НаСервереБезКонтекста
Функция Псевдоним(Значение, Псевдонимы)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "не указан";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если Псевдонимы.Показывать Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Код = Псевдонимы.Коды[Значение];
	Если Код <> Неопределено Тогда
		Возврат Код;
	КонецЕсли;
	Код = ОбезлКод(Значение, Псевдонимы.К); // «Вид-хеш»: один код во всех файлах, расшифровка только в этой базе
	Псевдонимы.Коды.Вставить(Значение, Код);
	Возврат Код;

КонецФункции

&НаСервереБезКонтекста
Функция ВидОбъектаДляКода(МетаЗначения)

	Если МетаЗначения = Неопределено Тогда
		Возврат "Значение";
	КонецЕсли;
	Имена = Новый Соответствие;
	Имена.Вставить("Контрагенты", "Контрагент");
	Имена.Вставить("Партнеры", "Партнёр");
	Имена.Вставить("Номенклатура", "Номенклатура");
	Имена.Вставить("Пользователи", "Пользователь");
	Имена.Вставить("ФизическиеЛица", "Человек");
	Имена.Вставить("Сотрудники", "Человек");
	Имена.Вставить("Склады", "Склад");
	Имена.Вставить("СтруктураПредприятия", "Подразделение");
	Имена.Вставить("Организации", "Организация");
	Имена.Вставить("СтатьиРасходов", "Статья расходов");
	Имена.Вставить("СтатьиДвиженияДенежныхСредств", "Статья ДДС");
	Имена.Вставить("ДоговорыКонтрагентов", "Договор");
	Имена.Вставить("БанковскиеСчетаОрганизаций", "Счёт");
	Вид = Имена[МетаЗначения.Имя];
	Возврат ?(Вид = Неопределено, МетаЗначения.Синоним, Вид);

КонецФункции

#КонецОбласти

#Область Аудит

&НаСервере
Процедура СобратьАудитНаСервере()

	Начало = НачалоДня(ЭтотОбъект.ДатаНачала);
	Конец = КонецДня(ЭтотОбъект.ДатаОкончания);
	Дней = Макс(1, Окр((Конец - Начало) / 86400));
	РабочихДней = Макс(1, Окр(Дней * 5 / 7));

	Строки = Новый Массив;
	Строки.Добавить("ПОЛНЫЙ АУДИТ 1С (Сервис учёта " + ВерсияПрограммы() + ")");
	Строки.Добавить(СведенияОБазе());
	Строки.Добавить("Период: " + Формат(Начало, "ДФ=dd.MM.yyyy") + " — " + Формат(Конец, "ДФ=dd.MM.yyyy")
		+ " (" + Дней + " дн., около " + РабочихДней + " рабочих)");
	Псевдонимы = НовыеПсевдонимы(ЭтотОбъект.ПоказыватьНаименования);
	Если ЭтотОбъект.ПоказыватьНаименования Тогда
		Строки.Добавить("ВНИМАНИЕ: включены настоящие наименования — такой файл не пересылайте. Для отправки снимите галочку и соберите аудит заново.");
	Иначе
		Строки.Добавить("Наименований в файле нет: контрагенты, номенклатура, пользователи, склады заменены кодами (Контрагент-3fa91c...), длинные номера скрыты.");
		Строки.Добавить("Один и тот же объект везде получает один код. Суммы и количества — настоящие.");
	КонецЕсли;
	ДлинаШапки = Строки.Количество();
	Кт = НовыйКонтекстАудита(Начало, Конец, Строки, Псевдонимы);

	// 1. сколько документов каждого вида
	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("Имя");
	Сводка.Колонки.Добавить("Представление");
	Сводка.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Сводка.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	Сводка.Колонки.Добавить("Авторы");
	Сводка.Колонки.Добавить("ПоМесяцам");
	Ошибки = Новый Массив;

	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		Попытка
			Количество = КоличествоДокументов(МетаДокумента, Начало, Конец);
		Исключение
			Ошибки.Добавить(МетаДокумента.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСводки = Сводка.Добавить();
		СтрокаСводки.Имя = МетаДокумента.Имя;
		СтрокаСводки.Представление = МетаДокумента.Синоним;
		СтрокаСводки.Количество = Количество;
		Попытка
			ПодробностиВида(МетаДокумента, Начало, Конец, СтрокаСводки, Псевдонимы);
		Исключение
			Ошибки.Добавить(МетаДокумента.Имя + " (подробности): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Сводка.Сортировать("Количество Убыв");

	Всего = Сводка.Итог("Количество");
	Строки.Добавить("");
	Строки.Добавить("==== 1. СКОЛЬКО ДОКУМЕНТОВ ВВОДИТСЯ ====");
	Строки.Добавить("Всего документов: " + ФорматЧисла(Всего) + ", в рабочий день около " + ФорматЧисла(Всего / РабочихДней)
		+ ". Видов документов в работе: " + Сводка.Количество());
	Строки.Добавить("");
	Строки.Добавить(Дополнить("Документ", 46) + Дополнить("всего", 8) + Дополнить("в день", 8) + Дополнить("строк в ср.", 12)
		+ Дополнить("по месяцам", 44) + "кто вводит");
	Для Каждого СтрокаСводки Из Сводка Цикл
		Строки.Добавить(Дополнить(СтрокаСводки.Представление, 46) + Дополнить(ФорматЧисла(СтрокаСводки.Количество), 8)
			+ Дополнить(Формат(СтрокаСводки.Количество / РабочихДней, "ЧДЦ=1; ЧН=0"), 8)
			+ Дополнить(?(СтрокаСводки.Строк = 0, "—", Формат(СтрокаСводки.Строк / СтрокаСводки.Количество, "ЧДЦ=1")), 12)
			+ Дополнить(СтрокаСводки.ПоМесяцам, 44) + СтрокаСводки.Авторы);
	КонецЦикла;

	// 2. подробности по видам, где больше всего ручной работы
	Строки.Добавить("");
	Строки.Добавить("==== 2. ЧТО ИМЕННО ВВОДИТСЯ (главные виды документов) ====");
	Подробно = Новый Массив;
	Для Каждого ИмяВида Из СтрРазделить("ВнутреннееПотребление,ПеремещениеТоваров,ДвижениеПродукцииИМатериалов,СборкаТоваров,"
		+ "ПроизводствоБезЗаказа,РеализацияТоваровУслуг,ПриобретениеТоваровУслуг,СписаниеБезналичныхДенежныхСредств,"
		+ "ПоступлениеБезналичныхДенежныхСредств,ЗаказМатериаловВПроизводство", ",") Цикл
		Если Сводка.Найти(ИмяВида, "Имя") <> Неопределено Тогда
			Подробно.Добавить(ИмяВида);
		КонецЕсли;
	КонецЦикла;
	Номер = 0;
	Для Каждого СтрокаСводки Из Сводка Цикл
		Номер = Номер + 1;
		Если Номер > 8 Тогда
			Прервать;
		КонецЕсли;
		Если Подробно.Найти(СтрокаСводки.Имя) = Неопределено Тогда
			Подробно.Добавить(СтрокаСводки.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяВида Из Подробно Цикл
		МетаДокумента = Метаданные.Документы[ИмяВида];
		Строки.Добавить("");
		Строки.Добавить("---- " + МетаДокумента.Синоним + " (" + ФорматЧисла(Сводка.Найти(ИмяВида, "Имя").Количество) + " шт.) ----");
		Попытка
			Повторов = ОписатьВид(МетаДокумента, Начало, Конец, Строки, Псевдонимы);
			Если Повторов > 0 Тогда
				Рекомендовать(Кт, 2, "Шаблоны", МетаДокумента.Синоним + ": одинаковый состав строк повторяется (" + Повторов
					+ " наборов, раздел 2). Такие документы набираются вручную снова и снова.",
					"Вводить копированием (F9 в списке) или сделать обработку-шаблон: выбрал шаблон — документ заполнен. Напишите, какие это позиции, — сделаю.");
			КонецЕсли;
		Исключение
			Строки.Добавить("   не получилось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// 3. пропуски суточных рапортов
	Строки.Добавить("");
	Строки.Добавить("==== 3. ДНИ БЕЗ СУТОЧНЫХ РАПОРТОВ (Производство без заказа), последние 30 дней ====");
	Попытка
		Пропусков = ДниБезРапортов(Строки);
		Если Пропусков > 3 Тогда
			Рекомендовать(Кт, 1, "Производство", "За 30 дней " + Пропусков + " будних дней без суточного рапорта (раздел 3): выпуск, расход сырья и остатки в базе отстают от реальности.",
				"Вводить рапорт каждый день до 10:00 за прошлые сутки; поручить одному человеку. Упростить ввод поможет обработка «Рапорт за смену» — могу сделать.");
		КонецЕсли;
	Исключение
		Строки.Добавить("   не получилось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 4. старые незакрытые заказы — коротко
	Строки.Добавить("");
	Строки.Добавить("==== 4. СТАРЫЕ НЕЗАКРЫТЫЕ ЗАКАЗЫ (старше " + ЭтотОбъект.СтаршеДней + " дней без движения) ====");
	Попытка
		НайтиЗаказыНаСервере();
		ИтогиЗаказов = Новый Соответствие;
		Для Каждого СтрокаЗаказа Из ЭтотОбъект.Заказы Цикл
			ИтогиЗаказов.Вставить(СтрокаЗаказа.ВидЗаказа, ?(ИтогиЗаказов[СтрокаЗаказа.ВидЗаказа] = Неопределено, 0, ИтогиЗаказов[СтрокаЗаказа.ВидЗаказа]) + 1);
		КонецЦикла;
		Если ИтогиЗаказов.Количество() = 0 Тогда
			Строки.Добавить("   нет");
		КонецЕсли;
		Для Каждого КлючИЗначение Из ИтогиЗаказов Цикл
			Строки.Добавить("   " + КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение + " шт.");
		КонецЦикла;
		Строки.Добавить("   Список и закрытие — на закладке «Старые заказы».");
		Если ЭтотОбъект.Заказы.Количество() > 0 Тогда
			Рекомендовать(Кт, 1, "Заказы", "Висит " + ЭтотОбъект.Заказы.Количество() + " старых незакрытых заказов (раздел 4): они искажают портфель заказов, обеспечение и «сырьё в пути».",
				"Закладка «Старые заказы» этой обработки → «Найти старые заказы» → отметить → «Закрыть отмеченные» (сначала 1–2 для проверки).");
		КонецЕсли;
	Исключение
		Строки.Добавить("   не получилось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВыполнитьПолныйАудит(Кт);
	Для Каждого ТекстОшибки Из Кт.Ошибки Цикл
		Ошибки.Добавить(ТекстОшибки);
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить("==== ОШИБКИ ПРИ СБОРЕ (для настройки) ====");
		Для Каждого ТекстОшибки Из Ошибки Цикл
			Строки.Добавить("   " + ТекстОшибки);
		КонецЦикла;
	КонецЕсли;

	Итог = Новый Массив;
	Для Индекс = 0 По ДлинаШапки - 1 Цикл
		Итог.Добавить(Строки[Индекс]);
	КонецЦикла;
	ВывестиРекомендации(Кт, Итог);
	Для Индекс = ДлинаШапки По Строки.Количество() - 1 Цикл
		Итог.Добавить(Строки[Индекс]);
	КонецЦикла;
	ЭтотОбъект.ТекстАудита = СтрСоединить(Итог, Символы.ПС);
	ВывестиТекст(Итог);
	Если НЕ ЭтотОбъект.ПоказыватьНаименования Тогда
		ОбезлСохранитьСловарь(Псевдонимы.К);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоДокументов(МетаДокумента, Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ." + МетаДокумента.Имя + " КАК Д
		|ГДЕ
		|	Д.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Д.ПометкаУдаления";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

&НаСервереБезКонтекста
Процедура ПодробностиВида(МетаДокумента, Начало, Конец, СтрокаСводки, Псевдонимы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	// по месяцам
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) КАК Месяц,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ." + МетаДокумента.Имя + " КАК Д
		|ГДЕ
		|	Д.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Д.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)
		|УПОРЯДОЧИТЬ ПО
		|	Месяц";
	ПоМесяцам = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоМесяцам.Добавить(Формат(Выборка.Месяц, "ДФ=MMM") + " " + Выборка.Количество);
	КонецЦикла;
	СтрокаСводки.ПоМесяцам = СтрСоединить(ПоМесяцам, ", ");

	// кто вводит
	ПолеАвтора = ПервыйРеквизит(МетаДокумента, "Автор,Ответственный,Менеджер");
	Если ЗначениеЗаполнено(ПолеАвтора) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 3
			|	Д." + ПолеАвтора + " КАК Автор,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Документ." + МетаДокумента.Имя + " КАК Д
			|ГДЕ
			|	Д.Дата МЕЖДУ &Начало И &Конец
			|	И НЕ Д.ПометкаУдаления
			|СГРУППИРОВАТЬ ПО
			|	Д." + ПолеАвтора + "
			|УПОРЯДОЧИТЬ ПО
			|	Количество УБЫВ";
		Авторы = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Авторы.Добавить(Псевдоним(Выборка.Автор, Псевдонимы) + " " + Выборка.Количество);
		КонецЦикла;
		СтрокаСводки.Авторы = СтрСоединить(Авторы, ", ");
	КонецЕсли;

	// строк в документах — сколько набирать руками
	МетаТЧ = ОсновнаяТабличнаяЧасть(МетаДокумента);
	Если МетаТЧ <> Неопределено Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Документ." + МетаДокумента.Имя + "." + МетаТЧ.Имя + " КАК Т
			|ГДЕ
			|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
			|	И НЕ Т.Ссылка.ПометкаУдаления";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтрокаСводки.Строк = Выборка.Количество;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписатьВид(МетаДокумента, Начало, Конец, Строки, Псевдонимы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	ИмяТаблицы = "Документ." + МетаДокумента.Имя;

	// типичные сочетания реквизитов шапки: откуда, куда, операция, статья
	ПоляШапки = Новый Массив;
	Для Каждого ИмяРеквизита Из СтрРазделить("ХозяйственнаяОперация,Склад,СкладОтправитель,СкладПолучатель,Отправитель,Получатель,"
		+ "Подразделение,СтатьяРасходов,СтатьяДвиженияДенежныхСредств,Контрагент", ",") Цикл
		Если ПоляШапки.Количество() < 3 И МетаДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			ПоляШапки.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	ЕстьСумма = МетаДокумента.Реквизиты.Найти("СуммаДокумента") <> Неопределено;
	Если ПоляШапки.Количество() > 0 Тогда
		СписокПолей = Новый Массив;
		Для Каждого ИмяРеквизита Из ПоляШапки Цикл
			СписокПолей.Добавить("Д." + ИмяРеквизита);
		КонецЦикла;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 10
			|	" + СтрСоединить(СписокПолей, ", ") + ",
			|	КОЛИЧЕСТВО(*) КАК Количество,
			|	" + ?(ЕстьСумма, "СУММА(Д.СуммаДокумента)", "0") + " КАК Сумма
			|ИЗ
			|	" + ИмяТаблицы + " КАК Д
			|ГДЕ
			|	Д.Дата МЕЖДУ &Начало И &Конец
			|	И НЕ Д.ПометкаУдаления
			|СГРУППИРОВАТЬ ПО
			|	" + СтрСоединить(СписокПолей, ", ") + "
			|УПОРЯДОЧИТЬ ПО
			|	Количество УБЫВ";
		Строки.Добавить("   Чаще всего (" + СтрСоединить(ПоляШапки, " / ") + "):");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Значения = Новый Массив;
			Для Каждого ИмяРеквизита Из ПоляШапки Цикл
				Значения.Добавить(Псевдоним(Выборка[ИмяРеквизита], Псевдонимы));
			КонецЦикла;
			Строки.Добавить("      " + Дополнить(ФорматЧисла(Выборка.Количество) + " шт.", 9) + СтрСоединить(Значения, " / ")
				+ ?(ЕстьСумма И Выборка.Сумма <> 0, "  на " + ФорматЧисла(Выборка.Сумма), ""));
		КонецЦикла;
	КонецЕсли;

	// регулярные платежи и получатели: контрагент есть в каждом месяце периода
	Если ЕстьСумма И МетаДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ПоМесяцам.Контрагент КАК Контрагент,
			|	СУММА(ПоМесяцам.Количество) КАК Количество,
			|	КОЛИЧЕСТВО(*) КАК Месяцев,
			|	СУММА(ПоМесяцам.Сумма) КАК Сумма
			|ИЗ
			|	(ВЫБРАТЬ
			|		Д.Контрагент КАК Контрагент,
			|		НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) КАК Месяц,
			|		КОЛИЧЕСТВО(*) КАК Количество,
			|		СУММА(Д.СуммаДокумента) КАК Сумма
			|	ИЗ
			|		" + ИмяТаблицы + " КАК Д
			|	ГДЕ
			|		Д.Дата МЕЖДУ &Начало И &Конец
			|		И НЕ Д.ПометкаУдаления
			|	СГРУППИРОВАТЬ ПО
			|		Д.Контрагент,
			|		НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)) КАК ПоМесяцам
			|СГРУППИРОВАТЬ ПО
			|	ПоМесяцам.Контрагент
			|ИМЕЮЩИЕ
			|	СУММА(ПоМесяцам.Количество) >= 3
			|УПОРЯДОЧИТЬ ПО
			|	Количество УБЫВ";
		Таблица = Запрос.Выполнить().Выгрузить();
		ВсегоМесяцев = 1 + Месяц(Конец) - Месяц(Начало) + 12 * (Год(Конец) - Год(Начало));
		Регулярные = Новый Массив;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.Контрагент) И СтрокаТаблицы.Месяцев >= Мин(3, ВсегоМесяцев) И Регулярные.Количество() < 15 Тогда
				Регулярные.Добавить("      " + Дополнить(ФорматЧисла(СтрокаТаблицы.Количество) + " шт.", 9)
					+ Псевдоним(СтрокаТаблицы.Контрагент, Псевдонимы) + " — в " + СтрокаТаблицы.Месяцев + " мес., на " + ФорматЧисла(СтрокаТаблицы.Сумма));
			КонецЕсли;
		КонецЦикла;
		Если Регулярные.Количество() > 0 Тогда
			Строки.Добавить("   Повторяются каждый месяц (кандидаты в шаблоны и автозаполнение):");
			Для Каждого ТекстСтроки Из Регулярные Цикл
				Строки.Добавить(ТекстСтроки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	МетаТЧ = ОсновнаяТабличнаяЧасть(МетаДокумента);
	Если МетаТЧ = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	ИмяТЧ = ИмяТаблицы + "." + МетаТЧ.Имя;
	ЕстьКоличество = МетаТЧ.Реквизиты.Найти("Количество") <> Неопределено;

	// чаще всего встречающаяся номенклатура
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 15
		|	Т.Номенклатура КАК Номенклатура,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК Документов,
		|	" + ?(ЕстьКоличество, "СУММА(Т.Количество)", "0") + " КАК Количество
		|ИЗ
		|	" + ИмяТЧ + " КАК Т
		|ГДЕ
		|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Т.Ссылка.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура
		|УПОРЯДОЧИТЬ ПО
		|	Документов УБЫВ";
	Строки.Добавить("   Чаще всего в строках (в скольких документах, сколько всего):");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("      " + Дополнить(ФорматЧисла(Выборка.Документов) + " док.", 10) + Псевдоним(Выборка.Номенклатура, Псевдонимы)
			+ ?(ЕстьКоличество, " — " + Формат(Выборка.Количество, "ЧДЦ=3; ЧН=0; ЧГ=3,0"), ""));
	КонецЦикла;

	// одинаковые наборы строк: такие документы можно создавать по шаблону
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номенклатура КАК Номенклатура
		|ИЗ
		|	" + ИмяТЧ + " КАК Т
		|ГДЕ
		|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Т.Ссылка.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Т.Ссылка,
		|	Т.Номенклатура";
	Наборы = Новый Соответствие;
	Примеры = Новый Соответствие;
	ТекущийДокумент = Неопределено;
	Ключи = Новый Массив;
	Названия = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Истина Цикл
		ЕстьСтрока = Выборка.Следующий();
		Если НЕ ЕстьСтрока ИЛИ Выборка.Ссылка <> ТекущийДокумент Тогда
			Если ТекущийДокумент <> Неопределено И Ключи.Количество() > 0 Тогда
				КлючНабора = СтрСоединить(Ключи, ";");
				Наборы.Вставить(КлючНабора, ?(Наборы[КлючНабора] = Неопределено, 0, Наборы[КлючНабора]) + 1);
				Если Примеры[КлючНабора] = Неопределено Тогда
					Примеры.Вставить(КлючНабора, Названия);
				КонецЕсли;
			КонецЕсли;
			Если НЕ ЕстьСтрока Тогда
				Прервать;
			КонецЕсли;
			ТекущийДокумент = Выборка.Ссылка;
			Ключи = Новый Массив;
			Названия = Новый Массив;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			КлючСтроки = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
			Если Ключи.Найти(КлючСтроки) = Неопределено Тогда
				Ключи.Добавить(КлючСтроки);
				Названия.Добавить(Псевдоним(Выборка.Номенклатура, Псевдонимы));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Повторы = Новый ТаблицаЗначений;
	Повторы.Колонки.Добавить("Раз", Новый ОписаниеТипов("Число"));
	Повторы.Колонки.Добавить("Названия");
	Для Каждого КлючИЗначение Из Наборы Цикл
		Если КлючИЗначение.Значение >= 3 Тогда
			СтрокаПовтора = Повторы.Добавить();
			СтрокаПовтора.Раз = КлючИЗначение.Значение;
			СтрокаПовтора.Названия = Примеры[КлючИЗначение.Ключ];
		КонецЕсли;
	КонецЦикла;
	Повторы.Сортировать("Раз Убыв");
	Если Повторы.Количество() > 0 Тогда
		Строки.Добавить("   Одинаковый состав строк повторяется (можно вводить по шаблону):");
		Номер = 0;
		Для Каждого СтрокаПовтора Из Повторы Цикл
			Номер = Номер + 1;
			Если Номер > 10 Тогда
				Прервать;
			КонецЕсли;
			Состав = Новый Массив;
			Для Индекс = 0 По Мин(5, СтрокаПовтора.Названия.Количество()) - 1 Цикл
				Состав.Добавить(СтрокаПовтора.Названия[Индекс]);
			КонецЦикла;
			Строки.Добавить("      " + Дополнить(Формат(СтрокаПовтора.Раз, "ЧГ=0") + " раз", 9) + "(" + СтрокаПовтора.Названия.Количество() + " поз.) "
				+ СтрСоединить(Состав, "; ") + ?(СтрокаПовтора.Названия.Количество() > 5, "; …", ""));
		КонецЦикла;
	КонецЕсли;


	Возврат Повторы.Количество();

КонецФункции

&НаСервереБезКонтекста
Функция ДниБезРапортов(Строки)

	Если Метаданные.Документы.Найти("ПроизводствоБезЗаказа") = Неопределено Тогда
		Строки.Добавить("   в конфигурации нет документа «Производство без заказа»");
		Возврат 0;
	КонецЕсли;
	Конец = НачалоДня(ТекущаяДатаСеанса());
	Начало = Конец - 29 * 86400;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ) КАК День
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа КАК Д
		|ГДЕ
		|	Д.Дата МЕЖДУ &Начало И &Конец
		|	И Д.Проведен";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	ЕстьРапорт = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЕстьРапорт.Вставить(Выборка.День, Истина);
	КонецЦикла;
	Пропуски = Новый Массив;
	День = Начало;
	Пока День <= Конец Цикл
		Если ДеньНедели(День) <= 5 И ЕстьРапорт[День] = Неопределено Тогда
			Пропуски.Добавить(Формат(День, "ДФ=dd.MM"));
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
	Строки.Добавить("   Дней с рапортами: " + ЕстьРапорт.Количество() + " из 30. Будни без рапорта: "
		+ ?(Пропуски.Количество() = 0, "нет", СтрСоединить(Пропуски, ", ")));


	Возврат Пропуски.Количество();

КонецФункции

&НаСервере
Процедура ВывестиТекст(Строки)

	ТД = Новый ТабличныйДокумент;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ШрифтТекста = Новый Шрифт("Courier New", 9);
	Номер = 0;
	Для Каждого ТекстСтроки Из Строки Цикл
		Номер = Номер + 1;
		Обл = ТД.Область(Номер, 1, Номер, 1);
		Обл.Текст = ТекстСтроки;
		Обл.Шрифт = ШрифтТекста;
		Если СтрНачинаетсяС(ТекстСтроки, "====") Тогда
			Обл.Шрифт = Новый Шрифт("Courier New", 10, Истина);
		КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.ДокументАудита = ТД;

КонецПроцедуры

#КонецОбласти

#Область ПолныйАудит

// Дополнительные разделы аудита: чистота документов и справочников, склад, связи документов,
// закрытие месяца, пользователи и права, регламентные задания, настройки и доработки.
// Каждая проверка может добавить рекомендацию «что изменить» — они выводятся в начале файла.

&НаСервереБезКонтекста
Функция НовыйКонтекстАудита(Начало, Конец, Строки, Псевдонимы)

	Рекомендации = Новый ТаблицаЗначений;
	Рекомендации.Колонки.Добавить("Важность", Новый ОписаниеТипов("Число"));
	Рекомендации.Колонки.Добавить("Область");
	Рекомендации.Колонки.Добавить("Что");
	Рекомендации.Колонки.Добавить("Как");
	Кт = Новый Структура;
	Кт.Вставить("Начало", Начало);
	Кт.Вставить("Конец", Конец);
	Кт.Вставить("Строки", Строки);
	Кт.Вставить("Псевдонимы", Псевдонимы);
	Кт.Вставить("Рекомендации", Рекомендации);
	Кт.Вставить("Ошибки", Новый Массив);
	Возврат Кт;

КонецФункции

// Важность: 1 — сделать в первую очередь, 2 — желательно, 3 — по возможности.
&НаСервереБезКонтекста
Процедура Рекомендовать(Кт, Важность, Область, Что, Как)

	Стр = Кт.Рекомендации.Добавить();
	Стр.Важность = Важность;
	Стр.Область = Область;
	Стр.Что = Что;
	Стр.Как = Как;

КонецПроцедуры

&НаСервереБезКонтекста
Функция Процент(Часть, Всего)

	Возврат ?(Всего = 0, "—", Формат(Часть / Всего * 100, "ЧДЦ=0; ЧН=0") + " %");

КонецФункции

&НаСервереБезКонтекста
Процедура Раздел(Кт, ТекстРаздела)

	Кт.Строки.Добавить("");
	Кт.Строки.Добавить("==== " + ТекстРаздела + " ====");

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьПолныйАудит(Кт)

	Для Каждого ИмяПроверки Из СтрРазделить("ЧистотаДокументов,ПомеченныеВСправочниках,КачествоНоменклатуры,КачествоКонтрагентов,"
		+ "Склад,СвязиДокументов,ЗакрытиеМесяца,ПользователиИПрава,РегламентныеЗадания,НастройкиИДоработки", ",") Цикл
		Попытка
			Если ИмяПроверки = "ЧистотаДокументов" Тогда
				ПроверитьЧистотуДокументов(Кт);
			ИначеЕсли ИмяПроверки = "ПомеченныеВСправочниках" Тогда
				ПроверитьПомеченныеВСправочниках(Кт);
			ИначеЕсли ИмяПроверки = "КачествоНоменклатуры" Тогда
				ПроверитьНоменклатуру(Кт);
			ИначеЕсли ИмяПроверки = "КачествоКонтрагентов" Тогда
				ПроверитьКонтрагентов(Кт);
			ИначеЕсли ИмяПроверки = "Склад" Тогда
				ПроверитьСклад(Кт);
			ИначеЕсли ИмяПроверки = "СвязиДокументов" Тогда
				ПроверитьСвязиДокументов(Кт);
			ИначеЕсли ИмяПроверки = "ЗакрытиеМесяца" Тогда
				ПроверитьЗакрытиеМесяца(Кт);
			ИначеЕсли ИмяПроверки = "ПользователиИПрава" Тогда
				ПроверитьПользователей(Кт);
			ИначеЕсли ИмяПроверки = "РегламентныеЗадания" Тогда
				ПроверитьРегламентныеЗадания(Кт);
			ИначеЕсли ИмяПроверки = "НастройкиИДоработки" Тогда
				ПроверитьНастройкиИДоработки(Кт);
			КонецЕсли;
		Исключение
			Кт.Строки.Добавить("   проверка «" + ИмяПроверки + "» не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Кт.Ошибки.Добавить(ИмяПроверки + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьЧистотуДокументов(Кт)

	Раздел(Кт, "5. ЧИСТОТА ДОКУМЕНТОВ (за всё время)");
	Неделя = НачалоДня(ТекущаяДатаСеанса()) - 7 * 86400;
	Завтра = КонецДня(ТекущаяДатаСеанса());
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид");
	Таблица.Колонки.Добавить("Всего", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Помечено", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("НеПроведено", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ВБудущем", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Служебный", Новый ОписаниеТипов("Булево"));
	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		Проводится = МетаДокумента.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Всего,
			|	СУММА(ВЫБОР КОГДА Д.ПометкаУдаления ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Помечено,
			|	" + ?(Проводится, "СУММА(ВЫБОР КОГДА НЕ Д.ПометкаУдаления И НЕ Д.Проведен И Д.Дата < &Неделя ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)", "0") + " КАК НеПроведено,
			|	СУММА(ВЫБОР КОГДА НЕ Д.ПометкаУдаления И Д.Дата > &Завтра ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ВБудущем
			|ИЗ
			|	Документ." + МетаДокумента.Имя + " КАК Д";
		Запрос.УстановитьПараметр("Неделя", Неделя);
		Запрос.УстановитьПараметр("Завтра", Завтра);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Продолжить;
		КонецПопытки;
		Если НЕ Выборка.Следующий() ИЛИ Выборка.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		Стр = Таблица.Добавить();
		Стр.Вид = МетаДокумента.Синоним;
		Стр.Всего = Выборка.Всего;
		Стр.Помечено = ?(Выборка.Помечено = NULL, 0, Выборка.Помечено);
		Стр.НеПроведено = ?(Выборка.НеПроведено = NULL, 0, Выборка.НеПроведено);
		Стр.ВБудущем = ?(Выборка.ВБудущем = NULL, 0, Выборка.ВБудущем);
		Стр.Служебный = ЭтоСлужебныйДокумент(МетаДокумента);
	КонецЦикла;

	// служебные документы (соглашения, неиспользуемые виды, СФР/пособия, регл. отчёты, графики) не проводятся
	// или законно датированы будущим — они не искажают учёт и в рекомендации не попадают
	Служебные = Таблица.НайтиСтроки(Новый Структура("Служебный", Истина));
	НеПроведеноСлужебных = 0;
	ВБудущемСлужебных = 0;
	Для Каждого Стр Из Служебные Цикл
		НеПроведеноСлужебных = НеПроведеноСлужебных + Стр.НеПроведено;
		ВБудущемСлужебных = ВБудущемСлужебных + Стр.ВБудущем;
		Стр.НеПроведено = 0;
		Стр.ВБудущем = 0;
	КонецЦикла;
	Всего = Таблица.Итог("Всего");
	Помечено = Таблица.Итог("Помечено");
	НеПроведено = Таблица.Итог("НеПроведено");
	ВБудущем = Таблица.Итог("ВБудущем");
	Кт.Строки.Добавить("Документов в базе: " + ФорматЧисла(Всего) + ", видов: " + Таблица.Количество());
	Кт.Строки.Добавить("Помечены на удаление: " + ФорматЧисла(Помечено) + " (" + Процент(Помечено, Всего) + ")");
	Кт.Строки.Добавить("Записаны, но не проведены (старше недели): " + ФорматЧисла(НеПроведено) + " учётных"
		+ ?(НеПроведеноСлужебных > 0, " (ещё " + ФорматЧисла(НеПроведеноСлужебных) + " служебных — соглашения, СФР, пособия и т.п., это нормально)", ""));
	Кт.Строки.Добавить("С датой в будущем: " + ФорматЧисла(ВБудущем) + " учётных"
		+ ?(ВБудущемСлужебных > 0, " (ещё " + ФорматЧисла(ВБудущемСлужебных) + " служебных — регл. отчёты, графики начислений)", ""));
	Для Каждого ИмяКолонки Из СтрРазделить("НеПроведено,Помечено,ВБудущем", ",") Цикл
		Таблица.Сортировать(ИмяКолонки + " Убыв");
		Список = Новый Массив;
		Для Каждого Стр Из Таблица Цикл
			Если Стр[ИмяКолонки] = 0 ИЛИ Список.Количество() >= 10 Тогда
				Прервать;
			КонецЕсли;
			Список.Добавить(Стр.Вид + " " + ФорматЧисла(Стр[ИмяКолонки]));
		КонецЦикла;
		Если Список.Количество() > 0 Тогда
			Кт.Строки.Добавить("   " + ?(ИмяКолонки = "НеПроведено", "Не проведены", ?(ИмяКолонки = "Помечено", "Помечены", "В будущем"))
				+ ": " + СтрСоединить(Список, "; "));
		КонецЕсли;
	КонецЦикла;

	Если НеПроведено > 0 Тогда
		Рекомендовать(Кт, ?(НеПроведено > 50, 1, 2), "Документы",
			"Непроведённых документов старше недели: " + ФорматЧисла(НеПроведено) + ". Они не влияют на остатки и долги — цифры в отчётах занижены или завышены.",
			"Откройте список каждого вида из раздела 5, отбор «Проведён = Нет». Нужные — проведите, лишние — пометьте на удаление.");
	КонецЕсли;
	Если Помечено > 1000 ИЛИ (Всего > 0 И Помечено / Всего > 0.03) Тогда
		Рекомендовать(Кт, 2, "Документы",
			"Помечено на удаление " + ФорматЧисла(Помечено) + " документов: они засоряют списки и замедляют базу.",
			"НСИ и администрирование → Обслуживание → Корректировка данных → Удаление помеченных объектов (делать в нерабочее время, после резервной копии).");
	КонецЕсли;
	Если ВБудущем > 0 Тогда
		Рекомендовать(Кт, 1, "Документы",
			"Документов с датой в будущем: " + ФорматЧисла(ВБудущем) + ". Обычно это опечатка в годе — искажает остатки и отчёты.",
			"Найдите их по списку из раздела 5 (отбор по дате позже сегодняшней) и исправьте дату.");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьПомеченныеВСправочниках(Кт)

	Раздел(Кт, "6. СПРАВОЧНИКИ: размер и помеченные на удаление");
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид");
	Таблица.Колонки.Добавить("Всего", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Помечено", Новый ОписаниеТипов("Число"));
	Для Каждого МетаСправочника Из Метаданные.Справочники Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Всего,
			|	СУММА(ВЫБОР КОГДА С.ПометкаУдаления ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Помечено
			|ИЗ
			|	Справочник." + МетаСправочника.Имя + " КАК С";
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Продолжить;
		КонецПопытки;
		Если НЕ Выборка.Следующий() ИЛИ Выборка.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		Стр = Таблица.Добавить();
		Стр.Вид = МетаСправочника.Синоним;
		Стр.Всего = Выборка.Всего;
		Стр.Помечено = ?(Выборка.Помечено = NULL, 0, Выборка.Помечено);
	КонецЦикла;
	Таблица.Сортировать("Всего Убыв");
	Список = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Если Список.Количество() >= 20 Тогда
			Прервать;
		КонецЕсли;
		Список.Добавить("   " + Дополнить(Стр.Вид, 46) + Дополнить(ФорматЧисла(Стр.Всего), 10)
			+ ?(Стр.Помечено > 0, "помечено " + ФорматЧисла(Стр.Помечено), ""));
	КонецЦикла;
	Кт.Строки.Добавить("Самые большие справочники (элементов, из них помечено на удаление):");
	Для Каждого ТекстСтроки Из Список Цикл
		Кт.Строки.Добавить(ТекстСтроки);
	КонецЦикла;
	Помечено = Таблица.Итог("Помечено");
	Кт.Строки.Добавить("Всего элементов справочников помечено на удаление: " + ФорматЧисла(Помечено));
	Если Помечено > 500 Тогда
		Рекомендовать(Кт, 2, "Справочники",
			"Помечено на удаление " + ФорматЧисла(Помечено) + " элементов справочников — они попадаются при выборе и в подборе.",
			"НСИ и администрирование → Обслуживание → Корректировка данных → Удаление помеченных объектов.");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НормализоватьНаименование(Знач Текст)

	Текст = НРег(СокрЛП(Текст));
	Текст = СтрЗаменить(Текст, "ё", "е");
	Для Каждого Символ Из СтрРазделить(". , ; : - _ "" ' ( ) / \ « » № + * # !", " ") Цикл
		Текст = СтрЗаменить(Текст, Символ, "");
	КонецЦикла;
	Возврат СтрЗаменить(Текст, " ", "");

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьНоменклатуру(Кт)

	Раздел(Кт, "7. НОМЕНКЛАТУРА: качество справочника");
	МетаНом = Метаданные.Справочники.Найти("Номенклатура");
	Если МетаНом = Неопределено Тогда
		Кт.Строки.Добавить("   справочника «Номенклатура» нет");
		Возврат;
	КонецЕсли;
	ЕстьГруппы = МетаНом.Иерархический И МетаНом.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	УсловиеЭлемент = "НЕ Н.ПометкаУдаления" + ?(ЕстьГруппы, " И НЕ Н.ЭтоГруппа", "");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Ссылка,
		|	Н.Наименование КАК Наименование,
		|	" + ?(МетаНом.Иерархический, "Н.Родитель", "НЕОПРЕДЕЛЕНО") + " КАК Родитель,
		|	" + ?(МетаНом.Реквизиты.Найти("ВидНоменклатуры") <> Неопределено, "Н.ВидНоменклатуры", "НЕОПРЕДЕЛЕНО") + " КАК Вид,
		|	" + ?(МетаНом.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено, "Н.ЕдиницаИзмерения", "НЕОПРЕДЕЛЕНО") + " КАК Единица,
		|	" + ?(МетаНом.Реквизиты.Найти("Артикул") <> Неопределено, "Н.Артикул", """""") + " КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	" + УсловиеЭлемент;
	Таблица = Запрос.Выполнить().Выгрузить();
	Всего = Таблица.Количество();
	БезПапки = 0;
	БезВида = 0;
	БезЕдиницы = 0;
	ПоИмени = Новый Соответствие;
	Для Каждого Стр Из Таблица Цикл
		Если МетаНом.Иерархический И НЕ ЗначениеЗаполнено(Стр.Родитель) Тогда
			БезПапки = БезПапки + 1;
		КонецЕсли;
		Если Стр.Вид <> Неопределено И НЕ ЗначениеЗаполнено(Стр.Вид) Тогда
			БезВида = БезВида + 1;
		КонецЕсли;
		Если Стр.Единица <> Неопределено И НЕ ЗначениеЗаполнено(Стр.Единица) Тогда
			БезЕдиницы = БезЕдиницы + 1;
		КонецЕсли;
		Ключ = НормализоватьНаименование(Стр.Наименование);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Группа = ПоИмени[Ключ];
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ПоИмени.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.Добавить(Стр.Ссылка);
	КонецЦикла;
	ГруппДублей = 0;
	ЛишнихЭлементов = 0;
	Примеры = Новый Массив;
	Для Каждого КлючИЗначение Из ПоИмени Цикл
		Если КлючИЗначение.Значение.Количество() > 1 Тогда
			ГруппДублей = ГруппДублей + 1;
			ЛишнихЭлементов = ЛишнихЭлементов + КлючИЗначение.Значение.Количество() - 1;
			Если Примеры.Количество() < 10 Тогда
				Коды = Новый Массив;
				Для Каждого Ссылка Из КлючИЗначение.Значение Цикл
					Коды.Добавить(Псевдоним(Ссылка, Кт.Псевдонимы));
				КонецЦикла;
				Примеры.Добавить(СтрСоединить(Коды, " = "));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// позиции-товары без движений по складу за 2 года
	НеИспользуются = 0;
	МетаРегистра = Метаданные.РегистрыНакопления.Найти("ТоварыНаСкладах");
	Если МетаРегистра <> Неопределено И МетаРегистра.Измерения.Найти("Номенклатура") <> Неопределено Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(Н.Ссылка) КАК Количество
			|ИЗ
			|	Справочник.Номенклатура КАК Н
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			Т.Номенклатура КАК Номенклатура
			|		ИЗ
			|			РегистрНакопления.ТоварыНаСкладах КАК Т
			|		ГДЕ
			|			Т.Период > &ДваГода) КАК Движения
			|		ПО Движения.Номенклатура = Н.Ссылка
			|ГДЕ
			|	Движения.Номенклатура ЕСТЬ NULL
			|	И " + УсловиеЭлемент
			+ ?(МетаНом.Реквизиты.Найти("ТипНоменклатуры") <> Неопределено, "
			|	И Н.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)", "");
		Запрос.УстановитьПараметр("ДваГода", ДобавитьМесяц(ТекущаяДатаСеанса(), -24));
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НеИспользуются = Выборка.Количество;
			КонецЕсли;
		Исключение
			Кт.Строки.Добавить("   неиспользуемые позиции не посчитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Кт.Строки.Добавить("Позиций (без папок и помеченных): " + ФорматЧисла(Всего));
	Если МетаНом.Иерархический Тогда
		Кт.Строки.Добавить("Лежат вне папок (в корне): " + ФорматЧисла(БезПапки) + " (" + Процент(БезПапки, Всего) + ")");
	КонецЕсли;
	Кт.Строки.Добавить("Без вида номенклатуры: " + ФорматЧисла(БезВида) + "; без единицы измерения: " + ФорматЧисла(БезЕдиницы));
	Кт.Строки.Добавить("Похожие названия (вероятные дубли): групп " + ФорматЧисла(ГруппДублей) + ", лишних позиций " + ФорматЧисла(ЛишнихЭлементов));
	Для Каждого Пример Из Примеры Цикл
		Кт.Строки.Добавить("   " + Пример);
	КонецЦикла;
	Кт.Строки.Добавить("Товары без движений по складу за 2 года: " + ФорматЧисла(НеИспользуются) + " (" + Процент(НеИспользуются, Всего) + ")");

	Если ГруппДублей > 0 Тогда
		Рекомендовать(Кт, 1, "Номенклатура",
			"Вероятных дублей номенклатуры: " + ФорматЧисла(ЛишнихЭлементов) + " позиций в " + ФорматЧисла(ГруппДублей) + " группах. Из-за дублей остатки и расход одного материала делятся на две позиции, отчёты врут.",
			"НСИ и администрирование → Обслуживание → Корректировка данных → Поиск и удаление дублей: справочник «Номенклатура», сравнение по наименованию. Объединять после резервной копии.");
	КонецЕсли;
	Если МетаНом.Иерархический И Всего > 0 И БезПапки / Всего > 0.1 Тогда
		Рекомендовать(Кт, 2, "Номенклатура",
			"Вне папок лежит " + Процент(БезПапки, Всего) + " номенклатуры — она не попадает в группы продаж и сырья в отчётах.",
			"Разложить по папкам: Сырьё основное / Вспомогательные материалы / Продукция / Полуфабрикаты / Тара / Хозтовары и спецодежда / Услуги. Перетаскиванием в списке номенклатуры.");
	КонецЕсли;
	Если НеИспользуются > 100 Тогда
		Рекомендовать(Кт, 3, "Номенклатура",
			"Товаров без движений 2 года: " + ФорматЧисла(НеИспользуются) + " — мешают подбору.",
			"Перенести в папку «Архив» или пометить на удаление (позиции с документами 1С не удалит, только снимет с выбора).");
	КонецЕсли;
	Если БезЕдиницы > 0 ИЛИ БезВида > 0 Тогда
		Рекомендовать(Кт, 2, "Номенклатура",
			"Позиции без вида номенклатуры (" + БезВида + ") или единицы (" + БезЕдиницы + "): по ним не работают нормы, цены и складские отчёты.",
			"В списке номенклатуры отбор по пустому виду / единице и заполнение групповым изменением реквизитов (НСИ и администрирование → Обслуживание → Корректировка данных → Групповое изменение реквизитов).");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьКонтрагентов(Кт)

	Раздел(Кт, "8. КОНТРАГЕНТЫ И ПАРТНЁРЫ");
	МетаК = Метаданные.Справочники.Найти("Контрагенты");
	Если МетаК = Неопределено ИЛИ МетаК.Реквизиты.Найти("ИНН") = Неопределено Тогда
		Кт.Строки.Добавить("   нет справочника «Контрагенты» с ИНН");
		Возврат;
	КонецЕсли;
	ЕстьКПП = МетаК.Реквизиты.Найти("КПП") <> Неопределено;
	Условие = "НЕ К.ПометкаУдаления" + ?(МетаК.Иерархический И МетаК.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов, " И НЕ К.ЭтоГруппа", "");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА К.ИНН = """" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезИНН
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	" + Условие + "
		|;
		|ВЫБРАТЬ
		|	К.ИНН КАК ИНН,
		|	" + ?(ЕстьКПП, "К.КПП", """""") + " КАК КПП,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	" + Условие + "
		|	И К.ИНН <> """"
		|СГРУППИРОВАТЬ ПО
		|	К.ИНН" + ?(ЕстьКПП, ", К.КПП", "") + "
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) > 1";
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();
	Выборка.Следующий();
	Всего = Выборка.Всего;
	БезИНН = ?(Выборка.БезИНН = NULL, 0, Выборка.БезИНН);
	Дубли = Пакет[1].Выгрузить();
	Лишних = Дубли.Итог("Количество") - Дубли.Количество();
	Кт.Строки.Добавить("Контрагентов: " + ФорматЧисла(Всего) + "; без ИНН: " + ФорматЧисла(БезИНН) + " (" + Процент(БезИНН, Всего) + ")");
	Кт.Строки.Добавить("С одинаковым ИНН" + ?(ЕстьКПП, " и КПП", "") + ": групп " + Дубли.Количество() + ", лишних карточек " + Лишних);
	Если Лишних > 0 Тогда
		Рекомендовать(Кт, 1, "Контрагенты",
			"Дублей контрагентов (одинаковый ИНН и КПП): " + Лишних + ". Долги и оплаты одного покупателя разнесены по двум карточкам — сверки и отчёты по долгам неверны.",
			"НСИ и администрирование → Обслуживание → Корректировка данных → Поиск и удаление дублей: справочник «Контрагенты», сравнение по ИНН и КПП.");
	КонецЕсли;
	Если Всего > 0 И БезИНН / Всего > 0.05 Тогда
		Рекомендовать(Кт, 2, "Контрагенты",
			"Без ИНН " + Процент(БезИНН, Всего) + " контрагентов: не работает проверка в ФНС, ЭДО и загрузка выписки банка по ИНН.",
			"Заполнить ИНН (если подключён 1С:Контрагент — кнопка «Заполнить по ИНН» в карточке); физлиц-покупателей можно оставить без ИНН.");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьСклад(Кт)

	Раздел(Кт, "9. СКЛАД И ЦЕНЫ");
	МетаРегистра = Метаданные.РегистрыНакопления.Найти("ТоварыНаСкладах");
	Если МетаРегистра <> Неопределено И МетаРегистра.Ресурсы.Найти("ВНаличии") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	О.Номенклатура КАК Номенклатура,
			|	СУММА(О.ВНаличииОстаток) КАК Остаток
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК О
			|ГДЕ
			|	О.ВНаличииОстаток < 0
			|СГРУППИРОВАТЬ ПО
			|	О.Номенклатура
			|УПОРЯДОЧИТЬ ПО
			|	Остаток";
		// одна выборка и для количества, и для списка — раньше счётчик и список расходились
		Таблица = Запрос.Выполнить().Выгрузить();
		Минусов = Таблица.Количество();
		Кт.Строки.Добавить("Отрицательные остатки на складах сейчас: " + ФорматЧисла(Минусов) + " позиций номенклатуры"
			+ ?(Минусов > 10, " (показаны 10 самых больших)", ""));
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Если Таблица.Индекс(СтрокаТаблицы) >= 10 Тогда
				Прервать;
			КонецЕсли;
			Кт.Строки.Добавить("   " + Псевдоним(СтрокаТаблицы.Номенклатура, Кт.Псевдонимы) + ": " + Формат(СтрокаТаблицы.Остаток, "ЧДЦ=3; ЧН=0; ЧГ=3,0"));
		КонецЦикла;
		Если Минусов > 0 Тогда
			Рекомендовать(Кт, 1, "Склад",
				"Отрицательных остатков: " + ФорматЧисла(Минусов) + ". Списали больше, чем пришло, — неверны себестоимость, остатки сырья и «на сколько дней хватит».",
				"Проверить по каждой позиции раздела 9 порядок документов (поступление позже списания) и единицы измерения; включить контроль остатков: НСИ и администрирование → Склад и доставка → «Контролировать остатки товаров».");
		КонецЕсли;
	КонецЕсли;

	Для Каждого ИмяДокумента Из СтрРазделить("РеализацияТоваровУслуг,ПриобретениеТоваровУслуг", ",") Цикл
		МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДокумента = Неопределено ИЛИ МетаДокумента.ТабличныеЧасти.Найти("Товары") = Неопределено
			ИЛИ МетаДокумента.ТабличныеЧасти.Товары.Реквизиты.Найти("Цена") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Строк,
			|	СУММА(ВЫБОР КОГДА Т.Цена = 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК БезЦены
			|ИЗ
			|	Документ." + ИмяДокумента + ".Товары КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец";
		Запрос.УстановитьПараметр("Начало", Кт.Начало);
		Запрос.УстановитьПараметр("Конец", Кт.Конец);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		БезЦены = ?(Выборка.БезЦены = NULL, 0, Выборка.БезЦены);
		Кт.Строки.Добавить(МетаДокумента.Синоним + ": строк " + ФорматЧисла(Выборка.Строк) + ", с нулевой ценой " + ФорматЧисла(БезЦены));
		Если БезЦены > 0 Тогда
			Рекомендовать(Кт, 2, "Цены",
				МетаДокумента.Синоним + ": строк с нулевой ценой за период — " + БезЦены + ". Выручка или себестоимость по ним нулевая.",
				"Проверить цены в этих документах; если нужно, подготовлю отчёт со списком таких строк.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Доля проведённых документов (или строк) за период, где поле не заполнено.
&НаСервереБезКонтекста
Функция ЗаполненностьПоля(Кт, ИмяДокумента, ИмяТЧ, ИмяПоля, Подпись)

	Результат = Новый Структура("Всего, Пусто", 0, 0);
	МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(ИмяТЧ) Тогда
		МетаПоля = МетаДокумента.Реквизиты.Найти(ИмяПоля);
		Таблица = "Документ." + ИмяДокумента;
		Документ = "Т";
	Иначе
		МетаТЧ = МетаДокумента.ТабличныеЧасти.Найти(ИмяТЧ);
		МетаПоля = ?(МетаТЧ = Неопределено, Неопределено, МетаТЧ.Реквизиты.Найти(ИмяПоля));
		Таблица = "Документ." + ИмяДокумента + "." + ИмяТЧ;
		Документ = "Т.Ссылка";
	КонецЕсли;
	Если МетаПоля = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Пустые = Новый Массив;
	Пустые.Добавить(Неопределено);
	Для Каждого ТипПоля Из МетаПоля.Тип.Типы() Цикл
		ОдинТип = Новый Массив;
		ОдинТип.Добавить(ТипПоля);
		ОписаниеОдногоТипа = Новый ОписаниеТипов(ОдинТип);
		Пустые.Добавить(ОписаниеОдногоТипа.ПривестиЗначение(Неопределено));
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА Т." + ИмяПоля + " В (&Пустые) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Пусто
		|ИЗ
		|	" + Таблица + " КАК Т
		|ГДЕ
		|	" + Документ + ".Проведен
		|	И " + Документ + ".Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Пустые", Пустые);
	Запрос.УстановитьПараметр("Начало", Кт.Начало);
	Запрос.УстановитьПараметр("Конец", Кт.Конец);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Кт.Строки.Добавить("   " + Подпись + ": не посчитано (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
		Возврат Результат;
	КонецПопытки;
	Если Выборка.Следующий() Тогда
		Результат.Всего = Выборка.Всего;
		Результат.Пусто = ?(Выборка.Пусто = NULL, 0, Выборка.Пусто);
	КонецЕсли;
	Если Результат.Всего > 0 Тогда
		Кт.Строки.Добавить("   " + Дополнить(Подпись, 70) + "не заполнено " + Процент(Результат.Пусто, Результат.Всего)
			+ " (" + ФорматЧисла(Результат.Пусто) + " из " + ФорматЧисла(Результат.Всего) + ")");
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьСвязиДокументов(Кт)

	Раздел(Кт, "10. КАК СВЯЗАНЫ ДОКУМЕНТЫ (за период аудита)");
	Р = ЗаполненностьПоля(Кт, "РеализацияТоваровУслуг", "Товары", "ЗаказКлиента", "Реализации: строки без заказа клиента");
	Если Р.Всего > 0 И Р.Пусто / Р.Всего > 0.5 Тогда
		Рекомендовать(Кт, 2, "Продажи",
			"Больше половины отгрузок без заказа клиента: не видно, что обещали покупателю, портфель заказов и «успеваем ли выпустить» считаются неверно.",
			"Либо вводить реализации только «на основании» заказа (Продажи → Заказы клиентов → Создать на основании), либо, если заказы не нужны, не вести их вовсе — тогда закройте старые на закладке «Старые заказы».");
	КонецЕсли;
	Р = ЗаполненностьПоля(Кт, "ПриобретениеТоваровУслуг", "Товары", "ЗаказПоставщику", "Поступления: строки без заказа поставщику");
	Если Р.Всего > 0 И Р.Пусто / Р.Всего > 0.5 Тогда
		Рекомендовать(Кт, 3, "Закупки",
			"Большинство поступлений без заказа поставщику: «сырьё в пути» и сроки поставок в отчётах не видны.",
			"Оформлять закупку сырья заказом поставщику, а поступление — на его основании (обработка «Накладная по фото» привязывает заказ сама).");
	КонецЕсли;
	Р = ЗаполненностьПоля(Кт, "ПроизводствоБезЗаказа", "ВыходныеИзделия", "Спецификация", "Суточные рапорты: продукция без ресурсной спецификации");
	Если Р.Всего > 0 И Р.Пусто / Р.Всего > 0.2 Тогда
		Рекомендовать(Кт, 1, "Производство",
			"В рапортах у " + Процент(Р.Пусто, Р.Всего) + " продукции не указана спецификация: нельзя сравнить расход сырья с нормой.",
			"Указывать спецификацию в каждой строке «Продукция» (или задать основную спецификацию в карточке номенклатуры — тогда она подставится сама).");
	КонецЕсли;
	ЗаполненностьПоля(Кт, "ПроизводствоБезЗаказа", "МатериалыИРаботы", "СтатьяКалькуляции", "Суточные рапорты: материалы без статьи калькуляции");
	Для Каждого ИмяДокумента Из СтрРазделить("СписаниеБезналичныхДенежныхСредств,ПоступлениеБезналичныхДенежныхСредств", ",") Цикл
		МетаДенег = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДенег = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Р = ЗаполненностьПоля(Кт, ИмяДокумента, "РасшифровкаПлатежа", "СтатьяДвиженияДенежныхСредств", МетаДенег.Синоним + ": строки без статьи ДДС");
		Если Р.Всего > 0 И Р.Пусто / Р.Всего > 0.1 Тогда
			Рекомендовать(Кт, 1, "Деньги",
				МетаДенег.Синоним + ": у " + Процент(Р.Пусто, Р.Всего) + " платежей не указана статья ДДС — отчёт о движении денег по статьям неверен.",
				"Задать статью по умолчанию для каждой хоз. операции и правила разноски при загрузке выписки (Казначейство → Настройки → Правила разноски выписки), разнести старые платежи групповым изменением.");
		КонецЕсли;
		ЗаполненностьПоля(Кт, ИмяДокумента, "", "ХозяйственнаяОперация", МетаДенег.Синоним + ": без хоз. операции");
	КонецЦикла;
	ЗаполненностьПоля(Кт, "ВнутреннееПотребление", "", "СтатьяРасходов", "Внутреннее потребление: без статьи расходов (в шапке)");
	ЗаполненностьПоля(Кт, "ВнутреннееПотребление", "Товары", "СтатьяРасходов", "Внутреннее потребление: строки без статьи расходов");

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьЗакрытиеМесяца(Кт)

	Раздел(Кт, "11. ЗАКРЫТИЕ МЕСЯЦА (документов по месяцам за 12 месяцев)");
	Начало = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -11));
	Месяцы = Новый Массив;
	Для Н = 0 По 11 Цикл
		Месяцы.Добавить(ДобавитьМесяц(Начало, Н));
	КонецЦикла;
	Шапка = Дополнить("", 44);
	Для Каждого Мес Из Месяцы Цикл
		Шапка = Шапка + Дополнить(Формат(Мес, "ДФ=MM.yy"), 6);
	КонецЦикла;
	Кт.Строки.Добавить(Шапка);
	ЕстьРасчетСебестоимости = Ложь;
	Для Каждого ИмяДокумента Из СтрРазделить("РасчетСебестоимостиТоваров,РаспределениеПроизводственныхЗатрат,РаспределениеПрочихЗатрат,"
		+ "РаспределениеРасходовБудущихПериодов,РегламентнаяОперация,РасчетКурсовыхРазниц,НачислениеАмортизацииОС", ",") Цикл
		МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) КАК Месяц,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Д
			|ГДЕ
			|	Д.Проведен
			|	И Д.Дата >= &Начало
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ)";
		Запрос.УстановитьПараметр("Начало", Начало);
		ПоМесяцам = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПоМесяцам.Вставить(Выборка.Месяц, Выборка.Количество);
		КонецЦикла;
		ТекстМесяцев = Дополнить(МетаДокумента.Синоним, 44);
		Для Каждого Мес Из Месяцы Цикл
			ТекстМесяцев = ТекстМесяцев + Дополнить(?(ПоМесяцам[Мес] = Неопределено, "·", ПоМесяцам[Мес]), 6);
		КонецЦикла;
		Кт.Строки.Добавить(ТекстМесяцев);
		Если ИмяДокумента = "РасчетСебестоимостиТоваров" Тогда
			ЕстьРасчетСебестоимости = ПоМесяцам[ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -1)] <> Неопределено
				ИЛИ ПоМесяцам[ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -2)] <> Неопределено;
		КонецЕсли;
	КонецЦикла;
	Кт.Строки.Добавить("(· — документа в месяце нет)");

	// себестоимость продаж за 3 прошлых месяца
	МетаВыручки = Метаданные.РегистрыНакопления.Найти("ВыручкаИСебестоимостьПродаж");
	НулеваяСебестоимость = Ложь;
	Если МетаВыручки <> Неопределено И МетаВыручки.Ресурсы.Найти("СуммаВыручкиБезНДС") <> Неопределено Тогда
		РесурсСебестоимости = ?(МетаВыручки.Ресурсы.Найти("СтоимостьБезНДС") <> Неопределено, "СтоимостьБезНДС",
			?(МетаВыручки.Ресурсы.Найти("Стоимость") <> Неопределено, "Стоимость", ""));
		Если РесурсСебестоимости <> "" Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	НАЧАЛОПЕРИОДА(ВС.Период, МЕСЯЦ) КАК Месяц,
				|	СУММА(ВС.СуммаВыручкиБезНДС) КАК Выручка,
				|	СУММА(ВС." + РесурсСебестоимости + ") КАК Себестоимость
				|ИЗ
				|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК ВС
				|ГДЕ
				|	ВС.Период >= &Начало
				|	И ВС.Период < &Конец
				|СГРУППИРОВАТЬ ПО
				|	НАЧАЛОПЕРИОДА(ВС.Период, МЕСЯЦ)
				|УПОРЯДОЧИТЬ ПО
				|	Месяц";
			Запрос.УстановитьПараметр("Начало", ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -3));
			Запрос.УстановитьПараметр("Конец", НачалоМесяца(ТекущаяДатаСеанса()));
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Кт.Строки.Добавить("   " + Формат(Выборка.Месяц, "ДФ='MMMM yyyy'") + ": выручка без НДС " + ФорматЧисла(Выборка.Выручка)
					+ ", себестоимость " + ФорматЧисла(Выборка.Себестоимость)
					+ ?(Выборка.Выручка > 0 И Выборка.Себестоимость > 0, ", валовая рентабельность " + Процент(Выборка.Выручка - Выборка.Себестоимость, Выборка.Выручка), ""));
				Если Выборка.Выручка > 0 И Выборка.Себестоимость = 0 Тогда
					НулеваяСебестоимость = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если НулеваяСебестоимость ИЛИ НЕ ЕстьРасчетСебестоимости Тогда
		Рекомендовать(Кт, 1, "Закрытие месяца",
			"Месяц не закрывается: себестоимость продаж нулевая, прибыль по продуктам, рентабельность и стоимость остатков в ERP неизвестны.",
			"Каждый месяц до 5–10 числа выполнять «Закрытие месяца» (Финансовый результат и контроллинг → Закрытие месяца) — сначала один прошлый месяц с помощью специалиста 1С, по шагам помощника, исправляя ошибки, которые он покажет.");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьПользователей(Кт)

	Раздел(Кт, "12. ПОЛЬЗОВАТЕЛИ И ПРАВА");
	Попытка
		ВсеПользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		Кт.Строки.Добавить("   нет прав посмотреть список пользователей (нужен администратор)");
		Возврат;
	КонецПопытки;
	Всего = ВсеПользователи.Количество();
	ПолныеПрава = 0;
	БезПароля = 0;
	РольПолныеПрава = Метаданные.Роли.Найти("ПолныеПрава");
	Для Каждого Пользователь Из ВсеПользователи Цикл
		Если РольПолныеПрава <> Неопределено И Пользователь.Роли.Содержит(РольПолныеПрава) Тогда
			ПолныеПрава = ПолныеПрава + 1;
		КонецЕсли;
		Если Пользователь.АутентификацияСтандартная И НЕ Пользователь.ПарольУстановлен И НЕ Пользователь.АутентификацияОС Тогда
			БезПароля = БезПароля + 1;
		КонецЕсли;
	КонецЦикла;
	Кт.Строки.Добавить("Пользователей базы: " + Всего + "; с полными правами: " + ПолныеПрава + "; входят без пароля: " + БезПароля);
	Если ПолныеПрава > 3 Тогда
		Рекомендовать(Кт, 2, "Безопасность",
			"Полные права у " + ПолныеПрава + " пользователей: любой может случайно изменить настройки, удалить данные или закрытый период.",
			"Оставить полные права 1–2 администраторам; остальным — профили групп доступа по работе (НСИ и администрирование → Настройки пользователей и прав → Группы доступа).");
	КонецЕсли;
	Если БезПароля > 0 Тогда
		Рекомендовать(Кт, 1, "Безопасность",
			"Без пароля входят " + БезПароля + " пользователей — в базу может зайти кто угодно под их именем.",
			"Задать пароли или включить вход по учётной записи Windows (карточка пользователя → «Вход в программу»).");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьРегламентныеЗадания(Кт)

	Раздел(Кт, "13. РЕГЛАМЕНТНЫЕ ЗАДАНИЯ (автоматические операции)");
	Попытка
		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	Исключение
		Кт.Строки.Добавить("   нет прав посмотреть регламентные задания (нужен администратор)");
		Возврат;
	КонецПопытки;
	Включено = 0;
	Аварийно = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Если НЕ Задание.Использование Тогда
			Продолжить;
		КонецЕсли;
		Включено = Включено + 1;
		Попытка
			Последнее = Задание.ПоследнееЗадание;
			Если Последнее <> Неопределено И Последнее.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				Аварийно.Добавить(Задание.Метаданные.Синоним + " (" + Формат(Последнее.Начало, "ДФ='dd.MM.yy HH:mm'") + ")");
			КонецЕсли;
		Исключение
			// у задания нет сведений о последнем запуске
		КонецПопытки;
	КонецЦикла;
	Кт.Строки.Добавить("Включено заданий: " + Включено + " из " + Задания.Количество() + "; последний запуск с ошибкой: " + Аварийно.Количество());
	Для Каждого ТекстЗадания Из Аварийно Цикл
		Кт.Строки.Добавить("   " + ТекстЗадания);
	КонецЦикла;
	Если Аварийно.Количество() > 0 Тогда
		Рекомендовать(Кт, 2, "Обслуживание",
			"С ошибкой выполняются " + Аварийно.Количество() + " регламентных заданий (список в разделе 13): например, загрузка курсов, обмен с банком или ЭДО могут не работать.",
			"НСИ и администрирование → Обслуживание → Регламентные операции → Регламентные и фоновые задания: открыть задание, посмотреть текст ошибки, передать специалисту 1С.");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьНастройкиИДоработки(Кт)

	Раздел(Кт, "14. НАСТРОЙКИ И ДОРАБОТКИ");

	// функциональные опции «Использовать…»
	Включены = Новый Массив;
	Выключено = 0;
	Для Каждого МетаКонстанты Из Метаданные.Константы Цикл
		Если НЕ СтрНачинаетсяС(МетаКонстанты.Имя, "Использовать") ИЛИ НЕ МетаКонстанты.Тип.СодержитТип(Тип("Булево"))
			ИЛИ МетаКонстанты.Тип.Типы().Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значение = Константы[МетаКонстанты.Имя].Получить();
		Исключение
			Продолжить;
		КонецПопытки;
		Если Значение = Истина Тогда
			Включены.Добавить(Сред(МетаКонстанты.Имя, 13));
		Иначе
			Выключено = Выключено + 1;
		КонецЕсли;
	КонецЦикла;
	Кт.Строки.Добавить("Включённые функции (константы «Использовать…»): " + Включены.Количество() + ", выключено: " + Выключено);
	ТекстФункций = "   ";
	Для Каждого ИмяФункции Из Включены Цикл
		Если СтрДлина(ТекстФункций) > 150 Тогда
			Кт.Строки.Добавить(ТекстФункций);
			ТекстФункций = "   ";
		КонецЕсли;
		ТекстФункций = ТекстФункций + ИмяФункции + ", ";
	КонецЦикла;
	Если СтрДлина(ТекстФункций) > 3 Тогда
		Кт.Строки.Добавить(ТекстФункций);
	КонецЕсли;

	// доработки конфигурации: реквизиты с префиксом вида «опти_», «СГ_»
	Префиксы = Новый Соответствие;
	ДобавленныеОбъекты = Новый Соответствие;
	Для Каждого Коллекция Из Новый Структура("Документы, Справочники, РегистрыСведений, РегистрыНакопления, Обработки, Отчеты",
		Метаданные.Документы, Метаданные.Справочники, Метаданные.РегистрыСведений, Метаданные.РегистрыНакопления, Метаданные.Обработки, Метаданные.Отчеты) Цикл
		Для Каждого МетаОбъекта Из Коллекция.Значение Цикл
			Префикс = ПрефиксДоработки(МетаОбъекта.Имя);
			Если Префикс <> "" Тогда
				ДобавленныеОбъекты.Вставить(Префикс, ?(ДобавленныеОбъекты[Префикс] = Неопределено, 0, ДобавленныеОбъекты[Префикс]) + 1);
			КонецЕсли;
			Попытка
				Реквизиты = МетаОбъекта.Реквизиты;
			Исключение
				Продолжить;
			КонецПопытки;
			Для Каждого МетаРеквизита Из Реквизиты Цикл
				Префикс = ПрефиксДоработки(МетаРеквизита.Имя);
				Если Префикс <> "" Тогда
					Префиксы.Вставить(Префикс, ?(Префиксы[Префикс] = Неопределено, 0, Префиксы[Префикс]) + 1);
				КонецЕсли;
			КонецЦикла;
			Попытка
				Для Каждого МетаТЧ Из МетаОбъекта.ТабличныеЧасти Цикл
					Для Каждого МетаРеквизита Из МетаТЧ.Реквизиты Цикл
						Префикс = ПрефиксДоработки(МетаРеквизита.Имя);
						Если Префикс <> "" Тогда
							Префиксы.Вставить(Префикс, ?(Префиксы[Префикс] = Неопределено, 0, Префиксы[Префикс]) + 1);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			Исключение
				// у объекта нет табличных частей
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	ВсегоДоработок = 0;
	Кт.Строки.Добавить("Доработки конфигурации (по префиксам имён):");
	Для Каждого КлючИЗначение Из Префиксы Цикл
		ВсегоДоработок = ВсегоДоработок + КлючИЗначение.Значение;
		Кт.Строки.Добавить("   " + КлючИЗначение.Ключ + "…: добавленных реквизитов " + КлючИЗначение.Значение
			+ ", объектов " + ?(ДобавленныеОбъекты[КлючИЗначение.Ключ] = Неопределено, 0, ДобавленныеОбъекты[КлючИЗначение.Ключ]));
	КонецЦикла;
	Для Каждого КлючИЗначение Из ДобавленныеОбъекты Цикл
		Если Префиксы[КлючИЗначение.Ключ] = Неопределено Тогда
			Кт.Строки.Добавить("   " + КлючИЗначение.Ключ + "…: объектов " + КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	// расширения
	Попытка
		Расширения = РасширенияКонфигурации.Получить();
		Кт.Строки.Добавить("Расширений конфигурации: " + Расширения.Количество());
		Для Каждого Расширение Из Расширения Цикл
			Кт.Строки.Добавить("   " + Расширение.Имя + " " + Расширение.Версия + ?(Расширение.Активно, "", " (выключено)"));
		КонецЦикла;
	Исключение
		Кт.Строки.Добавить("Расширения: нет прав посмотреть");
	КонецПопытки;

	// подключённые дополнительные обработки
	Если Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Справочник.ДополнительныеОтчетыИОбработки КАК Д
			|ГДЕ
			|	НЕ Д.ПометкаУдаления
			|	И НЕ Д.ЭтоГруппа";
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			Кт.Строки.Добавить("Подключено дополнительных отчётов и обработок: " + Выборка.Количество);
		Исключение
			Кт.Строки.Добавить("Дополнительные обработки: нет прав посмотреть");
		КонецПопытки;
	КонецЕсли;

	Если ВсегоДоработок > 50 Тогда
		Рекомендовать(Кт, 3, "Доработки",
			"Доработки (не типовые префиксы, в конфигурации и расширениях): " + ВсегоДоработок + " добавленных реквизитов. Каждое обновление ERP стоит дороже и дольше, ошибки после обновлений вероятнее.",
			"Новые доработки делать расширениями и внешними обработками (как наши), а не правкой конфигурации; со специалистом 1С обсудить перенос старых доработок в расширение.");
	КонецЕсли;
	Рекомендовать(Кт, 3, "Обновления", "Версия ERP: " + Метаданные.Версия + ". Устаревшая версия не получает исправлений и новых форм отчётности.",
		"Сверить с последней версией на портале 1С (releases.1c.ru) и планировать обновление раз в квартал на копии базы.");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоСлужебныйДокумент(МетаДокумента)

	Текст = НРег(МетаДокумента.Имя + " " + МетаДокумента.Синоним);
	Для Каждого Слово Из СтрРазделить("(не используется),удалить,соглашени,сэдо,сфр,пособи,первичныйдокумент,уведомлени,запрос,"
		+ "регистрациясведений,регламентированн,начислениякредитов,начисления по кредитам,планпроизводства,план производства,"
		+ "выгрузкарегламентированных,доверенност", ",") Цикл
		Если СтрНайти(Текст, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ПрефиксДоработки(Имя)

	// «опти_Количество» → «опти_», «СГ_КоличествоУпаковок» → «СГ_»; в типовых именах 1С подчёркиваний нет
	Позиция = СтрНайти(Имя, "_");
	Если Позиция < 2 ИЛИ Позиция > 8 Тогда
		Возврат "";
	КонецЕсли;
	Префикс = Лев(Имя, Позиция);
	Если СтрНайти("Удалить_", Префикс) > 0 Тогда
		Возврат "";
	КонецЕсли;
	// стандартные реквизиты самой ERP (регламентированные отчёты, кассы, ФНС/СФР) — не доработки
	Для Каждого Типовой Из СтрРазделить("Графа,РСВ_,ФСС_,ОГРН_,КодФНС_,РМК_,ЮЛ_,ФЛ_,action_,ЕНВД_,НДФЛ_,СЗВ_,ЕФС_,ПФР_,СФР_", ",") Цикл
		Если СтрНачинаетсяС(Префикс, Типовой) Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Префикс;

КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиРекомендации(Кт, Итог)

	Итог.Добавить("");
	Итог.Добавить("==== ЧТО ИЗМЕНИТЬ В 1С (по результатам проверок; подробности — в разделах ниже) ====");
	Если Кт.Рекомендации.Количество() = 0 Тогда
		Итог.Добавить("   Серьёзных замечаний нет.");
		Возврат;
	КонецЕсли;
	Кт.Рекомендации.Сортировать("Важность");
	Номер = 0;
	Для Каждого Стр Из Кт.Рекомендации Цикл
		Номер = Номер + 1;
		Итог.Добавить("");
		Итог.Добавить(Формат(Номер, "ЧГ=0") + ". [" + ?(Стр.Важность = 1, "СРОЧНО", ?(Стр.Важность = 2, "ВАЖНО", "ЖЕЛАТЕЛЬНО")) + "] "
			+ Стр.Область + ": " + Стр.Что);
		Итог.Добавить("   Как: " + Стр.Как);
	КонецЦикла;

КонецПроцедуры

