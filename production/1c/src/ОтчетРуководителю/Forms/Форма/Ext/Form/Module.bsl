Функция Склонение(Знач Колво, Форма1, Форма2, Форма5)

	Колво = Цел(Макс(Колво, -Колво));
	Если Колво % 10 = 1 И Колво % 100 <> 11 Тогда
		Возврат Форма1;
	ИначеЕсли Колво % 10 >= 2 И Колво % 10 <= 4 И (Колво % 100 < 12 ИЛИ Колво % 100 > 14) Тогда
		Возврат Форма2;
	КонецЕсли;
	Возврат Форма5;

