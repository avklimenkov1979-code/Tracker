	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Документ,
		|	Д.Дата КАК Дата,
		|	Д.Номер КАК Номер,
