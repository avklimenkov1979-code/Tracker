// Лучший распознанный договор каждого арендатора: без ошибки, больше найденных показателей, новее.
&НаСервере
Функция ДоговорыПДФПоАрендаторам()

	Результат = Новый Соответствие;
	Для Каждого Элемент Из ЗагрузитьДоговорыПДФ() Цикл
		Д = Элемент.Значение;
		Если ТипЗнч(Д) <> Тип("Структура") ИЛИ НЕ ПустаяСтрока(Д.Ошибка) Тогда
			Продолжить;
		КонецЕсли;
		Было = Результат[Д.Арендатор];
		Если Было = Неопределено ИЛИ ПолнотаДоговора(Д) > ПолнотаДоговора(Было)
			ИЛИ (ПолнотаДоговора(Д) = ПолнотаДоговора(Было) И Д.ДатаДоговора > Было.ДатаДоговора) Тогда
			Результат.Вставить(Д.Арендатор, Д);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПолнотаДоговора(Д)

	Возврат ?(Д.Площадь > 0, 1, 0) + ?(Д.ВМесяц > 0, 1, 0) + ?(Д.Ставка > 0, 1, 0) + ?(ЗначениеЗаполнено(Д.СрокДо), 1, 0);

КонецФункции

// Плата по договору без НДС — для сравнения с начислениями (они в отчёте без НДС).
&НаСервере
Функция ПлатаБезНДС(Д, ДатаОтчета)

	Ставка = ?(ДатаОтчета >= Дата(2026, 1, 1), 22, 20);
	Возврат ?(Д.НДС = "с НДС", Д.ВМесяц * 100 / (100 + Ставка), Д.ВМесяц);

КонецФункции

&НаСервере
Функция ВывестиДоговорыПДФ(Кэш, П)

	В = Новый Структура("ТД, Строка", Новый ТабличныйДокумент, 1);
	В.ТД.ОтображатьСетку = Ложь;
	В.ТД.ОтображатьЗаголовки = Ложь;
	В.ТД.АвтоМасштаб = Истина;
	Для К = 1 По 8 Цикл
		В.ТД.Область(1, К, 1, К).ШиринаКолонки = ?(К = 1, 34, ?(К = 8, 22, 14));
	КонецЦикла;
	ЗаголовокРаздела(В, "Договоры аренды из PDF (распознано без интернета)");
	Шапка(В, "Арендатор / файл", "Площадь, м²", "Ставка за м²", "Плата в месяц", "НДС", "Срок до", "Индексация", "Начислено в прошлом месяце");
	Аренда = Неопределено;
	Попытка
		Аренда = ПолучитьАренду(П, Неопределено);
	Исключение
		Аренда = Неопределено;
	КонецПопытки;
	Список = Новый ТаблицаЗначений;
	Список.Колонки.Добавить("Арендатор");
	Список.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Список.Колонки.Добавить("Д");
	Для Каждого Элемент Из Кэш Цикл
		НовСтр = Список.Добавить();
		НовСтр.Арендатор = Строка(Элемент.Значение.Арендатор);
		НовСтр.Имя = Элемент.Значение.Имя;
		НовСтр.Д = Элемент.Значение;
	КонецЦикла;
	Список.Сортировать("Арендатор, Имя");
	Для Каждого Стр Из Список Цикл
		Д = Стр.Д;
		Ячейка(В, 1, Строка(Д.Арендатор), Истина, , , , , Истина);
		Если НЕ ПустаяСтрока(Д.Ошибка) Тогда
			Ячейка(В, 2, Д.Имя + ": " + Д.Ошибка, , ЦветКрит(), , 9, 8, Истина);
			РасшифровкаСтроки(В, Д.Файл, 8);
			СледующаяСтрока(В);
			Продолжить;
		КонецЕсли;
		ЯчейкаЧисло(В, 2, Д.Площадь);
		ЯчейкаЧисло(В, 3, Д.Ставка);
		ЯчейкаЧисло(В, 4, Д.ВМесяц, , Истина);
		Ячейка(В, 5, Д.НДС);
		Ячейка(В, 6, ?(ЗначениеЗаполнено(Д.СрокДо), Формат(Д.СрокДо, "ДФ=dd.MM.yyyy"), "—"),
			ЗначениеЗаполнено(Д.СрокДо) И Д.СрокДо < П.День + 60 * 86400, ?(ЗначениеЗаполнено(Д.СрокДо) И Д.СрокДо < П.День + 60 * 86400, ЦветКрит(), Неопределено));
		Ячейка(В, 7, ?(Д.Индексация > 0, Формат(Д.Индексация, "ЧДЦ=1; ЧН=0") + " %", "—"));
		Начислено = 0;
		Если Аренда <> Неопределено Тогда
			СтрАренды = Аренда.Таблица.Найти(Д.Арендатор, "Арендатор");
			Начислено = ?(СтрАренды = Неопределено, 0, СтрАренды.ПрошлыйМесяц);
		КонецЕсли;
		ПоДоговору = ПлатаБезНДС(Д, П.День);
		Расхождение = ПоДоговору > 0 И Начислено > 0 И Макс(Начислено - ПоДоговору, ПоДоговору - Начислено) > ПоДоговору * 0.05;
		ЯчейкаЧисло(В, 8, Начислено, ?(Расхождение, ЦветКрит(), Неопределено), Расхождение);
		РасшифровкаСтроки(В, Д.Файл, 8);
		СледующаяСтрока(В);
		Части = Новый Массив;
		Части.Добавить(Д.Имя + ?(ЗначениеЗаполнено(Д.Договор), " → договор " + Строка(Д.Договор), " → договор в 1С не найден")
			+ ?(ПустаяСтрока(Д.Номер), "", ", в тексте № " + Д.Номер) + ?(ЗначениеЗаполнено(Д.ДатаДоговора), " от " + Формат(Д.ДатаДоговора, "ДФ=dd.MM.yyyy"), ""));
		Если НЕ ПустаяСтрока(Д.Адрес) Тогда
			Части.Добавить("адрес: " + Д.Адрес);
		КонецЕсли;
		Если Расхождение Тогда
			Части.Добавить("ВНИМАНИЕ: по договору " + ФорматДенег(ПоДоговору) + " без НДС в месяц, начислено " + ФорматДенег(Начислено));
		КонецЕсли;
		Для Каждого Пара Из СтрРазделить("площадь:ЦитатаПлощадь,ставка:ЦитатаСтавка,плата:ЦитатаВМесяц,срок:ЦитатаСрок,индексация:ЦитатаИндексация", ",") Цикл
			Ч = СтрРазделить(Пара, ":");
			Если НЕ ПустаяСтрока(Д[Ч[1]]) Тогда
				Части.Добавить(Ч[0] + " — «" + Д[Ч[1]] + "»");
			КонецЕсли;
		КонецЦикла;
		Текст = СтрСоединить(Части, Символы.ПС);
		Ячейка(В, 1, Текст, , ЦветПриглушенный(), , 8, 8, Истина);
		ПодогнатьВысоту(В, Текст, 150);
		РасшифровкаСтроки(В, ?(ЗначениеЗаполнено(Д.Договор), Д.Договор, Д.Файл), 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	Примечание(В, "Текст PDF распознан встроенным распознаванием Windows, договоры никуда не отправлялись. Цифры найдены по типовым фразам "
		+ "(«площадью … кв. м», «арендная плата составляет … руб. в месяц», «… руб. за 1 кв. м», «срок … по <дата>», «индексация … %») — "
		+ "проверьте их по цитатам. Сравнение с начислениями — без НДС (плата «с НДС» пересчитана). Двойной щелчок открывает файл или договор.");
	Возврат В.ТД;

КонецФункции

&НаСервере
Функция ЗаписатьДоговорыНаСервере()

	Записано = 0;
	Реквизитов = 0;
	НетРеквизитов = Новый Массив;
	Для Каждого Элемент Из ДоговорыПДФПоАрендаторам() Цикл
		Д = Элемент.Значение;
		Владелец = ?(ЗначениеЗаполнено(Д.Договор), Д.Договор, Д.Арендатор);
		Свойства = УправлениеСвойствами.СвойстваОбъекта(Владелец, Истина, Ложь);
		Если Свойства.Количество() = 0 Тогда
			НетРеквизитов.Добавить(Строка(Владелец));
			Продолжить;
		КонецЕсли;
		Текущие = УправлениеСвойствами.ЗначенияСвойств(Владелец, Истина, Ложь);
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Свойство");
		Таблица.Колонки.Добавить("Значение");
		Для Каждого Свойство Из Свойства Цикл
			Имя = СтрЗаменить(НРег(Строка(Свойство)), "ё", "е");
			Значение = Неопределено;
			Если СтрНайти(Имя, "площад") > 0 Тогда
				Значение = Д.Площадь;
			ИначеЕсли СтрНайти(Имя, "ставк") > 0 Тогда
				Значение = Д.Ставка;
			ИначеЕсли СтрНайти(Имя, "индексац") > 0 Тогда
				Значение = Д.Индексация;
			ИначеЕсли СтрНайти(Имя, "плат") > 0 ИЛИ СтрНайти(Имя, "в месяц") > 0 Тогда
				Значение = Д.ВМесяц;
			ИначеЕсли СтрНайти(Имя, "срок") > 0 ИЛИ СтрНайти(Имя, "окончан") > 0 Тогда
				Значение = Д.СрокДо;
			ИначеЕсли СтрНайти(Имя, "адрес") > 0 Тогда
				Значение = Д.Адрес;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			ТипСвойства = Свойство.ТипЗначения;
			Если НЕ ТипСвойства.СодержитТип(ТипЗнч(Значение)) Тогда
				Продолжить;
			КонецЕсли;
			Было = Текущие.Найти(Свойство, "Свойство");
			Если Было <> Неопределено И ЗначениеЗаполнено(Было.Значение) Тогда
				Продолжить; // заполненное не трогаем
			КонецЕсли;
			НовСтр = Таблица.Добавить();
			НовСтр.Свойство = Свойство;
			НовСтр.Значение = Значение;
		КонецЦикла;
		Если Таблица.Количество() > 0 Тогда
			УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Владелец, Таблица);
			Записано = Записано + 1;
			Реквизитов = Реквизитов + Таблица.Количество();
		КонецЕсли;
	КонецЦикла;
	Итог = СтрШаблон("Заполнено реквизитов: %1 у %2 договоров (арендаторов).", Реквизитов, Записано);
	Если НетРеквизитов.Количество() > 0 Тогда
		Итог = Итог + Символы.ПС + Символы.ПС + "У договоров нет дополнительных реквизитов (" + НетРеквизитов.Количество() + "). Заведите их один раз: "
			+ "НСИ и администрирование → Общие настройки → Дополнительные реквизиты и сведения → Договоры с контрагентами: "
			+ "«Площадь, м²» (число), «Арендная плата в месяц» (число), «Ставка за м²» (число), «Срок аренды до» (дата), «Индексация, %» (число), «Адрес помещения» (строка).";
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Данные распознанных договоров — в таблицу раздела «Арендаторы».
&НаСервере
Процедура ДобавитьДанныеДоговоровПДФ(Т)

	Т.Колонки.Добавить("ПоДоговору");
	Договоры = ДоговорыПДФПоАрендаторам();
	Для Каждого Стр Из Т Цикл
		Д = Договоры[Стр.Арендатор];
		Если Д = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Стр.ПоДоговору = Д;
		Если НЕ ЗначениеЗаполнено(Стр.ДоговорДо) И ЗначениеЗаполнено(Д.СрокДо) Тогда
			Стр.ДоговорДо = Д.СрокДо;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// >>> СКРИПТ РАСПОЗНАВАНИЯ (генерируется 1c_tools/embed_ps.py из production/1c/dogovory_pdf.ps1)
&НаСервере
Функция ТекстСкриптаРаспознавания()

	Строки = Новый Массив;
	Строки.Добавить("param([string]$Dir, [int]$MaxPages = 10, [int]$MaxSeconds = 180)");
	Строки.Добавить("# Распознавание договоров аренды в PDF без интернета: Windows сам рисует страницы PDF");
