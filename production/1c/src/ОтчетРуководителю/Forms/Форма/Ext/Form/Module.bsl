&НаСервере
Процедура ЯчейкаКоличество(В, Колонка, Значение, Ед)

	Если Значение = 0 Тогда
		Ячейка(В, Колонка, "—", , ЦветПриглушенный());
	Иначе
		Ячейка(В, Колонка, ФорматЧисла(Значение) + ?(ЗначениеЗаполнено(Ед), " " + Ед, ""));
	КонецЕсли;
	ВПраво(В, Колонка, Колонка);

