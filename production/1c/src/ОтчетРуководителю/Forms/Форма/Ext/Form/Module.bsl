#КонецОбласти

#Область Долги

&НаСервере
Функция ПолучитьДолги(ИмяРегистра, ЗапасноеИмя, П)

	Рег = ИмяРегистра;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Рег = ЗапасноеИмя;
	КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистров " + ИмяРегистра + " и " + ЗапасноеИмя;
	КонецЕсли;

	Поля = Новый Массив;
	Группировки = Новый Массив;
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаПоПартнерам") <> "" Тогда
		Поля.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер) КАК Контрагент");
		Группировки.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер)");
	Иначе
		ИзмКонтрагент = ИзмерениеРегистра(Рег, "Контрагент,Партнер");
		Поля.Добавить(?(ИзмКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмКонтрагент) + " КАК Контрагент");
		Если ИзмКонтрагент <> "" Тогда
			Группировки.Добавить("Т." + ИзмКонтрагент);
		КонецЕсли;
	КонецЕсли;
	ИзмДокумент = ИзмерениеРегистра(Рег, "ОбъектРасчетов,ДокументРасчетов,РасчетныйДокумент,ЗаказКлиента,Заказ,ДокументРегистратор");
	Поля.Добавить(?(ИзмДокумент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмДокумент) + " КАК Документ");
	Если ИзмДокумент <> "" Тогда
		Группировки.Добавить("Т." + ИзмДокумент);
	КонецЕсли;
	ИзмСрок = ИзмерениеРегистра(Рег, "ДатаПлановогоПогашения,ДатаПлатежа,СрокОплаты,ДатаПогашения");
	Поля.Добавить(?(ИзмСрок = "", "ДАТАВРЕМЯ(1, 1, 1)", "Т." + ИзмСрок) + " КАК Срок");
	Если ИзмСрок <> "" Тогда
		Группировки.Добавить("Т." + ИзмСрок);
	КонецЕсли;
	Ресурс = РесурсРегистра(Рег, "ДолгРегл,Долг,ДолгУпр,СуммаРегл,Сумма");
	Если Ресурс = "" Тогда
		ВызватьИсключение "в регистре " + Рег + " не найден ресурс суммы долга";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(Поля, ",
		|	") + ",
		|	СУММА(Т." + Ресурс + "Остаток) КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница" + ?(Условие = "", "", ", " + Условие) + ") КАК Т" + ?(Группировки.Количество() = 0, "", "
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(Группировки, ",
		|	")) + "
		|ИМЕЮЩИЕ
		|	СУММА(Т." + Ресурс + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Позиции = Запрос.Выполнить().Выгрузить();

	// тот же запрос на начало месяца: как изменился долг
	Запрос.УстановитьПараметр("Граница", П.НачалоМесяца);
	ВсегоНаНачало = 0;
	ПросроченоНаНачало = 0;
	Для Каждого Поз Из Запрос.Выполнить().Выгрузить() Цикл
		ВсегоНаНачало = ВсегоНаНачало + Поз.Сумма;
		Если ЗначениеЗаполнено(Поз.Срок) И Поз.Срок < П.НачалоМесяца Тогда
			ПросроченоНаНачало = ПросроченоНаНачало + Поз.Сумма;
		КонецЕсли;
	КонецЦикла;

	Позиции.Колонки.Добавить("Просрочка", ОписаниеЧисла());
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) Тогда
			Поз.Просрочка = Цел((П.День - НачалоДня(Поз.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;
	Позиции.Сортировать("Просрочка Убыв, Сумма Убыв");

	Корзины = Новый Массив;
	Для Каждого Опис Из ОписаниеКорзин() Цикл
		Корзины.Добавить(Новый Структура("Заголовок, Сумма", Опис.Заголовок, 0));
	КонецЦикла;
	Всего = 0;
	Просрочено = 0;
	ВБлижайшие = 0;
	ПоКонтрагентам = Новый ТаблицаЗначений;
	ПоКонтрагентам.Колонки.Добавить("Контрагент");
	ПоКонтрагентам.Колонки.Добавить("Долг", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Просрочено", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("МаксПросрочка", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Документов", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("БлижайшийСрок");
	Ближайшие = Позиции.СкопироватьКолонки();
	Для Каждого Поз Из Позиции Цикл
		Всего = Всего + Поз.Сумма;
		НовСтр = ПоКонтрагентам.Найти(Поз.Контрагент, "Контрагент");
		Если НовСтр = Неопределено Тогда
			НовСтр = ПоКонтрагентам.Добавить();
			НовСтр.Контрагент = Поз.Контрагент;
		КонецЕсли;
		НовСтр.Долг = НовСтр.Долг + Поз.Сумма;
		НовСтр.Документов = НовСтр.Документов + 1;
		Если Поз.Просрочка > 0 Тогда
			Просрочено = Просрочено + Поз.Сумма;
			НовСтр.Просрочено = НовСтр.Просрочено + Поз.Сумма;
			НовСтр.МаксПросрочка = Макс(НовСтр.МаксПросрочка, Поз.Просрочка);
		ИначеЕсли ЗначениеЗаполнено(Поз.Срок) Тогда
			Если НЕ ЗначениеЗаполнено(НовСтр.БлижайшийСрок) ИЛИ Поз.Срок < НовСтр.БлижайшийСрок Тогда
				НовСтр.БлижайшийСрок = Поз.Срок;
			КонецЕсли;
			Если -Поз.Просрочка <= П.Горизонт Тогда
				ВБлижайшие = ВБлижайшие + Поз.Сумма;
				ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Поз);
			КонецЕсли;
		КонецЕсли;
		Индекс = 0;
		Для Каждого Опис Из ОписаниеКорзин() Цикл
			Если Поз.Просрочка >= Опис.От И Поз.Просрочка <= Опис.До Тогда
				Корзины[Индекс].Сумма = Корзины[Индекс].Сумма + Поз.Сумма;
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	ПоКонтрагентам.Сортировать("Просрочено Убыв, Долг Убыв");
	Ближайшие.Сортировать("Срок");

	Р = Новый Структура;
	Р.Вставить("Регистр", Рег);
	Р.Вставить("ЕстьСроки", ИзмСрок <> "");
	Р.Вставить("Позиции", Позиции);
	Р.Вставить("Всего", Всего);
	Р.Вставить("Просрочено", Просрочено);
	Р.Вставить("ВБлижайшие", ВБлижайшие);
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Корзины", Корзины);
	Р.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	Р.Вставить("ВсегоНаНачало", ВсегоНаНачало);
	Р.Вставить("ПросроченоНаНачало", ПросроченоНаНачало);
	Возврат Р;

КонецФункции

&НаСервере
Функция ОписаниеКорзин()

	Корзины = Новый Массив;
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Срок не наступил", -100000, 0));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "1–30 дней", 1, 30));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "31–60 дней", 31, 60));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "61–90 дней", 61, 90));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Более 90 дней", 91, 100000));
	Возврат Корзины;

