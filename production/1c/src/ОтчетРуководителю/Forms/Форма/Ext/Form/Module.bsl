// Отчёт руководителю за день: деньги, долги, заказы, выпуск, нехватка сырья.
// Внешняя обработка для 1С:ERP Управление предприятием 2.4 / 2.5 (платформа 8.3.10+).
// Собирается из этой папки файлом СОБРАТЬ.bat (см. production/1c/README.md).
//
// Это модуль основной формы. Реквизиты и элементы формы создаются из кода
// в ПриСозданииНаСервере, поэтому Form.xml почти пустой.
//
// Регистры и поля ищутся по метаданным, поэтому отчёт переносит разницу между
// релизами ERP. Если какой-то раздел не получится собрать, отчёт покажет текст
// ошибки в этом разделе, а остальные разделы сформирует как обычно.
// Все запросы — в функциях Получить*(): их и правят, если в базе что-то иначе.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизитыФормы();
	СоздатьЭлементыФормы();
	ЗагрузитьНастройки();
	ЭтаФорма["ДатаОтчета"] = НачалоДня(ТекущаяДатаСеанса());
	ЭтаФорма.Заголовок = "Отчёт руководителю";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтаФорма["ДатаОтчета"]) Тогда
		ПоказатьПредупреждение(, "Укажите дату отчёта.");
		Возврат;
	КонецЕсли;
	Состояние("Формирую отчёт руководителю...");
	СформироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Вчера(Команда)

	ЭтаФорма["ДатаОтчета"] = НачалоДня(ЭтаФорма["ДатаОтчета"]) - 86400;
	СформироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Сегодня(Команда)

	ЭтаФорма["ДатаОтчета"] = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса());
	СформироватьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ФормаИзКода

&НаСервере
Процедура СоздатьРеквизитыФормы()

	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ТипДни = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный));

	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаОтчета", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), , "Дата"));
	Добавляемые.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Добавляемые.Добавить(Новый РеквизитФормы("ГруппаСырья", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), , "Группа сырья"));
	Добавляемые.Добавить(Новый РеквизитФормы("ПланВыпускаВСутки", ТипЧисло, , "План выпуска в сутки"));
	Добавляемые.Добавить(Новый РеквизитФормы("НеснижаемыйОстаток", ТипЧисло, , "Неснижаемый остаток, руб."));
	Добавляемые.Добавить(Новый РеквизитФормы("ГоризонтДней", ТипДни, , "Прогноз, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("СрокПоставкиДней", ТипДни, , "Срок поставки сырья, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("РезервДней", ТипДни, , "Резерв сверх срока поставки, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("КрупныйПлатеж", ТипЧисло, , "Крупный платёж от, руб."));
	Добавляемые.Добавить(Новый РеквизитФормы("ДокументОтчета", Новый ОписаниеТипов("ТабличныйДокумент"), , "Отчёт"));
	ИзменитьРеквизиты(Добавляемые);

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы()

	Команда = Команды.Добавить("СформироватьОтчет");
	Команда.Заголовок = "Сформировать";
	Команда.Действие = "СформироватьОтчет";
	Команда.Подсказка = "Собрать отчёт на выбранную дату";

	Команда = Команды.Добавить("Вчера");
	Команда.Заголовок = "← Вчера";
	Команда.Действие = "Вчера";

	Команда = Команды.Добавить("Сегодня");
	Команда.Заголовок = "Сегодня";
	Команда.Действие = "Сегодня";

	Кнопка = Элементы.Добавить("КнопкаСформировать", Тип("КнопкаФормы"), Элементы.КоманднаяПанель);
	Кнопка.ИмяКоманды = "СформироватьОтчет";
	Кнопка.КнопкаПоУмолчанию = Истина;
	Кнопка = Элементы.Добавить("КнопкаВчера", Тип("КнопкаФормы"), Элементы.КоманднаяПанель);
	Кнопка.ИмяКоманды = "Вчера";
	Кнопка = Элементы.Добавить("КнопкаСегодня", Тип("КнопкаФормы"), Элементы.КоманднаяПанель);
	Кнопка.ИмяКоманды = "Сегодня";

	Группа = Элементы.Добавить("ГруппаОсновные", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Группа.ОтображатьЗаголовок = Ложь;
	ДобавитьПоле("ДатаОтчета", Группа);
	ДобавитьПоле("Организация", Группа, "Пусто — все организации");

	Группа = Элементы.Добавить("ГруппаНастройки", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Настройки отчёта";
	Попытка
		Группа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
		Группа.Скрыта = Истина;
	Исключение
		// старая платформа: группа просто показывается раскрытой
	КонецПопытки;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Строка1 = Элементы.Добавить("ГруппаНастройки1", Тип("ГруппаФормы"), Группа);
	Строка1.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Строка1.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Строка1.ОтображатьЗаголовок = Ложь;
	Строка2 = Элементы.Добавить("ГруппаНастройки2", Тип("ГруппаФормы"), Группа);
	Строка2.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Строка2.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Строка2.ОтображатьЗаголовок = Ложь;
	ДобавитьПоле("ГруппаСырья", Строка1, "Папка номенклатуры с сырьём. Пусто — всё, что списывалось в производство за 30 дней");
	ДобавитьПоле("ПланВыпускаВСутки", Строка1, "В единицах продукции (т или кг). 0 — без процента выполнения плана");
	ДобавитьПоле("НеснижаемыйОстаток", Строка1);
	ДобавитьПоле("ГоризонтДней", Строка2);
	ДобавитьПоле("СрокПоставкиДней", Строка2);
	ДобавитьПоле("РезервДней", Строка2);
	ДобавитьПоле("КрупныйПлатеж", Строка2);

	Поле = Элементы.Добавить("ДокументОтчета", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	Поле.ПутьКДанным = "ДокументОтчета";
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоле(Имя, Родитель, Подсказка = "")

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = Имя;
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Поле.Подсказка = Подсказка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()

	ЭтаФорма["ГоризонтДней"] = 7;
	ЭтаФорма["СрокПоставкиДней"] = 7;
	ЭтаФорма["РезервДней"] = 3;
	ЭтаФорма["КрупныйПлатеж"] = 3000000;
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("ОтчетРуководителю", "Настройки");
	Если ТипЗнч(Сохраненные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Сохраненные Цикл
		Попытка
			ЭтаФорма[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		Исключение
			// реквизит переименован в новой версии отчёта — пропускаем
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()

	Настройки = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Организация,ГруппаСырья,ПланВыпускаВСутки,НеснижаемыйОстаток,ГоризонтДней,СрокПоставкиДней,РезервДней,КрупныйПлатеж", ",") Цикл
		Настройки.Вставить(Имя, ЭтаФорма[Имя]);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ОтчетРуководителю", "Настройки", Настройки);

КонецПроцедуры

#КонецОбласти

#Область Формирование

&НаСервере
Процедура СформироватьНаСервере()

	СохранитьНастройки();

	ДеньОтчета = НачалоДня(ЭтаФорма["ДатаОтчета"]);
	П = Новый Структура;
	П.Вставить("День", ДеньОтчета);
	П.Вставить("НачалоДня", ДеньОтчета);
	П.Вставить("КонецДня", КонецДня(ДеньОтчета));
	П.Вставить("Граница", Новый Граница(КонецДня(ДеньОтчета), ВидГраницы.Включая));
	П.Вставить("НачалоМесяца", НачалоМесяца(ДеньОтчета));
	П.Вставить("Начало14", ДеньОтчета - 13 * 86400);
	П.Вставить("Организация", ЭтаФорма["Организация"]);
	П.Вставить("ГруппаСырья", ЭтаФорма["ГруппаСырья"]);
	П.Вставить("ПланВСутки", ЭтаФорма["ПланВыпускаВСутки"]);
	П.Вставить("НеснижаемыйОстаток", ЭтаФорма["НеснижаемыйОстаток"]);
	П.Вставить("Горизонт", Макс(1, ЭтаФорма["ГоризонтДней"]));
	П.Вставить("СрокПоставки", ЭтаФорма["СрокПоставкиДней"]);
	П.Вставить("Резерв", ЭтаФорма["РезервДней"]);
	П.Вставить("КрупныйПлатеж", ЭтаФорма["КрупныйПлатеж"]);

	Р = Новый Структура;
	Р.Вставить("Ошибки", Новый Соответствие);
	Р.Вставить("Сигналы", НоваяТаблицаСигналов());

	Р.Вставить("Долги", Неопределено);
	Попытка
		Р.Долги = Новый Структура("НамДолжны, МыДолжны",
			ПолучитьДолги("РасчетыСКлиентамиПоСрокам", "РасчетыСКлиентами", П),
			ПолучитьДолги("РасчетыСПоставщикамиПоСрокам", "РасчетыСПоставщиками", П));
	Исключение
		Р.Ошибки.Вставить("Долги", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Р.Вставить("Деньги", Неопределено);
	Попытка
		Р.Деньги = ПолучитьДеньги(П, Р.Долги);
	Исключение
		Р.Ошибки.Вставить("Деньги", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Р.Вставить("Выпуск", Неопределено);
	Попытка
		Р.Выпуск = ПолучитьВыпуск(П);
	Исключение
		Р.Ошибки.Вставить("Выпуск", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Р.Вставить("Заказы", Неопределено);
	Попытка
		Р.Заказы = ПолучитьЗаказы(П, Р.Выпуск);
	Исключение
		Р.Ошибки.Вставить("Заказы", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Р.Вставить("Сырье", Неопределено);
	Попытка
		Р.Сырье = ПолучитьСырье(П);
	Исключение
		Р.Ошибки.Вставить("Сырье", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	СобратьСигналы(Р, П);
	ЭтаФорма["ДокументОтчета"] = Вывести(Р, П);

КонецПроцедуры

#КонецОбласти

#Область Деньги

&НаСервере
Функция ПолучитьДеньги(П, Долги)

	Р = Новый Структура;
	Счета = Новый ТаблицаЗначений;
	Счета.Колонки.Добавить("Вид");
	Счета.Колонки.Добавить("Счет");
	Счета.Колонки.Добавить("Вчера", ОписаниеЧисла());
	Счета.Колонки.Добавить("Сегодня", ОписаниеЧисла());

	Платежи = Новый ТаблицаЗначений;
	Платежи.Колонки.Добавить("Документ");
	Платежи.Колонки.Добавить("День");
	Платежи.Колонки.Добавить("Приход", ОписаниеЧисла());
	Платежи.Колонки.Добавить("Расход", ОписаниеЧисла());

	Регистры = Новый Массив;
	Регистры.Добавить(Новый Структура("Регистр, Измерение, Вид", "ДенежныеСредстваБезналичные", "БанковскийСчет,Счет", "Банк"));
	Регистры.Добавить(Новый Структура("Регистр, Измерение, Вид", "ДенежныеСредстваНаличные", "Касса", "Касса"));

	Для Каждого Опис Из Регистры Цикл
		Если Метаданные.РегистрыНакопления.Найти(Опис.Регистр) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = РесурсРегистра(Опис.Регистр, "СуммаРегл,Сумма");
		Измерение = ИзмерениеРегистра(Опис.Регистр, Опис.Измерение);
		Условие = УсловиеОрганизации(Опис.Регистр, П);

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т." + Измерение + " КАК Счет,
			|	Т." + Ресурс + "НачальныйОстаток КАК Вчера,
			|	Т." + Ресурс + "КонечныйОстаток КАК Сегодня
			|ИЗ
			|	РегистрНакопления." + Опис.Регистр + ".ОстаткиИОбороты(&НачалоДня, &КонецДня" + ?(Условие = "", "", ", , , " + Условие) + ") КАК Т";
		УстановитьПараметры(Запрос, П);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Вчера = 0 И Выборка.Сегодня = 0 Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Счета.Добавить();
			НовСтр.Вид = Опис.Вид;
			НовСтр.Счет = Выборка.Счет;
			НовСтр.Вчера = Выборка.Вчера;
			НовСтр.Сегодня = Выборка.Сегодня;
		КонецЦикла;

		// движения за месяц по документам: приход и расход каждого документа
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Регистратор КАК Документ,
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК День,
			|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Приход,
			|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Расход
			|ИЗ
			|	РегистрНакопления." + Опис.Регистр + " КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &НачалоМесяца И &КонецДня
			|	И Т.Активность" + ?(Условие = "", "", "
			|	И Т." + Условие) + "
			|СГРУППИРОВАТЬ ПО
			|	Т.Регистратор,
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Платежи.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;

	Платежи.Свернуть("Документ, День", "Приход, Расход");
	Счета.Сортировать("Вид, Сегодня Убыв");
	Р.Вставить("Счета", Счета);
	Р.Вставить("Итого", Счета.Итог("Сегодня"));
	Р.Вставить("ИтогоВчера", Счета.Итог("Вчера"));

	// платежи дня без внутренних перемещений
	ЗаДень = Новый ТаблицаЗначений;
	ЗаДень.Колонки.Добавить("Вид");
	ЗаДень.Колонки.Добавить("Документ");
	ЗаДень.Колонки.Добавить("Контрагент");
	ЗаДень.Колонки.Добавить("Статья");
	ЗаДень.Колонки.Добавить("Назначение");
	ЗаДень.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Приход = 0;
	Расход = 0;
	ПриходМесяц = 0;
	РасходМесяц = 0;
	Перемещений = 0;
	Для Каждого Пл Из Платежи Цикл
		Если ЭтоПеремещениеДенег(Пл) Тогда
			Если Пл.День = П.День Тогда
				Перемещений = Перемещений + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПриходМесяц = ПриходМесяц + Пл.Приход;
		РасходМесяц = РасходМесяц + Пл.Расход;
		Если Пл.День <> П.День Тогда
			Продолжить;
		КонецЕсли;
		Приход = Приход + Пл.Приход;
		Расход = Расход + Пл.Расход;
		Сальдо = Пл.Приход - Пл.Расход;
		НовСтр = ЗаДень.Добавить();
		НовСтр.Вид = ?(Сальдо >= 0, "приход", "расход");
		НовСтр.Документ = Пл.Документ;
		НовСтр.Сумма = Макс(Сальдо, -Сальдо);
		НовСтр.Контрагент = РеквизитСсылки(Пл.Документ, "Контрагент,Партнер,ПодотчетноеЛицо,Получатель");
		НовСтр.Статья = РеквизитСсылки(Пл.Документ, "СтатьяДвиженияДенежныхСредств,СтатьяДДС");
		НовСтр.Назначение = РеквизитСсылки(Пл.Документ, "НазначениеПлатежа,Основание,Комментарий");
	КонецЦикла;
	ЗаДень.Сортировать("Вид Убыв, Сумма Убыв");
	Р.Вставить("Платежи", ЗаДень);
	Р.Вставить("Приход", Приход);
	Р.Вставить("Расход", Расход);
	Р.Вставить("ПриходМесяц", ПриходМесяц);
	Р.Вставить("РасходМесяц", РасходМесяц);
	Р.Вставить("Перемещений", Перемещений);

	// прогноз по срокам оплат: просроченную кредиторку платим завтра,
	// просроченную дебиторку не ждём
	Прогноз = Новый ТаблицаЗначений;
	Прогноз.Колонки.Добавить("Дата");
	Прогноз.Колонки.Добавить("Поступления", ОписаниеЧисла());
	Прогноз.Колонки.Добавить("Платежи", ОписаниеЧисла());
	Прогноз.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Остаток = Р.Итого;
	ПросроченоКОплате = 0;
	Минимум = Неопределено;
	Если Долги <> Неопределено Тогда
		ПросроченоКОплате = Долги.МыДолжны.Просрочено;
		Для Д = 1 По П.Горизонт Цикл
			ДатаДня = П.День + Д * 86400;
			НовСтр = Прогноз.Добавить();
			НовСтр.Дата = ДатаДня;
			НовСтр.Поступления = СуммаКСроку(Долги.НамДолжны.Позиции, ДатаДня);
			НовСтр.Платежи = СуммаКСроку(Долги.МыДолжны.Позиции, ДатаДня) + ?(Д = 1, ПросроченоКОплате, 0);
			Остаток = Остаток + НовСтр.Поступления - НовСтр.Платежи;
			НовСтр.Остаток = Остаток;
			Если Минимум = Неопределено ИЛИ Остаток < Минимум.Остаток Тогда
				Минимум = НовСтр;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Р.Вставить("Прогноз", Прогноз);
	Р.Вставить("Минимум", Минимум);
	Р.Вставить("ПросроченоКОплате", ПросроченоКОплате);
	Возврат Р;

КонецФункции

&НаСервере
Функция ЭтоПеремещениеДенег(Платеж)

	// один документ и принёс, и списал деньги на своих счетах — это перемещение
	Если Платеж.Приход <> 0 И Платеж.Расход <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Имя = Платеж.Документ.Метаданные().Имя;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Для Каждого Часть Из СтрРазделить("Перемещени,ДругуюКассу,Инкассац,ВнесениеНаличных,СнятиеНаличных,КонвертацияВалют", ",") Цикл
		Если СтрНайти(Имя, Часть) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Операция = РеквизитСсылки(Платеж.Документ, "ХозяйственнаяОперация");
	Если ЗначениеЗаполнено(Операция) Тогда
		Текст = НРег(Строка(Операция));
		Возврат СтрНайти(Текст, "перемещ") > 0 ИЛИ СтрНайти(Текст, "внутренн") > 0
			ИЛИ СтрНайти(Текст, "сдача денежных средств в банк") > 0 ИЛИ СтрНайти(Текст, "получение наличных") > 0;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция СуммаКСроку(Позиции, ДатаДня)

	Сумма = 0;
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) И НачалоДня(Поз.Срок) = ДатаДня Тогда
			Сумма = Сумма + Поз.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

#КонецОбласти

#Область Долги

&НаСервере
Функция ПолучитьДолги(ИмяРегистра, ЗапасноеИмя, П)

	Рег = ИмяРегистра;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Рег = ЗапасноеИмя;
	КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистров " + ИмяРегистра + " и " + ЗапасноеИмя;
	КонецЕсли;

	Поля = Новый Массив;
	Группировки = Новый Массив;
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаПоПартнерам") <> "" Тогда
		Поля.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер) КАК Контрагент");
		Группировки.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер)");
	Иначе
		ИзмКонтрагент = ИзмерениеРегистра(Рег, "Контрагент,Партнер");
		Поля.Добавить(?(ИзмКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмКонтрагент) + " КАК Контрагент");
		Если ИзмКонтрагент <> "" Тогда
			Группировки.Добавить("Т." + ИзмКонтрагент);
		КонецЕсли;
	КонецЕсли;
	ИзмДокумент = ИзмерениеРегистра(Рег, "ОбъектРасчетов,ДокументРасчетов,РасчетныйДокумент,ЗаказКлиента,Заказ,ДокументРегистратор");
	Поля.Добавить(?(ИзмДокумент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмДокумент) + " КАК Документ");
	Если ИзмДокумент <> "" Тогда
		Группировки.Добавить("Т." + ИзмДокумент);
	КонецЕсли;
	ИзмСрок = ИзмерениеРегистра(Рег, "ДатаПлановогоПогашения,ДатаПлатежа,СрокОплаты,ДатаПогашения");
	Поля.Добавить(?(ИзмСрок = "", "ДАТАВРЕМЯ(1, 1, 1)", "Т." + ИзмСрок) + " КАК Срок");
	Если ИзмСрок <> "" Тогда
		Группировки.Добавить("Т." + ИзмСрок);
	КонецЕсли;
	Ресурс = РесурсРегистра(Рег, "ДолгРегл,Долг,ДолгУпр,СуммаРегл,Сумма");
	Если Ресурс = "" Тогда
		ВызватьИсключение "в регистре " + Рег + " не найден ресурс суммы долга";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(Поля, ",
		|	") + ",
		|	СУММА(Т." + Ресурс + "Остаток) КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница" + ?(Условие = "", "", ", " + Условие) + ") КАК Т" + ?(Группировки.Количество() = 0, "", "
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(Группировки, ",
		|	")) + "
		|ИМЕЮЩИЕ
		|	СУММА(Т." + Ресурс + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Позиции = Запрос.Выполнить().Выгрузить();
	Позиции.Колонки.Добавить("Просрочка", ОписаниеЧисла());
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) Тогда
			Поз.Просрочка = Цел((П.День - НачалоДня(Поз.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;
	Позиции.Сортировать("Просрочка Убыв, Сумма Убыв");

	Корзины = Новый Массив;
	Для Каждого Опис Из ОписаниеКорзин() Цикл
		Корзины.Добавить(Новый Структура("Заголовок, Сумма", Опис.Заголовок, 0));
	КонецЦикла;
	Всего = 0;
	Просрочено = 0;
	ВБлижайшие = 0;
	ПоКонтрагентам = Новый ТаблицаЗначений;
	ПоКонтрагентам.Колонки.Добавить("Контрагент");
	ПоКонтрагентам.Колонки.Добавить("Долг", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Просрочено", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("МаксПросрочка", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Документов", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("БлижайшийСрок");
	Ближайшие = Позиции.СкопироватьКолонки();
	Для Каждого Поз Из Позиции Цикл
		Всего = Всего + Поз.Сумма;
		НовСтр = ПоКонтрагентам.Найти(Поз.Контрагент, "Контрагент");
		Если НовСтр = Неопределено Тогда
			НовСтр = ПоКонтрагентам.Добавить();
			НовСтр.Контрагент = Поз.Контрагент;
		КонецЕсли;
		НовСтр.Долг = НовСтр.Долг + Поз.Сумма;
		НовСтр.Документов = НовСтр.Документов + 1;
		Если Поз.Просрочка > 0 Тогда
			Просрочено = Просрочено + Поз.Сумма;
			НовСтр.Просрочено = НовСтр.Просрочено + Поз.Сумма;
			НовСтр.МаксПросрочка = Макс(НовСтр.МаксПросрочка, Поз.Просрочка);
		ИначеЕсли ЗначениеЗаполнено(Поз.Срок) Тогда
			Если НЕ ЗначениеЗаполнено(НовСтр.БлижайшийСрок) ИЛИ Поз.Срок < НовСтр.БлижайшийСрок Тогда
				НовСтр.БлижайшийСрок = Поз.Срок;
			КонецЕсли;
			Если -Поз.Просрочка <= П.Горизонт Тогда
				ВБлижайшие = ВБлижайшие + Поз.Сумма;
				ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Поз);
			КонецЕсли;
		КонецЕсли;
		Индекс = 0;
		Для Каждого Опис Из ОписаниеКорзин() Цикл
			Если Поз.Просрочка >= Опис.От И Поз.Просрочка <= Опис.До Тогда
				Корзины[Индекс].Сумма = Корзины[Индекс].Сумма + Поз.Сумма;
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	ПоКонтрагентам.Сортировать("Просрочено Убыв, Долг Убыв");
	Ближайшие.Сортировать("Срок");

	Р = Новый Структура;
	Р.Вставить("Регистр", Рег);
	Р.Вставить("ЕстьСроки", ИзмСрок <> "");
	Р.Вставить("Позиции", Позиции);
	Р.Вставить("Всего", Всего);
	Р.Вставить("Просрочено", Просрочено);
	Р.Вставить("ВБлижайшие", ВБлижайшие);
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Корзины", Корзины);
	Р.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	Возврат Р;

КонецФункции

&НаСервере
Функция ОписаниеКорзин()

	Корзины = Новый Массив;
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Срок не наступил", -100000, 0));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "1–30 дней", 1, 30));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "31–60 дней", 31, 60));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "61–90 дней", 61, 90));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Более 90 дней", 91, 100000));
	Возврат Корзины;

КонецФункции

#КонецОбласти

#Область Выпуск

&НаСервере
Функция ДокументыПроизводства(ВключаяПередачу = Ложь)

	Кандидаты = "ЭтапПроизводства2_2,ВыпускПродукции,ПроизводствоБезЗаказа";
	Если ВключаяПередачу Тогда
		Кандидаты = Кандидаты + ",ПередачаМатериаловВПроизводство";
	КонецЕсли;
	Найдено = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Кандидаты, ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Найдено.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

&НаСервере
Функция УсловиеРегистратора(Документы)

	Части = Новый Массив;
	Для Каждого Имя Из Документы Цикл
		Части.Добавить("Т.Регистратор ССЫЛКА Документ." + Имя);
	КонецЦикла;
	Возврат "(" + СтрСоединить(Части, " ИЛИ ") + ")";

КонецФункции

&НаСервере
Функция ПолучитьВыпуск(П)

	Документы = ДокументыПроизводства();
	Если Документы.Количество() = 0 Тогда
		ВызватьИсключение "не найдены документы выпуска (ЭтапПроизводства2_2, ВыпускПродукции)";
	КонецЕсли;
	Ресурс = РесурсРегистра("ТоварыНаСкладах", "ВНаличии,Количество");
	Начало = Мин(П.НачалоМесяца, П.Начало14);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК День,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + Ресурс + ") КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК Т
		|ГДЕ
		|	Т.Период МЕЖДУ &Начало И &КонецДня
		|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И Т.Активность
		|	И " + УсловиеРегистратора(Документы) + "
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ),
		|	Т.Номенклатура";
		УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Начало", Начало);
	Строки = Запрос.Выполнить().Выгрузить();

	ПоДням = Новый Соответствие;
	ПоПродуктам = Новый ТаблицаЗначений;
	ПоПродуктам.Колонки.Добавить("Номенклатура");
	ПоПродуктам.Колонки.Добавить("Ед");
	ПоПродуктам.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ЗаМесяц", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("За7Дней", ОписаниеЧисла());
	ЗаДень = 0;
	ЗаМесяц = 0;
	Для Каждого Стр Из Строки Цикл
		ПоДням.Вставить(Стр.День, ?(ПоДням[Стр.День] = Неопределено, 0, ПоДням[Стр.День]) + Стр.Количество);
		НовСтр = ПоПродуктам.Найти(Стр.Номенклатура, "Номенклатура");
		Если НовСтр = Неопределено Тогда
			НовСтр = ПоПродуктам.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			НовСтр.Ед = ЕдиницаНоменклатуры(Стр.Номенклатура);
		КонецЕсли;
		Если Стр.День = П.День Тогда
			НовСтр.ЗаДень = НовСтр.ЗаДень + Стр.Количество;
			ЗаДень = ЗаДень + Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.НачалоМесяца Тогда
			НовСтр.ЗаМесяц = НовСтр.ЗаМесяц + Стр.Количество;
			ЗаМесяц = ЗаМесяц + Стр.Количество;
		КонецЕсли;
		Если Стр.День > П.День - 7 * 86400 Тогда
			НовСтр.За7Дней = НовСтр.За7Дней + Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	ПоПродуктам.Сортировать("ЗаМесяц Убыв");

	История = Новый ТаблицаЗначений;
	История.Колонки.Добавить("Дата");
	История.Колонки.Добавить("Количество", ОписаниеЧисла());
	Сумма7 = 0;
	Для Д = 0 По 13 Цикл
		ДатаДня = П.Начало14 + Д * 86400;
		НовСтр = История.Добавить();
		НовСтр.Дата = ДатаДня;
		НовСтр.Количество = ?(ПоДням[ДатаДня] = Неопределено, 0, ПоДням[ДатаДня]);
		Если Д >= 7 Тогда
			Сумма7 = Сумма7 + НовСтр.Количество;
		КонецЕсли;
	КонецЦикла;

	ДнейВМесяце = День(КонецМесяца(П.День));
	ДнейПрошло = День(П.День);
	Р = Новый Структура;
	Р.Вставить("ПоПродуктам", ПоПродуктам);
	Р.Вставить("История", История);
	Р.Вставить("ЗаДень", ЗаДень);
	Р.Вставить("ЗаМесяц", ЗаМесяц);
	Р.Вставить("ВСутки", Сумма7 / 7);
	Р.Вставить("План", П.ПланВСутки);
	Р.Вставить("ПланМесяца", П.ПланВСутки * ДнейВМесяце);
	Р.Вставить("ПланНаСегодня", П.ПланВСутки * ДнейПрошло);
	Р.Вставить("Прогноз", ЗаМесяц + Сумма7 / 7 * (ДнейВМесяце - ДнейПрошло));
	Р.Вставить("ОсталосьДней", ДнейВМесяце - ДнейПрошло);
	Возврат Р;

КонецФункции

#КонецОбласти

#Область Заказы

&НаСервере
Функция ПолучитьЗаказы(П, Выпуск)

	Рег = "ЗаказыКлиентов";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистра ЗаказыКлиентов";
	КонецЕсли;
	ИзмЗаказ = ИзмерениеРегистра(Рег, "ЗаказКлиента,Распоряжение,Заказ");
	РесКоличество = РесурсРегистра(Рег, "КОформлению,КОтгрузке,Заказано");
	РесСумма = РесурсРегистра(Рег, "Сумма,СуммаРегл");
	Если ИзмЗаказ = "" ИЛИ РесКоличество = "" Тогда
		ВызватьИсключение "в регистре ЗаказыКлиентов не найдены поля заказа и количества";
	КонецЕсли;
	Условие = "";
	Если ЗначениеЗаполнено(П.Организация) Тогда
		Условие = ИзмЗаказ + ".Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т." + ИзмЗаказ + " КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + РесКоличество + "Остаток) КАК Осталось,
		|	" + ?(РесСумма = "", "0", "СУММА(Т." + РесСумма + "Остаток)") + " КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т." + ИзмЗаказ + ",
		|	Т.Номенклатура
		|ИМЕЮЩИЕ
		|	СУММА(Т." + РесКоличество + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Открытые = Запрос.Выполнить().Выгрузить();
	Открытые.Колонки.Добавить("Номер");
	Открытые.Колонки.Добавить("Клиент");
	Открытые.Колонки.Добавить("Срок");
	Открытые.Колонки.Добавить("Ед");
	Открытые.Колонки.Добавить("СоСклада", ОписаниеЧисла());
	Открытые.Колонки.Добавить("Покрытие");
	Открытые.Колонки.Добавить("Просрочка", ОписаниеЧисла());

	Кэш = Новый Соответствие;
	Для Каждого Стр Из Открытые Цикл
		Данные = Кэш[Стр.Заказ];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Номер, Клиент, Срок, Цены", "", "", Неопределено, Неопределено);
			Попытка
				Данные.Номер = Стр.Заказ.Номер;
			Исключение
				Данные.Номер = Строка(Стр.Заказ);
			КонецПопытки;
			Данные.Клиент = РеквизитСсылки(Стр.Заказ, "Контрагент,Партнер");
			Данные.Срок = РеквизитСсылки(Стр.Заказ, "ДатаОтгрузки,ЖелаемаяДатаОтгрузки,ДатаПоступления");
			Кэш.Вставить(Стр.Заказ, Данные);
		КонецЕсли;
		Стр.Номер = Данные.Номер;
		Стр.Клиент = Данные.Клиент;
		Стр.Срок = Данные.Срок;
		Стр.Ед = ЕдиницаНоменклатуры(Стр.Номенклатура);
		Если РесСумма = "" Тогда
			Стр.Сумма = Стр.Осталось * ЦенаВЗаказе(Стр.Заказ, Стр.Номенклатура);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Срок) Тогда
			Стр.Просрочка = Цел((П.День - НачалоДня(Стр.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;

	// склад готовой продукции по заказам в порядке сроков, остальное — из выпуска
	Склад = ОстаткиНаСкладах(Открытые.ВыгрузитьКолонку("Номенклатура"), П);
	Темп = Новый Соответствие;
	Если Выпуск <> Неопределено Тогда
		Для Каждого Стр Из Выпуск.ПоПродуктам Цикл
			Темп.Вставить(Стр.Номенклатура, Стр.За7Дней / 7);
		КонецЦикла;
	КонецЕсли;
	Открытые.Колонки.Добавить("Порядок");
	Для Каждого Стр Из Открытые Цикл
		Стр.Порядок = ?(ЗначениеЗаполнено(Стр.Срок), Стр.Срок, '39991231');
	КонецЦикла;
	Открытые.Сортировать("Порядок");
	Зарезервировано = Новый Соответствие;
	Для Каждого Стр Из Открытые Цикл
		ЕстьНаСкладе = ?(Склад[Стр.Номенклатура] = Неопределено, 0, Склад[Стр.Номенклатура]);
		Стр.СоСклада = Мин(ЕстьНаСкладе, Стр.Осталось);
		Склад.Вставить(Стр.Номенклатура, ЕстьНаСкладе - Стр.СоСклада);
		Нужно = Стр.Осталось - Стр.СоСклада;
		Если НЕ ЗначениеЗаполнено(Стр.Срок) Тогда
			Стр.Покрытие = "без срока";
		ИначеЕсли Нужно <= 0 Тогда
			Стр.Покрытие = ?(Стр.Просрочка > 0, "просрочен, есть на складе", "есть на складе");
		ИначеЕсли Стр.Просрочка > 0 Тогда
			Стр.Покрытие = "просрочен";
		Иначе
			Дней = Цел((НачалоДня(Стр.Срок) - П.День) / 86400);
			Уже = ?(Зарезервировано[Стр.Номенклатура] = Неопределено, 0, Зарезервировано[Стр.Номенклатура]);
			ВСутки = ?(Темп[Стр.Номенклатура] = Неопределено, 0, Темп[Стр.Номенклатура]);
			Стр.Покрытие = ?(ВСутки * Дней - Уже >= Нужно, "успеваем выпустить", "не успеваем");
			Зарезервировано.Вставить(Стр.Номенклатура, Уже + Нужно);
		КонецЕсли;
	КонецЦикла;

	// портфель по продуктам
	Продукты = Открытые.Скопировать(, "Номенклатура, Ед, Осталось, Сумма, СоСклада");
	Продукты.Колонки.Добавить("Заказов", ОписаниеЧисла());
	Продукты.ЗаполнитьЗначения(1, "Заказов");
	Продукты.Свернуть("Номенклатура, Ед", "Осталось, Сумма, СоСклада, Заказов");
	Продукты.Колонки.Добавить("Выпустить", ОписаниеЧисла());
	Продукты.Колонки.Добавить("ВСутки", ОписаниеЧисла());
	Продукты.Колонки.Добавить("Загрузка");
	Для Каждого Стр Из Продукты Цикл
		Стр.Выпустить = Стр.Осталось - Стр.СоСклада;
		Стр.ВСутки = ?(Темп[Стр.Номенклатура] = Неопределено, 0, Темп[Стр.Номенклатура]);
		Стр.Загрузка = ?(Стр.ВСутки > 0, Стр.Выпустить / Стр.ВСутки, Неопределено);
	КонецЦикла;
	Продукты.Сортировать("Сумма Убыв");

	Р = Новый Структура;
	Р.Вставить("Открытые", Открытые);
	Р.Вставить("Продукты", Продукты);
	Р.Вставить("Портфель", Открытые.Итог("Сумма"));
	Р.Вставить("Заказов", Открытые.Скопировать(, "Заказ").Количество());
	Свернутые = Открытые.Скопировать(, "Заказ");
	Свернутые.Свернуть("Заказ");
	Р.Заказов = Свернутые.Количество();
	Р.Вставить("Просроченные", ОтобратьСтроки(Открытые, "просроч"));
	Р.Вставить("НеУспеваем", ОтобратьСтроки(Открытые, "не успеваем"));
	Ближайшие = Открытые.СкопироватьКолонки();
	Для Каждого Стр Из Открытые Цикл
		Если ЗначениеЗаполнено(Стр.Срок) И Стр.Просрочка <= 0 И -Стр.Просрочка <= П.Горизонт Тогда
			ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Новые", НовыеЗаказы(П));
	Р.Вставить("Отгрузки", ОтгрузкиЗаМесяц(П));
	Возврат Р;

КонецФункции

&НаСервере
Функция ОтобратьСтроки(Таблица, Подстрока)

	Результат = Таблица.СкопироватьКолонки();
	Для Каждого Стр Из Таблица Цикл
		Если СтрНайти(Стр.Покрытие, Подстрока) = 1 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЦенаВЗаказе(Заказ, Номенклатура)

	Попытка
		Для Каждого Стр Из Заказ.Товары Цикл
			Если Стр.Номенклатура = Номенклатура И Стр.Количество <> 0 Тогда
				Возврат Стр.Сумма / Стр.Количество;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// у заказа нет табличной части Товары
	КонецПопытки;
	Возврат 0;

КонецФункции

&НаСервере
Функция ОстаткиНаСкладах(СписокНоменклатуры, П)

	Ресурс = РесурсРегистра("ТоварыНаСкладах", "ВНаличии,Количество");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + Ресурс + "Остаток) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, Номенклатура В (&Список)) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Список", СписокНоменклатуры);
	Остатки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;
	Возврат Остатки;

КонецФункции

&НаСервере
Функция НовыеЗаказы(П)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("Клиент");
	Таблица.Колонки.Добавить("Срок");
	Таблица.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ЗаДень", Новый ОписаниеТипов("Булево"));
	Если Метаданные.Документы.Найти("ЗаказКлиента") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Документ,
		|	Д.Дата КАК Дата
		|ИЗ
		|	Документ.ЗаказКлиента КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И Д.Дата МЕЖДУ &НачалоМесяца И &КонецДня" + ?(ЗначениеЗаполнено(П.Организация), "
		|	И Д.Организация = &Организация", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Д.Дата";
	УстановитьПараметры(Запрос, П);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Документ = Выборка.Документ;
		НовСтр.ЗаДень = НачалоДня(Выборка.Дата) = П.День;
		НовСтр.Сумма = ЧислоИлиНоль(РеквизитСсылки(Выборка.Документ, "СуммаДокумента"));
		Если НовСтр.ЗаДень Тогда
			НовСтр.Номер = Выборка.Документ.Номер;
			НовСтр.Клиент = РеквизитСсылки(Выборка.Документ, "Контрагент,Партнер");
			НовСтр.Срок = РеквизитСсылки(Выборка.Документ, "ДатаОтгрузки,ЖелаемаяДатаОтгрузки");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

&НаСервере
Функция ОтгрузкиЗаМесяц(П)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("Клиент");
	Таблица.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ЗаДень", Новый ОписаниеТипов("Булево"));
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Документ,
		|	Д.Дата КАК Дата,
		|	Д.Номер КАК Номер,
		|	Д.СуммаДокумента КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И Д.Дата МЕЖДУ &НачалоМесяца И &КонецДня" + ?(ЗначениеЗаполнено(П.Организация), "
		|	И Д.Организация = &Организация", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Д.Дата";
	УстановитьПараметры(Запрос, П);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтр = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
		НовСтр.ЗаДень = НачалоДня(Выборка.Дата) = П.День;
		Если НовСтр.ЗаДень Тогда
			НовСтр.Клиент = РеквизитСсылки(Выборка.Документ, "Контрагент,Партнер");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область Сырье

&НаСервере
Функция ПолучитьСырье(П)

	Ресурс = РесурсРегистра("ТоварыНаСкладах", "ВНаличии,Количество");
	Документы = ДокументыПроизводства(Истина);
	Если Документы.Количество() = 0 Тогда
		ВызватьИсключение "не найдены документы списания в производство";
	КонецЕсли;
	ОтборГруппы = ?(ЗначениеЗаполнено(П.ГруппаСырья), "
		|	И Т.Номенклатура В ИЕРАРХИИ (&ГруппаСырья)", "");

	// расход в производство за 30 дней: по нему находим сырьё (если группа не задана)
	// и считаем средний суточный расход за последние 14 дней
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(ВЫБОР КОГДА Т.Период >= &Начало14 ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Расход14
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК Т
		|ГДЕ
		|	Т.Период МЕЖДУ &Начало30 И &КонецДня
		|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И Т.Активность
		|	И " + УсловиеРегистратора(Документы) + ОтборГруппы + "
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Начало30", П.День - 29 * 86400);
	Расходы = Запрос.Выполнить().Выгрузить();

	Материалы = Расходы.ВыгрузитьКолонку("Номенклатура");
	Если ЗначениеЗаполнено(П.ГруппаСырья) Тогда
		// в группе может быть сырьё, которое давно не расходовалось, но лежит на складе
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Т.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, Номенклатура В ИЕРАРХИИ (&ГруппаСырья)) КАК Т";
		Для Каждого Ном Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура") Цикл
			Если Материалы.Найти(Ном) = Неопределено Тогда
				Материалы.Добавить(Ном);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Остатки = ОстаткиНаСкладах(Материалы, П);
	ВПути = ПоставкиВПути(Материалы, П);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Ед");
	Таблица.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВСутки", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ХватитДней");
	Таблица.Колонки.Добавить("ХватитСПоставкой");
	Таблица.Колонки.Добавить("ВПути", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ДатаПоставки");
	Таблица.Колонки.Добавить("Статус");
	Таблица.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Пояснение");
	Таблица.Колонки.Добавить("Заказать", ОписаниеЧисла());

	Для Каждого Ном Из Материалы Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Номенклатура = Ном;
		НовСтр.Ед = ЕдиницаНоменклатуры(Ном);
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Ном]);
		Расход = Расходы.Найти(Ном, "Номенклатура");
		НовСтр.ВСутки = ?(Расход = Неопределено, 0, Расход.Расход14 / 14);
		Поставка = ВПути[Ном];
		Если Поставка <> Неопределено Тогда
			НовСтр.ВПути = Поставка.Количество;
			НовСтр.ДатаПоставки = Поставка.Дата;
		КонецЕсли;
		ОценитьМатериал(НовСтр, П);
	КонецЦикла;
	Таблица.Сортировать("Порядок, ХватитДней");

	Р = Новый Структура;
	Р.Вставить("Материалы", Таблица);
	Р.Вставить("Нехватка", Таблица.НайтиСтроки(Новый Структура("Статус", "нехватка")));
	Р.Вставить("Заказать", Таблица.НайтиСтроки(Новый Структура("Статус", "заказать")));
	Возврат Р;

КонецФункции

&НаСервере
Процедура ОценитьМатериал(НовСтр, П)

	НовСтр.Статус = "в норме";
	НовСтр.Порядок = 2;
	Если НовСтр.ВСутки <= 0 Тогда
		НовСтр.Пояснение = "За 14 дней в производство не списывался";
		НовСтр.Порядок = 3;
		Возврат;
	КонецЕсли;
	НовСтр.ХватитДней = НовСтр.Остаток / НовСтр.ВСутки;
	НовСтр.ХватитСПоставкой = (НовСтр.Остаток + НовСтр.ВПути) / НовСтр.ВСутки;
	Кончится = П.День + Цел(НовСтр.ХватитДней) * 86400;
	Если НовСтр.ВПути > 0 И ЗначениеЗаполнено(НовСтр.ДатаПоставки) И НачалоДня(НовСтр.ДатаПоставки) > Кончится Тогда
		Простой = Цел((НачалоДня(НовСтр.ДатаПоставки) - Кончится) / 86400);
		НовСтр.Статус = "нехватка";
		НовСтр.Пояснение = СтрШаблон("Закончится %1, поставка %2 — простой около %3 %4",
			Формат(Кончится, "ДФ=dd.MM"), Формат(НовСтр.ДатаПоставки, "ДФ=dd.MM"), Простой, Склонение(Простой, "дня", "дней", "дней"));
	ИначеЕсли НовСтр.ВПути = 0 И НовСтр.ХватитДней < П.СрокПоставки Тогда
		НовСтр.Статус = "нехватка";
		НовСтр.Пояснение = СтрШаблон("Хватит на %1 дн., а поставка идёт %2 дн. — заказать сегодня",
			Формат(НовСтр.ХватитДней, "ЧДЦ=1; ЧН=0"), П.СрокПоставки);
	ИначеЕсли НовСтр.ХватитСПоставкой < П.СрокПоставки + П.Резерв Тогда
		НовСтр.Статус = "заказать";
		НовСтр.Пояснение = "Запас меньше срока поставки с резервом";
	КонецЕсли;
	Если НовСтр.Статус <> "в норме" Тогда
		НовСтр.Порядок = ?(НовСтр.Статус = "нехватка", 0, 1);
		НовСтр.Заказать = Макс(0, НовСтр.ВСутки * (П.СрокПоставки + П.Горизонт) - НовСтр.Остаток - НовСтр.ВПути);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоставкиВПути(Материалы, П)

	Результат = Новый Соответствие;
	Рег = "ЗаказыПоставщикам";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ИзмЗаказ = ИзмерениеРегистра(Рег, "ЗаказПоставщику,Распоряжение,Заказ");
	РесКоличество = РесурсРегистра(Рег, "КПоступлению,КОформлению,Заказано");
	Если ИзмЗаказ = "" ИЛИ РесКоличество = "" Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т." + ИзмЗаказ + " КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + РесКоличество + "Остаток) КАК Количество
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница, Номенклатура В (&Список)) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т." + ИзмЗаказ + ",
		|	Т.Номенклатура
		|ИМЕЮЩИЕ
		|	СУММА(Т." + РесКоличество + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Список", Материалы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаДня = РеквизитСсылки(Выборка.Заказ, "ДатаПоступления,ЖелаемаяДатаПоступления");
		Было = Результат[Выборка.Номенклатура];
		Если Было = Неопределено Тогда
			Было = Новый Структура("Количество, Дата", 0, ДатаДня);
			Результат.Вставить(Выборка.Номенклатура, Было);
		ИначеЕсли ЗначениеЗаполнено(ДатаДня) И (НЕ ЗначениеЗаполнено(Было.Дата) ИЛИ ДатаДня < Было.Дата) Тогда
			Было.Дата = ДатаДня;
		КонецЕсли;
		Было.Количество = Было.Количество + Выборка.Количество;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Сигналы

&НаСервере
Функция НоваяТаблицаСигналов()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Уровень", ОписаниеЧисла()); // 0 критично, 1 внимание, 2 информация, 3 хорошо
	Т.Колонки.Добавить("Раздел");
	Т.Колонки.Добавить("Заголовок");
	Т.Колонки.Добавить("Текст");
	Возврат Т;

КонецФункции

&НаСервере
Процедура Сигнал(Р, Уровень, Раздел, Заголовок, Текст = "")

	НовСтр = Р.Сигналы.Добавить();
	НовСтр.Уровень = Уровень;
	НовСтр.Раздел = Раздел;
	НовСтр.Заголовок = Заголовок;
	НовСтр.Текст = Текст;

КонецПроцедуры

&НаСервере
Процедура СобратьСигналы(Р, П)

	Для Каждого Ошибка Из Р.Ошибки Цикл
		Сигнал(Р, 1, Ошибка.Ключ, "Раздел «" + Ошибка.Ключ + "» не сформирован", Ошибка.Значение);
	КонецЦикла;

	Д = Р.Деньги;
	Если Д <> Неопределено И Д.Минимум <> Неопределено Тогда
		Если Д.Минимум.Остаток < 0 Тогда
			Сигнал(Р, 0, "Деньги", "Кассовый разрыв " + Формат(Д.Минимум.Дата, "ДФ=dd.MM") + ": " + ДеньгиКратко(Д.Минимум.Остаток),
				"Если платить поставщикам по срокам и не получить просроченную дебиторку. Перенесите платежи или ускорьте поступления.");
		ИначеЕсли П.НеснижаемыйОстаток > 0 И Д.Минимум.Остаток < П.НеснижаемыйОстаток Тогда
			Сигнал(Р, 1, "Деньги", "Остаток опустится до " + ДеньгиКратко(Д.Минимум.Остаток) + " (" + Формат(Д.Минимум.Дата, "ДФ=dd.MM") + ")",
				"Это ниже неснижаемого остатка " + ДеньгиКратко(П.НеснижаемыйОстаток) + ".");
		КонецЕсли;
	КонецЕсли;

	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		Если Нам.Просрочено > 0 Тогда
			Доля = ?(Нам.Всего = 0, 0, Нам.Просрочено / Нам.Всего * 100);
			Первый = Нам.ПоКонтрагентам[0];
			Сигнал(Р, ?(Доля >= 30, 0, 1), "Долги", "Просроченная дебиторка " + ДеньгиКратко(Нам.Просрочено) + " — " + Формат(Доля, "ЧДЦ=0") + " % долга покупателей",
				СтрШаблон("Больше всех должен %1: %2, до %3 дн. просрочки.", Первый.Контрагент, ДеньгиКратко(Первый.Просрочено), Первый.МаксПросрочка));
		КонецЕсли;
		Старые = Нам.Корзины[3].Сумма + Нам.Корзины[4].Сумма;
		Если Старые > 0 Тогда
			Сигнал(Р, 1, "Долги", "Долги покупателей старше 60 дней: " + ДеньгиКратко(Старые),
				"Высокий риск невозврата: претензия, суд или резерв по сомнительным долгам.");
		КонецЕсли;
		Мы = Р.Долги.МыДолжны;
		Если Мы.Просрочено > 0 Тогда
			Имена = Новый Массив;
			Для Каждого Стр Из Мы.ПоКонтрагентам Цикл
				Если Стр.Просрочено > 0 И Имена.Количество() < 3 Тогда
					Имена.Добавить(Строка(Стр.Контрагент));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Долги", "Мы просрочили оплату поставщикам на " + ДеньгиКратко(Мы.Просрочено), СтрСоединить(Имена, ", "));
		КонецЕсли;
	КонецЕсли;

	С = Р.Сырье;
	Если С <> Неопределено Тогда
		Для Каждого Стр Из С.Нехватка Цикл
			Сигнал(Р, 0, "Сырьё", Строка(Стр.Номенклатура) + ": " + Стр.Пояснение,
				СтрШаблон("Остаток %1 %3, расход %2 %3 в сутки.", ФорматЧисла(Стр.Остаток), ФорматЧисла(Стр.ВСутки), Стр.Ед));
		КонецЦикла;
		Для Каждого Стр Из С.Заказать Цикл
			Сигнал(Р, 1, "Сырьё", Строка(Стр.Номенклатура) + ": пора заказывать",
				СтрШаблон("Хватит на %1 дн. вместе с поставкой. Заказать %2 %3.", Формат(Стр.ХватитСПоставкой, "ЧДЦ=1; ЧН=0"), ФорматЧисла(Стр.Заказать), Стр.Ед));
		КонецЦикла;
	КонецЕсли;

	З = Р.Заказы;
	Если З <> Неопределено Тогда
		Если З.Просроченные.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из З.Просроченные Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 %2 — %3 дн.", Стр.Номер, Стр.Клиент, Стр.Просрочка));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 0, "Заказы", "Сорван срок отгрузки: " + З.Просроченные.Количество() + " "
				+ Склонение(З.Просроченные.Количество(), "позиция", "позиции", "позиций") + " заказов", СтрСоединить(Части, "; "));
		КонецЕсли;
		Если З.НеУспеваем.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из З.НеУспеваем Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 %2 %3 %4 до %5", Стр.Номер, Стр.Номенклатура, ФорматЧисла(Стр.Осталось), Стр.Ед, Формат(Стр.Срок, "ДФ=dd.MM")));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Заказы", "Не успеваем выпустить к сроку: " + З.НеУспеваем.Количество() + " "
				+ Склонение(З.НеУспеваем.Количество(), "позиция", "позиции", "позиций"), СтрСоединить(Части, "; "));
		КонецЕсли;
	КонецЕсли;

	В = Р.Выпуск;
	Если В <> Неопределено И В.План > 0 Тогда
		Процент = В.ЗаДень / В.План * 100;
		Если Процент < 90 Тогда
			Сигнал(Р, ?(Процент < 75, 0, 1), "Выпуск", СтрШаблон("Выпуск за сутки %1 %% плана: %2 из %3", Формат(Процент, "ЧДЦ=0; ЧН=0"), ФорматЧисла(В.ЗаДень), ФорматЧисла(В.План)));
		ИначеЕсли Процент >= 100 Тогда
			Сигнал(Р, 3, "Выпуск", СтрШаблон("План суток выполнен: %1 %%", Формат(Процент, "ЧДЦ=0")));
		КонецЕсли;
		Если В.ПланМесяца > 0 И В.Прогноз < В.ПланМесяца * 0.97 Тогда
			Нужно = ?(В.ОсталосьДней > 0, (В.ПланМесяца - В.ЗаМесяц) / В.ОсталосьДней, 0);
			Сигнал(Р, 1, "Выпуск", СтрШаблон("Прогноз месяца %1 %% плана: %2 из %3", Формат(В.Прогноз / В.ПланМесяца * 100, "ЧДЦ=0"), ФорматЧисла(В.Прогноз), ФорматЧисла(В.ПланМесяца)),
				СтрШаблон("Чтобы выполнить план, нужно %1 в сутки при текущих %2.", ФорматЧисла(Нужно), ФорматЧисла(В.ВСутки)));
		КонецЕсли;
	КонецЕсли;

	Если Д <> Неопределено Тогда
		Для Каждого Стр Из Д.Платежи Цикл
			Если Стр.Сумма >= П.КрупныйПлатеж И П.КрупныйПлатеж > 0 Тогда
				Если Стр.Вид = "приход" Тогда
					Сигнал(Р, 3, "Деньги", "Поступило " + ДеньгиКратко(Стр.Сумма) + " от " + Строка(Стр.Контрагент), Строка(Стр.Назначение));
				Иначе
					Сигнал(Р, 2, "Деньги", "Оплачено " + ДеньгиКратко(Стр.Сумма) + ": " + Строка(Стр.Контрагент), Строка(Стр.Назначение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Р.Сигналы.Сортировать("Уровень");

КонецПроцедуры

#КонецОбласти

#Область ВыводВТабличныйДокумент

// Сетка: колонка 1 — названия (широкая), колонки 2–8 — числа.

&НаСервере
Функция Вывести(Р, П)

	В = Новый Структура("ТД, Строка", Новый ТабличныйДокумент, 1);
	ТД = В.ТД;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.АвтоМасштаб = Истина;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТД.ПолеСлева = 10;
	ТД.ПолеСправа = 10;
	ТД.Область("C1").ШиринаКолонки = 36;
	Для К = 2 По 8 Цикл
		ТД.Область("C" + Формат(К, "ЧГ=0")).ШиринаКолонки = 15;
	КонецЦикла;

	Организация = ?(ЗначениеЗаполнено(П.Организация), Строка(П.Организация), "Все организации");
	Ячейка(В, 1, Организация, , ЦветПриглушенный(), , 9, 8);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Отчёт руководителю за " + Формат(П.День, "ДЛФ=DD") + ", " + НРег(Формат(П.День, "ДФ=dddd")), Истина, , , 16, 8);
	ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 26;
	СледующаяСтрока(В);
	Ячейка(В, 1, "Сформирован " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'") + ", " + Строка(Пользователи.ТекущийПользователь()), , ЦветПриглушенный(), , 9, 8);
	Черта(В, 1, 8, 2);
	СледующаяСтрока(В, 2);

	ВывестиГлавное(В, Р, П);
	ВывестиДеньги(В, Р, П);
	ВывестиДолги(В, Р, П);
	ВывестиЗаказы(В, Р, П);
	ВывестиВыпуск(В, Р, П);
	ВывестиСырье(В, Р, П);

	СледующаяСтрока(В);
	Ячейка(В, 1, "Суммы в рублях регламентированного учёта по данным оперативного учёта ERP. Выпуск — приход на склад документами производства; "
		+ "расход сырья — списание со складов в производство. Прогноз денег — по срокам оплат из графиков расчётов.", , ЦветПриглушенный(), , 8, 8, Истина);
	ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
	Возврат ТД;

КонецФункции

&НаСервере
Процедура ВывестиГлавное(В, Р, П)

	ЗаголовокРаздела(В, "Главное");
	Шапка(В, "Показатель", "Значение", "", "Комментарий");
	Д = Р.Деньги;
	Если Д <> Неопределено Тогда
		Изменение = Д.Итого - Д.ИтогоВчера;
		Уровень = -1;
		Если Д.Минимум <> Неопределено И Д.Минимум.Остаток < 0 Тогда
			Уровень = 0;
		ИначеЕсли Д.Минимум <> Неопределено И П.НеснижаемыйОстаток > 0 И Д.Минимум.Остаток < П.НеснижаемыйОстаток Тогда
			Уровень = 1;
		КонецЕсли;
		СтрокаГлавного(В, "Деньги на счетах и в кассе", ДеньгиКратко(Д.Итого), Уровень,
			"за день " + ?(Изменение > 0, "+", "") + ДеньгиКратко(Изменение));
	КонецЕсли;
	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		СтрокаГлавного(В, "Нам должны покупатели", ДеньгиКратко(Нам.Всего),
			?(Нам.Просрочено = 0, -1, ?(Нам.Всего > 0 И Нам.Просрочено / Нам.Всего >= 0.3, 0, 1)), "просрочено " + ДеньгиКратко(Нам.Просрочено));
		Мы = Р.Долги.МыДолжны;
		СтрокаГлавного(В, "Мы должны поставщикам", ДеньгиКратко(Мы.Всего), ?(Мы.Просрочено = 0, -1, 1), "просрочено " + ДеньгиКратко(Мы.Просрочено));
	КонецЕсли;
	З = Р.Заказы;
	Если З <> Неопределено Тогда
		СтрокаГлавного(В, "Портфель заказов к отгрузке", ДеньгиКратко(З.Портфель),
			?(З.Просроченные.Количество() > 0, 0, ?(З.НеУспеваем.Количество() > 0, 1, -1)),
			СтрШаблон("%1 %2, просроченных позиций %3", З.Заказов, Склонение(З.Заказов, "заказ", "заказа", "заказов"), З.Просроченные.Количество()));
	КонецЕсли;
	Вып = Р.Выпуск;
	Если Вып <> Неопределено Тогда
		Если Вып.План > 0 Тогда
			Процент = Вып.ЗаДень / Вып.План * 100;
			СтрокаГлавного(В, "Выпуск за сутки", ФорматЧисла(Вып.ЗаДень), ?(Процент >= 100, 3, ?(Процент >= 90, -1, ?(Процент >= 75, 1, 0))),
				Формат(Процент, "ЧДЦ=0; ЧН=0") + " % плана; с начала месяца " + ФорматЧисла(Вып.ЗаМесяц) + " (" + Формат(Вып.ЗаМесяц / Вып.ПланНаСегодня * 100, "ЧДЦ=0; ЧН=0") + " %)");
		Иначе
			СтрокаГлавного(В, "Выпуск за сутки", ФорматЧисла(Вып.ЗаДень), -1, "с начала месяца " + ФорматЧисла(Вып.ЗаМесяц) + "; план в настройках не задан");
		КонецЕсли;
	КонецЕсли;
	С = Р.Сырье;
	Если С <> Неопределено Тогда
		СтрокаГлавного(В, "Сырьё: нехватка / пора заказывать", Формат(С.Нехватка.Количество(), "ЧН=0") + " / " + Формат(С.Заказать.Количество(), "ЧН=0"),
			?(С.Нехватка.Количество() > 0, 0, ?(С.Заказать.Количество() > 0, 1, 3)), "позиций из " + Формат(С.Материалы.Количество(), "ЧН=0"));
	КонецЕсли;

	СледующаяСтрока(В);
	Крит = Р.Сигналы.НайтиСтроки(Новый Структура("Уровень", 0)).Количество();
	Вним = Р.Сигналы.НайтиСтроки(Новый Структура("Уровень", 1)).Количество();
	Ячейка(В, 1, СтрШаблон("Что требует решения: критично — %1, внимание — %2", Крит, Вним), Истина, , , 11, 8);
	СледующаяСтрока(В);
	Если Р.Сигналы.Количество() = 0 Тогда
		Ячейка(В, 1, "Все показатели в норме.", , ЦветПриглушенный(), , , 8);
		СледующаяСтрока(В);
	КонецЕсли;
	Значки = СтрРазделить("‼,!,i,✓", ",");
	Для Каждого Сиг Из Р.Сигналы Цикл
		Фон = ?(Сиг.Уровень = 0, ФонКрит(), ?(Сиг.Уровень = 1, ФонВнимание(), ?(Сиг.Уровень = 3, ФонХорошо(), ЦветФонаШапки())));
		Цвет = ?(Сиг.Уровень = 0, ЦветКрит(), ?(Сиг.Уровень = 1, ЦветВнимание(), ?(Сиг.Уровень = 3, ЦветХорошо(), ЦветПриглушенный())));
		Ячейка(В, 1, Значки[Сиг.Уровень] + "  " + Сиг.Раздел, Истина, Цвет, Фон);
		Ячейка(В, 2, Сиг.Заголовок, Истина, , Фон, , 8, Истина);
		ПодогнатьВысоту(В, Сиг.Заголовок, 7 * 15);
		СледующаяСтрока(В);
		Если ЗначениеЗаполнено(Сиг.Текст) Тогда
			Ячейка(В, 1, "", , , Фон);
			Ячейка(В, 2, Сиг.Текст, , ЦветПриглушенный(), Фон, 9, 8, Истина);
			ПодогнатьВысоту(В, Сиг.Текст, 7 * 15);
			СледующаяСтрока(В);
		КонецЕсли;
		СледующаяСтрока(В, 0.25);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СтрокаГлавного(В, Название, Значение, Уровень, Комментарий)

	Цвет = ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ?(Уровень = 3, ЦветХорошо(), Неопределено)));
	Фон = ?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ?(Уровень = 3, ФонХорошо(), Неопределено)));
	Ячейка(В, 1, Название);
	Ячейка(В, 2, Значение, Истина, Цвет, Фон, 11, 3);
	ВПраво(В, 2, 3);
	Ячейка(В, 4, Комментарий, , ЦветПриглушенный(), , 9, 8);
	ЛинияСнизу(В, 1, 8);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ВывестиДеньги(В, Р, П)

	ЗаголовокРаздела(В, "Деньги");
	Если ПоказатьОшибку(В, Р, "Деньги") Тогда
		Возврат;
	КонецЕсли;
	Д = Р.Деньги;

	Подзаголовок(В, "Остатки на конец дня");
	Шапка(В, "Счёт / касса", "На " + Формат(П.День - 86400, "ДФ=dd.MM"), "На " + Формат(П.День, "ДФ=dd.MM"), "Изменение");
	Для Каждого Стр Из Д.Счета Цикл
		Ячейка(В, 1, Строка(Стр.Вид) + ": " + Строка(Стр.Счет));
		ЯчейкаЧисло(В, 2, Стр.Вчера);
		ЯчейкаЧисло(В, 3, Стр.Сегодня);
		ЯчейкаЧисло(В, 4, Стр.Сегодня - Стр.Вчера, ЦветИзменения(Стр.Сегодня - Стр.Вчера));
		ЛинияСнизу(В, 1, 4);
		СледующаяСтрока(В);
	КонецЦикла;
	СтрокаИтога(В, "Итого", Д.ИтогоВчера, Д.Итого, Д.Итого - Д.ИтогоВчера);

	СледующаяСтрока(В);
	Подзаголовок(В, "Движение денег");
	Шапка(В, "", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа");
	Ячейка(В, 1, "Поступило");
	ЯчейкаЧисло(В, 2, Д.Приход, ЦветХорошо());
	ЯчейкаЧисло(В, 3, Д.ПриходМесяц);
	ЛинияСнизу(В, 1, 3);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Оплачено");
	ЯчейкаЧисло(В, 2, Д.Расход, ЦветКрит());
	ЯчейкаЧисло(В, 3, Д.РасходМесяц);
	ЛинияСнизу(В, 1, 3);
	СледующаяСтрока(В);
	СтрокаИтога(В, "Сальдо", Д.Приход - Д.Расход, Д.ПриходМесяц - Д.РасходМесяц);
	Если Д.Перемещений > 0 Тогда
		Примечание(В, "Внутренние перемещения между своими счетами и кассой (" + Д.Перемещений + ") в приход и расход не включены.");
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Платежи за день");
	Если Д.Платежи.Количество() = 0 Тогда
		Примечание(В, "Движения по счетам и кассе за день нет.");
	Иначе
		Шапка(В, "Контрагент", "", "Статья", "", "Назначение", "", "", "Сумма");
		Для Каждого Стр Из Д.Платежи Цикл
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			Ячейка(В, 2, Стр.Вид, Истина, ?(Стр.Вид = "приход", ЦветХорошо(), ЦветПриглушенный()));
			Ячейка(В, 3, Строка(Стр.Статья), , , , 9, 4, Истина);
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.Назначение), Строка(Стр.Назначение), Строка(Стр.Документ)), , ЦветПриглушенный(), , 9, 7, Истина);
			ЯчейкаЧисло(В, 8, Стр.Сумма, ?(Стр.Вид = "приход", ЦветХорошо(), Неопределено));
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ПодогнатьВысоту(В, Строка(Стр.Назначение), 45);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;

	Если Д.Прогноз.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Прогноз остатка на " + П.Горизонт + " " + Склонение(П.Горизонт, "день", "дня", "дней") + " по срокам оплат");
		Шапка(В, "Дата", "Ждём от покупателей", "Платим поставщикам", "Остаток");
		Для Каждого Стр Из Д.Прогноз Цикл
			Уровень = ?(Стр.Остаток < 0, 0, ?(П.НеснижаемыйОстаток > 0 И Стр.Остаток < П.НеснижаемыйОстаток, 1, -1));
			Ячейка(В, 1, Формат(Стр.Дата, "ДФ='dd.MM, ddd'"));
			ЯчейкаЧисло(В, 2, Стр.Поступления);
			ЯчейкаЧисло(В, 3, Стр.Платежи);
			ЯчейкаЧисло(В, 4, Стр.Остаток, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), Неопределено)), Истина,
				?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), Неопределено)));
			ЛинияСнизу(В, 1, 4);
			СледующаяСтрока(В);
		КонецЦикла;
		Если Д.ПросроченоКОплате > 0 Тогда
			Примечание(В, "В первый день учтена оплата просроченной кредиторки " + ФорматДенег(Д.ПросроченоКОплате) + " руб.");
		КонецЕсли;
		Если Р.Долги <> Неопределено И Р.Долги.НамДолжны.Просрочено > 0 Тогда
			Примечание(В, "Просроченная дебиторка " + ФорматДенег(Р.Долги.НамДолжны.Просрочено) + " руб. в прогноз не включена: если её вернут, остаток будет выше.");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиДолги(В, Р, П)

	ЗаголовокРаздела(В, "Долги");
	Если ПоказатьОшибку(В, Р, "Долги") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вид Из СтрРазделить("НамДолжны,МыДолжны", ",") Цикл
		Д = Р.Долги[Вид];
		Подзаголовок(В, ?(Вид = "НамДолжны", "Нам должны покупатели", "Мы должны поставщикам"));
		Если Д.Позиции.Количество() = 0 Тогда
			Примечание(В, "Долгов нет.");
			СледующаяСтрока(В);
			Продолжить;
		КонецЕсли;
		Шапка(В, "", "Всего", "Просрочено", "Доля", "Срок в " + П.Горизонт + " дн.");
		Ячейка(В, 1, ?(Вид = "НамДолжны", "Долг покупателей", "Наш долг"));
		ЯчейкаЧисло(В, 2, Д.Всего, , Истина);
		ЯчейкаЧисло(В, 3, Д.Просрочено, ?(Д.Просрочено > 0, ЦветКрит(), Неопределено), Истина);
		Ячейка(В, 4, ?(Д.Всего = 0, "—", Формат(Д.Просрочено / Д.Всего * 100, "ЧДЦ=0; ЧН=0") + " %"));
		ВПраво(В, 4, 4);
		ЯчейкаЧисло(В, 5, Д.ВБлижайшие);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
		Если Д.ЕстьСроки Тогда
			Индекс = 0;
			Для Каждого Корзина Из Д.Корзины Цикл
				Если Корзина.Сумма <> 0 Тогда
					Ячейка(В, 1, "   " + Корзина.Заголовок, , ЦветПриглушенный());
					ЯчейкаЧисло(В, 2, Корзина.Сумма, ?(Индекс >= 3, ЦветКрит(), ?(Индекс >= 1, ЦветВнимание(), Неопределено)));
					Ячейка(В, 3, Формат(Корзина.Сумма / Д.Всего * 100, "ЧДЦ=0; ЧН=0") + " %", , ЦветПриглушенный());
					ВПраво(В, 3, 3);
					СледующаяСтрока(В);
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;
		Иначе
			Примечание(В, "В регистре " + Д.Регистр + " нет сроков оплаты, поэтому просрочка не считается.");
		КонецЕсли;

		СледующаяСтрока(В, 0.5);
		Шапка(В, ?(Вид = "НамДолжны", "Покупатель", "Поставщик"), "Долг", "Просрочено", "Дней просрочки", "Ближайший срок", "Документов");
		Номер = 0;
		Для Каждого Стр Из Д.ПоКонтрагентам Цикл
			Номер = Номер + 1;
			Если Номер > 15 Тогда
				Примечание(В, "…и ещё " + (Д.ПоКонтрагентам.Количество() - 15) + ", без просрочки или с меньшим долгом.");
				Прервать;
			КонецЕсли;
			Уровень = ?(Стр.МаксПросрочка > 60, 0, ?(Стр.МаксПросрочка > 0, 1, -1));
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			ЯчейкаЧисло(В, 2, Стр.Долг);
			ЯчейкаЧисло(В, 3, Стр.Просрочено, ?(Стр.Просрочено > 0, ЦветКрит(), Неопределено));
			Если Стр.МаксПросрочка > 0 Тогда
				Ячейка(В, 4, Формат(Стр.МаксПросрочка, "ЧГ=0") + " дн.", Истина, ?(Уровень = 0, ЦветКрит(), ЦветВнимание()), ?(Уровень = 0, ФонКрит(), ФонВнимание()));
			Иначе
				Ячейка(В, 4, "в срок", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 4, 4);
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.БлижайшийСрок), Формат(Стр.БлижайшийСрок, "ДФ=dd.MM.yy"), "—"));
			ВПраво(В, 5, 5);
			ЯчейкаЧисло(В, 6, Стр.Документов);
			РасшифровкаСтроки(В, Стр.Контрагент, 6);
			ЛинияСнизу(В, 1, 6);
			СледующаяСтрока(В);
		КонецЦикла;

		Если Д.Ближайшие.Количество() > 0 Тогда
			СледующаяСтрока(В, 0.5);
			Ячейка(В, 1, ?(Вид = "НамДолжны", "Ожидаемые поступления", "Платежи по срокам") + " в ближайшие " + П.Горизонт + " дн.: " + ФорматДенег(Д.ВБлижайшие) + " руб.", Истина, , , 9, 8);
			СледующаяСтрока(В);
			Для Каждого Стр Из Д.Ближайшие Цикл
				Ячейка(В, 1, Формат(Стр.Срок, "ДФ='dd.MM, ddd'") + "   " + Строка(Стр.Контрагент), , , , 9, 4);
				Ячейка(В, 5, Строка(Стр.Документ), , ЦветПриглушенный(), , 9, 7);
				ЯчейкаЧисло(В, 8, Стр.Сумма);
				ЛинияСнизу(В, 1, 8);
				СледующаяСтрока(В);
			КонецЦикла;
		КонецЕсли;
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиЗаказы(В, Р, П)

	ЗаголовокРаздела(В, "Заказы и отгрузки");
	Если ПоказатьОшибку(В, Р, "Заказы") Тогда
		Возврат;
	КонецЕсли;
	З = Р.Заказы;

	Новые = З.Новые.НайтиСтроки(Новый Структура("ЗаДень", Истина));
	Отгрузки = З.Отгрузки.НайтиСтроки(Новый Структура("ЗаДень", Истина));
	Шапка(В, "", "За " + Формат(П.День, "ДФ=dd.MM"), "", "С 1-го числа", "");
	Ячейка(В, 1, "Новые заказы, руб.");
	ЯчейкаЧисло(В, 2, СуммаСтрок(Новые));
	Ячейка(В, 3, Формат(Новые.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЯчейкаЧисло(В, 4, З.Новые.Итог("Сумма"));
	Ячейка(В, 5, Формат(З.Новые.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЛинияСнизу(В, 1, 5);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Отгружено, руб.");
	ЯчейкаЧисло(В, 2, СуммаСтрок(Отгрузки));
	Ячейка(В, 3, Формат(Отгрузки.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЯчейкаЧисло(В, 4, З.Отгрузки.Итог("Сумма"));
	Ячейка(В, 5, Формат(З.Отгрузки.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЛинияСнизу(В, 1, 5);
	СледующаяСтрока(В);

	СледующаяСтрока(В);
	Подзаголовок(В, "Портфель по продуктам");
	Шапка(В, "Продукт", "Заказов", "Осталось", "Сумма", "На складе", "Выпустить", "Выпуск в сутки", "Загрузка, сут.");
	Для Каждого Стр Из З.Продукты Цикл
		Ячейка(В, 1, Строка(Стр.Номенклатура), , , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Заказов);
		ЯчейкаКоличество(В, 3, Стр.Осталось, Стр.Ед);
		ЯчейкаЧисло(В, 4, Стр.Сумма);
		ЯчейкаКоличество(В, 5, Стр.СоСклада, Стр.Ед);
		ЯчейкаКоличество(В, 6, Стр.Выпустить, Стр.Ед);
		ЯчейкаКоличество(В, 7, Стр.ВСутки, Стр.Ед);
		Ячейка(В, 8, ?(Стр.Загрузка = Неопределено, ?(Стр.Выпустить > 0, "нет выпуска", "—"), Формат(Стр.Загрузка, "ЧДЦ=1; ЧН=0")));
		ВПраво(В, 8, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	СтрокаИтога(В, "Итого", , , З.Портфель);
	Примечание(В, "«На складе» — сколько из портфеля закрывается готовой продукцией. «Загрузка» — сколько суток работы при среднем выпуске последней недели нужно на остальное.");

	ВывестиСписокЗаказов(В, З.Просроченные, "Просроченные отгрузки");
	ВывестиСписокЗаказов(В, З.Ближайшие, "Отгрузить в ближайшие " + П.Горизонт + " дн.");

	Если Новые.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Новые заказы за день");
		Шапка(В, "Клиент", "", "", "Номер", "Срок отгрузки", "", "", "Сумма");
		Для Каждого Стр Из Новые Цикл
			Ячейка(В, 1, Строка(Стр.Клиент), , , , , 3, Истина);
			Ячейка(В, 4, Строка(Стр.Номер));
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.Срок), Формат(Стр.Срок, "ДФ=dd.MM.yy"), "—"));
			ЯчейкаЧисло(В, 8, Стр.Сумма);
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;
	Если Отгрузки.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Отгрузки за день");
		Шапка(В, "Клиент", "", "", "Номер", "", "", "", "Сумма");
		Для Каждого Стр Из Отгрузки Цикл
			Ячейка(В, 1, Строка(Стр.Клиент), , , , , 3, Истина);
			Ячейка(В, 4, Строка(Стр.Номер));
			ЯчейкаЧисло(В, 8, Стр.Сумма);
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиСписокЗаказов(В, Таблица, Название)

	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СледующаяСтрока(В);
	Подзаголовок(В, Название + " — " + Таблица.Количество() + " " + Склонение(Таблица.Количество(), "позиция", "позиции", "позиций"));
	Шапка(В, "Клиент / продукт", "Заказ", "Срок", "Осталось", "Со склада", "Статус", "", "Сумма");
	Для Каждого Стр Из Таблица Цикл
		Уровень = ?(СтрНайти(Стр.Покрытие, "просроч") > 0, 0, ?(Стр.Покрытие = "не успеваем", 1, 3));
		Ячейка(В, 1, Строка(Стр.Клиент) + Символы.ПС + Строка(Стр.Номенклатура), , , , 9, , Истина);
		Ячейка(В, 2, Строка(Стр.Номер));
		Ячейка(В, 3, ?(ЗначениеЗаполнено(Стр.Срок), Формат(Стр.Срок, "ДФ=dd.MM"), "—"));
		ЯчейкаКоличество(В, 4, Стр.Осталось, Стр.Ед);
		ЯчейкаКоличество(В, 5, Стр.СоСклада, Стр.Ед);
		Ячейка(В, 6, Стр.Покрытие + ?(Стр.Просрочка > 0, ", " + Стр.Просрочка + " дн.", ""), Истина,
			?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())), ?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())), 9, 7, Истина);
		ЯчейкаЧисло(В, 8, Стр.Сумма);
		РасшифровкаСтроки(В, Стр.Заказ, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиВыпуск(В, Р, П)

	ЗаголовокРаздела(В, "Выпуск продукции");
	Если ПоказатьОшибку(В, Р, "Выпуск") Тогда
		Возврат;
	КонецЕсли;
	Вып = Р.Выпуск;

	Шапка(В, "Продукт", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "За 7 дней", "В сутки");
	Для Каждого Стр Из Вып.ПоПродуктам Цикл
		Ячейка(В, 1, Строка(Стр.Номенклатура), , , , , , Истина);
		ЯчейкаКоличество(В, 2, Стр.ЗаДень, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ЗаМесяц, Стр.Ед);
		ЯчейкаКоличество(В, 4, Стр.За7Дней, Стр.Ед);
		ЯчейкаКоличество(В, 5, Стр.За7Дней / 7, Стр.Ед);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;
	СтрокаИтога(В, "Итого", Вып.ЗаДень, Вып.ЗаМесяц, , Вып.ВСутки);

	Если Вып.План > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "План и прогноз на месяц");
		Шапка(В, "", "План", "Факт", "%");
		СтрокаПлана(В, "За сутки", Вып.План, Вып.ЗаДень);
		СтрокаПлана(В, "С начала месяца", Вып.ПланНаСегодня, Вып.ЗаМесяц);
		СтрокаПлана(В, "Прогноз на месяц", Вып.ПланМесяца, Вып.Прогноз);
		Если Вып.ОсталосьДней > 0 Тогда
			Примечание(В, СтрШаблон("Чтобы выполнить план месяца, нужно %1 в сутки; сейчас %2 в сутки (среднее за 7 дней). Прогноз = факт + среднее × %3 оставшихся суток.",
				ФорматЧисла(Макс(0, Вып.ПланМесяца - Вып.ЗаМесяц) / Вып.ОсталосьДней), ФорматЧисла(Вып.ВСутки), Вып.ОсталосьДней));
		КонецЕсли;
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Последние 14 суток");
	Максимум = Макс(Вып.План, 1);
	Для Каждого Стр Из Вып.История Цикл
		Максимум = Макс(Максимум, Стр.Количество);
	КонецЦикла;
	Для Каждого Стр Из Вып.История Цикл
		Цвет = ЦветАкцент();
		Если Вып.План > 0 Тогда
			Цвет = ?(Стр.Количество >= Вып.План * 0.9, ЦветАкцент(), ?(Стр.Количество >= Вып.План * 0.75, ЦветВнимание(), ЦветКрит()));
		КонецЕсли;
		Ячейка(В, 1, Формат(Стр.Дата, "ДФ='dd.MM, ddd'"), Стр.Дата = П.День, ?(Стр.Дата = П.День, Неопределено, ЦветПриглушенный()), , 9);
		ЯчейкаЧисло(В, 2, Стр.Количество, , Стр.Дата = П.День);
		Полоса(В, 3, 8, Стр.Количество / Максимум, Цвет, ?(Вып.План > 0, Вып.План / Максимум, 0));
		СледующаяСтрока(В);
	КонецЦикла;
	Если Вып.План > 0 Тогда
		Примечание(В, "Полоса — выпуск за сутки; черта | — план. Зелёный — не меньше 90 % плана, жёлтый — 75–90 %, красный — меньше 75 %.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СтрокаПлана(В, Название, План, Факт)

	Процент = ?(План = 0, 0, Факт / План * 100);
	Ячейка(В, 1, Название);
	ЯчейкаЧисло(В, 2, План);
	ЯчейкаЧисло(В, 3, Факт);
	Ячейка(В, 4, Формат(Процент, "ЧДЦ=0; ЧН=0") + " %", Истина, ?(Процент >= 100, ЦветХорошо(), ?(Процент >= 90, ЦветВнимание(), ЦветКрит())));
	ВПраво(В, 4, 4);
	ЛинияСнизу(В, 1, 4);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ВывестиСырье(В, Р, П)

	ЗаголовокРаздела(В, "Сырьё и нехватка");
	Если ПоказатьОшибку(В, Р, "Сырье") Тогда
		Возврат;
	КонецЕсли;
	С = Р.Сырье;
	Если С.Материалы.Количество() = 0 Тогда
		Примечание(В, "Не найдено сырья: за 30 дней ничего не списывалось в производство. Укажите группу сырья в настройках отчёта.");
		Возврат;
	КонецЕсли;
	Шапка(В, "Материал", "Остаток", "Расход в сутки", "Хватит, дней", "В пути", "Поставка", "Статус", "Заказать");
	Для Каждого Стр Из С.Материалы Цикл
		Уровень = ?(Стр.Статус = "нехватка", 0, ?(Стр.Статус = "заказать", 1, 3));
		Ячейка(В, 1, Строка(Стр.Номенклатура) + ?(ЗначениеЗаполнено(Стр.Пояснение), Символы.ПС + Стр.Пояснение, ""), , , , 9, , Истина);
		ЯчейкаКоличество(В, 2, Стр.Остаток, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ВСутки, Стр.Ед);
		Ячейка(В, 4, ?(Стр.ХватитДней = Неопределено, "—", Формат(Стр.ХватитДней, "ЧДЦ=1; ЧН=0")
			+ ?(Стр.ВПути > 0, " (" + Формат(Стр.ХватитСПоставкой, "ЧДЦ=1; ЧН=0") + ")", "")));
		ВПраво(В, 4, 4);
		ЯчейкаКоличество(В, 5, Стр.ВПути, Стр.Ед);
		Ячейка(В, 6, ?(ЗначениеЗаполнено(Стр.ДатаПоставки), Формат(Стр.ДатаПоставки, "ДФ=dd.MM"), "—"));
		ВПраво(В, 6, 6);
		Ячейка(В, 7, Стр.Статус, Истина, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())),
			?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())));
		ЯчейкаКоличество(В, 8, Стр.Заказать, Стр.Ед);
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = ?(ЗначениеЗаполнено(Стр.Пояснение), 26, 14);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	Примечание(В, СтрШаблон("Расход — среднее списание в производство за 14 дней. «Хватит» в скобках — вместе с поставкой в пути (заказы поставщикам). "
		+ "Нехватка — кончится раньше поставки или запаса меньше срока поставки (%1 дн.). «Заказать» — на срок поставки плюс %2 дн.", П.СрокПоставки, П.Горизонт));

КонецПроцедуры

#КонецОбласти

#Область ПримитивыВывода

&НаСервере
Процедура СледующаяСтрока(В, Сколько = 1)

	Если Сколько < 1 Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 5;
		В.Строка = В.Строка + 1;
	Иначе
		В.Строка = В.Строка + Сколько;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Ячейка(В, Колонка, Значение, Жирный = Ложь, ЦветТекста = Неопределено, ЦветФона = Неопределено, Размер = 9, КолонкаПо = 0, Переносить = Ложь)

	Обл = В.ТД.Область(В.Строка, Колонка, В.Строка, Макс(Колонка, КолонкаПо));
	Если КолонкаПо > Колонка Тогда
		Обл.Объединить();
	КонецЕсли;
	Обл.Текст = Строка(Значение);
	Обл.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Если ЦветТекста <> Неопределено Тогда
		Обл.ЦветТекста = ЦветТекста;
	КонецЕсли;
	Если ЦветФона <> Неопределено Тогда
		Обл.ЦветФона = ЦветФона;
	КонецЕсли;
	Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Если Переносить Тогда
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Иначе
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЯчейкаЧисло(В, Колонка, Значение, ЦветТекста = Неопределено, Жирный = Ложь, ЦветФона = Неопределено)

	Ячейка(В, Колонка, ФорматДенег(Значение), Жирный, ЦветТекста, ЦветФона);
	ВПраво(В, Колонка, Колонка);

КонецПроцедуры

&НаСервере
Процедура ЯчейкаКоличество(В, Колонка, Значение, Ед)

	Если Значение = 0 Тогда
		Ячейка(В, Колонка, "—", , ЦветПриглушенный());
	Иначе
		Ячейка(В, Колонка, ФорматЧисла(Значение) + ?(ЗначениеЗаполнено(Ед), " " + Ед, ""));
	КонецЕсли;
	ВПраво(В, Колонка, Колонка);

КонецПроцедуры

&НаСервере
Процедура ВПраво(В, ОтКолонки, ДоКолонки)

	В.ТД.Область(В.Строка, ОтКолонки, В.Строка, ДоКолонки).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;

КонецПроцедуры

&НаСервере
Процедура ЗаголовокРаздела(В, Название)

	СледующаяСтрока(В);
	Ячейка(В, 1, Название, Истина, ЦветАкцент(), , 13, 8);
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 22;
	Черта(В, 1, 8, 2, ЦветАкцент());
	СледующаяСтрока(В);
	СледующаяСтрока(В, 0.5);

КонецПроцедуры

&НаСервере
Процедура Подзаголовок(В, Название)

	Ячейка(В, 1, Название, Истина, , , 10, 8);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура Шапка(В, К1, К2 = "", К3 = "", К4 = "", К5 = "", К6 = "", К7 = "", К8 = "")

	Значения = Новый Массив;
	Значения.Добавить(К1);
	Значения.Добавить(К2);
	Значения.Добавить(К3);
	Значения.Добавить(К4);
	Значения.Добавить(К5);
	Значения.Добавить(К6);
	Значения.Добавить(К7);
	Значения.Добавить(К8);
	Последняя = 1;
	Для Индекс = 0 По 7 Цикл
		Если ЗначениеЗаполнено(Значения[Индекс]) Тогда
			Последняя = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Для Индекс = 0 По Последняя - 1 Цикл
		Ячейка(В, Индекс + 1, Значения[Индекс], Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8, , Истина);
		Если Индекс > 0 Тогда
			ВПраво(В, Индекс + 1, Индекс + 1);
		КонецЕсли;
	КонецЦикла;
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 18;
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура СтрокаИтога(В, Название, З2 = Неопределено, З3 = Неопределено, З4 = Неопределено, З5 = Неопределено)

	Значения = Новый Массив;
	Значения.Добавить(З2);
	Значения.Добавить(З3);
	Значения.Добавить(З4);
	Значения.Добавить(З5);
	Последняя = 1;
	Для Индекс = 0 По 3 Цикл
		Если Значения[Индекс] <> Неопределено Тогда
			Последняя = Индекс + 2;
		КонецЕсли;
	КонецЦикла;
	Ячейка(В, 1, Название, Истина, , ЦветФонаШапки());
	Для Индекс = 0 По Последняя - 2 Цикл
		Если Значения[Индекс] = Неопределено Тогда
			Ячейка(В, Индекс + 2, "", , , ЦветФонаШапки());
		Иначе
			ЯчейкаЧисло(В, Индекс + 2, Значения[Индекс], , Истина, ЦветФонаШапки());
		КонецЕсли;
	КонецЦикла;
	Черта(В, 1, Последняя, 1, , Ложь);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура Примечание(В, ТекстПримечания)

	Ячейка(В, 1, ТекстПримечания, , ЦветПриглушенный(), , 8, 8, Истина);
	ПодогнатьВысоту(В, ТекстПримечания, 160);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ПодогнатьВысоту(В, ТекстЯчейки, СимволовВСтроке)

	Строк = Цел(СтрДлина(ТекстЯчейки) / СимволовВСтроке) + 1;
	Если Строк > 1 Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 12 * Строк;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Черта(В, ОтКолонки, ДоКолонки, Толщина = 1, Цвет = Неопределено, Снизу = Истина)

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, Толщина);
	Обл = В.ТД.Область(В.Строка, ОтКолонки, В.Строка, ДоКолонки);
	Если Снизу Тогда
		Обл.ГраницаСнизу = Линия;
	Иначе
		Обл.ГраницаСверху = Линия;
	КонецЕсли;
	Обл.ЦветРамки = ?(Цвет = Неопределено, Новый Цвет(24, 32, 31), Цвет);

КонецПроцедуры

&НаСервере
Процедура ЛинияСнизу(В, ОтКолонки, ДоКолонки)

	Обл = В.ТД.Область(В.Строка, ОтКолонки, В.Строка, ДоКолонки);
	Обл.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Обл.ЦветРамки = Новый Цвет(225, 231, 229);

КонецПроцедуры

&НаСервере
Процедура Полоса(В, ОтКолонки, ДоКолонки, Доля, Цвет, ДоляПлана)

	// горизонтальная полоса из символов █: примерно 15 символов на колонку, лишнее обрезается
	Ячеек = ДоКолонки - ОтКолонки + 1;
	Заполнено = Окр(Мин(Доля, 1) * Ячеек * 15);
	Для К = 0 По Ячеек - 1 Цикл
		Блоков = Мин(15, Макс(0, Заполнено - К * 15));
		Обл = В.ТД.Область(В.Строка, ОтКолонки + К, В.Строка, ОтКолонки + К);
		Обл.Текст = Лев("████████████████████", Блоков);
		Обл.Шрифт = Новый Шрифт("Arial", 9);
		Обл.ЦветТекста = Цвет;
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
	КонецЦикла;
	Если ДоляПлана > 0 Тогда
		Колонка = ОтКолонки + Мин(Ячеек - 1, Цел(ДоляПлана * Ячеек - 0.0001));
		Обл = В.ТД.Область(В.Строка, Колонка, В.Строка, Колонка);
		Обл.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		Обл.ЦветРамки = Новый Цвет(24, 32, 31);
	КонецЕсли;

