&НаСервере
Процедура РасшифровкаСтроки(В, Значение, ДоКолонки)

	// двойной щелчок по строке открывает документ, контрагента или номенклатуру
	Если ЗначениеЗаполнено(Значение) И ТипЗнч(Значение) <> Тип("Строка") Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, ДоКолонки).Расшифровка = Значение;
	КонецЕсли;

