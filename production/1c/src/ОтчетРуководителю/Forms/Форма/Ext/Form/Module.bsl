&НаСервере
Функция ПоказатьОшибку(В, Р, Раздел)

	Ошибка = Р.Ошибки[Раздел];
	Если Ошибка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Ячейка(В, 1, "Раздел не сформирован: " + Ошибка, , ЦветКрит(), ФонКрит(), 9, 8, Истина);
	ПодогнатьВысоту(В, Ошибка, 120);
	СледующаяСтрока(В);
	Примечание(В, "Скорее всего, в вашем релизе ERP регистр или поле называется иначе. Поправьте запрос в функции Получить" + Раздел + "() модуля формы.");
	Возврат Истина;

