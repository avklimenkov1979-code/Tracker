&НаСервере
Процедура СтрокаИтога(В, Название, З2 = Неопределено, З3 = Неопределено, З4 = Неопределено, З5 = Неопределено)

	Значения = Новый Массив;
	Значения.Добавить(З2);
	Значения.Добавить(З3);
	Значения.Добавить(З4);
	Значения.Добавить(З5);
	Последняя = 1;
	Для Индекс = 0 По 3 Цикл
		Если Значения[Индекс] <> Неопределено Тогда
			Последняя = Индекс + 2;
		КонецЕсли;
	КонецЦикла;
	Ячейка(В, 1, Название, Истина, , ЦветФонаШапки());
	Для Индекс = 0 По Последняя - 2 Цикл
		Если Значения[Индекс] = Неопределено Тогда
			Ячейка(В, Индекс + 2, "", , , ЦветФонаШапки());
		Иначе
			ЯчейкаЧисло(В, Индекс + 2, Значения[Индекс], , Истина, ЦветФонаШапки());
		КонецЕсли;
	КонецЦикла;
	Черта(В, 1, Последняя, 1, , Ложь);
	СледующаяСтрока(В);

