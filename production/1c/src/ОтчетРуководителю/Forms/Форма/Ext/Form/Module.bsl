		|	И Д.Организация = &Организация", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Д.Дата";
	УстановитьПараметры(Запрос, П);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтр = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
		НовСтр.ЗаДень = НачалоДня(Выборка.Дата) = П.День;
		Если НовСтр.ЗаДень Тогда
			НовСтр.Клиент = РеквизитСсылки(Выборка.Документ, "Контрагент,Партнер");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

