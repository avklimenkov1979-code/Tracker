&НаСервере
Процедура Шапка(В, К1, К2 = "", К3 = "", К4 = "", К5 = "", К6 = "", К7 = "", К8 = "")

	Значения = Новый Массив;
	Значения.Добавить(К1);
	Значения.Добавить(К2);
	Значения.Добавить(К3);
	Значения.Добавить(К4);
	Значения.Добавить(К5);
	Значения.Добавить(К6);
	Значения.Добавить(К7);
	Значения.Добавить(К8);
	Последняя = 1;
	Для Индекс = 0 По 7 Цикл
		Если ЗначениеЗаполнено(Значения[Индекс]) Тогда
			Последняя = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Для Индекс = 0 По Последняя - 1 Цикл
		Ячейка(В, Индекс + 1, Значения[Индекс], Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8, , Истина);
		Если Индекс > 0 Тогда
			ВПраво(В, Индекс + 1, Индекс + 1);
		КонецЕсли;
	КонецЦикла;
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 18;
	СледующаяСтрока(В);

