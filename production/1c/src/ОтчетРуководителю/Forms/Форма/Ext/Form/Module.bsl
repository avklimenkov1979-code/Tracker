Функция ДеньгиКратко(Сумма)

	Модуль = Макс(Сумма, -Сумма);
	Знак = ?(Сумма < 0, "−", "");
	Если Модуль >= 1000000000 Тогда
		Возврат Знак + Формат(Модуль / 1000000000, "ЧДЦ=2") + " млрд руб.";
	ИначеЕсли Модуль >= 1000000 Тогда
		Возврат Знак + Формат(Модуль / 1000000, "ЧДЦ=1") + " млн руб.";
	ИначеЕсли Модуль >= 10000 Тогда
		Возврат Знак + Формат(Модуль / 1000, "ЧДЦ=0") + " тыс. руб.";
	КонецЕсли;
	Возврат Знак + Формат(Модуль, "ЧДЦ=0; ЧН=0") + " руб.";

