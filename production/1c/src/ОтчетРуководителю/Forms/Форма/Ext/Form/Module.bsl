&НаСервере
Функция УсловиеОрганизации(ИмяРегистра, П)

	Если НЕ ЗначениеЗаполнено(П.Организация) Тогда
		Возврат "";
	КонецЕсли;
	Если ИзмерениеРегистра(ИмяРегистра, "Организация") <> "" Тогда
		Возврат "Организация = &Организация";
	ИначеЕсли ИзмерениеРегистра(ИмяРегистра, "АналитикаУчетаПоПартнерам") <> "" Тогда
		Возврат "АналитикаУчетаПоПартнерам.Организация = &Организация";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция РеквизитСсылки(Ссылка, Варианты)

	// первый из перечисленных реквизитов, который есть у объекта; иначе Неопределено
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		М = Ссылка.Метаданные();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Имя = СокрЛП(Имя);
		Если М.Реквизиты.Найти(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Имя);
		Исключение
			Значение = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

