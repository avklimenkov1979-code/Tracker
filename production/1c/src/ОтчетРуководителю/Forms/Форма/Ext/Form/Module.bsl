// Ежедневный отчёт: деньги, долги, продажи, прибыль, аренда, заказы, выпуск, сырьё, неоплаченные счета.
// Внешняя обработка для 1С:ERP Управление предприятием 2.4 / 2.5 (платформа 8.3.10+).
// Собирается из этой папки файлом СОБРАТЬ.bat (см. production/1c/README.md).
//
// Это модуль основной формы. Реквизиты и элементы формы создаются из кода
// в ПриСозданииНаСервере, поэтому Form.xml почти пустой.
//
// Регистры и поля ищутся по метаданным, поэтому отчёт переносит разницу между
// релизами ERP. Если какой-то раздел не получится собрать, отчёт покажет текст
// ошибки в этом разделе, а остальные разделы сформирует как обычно.
// Все запросы — в функциях Получить*(): их и правят, если в базе что-то иначе.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизитыФормы();
	СоздатьЭлементыФормы();
	ЗагрузитьНастройки();
	ЭтаФорма["ДатаОтчета"] = НачалоДня(ТекущаяДатаСеанса());
	ЭтаФорма.Заголовок = "Ежедневный отчёт";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтаФорма["ДатаОтчета"]) Тогда
		ПоказатьПредупреждение(, "Укажите дату отчёта.");
		Возврат;
	КонецЕсли;
	Состояние("Формирую ежедневный отчёт...");
	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура Вчера(Команда)

	ЭтаФорма["ДатаОтчета"] = НачалоДня(ЭтаФорма["ДатаОтчета"]) - 86400;
	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура Сегодня(Команда)

	ЭтаФорма["ДатаОтчета"] = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса());
	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибке(Команда)

	Состояние("Собираю сведения об ошибке...");
	Адрес = ОтчетОбОшибкеНаСервере(СведенияОКлиенте());
	ИмяФайла = "Ошибка_ежедневный_отчет_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	ПоказатьОповещениеПользователя("Сохраните файл и пришлите его в чат", , ИмяФайла);
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)

	Состояние("Собираю сведения о базе для настройки отчёта...");
	Адрес = ДиагностикаНаСервере();
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, "Диагностика_ежедневного_отчета.txt");
	Исключение
		ПоказатьПредупреждение(, "Текст диагностики показан в окне. Сохраните его: Ещё → Сохранить как, и пришлите файл.");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СообщениеОбОшибке

// Кнопка «Сообщить об ошибке» собирает в один текстовый файл всё, что нужно, чтобы найти причину:
// версии программы, 1С и конфигурации, настройки отчёта, полный текст ошибок разделов
// (с номером строки модуля), сообщения на экране и ошибки из журнала регистрации за 2 часа.
// Названий контрагентов и сумм в файле нет — только тексты ошибок.

&НаКлиенте
Процедура Сформировать()

	Попытка
		СформироватьНаСервере();
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Формирование отчёта", ПодробноеПредставлениеОшибки(Инфо));
		ПоказатьПредупреждение(, "Отчёт не сформировался:" + Символы.ПС + КраткоеПредставлениеОшибки(Инфо) + Символы.ПС + Символы.ПС
			+ "Нажмите «Сообщить об ошибке» и пришлите сохранённый файл в чат.");
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция СведенияОКлиенте()

	Сведения = Новый Структура("Платформа, ОС, Сообщения", "", "", "");
	Попытка
		СисИнфо = Новый СистемнаяИнформация;
		Сведения.Платформа = СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + ")";
		Сведения.ОС = СисИнфо.ВерсияОС;
	Исключение
		// не критично
	КонецПопытки;
	ТекстыСообщений = Новый Массив;
	// ПолучитьСообщенияПользователю() на клиенте недоступна (только сервер) — не вызываем
	Сведения.Сообщения = СтрСоединить(ТекстыСообщений, Символы.ПС);
	Возврат Сведения;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьЗаписьЖурнала(Знач Журнал, Где, ТекстОшибки)

	Запись = "[" + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + Где + ":" + Символы.ПС + ТекстОшибки;
	Если ПустаяСтрока(Журнал) Тогда
		Возврат Запись;
	КонецЕсли;
	Возврат Журнал + Символы.ПС + Символы.ПС + Запись;

КонецФункции

&НаСервере
Процедура ЗапомнитьОшибкуРаздела(Р, Раздел, Инфо)

	Р.Ошибки.Вставить(Раздел, КраткоеПредставлениеОшибки(Инфо));
	ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Раздел «" + Раздел + "»", ПодробноеПредставлениеОшибки(Инфо));

КонецПроцедуры

&НаСервере
Функция ВерсияПрограммы()

	Попытка
		Возврат РеквизитФормыВЗначение("Объект").СведенияОВнешнейОбработке().Версия;
	Исключение
		Возврат "не определена";
	КонецПопытки;

КонецФункции

&НаСервере
Функция ОтчетОбОшибкеНаСервере(СведенияКлиента)

	Строки = Новый Массив;
	Строки.Добавить("СООБЩЕНИЕ ОБ ОШИБКЕ: Ежедневный отчёт, версия " + ВерсияПрограммы());
	Строки.Добавить("Составлено: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'"));
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия);
	Попытка
		СисИнфо = Новый СистемнаяИнформация;
		Строки.Добавить("1С на сервере: " + СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + ")");
	Исключение
		// не критично
	КонецПопытки;
	Строки.Добавить("1С на компьютере: " + СведенияКлиента.Платформа + "; " + СведенияКлиента.ОС);
	Строки.Добавить("База: " + ?(СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "file=") > 0, "файловая", "на сервере 1С"));

	Строки.Добавить("");
	Строки.Добавить("НАСТРОЙКИ ОТЧЁТА");
	Для Каждого ИмяНастройки Из СтрРазделить("ДатаОтчета,Организация,ГруппаСырья,СтатьиСырья,ПланВыпускаВСутки,НеснижаемыйОстаток,ГоризонтДней,СрокПоставкиДней,РезервДней,КрупныйПлатеж", ",") Цикл
		Строки.Добавить("  " + ИмяНастройки + " = " + ЭтаФорма[ИмяНастройки]);
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ ПРИ ПОСЛЕДНЕМ ФОРМИРОВАНИИ");
	Строки.Добавить(?(ПустаяСтрока(ЭтаФорма["ЖурналОшибок"]), "  нет (если отчёт показывает неверные цифры — нажмите ещё «Диагностика» и пришлите оба файла)", ЭтаФорма["ЖурналОшибок"]));

	Если НЕ ПустаяСтрока(СведенияКлиента.Сообщения) Тогда
		Строки.Добавить("");
		Строки.Добавить("СООБЩЕНИЯ НА ЭКРАНЕ");
		Строки.Добавить(СведенияКлиента.Сообщения);
	КонецЕсли;

	ДобавитьЖурналРегистрации(Строки);

	Текст = ОбезличитьДляЧата(СтрСоединить(Строки, Символы.ПС));
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ДобавитьЖурналРегистрации(Строки)

	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ ИЗ ЖУРНАЛА РЕГИСТРАЦИИ ЗА 2 ЧАСА (этот пользователь)");
	Попытка
		ТаблицаЖурнала = Новый ТаблицаЗначений;
		Отбор = Новый Структура;
		Отбор.Вставить("ДатаНачала", ТекущаяДатаСеанса() - 7200);
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
		Отбор.Вставить("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь());
		ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, , , 200);
		Если ТаблицаЖурнала.Количество() = 0 Тогда
			Строки.Добавить("  нет");
		КонецЕсли;
		Первая = Макс(0, ТаблицаЖурнала.Количество() - 20);
		Для Индекс = Первая По ТаблицаЖурнала.Количество() - 1 Цикл
			ЗаписьЖ = ТаблицаЖурнала[Индекс];
			Строки.Добавить("[" + Формат(ЗаписьЖ.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + ЗаписьЖ.Событие + ": " + Лев(ЗаписьЖ.Комментарий, 3000));
		КонецЦикла;
	Исключение
		Строки.Добавить("  недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ФормаИзКода

&НаСервере
Процедура СоздатьРеквизитыФормы()

	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ТипДни = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный));

	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаОтчета", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), , "Дата"));
	Добавляемые.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Добавляемые.Добавить(Новый РеквизитФормы("ГруппаСырья", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), , "Группа сырья"));
	Добавляемые.Добавить(Новый РеквизитФормы("ПланВыпускаВСутки", ТипЧисло, , "План выпуска в сутки"));
	Добавляемые.Добавить(Новый РеквизитФормы("СтатьиСырья", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)), , "Статьи калькуляции основного сырья"));
	Добавляемые.Добавить(Новый РеквизитФормы("НеснижаемыйОстаток", ТипЧисло, , "Неснижаемый остаток, руб."));
	Добавляемые.Добавить(Новый РеквизитФормы("ГоризонтДней", ТипДни, , "Прогноз, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("СрокПоставкиДней", ТипДни, , "Срок поставки сырья, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("РезервДней", ТипДни, , "Резерв сверх срока поставки, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("КрупныйПлатеж", ТипЧисло, , "Крупный платёж от, руб."));
	Добавляемые.Добавить(Новый РеквизитФормы("ДокументОтчета", Новый ОписаниеТипов("ТабличныйДокумент"), , "Отчёт"));
	Добавляемые.Добавить(Новый РеквизитФормы("ЖурналОшибок", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(Добавляемые);

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы()

	Команда = Команды.Добавить("СформироватьОтчет");
	Команда.Заголовок = "Сформировать";
	Команда.Действие = "СформироватьОтчет";
	Команда.Подсказка = "Собрать отчёт на выбранную дату";

	Команда = Команды.Добавить("Вчера");
	Команда.Заголовок = "← Вчера";
	Команда.Действие = "Вчера";

	Команда = Команды.Добавить("Диагностика");
	Команда.Заголовок = "Диагностика";
	Команда.Действие = "Диагностика";
	Команда.Подсказка = "Собрать сведения о базе в файл — для настройки отчёта под вашу базу";

	Команда = Команды.Добавить("СообщитьОбОшибке");
	Команда.Заголовок = "Сообщить об ошибке";
	Команда.Действие = "СообщитьОбОшибке";
	Команда.Подсказка = "Собрать в один файл тексты ошибок и версии программы и 1С, чтобы прислать его в чат";

	Команда = Команды.Добавить("Сегодня");
	Команда.Заголовок = "Сегодня";
	Команда.Действие = "Сегодня";

	// командная панель формы: свойство формы, а не элемент «КоманднаяПанель»
	Панель = Элементы.Найти("ФормаКоманднаяПанель");
	Если Панель = Неопределено Тогда
		Панель = ЭтаФорма.КоманднаяПанель;
	КонецЕсли;
	Кнопка = Элементы.Добавить("КнопкаСформировать", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "СформироватьОтчет";
	Кнопка.КнопкаПоУмолчанию = Истина;
	Кнопка = Элементы.Добавить("КнопкаВчера", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "Вчера";
	Кнопка = Элементы.Добавить("КнопкаСегодня", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "Сегодня";
	Кнопка = Элементы.Добавить("КнопкаДиагностика", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "Диагностика";
	Кнопка = Элементы.Добавить("КнопкаСообщитьОбОшибке", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "СообщитьОбОшибке";

	Группа = Элементы.Добавить("ГруппаОсновные", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Группа.ОтображатьЗаголовок = Ложь;
	ДобавитьПоле("ДатаОтчета", Группа);
	ДобавитьПоле("Организация", Группа, "Пусто — все организации");

	Группа = Элементы.Добавить("ГруппаНастройки", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Настройки отчёта";
	Попытка
		Группа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
		Группа.Скрыта = Истина;
	Исключение
		// старая платформа: группа просто показывается раскрытой
	КонецПопытки;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Строка1 = Элементы.Добавить("ГруппаНастройки1", Тип("ГруппаФормы"), Группа);
	Строка1.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Строка1.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Строка1.ОтображатьЗаголовок = Ложь;
	Строка2 = Элементы.Добавить("ГруппаНастройки2", Тип("ГруппаФормы"), Группа);
	Строка2.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Строка2.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Строка2.ОтображатьЗаголовок = Ложь;
	ДобавитьПоле("ГруппаСырья", Строка1, "Папка номенклатуры с сырьём. Пусто — всё, что списывалось в производство за 30 дней");
	ДобавитьПоле("ПланВыпускаВСутки", Строка1, "Нужен, только если нет документов «План производства». В основной единице продукции (обычно кг)");
	ДобавитьПоле("СтатьиСырья", Строка1, "Какое сырьё считать основным: части названий статей калькуляции через запятую");
	ДобавитьПоле("НеснижаемыйОстаток", Строка1);
	ДобавитьПоле("ГоризонтДней", Строка2);
	ДобавитьПоле("СрокПоставкиДней", Строка2);
	ДобавитьПоле("РезервДней", Строка2);
	ДобавитьПоле("КрупныйПлатеж", Строка2);

	Поле = Элементы.Добавить("ДокументОтчета", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	Поле.ПутьКДанным = "ДокументОтчета";
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоле(Имя, Родитель, Подсказка = "")

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = Имя;
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Поле.Подсказка = Подсказка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()

	ЭтаФорма["ГоризонтДней"] = 7;
	ЭтаФорма["СрокПоставкиДней"] = 7;
	ЭтаФорма["РезервДней"] = 3;
	ЭтаФорма["КрупныйПлатеж"] = 3000000;
	ЭтаФорма["СтатьиСырья"] = "Сырье основное";
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("ОтчетРуководителю", "Настройки");
	Если ТипЗнч(Сохраненные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Сохраненные Цикл
		Попытка
			ЭтаФорма[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		Исключение
			// реквизит переименован в новой версии отчёта — пропускаем
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()

	Настройки = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Организация,ГруппаСырья,ПланВыпускаВСутки,СтатьиСырья,НеснижаемыйОстаток,ГоризонтДней,СрокПоставкиДней,РезервДней,КрупныйПлатеж", ",") Цикл
		Попытка
			Настройки.Вставить(Имя, ЭтаФорма[Имя]);
		Исключение
			// реквизита нет в этой конфигурации (например, нет справочника учётных записей почты)
			Настройки.Вставить(Имя, Неопределено);
		КонецПопытки;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ОтчетРуководителю", "Настройки", Настройки);

КонецПроцедуры

#КонецОбласти

#Область Формирование

&НаСервере
Функция ПараметрыОтчета()

	ДеньОтчета = НачалоДня(ЭтаФорма["ДатаОтчета"]);
	П = Новый Структура;
	П.Вставить("День", ДеньОтчета);
	П.Вставить("НачалоДня", ДеньОтчета);
	П.Вставить("КонецДня", КонецДня(ДеньОтчета));
	П.Вставить("Граница", Новый Граница(КонецДня(ДеньОтчета), ВидГраницы.Включая));
	П.Вставить("НачалоМесяца", НачалоМесяца(ДеньОтчета));
	П.Вставить("Начало14", ДеньОтчета - 13 * 86400);
	П.Вставить("Начало30", ДеньОтчета - 29 * 86400);
	П.Вставить("НачалоДенег", Мин(НачалоМесяца(ДеньОтчета), ДеньОтчета - 13 * 86400));
	П.Вставить("НачалоПрошлогоМесяца", ДобавитьМесяц(НачалоМесяца(ДеньОтчета), -1));
	П.Вставить("КонецПрошлогоПериода", КонецДня(ДобавитьМесяц(ДеньОтчета, -1)));
	П.Вставить("Организация", ЭтаФорма["Организация"]);
	П.Вставить("ГруппаСырья", ЭтаФорма["ГруппаСырья"]);
	П.Вставить("ПланВСутки", ЭтаФорма["ПланВыпускаВСутки"]);
	П.Вставить("СтатьиСырья", ?(ПустаяСтрока(ЭтаФорма["СтатьиСырья"]), "Сырье основное", ЭтаФорма["СтатьиСырья"]));
	П.Вставить("НеснижаемыйОстаток", ЭтаФорма["НеснижаемыйОстаток"]);
	П.Вставить("Горизонт", Макс(1, ЭтаФорма["ГоризонтДней"]));
	П.Вставить("СрокПоставки", ЭтаФорма["СрокПоставкиДней"]);
	П.Вставить("Резерв", ЭтаФорма["РезервДней"]);
	П.Вставить("КрупныйПлатеж", ЭтаФорма["КрупныйПлатеж"]);
	Возврат П;

КонецФункции

&НаСервере
Процедура СформироватьНаСервере()

	СохранитьНастройки();
	ЭтаФорма["ЖурналОшибок"] = "";

	П = ПараметрыОтчета();

	Р = Новый Структура;
	Р.Вставить("Ошибки", Новый Соответствие);
	Р.Вставить("Сигналы", НоваяТаблицаСигналов());

	Р.Вставить("Долги", Неопределено);
	Попытка
		Р.Долги = Новый Структура("НамДолжны, МыДолжны",
			ПолучитьДолги("РасчетыСКлиентамиПоСрокам", "РасчетыСКлиентами", П),
			ПолучитьДолги("РасчетыСПоставщикамиПоСрокам", "РасчетыСПоставщиками", П));
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Долги", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Деньги", Неопределено);
	Попытка
		Р.Деньги = ПолучитьДеньги(П, Р.Долги);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Деньги", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Выпуск", Неопределено);
	Попытка
		Р.Выпуск = ПолучитьВыпуск(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Выпуск", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Заказы", Неопределено);
	Попытка
		Р.Заказы = ПолучитьЗаказы(П, Р.Выпуск);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Заказы", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Сырье", Неопределено);
	Попытка
		Р.Сырье = ПолучитьСырье(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Сырье", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Продажи", Неопределено);
	Попытка
		Р.Продажи = ПолучитьПродажи(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Продажи", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Маржа", Неопределено);
	Попытка
		Р.Маржа = ПолучитьМаржу(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Маржа", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Финрезультат", Неопределено);
	Попытка
		Р.Финрезультат = ПолучитьФинрезультат(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Финрезультат", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Закупки", Неопределено);
	Попытка
		Р.Закупки = ПолучитьОбороты("ПриобретениеТоваровУслуг", П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Закупки", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("ЗакупкиГод", Неопределено);
	Попытка
		Р.ЗакупкиГод = ПолучитьЗакупкиГод(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "ЗакупкиГод", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("НеоплаченныеСчета", Неопределено);
	Попытка
		Р.НеоплаченныеСчета = ПолучитьНеоплаченныеСчета(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "НеоплаченныеСчета", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Аренда", Неопределено);
	Попытка
		Р.Аренда = ПолучитьАренду(П, Р.Долги);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Аренда", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Запасы", Неопределено);
	Попытка
		Р.Запасы = ПолучитьЗапасы(П, Р.Выпуск, Р.Продажи, Р.Заказы);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Запасы", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Потребность", Неопределено);
	Попытка
		Р.Потребность = ПолучитьПотребность(П, Р);
	Исключение
