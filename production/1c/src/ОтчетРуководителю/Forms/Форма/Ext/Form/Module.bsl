	Строки.Добавить("    Add-Type -AssemblyName System.Runtime.WindowsRuntime");
	Строки.Добавить("    $null = [Windows.Storage.StorageFile, Windows.Storage, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Data.Pdf.PdfDocument, Windows.Data.Pdf, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Data.Pdf.PdfPageRenderOptions, Windows.Data.Pdf, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Graphics, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Graphics.Imaging.SoftwareBitmap, Windows.Graphics, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Storage.Streams.InMemoryRandomAccessStream, Windows.Storage.Streams, ContentType = WindowsRuntime]");
	Строки.Добавить("    $null = [Windows.Globalization.Language, Windows.Globalization, ContentType = WindowsRuntime]");
	Строки.Добавить("} catch {");
	Строки.Добавить("    Log ('ОШИБКА: в этой Windows нет встроенного распознавания PDF (нужна Windows 10/11 или Server 2019+): ' + $_.Exception.Message)");
	Строки.Добавить("    exit 2");
