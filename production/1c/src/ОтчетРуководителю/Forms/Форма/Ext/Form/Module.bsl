&НаСервере
Функция ИзмерениеРегистра(ИмяРегистра, Варианты)

	М = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если М = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если М.Измерения.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Возврат СокрЛП(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

