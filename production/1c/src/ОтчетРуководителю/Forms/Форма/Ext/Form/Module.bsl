&НаСервере
Функция РасходСырья(П, НачалоПериода)

	// фактический расход сырья в производство по строкам документов: номенклатура, количество
	// за период и за последние 14 дней; только основное сырьё (статья калькуляции или группа)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("За30", ОписаниеЧисла());
	Результат.Колонки.Добавить("За14", ОписаниеЧисла());
	Для Каждого Опис Из ИсточникиРасходаСырья() Цикл
		Мета = Метаданные.Документы.Найти(Опис.Документ);
		Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти(Опис.ТЧ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты = Мета.ТабличныеЧасти[Опис.ТЧ].Реквизиты;
		Если Реквизиты.Найти("Количество") = Неопределено ИЛИ Реквизиты.Найти("Номенклатура") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЕстьСтатья = Реквизиты.Найти("СтатьяКалькуляции") <> Неопределено;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Номенклатура КАК Номенклатура,
			|	" + ?(ЕстьСтатья, "Т.СтатьяКалькуляции", "НЕОПРЕДЕЛЕНО") + " КАК Статья,
			|	СУММА(Т.Количество) КАК За30,
			|	СУММА(ВЫБОР КОГДА Т.Ссылка.Дата >= &Начало14 ТОГДА Т.Количество ИНАЧЕ 0 КОНЕЦ) КАК За14
			|ИЗ
			|	Документ." + Опис.Документ + "." + Опис.ТЧ + " КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &НачалоРасхода И &КонецДня" + ?(ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено, "
			|	И Т.Ссылка.Организация = &Организация", "") + ?(ЗначениеЗаполнено(П.ГруппаСырья), "
			|	И Т.Номенклатура В ИЕРАРХИИ (&ГруппаСырья)", "") + "
			|СГРУППИРОВАТЬ ПО
			|	Т.Номенклатура" + ?(ЕстьСтатья, ",
			|	Т.СтатьяКалькуляции", "");
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("НачалоРасхода", НачалоПериода);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(П.ГруппаСырья) И НЕ ЭтоОсновноеСырье(Выборка.Статья, П) Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;
	Результат.Свернуть("Номенклатура", "За30, За14");
	Результат.Сортировать("За30 Убыв");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьСырье(П)

	// основное сырьё — то, что за 30 дней списано в суточных рапортах и этапах производства
	// по статьям калькуляции из настройки (по умолчанию «Сырье основное»);
	// если в настройках задана группа сырья — всё сырьё этой группы
	Расходы = РасходСырья(П, П.Начало30);
	СписокДокументов = Новый Массив;
	Для Каждого Опис Из ИсточникиРасходаСырья() Цикл
		Если Метаданные.Документы.Найти(Опис.Документ) <> Неопределено Тогда
			СписокДокументов.Добавить(Опис.Документ);
		КонецЕсли;
	КонецЦикла;
	Материалы = Расходы.ВыгрузитьКолонку("Номенклатура");
	Если ЗначениеЗаполнено(П.ГруппаСырья) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Т.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, Номенклатура В ИЕРАРХИИ (&ГруппаСырья)) КАК Т";
		УстановитьПараметры(Запрос, П);
		Для Каждого Ном Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура") Цикл
			Если Материалы.Найти(Ном) = Неопределено Тогда
				Материалы.Добавить(Ном);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Остатки = ОстаткиНаСкладах(Материалы, П);
	ВПути = ПоставкиВПути(Материалы, П);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Ед");
	Таблица.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВСутки", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ХватитДней", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ХватитСПоставкой", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВПути", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ДатаПоставки");
	Таблица.Колонки.Добавить("Статус");
	Таблица.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Пояснение");
	Таблица.Колонки.Добавить("Заказать", ОписаниеЧисла());

	Для Каждого Ном Из Материалы Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Номенклатура = Ном;
		НовСтр.Ед = ЕдиницаНоменклатуры(Ном);
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Ном]);
		Расход = Расходы.Найти(Ном, "Номенклатура");
		НовСтр.ВСутки = ?(Расход = Неопределено, 0, Расход.За30 / 30);
		Поставка = ВПути[Ном];
		Если Поставка <> Неопределено Тогда
			НовСтр.ВПути = Поставка.Количество;
			НовСтр.ДатаПоставки = Поставка.Дата;
		КонецЕсли;
		ОценитьМатериал(НовСтр, П);
	КонецЦикла;
	Таблица.Сортировать("Порядок, ХватитДней");

	Р = Новый Структура;
	Р.Вставить("Материалы", Таблица);
	Р.Вставить("Нехватка", Таблица.НайтиСтроки(Новый Структура("Статус", "нехватка")));
	Р.Вставить("Документы", СписокДокументов);
	Р.Вставить("Заказать", Таблица.НайтиСтроки(Новый Структура("Статус", "заказать")));
	Возврат Р;

КонецФункции

&НаСервере
Процедура ОценитьМатериал(НовСтр, П)

	НовСтр.Статус = "в норме";
	НовСтр.Порядок = 2;
	Если НовСтр.ВСутки <= 0 Тогда
		НовСтр.Пояснение = "За 30 дней в производство не списывался";
		НовСтр.Порядок = 3;
		Возврат;
	КонецЕсли;
	НовСтр.ХватитДней = НовСтр.Остаток / НовСтр.ВСутки;
	НовСтр.ХватитСПоставкой = (НовСтр.Остаток + НовСтр.ВПути) / НовСтр.ВСутки;
	Кончится = П.День + Цел(НовСтр.ХватитДней) * 86400;
	// поставка с прошедшей датой ещё не пришла — ждём её не раньше завтра; без даты — через срок поставки
	ДатаПрихода = ?(ЗначениеЗаполнено(НовСтр.ДатаПоставки), Макс(НачалоДня(НовСтр.ДатаПоставки), П.День + 86400), П.День + П.СрокПоставки * 86400);
	Если НовСтр.ВПути > 0 И ДатаПрихода > Кончится Тогда
		Простой = Цел((ДатаПрихода - Кончится) / 86400);
		НовСтр.Статус = "нехватка";
		НовСтр.Пояснение = СтрШаблон("Закончится %1, поставка %2 — простой около %3 %4",
			Формат(Кончится, "ДФ=dd.MM"), Формат(ДатаПрихода, "ДФ=dd.MM") + ?(ЗначениеЗаполнено(НовСтр.ДатаПоставки) И НовСтр.ДатаПоставки < П.День, " (просрочена)", ""), Простой, Склонение(Простой, "дня", "дней", "дней"));
	ИначеЕсли НовСтр.ВПути = 0 И НовСтр.ХватитДней < П.СрокПоставки Тогда
		НовСтр.Статус = "нехватка";
		НовСтр.Пояснение = СтрШаблон("Хватит на %1 дн., а поставка идёт %2 дн. — заказать сегодня",
			Формат(НовСтр.ХватитДней, "ЧДЦ=1; ЧН=0"), П.СрокПоставки);
	ИначеЕсли НовСтр.ХватитСПоставкой < П.СрокПоставки + П.Резерв Тогда
		НовСтр.Статус = "заказать";
		НовСтр.Пояснение = "Запас меньше срока поставки с резервом";
	КонецЕсли;
	Если НовСтр.Статус <> "в норме" Тогда
		НовСтр.Порядок = ?(НовСтр.Статус = "нехватка", 0, 1);
		НовСтр.Заказать = Макс(0, НовСтр.ВСутки * (П.СрокПоставки + Макс(П.Резерв, П.Горизонт)) - НовСтр.Остаток - НовСтр.ВПути);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоставкиВПути(Материалы, П)

	Результат = Новый Соответствие;
	Рег = "ЗаказыПоставщикам";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ИзмЗаказ = ИзмерениеРегистра(Рег, "ЗаказПоставщику,Распоряжение,Заказ");
	РесКоличество = РесурсРегистра(Рег, "КПоступлению,КОформлению,Заказано");
	Если ИзмЗаказ = "" ИЛИ РесКоличество = "" Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т." + ИзмЗаказ + " КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + РесКоличество + "Остаток) КАК Количество
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница, Номенклатура В (&Список)) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т." + ИзмЗаказ + ",
		|	Т.Номенклатура
		|ИМЕЮЩИЕ
		|	СУММА(Т." + РесКоличество + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Список", Материалы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаДня = РеквизитСсылки(Выборка.Заказ, "ДатаПоступления,ЖелаемаяДатаПоступления");
		Было = Результат[Выборка.Номенклатура];
		Если Было = Неопределено Тогда
			Было = Новый Структура("Количество, Дата, ДоКонцаМесяца, ДоКонцаСледующего", 0, ДатаДня, 0, 0);
			Результат.Вставить(Выборка.Номенклатура, Было);
		ИначеЕсли ЗначениеЗаполнено(ДатаДня) И (НЕ ЗначениеЗаполнено(Было.Дата) ИЛИ ДатаДня < Было.Дата) Тогда
			Было.Дата = ДатаДня;
		КонецЕсли;
		Было.Количество = Было.Количество + Выборка.Количество;
		// без даты поступления считаем, что придёт в этом месяце
		Если НЕ ЗначениеЗаполнено(ДатаДня) ИЛИ ДатаДня <= КонецМесяца(П.День) Тогда
			Было.ДоКонцаМесяца = Было.ДоКонцаМесяца + Выборка.Количество;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДатаДня) ИЛИ ДатаДня <= КонецМесяца(ДобавитьМесяц(П.НачалоМесяца, 1)) Тогда
			Было.ДоКонцаСледующего = Было.ДоКонцаСледующего + Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПродажиЗакупкиЗапасы

&НаСервере
Функция РеквизитКоллекции(Коллекция, Варианты)

	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если Коллекция.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Возврат СокрЛП(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Функция ВыражениеСуммыБезНДС(ИмяДокумента)

	// сумма строки табличной части «Товары» без НДС
	Мета = Метаданные.Документы[ИмяДокумента];
	Реквизиты = Мета.ТабличныеЧасти.Товары.Реквизиты;
	ЕстьНДС = Реквизиты.Найти("СуммаНДС") <> Неопределено;
	Если Реквизиты.Найти("СуммаСНДС") <> Неопределено И ЕстьНДС Тогда
		Возврат "Т.СуммаСНДС - Т.СуммаНДС";
	ИначеЕсли Реквизиты.Найти("Сумма") <> Неопределено Тогда
		Если ЕстьНДС И Мета.Реквизиты.Найти("ЦенаВключаетНДС") <> Неопределено Тогда
			Возврат "ВЫБОР КОГДА Т.Ссылка.ЦенаВключаетНДС ТОГДА Т.Сумма - Т.СуммаНДС ИНАЧЕ Т.Сумма КОНЕЦ";
		КонецЕсли;
		Возврат "Т.Сумма";
	КонецЕсли;
	Возврат "0";

КонецФункции

&НаСервере
Функция СтрокиДокументов(ИмяДокумента, П)

	// строки «Товары» проведённых документов с начала прошлого месяца по дату отчёта:
	// день, контрагент, номенклатура, количество, сумма без НДС
	Мета = Метаданные.Документы.Найти(ИмяДокумента);
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет документа " + ИмяДокумента + " с табличной частью Товары";
	КонецЕсли;
	РекКонтрагент = РеквизитКоллекции(Мета.Реквизиты, "Контрагент,Партнер");
	ПолеКонтрагента = ?(РекКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекКонтрагент);
	ПолеВалюты = ?(Мета.Реквизиты.Найти("Валюта") = Неопределено, "НЕОПРЕДЕЛЕНО", "Т.Ссылка.Валюта");
	ОтборОрганизации = ?(ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Т.Ссылка.Организация = &Организация", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК День,
		|	" + ПолеКонтрагента + " КАК Контрагент,
		|	Т.Номенклатура КАК Номенклатура,
		|	" + ПолеВалюты + " КАК Валюта,
		|	СУММА(Т.Количество) КАК Количество,
		|	СУММА(" + ВыражениеСуммыБезНДС(ИмяДокумента) + ") КАК Сумма
		|ИЗ
		|	Документ." + ИмяДокумента + ".Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецДня" + ОтборОрганизации + "
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ),
		|	" + ?(ПолеВалюты = "НЕОПРЕДЕЛЕНО", "", ПолеВалюты + ",") + "
		|	" + ?(РекКонтрагент = "", "", ПолеКонтрагента + ",
		|	") + "Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	// «за 30 дней» может начинаться раньше прошлого месяца (1-го марта — 31 января)
	Запрос.УстановитьПараметр("НачалоПериода", Мин(П.НачалоПрошлогоМесяца, П.Начало30));
	Строки = Запрос.Выполнить().Выгрузить();
	ПересчитатьВРубли(Строки, "День");
	Возврат Строки;

КонецФункции

// Суммы документов в валюте (импорт) — в рубли по курсу на дату; рублёвые не меняются.
&НаСервере
Процедура ПересчитатьВРубли(Строки, ПолеДаты)

	Если Строки.Колонки.Найти("Валюта") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВалютаРегл = Неопределено;
	Попытка
		ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	Исключение
		Возврат;
	КонецПопытки;
	Курсы = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Валюта) ИЛИ Стр.Валюта = ВалютаРегл Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка(Стр.Валюта.УникальныйИдентификатор()) + Формат(Стр[ПолеДаты], "ДФ=yyyyMMdd");
		Коэффициент = Курсы[Ключ];
		Если Коэффициент = Неопределено Тогда
			Коэффициент = 1;
			Попытка
				Курс = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Стр.Валюта, КонецДня(Стр[ПолеДаты]));
				Если Курс.Кратность > 0 Тогда
					Коэффициент = Курс.Курс / Курс.Кратность;
				КонецЕсли;
			Исключение
				Коэффициент = 1;
			КонецПопытки;
			Курсы.Вставить(Ключ, Коэффициент);
		КонецЕсли;
		Стр.Сумма = Стр.Сумма * Коэффициент;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СвестиПоПериодам(Строки, П, ПолеГруппы)

	// сводка по номенклатуре или контрагенту: текущий месяц, тот же период прошлого месяца,
	// весь прошлый месяц, последние 30 дней
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Ключ");
	Т.Колонки.Добавить("Количество", ОписаниеЧисла());
	Т.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Т.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	Т.Колонки.Добавить("КоличествоПрошл", ОписаниеЧисла());
	Т.Колонки.Добавить("СуммаПрошл", ОписаниеЧисла());
	Т.Колонки.Добавить("КоличествоПрошлМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("СуммаПрошлМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("Количество30", ОписаниеЧисла());
	Для Каждого Стр Из Строки Цикл
		НовСтр = Т.Добавить();
		НовСтр.Ключ = Стр[ПолеГруппы];
		Если Стр.День >= П.НачалоМесяца Тогда
			НовСтр.Количество = Стр.Количество;
			НовСтр.Сумма = Стр.Сумма;
			Если Стр.День = П.День Тогда
				НовСтр.ЗаДень = Стр.Сумма;
			КонецЕсли;
		ИначеЕсли Стр.День >= П.НачалоПрошлогоМесяца Тогда
			НовСтр.КоличествоПрошлМесяц = Стр.Количество;
			НовСтр.СуммаПрошлМесяц = Стр.Сумма;
			Если Стр.День <= П.КонецПрошлогоПериода Тогда
				НовСтр.КоличествоПрошл = Стр.Количество;
				НовСтр.СуммаПрошл = Стр.Сумма;
			КонецЕсли;
		КонецЕсли;
		Если Стр.День >= П.Начало30 Тогда
			НовСтр.Количество30 = Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	Т.Свернуть("Ключ", "Количество, Сумма, ЗаДень, КоличествоПрошл, СуммаПрошл, КоличествоПрошлМесяц, СуммаПрошлМесяц, Количество30");
	Т.Сортировать("Сумма Убыв, СуммаПрошлМесяц Убыв");
	Возврат Т;

КонецФункции

// Группа каждой позиции: папка справочника «Номенклатура», а если её нет — вид номенклатуры.
// Одно правило для всех разделов отчёта — как в «Продажах».
&НаСервере
Функция ГруппыПозиций(Список)

	ГруппаПозиции = Новый Соответствие;
	МетаНом = Метаданные.Справочники.Найти("Номенклатура");
	Если МетаНом <> Неопределено И Список.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Н.Ссылка КАК Ссылка,
			|	" + ?(МетаНом.Иерархический, "Н.Родитель", "НЕОПРЕДЕЛЕНО") + " КАК Родитель,
			|	" + ?(МетаНом.Реквизиты.Найти("ВидНоменклатуры") <> Неопределено, "Н.ВидНоменклатуры", "НЕОПРЕДЕЛЕНО") + " КАК Вид
			|ИЗ
			|	Справочник.Номенклатура КАК Н
			|ГДЕ
			|	Н.Ссылка В (&Список)";
		Запрос.УстановитьПараметр("Список", Список);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ГруппаПозиции.Вставить(Выборка.Ссылка, ?(ЗначениеЗаполнено(Выборка.Родитель), Выборка.Родитель,
				?(ЗначениеЗаполнено(Выборка.Вид), Выборка.Вид, "Без группы")));
		КонецЦикла;
	КонецЕсли;
	Возврат ГруппаПозиции;

КонецФункции

// Строки таблицы (или массива строк) по группам номенклатуры. Внутри группы — исходный порядок строк;
// группы — по убыванию суммы поля ПолеВеса (если задано), иначе в порядке первой позиции.
&НаСервере
Функция ГруппыНоменклатуры(Строки, ИмяПоля = "Номенклатура", ПолеВеса = "")

	Список = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Список.Добавить(Стр[ИмяПоля]);
	КонецЦикла;
	ГруппаПозиции = ГруппыПозиций(Список);
	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Группа");
	Группы.Колонки.Добавить("Позиции");
	Группы.Колонки.Добавить("Ед");
	Группы.Колонки.Добавить("ОднаЕд", Новый ОписаниеТипов("Булево"));
	Группы.Колонки.Добавить("Вес", ОписаниеЧисла());
	Группы.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Для Каждого Стр Из Строки Цикл
		Группа = ГруппаПозиции[Стр[ИмяПоля]];
		Если Группа = Неопределено Тогда
			Группа = "Без группы";
		КонецЕсли;
		Гр = Группы.Найти(Группа, "Группа");
		Ед = "";
		Попытка
			Ед = Стр.Ед;
		Исключение
			Ед = "";
		КонецПопытки;
		Если Гр = Неопределено Тогда
			Гр = Группы.Добавить();
			Гр.Группа = Группа;
			Гр.Позиции = Новый Массив;
			Гр.Ед = Ед;
			Гр.ОднаЕд = Истина;
			Гр.Порядок = Группы.Количество();
		КонецЕсли;
		Гр.Позиции.Добавить(Стр);
		Если Гр.Ед <> Ед Тогда
			Гр.ОднаЕд = Ложь;
		КонецЕсли;
		Если ПолеВеса <> "" Тогда
			Гр.Вес = Гр.Вес + ЧислоИлиНоль(Стр[ПолеВеса]);
		КонецЕсли;
	КонецЦикла;
	Группы.Сортировать(?(ПолеВеса = "", "Порядок", "Вес Убыв, Порядок"));
	Возврат Группы;

КонецФункции

// Строка группы как в «Продажах»: название (число позиций), итоги колонок.
// Колонки — «2:Поле:к,3:Поле:ч»: к — количество (с единицей, если она у группы одна), ч — число/деньги.
&НаСервере
Процедура ВывестиСтрокуГруппы(В, Гр, Колонки, ДоКолонки)

	Фон = Новый Цвет(226, 240, 238);
	Ячейка(В, 1, Строка(Гр.Группа) + " (" + Гр.Позиции.Количество() + ")", Истина, ЦветАкцент(), Фон, , , Истина);
	Итоги = Новый Соответствие;
	Для Каждого Описание Из СтрРазделить(Колонки, ",", Ложь) Цикл
		Части = СтрРазделить(Описание, ":");
		Итоги.Вставить(Число(Части[0]), Части);
	КонецЦикла;
	Для НомерКолонки = 2 По ДоКолонки Цикл
		Части = Итоги[НомерКолонки];
		Если Части = Неопределено Тогда
			Ячейка(В, НомерКолонки, "", , , Фон);
			Продолжить;
		КонецЕсли;
		Сумма = 0;
		Для Каждого Стр Из Гр.Позиции Цикл
			Сумма = Сумма + ЧислоИлиНоль(Стр[Части[1]]);
		КонецЦикла;
		Если Части[2] = "к" Тогда
			Если Гр.ОднаЕд Тогда
				Ячейка(В, НомерКолонки, ?(Сумма = 0, "—", ФорматЧисла(Сумма) + ?(ЗначениеЗаполнено(Гр.Ед), " " + Гр.Ед, "")), Истина, , Фон);
			Иначе
				Ячейка(В, НомерКолонки, "разные ед.", , ЦветПриглушенный(), Фон);
			КонецЕсли;
			ВПраво(В, НомерКолонки, НомерКолонки);
		Иначе
			ЯчейкаЧисло(В, НомерКолонки, Сумма, , Истина, Фон);
		КонецЕсли;
	КонецЦикла;
	РасшифровкаСтроки(В, Гр.Группа, ДоКолонки);
	СледующаяСтрока(В);

КонецПроцедуры

// Название позиции внутри группы — с отступом и мелким шрифтом, как в «Продажах».
&НаСервере
Процедура ЯчейкаПозиции(В, Текст)

	Ячейка(В, 1, "      " + Текст, , , , 8, , Истина);

КонецПроцедуры

// Строка «…и ещё N поз.», если в группе больше Предел позиций.
&НаСервере
Функция ПрерватьГруппу(В, Гр, Номер, Предел = 15)

	Если Номер <= Предел Тогда
		Возврат Ложь;
	КонецЕсли;
	Ячейка(В, 1, "      …и ещё " + (Гр.Позиции.Количество() - Предел) + " поз.", , ЦветПриглушенный(), , 8, 8);
	СледующаяСтрока(В);
	Возврат Истина;

КонецФункции

&НаСервере
Функция ГруппыПродаж(ПоНоменклатуре)

	ГруппаПозиции = ГруппыПозиций(ПоНоменклатуре.ВыгрузитьКолонку("Ключ"));

	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Группа");
	Группы.Колонки.Добавить("Позиции");
	Группы.Колонки.Добавить("Ед");
	Группы.Колонки.Добавить("ОднаЕд", Новый ОписаниеТипов("Булево"));
	Группы.Колонки.Добавить("Количество", ОписаниеЧисла());
	Группы.Колонки.Добавить("КоличествоПрошлМесяц", ОписаниеЧисла());
	Группы.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Группы.Колонки.Добавить("СуммаПрошл", ОписаниеЧисла());
	Группы.Колонки.Добавить("СуммаПрошлМесяц", ОписаниеЧисла());
	Группы.Колонки.Добавить("СуммаОстальных", ОписаниеЧисла());
	Группы.Колонки.Добавить("Цена", ОписаниеЧисла());
	Группы.Колонки.Добавить("ЦенаПрошлМесяц", ОписаниеЧисла());
	Группы.Колонки.Добавить("ИзмЦены");
	Для Каждого Стр Из ПоНоменклатуре Цикл
		Если Стр.Сумма = 0 И Стр.СуммаПрошл = 0 И Стр.СуммаПрошлМесяц = 0 Тогда
			Продолжить;
		КонецЕсли;
		Группа = ГруппаПозиции[Стр.Ключ];
		Если Группа = Неопределено Тогда
			Группа = "Без группы";
		КонецЕсли;
		Гр = Группы.Найти(Группа, "Группа");
		Если Гр = Неопределено Тогда
			Гр = Группы.Добавить();
			Гр.Группа = Группа;
			Гр.Позиции = Новый Массив;
			Гр.Ед = Стр.Ед;
			Гр.ОднаЕд = Истина;
		КонецЕсли;
		Гр.Позиции.Добавить(Стр);
		Если Гр.Ед <> Стр.Ед Тогда
			Гр.ОднаЕд = Ложь;
		КонецЕсли;
		Гр.Количество = Гр.Количество + Стр.Количество;
		Гр.КоличествоПрошлМесяц = Гр.КоличествоПрошлМесяц + Стр.КоличествоПрошлМесяц;
		Гр.Сумма = Гр.Сумма + Стр.Сумма;
		Гр.СуммаПрошл = Гр.СуммаПрошл + Стр.СуммаПрошл;
		Гр.СуммаПрошлМесяц = Гр.СуммаПрошлМесяц + Стр.СуммаПрошлМесяц;
		Если Гр.Позиции.Количество() > 15 Тогда
			Гр.СуммаОстальных = Гр.СуммаОстальных + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Гр Из Группы Цикл
		Если НЕ Гр.ОднаЕд Тогда
			Гр.Ед = "";
			Продолжить;
		КонецЕсли;
		Гр.Цена = ?(Гр.Количество = 0, 0, Гр.Сумма / Гр.Количество);
		Гр.ЦенаПрошлМесяц = ?(Гр.КоличествоПрошлМесяц = 0, 0, Гр.СуммаПрошлМесяц / Гр.КоличествоПрошлМесяц);
		Если Гр.Цена > 0 И Гр.ЦенаПрошлМесяц > 0 Тогда
			Гр.ИзмЦены = (Гр.Цена / Гр.ЦенаПрошлМесяц - 1) * 100;
		КонецЕсли;
	КонецЦикла;
	Группы.Сортировать("Сумма Убыв, СуммаПрошлМесяц Убыв");
	Возврат Группы;

КонецФункции

&НаСервере
Функция ПолучитьПродажи(П)

	// выручка — из регистра ERP «Выручка и себестоимость продаж» (по нему строится стандартный
	// отчёт «Валовая прибыль», возвраты уже вычтены); если он пуст — по документам реализации
	Строки = Неопределено;
	ОшибкаРегистра = "";
	Попытка
		Строки = СтрокиВыручки(П);
	Исключение
		Строки = Неопределено;
		ОшибкаРегистра = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Строки <> Неопределено И Строки.Итог("Сумма") <> 0 Тогда
		Р = ПолучитьОбороты("", П, Строки);
		Р.Вставить("Источник", "регистр «Выручка и себестоимость продаж», без НДС, за вычетом возвратов");
	Иначе
		Р = ПолучитьОбороты("РеализацияТоваровУслуг", П);
		Р.Вставить("Источник", "документы «Реализация товаров и услуг», без НДС; возвраты не вычтены"
			+ ?(ОшибкаРегистра = "", "", " (регистр выручки не прочитан: " + ОшибкаРегистра + ")"));
	КонецЕсли;
	Возврат Р;

КонецФункции

&НаСервере
Функция СтрокиВыручки(П)

	Рег = "ВыручкаИСебестоимостьПродаж";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выручка = РесурсРегистра(Рег, "СуммаВыручкиБезНДС,СуммаВыручкиРегл,СуммаВыручки");
	Если Выручка = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Количество = РесурсРегистра(Рег, "Количество");
	ПолеНоменклатуры = "НЕОПРЕДЕЛЕНО";
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаНоменклатуры") <> "" Тогда
		ПолеНоменклатуры = "Т.АналитикаУчетаНоменклатуры.Номенклатура";
	ИначеЕсли ИзмерениеРегистра(Рег, "Номенклатура") <> "" Тогда
		ПолеНоменклатуры = "Т.Номенклатура";
	КонецЕсли;
	ПолеКонтрагента = "НЕОПРЕДЕЛЕНО";
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаПоПартнерам") <> "" Тогда
		ПолеКонтрагента = "Т.АналитикаУчетаПоПартнерам.Контрагент";
	ИначеЕсли ИзмерениеРегистра(Рег, "Контрагент,Партнер") <> "" Тогда
		ПолеКонтрагента = "Т." + ИзмерениеРегистра(Рег, "Контрагент,Партнер");
	КонецЕсли;
	Группировки = Новый Массив;
	Группировки.Добавить("Т.Период");
	Если ПолеНоменклатуры <> "НЕОПРЕДЕЛЕНО" Тогда
		Группировки.Добавить(ПолеНоменклатуры);
	КонецЕсли;
	Если ПолеКонтрагента <> "НЕОПРЕДЕЛЕНО" Тогда
		Группировки.Добавить(ПолеКонтрагента);
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Период КАК День,
		|	" + ПолеКонтрагента + " КАК Контрагент,
		|	" + ПолеНоменклатуры + " КАК Номенклатура,
		|	" + ?(Количество = "", "0", "СУММА(Т." + Количество + "Оборот)") + " КАК Количество,
		|	СУММА(Т." + Выручка + "Оборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Обороты(&НачалоПериода, &КонецДня, День" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(Группировки, ",
		|	");
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("НачалоПериода", Мин(П.НачалоПрошлогоМесяца, П.Начало30));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ПолучитьОбороты(ИмяДокумента, П, Знач Строки = Неопределено)

	Если Строки = Неопределено Тогда
		Строки = СтрокиДокументов(ИмяДокумента, П);
	КонецЕсли;
	Р = Новый Структура;
	Р.Вставить("ПоНоменклатуре", СвестиПоПериодам(Строки, П, "Номенклатура"));
	Р.Вставить("ПоКонтрагентам", СвестиПоПериодам(Строки, П, "Контрагент"));
	Т = Р.ПоНоменклатуре;
	Р.Вставить("ЗаДень", Т.Итог("ЗаДень"));
	Р.Вставить("Месяц", Т.Итог("Сумма"));
	Р.Вставить("ПрошлыйПериод", Т.Итог("СуммаПрошл"));
	Р.Вставить("ПрошлыйМесяц", Т.Итог("СуммаПрошлМесяц"));
	Р.Вставить("Изменение", ?(Р.ПрошлыйПериод <= 0, Неопределено, (Р.Месяц / Р.ПрошлыйПериод - 1) * 100));
	Т.Колонки.Добавить("Ед");
	Т.Колонки.Добавить("Цена", ОписаниеЧисла());
	Т.Колонки.Добавить("ЦенаПрошлМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("ИзмЦены");
	Цены = Новый Соответствие;
	Для Каждого Стр Из Т Цикл
		Стр.Ед = ЕдиницаНоменклатуры(Стр.Ключ);
		Стр.Цена = ?(Стр.Количество = 0, 0, Стр.Сумма / Стр.Количество);
		Стр.ЦенаПрошлМесяц = ?(Стр.КоличествоПрошлМесяц = 0, 0, Стр.СуммаПрошлМесяц / Стр.КоличествоПрошлМесяц);
		Если Стр.Цена > 0 И Стр.ЦенаПрошлМесяц > 0 Тогда
			Стр.ИзмЦены = (Стр.Цена / Стр.ЦенаПрошлМесяц - 1) * 100;
		КонецЕсли;
		Цены.Вставить(Стр.Ключ, ?(Стр.Цена > 0, Стр.Цена, Стр.ЦенаПрошлМесяц));
	КонецЦикла;
	Р.Вставить("Цены", Цены);
	Возврат Р;

КонецФункции

&НаСервере
Функция ПолучитьМаржу(П)

	// прибыль по прямым затратам по продуктам из регистра выручки и себестоимости ERP;
	// себестоимость текущего месяца появляется после закрытия месяца
	Рег = "ВыручкаИСебестоимостьПродаж";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистра ВыручкаИСебестоимостьПродаж";
	КонецЕсли;
	Выручка = РесурсРегистра(Рег, "СуммаВыручкиБезНДС,СуммаВыручкиРегл,СуммаВыручки");
	Состав = СоставСебестоимости(Рег, Ложь);
	Если Выручка = "" ИЛИ Состав.Количество() = 0 Тогда
		ВызватьИсключение "в регистре " + Рег + " не найдены ресурсы выручки и себестоимости";
	КонецЕсли;
	ПолеНоменклатуры = "НЕОПРЕДЕЛЕНО";
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаНоменклатуры") <> "" Тогда
		ПолеНоменклатуры = "Т.АналитикаУчетаНоменклатуры.Номенклатура";
	ИначеЕсли ИзмерениеРегистра(Рег, "Номенклатура") <> "" Тогда
		ПолеНоменклатуры = "Т.Номенклатура";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Период КАК Период,
		|	" + ПолеНоменклатуры + " КАК Номенклатура,
		|	СУММА(Т." + Выручка + "Оборот) КАК Выручка,
		|	" + ПоляСебестоимости(Состав) + "
		|ИЗ
		|	РегистрНакопления." + Рег + ".Обороты(&НачалоПрошлогоМесяца, &КонецДня, Месяц" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Период" + ?(ПолеНоменклатуры = "НЕОПРЕДЕЛЕНО", "", ",
		|	" + ПолеНоменклатуры);
	УстановитьПараметры(Запрос, П);
	Строки = Запрос.Выполнить().Выгрузить();
	Ресурсы = РазложитьСебестоимость(Строки, Состав);

	Р = Новый Структура;
	Р.Вставить("РесурсСебестоимости", Ресурсы);
	Для Каждого Период Из СтрРазделить("Прошлый,Текущий", ",") Цикл
		Начало = ?(Период = "Текущий", П.НачалоМесяца, П.НачалоПрошлогоМесяца);
		Т = Новый ТаблицаЗначений;
		Т.Колонки.Добавить("Номенклатура");
		Т.Колонки.Добавить("Выручка", ОписаниеЧисла());
		Т.Колонки.Добавить("Прямые", ОписаниеЧисла());
		Т.Колонки.Добавить("Косвенные", ОписаниеЧисла());
		Для Каждого Стр Из Строки Цикл
			Если НачалоМесяца(Стр.Период) = Начало Тогда
				ЗаполнитьЗначенияСвойств(Т.Добавить(), Стр);
			КонецЕсли;
		КонецЦикла;
		Т.Свернуть("Номенклатура", "Выручка, Прямые, Косвенные");
		Т.Колонки.Добавить("Прибыль", ОписаниеЧисла());
		Т.Колонки.Добавить("Рентабельность");
		Для Каждого Стр Из Т Цикл
			Стр.Прибыль = Стр.Выручка - Стр.Прямые;
			Стр.Рентабельность = ?(Стр.Выручка = 0, Неопределено, Стр.Прибыль / Стр.Выручка * 100);
		КонецЦикла;
		Т.Сортировать("Выручка Убыв");
		Р.Вставить(Период, Т);
	КонецЦикла;
	Р.Вставить("СебестоимостьТекущего", Р.Текущий.Итог("Прямые") + Р.Текущий.Итог("Косвенные"));
	Р.Вставить("СебестоимостьПрошлого", Р.Прошлый.Итог("Прямые") + Р.Прошлый.Итог("Косвенные"));
	Р.Вставить("КосвенныеПрошлого", Р.Прошлый.Итог("Косвенные"));
	Р.Вставить("КосвенныеТекущего", Р.Текущий.Итог("Косвенные"));
	Возврат Р;

КонецФункции

// Части себестоимости в регистре ERP «Выручка и себестоимость продаж».
// Прямые: материалы (стоимость), доп. расходы, трудозатраты, постатейные переменные.
// Косвенные: постатейные постоянные (общепроизводственные, распределённые на продукцию).
// Для каждой части — варианты ресурса по порядку; берётся первый, в котором за период есть суммы.
&НаСервере
Функция СоставСебестоимости(Рег, Регл)

	Если Регл Тогда
		Варианты = "Прямые:СтоимостьРегл|Прямые:ДопРасходыРегл,СтоимостьДопРасходыРегл|Прямые:ТрудозатратыРегл"
			+ "|Прямые:ПостатейныеПеременныеРегл|Косвенные:ПостатейныеПостоянныеРегл";
	Иначе
		// одна оценка для всех частей — как у выручки (управленческая, без НДС); регл. и «с НДС» не смешиваем
		Варианты = "Прямые:СтоимостьБезНДС"
			+ "|Прямые:ДопРасходыБезНДС,СтоимостьДопРасходыБезНДС"
			+ "|Прямые:Трудозатраты"
			+ "|Прямые:ПостатейныеПеременныеБезНДС"
			+ "|Косвенные:ПостатейныеПостоянныеБезНДС";
	КонецЕсли;
	Состав = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Варианты, "|") Цикл
		Пара = СтрРазделить(Часть, ":");
		Имена = Новый Массив;
		Для Каждого Имя Из СтрРазделить(Пара[1], ",") Цикл
			Если РесурсРегистра(Рег, Имя) <> "" Тогда
				Имена.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Если Имена.Количество() > 0 Тогда
			Состав.Добавить(Новый Структура("Вид, Имена", Пара[0], Имена));
		КонецЕсли;
	КонецЦикла;
	Возврат Состав;

КонецФункции

&НаСервере
Функция ПоляСебестоимости(Состав)

	Поля = Новый Массив;
	Для Каждого Часть Из Состав Цикл
		Для Каждого Имя Из Часть.Имена Цикл
			Поля.Добавить("СУММА(Т." + Имя + "Оборот) КАК " + Имя);
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Поля, ",
	|	");

КонецФункции

// Добавляет в строки колонки «Прямые» и «Косвенные»; возвращает, какие ресурсы взяты.
&НаСервере
Функция РазложитьСебестоимость(Строки, Состав)

	Строки.Колонки.Добавить("Прямые", ОписаниеЧисла());
	Строки.Колонки.Добавить("Косвенные", ОписаниеЧисла());
	Взяты = Новый Массив;
	Для Каждого Часть Из Состав Цикл
		Выбранный = "";
		Для Каждого Имя Из Часть.Имена Цикл
			Если Строки.Итог(Имя) <> 0 Тогда
				Выбранный = Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Выбранный = "" Тогда
			Продолжить;
		КонецЕсли;
		Взяты.Добавить(Выбранный + " (" + НРег(Часть.Вид) + ")");
		Для Каждого Стр Из Строки Цикл
			Стр[Часть.Вид] = Стр[Часть.Вид] + ЧислоИлиНоль(Стр[Выбранный]);
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Взяты, ", ");

КонецФункции

&НаСервере
Функция ПолучитьЗапасы(П, Выпуск, Продажи, Заказы)

	// готовая продукция: всё, что выпускали (кроме полуфабрикатов) или продавали за два месяца,
	// и всё, что есть в открытых заказах клиентов
	Продукты = Новый Массив;
	Если Выпуск <> Неопределено Тогда
		Для Каждого Стр Из Выпуск.ПоПродуктам Цикл
			Если НЕ Стр.Полуфабрикат Тогда
				Продукты.Добавить(Стр.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Продажи <> Неопределено Тогда
		Для Каждого Стр Из Продажи.ПоНоменклатуре Цикл
			Если Продукты.Найти(Стр.Ключ) = Неопределено И Продукты.Количество() < 1000 И НЕ ЭтоУслуга(Стр.Ключ) Тогда
				Продукты.Добавить(Стр.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Заказы <> Неопределено Тогда
		Для Каждого Стр Из Заказы.Продукты Цикл
			Если Продукты.Найти(Стр.Номенклатура) = Неопределено И Продукты.Количество() < 1000 И НЕ ЭтоУслуга(Стр.Номенклатура) Тогда
				Продукты.Добавить(Стр.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Продукты.Количество() = 0 Тогда
		ВызватьИсключение "нет данных о выпуске и продажах, не понятно, что считать готовой продукцией";
	КонецЕсли;
	Остатки = ОстаткиНаСкладах(Продукты, П);

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Номенклатура");
	Т.Колонки.Добавить("Ед");
	Т.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Т.Колонки.Добавить("ОтгрузкиВСутки", ОписаниеЧисла());
	Т.Колонки.Добавить("ВыпускВСутки", ОписаниеЧисла());
	Т.Колонки.Добавить("ВЗаказах", ОписаниеЧисла());
	Т.Колонки.Добавить("НеХватает", ОписаниеЧисла());
	Т.Колонки.Добавить("ДнейЗапаса", ОписаниеЧисла());
	Т.Колонки.Добавить("Статус");
	Т.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Для Каждого Ном Из Продукты Цикл
		НовСтр = Т.Добавить();
		НовСтр.Номенклатура = Ном;
		НовСтр.Ед = ЕдиницаНоменклатуры(Ном);
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Ном]);
		Если Продажи <> Неопределено Тогда
			Стр = Продажи.ПоНоменклатуре.Найти(Ном, "Ключ");
			Если Стр <> Неопределено Тогда
				НовСтр.ОтгрузкиВСутки = Стр.Количество30 / 30;
			КонецЕсли;
		КонецЕсли;
		Если Выпуск <> Неопределено Тогда
			Стр = Выпуск.ПоПродуктам.Найти(Ном, "Номенклатура");
			Если Стр <> Неопределено Тогда
				НовСтр.ВыпускВСутки = Стр.За30Дней / 30;
			КонецЕсли;
		КонецЕсли;
		Если Заказы <> Неопределено Тогда
			Стр = Заказы.Продукты.Найти(Ном, "Номенклатура");
			Если Стр <> Неопределено Тогда
				НовСтр.ВЗаказах = Стр.Осталось;
			КонецЕсли;
		КонецЕсли;
		НовСтр.НеХватает = Макс(0, НовСтр.ВЗаказах - НовСтр.Остаток);
		НовСтр.Статус = "в норме";
		НовСтр.Порядок = 2;
		Если НовСтр.ОтгрузкиВСутки > 0 Тогда
			НовСтр.ДнейЗапаса = НовСтр.Остаток / НовСтр.ОтгрузкиВСутки;
			Если НовСтр.ДнейЗапаса < 3 И НовСтр.ВЗаказах > НовСтр.Остаток Тогда
				НовСтр.Статус = "мало";
				НовСтр.Порядок = 0;
			ИначеЕсли НовСтр.ДнейЗапаса > 45 Тогда
				НовСтр.Статус = "затоваривание";
				НовСтр.Порядок = 1;
			КонецЕсли;
		ИначеЕсли НовСтр.Остаток > 0 Тогда
			НовСтр.Статус = "нет продаж 30 дн.";
			НовСтр.Порядок = 1;
		КонецЕсли;
		Если НовСтр.Остаток = 0 И НовСтр.ОтгрузкиВСутки = 0 И НовСтр.ВЗаказах = 0 Тогда
			Т.Удалить(НовСтр);
		КонецЕсли;
	КонецЦикла;
	// только крупные: по стоимости остатка (цена продажи), мелочь — одной строкой «прочие»
	Т.Колонки.Добавить("Стоимость", ОписаниеЧисла());
	Для Каждого Стр Из Т Цикл
		Цена = 0;
		Если Продажи <> Неопределено Тогда
			Продажа = Продажи.ПоНоменклатуре.Найти(Стр.Номенклатура, "Ключ");
			Если Продажа <> Неопределено Тогда
				Цена = ?(Продажа.Цена > 0, Продажа.Цена, Продажа.ЦенаПрошлМесяц);
			КонецЕсли;
		КонецЕсли;
		Стр.Стоимость = Стр.Остаток * Цена;
	КонецЦикла;
	ВсегоСтоимость = Т.Итог("Стоимость");
	Т.Сортировать("Стоимость Убыв, Остаток Убыв");
	// все позиции по номенклатуре, как в других разделах
	Р = Новый Структура("Таблица, Всего", Т, ВсегоСтоимость);
	Р.Вставить("ОсталосьОтгрузить", Т.Итог("ВЗаказах"));
	Р.Вставить("НеХватает", Т.Итог("НеХватает"));
	Возврат Р;

КонецФункции

&НаСервере
Функция РеквизитыДокументов(Ссылки, Поля)

	// значения реквизитов для многих документов разных видов: один запрос на вид документа.
	// Поля — Структура: ключ результата → варианты имени реквизита через запятую.
	Результат = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Попытка
			Вид = Ссылка.Метаданные().ПолноеИмя();
		Исключение
			Продолжить;
		КонецПопытки;
		Если ПоВидам[Вид] = Неопределено Тогда
			ПоВидам.Вставить(Вид, Новый Массив);
		КонецЕсли;
		ПоВидам[Вид].Добавить(Ссылка);
	КонецЦикла;
	Для Каждого Элемент Из ПоВидам Цикл
		Мета = Элемент.Значение[0].Метаданные();
		Имена = Новый Структура;
		Список = Новый Массив;
		Для Каждого Поле Из Поля Цикл
			Имя = РеквизитКоллекции(Мета.Реквизиты, Поле.Значение);
			Имена.Вставить(Поле.Ключ, Имя);
			Если Имя <> "" И Список.Найти(Имя) = Неопределено Тогда
				Список.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Если Список.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Элемент.Значение, СтрСоединить(Список, ","));
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого Ссылка Из Элемент.Значение Цикл
			ЗначенияСсылки = Значения[Ссылка];
			Стр = Новый Структура;
			Для Каждого Поле Из Имена Цикл
				Стр.Вставить(Поле.Ключ, ?(Поле.Значение = "" ИЛИ ЗначенияСсылки = Неопределено, Неопределено, ЗначенияСсылки[Поле.Значение]));
			КонецЦикла;
			Результат.Вставить(Ссылка, Стр);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЦеныЗакупокИПотребность

&НаСервере
Функция ЭтоУслуга(Номенклатура)

	ТипНоменклатуры = НРег(Строка(РеквизитСсылки(Номенклатура, "ТипНоменклатуры")));
	Возврат СтрНайти(ТипНоменклатуры, "услуг") > 0 ИЛИ СтрНайти(ТипНоменклатуры, "работ") > 0;

КонецФункции

&НаСервере
Функция ПолучитьЗакупкиГод(П)

	// закупки за 12 месяцев: средняя цена по месяцам, разброс, изменение за год,
	// сравнение поставщиков за последние 3 месяца
	Мета = Метаданные.Документы.Найти("ПриобретениеТоваровУслуг");
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет документа ПриобретениеТоваровУслуг с табличной частью Товары";
	КонецЕсли;
	РекКонтрагент = РеквизитКоллекции(Мета.Реквизиты, "Контрагент,Партнер");
	ПолеКонтрагента = ?(РекКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекКонтрагент);
	ОтборОрганизации = ?(ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Т.Ссылка.Организация = &Организация", "");
	ПолеВалюты = ?(Мета.Реквизиты.Найти("Валюта") = Неопределено, "НЕОПРЕДЕЛЕНО", "Т.Ссылка.Валюта");
	ОтборГруппы = ?(ЗначениеЗаполнено(П.ГруппаСырья), "
		|	И Т.Номенклатура В ИЕРАРХИИ (&ГруппаСырья)", "");
	НачалоГода = ДобавитьМесяц(П.НачалоМесяца, -11);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ) КАК Месяц,
		|	" + ПолеКонтрагента + " КАК Контрагент,
		|	Т.Номенклатура КАК Номенклатура,
		|	" + ПолеВалюты + " КАК Валюта,
		|	СУММА(Т.Количество) КАК Количество,
		|	СУММА(" + ВыражениеСуммыБезНДС("ПриобретениеТоваровУслуг") + ") КАК Сумма
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &НачалоГода И &КонецДня" + ОтборОрганизации + ОтборГруппы + "
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ),
		|	" + ?(ПолеВалюты = "НЕОПРЕДЕЛЕНО", "", ПолеВалюты + ",") + "
		|	" + ?(РекКонтрагент = "", "", ПолеКонтрагента + ",
		|	") + "Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода);
	Строки = Запрос.Выполнить().Выгрузить();
	ПересчитатьВРубли(Строки, "Месяц");

	Месяцы = Новый Массив;
	Для Н = 0 По 11 Цикл
		Месяцы.Добавить(ДобавитьМесяц(НачалоГода, Н));
	КонецЦикла;

	Итоги = Строки.Скопировать(, "Номенклатура, Количество, Сумма");
	Итоги.Свернуть("Номенклатура", "Количество, Сумма");
	Итоги.Сортировать("Сумма Убыв");
	ПоМесяцам = Строки.Скопировать(, "Номенклатура, Месяц, Количество, Сумма");
	ПоМесяцам.Свернуть("Номенклатура, Месяц", "Количество, Сумма");
	ПоМесяцам.Сортировать("Месяц");

	// последняя известная цена закупки по каждой позиции
	Последние = Новый Соответствие;
	Для Каждого Стр Из ПоМесяцам Цикл
		Если Стр.Количество > 0 И Стр.Сумма > 0 Тогда
			Последние.Вставить(Стр.Номенклатура, Стр.Сумма / Стр.Количество);
		КонецЕсли;
	КонецЦикла;

	Материалы = Новый ТаблицаЗначений;
	Материалы.Колонки.Добавить("Номенклатура");
	Материалы.Колонки.Добавить("Ед");
	Материалы.Колонки.Добавить("Количество", ОписаниеЧисла());
	Материалы.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Материалы.Колонки.Добавить("МинЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("МаксЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("ПерваяЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("ПервыйМесяц");
	Материалы.Колонки.Добавить("ПоследняяЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("ПоследнийМесяц");
	Материалы.Колонки.Добавить("ИзмГод");
	Материалы.Колонки.Добавить("Помесячно");
	Для Каждого Ит Из Итоги Цикл
		Если Материалы.Количество() >= 300 Тогда
			Прервать;
		КонецЕсли;
		Если Ит.Сумма <= 0 ИЛИ Ит.Количество <= 0 ИЛИ ЭтоУслуга(Ит.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Ит);
		НовСтр.Ед = ЕдиницаНоменклатуры(Ит.Номенклатура);
		НовСтр.Помесячно = Новый Соответствие;
		Для Каждого Стр Из ПоМесяцам.НайтиСтроки(Новый Структура("Номенклатура", Ит.Номенклатура)) Цикл
			Если Стр.Количество <= 0 ИЛИ Стр.Сумма <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Цена = Стр.Сумма / Стр.Количество;
			НовСтр.Помесячно.Вставить(Стр.Месяц, Цена);
			Если НовСтр.МинЦена = 0 ИЛИ Цена < НовСтр.МинЦена Тогда
				НовСтр.МинЦена = Цена;
			КонецЕсли;
			НовСтр.МаксЦена = Макс(НовСтр.МаксЦена, Цена);
			Если НовСтр.ПервыйМесяц = Неопределено Тогда
				НовСтр.ПервыйМесяц = Стр.Месяц;
				НовСтр.ПерваяЦена = Цена;
			КонецЕсли;
			НовСтр.ПоследнийМесяц = Стр.Месяц;
			НовСтр.ПоследняяЦена = Цена;
		КонецЦикла;
		Если НовСтр.ПерваяЦена > 0 И НовСтр.ПоследнийМесяц <> НовСтр.ПервыйМесяц Тогда
			НовСтр.ИзмГод = (НовСтр.ПоследняяЦена / НовСтр.ПерваяЦена - 1) * 100;
		КонецЕсли;
	КонецЦикла;

	// поставщики за 3 месяца: кто дешевле по одной и той же позиции
	Начало3 = ДобавитьМесяц(П.НачалоМесяца, -2);
	Последние3 = Строки.СкопироватьКолонки();
	Для Каждого Стр Из Строки Цикл
		Если Стр.Месяц >= Начало3 Тогда
			ЗаполнитьЗначенияСвойств(Последние3.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Последние3.Свернуть("Номенклатура, Контрагент", "Количество, Сумма");
	Сравнение = Новый ТаблицаЗначений;
	Сравнение.Колонки.Добавить("Номенклатура");
	Сравнение.Колонки.Добавить("Контрагент");
	Сравнение.Колонки.Добавить("Ед");
	Сравнение.Колонки.Добавить("Количество", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Цена", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Отклонение", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Переплата", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Лучший", Новый ОписаниеТипов("Булево"));
	Переплата = 0;
	Для Каждого Мат Из Материалы Цикл
		Варианты = Последние3.НайтиСтроки(Новый Структура("Номенклатура", Мат.Номенклатура));
		Если Варианты.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Лучшая = 0;
		Для Каждого Стр Из Варианты Цикл
			Если Стр.Количество > 0 И Стр.Сумма > 0 И (Лучшая = 0 ИЛИ Стр.Сумма / Стр.Количество < Лучшая) Тогда
				Лучшая = Стр.Сумма / Стр.Количество;
			КонецЕсли;
		КонецЦикла;
		Если Лучшая = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Стр Из Варианты Цикл
			Если Стр.Количество <= 0 ИЛИ Стр.Сумма <= 0 Тогда
				Продолжить; // бесплатная или бонусная поставка — не цена поставщика
			КонецЕсли;
			НовСтр = Сравнение.Добавить();
			НовСтр.Номенклатура = Мат.Номенклатура;
			НовСтр.Контрагент = Стр.Контрагент;
			НовСтр.Ед = Мат.Ед;
			НовСтр.Количество = Стр.Количество;
			НовСтр.Цена = Стр.Сумма / Стр.Количество;
			НовСтр.Отклонение = (НовСтр.Цена / Лучшая - 1) * 100;
			НовСтр.Переплата = (НовСтр.Цена - Лучшая) * Стр.Количество;
			НовСтр.Лучший = НовСтр.Отклонение < 0.05;
			Переплата = Переплата + НовСтр.Переплата;
		КонецЦикла;
	КонецЦикла;

	Р = Новый Структура;
	Р.Вставить("Месяцы", Месяцы);
	Р.Вставить("Материалы", Материалы);
	Р.Вставить("Последние", Последние);
	Р.Вставить("Сравнение", Сравнение);
	Р.Вставить("Переплата", Переплата);
	Р.Вставить("ЗаГод", Итоги.Итог("Сумма"));
	Возврат Р;

КонецФункции

// Количество упаковок × коэффициент упаковки (в базовых единицах).
&НаСервере
Функция ВыражениеКоличестваУпаковок(ТЧ, Псевдоним)

	Выражение = Псевдоним + ".КоличествоУпаковок";
	МетаУпаковок = Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения");
	Если ТЧ.Реквизиты.Найти("Упаковка") <> Неопределено И МетаУпаковок <> Неопределено
		И МетаУпаковок.Реквизиты.Найти("Числитель") <> Неопределено И МетаУпаковок.Реквизиты.Найти("Знаменатель") <> Неопределено Тогда
		Выражение = Псевдоним + ".КоличествоУпаковок * ЕСТЬNULL(ВЫБОР КОГДА " + Псевдоним + ".Упаковка.Знаменатель > 0 И "
			+ Псевдоним + ".Упаковка.Числитель > 0 ТОГДА " + Псевдоним + ".Упаковка.Числитель / " + Псевдоним + ".Упаковка.Знаменатель ИНАЧЕ 1 КОНЕЦ, 1)";
	КонецЕсли;
	Возврат Выражение;

КонецФункции

&НаСервере
Функция ВыражениеКоличестваВСпецификации(ТЧ, Псевдоним)

	// количество строки спецификации в базовых единицах номенклатуры:
	// поле «опти_Количество» (если заполнено), иначе количество упаковок × коэффициент упаковки
	ВУпаковках = Псевдоним + ".КоличествоУпаковок";
	МетаУпаковок = Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения");
	Если ТЧ.Реквизиты.Найти("Упаковка") <> Неопределено И МетаУпаковок <> Неопределено
		И МетаУпаковок.Реквизиты.Найти("Числитель") <> Неопределено И МетаУпаковок.Реквизиты.Найти("Знаменатель") <> Неопределено Тогда
		ВУпаковках = Псевдоним + ".КоличествоУпаковок * ЕСТЬNULL(ВЫБОР КОГДА " + Псевдоним + ".Упаковка.Знаменатель > 0 И "
			+ Псевдоним + ".Упаковка.Числитель > 0 ТОГДА " + Псевдоним + ".Упаковка.Числитель / " + Псевдоним + ".Упаковка.Знаменатель ИНАЧЕ 1 КОНЕЦ, 1)";
	КонецЕсли;
	ВБазовых = ?(ТЧ.Реквизиты.Найти("Количество") <> Неопределено, Псевдоним + ".Количество", ВУпаковках);
	Если ТЧ.Реквизиты.Найти("опти_Количество") <> Неопределено Тогда
		Возврат "ВЫБОР КОГДА " + Псевдоним + ".опти_Количество <> 0 ТОГДА " + Псевдоним + ".опти_Количество ИНАЧЕ " + ВБазовых + " КОНЕЦ";
	КонецЕсли;
	Возврат ВБазовых;

КонецФункции

&НаСервере
Функция СпецификацииИзПроизводства(П)

	// какая спецификация последней применялась в суточных рапортах для каждого продукта (90 дней)
	Результат = Новый Соответствие;
	Мета = Метаданные.Документы.Найти("ПроизводствоБезЗаказа");
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("ВыходныеИзделия") = Неопределено
		ИЛИ Мета.ТабличныеЧасти.ВыходныеИзделия.Реквизиты.Найти("Спецификация") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Спецификация КАК Спецификация,
		|	МАКСИМУМ(Т.Ссылка.Дата) КАК Дата
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &Начало90 И &КонецДня
		|	И Т.Спецификация <> ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура,
		|	Т.Спецификация
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	Запрос.УстановитьПараметр("Начало90", П.День - 89 * 86400);
	Запрос.УстановитьПараметр("КонецДня", П.КонецДня);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Спецификация);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция НормыИзСпецификаций(Продукты, П, ЗаданныеСпецификации = Неопределено)

	// нормы на 1 базовую единицу продукта: материал → (норма, статья калькуляции).
	// Спецификация: из плана производства, иначе последняя из суточных рапортов, иначе действующая.
	// Строки со статьёй «Полуфабрикат» раскладываются по спецификации полуфабриката (до 5 уровней).
	Результат = Новый Соответствие;
	МетаСпец = Метаданные.Справочники.Найти("РесурсныеСпецификации");
	Если МетаСпец = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ТЧВыход = МетаСпец.ТабличныеЧасти.Найти("ВыходныеИзделия");
	ТЧМатериалы = МетаСпец.ТабличныеЧасти.Найти("МатериалыИУслуги");
	Если ТЧВыход = Неопределено ИЛИ ТЧМатериалы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьСтатус = МетаСпец.Реквизиты.Найти("Статус") <> Неопределено;
	ЕстьСтатья = ТЧМатериалы.Реквизиты.Найти("СтатьяКалькуляции") <> Неопределено;
	ЕстьДоля = ТЧВыход.Реквизиты.Найти("ДоляСтоимости") <> Неопределено;
	ИзПроизводства = СпецификацииИзПроизводства(П);

	Прямые = Новый Соответствие;
	ВыбраннаяСпецификация = Новый Соответствие;
	Запрошено = Новый Соответствие;
	Очередь = Новый Массив;
	Для Каждого Ном Из Продукты Цикл
		Очередь.Добавить(Ном);
	КонецЦикла;
	Запрос = Новый Запрос;
	Для Уровень = 1 По 5 Цикл
		Список = Новый Массив;
		Для Каждого Ном Из Очередь Цикл
			Если Запрошено[Ном] = Неопределено Тогда
				Список.Добавить(Ном);
				Запрошено.Вставить(Ном, Истина);
			КонецЕсли;
		КонецЦикла;
		Если Список.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// спецификация для каждого продукта
		БезСпецификации = Новый Массив;
		Для Каждого Ном Из Список Цикл
			Спец = Неопределено;
			Если ЗаданныеСпецификации <> Неопределено Тогда
				Спец = ЗаданныеСпецификации[Ном];
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Спец) Тогда
				Спец = ИзПроизводства[Ном];
			КонецЕсли;
			Если ЗначениеЗаполнено(Спец) Тогда
				ВыбраннаяСпецификация.Вставить(Ном, Спец);
			Иначе
				БезСпецификации.Добавить(Ном);
			КонецЕсли;
		КонецЦикла;
		Если БезСпецификации.Количество() > 0 Тогда
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Вых.Ссылка КАК Спецификация,
				|	Вых.Номенклатура КАК Продукт,
				|	" + ?(ЕстьСтатус, "Вых.Ссылка.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус
				|ИЗ
				|	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК Вых
				|ГДЕ
				|	НЕ Вых.Ссылка.ПометкаУдаления
				|	И Вых.Номенклатура В (&Список)";
			Запрос.УстановитьПараметр("Список", БезСпецификации);
			Действующая = Новый Соответствие;
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Действует = НЕ ЕстьСтатус ИЛИ СтрНайти(НРег(Строка(Выборка.Статус)), "действ") > 0;
				Если ВыбраннаяСпецификация[Выборка.Продукт] = Неопределено ИЛИ (Действует И НЕ Действующая[Выборка.Продукт] = Истина) Тогда
					ВыбраннаяСпецификация.Вставить(Выборка.Продукт, Выборка.Спецификация);
					Действующая.Вставить(Выборка.Продукт, Действует);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Спецификации = Новый Массив;
		Для Каждого Ном Из Список Цикл
			Спец = ВыбраннаяСпецификация[Ном];
			Если ЗначениеЗаполнено(Спец) И Спецификации.Найти(Спец) = Неопределено Тогда
				Спецификации.Добавить(Спец);
			КонецЕсли;
		КонецЦикла;
		Если Спецификации.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// сколько продукта выходит по спецификации (в базовых единицах)
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Вых.Ссылка КАК Спецификация,
			|	Вых.Номенклатура КАК Продукт,
			|	" + ?(ЕстьДоля, "СУММА(Вых.ДоляСтоимости)", "0") + " КАК Доля,
			|	СУММА(" + ВыражениеКоличестваВСпецификации(ТЧВыход, "Вых") + ") КАК Выход
			|ИЗ
			|	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК Вых
			|ГДЕ
			|	Вых.Ссылка В (&Спецификации)
			|СГРУППИРОВАТЬ ПО
			|	Вых.Ссылка,
			|	Вых.Номенклатура";
		Запрос.УстановитьПараметр("Спецификации", Спецификации);
		Выходы = Новый Соответствие;
		ДолиВыхода = Новый Соответствие;
		ТаблицаВыходов = Запрос.Выполнить().Выгрузить();
		// спецификация с несколькими выходными изделиями: материалы делятся по долям стоимости,
		// иначе каждому изделию достались бы все материалы
		ДоляВсего = Новый Соответствие;
		Для Каждого Выборка Из ТаблицаВыходов Цикл
			ДоляВсего.Вставить(Выборка.Спецификация, ЧислоИлиНоль(ДоляВсего[Выборка.Спецификация]) + ЧислоИлиНоль(Выборка.Доля));
		КонецЦикла;
		Для Каждого Выборка Из ТаблицаВыходов Цикл
			Ключ = Строка(Выборка.Спецификация.УникальныйИдентификатор()) + "|" + Строка(Выборка.Продукт.УникальныйИдентификатор());
			Выходы.Вставить(Ключ, Выборка.Выход);
			Всего = ЧислоИлиНоль(ДоляВсего[Выборка.Спецификация]);
			ДолиВыхода.Вставить(Ключ, ?(Всего > 0, ЧислоИлиНоль(Выборка.Доля) / Всего, 1));
		КонецЦикла;

		// материалы спецификаций (в базовых единицах)
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Мат.Ссылка КАК Спецификация,
			|	Мат.Номенклатура КАК Материал,
			|	" + ?(ЕстьСтатья, "Мат.СтатьяКалькуляции", "НЕОПРЕДЕЛЕНО") + " КАК Статья,
			|	СУММА(" + ВыражениеКоличестваВСпецификации(ТЧМатериалы, "Мат") + ") КАК Количество
			|ИЗ
			|	Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК Мат
			|ГДЕ
			|	Мат.Ссылка В (&Спецификации)
			|СГРУППИРОВАТЬ ПО
			|	Мат.Ссылка,
			|	Мат.Номенклатура" + ?(ЕстьСтатья, ",
			|	Мат.СтатьяКалькуляции", "");
		Материалы = Запрос.Выполнить().Выгрузить();
		Очередь = Новый Массив;
		Для Каждого Ном Из Список Цикл
			Спец = ВыбраннаяСпецификация[Ном];
			Если НЕ ЗначениеЗаполнено(Спец) Тогда
				Продолжить;
			КонецЕсли;
			КлючВыхода = Строка(Спец.УникальныйИдентификатор()) + "|" + Строка(Ном.УникальныйИдентификатор());
			Выход = ЧислоИлиНоль(Выходы[КлючВыхода]);
			Если Выход <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Доля = ?(ДолиВыхода[КлючВыхода] = Неопределено, 1, ДолиВыхода[КлючВыхода]);
			Строки = Новый Массив;
			Для Каждого Стр Из Материалы.НайтиСтроки(Новый Структура("Спецификация", Спец)) Цикл
				Если НЕ ЗначениеЗаполнено(Стр.Материал) Тогда
					Продолжить;
				КонецЕсли;
				Полуфабрикат = СтрНайти(НРег(Строка(Стр.Статья)), "полуфабрикат") > 0 ИЛИ ЭтоПолуфабрикат(Стр.Материал);
				Строки.Добавить(Новый Структура("Материал, Норма, Статья, Полуфабрикат", Стр.Материал, Стр.Количество * Доля / Выход, Стр.Статья, Полуфабрикат));
				Если Полуфабрикат Тогда
					Очередь.Добавить(Стр.Материал);
				КонецЕсли;
			КонецЦикла;
			Прямые.Вставить(Ном, Строки);
		КонецЦикла;
	КонецЦикла;

	Для Каждого Ном Из Продукты Цикл
		Если Прямые[Ном] <> Неопределено Тогда
			Итог = Новый Соответствие;
			РазвернутьНормы(Прямые, Ном, 1, 1, Итог);
			Результат.Вставить(Ном, Итог);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Спецификации", ВыбраннаяСпецификация);
	Возврат Результат;

КонецФункции

&НаСервере
Процедура РазвернутьНормы(Прямые, Номенклатура, Множитель, Глубина, Итог)

	Для Каждого Стр Из Прямые[Номенклатура] Цикл
		Вложенные = Прямые[Стр.Материал];
		Если Стр.Полуфабрикат И Вложенные <> Неопределено И Глубина < 5 И Стр.Материал <> Номенклатура Тогда
			РазвернутьНормы(Прямые, Стр.Материал, Множитель * Стр.Норма, Глубина + 1, Итог);
		Иначе
			Было = Итог[Стр.Материал];
			Если Было = Неопределено Тогда
				// полуфабрикат без своей спецификации остаётся неразложенным — это показывается в отчёте
				Итог.Вставить(Стр.Материал, Новый Структура("Норма, Статья, НеРазложен", Множитель * Стр.Норма, Стр.Статья, Стр.Полуфабрикат));
			Иначе
				Было.Норма = Было.Норма + Множитель * Стр.Норма;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьПотребность(П, Р)

	// потребность в основном сырье: остаток плана производства месяца, план следующего месяца
	// и выпуск под заказы × нормы спецификаций; сравнение с остатками и поставками в пути
	Если Р.Выпуск = Неопределено Тогда
		ВызватьИсключение "нет данных о выпуске и плане производства";
	КонецЕсли;
	Вып = Р.Выпуск;
	ЕстьПлан = Вып.ЕстьПланПроизводства;
	ЕстьПланСледующего = Вып.Свойство("ЕстьПланСледующего") И Вып.ЕстьПланСледующего;
	План = Новый ТаблицаЗначений;
	План.Колонки.Добавить("Номенклатура");
	План.Колонки.Добавить("Ед");
	План.Колонки.Добавить("ОстатокПлана", ОписаниеЧисла());
	План.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	План.Колонки.Добавить("НаЗаказы", ОписаниеЧисла());
	План.Колонки.Добавить("Нормы");
	План.Колонки.Добавить("ИсточникНорм");
	План.Колонки.Добавить("Спецификация");
	План.Колонки.Добавить("ВПлане", Новый ОписаниеТипов("Булево"));
	Спецификации = Новый Соответствие;
	Для Каждого Стр Из Вып.ПоПродуктам Цикл
		Если Стр.Полуфабрикат Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = План.Добавить();
		НовСтр.Номенклатура = Стр.Номенклатура;
		НовСтр.Ед = Стр.Ед;
		НовСтр.ВПлане = Стр.ПланМесяца > 0 ИЛИ Стр.ПланСледующего > 0;
		// план этого и следующего месяца — каждый из своих документов; где плана нет — по выпуску 30 дней
		Если ЕстьПлан Тогда
			НовСтр.ОстатокПлана = Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц);
		Иначе
			НовСтр.ОстатокПлана = Стр.За30Дней / 30 * Вып.ОсталосьДней;
		КонецЕсли;
		Если ЕстьПланСледующего Тогда
			НовСтр.ПланСледующего = Стр.ПланСледующего;
		Иначе
			НовСтр.ПланСледующего = Стр.За30Дней;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда
			Спецификации.Вставить(Стр.Номенклатура, Стр.Спецификация);
		КонецЕсли;
	КонецЦикла;
	// заказы клиентов, которые надо выпустить (за вычетом готовой продукции на складе):
	// со сроком до конца месяца (и просроченные, и без срока) — в этот месяц, до конца следующего — в следующий.
	// Заказы обычно уже входят в план, поэтому берётся большее из плана и заказов, а не сумма.
	План.Колонки.Добавить("ЗаказыСледующего", ОписаниеЧисла());
	Если Р.Заказы <> Неопределено Тогда
		КонецЭтого = КонецМесяца(П.День);
		КонецСледующего = КонецМесяца(ДобавитьМесяц(П.НачалоМесяца, 1));
		Для Каждого Стр Из Р.Заказы.Открытые Цикл
			Выпустить = ЧислоИлиНоль(Стр.Осталось) - ЧислоИлиНоль(Стр.СоСклада);
			Если Выпустить <= 0 ИЛИ (ЗначениеЗаполнено(Стр.Срок) И Стр.Срок > КонецСледующего) Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = План.Найти(Стр.Номенклатура, "Номенклатура");
			Если НовСтр = Неопределено Тогда
				НовСтр = План.Добавить();
				НовСтр.Номенклатура = Стр.Номенклатура;
				НовСтр.Ед = ЕдиницаНоменклатуры(Стр.Номенклатура);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Стр.Срок) ИЛИ Стр.Срок <= КонецЭтого Тогда
				НовСтр.НаЗаказы = НовСтр.НаЗаказы + Выпустить;
			Иначе
				НовСтр.ЗаказыСледующего = НовСтр.ЗаказыСледующего + Выпустить;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Стр Из План Цикл
			Стр.ОстатокПлана = Макс(Стр.ОстатокПлана, Стр.НаЗаказы);
			Стр.ПланСледующего = Макс(Стр.ПланСледующего, Стр.ЗаказыСледующего);
		КонецЦикла;
	КонецЕсли;
	// продукты без плана и заказов не нужны
	// с конца: число строк запоминается один раз, иначе после удаления индекс уходит за границы
	ВсегоСтрок = План.Количество();
	Для Индекс = 1 По ВсегоСтрок Цикл
		Стр = План[ВсегоСтрок - Индекс];
		Если Стр.ОстатокПлана = 0 И Стр.ПланСледующего = 0 И Стр.НаЗаказы = 0 Тогда
			План.Удалить(Стр);
		КонецЕсли;
	КонецЦикла;

	Нормы = НормыИзСпецификаций(План.ВыгрузитьКолонку("Номенклатура"), П, Спецификации);
	Выбранные = Нормы["Спецификации"];

	// где план оценён по выпуску, выпуск полуфабрикатов попал бы в план второй раз: они уже входят
	// в нормы готовой продукции. Убираем продукты не из документов плана и не под заказы,
	// которые входят в спецификацию другого продукта плана.
	Убрано = Новый Массив;
	Если НЕ ЕстьПлан ИЛИ НЕ ЕстьПланСледующего Тогда
		ВСоставе = Новый Соответствие;
		Для Каждого Ном Из ПолуфабрикатыПродуктов(План, Нормы) Цикл
			ВСоставе.Вставить(Ном, Истина);
		КонецЦикла;
		ВсегоСтрок = План.Количество();
		Для Индекс = 1 По ВсегоСтрок Цикл
			Стр = План[ВсегоСтрок - Индекс];
			Если ВСоставе[Стр.Номенклатура] <> Неопределено И НЕ Стр.ВПлане И Стр.НаЗаказы + Стр.ЗаказыСледующего = 0 Тогда
				Убрано.Добавить(Строка(Стр.Номенклатура));
				План.Удалить(Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// полуфабрикаты без своей спецификации: их сырьё посчитать не из чего
	НеРазложены = Новый Соответствие;
	ПоСпецификациям = 0;
	БезНорм = Новый Массив;
	Для Каждого Стр Из План Цикл
		Стр.Нормы = Нормы[Стр.Номенклатура];
		Если Стр.Нормы <> Неопределено И Стр.Нормы.Количество() > 0 Тогда
			Стр.ИсточникНорм = "спецификация";
			Стр.Спецификация = ?(Выбранные = Неопределено, Неопределено, Выбранные[Стр.Номенклатура]);
			ПоСпецификациям = ПоСпецификациям + 1;
		Иначе
			Стр.Нормы = Неопределено;
			Стр.ИсточникНорм = "нет спецификации";
			БезНорм.Добавить(Строка(Стр.Номенклатура));
		КонецЕсли;
	КонецЦикла;

	Потребность = Новый Соответствие;
	Для Каждого Стр Из План Цикл
		Если Стр.Нормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Стр.Нормы Цикл
			Если НЕ СырьеДляПотребности(Элемент.Ключ, Элемент.Значение.Статья, П) Тогда
				// покупной полуфабрикат со статьёй сырья считается как сырьё; свой без спецификации — в список
				Если Элемент.Значение.Свойство("НеРазложен") И Элемент.Значение.НеРазложен Тогда
					НеРазложены.Вставить(Строка(Элемент.Ключ), Истина);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Нужно = Потребность[Элемент.Ключ];
			Если Нужно = Неопределено Тогда
				Нужно = Новый Структура("ОстатокПлана, ПланСледующего, НаЗаказы", 0, 0, 0);
				Потребность.Вставить(Элемент.Ключ, Нужно);
			КонецЕсли;
			Норма = Элемент.Значение.Норма;
			Нужно.ОстатокПлана = Нужно.ОстатокПлана + Стр.ОстатокПлана * Норма;
			Нужно.ПланСледующего = Нужно.ПланСледующего + Стр.ПланСледующего * Норма;
			Нужно.НаЗаказы = Нужно.НаЗаказы + Стр.НаЗаказы * Норма;
		КонецЦикла;
	КонецЦикла;

	Материалы = Новый Массив;
	Для Каждого Элемент Из Потребность Цикл
		Материалы.Добавить(Элемент.Ключ);
	КонецЦикла;
	Остатки = ОстаткиНаСкладах(Материалы, П);
	ВПути = ПоставкиВПути(Материалы, П);
	Цены = ЦеныСырья(Р);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Ед");
	Таблица.Колонки.Добавить("ОстатокПлана", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	Таблица.Колонки.Добавить("НаЗаказы", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВПути", ОписаниеЧисла());
	Таблица.Колонки.Добавить("НехваткаМесяц", ОписаниеЧисла());
	Таблица.Колонки.Добавить("НехваткаДвухМесяцев", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Цена", ОписаниеЧисла());
	Таблица.Колонки.Добавить("СуммаДокупки", ОписаниеЧисла());
	Для Каждого Элемент Из Потребность Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Номенклатура = Элемент.Ключ;
		НовСтр.Ед = ЕдиницаНоменклатуры(Элемент.Ключ);
		НовСтр.ОстатокПлана = Элемент.Значение.ОстатокПлана;
		НовСтр.ПланСледующего = Элемент.Значение.ПланСледующего;
		НовСтр.НаЗаказы = Элемент.Значение.НаЗаказы;
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Элемент.Ключ]);
		Поставка = ВПути[Элемент.Ключ];
		НовСтр.ВПути = ?(Поставка = Неопределено, 0, Поставка.Количество);
		// на этот месяц — только поставки с датой поступления до конца месяца
		ВПутиМесяц = ?(Поставка = Неопределено, 0, Поставка.ДоКонцаМесяца);
		НовСтр.НехваткаМесяц = Макс(0, НовСтр.ОстатокПлана - НовСтр.Остаток - ВПутиМесяц);
		ВПутиДваМесяца = ?(Поставка = Неопределено, 0, Поставка.ДоКонцаСледующего);
		НовСтр.НехваткаДвухМесяцев = Макс(0, НовСтр.ОстатокПлана + НовСтр.ПланСледующего - НовСтр.Остаток - ВПутиДваМесяца);
		НовСтр.Цена = ЧислоИлиНоль(Цены[Элемент.Ключ]);
		НовСтр.СуммаДокупки = НовСтр.НехваткаДвухМесяцев * НовСтр.Цена;
	КонецЦикла;
	Таблица.Сортировать("СуммаДокупки Убыв, НехваткаДвухМесяцев Убыв, ОстатокПлана Убыв");

	// стоимость основного сырья на единицу продукта по нормам и последним ценам закупки
	Затраты = Новый ТаблицаЗначений;
	Затраты.Колонки.Добавить("Номенклатура");
	Затраты.Колонки.Добавить("Ед");
	Затраты.Колонки.Добавить("НаЕдиницу", ОписаниеЧисла());
	Затраты.Колонки.Добавить("ЦенаПродажи", ОписаниеЧисла());
	Затраты.Колонки.Добавить("Доля");
	Затраты.Колонки.Добавить("БезЦены");
	Затраты.Колонки.Добавить("Главное");
	Затраты.Колонки.Добавить("Спецификация");
	Для Каждого Стр Из План Цикл
		Если Стр.Нормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Затраты.Добавить();
		НовСтр.Номенклатура = Стр.Номенклатура;
		НовСтр.Ед = Стр.Ед;
		НовСтр.Спецификация = Стр.Спецификация;
		НетЦены = Новый Массив;
		Крупнейшая = 0;
		Для Каждого Элемент Из Стр.Нормы Цикл
			Если НЕ СырьеДляПотребности(Элемент.Ключ, Элемент.Значение.Статья, П) Тогда
				Продолжить;
			КонецЕсли;
			Цена = ЧислоИлиНоль(Цены[Элемент.Ключ]);
			Если Цена = 0 Тогда
				НетЦены.Добавить(Строка(Элемент.Ключ));
			КонецЕсли;
			Сумма = Элемент.Значение.Норма * Цена;
			НовСтр.НаЕдиницу = НовСтр.НаЕдиницу + Сумма;
			Если Сумма > Крупнейшая Тогда
				Крупнейшая = Сумма;
				НовСтр.Главное = Строка(Элемент.Ключ) + " — " + Формат(Сумма / Макс(НовСтр.НаЕдиницу, 0.01) * 100, "ЧДЦ=0") + " %";
			КонецЕсли;
		КонецЦикла;
		Если Крупнейшая > 0 И НовСтр.НаЕдиницу > 0 Тогда
			// доля главной статьи считается от итоговой стоимости
			Для Каждого Элемент Из Стр.Нормы Цикл
				Если СырьеДляПотребности(Элемент.Ключ, Элемент.Значение.Статья, П) И Элемент.Значение.Норма * ЧислоИлиНоль(Цены[Элемент.Ключ]) = Крупнейшая Тогда
					НовСтр.Главное = Строка(Элемент.Ключ) + " — " + Формат(Крупнейшая / НовСтр.НаЕдиницу * 100, "ЧДЦ=0") + " %";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		НовСтр.БезЦены = СтрСоединить(НетЦены, ", ");
		Если Р.Продажи <> Неопределено Тогда
			Продажа = Р.Продажи.ПоНоменклатуре.Найти(Стр.Номенклатура, "Ключ");
			Если Продажа <> Неопределено Тогда
				НовСтр.ЦенаПродажи = ?(Продажа.Цена > 0, Продажа.Цена, Продажа.ЦенаПрошлМесяц);
			КонецЕсли;
		КонецЕсли;
		Если НовСтр.ЦенаПродажи > 0 Тогда
			НовСтр.Доля = НовСтр.НаЕдиницу / НовСтр.ЦенаПродажи * 100;
		КонецЕсли;
	КонецЦикла;
	Затраты.Сортировать("НаЕдиницу Убыв");

	Результат = Новый Структура;
	Результат.Вставить("План", План);
	Результат.Вставить("ЕстьПлан", ЕстьПлан);
	Результат.Вставить("Таблица", Таблица);
	Результат.Вставить("Затраты", Затраты);
	Результат.Вставить("ПоСпецификациям", ПоСпецификациям);
	Результат.Вставить("БезНорм", БезНорм);
	Результат.Вставить("ЕстьПланСледующего", ЕстьПланСледующего);
	СписокНеРазложены = Новый Массив;
	Для Каждого Элемент Из НеРазложены Цикл
		СписокНеРазложены.Добавить(Элемент.Ключ);
	КонецЦикла;
	Результат.Вставить("НеРазложены", СписокНеРазложены);
	Результат.Вставить("УбраноПолуфабрикатов", Убрано);
	Результат.Вставить("СуммаДокупки", Таблица.Итог("СуммаДокупки"));
	Возврат Результат;

КонецФункции

// Основное сырьё в потребности — по той же настройке, что и в разделе «Сырьё»:
// если задана группа сырья — всё из этой группы, иначе по статьям калькуляции.
&НаСервере
Функция СырьеДляПотребности(Материал, Статья, П)

	Если ЗначениеЗаполнено(П.ГруппаСырья) Тогда
		Попытка
			Возврат Материал = П.ГруппаСырья ИЛИ Материал.ПринадлежитЭлементу(П.ГруппаСырья);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	Возврат ЭтоОсновноеСырье(Статья, П);

КонецФункции

// Продукты плана, которые входят в спецификацию другого продукта плана.
&НаСервере
Функция ПолуфабрикатыПродуктов(План, Нормы)

	Результат = Новый Массив;
	Выбранные = Нормы["Спецификации"];
	Если Метаданные.Справочники.Найти("РесурсныеСпецификации") = Неопределено ИЛИ Выбранные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Спецификации = Новый Массив;
	Продукты = Новый Массив;
	Для Каждого Стр Из План Цикл
		Спец = Выбранные[Стр.Номенклатура];
		Если ЗначениеЗаполнено(Спец) Тогда
			Спецификации.Добавить(Спец);
		КонецЕсли;
		Продукты.Добавить(Стр.Номенклатура);
	КонецЦикла;
	Если Спецификации.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Мат.Ссылка КАК Спецификация,
		|	Мат.Номенклатура КАК Номенклатура
		|ИЗ
		|	Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК Мат
		|ГДЕ
		|	Мат.Ссылка В (&Спецификации)
		|	И Мат.Номенклатура В (&Продукты)";
	Запрос.УстановитьПараметр("Спецификации", Спецификации);
	Запрос.УстановитьПараметр("Продукты", Продукты);
	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
		// продукт в своей же спецификации (переработка своего брака) — не полуфабрикат другого продукта
		Если Выбранные[Стр.Номенклатура] <> Стр.Спецификация Тогда
			Результат.Добавить(Стр.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЦеныСырья(Р)

	// последняя цена закупки без НДС: за 12 месяцев, иначе за текущий и прошлый месяц
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Возврат Р.ЗакупкиГод.Последние;
	ИначеЕсли Р.Закупки <> Неопределено Тогда
		Возврат Р.Закупки.Цены;
	КонецЕсли;
	Возврат Новый Соответствие;

КонецФункции

#КонецОбласти

#Область Диагностика

&НаСервере
Процедура ОставитьОсновноеВЗакупках(Р)

	// в таблицах закупок оставляем только основное сырьё (итоги по закупкам не меняются)
	Основное = Новый Соответствие;
	Если Р.Сырье <> Неопределено Тогда
		Для Каждого Стр Из Р.Сырье.Материалы Цикл
			Основное.Вставить(Стр.Номенклатура, Истина);
		КонецЦикла;
	КонецЕсли;
	Если Р.Потребность <> Неопределено Тогда
		Для Каждого Стр Из Р.Потребность.Таблица Цикл
			Основное.Вставить(Стр.Номенклатура, Истина);
		КонецЦикла;
	КонецЕсли;
	Если Основное.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Таблицы = Новый Массив;
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Таблицы.Добавить(Новый Структура("Т, Поле", Р.ЗакупкиГод.Материалы, "Номенклатура"));
		Таблицы.Добавить(Новый Структура("Т, Поле", Р.ЗакупкиГод.Сравнение, "Номенклатура"));
	КонецЕсли;
	Если Р.Закупки <> Неопределено Тогда
		Таблицы.Добавить(Новый Структура("Т, Поле", Р.Закупки.ПоНоменклатуре, "Ключ"));
	КонецЕсли;
	Для Каждого Опис Из Таблицы Цикл
		// с конца: число строк запоминается один раз, иначе после удаления индекс уходит за границы
		ВсегоСтрок = Опис.Т.Количество();
		Для Индекс = 1 По ВсегоСтрок Цикл
			Стр = Опис.Т[ВсегоСтрок - Индекс];
			Если Основное[Стр[Опис.Поле]] = Неопределено Тогда
				Опис.Т.Удалить(Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Р.ЗакупкиГод.Переплата = Р.ЗакупкиГод.Сравнение.Итог("Переплата");
		Р.ЗакупкиГод.Вставить("ТолькоОсновное", Истина);
	КонецЕсли;
	Если Р.Закупки <> Неопределено Тогда
		Р.Закупки.Вставить("ТолькоОсновное", Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДиагностикаНаСервере()

	// сведения о структуре базы и пробные цифры разделов — чтобы настроить отчёт под эту базу
	СохранитьНастройки();
	Строки = Новый Массив;
	Попытка
		СобратьДиагностику(Строки);
	Исключение
		Строки.Добавить("ОШИБКА ДИАГНОСТИКИ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Текст = СтрСоединить(Строки, Символы.ПС);

	ТД = Новый ТабличныйДокумент;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	Попытка
		ТД.Область("C1").ШиринаКолонки = 250;
	Исключение
		ТД.Область(1, 1, 1, 1).ШиринаКолонки = 250;
	КонецПопытки;
	ШрифтТекста = Новый Шрифт("Courier New", 9);
	Номер = 0;
	Для Каждого ТекстСтроки Из Строки Цикл
		Номер = Номер + 1;
		Обл = ТД.Область(Номер, 1, Номер, 1);
		Обл.Текст = ТекстСтроки;
		Обл.Шрифт = ШрифтТекста;
	КонецЦикла;
	ЭтаФорма["ДокументОтчета"] = ТД;
	Текст = ОбезличитьДляЧата(Текст); // на экране — как есть, в файл для чата — без названий
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура СобратьДиагностику(Строки)

	П = ПараметрыОтчета();
	Строки.Добавить("ДИАГНОСТИКА ЕЖЕДНЕВНОГО ОТЧЁТА");
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия);
	Строки.Добавить("Дата отчёта: " + Формат(П.День, "ДФ=dd.MM.yyyy") + "; организация: " + ?(ЗначениеЗаполнено(П.Организация), Строка(П.Организация), "все")
		+ "; группа сырья: " + ?(ЗначениеЗаполнено(П.ГруппаСырья), Строка(П.ГруппаСырья), "не задана"));

	Попытка
		ДиагностикаСуточногоРапорта(Строки, П);
	Исключение
		Строки.Добавить("суточный рапорт: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		ДиагностикаПлановПроизводства(Строки, П);
	Исключение
		Строки.Добавить("планы производства: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаголовокДиагностики(Строки, "1. РЕГИСТРЫ НАКОПЛЕНИЯ");
	Слова = "Денежн,Расчет,Заказ,ТоварыНаСкладах,Выпуск,Производ,Выручк,Себестоим,Материал,Продукц,ДДС,Платеж,Потребн,Обеспечен,Партии";
	Для Каждого Мета Из Метаданные.РегистрыНакопления Цикл
		Если ИмяПодходит(Мета.Имя, Слова) Тогда
			Строки.Добавить("РН." + Мета.Имя + " (" + Мета.Синоним + "), " + Строка(Мета.ВидРегистра));
			Строки.Добавить("   измерения: " + ОписаниеПолей(Мета.Измерения, Истина));
			Строки.Добавить("   ресурсы:   " + ОписаниеПолей(Мета.Ресурсы, Ложь));
			Строки.Добавить("   реквизиты: " + ОписаниеПолей(Мета.Реквизиты, Ложь));
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "2. СПРАВОЧНИКИ: технологические карты, спецификации, нормы");
	Для Каждого Мета Из Метаданные.Справочники Цикл
		Если ИмяПодходит(Мета.Имя + " " + Мета.Синоним, "Технолог,Спецификац,Рецепт,Норм,Маршрут,Карт") Тогда
			ОписатьОбъект(Строки, Мета, "Справочник");
			ПримерОбъекта(Строки, Мета, "Справочник");
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "3. ДОКУМЕНТЫ ПРОИЗВОДСТВА");
	Для Каждого Мета Из Метаданные.Документы Цикл
		Если ИмяПодходит(Мета.Имя + " " + Мета.Синоним, "Производ,Выпуск,Этап,ПередачаМатериал,Сборк,Переработ,Технолог,Маршрут,Смен,Рапорт,Варк,Сушк") Тогда
			ОписатьОбъект(Строки, Мета, "Документ");
			ПримерОбъекта(Строки, Мета, "Документ");
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "4. КАКИЕ ДОКУМЕНТЫ ДВИГАЛИ РЕГИСТРЫ ЗА 30 ДНЕЙ");
	Для Каждого ИмяРегистра Из СтрРазделить("ТоварыНаСкладах,ДенежныеСредстваБезналичные,ДенежныеСредстваНаличные", ",") Цикл
		РегистраторыПоВидам(Строки, ИмяРегистра, П);
	КонецЦикла;
	Для Каждого Мета Из Метаданные.РегистрыНакопления Цикл
		Если ИмяПодходит(Мета.Имя, "Выпуск,Продукц,Производ,Себестоим,Выручк") Тогда
			РегистраторыПоВидам(Строки, Мета.Имя, П);
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "4б. АРЕНДАТОРЫ");
	Попытка
		Ар = ПолучитьАренду(П, Неопределено);
		Строки.Добавить("Арендаторов: " + Ар.Таблица.Количество() + "; начислено с 1-го " + Формат(Ар.Месяц, "ЧДЦ=0; ЧН=0")
			+ ", с начала года " + Формат(Ар.СНачалаГода, "ЧДЦ=0; ЧН=0"));
		Для Каждого ТекстИсточника Из Ар.Источники Цикл
			Строки.Добавить("   " + ТекстИсточника);
		КонецЦикла;
		Для Каждого МетаДокумента Из Метаданные.Документы Цикл
			Если СтрНайти(НРег(МетаДокумента.Имя), "аренд") > 0 Тогда
				Строки.Добавить("   документ «" + МетаДокумента.Синоним + "» (" + МетаДокумента.Имя + "): шапка " + ОписаниеПолей(МетаДокумента.Реквизиты, Ложь));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Аренда: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаголовокДиагностики(Строки, "4а. ДЕПОЗИТЫ");
	Попытка
		Деп = ПолучитьДепозиты(П);
		Строки.Добавить("Итог: на начало дня " + Формат(Деп.Вчера, "ЧДЦ=0; ЧН=0") + ", на конец " + Формат(Деп.Сегодня, "ЧДЦ=0; ЧН=0")
			+ "; источник: " + ?(ПустаяСтрока(Деп.Источник), "не найден", Деп.Источник));
		Для Каждого ТекстПути Из Деп.Пути Цикл
			Строки.Добавить("   " + ТекстПути);
		КонецЦикла;
		Если Метаданные.Справочники.Найти("ДоговорыКредитовИДепозитов") <> Неопределено Тогда
			ЗапросДоговоров = Новый Запрос("ВЫБРАТЬ Д.ТипДоговора КАК Тип, КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ДоговорыКредитовИДепозитов КАК Д ГДЕ НЕ Д.ПометкаУдаления СГРУППИРОВАТЬ ПО Д.ТипДоговора");
			Выборка = ЗапросДоговоров.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Строки.Добавить("   договоров «" + Строка(Выборка.Тип) + "»: " + Выборка.Количество);
			КонецЦикла;
		КонецЕсли;
	Исключение
		Строки.Добавить("Депозиты: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаголовокДиагностики(Строки, "5. ИТОГИ РЕСУРСОВ (прошлый и текущий месяц)");
	Для Каждого ИмяРегистра Из СтрРазделить("ВыручкаИСебестоимостьПродаж,ДенежныеСредстваБезналичные", ",") Цикл
		ИтогиРесурсов(Строки, ИмяРегистра, П);
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "6. ЦИФРЫ РАЗДЕЛОВ ОТЧЁТА");
	ДиагностикаРазделов(Строки, П);

КонецПроцедуры

// Отчёт «Суточный рапорт» базы: откуда он берёт выпуск (запросы схемы компоновки, отборы варианта)
// и что он выдаёт за текущий месяц — чтобы раздел «Выпуск» считать так же.
&НаСервере
Процедура ДиагностикаСуточногоРапорта(Строки, П)

	ЗаголовокДиагностики(Строки, "0. ОТЧЁТЫ «РАПОРТ» БАЗЫ: откуда берут выпуск и что показывают за месяц");
	Найдено = 0;
	Если Метаданные.Справочники.Найти("ВариантыОтчетов") <> Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10 ВО.Ссылка КАК Ссылка, ВО.Наименование КАК Наименование, ВО.Отчет КАК Отчет, ВО.КлючВарианта КАК КлючВарианта
			|ИЗ Справочник.ВариантыОтчетов КАК ВО
			|ГДЕ НЕ ВО.ПометкаУдаления И ВО.Наименование ПОДОБНО ""%рапорт%""");
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Найдено = Найдено + 1;
				Строки.Добавить("");
				Строки.Добавить("ВАРИАНТ ОТЧЁТА «" + Выборка.Наименование + "», ключ " + Выборка.КлючВарианта + ", отчёт: " + Строка(Выборка.Отчет)
					+ " [" + Строка(ТипЗнч(Выборка.Отчет)) + "]");
				ОписатьОтчетСКД(Строки, Выборка.Отчет, Выборка.Ссылка, П);
			КонецЦикла;
		Исключение
			Строки.Добавить("варианты отчётов: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Для Каждого МетаОтчета Из Метаданные.Отчеты Цикл
		Если СтрНайти(НРег(МетаОтчета.Имя + " " + МетаОтчета.Синоним), "рапорт") > 0 Тогда
			Найдено = Найдено + 1;
			Строки.Добавить("");
			Строки.Добавить("ОТЧЁТ КОНФИГУРАЦИИ «" + МетаОтчета.Синоним + "» (" + МетаОтчета.Имя + ")");
			ОписатьОтчетСКД(Строки, МетаОтчета.ПолноеИмя(), Неопределено, П);
		КонецЕсли;
	КонецЦикла;
	Если Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10 Д.Ссылка КАК Ссылка, Д.Наименование КАК Наименование ИЗ Справочник.ДополнительныеОтчетыИОбработки КАК Д
			|ГДЕ НЕ Д.ПометкаУдаления И Д.Наименование ПОДОБНО ""%рапорт%""");
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Найдено = Найдено + 1;
				Строки.Добавить("");
				Строки.Добавить("ДОПОЛНИТЕЛЬНЫЙ ОТЧЁТ «" + Выборка.Наименование + "»");
				ОписатьОтчетСКД(Строки, Выборка.Ссылка, Неопределено, П);
			КонецЦикла;
		Исключение
			Строки.Добавить("дополнительные отчёты: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Если Найдено = 0 Тогда
		Строки.Добавить("Отчётов со словом «рапорт» в названии не найдено.");
	КонецЕсли;

КонецПроцедуры

// Планы производства на этот и следующий месяц: какие документы есть и какие взяты в отчёт.
&НаСервере
Процедура ДиагностикаПлановПроизводства(Строки, П)

	ЗаголовокДиагностики(Строки, "0а. ПЛАНЫ ПРОИЗВОДСТВА НА ЭТОТ И СЛЕДУЮЩИЙ МЕСЯЦ");
	Мета = Метаданные.Документы.Найти("ПланПроизводства");
	Если Мета = Неопределено Тогда
		Строки.Добавить("документа «План производства» нет");
		Возврат;
	КонецЕсли;
	ОписатьОбъект(Строки, Мета, "Документ");
	НачалоСледующего = ДобавитьМесяц(П.НачалоМесяца, 1);
	Для Каждого Период Из СтрРазделить("этот,следующий", ",") Цикл
		Нач = ?(Период = "этот", П.НачалоМесяца, НачалоСледующего);
		Кон = КонецМесяца(Нач);
		Взятые = Новый Массив;
		План = ПланПроизводства(П, Нач, Кон, Неопределено, Взятые);
		Строки.Добавить("");
		Строки.Добавить("Месяц " + Формат(Нач, "ДФ='MMMM yyyy'") + ": позиций в плане отчёта " + План.Количество() + ", всего " + ФорматЧисла(План.Итог("Количество"))
			+ ", полуфабрикатов " + План.НайтиСтроки(Новый Структура("Полуфабрикат", Истина)).Количество());
		ДатаШапки = ?(Мета.Реквизиты.Найти("НачалоПериода") <> Неопределено, "Д.НачалоПериода", "Д.Дата");
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Д.Ссылка КАК Документ, Д.Дата КАК Дата, Д.Проведен КАК Проведен, Д.ПометкаУдаления КАК Удален, "
			+ ДатаШапки + " КАК НачалоПериода, "
			+ ?(Мета.Реквизиты.Найти("ОкончаниеПериода") <> Неопределено, "Д.ОкончаниеПериода", "НЕОПРЕДЕЛЕНО") + " КАК ОкончаниеПериода, "
			+ ?(Мета.Реквизиты.Найти("Статус") <> Неопределено, "Д.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус, "
			+ ?(Мета.Реквизиты.Найти("Сценарий") <> Неопределено, "Д.Сценарий", "НЕОПРЕДЕЛЕНО") + " КАК Сценарий, "
			+ ?(Мета.Реквизиты.Найти("Подразделение") <> Неопределено, "Д.Подразделение", "НЕОПРЕДЕЛЕНО") + " КАК Подразделение, "
			+ ?(Мета.Реквизиты.Найти("ВидПлана") <> Неопределено, "Д.ВидПлана", "НЕОПРЕДЕЛЕНО") + " КАК ВидПлана
			|ИЗ Документ.ПланПроизводства КАК Д
			|ГДЕ " + ДатаШапки + " <= &Кон И "
			+ ?(Мета.Реквизиты.Найти("ОкончаниеПериода") <> Неопределено, "Д.ОкончаниеПериода >= &Нач", ДатаШапки + " >= &Нач") + "
			|УПОРЯДОЧИТЬ ПО Д.Дата");
		Запрос.УстановитьПараметр("Нач", Нач);
		Запрос.УстановитьПараметр("Кон", Кон);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗапросСтрок = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Строк, СУММА(Т.Количество) КАК Количество ИЗ Документ.ПланПроизводства.Продукция КАК Т ГДЕ Т.Ссылка = &Ссылка");
			ЗапросСтрок.УстановитьПараметр("Ссылка", Выборка.Документ);
			Итог = ЗапросСтрок.Выполнить().Выбрать();
			Итог.Следующий();
			Строки.Добавить(СтрШаблон("   %1 от %2: период %3–%4, статус %5, сценарий %6, вид плана %7, подразделение %8",
				Выборка.Документ.Номер, Формат(Выборка.Дата, "ДФ='dd.MM.yyyy HH:mm'"), Формат(Выборка.НачалоПериода, "ДФ=dd.MM.yy"),
				Формат(Выборка.ОкончаниеПериода, "ДФ=dd.MM.yy"), Строка(Выборка.Статус), Строка(Выборка.Сценарий), Строка(Выборка.ВидПлана),
				Строка(Выборка.Подразделение))
				+ СтрШаблон(", проведён %1, строк %2, количество %3%4", ?(Выборка.Проведен, "да", "нет") + ?(Выборка.Удален, ", помечен на удаление", ""),
				ЧислоИлиНоль(Итог.Строк), ФорматЧисла(ЧислоИлиНоль(Итог.Количество)), ?(Взятые.Найти(Выборка.Документ) = Неопределено, "", " — ВЗЯТ В ОТЧЁТ")));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОписатьОтчетСКД(Строки, Отчет, Вариант, П)

	Попытка
		ОтчетОбъект = Неопределено;
		Если ТипЗнч(Отчет) = Тип("Строка") Тогда
			Мета = Метаданные.НайтиПоПолномуИмени(Отчет);
			ОтчетОбъект = Отчеты[Мета.Имя].Создать();
		ИначеЕсли Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено
			И ТипЗнч(Отчет) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") Тогда
			ОтчетОбъект = ВнешниеОтчеты.Создать(ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(Отчет));
		Иначе
			ПолноеИмя = РеквизитСсылки(Отчет, "ПолноеИмя");
			Мета = ?(ПолноеИмя = Неопределено, Неопределено, Метаданные.НайтиПоПолномуИмени(ПолноеИмя));
			Если Мета = Неопределено Тогда
				Строки.Добавить("   отчёт не найден в метаданных (" + Строка(ПолноеИмя) + ")");
				Возврат;
			КонецЕсли;
			ОтчетОбъект = Отчеты[Мета.Имя].Создать();
		КонецЕсли;
		МетаОтчета = ОтчетОбъект.Метаданные();
		Строки.Добавить("   объект: " + МетаОтчета.ПолноеИмя() + " «" + МетаОтчета.Синоним + "»");
		Если МетаОтчета.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
			Макеты = Новый Массив;
			Для Каждого МетаМакета Из МетаОтчета.Макеты Цикл
				Макеты.Добавить(МетаМакета.Имя);
			КонецЦикла;
			Строки.Добавить("   нет основной схемы компоновки; макеты: " + СтрСоединить(Макеты, ", "));
			Возврат;
		КонецЕсли;
		Схема = ОтчетОбъект.ПолучитьМакет(МетаОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
	Исключение
		Строки.Добавить("   не открыт: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого Набор Из Схема.НаборыДанных Цикл
		ОписатьНаборСКД(Строки, Набор, "   ");
	КонецЦикла;
	ПараметрыСхемы = Новый Массив;
	Для Каждого Пар Из Схема.Параметры Цикл
		ПараметрыСхемы.Добавить(Пар.Имя);
	КонецЦикла;
	Строки.Добавить("   параметры схемы: " + СтрСоединить(ПараметрыСхемы, ", "));
	Ресурсы = Новый Массив;
	Для Каждого Рес Из Схема.ПоляИтога Цикл
		Ресурсы.Добавить(Рес.ПутьКДанным + " = " + Рес.Выражение);
	КонецЦикла;
	Строки.Добавить("   ресурсы: " + СтрСоединить(Ресурсы, "; "));

	// настройки варианта: отборы и выбранные поля
	Настройки = Неопределено;
	Если Вариант <> Неопределено Тогда
		Попытка
			Настройки = РеквизитСсылки(Вариант, "Настройки").Получить();
		Исключение
			Настройки = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(Настройки) <> Тип("НастройкиКомпоновкиДанных") Тогда
		Настройки = Схема.НастройкиПоУмолчанию;
		Строки.Добавить("   настройки: по умолчанию");
	Иначе
		Строки.Добавить("   настройки: из варианта");
	КонецЕсли;
	Отборы = Новый Массив;
	ОписатьОтборСКД(Настройки.Отбор.Элементы, Отборы);
	Строки.Добавить("   отбор: " + ?(Отборы.Количество() = 0, "нет", СтрСоединить(Отборы, "; ")));

	// результат за месяц
	Попытка
		Для Каждого Пар Из Настройки.ПараметрыДанных.Элементы Цикл
			Имя = НРег(Строка(Пар.Параметр));
			Значение = Неопределено;
			Если СтрНайти(Имя, "начал") > 0 Тогда
				Значение = П.НачалоМесяца;
			ИначеЕсли СтрНайти(Имя, "конец") > 0 ИЛИ СтрНайти(Имя, "оконч") > 0 Тогда
				Значение = П.КонецДня;
			ИначеЕсли СтрНайти(Имя, "период") > 0 Тогда
				Значение = Новый СтандартныйПериод(П.НачалоМесяца, П.КонецДня);
			ИначеЕсли СтрНайти(Имя, "дата") > 0 Тогда
				Значение = П.КонецДня;
			КонецЕсли;
			Если Значение <> Неопределено Тогда
				Пар.Значение = Значение;
				Пар.Использование = Истина;
			КонецЕсли;
		КонецЦикла;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(Макет, , , Истина);
		Результат = Новый ТаблицаЗначений;
		Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		Вывод.УстановитьОбъект(Результат);
		Вывод.Вывести(Процессор);
		Колонки = Новый Массив;
		Для Каждого Кол Из Результат.Колонки Цикл
			Колонки.Добавить(Кол.Имя + " (" + ТипыСтрокой(Кол.ТипЗначения) + ")");
		КонецЦикла;
		Строки.Добавить("   результат с 1-го числа: строк " + Результат.Количество() + "; колонки: " + СтрСоединить(Колонки, ", "));
		Номер = 0;
		Для Каждого Стр Из Результат Цикл
			Номер = Номер + 1;
			Если Номер > 40 Тогда
				Прервать;
			КонецЕсли;
			Значения = Новый Массив;
			Для Каждого Кол Из Результат.Колонки Цикл
				Значения.Добавить(Строка(Стр[Кол.Имя]));
			КонецЦикла;
			Строки.Добавить("      " + СтрСоединить(Значения, " | "));
		КонецЦикла;
	Исключение
		Строки.Добавить("   результат не получен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОписатьНаборСКД(Строки, Набор, Отступ)

	ТипНабора = ТипЗнч(Набор);
	Если ТипНабора = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
		Строки.Добавить(Отступ + "набор «" + Набор.Имя + "» — запрос:");
		Для Каждого СтрокаЗапроса Из СтрРазделить(Набор.Запрос, Символы.ПС) Цикл
			Строки.Добавить(Отступ + "   " + СтрокаЗапроса);
		КонецЦикла;
	ИначеЕсли ТипНабора = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
		Строки.Добавить(Отступ + "набор «" + Набор.Имя + "» — объединение:");
		Для Каждого Вложенный Из Набор.Элементы Цикл
			ОписатьНаборСКД(Строки, Вложенный, Отступ + "   ");
		КонецЦикла;
	Иначе
		Строки.Добавить(Отступ + "набор «" + Набор.Имя + "» — " + Строка(ТипНабора) + " (данные заполняет модуль отчёта)");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОписатьОтборСКД(ЭлементыОтбора, Отборы)

	Для Каждого Элемент Из ЭлементыОтбора Цикл
		Если НЕ Элемент.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ОписатьОтборСКД(Элемент.Элементы, Отборы);
		Иначе
			Отборы.Добавить(Строка(Элемент.ЛевоеЗначение) + " " + Строка(Элемент.ВидСравнения) + " " + Строка(Элемент.ПравоеЗначение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаголовокДиагностики(Строки, Текст)

	Строки.Добавить("");
	Строки.Добавить("==== " + Текст + " ====");

КонецПроцедуры

&НаСервере
Функция ИмяПодходит(Имя, Слова)

	ИмяНРег = НРег(Имя);
	Для Каждого Слово Из СтрРазделить(Слова, ",") Цикл
		Если СтрНайти(ИмяНРег, НРег(Слово)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ОписаниеПолей(Коллекция, СТипами)

	Части = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Если Части.Количество() >= 60 Тогда
			Части.Добавить("…");
			Прервать;
		КонецЕсли;
		Части.Добавить(Поле.Имя + ?(СТипами, "[" + ТипыСтрокой(Поле.Тип) + "]", ""));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

&НаСервере
Функция ТипыСтрокой(ОписаниеТиповПоля)

	Части = Новый Массив;
	Для Каждого ТипПоля Из ОписаниеТиповПоля.Типы() Цикл
		Если Части.Количество() >= 3 Тогда
			Части.Добавить("+" + Формат(ОписаниеТиповПоля.Типы().Количество() - 3, "ЧГ=0"));
			Прервать;
		КонецЕсли;
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Части.Добавить(?(МетаТипа = Неопределено, Строка(ТипПоля), МетаТипа.ПолноеИмя()));
	КонецЦикла;
	Возврат СтрСоединить(Части, "|");

КонецФункции

&НаСервере
Процедура ОписатьОбъект(Строки, Мета, Вид)

	Строки.Добавить("");
	Строки.Добавить(Вид + "." + Мета.Имя + " (" + Мета.Синоним + ")");
	Строки.Добавить("   шапка: " + ОписаниеПолей(Мета.Реквизиты, Истина));
	Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
		Строки.Добавить("   ТЧ " + ТЧ.Имя + " (" + ТЧ.Синоним + "): " + ОписаниеПолей(ТЧ.Реквизиты, Ложь));
	КонецЦикла;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Вид + "." + Мета.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Строки.Добавить("   записей в базе: " + Формат(Выборка.Количество, "ЧН=0; ЧГ=0"));
		КонецЕсли;
	Исключение
		Строки.Добавить("   записей: нет доступа");
	КонецПопытки;

КонецПроцедуры

// В диагностике нужна структура, а не данные: для ссылок — вид объекта, для текста — длина.
&НаСервереБезКонтекста
Функция ВидЗначенияДляДиагностики(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "текст(" + СтрДлина(Значение) + ")";
	КонецЕсли;
	МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаЗначения = Неопределено Тогда
		Возврат Строка(ТипЗначения);
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаЗначения) ИЛИ Метаданные.ПланыСчетов.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "[" + МетаЗначения.Имя + "]";

КонецФункции

&НаСервере
Процедура ПримерОбъекта(Строки, Мета, Вид)

	// один пример: последний проведённый документ или первый элемент справочника, первые строки каждой ТЧ
	Попытка
		Если Вид = "Документ" Тогда
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ." + Мета.Имя + " КАК Т ГДЕ "
				+ ?(Мета.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить, "Т.Проведен", "НЕ Т.ПометкаУдаления") + " УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ";
		Иначе
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник." + Мета.Имя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления"
				+ ?(Мета.Иерархический И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов, " И НЕ Т.ЭтоГруппа", "");
		КонецЕсли;
		ЗапросПримера = Новый Запрос(ТекстЗапроса);
		Выборка = ЗапросПримера.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Строки.Добавить("   пример: записей нет");
			Возврат;
		КонецЕсли;
		Ссылка = Выборка.Ссылка;
		Строки.Добавить("   пример: найден");
		Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 8 * ИЗ " + Вид + "." + Мета.Имя + "." + ТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Таблица = Запрос.Выполнить().Выгрузить();
			Если Таблица.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить("   ТЧ " + ТЧ.Имя + ", строк в примере: " + Таблица.Количество());
			Для Каждого Стр Из Таблица Цикл
				Части = Новый Массив;
				Для Каждого Колонка Из Таблица.Колонки Цикл
					Если Колонка.Имя = "Ссылка" ИЛИ Колонка.Имя = "НомерСтроки" Тогда
						Продолжить;
					КонецЕсли;
					Значение = Стр[Колонка.Имя];
					Если ЗначениеЗаполнено(Значение) И Части.Количество() < 14 Тогда
						Части.Добавить(Колонка.Имя + "=" + ВидЗначенияДляДиагностики(Значение));
					КонецЕсли;
				КонецЦикла;
				Строки.Добавить("      " + СтрСоединить(Части, "; "));
			КонецЦикла;
		КонецЦикла;
	Исключение
		Строки.Добавить("   пример: не прочитан — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура РегистраторыПоВидам(Строки, ИмяРегистра, П)

	Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Остаточный = Метаданные.РегистрыНакопления[ИмяРегистра].ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 20000
			|	Т.Регистратор КАК Регистратор" + ?(Остаточный, ",
			|	Т.ВидДвижения КАК ВидДвижения", "") + "
			|ИЗ
			|	РегистрНакопления." + ИмяРегистра + " КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &Начало30 И &КонецДня");
		Запрос.УстановитьПараметр("Начало30", П.Начало30);
		Запрос.УстановитьПараметр("КонецДня", П.КонецДня);
		Выборка = Запрос.Выполнить().Выбрать();
		Счетчики = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			Попытка
				Имя = Выборка.Регистратор.Метаданные().Имя;
			Исключение
				Имя = "?";
			КонецПопытки;
			Ключ = Имя + ?(Остаточный, " — " + НРег(Строка(Выборка.ВидДвижения)), "");
			Счетчики.Вставить(Ключ, ЧислоИлиНоль(Счетчики[Ключ]) + 1);
		КонецЦикла;
		Строки.Добавить("");
		Строки.Добавить("РН." + ИмяРегистра + ":");
		Если Счетчики.Количество() = 0 Тогда
			Строки.Добавить("   движений нет");
		КонецЕсли;
		Для Каждого Элемент Из Счетчики Цикл
			Строки.Добавить("   " + Элемент.Ключ + ": " + Формат(Элемент.Значение, "ЧГ=0") + " док.");
		КонецЦикла;
	Исключение
		Строки.Добавить("РН." + ИмяРегистра + ": ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ИтогиРесурсов(Строки, ИмяРегистра, П)

	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		Строки.Добавить("РН." + ИмяРегистра + ": нет в конфигурации");
		Возврат;
	КонецЕсли;
	Попытка
		Поля = Новый Массив;
		Для Каждого Ресурс Из Мета.Ресурсы Цикл
			Поля.Добавить("СУММА(Т." + Ресурс.Имя + "Оборот) КАК " + Ресурс.Имя);
		КонецЦикла;
		Для Каждого Период Из СтрРазделить("Прошлый,Текущий", ",") Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ РегистрНакопления." + ИмяРегистра + ".Обороты(&Начало, &Конец) КАК Т");
			Запрос.УстановитьПараметр("Начало", ?(Период = "Текущий", П.НачалоМесяца, П.НачалоПрошлогоМесяца));
			Запрос.УстановитьПараметр("Конец", ?(Период = "Текущий", П.КонецДня, КонецМесяца(П.НачалоПрошлогоМесяца)));
			Таблица = Запрос.Выполнить().Выгрузить();
			Части = Новый Массив;
			Если Таблица.Количество() > 0 Тогда
				Для Каждого Колонка Из Таблица.Колонки Цикл
					Части.Добавить(Колонка.Имя + "=" + Формат(Таблица[0][Колонка.Имя], "ЧДЦ=0; ЧН=0; ЧГ=0"));
				КонецЦикла;
			КонецЕсли;
			Строки.Добавить("РН." + ИмяРегистра + ", обороты, " + НРег(Период) + " месяц: " + СтрСоединить(Части, "; "));
		КонецЦикла;
	Исключение
		Строки.Добавить("РН." + ИмяРегистра + ": ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДиагностикаРазделов(Строки, П)

	Р = Новый Структура("Ошибки, Выпуск, Заказы, Сырье, Продажи, Закупки, ЗакупкиГод, Маржа",
		Новый Соответствие, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);

	Строки.Добавить("Документы выпуска: " + СтрСоединить(ДокументыПроизводства(П), ", "));
	Строки.Добавить("Документы списания в производство: " + СтрСоединить(ДокументыПроизводства(П, Истина), ", "));
	Попытка
		Р.Выпуск = ПолучитьВыпуск(П);
		Строки.Добавить(СтрШаблон("Выпуск: за день %1, с начала месяца %2, в сутки %3", Р.Выпуск.ЗаДень, Р.Выпуск.ЗаМесяц, Р.Выпуск.ВСутки));
		Для Каждого Стр Из Р.Выпуск.ПоПродуктам Цикл
			Если Р.Выпуск.ПоПродуктам.Индекс(Стр) < 8 Тогда
				Строки.Добавить(СтрШаблон("   %1: месяц %2 %3, 7 дней %4", Стр.Номенклатура, Стр.ЗаМесяц, Стр.Ед, Стр.За7Дней));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Выпуск: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Продажи = ПолучитьПродажи(П);
		Строки.Добавить(СтрШаблон("Продажи: месяц %1, тот же период прошлого %2, весь прошлый %3", Р.Продажи.Месяц, Р.Продажи.ПрошлыйПериод, Р.Продажи.ПрошлыйМесяц));
		Для Каждого Стр Из Р.Продажи.ПоНоменклатуре Цикл
			Если Р.Продажи.ПоНоменклатуре.Индекс(Стр) < 8 Тогда
				Строки.Добавить(СтрШаблон("   %1: %2 %3 на %4, цена %5", Стр.Ключ, Стр.Количество, Стр.Ед, Стр.Сумма, Стр.Цена));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Продажи: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Маржа = ПолучитьМаржу(П);
		Строки.Добавить(СтрШаблон("Маржа: ресурсы себестоимости — %1; себестоимость прошлого месяца %2 (из неё косвенные %3), текущего %4 (косвенные %5)",
			Р.Маржа.РесурсСебестоимости, Р.Маржа.СебестоимостьПрошлого, Р.Маржа.КосвенныеПрошлого, Р.Маржа.СебестоимостьТекущего, Р.Маржа.КосвенныеТекущего));
	Исключение
		Строки.Добавить("Маржа: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Заказы = ПолучитьЗаказы(П, Р.Выпуск);
		Строки.Добавить(СтрШаблон("Заказы: источник — %1; открытых строк %2, заказов %3, на сумму %4", Р.Заказы.Источник,
			Р.Заказы.Открытые.Количество(), Р.Заказы.Заказов, Р.Заказы.Портфель));
		Для Каждого Стр Из Р.Заказы.Открытые Цикл
			Если Р.Заказы.Открытые.Индекс(Стр) < 8 Тогда
				Строки.Добавить(СтрШаблон("   %1 от %2: %3 — осталось %4 %5, срок %6, сумма %7", Стр.Номер, Формат(Стр.Заказ.Дата, "ДФ=dd.MM.yy"),
					Стр.Номенклатура, Стр.Осталось, Стр.Ед, Формат(Стр.Срок, "ДФ=dd.MM.yy"), Стр.Сумма));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Заказы: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Сырье = ПолучитьСырье(П);
		Строки.Добавить("Сырьё: позиций " + Р.Сырье.Материалы.Количество());
		Для Каждого Стр Из Р.Сырье.Материалы Цикл
			Если Р.Сырье.Материалы.Индекс(Стр) < 12 Тогда
				Строки.Добавить(СтрШаблон("   %1: остаток %2 %3, расход в сутки %4, в пути %5", Стр.Номенклатура, Стр.Остаток, Стр.Ед, Стр.ВСутки, Стр.ВПути));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Сырьё: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Продукты = Новый Массив;
		Если Р.Выпуск <> Неопределено Тогда
			Для Каждого Стр Из Р.Выпуск.ПоПродуктам Цикл
				Если Продукты.Количество() < 6 Тогда
					Продукты.Добавить(Стр.Номенклатура);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Продукты.Количество() = 0 И Р.Продажи <> Неопределено Тогда
			Для Каждого Стр Из Р.Продажи.ПоНоменклатуре Цикл
				Если Продукты.Количество() < 6 Тогда
					Продукты.Добавить(Стр.Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Нормы = НормыИзСпецификаций(Продукты, П);
		Выбранные = Нормы["Спецификации"];
		Строки.Добавить("Нормы на 1 базовую единицу продукта (основное сырьё отмечено *):");
		Для Каждого Ном Из Продукты Цикл
			Норма = Нормы[Ном];
			Если Норма = Неопределено Тогда
				Строки.Добавить("   " + Строка(Ном) + ": спецификация не найдена");
				Продолжить;
			КонецЕсли;
			Части = Новый Массив;
			Для Каждого Элемент Из Норма Цикл
				Части.Добавить(?(СырьеДляПотребности(Элемент.Ключ, Элемент.Значение.Статья, П), "*", "") + Строка(Элемент.Ключ) + " " + Формат(Элемент.Значение.Норма, "ЧДЦ=5") + " " + ЕдиницаНоменклатуры(Элемент.Ключ));
			КонецЦикла;
			Строки.Добавить("   " + Строка(Ном) + " [" + ЕдиницаНоменклатуры(Ном) + "; " + Строка(?(Выбранные = Неопределено, "", Выбранные[Ном])) + "]: " + СтрСоединить(Части, "; "));
		КонецЦикла;
	Исключение
		Строки.Добавить("Нормы: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Сигналы

&НаСервере
Функция НоваяТаблицаСигналов()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Уровень", ОписаниеЧисла()); // 0 критично, 1 внимание, 2 информация, 3 хорошо
	Т.Колонки.Добавить("Раздел");
	Т.Колонки.Добавить("Заголовок");
	Т.Колонки.Добавить("Текст");
	Возврат Т;

КонецФункции

&НаСервере
Процедура Сигнал(Р, Уровень, Раздел, ТекстЗаголовка, Текст = "")

	НовСтр = Р.Сигналы.Добавить();
	НовСтр.Уровень = Уровень;
	НовСтр.Раздел = Раздел;
	НовСтр.Заголовок = ТекстЗаголовка;
	НовСтр.Текст = Текст;

КонецПроцедуры

&НаСервере
Процедура СобратьСигналы(Р, П)

	Для Каждого Ошибка Из Р.Ошибки Цикл
		Имена = Новый Структура("ЗакупкиГод, Потребность, Сырье, Маржа", "Цены закупок", "Сырьё на план", "Сырьё", "Маржа");
		Имя = ?(Имена.Свойство(Ошибка.Ключ), Имена[Ошибка.Ключ], Ошибка.Ключ);
		Сигнал(Р, 1, Имя, "Раздел «" + Имя + "» не сформирован", Ошибка.Значение);
	КонецЦикла;

	Д = Р.Деньги;
	Если Д <> Неопределено И П.НеснижаемыйОстаток > 0 И Д.Итого < П.НеснижаемыйОстаток Тогда
		Сигнал(Р, 1, "Деньги", "Денег меньше неснижаемого остатка: " + ДеньгиКратко(Д.Итого), "Порог " + ДеньгиКратко(П.НеснижаемыйОстаток) + ".");
	КонецЕсли;

	Ф = Р.Финрезультат;
	Если Ф <> Неопределено И Ф.ЗакрытыхМесяцев > 0 Тогда
		ИтогКв = Ф.ЗаЗакрытые; // только закрытые месяцы квартала
		Если ИтогКв.Чистая < 0 Тогда
			Сигнал(Р, 0, "Финрезультат", "Убыток за " + Ф.ИмяКвартала + ": " + ДеньгиКратко(ИтогКв.Чистая),
				?(Ф.ЕстьПрямые, "Прибыль по прямым затратам " + ДеньгиКратко(ИтогКв.ПоПрямым) + ", ", "") + "прибыль от продаж " + ДеньгиКратко(ИтогКв.ОтПродаж) + ".");
		ИначеЕсли Ф.ЕстьПрямые И ИтогКв.ПоПрямым < 0 Тогда
			Сигнал(Р, 0, "Финрезультат", "Прямые затраты больше выручки за " + Ф.ИмяКвартала, "Прибыль по прямым затратам " + ДеньгиКратко(ИтогКв.ПоПрямым) + ".");
		КонецЕсли;
	КонецЕсли;

	А = Р.Аренда;
	Если А <> Неопределено И А.Свойство("Расхождения") И А.Расхождения.Количество() > 0 Тогда
		Сигнал(Р, 1, "Аренда", "Начисления аренды не совпадают с договором (" + А.Расхождения.Количество() + ")",
			Лев(СтрСоединить(А.Расхождения, "; "), 400) + ". Сравнение по распознанным PDF договоров, без НДС.");
	КонецЕсли;
	Если А <> Неопределено И А.Просрочено > 0 Тогда
		Сигнал(Р, 1, "Аренда", "Арендаторы просрочили оплату: " + ДеньгиКратко(А.Просрочено),
			"Арендаторов с просрочкой: " + А.СПросрочкой + ". Это вся просроченная дебиторка этих контрагентов (не только аренда). Подробности — в разделе «Арендаторы».");
	КонецЕсли;

	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		Если Нам.Просрочено > 0 Тогда
			Доля = ?(Нам.Всего = 0, 0, Нам.Просрочено / Нам.Всего * 100);
			Первый = Нам.ПоКонтрагентам[0];
			Сигнал(Р, ?(Доля >= 30, 0, 1), "Долги", "Просроченная дебиторка " + ДеньгиКратко(Нам.Просрочено) + " — " + Формат(Доля, "ЧДЦ=0") + " % долга покупателей",
				СтрШаблон("Больше всех должен %1: %2, до %3 дн. просрочки.", Первый.Контрагент, ДеньгиКратко(Первый.Просрочено), Первый.МаксПросрочка));
		КонецЕсли;
		Старые = Нам.Корзины[3].Сумма + Нам.Корзины[4].Сумма;
		Если Старые > 0 Тогда
			Сигнал(Р, 1, "Долги", "Долги покупателей старше 60 дней: " + ДеньгиКратко(Старые),
				"Высокий риск невозврата: претензия, суд или резерв по сомнительным долгам.");
		КонецЕсли;
		Мы = Р.Долги.МыДолжны;
		Если Мы.Просрочено > 0 Тогда
			Имена = Новый Массив;
			Для Каждого Стр Из Мы.ПоКонтрагентам Цикл
				Если Стр.Просрочено > 0 И Имена.Количество() < 3 Тогда
					Имена.Добавить(Строка(Стр.Контрагент));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Долги", "Мы просрочили оплату поставщикам на " + ДеньгиКратко(Мы.Просрочено), СтрСоединить(Имена, ", "));
		КонецЕсли;
	КонецЕсли;

	С = Р.Сырье;
	Если С <> Неопределено Тогда
		Для Каждого Стр Из С.Нехватка Цикл
			Сигнал(Р, 0, "Сырьё", Строка(Стр.Номенклатура) + ": " + Стр.Пояснение,
				СтрШаблон("Остаток %1 %3, расход %2 %3 в сутки.", ФорматЧисла(Стр.Остаток), ФорматЧисла(Стр.ВСутки), Стр.Ед));
		КонецЦикла;
		Для Каждого Стр Из С.Заказать Цикл
			Сигнал(Р, 1, "Сырьё", Строка(Стр.Номенклатура) + ": пора заказывать",
				СтрШаблон("Хватит на %1 дн. вместе с поставкой. Заказать %2 %3.", Формат(Стр.ХватитСПоставкой, "ЧДЦ=1; ЧН=0"), ФорматЧисла(Стр.Заказать), Стр.Ед));
		КонецЦикла;
	КонецЕсли;

	З = Р.Заказы;
	Если З <> Неопределено Тогда
		Если З.Просроченные.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из З.Просроченные Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 %2 — %3 дн.", Стр.Номер, Стр.Клиент, Стр.Просрочка));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 0, "Заказы", "Сорван срок отгрузки: " + З.Просроченные.Количество() + " "
				+ Склонение(З.Просроченные.Количество(), "позиция", "позиции", "позиций") + " заказов", СтрСоединить(Части, "; "));
		КонецЕсли;
		Если З.НеУспеваем.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из З.НеУспеваем Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 %2 %3 %4 до %5", Стр.Номер, Стр.Номенклатура, ФорматЧисла(Стр.Осталось), Стр.Ед, Формат(Стр.Срок, "ДФ=dd.MM")));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Заказы", "Не успеваем выпустить к сроку: " + З.НеУспеваем.Количество() + " "
				+ Склонение(З.НеУспеваем.Количество(), "позиция", "позиции", "позиций"), СтрСоединить(Части, "; "));
		КонецЕсли;
	КонецЕсли;

	В = Р.Выпуск;
	ДеньВведен = В <> Неопределено И ЗначениеЗаполнено(В.ПоследнийВыпуск) И НачалоДня(В.ПоследнийВыпуск) >= П.День;
	Если В <> Неопределено И ЗначениеЗаполнено(В.ПоследнийВыпуск) И НачалоДня(В.ПоследнийВыпуск) < П.День - 2 * 86400 Тогда
		Сигнал(Р, 1, "Выпуск", "Суточные рапорты не введены с " + Формат(В.ПоследнийВыпуск, "ДФ=dd.MM"),
			"Выпуск за последние дни в базе отсутствует, цифры месяца занижены.");
	КонецЕсли;
	Если В <> Неопределено И В.План > 0 Тогда
		Процент = В.ЗаДень / В.План * 100;
		Если НЕ ДеньВведен Тогда
			// за сутки рапорта нет — оценку суток не даём
		ИначеЕсли Процент < 90 Тогда
			Сигнал(Р, ?(Процент < 75, 0, 1), "Выпуск", СтрШаблон("Выпуск за сутки %1 %% плана: %2 из %3", Формат(Процент, "ЧДЦ=0; ЧН=0"), ФорматЧисла(В.ЗаДень), ФорматЧисла(В.План)));
		ИначеЕсли Процент >= 100 Тогда
			Сигнал(Р, 3, "Выпуск", СтрШаблон("План суток выполнен: %1 %%", Формат(Процент, "ЧДЦ=0")));
		КонецЕсли;
		Если В.ПланМесяца > 0 И В.Прогноз < В.ПланМесяца * 0.97 Тогда
			Нужно = ?(В.ОсталосьДней > 0, (В.ПланМесяца - В.ЗаМесяц) / В.ОсталосьДней, 0);
			Сигнал(Р, 1, "Выпуск", СтрШаблон("Прогноз месяца %1 %% плана: %2 из %3 %4", Формат(В.Прогноз / В.ПланМесяца * 100, "ЧДЦ=0"), ФорматЧисла(В.Прогноз), ФорматЧисла(В.ПланМесяца), В.ГлавнаяЕд),
				СтрШаблон("Чтобы выполнить план, нужно %1 в сутки при текущих %2.", ФорматЧисла(Нужно), ФорматЧисла(В.ВСутки)));
		КонецЕсли;
	КонецЕсли;

	Если Д <> Неопределено Тогда
		Для Каждого Стр Из Д.Платежи Цикл
			Если Стр.Сумма >= П.КрупныйПлатеж И П.КрупныйПлатеж > 0 Тогда
				Если Стр.Вид = "приход" Тогда
					Сигнал(Р, 3, "Деньги", "Поступило " + ДеньгиКратко(Стр.Сумма) + " от " + Строка(Стр.Контрагент), Строка(Стр.Назначение));
				Иначе
					Сигнал(Р, 2, "Деньги", "Оплачено " + ДеньгиКратко(Стр.Сумма) + ": " + Строка(Стр.Контрагент), Строка(Стр.Назначение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Пр = Р.Продажи;
	Если Пр <> Неопределено И Пр.Изменение <> Неопределено Тогда
		Если Пр.Изменение <= -15 Тогда
			Сигнал(Р, 1, "Продажи", СтрШаблон("Выручка с начала месяца на %1 %% ниже, чем за тот же период прошлого месяца", Формат(-Пр.Изменение, "ЧДЦ=0")),
				ДеньгиКратко(Пр.Месяц) + " против " + ДеньгиКратко(Пр.ПрошлыйПериод) + ".");
		ИначеЕсли Пр.Изменение >= 15 Тогда
			Сигнал(Р, 3, "Продажи", СтрШаблон("Выручка с начала месяца выросла на %1 %% к прошлому месяцу", Формат(Пр.Изменение, "ЧДЦ=0")),
				ДеньгиКратко(Пр.Месяц) + " против " + ДеньгиКратко(Пр.ПрошлыйПериод) + ".");
		КонецЕсли;
	КонецЕсли;
	Если Пр <> Неопределено Тогда
		Подешевели = Новый Массив;
		Для Каждого Стр Из Пр.ПоНоменклатуре Цикл
			Если Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены <= -5 И Стр.Сумма > 0 И Подешевели.Количество() < 4 Тогда
				Подешевели.Добавить(Строка(Стр.Ключ) + " " + Формат(Стр.ИзмЦены, "ЧДЦ=1") + " %");
			КонецЕсли;
		КонецЦикла;
		Если Подешевели.Количество() > 0 Тогда
			Сигнал(Р, 1, "Продажи", "Продаём дешевле, чем в прошлом месяце", СтрСоединить(Подешевели, "; "));
		КонецЕсли;
	КонецЕсли;
	Если Р.Маржа <> Неопределено И Р.Маржа.СебестоимостьПрошлого <> 0 Тогда
		Убыточные = Новый Массив;
		Для Каждого Стр Из Р.Маржа.Прошлый Цикл
			Если Стр.Прибыль < 0 И Убыточные.Количество() < 5 Тогда
				Убыточные.Добавить(Строка(Стр.Номенклатура) + " (" + ДеньгиКратко(Стр.Прибыль) + ")");
			КонецЕсли;
		КонецЦикла;
		Если Убыточные.Количество() > 0 Тогда
			Сигнал(Р, 0, "Продажи", "Продажи дешевле прямых затрат за " + ИмяМесяца(Месяц(П.НачалоПрошлогоМесяца), Ложь), СтрСоединить(Убыточные, "; "));
		КонецЕсли;
	КонецЕсли;
	Зк = Р.Закупки;
	Если Зк <> Неопределено Тогда
		Подорожали = Новый Массив;
		Для Каждого Стр Из Зк.ПоНоменклатуре Цикл
			Если Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены >= 5 И Подорожали.Количество() < 5 Тогда
				Подорожали.Добавить(Строка(Стр.Ключ) + " +" + Формат(Стр.ИзмЦены, "ЧДЦ=1") + " %");
			КонецЕсли;
		КонецЦикла;
		Если Подорожали.Количество() > 0 Тогда
			Сигнал(Р, 1, "Закупки", "Сырьё и материалы подорожали к прошлому месяцу", СтрСоединить(Подорожали, "; "));
		КонецЕсли;
	КонецЕсли;
	Если Р.Запасы <> Неопределено Тогда
		Мало = Р.Запасы.Таблица.НайтиСтроки(Новый Структура("Статус", "мало"));
		Если Мало.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из Мало Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1: остаток %2, в заказах %3", Стр.Номенклатура, ФорматЧисла(Стр.Остаток), ФорматЧисла(Стр.ВЗаказах)));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Запасы", "Готовой продукции меньше чем на 3 дня отгрузок", СтрСоединить(Части, "; "));
		КонецЕсли;
		Лежит = Р.Запасы.Таблица.НайтиСтроки(Новый Структура("Статус", "затоваривание"));
		Если Лежит.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из Лежит Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 — на %2 дн.", Стр.Номенклатура, Формат(Стр.ДнейЗапаса, "ЧДЦ=0")));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 2, "Запасы", "Затоваривание готовой продукции", СтрСоединить(Части, "; "));
		КонецЕсли;
	КонецЕсли;
	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		Если Нам.ВсегоНаНачало > 0 И Нам.Всего > Нам.ВсегоНаНачало * 1.1 Тогда
			Сигнал(Р, 2, "Долги", "Долг покупателей вырос с начала месяца на " + ДеньгиКратко(Нам.Всего - Нам.ВсегоНаНачало),
				ДеньгиКратко(Нам.ВсегоНаНачало) + " → " + ДеньгиКратко(Нам.Всего) + ".");
		КонецЕсли;
	КонецЕсли;

	Пт = Р.Потребность;
	Если Пт <> Неопределено Тогда
		НаЗаказы = Новый Массив;
		НаПлан = Новый Массив;
		Для Каждого Стр Из Пт.Таблица Цикл
			Если Стр.НехваткаМесяц > 0 И НаЗаказы.Количество() < 5 Тогда
				НаЗаказы.Добавить(СтрШаблон("%1 — %2 %3", Стр.Номенклатура, ФорматЧисла(Стр.НехваткаМесяц), Стр.Ед));
			ИначеЕсли Стр.НехваткаДвухМесяцев > 0 И НаПлан.Количество() < 5 Тогда
				НаПлан.Добавить(СтрШаблон("%1 — %2 %3", Стр.Номенклатура, ФорматЧисла(Стр.НехваткаДвухМесяцев), Стр.Ед));
			КонецЕсли;
		КонецЦикла;
		Если НаЗаказы.Количество() > 0 Тогда
			Сигнал(Р, 0, "Сырьё на план", "Основного сырья не хватит на план этого месяца", СтрСоединить(НаЗаказы, "; "));
		КонецЕсли;
		Если НаПлан.Количество() > 0 Тогда
			Сигнал(Р, 1, "Сырьё на план", "На план следующего месяца не хватает сырья, докупить ≈ " + ДеньгиКратко(Пт.СуммаДокупки), СтрСоединить(НаПлан, "; "));
		КонецЕсли;
		Если Пт.БезНорм.Количество() > 0 Тогда
			Сигнал(Р, 2, "Сырьё на план", "Нет спецификации у " + Пт.БезНорм.Количество() + " " + Склонение(Пт.БезНорм.Количество(), "продукта", "продуктов", "продуктов") + " из плана",
				"Их потребность в сырье не посчитана: " + Лев(СтрСоединить(Пт.БезНорм, ", "), 300));
		КонецЕсли;
		Если Пт.НеРазложены.Количество() > 0 Тогда
			Сигнал(Р, 2, "Сырьё на план", "Нет спецификации у " + Пт.НеРазложены.Количество() + " " + Склонение(Пт.НеРазложены.Количество(), "полуфабриката", "полуфабрикатов", "полуфабрикатов"),
				"Сырьё на них не посчитано, потребность занижена: " + Лев(СтрСоединить(Пт.НеРазложены, ", "), 300));
		КонецЕсли;
	КонецЕсли;
	Зг = Р.ЗакупкиГод;
	Если Зг <> Неопределено Тогда
		Рост = Новый Массив;
		Для Каждого Стр Из Зг.Материалы Цикл
			Если Стр.ИзмГод <> Неопределено И Стр.ИзмГод >= 15 И Рост.Количество() < 5 Тогда
				Рост.Добавить(Строка(Стр.Номенклатура) + " +" + Формат(Стр.ИзмГод, "ЧДЦ=0") + " %");
			КонецЕсли;
		КонецЦикла;
		Если Рост.Количество() > 0 Тогда
			Сигнал(Р, 2, "Цены закупок", "За год сильно подорожало сырьё", СтрСоединить(Рост, "; "));
		КонецЕсли;
		Если Зг.Переплата >= 100000 Тогда
			Сигнал(Р, 1, "Цены закупок", "За 3 месяца переплатили поставщикам ≈ " + ДеньгиКратко(Зг.Переплата) + " против лучших цен",
				"Одно и то же сырьё покупали у разных поставщиков по разной цене — см. раздел «Закупочные цены за 12 месяцев».");
		КонецЕсли;
	КонецЕсли;

	Р.Сигналы.Сортировать("Уровень");

КонецПроцедуры

#КонецОбласти

#Область ВыводВТабличныйДокумент

// Сетка: колонка 1 — названия (широкая), колонки 2–8 — числа.

&НаСервере
Функция Вывести(Р, П)

	В = Новый Структура("ТД, Строка", Новый ТабличныйДокумент, 1);
	ТД = В.ТД;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.АвтоМасштаб = Истина;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТД.ПолеСлева = 10;
	ТД.ПолеСправа = 10;
	Для К = 1 По 8 Цикл
		ШирКол = ?(К = 1, 36, 15);
		Попытка
			ТД.Область("C" + Формат(К, "ЧГ=0")).ШиринаКолонки = ШирКол;
		Исключение
			ТД.Область(1, К, 1, К).ШиринаКолонки = ШирКол;
		КонецПопытки;
	КонецЦикла;

	Организация = ?(ЗначениеЗаполнено(П.Организация), Строка(П.Организация), "Все организации");
	Ячейка(В, 1, Организация, , ЦветПриглушенный(), , 9, 8);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Ежедневный отчёт за " + Формат(П.День, "ДЛФ=DD") + ", " + НРег(Формат(П.День, "ДФ=dddd")), Истина, , , 16, 8);
	ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 26;
	СледующаяСтрока(В);
	Ячейка(В, 1, "Сформирован " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'") + ", " + Строка(Пользователи.ТекущийПользователь()), , ЦветПриглушенный(), , 9, 8);
	Черта(В, 1, 8, 2);
	СледующаяСтрока(В, 2);

	ВывестиГлавное(В, Р, П);
	ВывестиДеньги(В, Р, П);
	ВывестиДолги(В, Р, П);
	ВывестиПродажи(В, Р, П);
	ВывестиФинрезультат(В, Р, П);
	ВывестиАренду(В, Р, П);
	ВывестиЗаказы(В, Р, П);
	ВывестиВыпуск(В, Р, П);
	ВывестиЗапасы(В, Р, П);
	ВывестиСырье(В, Р, П);
	ВывестиПотребность(В, Р, П);
	ВывестиЗакупки(В, Р, П);
	ВывестиЦеныЗакупок(В, Р, П);

	СледующаяСтрока(В);
	Ячейка(В, 1, "Суммы в рублях регламентированного учёта по данным оперативного учёта ERP. Выпуск — приход на склад документами производства; "
		+ "расход сырья — списание со складов в производство.", , ЦветПриглушенный(), , 8, 8, Истина);
	ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
	Возврат ТД;

КонецФункции

&НаСервере
Процедура ВывестиГлавное(В, Р, П)

	ЗаголовокРаздела(В, "Главное");
	Шапка(В, "Показатель", "Значение", "", "Комментарий");
	Д = Р.Деньги;
	Если Д <> Неопределено Тогда
		Изменение = Д.Итого - Д.ИтогоВчера;
		Уровень = ?(П.НеснижаемыйОстаток > 0 И Д.Итого < П.НеснижаемыйОстаток, 1, -1);
		СтрокаГлавного(В, "Деньги на счетах и в кассе", ДеньгиКратко(Д.Итого), Уровень,
			"за день " + ?(Изменение > 0, "+", "") + ДеньгиКратко(Изменение));
		Деп = Д.Депозиты;
		ИзменениеДеп = Деп.Сегодня - Деп.Вчера;
		СтрокаГлавного(В, "Депозиты", ДеньгиКратко(Деп.Сегодня), -1,
			?(ПустаяСтрока(Деп.Ошибка), ?(ПустаяСтрока(Деп.Источник), "в базе не найдены",
			"за день " + ?(ИзменениеДеп > 0, "+", "") + ДеньгиКратко(ИзменениеДеп)), "не прочитаны: " + Деп.Ошибка));
		ИзменениеВсего = Д.ВсегоСДепозитами - Д.ВсегоСДепозитамиВчера;
		СтрокаГлавного(В, "Итого: деньги и депозиты", ДеньгиКратко(Д.ВсегоСДепозитами), -1,
			"за день " + ?(ИзменениеВсего > 0, "+", "") + ДеньгиКратко(ИзменениеВсего));
	КонецЕсли;
	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		СтрокаГлавного(В, "Нам должны покупатели", ДеньгиКратко(Нам.Всего),
			?(Нам.Просрочено = 0, -1, ?(Нам.Всего > 0 И Нам.Просрочено / Нам.Всего >= 0.3, 0, 1)), "просрочено " + ДеньгиКратко(Нам.Просрочено));
		Мы = Р.Долги.МыДолжны;
		СтрокаГлавного(В, "Мы должны поставщикам", ДеньгиКратко(Мы.Всего), ?(Мы.Просрочено = 0, -1, 1), "просрочено " + ДеньгиКратко(Мы.Просрочено));
	КонецЕсли;
	Ф = Р.Финрезультат;
	Если Ф <> Неопределено И Ф.ЗакрытыхМесяцев > 0 Тогда
		ИтогКв = Ф.ЗаЗакрытые; // только закрытые месяцы квартала
		СтрокаГлавного(В, "Чистая прибыль, " + Ф.ИмяКвартала + " (" + Ф.ЗакрытыхМесяцев + " мес.)", ДеньгиКратко(ИтогКв.Чистая),
			?(ИтогКв.Чистая < 0, 0, -1), ?(Ф.ЕстьПрямые, "по прямым затратам " + ДеньгиКратко(ИтогКв.ПоПрямым) + ", ", "") + "от продаж " + ДеньгиКратко(ИтогКв.ОтПродаж)
			+ ", рентабельность продаж " + ?(ИтогКв.Выручка = 0, "—", Формат(ИтогКв.ОтПродаж / ИтогКв.Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"));
	КонецЕсли;
	Если Ф <> Неопределено И Ф.ЕстьГод Тогда
		Год0 = Ф.Колонки[5];
		Год1 = Ф.Колонки[6];
		Изм = "";
		Если Год1.Чистая <> 0 Тогда
			Процент = (Год0.Чистая / Год1.Чистая - 1) * 100 * ?(Год1.Чистая < 0, -1, 1);
			Изм = ", год назад " + ДеньгиКратко(Год1.Чистая) + " (" + ?(Процент > 0, "+", "") + Формат(Процент, "ЧДЦ=0; ЧН=0") + " %)";
		КонецЕсли;
		СтрокаГлавного(В, "Чистая прибыль с начала года (" + Год0.Заголовок + ")", ДеньгиКратко(Год0.Чистая),
			?(Год0.Чистая < 0, 0, ?(Год0.Чистая < Год1.Чистая, 1, -1)),
			"выручка " + ДеньгиКратко(Год0.Выручка) + Изм + ", два года назад " + ДеньгиКратко(Ф.Колонки[7].Чистая));
	КонецЕсли;
	Зп = Р.Запасы;
	Если Зп <> Неопределено И Зп.Свойство("НеХватает") Тогда
		НеХватаетПоз = 0;
		Для Каждого Стр Из Зп.Таблица Цикл
			Если Стр.НеХватает > 0 Тогда
				НеХватаетПоз = НеХватаетПоз + 1;
			КонецЕсли;
		КонецЦикла;
		Если НеХватаетПоз > 0 Тогда
			СтрокаГлавного(В, "Готовой продукции не хватает под заказы", НеХватаетПоз + " поз.", 1,
				"на складе меньше, чем осталось отгрузить по открытым заказам — см. «Остатки готовой продукции»");
		КонецЕсли;
	КонецЕсли;
	А = Р.Аренда;
	Если А <> Неопределено И А.Таблица.Количество() > 0 Тогда
		СтрокаГлавного(В, "Аренда: начислено с 1-го числа", ДеньгиКратко(А.Месяц), ?(А.Просрочено > 0, 1, -1),
			СтрШаблон("арендаторов %1, долг %2, просрочено %3", А.Таблица.Количество(), ДеньгиКратко(А.Долг), ДеньгиКратко(А.Просрочено)));
	КонецЕсли;
	З = Р.Заказы;
	Если З <> Неопределено Тогда
		СтрокаГлавного(В, "Портфель заказов к отгрузке", ДеньгиКратко(З.Портфель),
			?(З.Просроченные.Количество() > 0, 0, ?(З.НеУспеваем.Количество() > 0, 1, -1)),
			СтрШаблон("%1 %2, просроченных позиций %3", З.Заказов, Склонение(З.Заказов, "заказ", "заказа", "заказов"), З.Просроченные.Количество()));
	КонецЕсли;
	Вып = Р.Выпуск;
	Если Вып <> Неопределено Тогда
		Ед = " " + Вып.ГлавнаяЕд;
		Если Вып.ПланМесяца > 0 Тогда
			Процент = Вып.ЗаМесяц / Вып.ПланМесяца * 100;
			ПроцентКДате = ?(Вып.ПланНаСегодня = 0, 0, Вып.ЗаМесяц / Вып.ПланНаСегодня * 100);
			СтрокаГлавного(В, "Выпуск с начала месяца", ФорматЧисла(Вып.ЗаМесяц) + Ед, ?(ПроцентКДате >= 100, 3, ?(ПроцентКДате >= 90, -1, ?(ПроцентКДате >= 75, 1, 0))),
				Формат(Процент, "ЧДЦ=0; ЧН=0") + " % плана месяца " + ФорматЧисла(Вып.ПланМесяца) + Ед + "; к сегодняшней дате " + Формат(ПроцентКДате, "ЧДЦ=0; ЧН=0")
				+ " %; последний рапорт " + ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск), Формат(Вып.ПоследнийВыпуск, "ДФ=dd.MM"), "—"));
		Иначе
			СтрокаГлавного(В, "Выпуск с начала месяца", ФорматЧисла(Вып.ЗаМесяц) + Ед, -1, "плана производства на месяц нет; последний рапорт "
				+ ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск), Формат(Вып.ПоследнийВыпуск, "ДФ=dd.MM"), "—"));
		КонецЕсли;
	КонецЕсли;
	С = Р.Сырье;
	Если С <> Неопределено Тогда
		СтрокаГлавного(В, "Сырьё: нехватка / пора заказывать", Формат(С.Нехватка.Количество(), "ЧН=0") + " / " + Формат(С.Заказать.Количество(), "ЧН=0"),
			?(С.Нехватка.Количество() > 0, 0, ?(С.Заказать.Количество() > 0, 1, 3)), "позиций из " + Формат(С.Материалы.Количество(), "ЧН=0"));
	КонецЕсли;
	Пр = Р.Продажи;
	Если Пр <> Неопределено Тогда
		СтрокаГлавного(В, "Выручка без НДС с 1-го числа", ДеньгиКратко(Пр.Месяц),
			?(Пр.Изменение = Неопределено, -1, ?(Пр.Изменение <= -15, 1, ?(Пр.Изменение >= 10, 3, -1))),
			"за день " + ДеньгиКратко(Пр.ЗаДень) + ?(Пр.Изменение = Неопределено, "", "; к тому же периоду прошлого месяца "
			+ ?(Пр.Изменение > 0, "+", "") + Формат(Пр.Изменение, "ЧДЦ=1; ЧН=0") + " %"));
	КонецЕсли;
	Если Р.Маржа <> Неопределено Тогда
		ВыручкаМ = Р.Маржа.Прошлый.Итог("Выручка");
		ПрибыльМ = Р.Маржа.Прошлый.Итог("Прибыль");
		Если ВыручкаМ <> 0 И Р.Маржа.СебестоимостьПрошлого <> 0 Тогда
			Рент = ПрибыльМ / ВыручкаМ * 100;
			СтрокаГлавного(В, "Прибыль по прямым затратам за " + ИмяМесяца(Месяц(П.НачалоПрошлогоМесяца), Ложь), ДеньгиКратко(ПрибыльМ),
				?(Рент < 0, 0, ?(Рент < 10, 1, -1)), "рентабельность " + Формат(Рент, "ЧДЦ=1; ЧН=0") + " % от выручки " + ДеньгиКратко(ВыручкаМ));
		КонецЕсли;
	КонецЕсли;
	Зк = Р.Закупки;
	Если Зк <> Неопределено Тогда
		Подорожало = 0;
		Для Каждого Стр Из Зк.ПоНоменклатуре Цикл
			Если Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены >= 5 Тогда
				Подорожало = Подорожало + 1;
			КонецЕсли;
		КонецЦикла;
		СтрокаГлавного(В, "Закупки с 1-го числа", ДеньгиКратко(Зк.Месяц), ?(Подорожало > 0, 1, -1),
			?(Подорожало > 0, "подорожали на 5 % и больше: " + Подорожало + " поз.", "заметных подорожаний нет"));
	КонецЕсли;
	Пт = Р.Потребность;
	Если Пт <> Неопределено И Пт.Таблица.Количество() > 0 Тогда
		НеХватает = 0;
		БезЦены = 0;
		Для Каждого Стр Из Пт.Таблица Цикл
			Если Стр.НехваткаДвухМесяцев > 0 Тогда
				НеХватает = НеХватает + 1;
				Если Стр.Цена = 0 Тогда
					БезЦены = БезЦены + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СтрокаГлавного(В, "Основное сырьё на план (этот и след. месяц)", ?(НеХватает = 0, "хватает", "докупить " + ДеньгиКратко(Пт.СуммаДокупки)),
			?(Пт.Таблица.Итог("НехваткаМесяц") > 0, 0, ?(НеХватает > 0, 1, 3)),
			?(НеХватает = 0, "с учётом остатков и поставок в пути", "не хватает " + НеХватает + " поз. из " + Пт.Таблица.Количество()
			+ ?(БезЦены > 0, "; у " + БезЦены + " поз. нет цены закупки — в сумму не вошли", "")));
	КонецЕсли;

	СледующаяСтрока(В);
	Крит = Р.Сигналы.НайтиСтроки(Новый Структура("Уровень", 0)).Количество();
	Вним = Р.Сигналы.НайтиСтроки(Новый Структура("Уровень", 1)).Количество();
	Ячейка(В, 1, СтрШаблон("Что требует решения: критично — %1, внимание — %2", Крит, Вним), Истина, , , 11, 8);
	СледующаяСтрока(В);
	Если Р.Сигналы.Количество() = 0 Тогда
		Ячейка(В, 1, "Все показатели в норме.", , ЦветПриглушенный(), , , 8);
		СледующаяСтрока(В);
	КонецЕсли;
	Значки = СтрРазделить("‼,!,i,✓", ",");
	Для Каждого Сиг Из Р.Сигналы Цикл
		Фон = ?(Сиг.Уровень = 0, ФонКрит(), ?(Сиг.Уровень = 1, ФонВнимание(), ?(Сиг.Уровень = 3, ФонХорошо(), ЦветФонаШапки())));
		Цвет = ?(Сиг.Уровень = 0, ЦветКрит(), ?(Сиг.Уровень = 1, ЦветВнимание(), ?(Сиг.Уровень = 3, ЦветХорошо(), ЦветПриглушенный())));
		Ячейка(В, 1, Значки[Сиг.Уровень] + "  " + Сиг.Раздел, Истина, Цвет, Фон);
		Ячейка(В, 2, Сиг.Заголовок, Истина, , Фон, , 8, Истина);
		ПодогнатьВысоту(В, Сиг.Заголовок, 7 * 15);
		СледующаяСтрока(В);
		Если ЗначениеЗаполнено(Сиг.Текст) Тогда
			Ячейка(В, 1, "", , , Фон);
			Ячейка(В, 2, Сиг.Текст, , ЦветПриглушенный(), Фон, 9, 8, Истина);
			ПодогнатьВысоту(В, Сиг.Текст, 7 * 15);
			СледующаяСтрока(В);
		КонецЕсли;
		СледующаяСтрока(В, 0.25);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СтрокаГлавного(В, Название, Значение, Уровень, Комментарий)

	Цвет = ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ?(Уровень = 3, ЦветХорошо(), Неопределено)));
	Фон = ?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ?(Уровень = 3, ФонХорошо(), Неопределено)));
	Ячейка(В, 1, Название);
	Ячейка(В, 2, Значение, Истина, Цвет, Фон, 11, 3);
	ВПраво(В, 2, 3);
	Ячейка(В, 4, Комментарий, , ЦветПриглушенный(), , 9, 8);
	ЛинияСнизу(В, 1, 8);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ВывестиДеньги(В, Р, П)

	ЗаголовокРаздела(В, "Деньги");
	Если ПоказатьОшибку(В, Р, "Деньги") Тогда
		Возврат;
	КонецЕсли;
	Д = Р.Деньги;

	Подзаголовок(В, "Остатки на конец дня");
	Шапка(В, "Счёт / касса", "На " + Формат(П.День - 86400, "ДФ=dd.MM"), "На " + Формат(П.День, "ДФ=dd.MM"), "Изменение");
	Для Каждого Стр Из Д.Счета Цикл
		Ячейка(В, 1, Строка(Стр.Вид) + ": " + Строка(Стр.Счет));
		ЯчейкаЧисло(В, 2, Стр.Вчера);
		ЯчейкаЧисло(В, 3, Стр.Сегодня);
		ЯчейкаЧисло(В, 4, Стр.Сегодня - Стр.Вчера, ЦветИзменения(Стр.Сегодня - Стр.Вчера));
		ЛинияСнизу(В, 1, 4);
		СледующаяСтрока(В);
	КонецЦикла;
	СтрокаИтога(В, "Итого на счетах и в кассе", Д.ИтогоВчера, Д.Итого, Д.Итого - Д.ИтогоВчера);
	Деп = Д.Депозиты;
	Ячейка(В, 1, "Депозиты");
	ЯчейкаЧисло(В, 2, Деп.Вчера);
	ЯчейкаЧисло(В, 3, Деп.Сегодня);
	ЯчейкаЧисло(В, 4, Деп.Сегодня - Деп.Вчера, ЦветИзменения(Деп.Сегодня - Деп.Вчера));
	ЛинияСнизу(В, 1, 4);
	СледующаяСтрока(В);
	СтрокаИтога(В, "Итого с депозитами", Д.ВсегоСДепозитамиВчера, Д.ВсегоСДепозитами, Д.ВсегоСДепозитами - Д.ВсегоСДепозитамиВчера);
	Примечание(В, "Депозиты: " + ?(НЕ ПустаяСтрока(Деп.Ошибка), "не прочитаны — " + Деп.Ошибка,
		?(ПустаяСтрока(Деп.Источник), "в базе не найдены. Проверено: " + ?(Деп.Пути.Количество() = 0, "регистров с договорами депозитов нет", СтрСоединить(Деп.Пути, "; "))
			+ ". Нажмите «Диагностика» и пришлите файл.",
		"источник — " + Деп.Источник + ".")));

	СледующаяСтрока(В);
	Подзаголовок(В, "Движение денег");
	Шапка(В, "", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа");
	Ячейка(В, 1, "Поступило");
	ЯчейкаЧисло(В, 2, Д.Приход, ЦветХорошо());
	ЯчейкаЧисло(В, 3, Д.ПриходМесяц);
	ЛинияСнизу(В, 1, 3);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Оплачено");
	ЯчейкаЧисло(В, 2, Д.Расход, ЦветКрит());
	ЯчейкаЧисло(В, 3, Д.РасходМесяц);
	ЛинияСнизу(В, 1, 3);
	СледующаяСтрока(В);
	СтрокаИтога(В, "Сальдо", Д.Приход - Д.Расход, Д.ПриходМесяц - Д.РасходМесяц);
	Если Д.Перемещений > 0 Тогда
		Примечание(В, "Внутренние перемещения между своими счетами и кассой (" + Д.Перемещений + ") в приход и расход не включены.");
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Деньги за день: сначала поступления, потом платежи");
	Если Д.Платежи.Количество() = 0 Тогда
		Примечание(В, "Движения по счетам и кассе за день нет.");
	Иначе
		Шапка(В, "Контрагент", "", "Статья", "", "Назначение", "", "", "Сумма");
		ТекущийВид = "";
		Для Каждого Стр Из Д.Платежи Цикл
			Если Стр.Вид <> ТекущийВид Тогда
				ТекущийВид = Стр.Вид;
				ЭтоПриход = ТекущийВид = "приход";
				СуммаВида = 0;
				Для Каждого Пл Из Д.Платежи.НайтиСтроки(Новый Структура("Вид", ТекущийВид)) Цикл
					СуммаВида = СуммаВида + Пл.Сумма;
				КонецЦикла;
				Фон = ?(ЭтоПриход, ФонХорошо(), ФонВнимание());
				Ячейка(В, 1, ?(ЭтоПриход, "ПОСТУПЛЕНИЯ", "ПЛАТЕЖИ"), Истина, ?(ЭтоПриход, ЦветХорошо(), ЦветАкцент()), Фон, , 7);
				ЯчейкаЧисло(В, 8, СуммаВида, , Истина, Фон);
				СледующаяСтрока(В);
			КонецЕсли;
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			Ячейка(В, 2, Стр.Вид, Истина, ?(Стр.Вид = "приход", ЦветХорошо(), ЦветПриглушенный()));
			Ячейка(В, 3, Строка(Стр.Статья), , , , 9, 4, Истина);
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.Назначение), Строка(Стр.Назначение), Строка(Стр.Документ)), , ЦветПриглушенный(), , 9, 7, Истина);
			ЯчейкаЧисло(В, 8, Стр.Сумма, ?(Стр.Вид = "приход", ЦветХорошо(), Неопределено));
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ПодогнатьВысоту(В, Строка(Стр.Назначение), 45);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Остаток денег на конец дня за 14 дней");
	Точки = Новый Массив;
	Значения = Новый Массив;
	Шапка(В, "Дата", "Остаток", "За день");
	Предыдущий = Неопределено;
	Для Каждого Стр Из Д.Динамика Цикл
		Точки.Добавить(Формат(Стр.Дата, "ДФ=dd.MM"));
		Значения.Добавить(Стр.Остаток);
		Ячейка(В, 1, Формат(Стр.Дата, "ДФ='dd.MM, ddd'"), Стр.Дата = П.День, ?(Стр.Дата = П.День, Неопределено, ЦветПриглушенный()), , 9);
		ЯчейкаЧисло(В, 2, Стр.Остаток, ?(Стр.Остаток < 0, ЦветКрит(), Неопределено), Стр.Дата = П.День);
		Если Предыдущий <> Неопределено Тогда
			ЯчейкаЧисло(В, 3, Стр.Остаток - Предыдущий, ЦветИзменения(Стр.Остаток - Предыдущий));
		КонецЕсли;
		Предыдущий = Стр.Остаток;
		ЛинияСнизу(В, 1, 3);
		СледующаяСтрока(В);
	КонецЦикла;
	Серии = Новый Массив;
	Серии.Добавить(Новый Структура("Имя, Значения", "Остаток денег, руб.", Значения));
	ВывестиГрафик(В, Точки, Серии, 12);

	Если Д.ПоСтатьям.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Движение денег с начала месяца по статьям: сначала поступления, потом платежи");
		Шапка(В, "Статья движения денежных средств", "С 1-го числа", "Доля");
		Для Каждого Вид Из СтрРазделить("Приход,Расход", ",") Цикл
			ЭтоПриход = Вид = "Приход";
			Всего = ?(ЭтоПриход, Д.ПриходМесяц, Д.РасходМесяц);
			Статьи = Д.ПоСтатьям.Скопировать();
			Статьи.Сортировать(Вид + " Убыв");
			Фон = ?(ЭтоПриход, ФонХорошо(), ФонВнимание());
			Ячейка(В, 1, ?(ЭтоПриход, "ПОСТУПЛЕНИЯ", "ПЛАТЕЖИ"), Истина, ?(ЭтоПриход, ЦветХорошо(), ЦветАкцент()), Фон);
			ЯчейкаЧисло(В, 2, Всего, , Истина, Фон);
			Ячейка(В, 3, "100 %", Истина, , Фон);
			ВПраво(В, 3, 3);
			СледующаяСтрока(В);
			Для Каждого Стр Из Статьи Цикл
				Если Стр[Вид] <= 0 Тогда
					Продолжить;
				КонецЕсли;
				Ячейка(В, 1, "   " + Строка(Стр.Статья), , , , , , Истина);
				ЯчейкаЧисло(В, 2, Стр[Вид]);
				Ячейка(В, 3, ?(Всего = 0, "—", Формат(Стр[Вид] / Всего * 100, "ЧДЦ=1; ЧН=0") + " %"), , ЦветПриглушенный());
				ВПраво(В, 3, 3);
				РасшифровкаСтроки(В, Стр.Статья, 3);
				ЛинияСнизу(В, 1, 3);
				СледующаяСтрока(В);
			КонецЦикла;
		КонецЦикла;
		СтрокаИтога(В, "Сальдо (поступления − платежи)", Д.ПриходМесяц - Д.РасходМесяц);
	КонецЕсли;
	Для Каждого Вид Из СтрРазделить("Плательщики,Получатели", ",") Цикл
		Таблица = Д[Вид];
		Если Таблица.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СледующаяСтрока(В);
		Подзаголовок(В, ?(Вид = "Плательщики", "Кто больше всех заплатил нам с начала месяца", "Кому мы больше всех заплатили с начала месяца"));
		Итого = ?(Вид = "Плательщики", Д.ПриходМесяц, Д.РасходМесяц);
		Шапка(В, "Контрагент", "Сумма", "Доля");
		Для Каждого Стр Из Таблица Цикл
			Сумма = ?(Вид = "Плательщики", Стр.Приход, Стр.Расход);
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			ЯчейкаЧисло(В, 2, Сумма);
			ЯчейкаПроцента(В, 3, ?(Итого = 0, Неопределено, Сумма / Итого * 100), Ложь);
			РасшифровкаСтроки(В, Стр.Контрагент, 3);
			ЛинияСнизу(В, 1, 3);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиДолги(В, Р, П)

	ЗаголовокРаздела(В, "Долги");
	Если ПоказатьОшибку(В, Р, "Долги") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вид Из СтрРазделить("НамДолжны,МыДолжны", ",") Цикл
		Д = Р.Долги[Вид];
		Подзаголовок(В, ?(Вид = "НамДолжны", "Нам должны покупатели", "Мы должны поставщикам"));
		Если Д.Позиции.Количество() = 0 Тогда
			Примечание(В, "Долгов нет.");
			СледующаяСтрока(В);
			Продолжить;
		КонецЕсли;
		Шапка(В, "", "Всего", "Просрочено", "Доля", "Срок в " + П.Горизонт + " дн.", "На 1-е число", "Изменение", "Просрочено на 1-е");
		Ячейка(В, 1, ?(Вид = "НамДолжны", "Долг покупателей", "Наш долг"));
		ЯчейкаЧисло(В, 2, Д.Всего, , Истина);
		ЯчейкаЧисло(В, 3, Д.Просрочено, ?(Д.Просрочено > 0, ЦветКрит(), Неопределено), Истина);
		Ячейка(В, 4, ?(Д.Всего = 0, "—", Формат(Д.Просрочено / Д.Всего * 100, "ЧДЦ=0; ЧН=0") + " %"));
		ВПраво(В, 4, 4);
		ЯчейкаЧисло(В, 5, Д.ВБлижайшие);
		ЯчейкаЧисло(В, 6, Д.ВсегоНаНачало);
		ЯчейкаЧисло(В, 7, Д.Всего - Д.ВсегоНаНачало, ?(Д.Всего - Д.ВсегоНаНачало > 0, ?(Вид = "НамДолжны", ЦветВнимание(), ЦветКрит()), ЦветХорошо()));
		ЯчейкаЧисло(В, 8, Д.ПросроченоНаНачало);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
		Если Д.ЕстьСроки Тогда
			Индекс = 0;
			Для Каждого Корзина Из Д.Корзины Цикл
				Если Корзина.Сумма <> 0 Тогда
					Ячейка(В, 1, "   " + Корзина.Заголовок, , ЦветПриглушенный());
					ЯчейкаЧисло(В, 2, Корзина.Сумма, ?(Индекс >= 3, ЦветКрит(), ?(Индекс >= 1, ЦветВнимание(), Неопределено)));
					Ячейка(В, 3, Формат(Корзина.Сумма / Д.Всего * 100, "ЧДЦ=0; ЧН=0") + " %", , ЦветПриглушенный());
					ВПраво(В, 3, 3);
					СледующаяСтрока(В);
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;
		Иначе
			Примечание(В, "В регистре " + Д.Регистр + " нет сроков оплаты, поэтому просрочка не считается.");
		КонецЕсли;

		СледующаяСтрока(В, 0.5);
		Шапка(В, ?(Вид = "НамДолжны", "Покупатель", "Поставщик"), "Долг", "Просрочено", "Дней просрочки", "Ближайший срок", "Документов");
		Номер = 0;
		Для Каждого Стр Из Д.ПоКонтрагентам Цикл
			Номер = Номер + 1;
			Если Номер > 15 Тогда
				Примечание(В, "…и ещё " + (Д.ПоКонтрагентам.Количество() - 15) + ", без просрочки или с меньшим долгом.");
				Прервать;
			КонецЕсли;
			Уровень = ?(Стр.МаксПросрочка > 60, 0, ?(Стр.МаксПросрочка > 0, 1, -1));
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			ЯчейкаЧисло(В, 2, Стр.Долг);
			ЯчейкаЧисло(В, 3, Стр.Просрочено, ?(Стр.Просрочено > 0, ЦветКрит(), Неопределено));
			Если Стр.МаксПросрочка > 0 Тогда
				Ячейка(В, 4, Формат(Стр.МаксПросрочка, "ЧГ=0") + " дн.", Истина, ?(Уровень = 0, ЦветКрит(), ЦветВнимание()), ?(Уровень = 0, ФонКрит(), ФонВнимание()));
			Иначе
				Ячейка(В, 4, "в срок", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 4, 4);
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.БлижайшийСрок), Формат(Стр.БлижайшийСрок, "ДФ=dd.MM.yy"), "—"));
			ВПраво(В, 5, 5);
			ЯчейкаЧисло(В, 6, Стр.Документов);
			РасшифровкаСтроки(В, Стр.Контрагент, 6);
			ЛинияСнизу(В, 1, 6);
			СледующаяСтрока(В);
		КонецЦикла;

		Если Д.Ближайшие.Количество() > 0 Тогда
			СледующаяСтрока(В, 0.5);
			Ячейка(В, 1, ?(Вид = "НамДолжны", "Ожидаемые поступления", "Платежи по срокам") + " в ближайшие " + П.Горизонт + " дн.: " + ФорматДенег(Д.ВБлижайшие) + " руб.", Истина, , , 9, 8);
			СледующаяСтрока(В);
			Для Каждого Стр Из Д.Ближайшие Цикл
				Ячейка(В, 1, Формат(Стр.Срок, "ДФ='dd.MM, ddd'") + "   " + Строка(Стр.Контрагент), , , , 9, 4);
				Ячейка(В, 5, Строка(Стр.Документ), , ЦветПриглушенный(), , 9, 7);
				ЯчейкаЧисло(В, 8, Стр.Сумма);
				ЛинияСнизу(В, 1, 8);
				СледующаяСтрока(В);
			КонецЦикла;
		КонецЕсли;
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

// Финансовый результат по бухучёту (форма «Отчёт о финансовых результатах»), по месяцам текущего квартала,
// итог квартала и прошлый квартал. Счета: 90.01 выручка (Кт), 90.03 НДС, 90.04 акцизы, 90.02 себестоимость,
// 90.07 коммерческие, 90.08 управленческие, 91.01 прочие доходы, 91.02 прочие расходы (проценты — по статьям со словом
// «процент»), 99.02 налог на прибыль. Месяц считается закрытым, если в нём закрыт счёт 90 (обороты по 90.09).
&НаСервере
Функция ПолучитьФинрезультат(П)

	Если Метаданные.ПланыСчетов.Найти("Хозрасчетный") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет плана счетов «Хозрасчетный»";
	КонецЕсли;
	ДатаНачалаКвартала = НачалоКвартала(П.День);
	НачалоПрошлого = ДобавитьМесяц(ДатаНачалаКвартала, -3);
	// данные с начала позапрошлого года — для сравнения «с начала года» за 3 года
	НачалоГодаОтчета = НачалоГода(П.День);
	НачалоДанных = Мин(НачалоПрошлого, ДобавитьМесяц(НачалоГодаОтчета, -24));
	Счета = Новый Массив;
	Для Каждого КодСчета Из СтрРазделить("90,91,99", ",") Цикл
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета);
		Если ЗначениеЗаполнено(Счет) Тогда
			Счета.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Если Счета.Количество() = 0 Тогда
		ВызватьИсключение "в плане счетов нет счетов 90, 91, 99";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ) КАК Месяц,
		|	Т.Счет КАК Счет,
		|	НЕОПРЕДЕЛЕНО КАК КорСчет,
		|	Т.Субконто1 КАК Статья,
		|	СУММА(Т.СуммаОборотДт) КАК Дт,
		|	СУММА(Т.СуммаОборотКт) КАК Кт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПрошлого, &КонецКвартала, Месяц, Счет В ИЕРАРХИИ (&Счета), , "
		+ ?(ЗначениеЗаполнено(П.Организация), "Организация = &Организация", "") + ", , ) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ),
		|	Т.Счет,
		|	Т.Субконто1";
	Запрос.УстановитьПараметр("НачалоПрошлого", НачалоДанных);
	Запрос.УстановитьПараметр("КонецКвартала", КонецКвартала(П.День));
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("Организация", П.Организация);
	Таблица = Запрос.Выполнить().Выгрузить();
	// реформация баланса 31 декабря (закрытие субсчетов внутри 90, 91, 99) — только в декабрях,
	// читаем её отдельно с корреспонденцией и убираем из оборотов (обороты по корсчёту без итогов медленные)
	ВычестьРеформацию(Таблица, НачалоДанных, КонецКвартала(П.День), Счета, П);

	Месяцы = Новый Массив;
	Для Н = 0 По 2 Цикл
		Месяцы.Добавить(ДобавитьМесяц(ДатаНачалаКвартала, Н));
	КонецЦикла;
	Колонки = Новый Массив;
	Для Каждого Мес Из Месяцы Цикл
		Колонки.Добавить(НоваяКолонкаФинрезультата(Мес, Мес, ИмяМесяца(Месяц(Мес), Ложь)));
	КонецЦикла;
	Колонки.Добавить(НоваяКолонкаФинрезультата(ДатаНачалаКвартала, ДобавитьМесяц(ДатаНачалаКвартала, 2), "Квартал"));
	Колонки.Добавить(НоваяКолонкаФинрезультата(НачалоПрошлого, ДобавитьМесяц(НачалоПрошлого, 2), "Прошлый квартал"));

	// закрытые месяцы: есть закрытие 90.09 на 99 (реформация внутри 90 не в счёт)
	ЗакрытыеМесяцы = Новый Соответствие;
	Для Каждого Стр Из Таблица Цикл
		Код = СокрЛП(Стр.Счет.Код);
		Если СчетНачинаетсяС(Код, "90.09") И (ЧислоИлиНоль(Стр.Дт) <> 0 ИЛИ ЧислоИлиНоль(Стр.Кт) <> 0) Тогда
			ЗакрытыеМесяцы.Вставить(Стр.Месяц, Истина);
		КонецЕсли;
	КонецЦикла;
	// с начала года по последний закрытый месяц и те же месяцы двух прошлых лет (нарастающим итогом)
	ПоследнийЗакрытый = Неопределено;
	НезакрытыеВГоду = Новый Массив;
	Мес = НачалоМесяца(П.День);
	Пока Мес >= НачалоГодаОтчета Цикл
		Если ЗакрытыеМесяцы[Мес] <> Неопределено Тогда
			ПоследнийЗакрытый = Мес;
			Прервать;
		КонецЕсли;
		Мес = ДобавитьМесяц(Мес, -1);
	КонецЦикла;
	ЕстьГод = ПоследнийЗакрытый <> Неопределено;
	Если ЕстьГод Тогда
		Мес = НачалоГодаОтчета;
		Пока Мес <= ПоследнийЗакрытый Цикл
			Если ЗакрытыеМесяцы[Мес] = Неопределено Тогда
				НезакрытыеВГоду.Добавить(ИмяМесяца(Месяц(Мес), Ложь));
			КонецЕсли;
			Мес = ДобавитьМесяц(Мес, 1);
		КонецЦикла;
		Для Лет = 0 По 2 Цикл
			Нач = ДобавитьМесяц(НачалоГодаОтчета, -12 * Лет);
			Кон = ДобавитьМесяц(ПоследнийЗакрытый, -12 * Лет);
			Колонки.Добавить(НоваяКолонкаФинрезультата(Нач, Кон, ПериодГода(Нач, Кон)));
		КонецЦикла;
	КонецЕсли;

	Для Каждого Стр Из Таблица Цикл
		Код = СокрЛП(Стр.Счет.Код);
		// закрытие субсчетов внутри счёта (реформация баланса 31 декабря: 90.01 → 90.09, 91 → 91.09, 99.02 → 99.01)
		// — не обороты месяца, иначе в декабре выручка и расходы обнуляются годовыми суммами
		Дт = ЧислоИлиНоль(Стр.Дт);
		Кт = ЧислоИлиНоль(Стр.Кт);
		ЭтоПроценты = СтрНайти(НРег(Строка(Стр.Статья)), "процент") > 0;
		Для Каждого Кол Из Колонки Цикл
			Если Стр.Месяц < Кол.НачалоПериода ИЛИ Стр.Месяц > Кол.КонецПериода Тогда
				Продолжить;
			КонецЕсли;
			Если СчетНачинаетсяС(Код, "90.01") Тогда
				Кол.Выручка = Кол.Выручка + Кт - Дт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.03") ИЛИ СчетНачинаетсяС(Код, "90.04") ИЛИ СчетНачинаетсяС(Код, "90.05") Тогда
				Кол.Выручка = Кол.Выручка - (Дт - Кт);
			ИначеЕсли СчетНачинаетсяС(Код, "90.02") Тогда
				Кол.Себестоимость = Кол.Себестоимость + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.07") Тогда
				Кол.Коммерческие = Кол.Коммерческие + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.08") Тогда
				Кол.Управленческие = Кол.Управленческие + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.09") Тогда
				Кол.Закрыт = Кол.Закрыт ИЛИ Дт <> 0 ИЛИ Кт <> 0;
			ИначеЕсли СчетНачинаетсяС(Код, "91.01") Тогда
				Если ЭтоПроценты Тогда
					Кол.ПроцентыКПолучению = Кол.ПроцентыКПолучению + Кт - Дт;
				Иначе
					Кол.ПрочиеДоходы = Кол.ПрочиеДоходы + Кт - Дт;
				КонецЕсли;
			ИначеЕсли СчетНачинаетсяС(Код, "91.02") Тогда
				Если ЭтоПроценты Тогда
					Кол.ПроцентыКУплате = Кол.ПроцентыКУплате + Дт - Кт;
				Иначе
					Кол.ПрочиеРасходы = Кол.ПрочиеРасходы + Дт - Кт;
				КонецЕсли;
			ИначеЕсли СчетНачинаетсяС(Код, "99.02") Тогда
				Кол.Налог = Кол.Налог + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "99") И НЕ СчетНачинаетсяС(Код, "99.02") Тогда
				Кол.Прочие99 = Кол.Прочие99 + Дт - Кт;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// прямые затраты в себестоимости продаж — из регистра «Выручка и себестоимость продаж»
	ИсточникПрямых = "";
	Попытка
		ИсточникПрямых = ДобавитьПрямыеЗатраты(Колонки, П, НачалоДанных);
	Исключение
		ИсточникПрямых = "";
	КонецПопытки;

	ЗакрытыхМесяцев = 0;
	Для Каждого Кол Из Колонки Цикл
		Кол.ПоПрямым = Кол.Выручка - Кол.Прямые;
		Кол.Косвенные = Кол.Себестоимость - Кол.Прямые;
		Кол.ОтПродаж = Кол.Выручка - Кол.Себестоимость - Кол.Коммерческие - Кол.Управленческие;
		Кол.ДоНалога = Кол.ОтПродаж + Кол.ПроцентыКПолучению - Кол.ПроцентыКУплате + Кол.ПрочиеДоходы - Кол.ПрочиеРасходы;
		Кол.Чистая = Кол.ДоНалога - Кол.Налог;
	КонецЦикла;
	Для Н = 0 По 2 Цикл
		Если Колонки[Н].Закрыт Тогда
			ЗакрытыхМесяцев = ЗакрытыхМесяцев + 1;
		КонецЕсли;
	КонецЦикла;
	Колонки[3].Закрыт = ЗакрытыхМесяцев > 0;
	// для «Главного» и сигналов — только закрытые месяцы: в незакрытом нет себестоимости и распределения расходов
	ЗаЗакрытые = НоваяКолонкаФинрезультата(ДатаНачалаКвартала, ДобавитьМесяц(ДатаНачалаКвартала, 2), "Закрытые месяцы");
	Для Н = 0 По 2 Цикл
		Если НЕ Колонки[Н].Закрыт Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Поле Из ЗаЗакрытые Цикл
			Если ТипЗнч(Поле.Значение) = Тип("Число") Тогда
				ЗаЗакрытые[Поле.Ключ] = Поле.Значение + Колонки[Н][Поле.Ключ];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Р = Новый Структура;
	Р.Вставить("ЗаЗакрытые", ЗаЗакрытые);
	Р.Вставить("Колонки", Колонки);
	Р.Вставить("ЕстьГод", ЕстьГод);
	Р.Вставить("ПоследнийЗакрытый", ПоследнийЗакрытый);
	Р.Вставить("НезакрытыеВГоду", НезакрытыеВГоду);
	Р.Вставить("ЗакрытыхМесяцев", ЗакрытыхМесяцев);
	Р.Вставить("ЕстьПрямые", ИсточникПрямых <> "");
	Р.Вставить("ИсточникПрямых", ИсточникПрямых);
	Р.Вставить("ИмяКвартала", Формат(Цел((Месяц(ДатаНачалаКвартала) - 1) / 3) + 1, "ЧГ=0") + " квартал " + Формат(Год(ДатаНачалаКвартала), "ЧГ=0"));
	Возврат Р;

КонецФункции

&НаСервере
Функция ДобавитьПрямыеЗатраты(Колонки, П, НачалоПериода)

	// прямые затраты по месяцам в регламентированной оценке (как в 90.02); без неё не считаем —
	// вычитать управленческую оценку из 90.02 нельзя
	Рег = "ВыручкаИСебестоимостьПродаж";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);
	Для Каждого Регл Из СтрРазделить("Да", ",") Цикл
		Состав = СоставСебестоимости(Рег, Регл = "Да");
		Если Состав.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ) КАК Месяц,
			|	" + ПоляСебестоимости(Состав) + "
			|ИЗ
			|	РегистрНакопления." + Рег + ".Обороты(&НачалоПериода, &КонецКвартала, Месяц" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ)";
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецКвартала", КонецКвартала(П.День));
		Запрос.УстановитьПараметр("Организация", П.Организация);
		Строки = Запрос.Выполнить().Выгрузить();
		Ресурсы = РазложитьСебестоимость(Строки, Состав);
		Если Строки.Итог("Прямые") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Стр Из Строки Цикл
			Для Каждого Кол Из Колонки Цикл
				Если Стр.Месяц >= Кол.НачалоПериода И Стр.Месяц <= Кол.КонецПериода Тогда
					Кол.Прямые = Кол.Прямые + Стр.Прямые;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат ?(Регл = "Да", "регл. оценка", "упр. оценка без НДС") + ": " + Ресурсы;
	КонецЦикла;
	Возврат "";

КонецФункции

// Вычитает из оборотов по месяцам обороты реформации баланса: проводки декабря, где счёт и корсчёт —
// субсчета одного счёта (90.01 ↔ 90.09, 91.01 ↔ 91.09, 99.02 ↔ 99.01). Запрос — только за декабри периода.
&НаСервере
Процедура ВычестьРеформацию(Таблица, НачалоПериода, КонецПериода, Счета, П)

	Год = Год(НачалоПериода);
	Пока Дата(Год, 12, 1) <= КонецПериода Цикл
		НачалоДекабря = Дата(Год, 12, 1);
		Год = Год + 1;
		Если НачалоДекабря < НачалоМесяца(НачалоПериода) Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Счет КАК Счет,
			|	Т.КорСчет КАК КорСчет,
			|	Т.Субконто1 КАК Статья,
			|	СУММА(Т.СуммаОборотДт) КАК Дт,
			|	СУММА(Т.СуммаОборотКт) КАК Кт
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Счета), , "
			+ ?(ЗначениеЗаполнено(П.Организация), "Организация = &Организация", "") + ", КорСчет В ИЕРАРХИИ (&Счета), ) КАК Т
			|СГРУППИРОВАТЬ ПО
			|	Т.Счет,
			|	Т.КорСчет,
			|	Т.Субконто1";
		Запрос.УстановитьПараметр("Начало", НачалоДекабря);
		Запрос.УстановитьПараметр("Конец", КонецМесяца(НачалоДекабря));
		Запрос.УстановитьПараметр("Счета", Счета);
		Запрос.УстановитьПараметр("Организация", П.Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Код = СокрЛП(Выборка.Счет.Код);
			КодКор = ?(ЗначениеЗаполнено(Выборка.КорСчет), СокрЛП(Выборка.КорСчет.Код), "");
			Если КодКор = "" ИЛИ СтрРазделить(КодКор, ".")[0] <> СтрРазделить(Код, ".")[0] Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Таблица.Добавить();
			НовСтр.Месяц = НачалоДекабря;
			НовСтр.Счет = Выборка.Счет;
			НовСтр.Статья = Выборка.Статья;
			НовСтр.Дт = -ЧислоИлиНоль(Выборка.Дт);
			НовСтр.Кт = -ЧислоИлиНоль(Выборка.Кт);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// «январь–октябрь 2026» / «январь 2026»
&НаСервере
Функция ПериодГода(НачалоКолонки, КонецКолонки)

	Если НачалоМесяца(НачалоКолонки) = НачалоМесяца(КонецКолонки) Тогда
		Возврат ИмяМесяца(Месяц(НачалоКолонки), Ложь) + " " + Формат(Год(НачалоКолонки), "ЧГ=0");
	КонецЕсли;
	Возврат ИмяМесяца(Месяц(НачалоКолонки), Ложь) + "–" + ИмяМесяца(Месяц(КонецКолонки), Ложь) + " " + Формат(Год(КонецКолонки), "ЧГ=0");

КонецФункции

&НаСервере
Функция НоваяКолонкаФинрезультата(НачалоКолонки, КонецКолонки, Заголовок)

	Кол = Новый Структура("НачалоПериода, КонецПериода, Заголовок, Закрыт", НачалоКолонки, КонецКолонки, Заголовок, Ложь);
	Для Каждого Имя Из СтрРазделить("Выручка,Себестоимость,Прямые,ПоПрямым,Косвенные,Коммерческие,Управленческие,ОтПродаж,ПроцентыКПолучению,ПроцентыКУплате,"
		+ "ПрочиеДоходы,ПрочиеРасходы,ДоНалога,Налог,Чистая,Прочие99", ",") Цикл
		Кол.Вставить(Имя, 0);
	КонецЦикла;
	Возврат Кол;

КонецФункции

// «90.01.1» начинается с «90.01», а «90.1» — нет: сравнение по сегментам кода.
&НаСервереБезКонтекста
Функция СчетНачинаетсяС(Код, Префикс)

	Возврат Код = Префикс ИЛИ Лев(Код, СтрДлина(Префикс) + 1) = Префикс + ".";

КонецФункции

&НаСервере
Процедура ВывестиФинрезультат(В, Р, П)

	ЗаголовокРаздела(В, "Финансовый результат за квартал и с начала года (бухучёт)");
	Если ПоказатьОшибку(В, Р, "Финрезультат") Тогда
		Возврат;
	КонецЕсли;
	Ф = Р.Финрезультат;
	К = Ф.Колонки;
	Заголовки = Новый Массив;
	Для Каждого Кол Из К Цикл
		Заголовки.Добавить(Кол.Заголовок + ?(Кол.Заголовок = "Квартал" ИЛИ Кол.Заголовок = "Прошлый квартал" ИЛИ Кол.Закрыт, "", Символы.ПС + "не закрыт"));
	КонецЦикла;
	Шапка(В, Ф.ИмяКвартала, Заголовки[0], Заголовки[1], Заголовки[2], "Итого за квартал", "Прошлый квартал", "Изм. к прошл.");
	ВывестиСтрокуФинрезультата(В, К, "Выручка (без НДС и акцизов)", "Выручка", Ложь, Ложь);
	Если Ф.ЕстьПрямые Тогда
		ВывестиСтрокуФинрезультата(В, К, "Прямые затраты в себестоимости продаж", "Прямые", Ложь, Истина);
		ВывестиСтрокуФинрезультата(В, К, "Прибыль по прямым затратам", "ПоПрямым", Истина, Ложь);
		ВывестиСтрокуФинрезультата(В, К, "Косвенные затраты в себестоимости продаж", "Косвенные", Ложь, Истина);
	Иначе
		ВывестиСтрокуФинрезультата(В, К, "Себестоимость продаж", "Себестоимость", Ложь, Истина);
	КонецЕсли;
	ВывестиСтрокуФинрезультата(В, К, "Коммерческие расходы", "Коммерческие", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Управленческие расходы", "Управленческие", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Прибыль от продаж", "ОтПродаж", Истина, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Проценты к получению", "ПроцентыКПолучению", Ложь, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Проценты к уплате", "ПроцентыКУплате", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Прочие доходы", "ПрочиеДоходы", Ложь, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Прочие расходы", "ПрочиеРасходы", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Прибыль до налогообложения", "ДоНалога", Истина, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Налог на прибыль (текущий и отложенный)", "Налог", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Чистая прибыль", "Чистая", Истина, Ложь);

	// рентабельности
	Для Каждого Пара Из СтрРазделить("Рентабельность по прямым затратам:ПоПрямым,Рентабельность продаж:ОтПродаж,Чистая рентабельность:Чистая", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Если Части[1] = "ПоПрямым" И НЕ Ф.ЕстьПрямые Тогда
			Продолжить;
		КонецЕсли;
		Ячейка(В, 1, Части[0], , ЦветПриглушенный());
		Для Индекс = 0 По 4 Цикл
			Кол = К[Индекс];
			Ячейка(В, Индекс + 2, ?(Кол.Выручка = 0, "—", Формат(Кол[Части[1]] / Кол.Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"), , ЦветПриглушенный());
			ВПраво(В, Индекс + 2, Индекс + 2);
		КонецЦикла;
		Если К[3].Выручка <> 0 И К[4].Выручка <> 0 Тогда
			Изм = (К[3][Части[1]] / К[3].Выручка - К[4][Части[1]] / К[4].Выручка) * 100;
			Ячейка(В, 7, ?(Изм > 0, "+", "") + Формат(Изм, "ЧДЦ=1; ЧН=0") + " п.п.", , ?(Изм > 0, ЦветХорошо(), ?(Изм < 0, ЦветКрит(), Неопределено)));
			ВПраво(В, 7, 7);
		КонецЕсли;
		ЛинияСнизу(В, 1, 7);
		СледующаяСтрока(В);
	КонецЦикла;
	Если Ф.ЕстьПрямые Тогда
		Примечание(В, "Прямые затраты — материалы, доп. расходы, трудозатраты и переменные статьи в себестоимости проданного (регистр «Выручка и себестоимость продаж», "
			+ Ф.ИсточникПрямых + "). Прибыль по прямым затратам = выручка − прямые затраты. Косвенные = себестоимость продаж по счёту 90.02 − прямые: "
			+ "распределённые общепроизводственные расходы и прочее, что попало в 90.02.");
	Иначе
		Примечание(В, "Прибыль по прямым затратам не посчитана: в регистре «Выручка и себестоимость продаж» нет разбивки себестоимости за эти месяцы "
			+ "(появляется после закрытия месяца).");
	КонецЕсли;
	Примечание(В, "По данным бухучёта (счета 90, 91, 99), как в форме «Отчёт о финансовых результатах». "
		+ "Прибыль от продаж = выручка − вся себестоимость продаж − коммерческие − управленческие; прибыль до налогообложения = от продаж + проценты к получению − проценты к уплате + прочие доходы − прочие расходы; "
		+ "чистая = до налогообложения − налог на прибыль (99.02). Цифры месяца окончательные после закрытия месяца; незакрытый месяц помечен — в нём нет себестоимости и распределения расходов. "
		+ "«Изм. к прошл.» сравнивает квартал целиком с прошлым кварталом целиком, поэтому до конца квартала сравнение неполное.");

	ВывестиФинрезультатГода(В, Ф);

КонецПроцедуры

// С начала года по последний закрытый месяц — и те же месяцы двух прошлых лет, нарастающим итогом.
&НаСервере
Процедура ВывестиФинрезультатГода(В, Ф)

	СледующаяСтрока(В);
	Подзаголовок(В, "С начала года нарастающим итогом (только закрытые месяцы) и то же за 2 прошлых года");
	Если НЕ Ф.ЕстьГод Тогда
		Примечание(В, "В этом году ещё нет закрытых месяцев — сравнение появится после закрытия января.");
		Возврат;
	КонецЕсли;
	К = Ф.Колонки;
	Шапка(В, "Показатель", К[5].Заголовок, К[6].Заголовок, "Изм. к " + Формат(Год(К[6].КонецПериода), "ЧГ=0"),
		К[7].Заголовок, "Изм. к " + Формат(Год(К[7].КонецПериода), "ЧГ=0"));
	Строки = Новый Массив;
	Строки.Добавить("Выручка (без НДС и акцизов)|Выручка|0|0");
	Если Ф.ЕстьПрямые Тогда
		Строки.Добавить("Прямые затраты в себестоимости продаж|Прямые|0|1");
		Строки.Добавить("Прибыль по прямым затратам|ПоПрямым|1|0");
		Строки.Добавить("Косвенные затраты в себестоимости продаж|Косвенные|0|1");
	Иначе
		Строки.Добавить("Себестоимость продаж|Себестоимость|0|1");
	КонецЕсли;
	Строки.Добавить("Коммерческие расходы|Коммерческие|0|1");
	Строки.Добавить("Управленческие расходы|Управленческие|0|1");
	Строки.Добавить("Прибыль от продаж|ОтПродаж|1|0");
	Строки.Добавить("Проценты к получению|ПроцентыКПолучению|0|0");
	Строки.Добавить("Проценты к уплате|ПроцентыКУплате|0|1");
	Строки.Добавить("Прочие доходы|ПрочиеДоходы|0|0");
	Строки.Добавить("Прочие расходы|ПрочиеРасходы|0|1");
	Строки.Добавить("Прибыль до налогообложения|ДоНалога|1|0");
	Строки.Добавить("Налог на прибыль (текущий и отложенный)|Налог|0|1");
	Строки.Добавить("Чистая прибыль|Чистая|1|0");
	НетПрямых = Ложь;
	Для Каждого Описание Из Строки Цикл
		Ч = СтрРазделить(Описание, "|");
		Поле = Ч[1];
		Итоговая = Ч[2] = "1";
		Расход = Ч[3] = "1";
		Фон = ?(Итоговая, Новый Цвет(226, 240, 238), Неопределено);
		Ячейка(В, 1, ?(Расход, "   ", "") + Ч[0], Итоговая, ?(Итоговая, ЦветАкцент(), Неопределено), Фон);
		Для Каждого Пара Из СтрРазделить("2:5,3:6,5:7", ",") Цикл
			Части = СтрРазделить(Пара, ":");
			Кол = К[Число(Части[1])];
			Колонка = Число(Части[0]);
			// за годы, когда в регистре ещё нет разбивки себестоимости, прямые затраты неизвестны
			Если (Поле = "Прямые" ИЛИ Поле = "ПоПрямым" ИЛИ Поле = "Косвенные") И Кол.Прямые = 0 И Кол.Себестоимость <> 0 Тогда
				Ячейка(В, Колонка, "нет данных", , ЦветПриглушенный(), Фон);
				ВПраво(В, Колонка, Колонка);
				НетПрямых = Истина;
			Иначе
				Значение = Кол[Поле];
				ЯчейкаЧисло(В, Колонка, Значение, ?(Итоговая И Значение < 0, ЦветКрит(), Неопределено), Итоговая ИЛИ Колонка = 2, Фон);
			КонецЕсли;
		КонецЦикла;
		Стало = К[5][Поле];
		Для Каждого Пара Из СтрРазделить("4:6,6:7", ",") Цикл
			Части = СтрРазделить(Пара, ":");
			Колонка = Число(Части[0]);
			Было = К[Число(Части[1])][Поле];
			ЕстьДанные = НЕ ((Поле = "Прямые" ИЛИ Поле = "ПоПрямым" ИЛИ Поле = "Косвенные")
				И К[Число(Части[1])].Прямые = 0 И К[Число(Части[1])].Себестоимость <> 0);
			Если Было <> 0 И ЕстьДанные Тогда
				Изм = (Стало / Было - 1) * 100 * ?(Было < 0, -1, 1);
				ЯчейкаПроцента(В, Колонка, Изм, Истина, ?(Расход, ?(Изм > 0, ЦветКрит(), ЦветХорошо()), Неопределено));
			Иначе
				Ячейка(В, Колонка, "", , , Фон);
			КонецЕсли;
		КонецЦикла;
		ЛинияСнизу(В, 1, 6);
		СледующаяСтрока(В);
	КонецЦикла;
	// рентабельности
	Для Каждого Пара Из СтрРазделить("Рентабельность по прямым затратам:ПоПрямым,Рентабельность продаж:ОтПродаж,Чистая рентабельность:Чистая", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Если Части[1] = "ПоПрямым" И НЕ Ф.ЕстьПрямые Тогда
			Продолжить;
		КонецЕсли;
		Ячейка(В, 1, Части[0], , ЦветПриглушенный());
		Для Каждого Место Из СтрРазделить("2:5,3:6,5:7", ",") Цикл
			М = СтрРазделить(Место, ":");
			Кол = К[Число(М[1])];
			Нет = Кол.Выручка = 0 ИЛИ (Части[1] = "ПоПрямым" И Кол.Прямые = 0 И Кол.Себестоимость <> 0);
			Ячейка(В, Число(М[0]), ?(Нет, "—", Формат(Кол[Части[1]] / Кол.Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"), , ЦветПриглушенный());
			ВПраво(В, Число(М[0]), Число(М[0]));
		КонецЦикла;
		Для Каждого Место Из СтрРазделить("4:6,6:7", ",") Цикл
			М = СтрРазделить(Место, ":");
			Кол = К[Число(М[1])];
			Нет = Кол.Выручка = 0 ИЛИ К[5].Выручка = 0 ИЛИ (Части[1] = "ПоПрямым" И Кол.Прямые = 0 И Кол.Себестоимость <> 0);
			Если НЕ Нет Тогда
				Изм = (К[5][Части[1]] / К[5].Выручка - Кол[Части[1]] / Кол.Выручка) * 100;
				Ячейка(В, Число(М[0]), ?(Изм > 0, "+", "") + Формат(Изм, "ЧДЦ=1; ЧН=0") + " п.п.", , ?(Изм > 0, ЦветХорошо(), ?(Изм < 0, ЦветКрит(), Неопределено)));
				ВПраво(В, Число(М[0]), Число(М[0]));
			КонецЕсли;
		КонецЦикла;
		ЛинияСнизу(В, 1, 6);
		СледующаяСтрока(В);
	КонецЦикла;
	Примечание(В, "Каждый год — одни и те же месяцы, с января по последний закрытый месяц этого года (" + ИмяМесяца(Месяц(Ф.ПоследнийЗакрытый), Ложь) + "), нарастающим итогом. "
		+ "Реформация баланса 31 декабря не учитывается, поэтому прошлые годы сравнимы."
		+ ?(Ф.НезакрытыеВГоду.Количество() > 0, " Внимание: в этом году не закрыты " + СтрСоединить(Ф.НезакрытыеВГоду, ", ") + " — в них нет себестоимости и распределения расходов.", "")
		+ ?(НетПрямых, " «Нет данных» — в регистре «Выручка и себестоимость продаж» за этот год нет разбивки себестоимости на прямые и косвенные.", ""));

КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуФинрезультата(В, К, Название, Поле, Итоговая, Расход)

	Фон = ?(Итоговая, Новый Цвет(226, 240, 238), Неопределено);
	Ячейка(В, 1, ?(Расход, "   ", "") + Название, Итоговая, ?(Итоговая, ЦветАкцент(), Неопределено), Фон);
	Для Индекс = 0 По 4 Цикл
		Значение = К[Индекс][Поле];
		Цвет = ?(Итоговая И Значение < 0, ЦветКрит(), Неопределено);
		ЯчейкаЧисло(В, Индекс + 2, Значение, Цвет, Итоговая ИЛИ Индекс = 3, Фон);
	КонецЦикла;
	Было = К[4][Поле];
	Стало = К[3][Поле];
	Если Было <> 0 Тогда
		Изм = (Стало / Было - 1) * 100 * ?(Было < 0, -1, 1);
		ЯчейкаПроцента(В, 7, Изм, Истина, ?(Расход, ?(Изм > 0, ЦветКрит(), ЦветХорошо()), Неопределено));
	Иначе
		Ячейка(В, 7, "", , , Фон);
	КонецЕсли;
	ЛинияСнизу(В, 1, 7);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервереБезКонтекста
Функция МинДата(Д1, Д2)

	Если НЕ ЗначениеЗаполнено(Д1) Тогда
		Возврат Д2;
	ИначеЕсли НЕ ЗначениеЗаполнено(Д2) Тогда
		Возврат Д1;
	КонецЕсли;
	Возврат Мин(Д1, Д2);

КонецФункции

&НаСервереБезКонтекста
Функция МаксДата(Д1, Д2)

	Если НЕ ЗначениеЗаполнено(Д1) Тогда
		Возврат Д2;
	ИначеЕсли НЕ ЗначениеЗаполнено(Д2) Тогда
		Возврат Д1;
	КонецЕсли;
	Возврат Макс(Д1, Д2);

КонецФункции

// Арендаторы: кто арендует (документы «Передача ОС в аренду», возвраты из аренды), начисления аренды
// (строки реализаций, где в номенклатуре, содержании или статье доходов есть «аренд»), оплаты
// (поступления на счёт и в кассу от арендатора), долг и просрочка (из раздела «Долги»), срок договора.
&НаСервере
Функция ПолучитьАренду(П, Долги)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Арендатор");
	Т.Колонки.Добавить("Договор");
	Т.Колонки.Добавить("Объекты", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Передано");
	Т.Колонки.Добавить("Возвращено");
	Т.Колонки.Добавить("Месяц", ОписаниеЧисла());
	Т.Колонки.Добавить("ПрошлыйМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("СНачалаГода", ОписаниеЧисла());
	Т.Колонки.Добавить("За12", ОписаниеЧисла());
	Т.Колонки.Добавить("МесяцевНачислений", ОписаниеЧисла());
	МесяцыАренды = Новый Соответствие; // арендатор -> месяцы с начислениями
	Т.Колонки.Добавить("ПоследнееНачисление");
	Т.Колонки.Добавить("Оплачено", ОписаниеЧисла());
	Т.Колонки.Добавить("ОплаченоГод", ОписаниеЧисла());
	Т.Колонки.Добавить("ПоследняяОплата");
	Т.Колонки.Добавить("СуммаПоследнейОплаты", ОписаниеЧисла());
	Т.Колонки.Добавить("Долг", ОписаниеЧисла());
	Т.Колонки.Добавить("Просрочено", ОписаниеЧисла());
	Т.Колонки.Добавить("МаксПросрочка", ОписаниеЧисла());
	Т.Колонки.Добавить("ДоговорДо");
	Источники = Новый Массив;
	Начало12 = ДобавитьМесяц(П.НачалоМесяца, -11);
	ДатаНачалаГода = НачалоГода(П.День);

	// 1. передача ОС в аренду и возврат из аренды
	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		ИмяНРег = НРег(МетаДокумента.Имя);
		Если СтрНайти(ИмяНРег, "аренд") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭтоПередача = СтрНайти(ИмяНРег, "передача") > 0 И СтрНайти(ИмяНРег, "варенду") > 0;
		ЭтоВозврат = СтрНайти(ИмяНРег, "возврат") > 0 И СтрНайти(ИмяНРег, "изаренды") > 0;
		Если НЕ ЭтоПередача И НЕ ЭтоВозврат Тогда
			Продолжить;
		КонецЕсли;
		РекКонтрагент = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Арендатор,Партнер");
		Если РекКонтрагент = "" Тогда
			Источники.Добавить(МетаДокумента.Синоним + ": нет реквизита-контрагента");
			Продолжить;
		КонецЕсли;
		РекДоговор = РеквизитКоллекции(МетаДокумента.Реквизиты, "Договор");
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Д.Ссылка КАК Ссылка,
			|	Д.Дата КАК Дата,
			|	Д." + РекКонтрагент + " КАК Арендатор,
			|	" + ?(РекДоговор = "", "НЕОПРЕДЕЛЕНО", "Д." + РекДоговор) + " КАК Договор
			|ИЗ
			|	Документ." + МетаДокумента.Имя + " КАК Д
			|ГДЕ
			|	Д.Проведен
			|	И Д.Дата <= &КонецДня" + ?(ЗначениеЗаполнено(П.Организация) И МетаДокумента.Реквизиты.Найти("Организация") <> Неопределено, "
			|	И Д.Организация = &Организация", "") + "
			|УПОРЯДОЧИТЬ ПО
			|	Д.Дата";
		УстановитьПараметры(Запрос, П);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Источники.Добавить(МетаДокумента.Синоним + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Документов = 0;
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.Арендатор) Тогда
				Продолжить;
			КонецЕсли;
			Документов = Документов + 1;
			Стр = СтрокаАрендатора(Т, Выборка.Арендатор);
			Если ЭтоПередача Тогда
				Стр.Передано = Выборка.Дата;
				Если ЗначениеЗаполнено(Выборка.Договор) Тогда
					Стр.Договор = Выборка.Договор;
				КонецЕсли;
				Объекты = ОбъектыДокументаАренды(Выборка.Ссылка, МетаДокумента);
				Если НЕ ПустаяСтрока(Объекты) Тогда
					Стр.Объекты = ?(ПустаяСтрока(Стр.Объекты), Объекты, Стр.Объекты + "; " + Объекты);
				КонецЕсли;
			Иначе
				Стр.Возвращено = Выборка.Дата;
			КонецЕсли;
		КонецЦикла;
		Источники.Добавить(МетаДокумента.Синоним + ": документов " + Документов);
	КонецЦикла;

	// 2. начисления аренды в реализациях
	Для Каждого ИмяДокумента Из СтрРазделить("РеализацияУслугПрочихАктивов,РеализацияТоваровУслуг,АктВыполненныхРабот", ",") Цикл
		МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РекКонтрагент = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Партнер");
		Если РекКонтрагент = "" Тогда
			Продолжить;
		КонецЕсли;
		РекДоговор = РеквизитКоллекции(МетаДокумента.Реквизиты, "Договор");
		Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
			Реквизиты = МетаТЧ.Реквизиты;
			Условия = Новый Массив;
			Для Каждого ИмяПоля Из СтрРазделить("Номенклатура,СтатьяДоходов,Услуга", ",") Цикл
				Если Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
					Условия.Добавить("Т." + ИмяПоля + ".Наименование ПОДОБНО &Аренда");
				КонецЕсли;
			КонецЦикла;
			Если Реквизиты.Найти("Содержание") <> Неопределено Тогда
				Условия.Добавить("ВЫРАЗИТЬ(Т.Содержание КАК СТРОКА(300)) ПОДОБНО &Аренда");
			КонецЕсли;
			ЕстьНДС = Реквизиты.Найти("СуммаНДС") <> Неопределено;
			Если Реквизиты.Найти("СуммаСНДС") <> Неопределено И ЕстьНДС Тогда
				ВыражениеСуммы = "Т.СуммаСНДС - Т.СуммаНДС";
			ИначеЕсли Реквизиты.Найти("Сумма") <> Неопределено Тогда
				ВыражениеСуммы = ?(ЕстьНДС И МетаДокумента.Реквизиты.Найти("ЦенаВключаетНДС") <> Неопределено,
					"ВЫБОР КОГДА Т.Ссылка.ЦенаВключаетНДС ТОГДА Т.Сумма - Т.СуммаНДС ИНАЧЕ Т.Сумма КОНЕЦ", "Т.Сумма");
			Иначе
				Продолжить;
			КонецЕсли;
			Если Условия.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Т.Ссылка." + РекКонтрагент + " КАК Арендатор,
				|	" + ?(РекДоговор = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекДоговор) + " КАК Договор,
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ) КАК Месяц,
				|	МАКСИМУМ(Т.Ссылка.Дата) КАК Последняя,
				|	СУММА(" + ВыражениеСуммы + ") КАК Сумма
				|ИЗ
				|	Документ." + ИмяДокумента + "." + МетаТЧ.Имя + " КАК Т
				|ГДЕ
				|	Т.Ссылка.Проведен
				|	И Т.Ссылка.Дата МЕЖДУ &Начало12 И &КонецДня
				|	И (" + СтрСоединить(Условия, " ИЛИ ") + ")" + ?(ЗначениеЗаполнено(П.Организация) И МетаДокумента.Реквизиты.Найти("Организация") <> Неопределено, "
				|	И Т.Ссылка.Организация = &Организация", "") + "
				|СГРУППИРОВАТЬ ПО
				|	Т.Ссылка." + РекКонтрагент + ",
				|	" + ?(РекДоговор = "", "", "Т.Ссылка." + РекДоговор + ",") + "
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ)";
			УстановитьПараметры(Запрос, П);
			Запрос.УстановитьПараметр("Аренда", "%аренд%");
			Запрос.УстановитьПараметр("Начало12", Начало12);
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Источники.Добавить(МетаДокумента.Синоним + "." + МетаТЧ.Имя + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Строк = 0;
			Пока Выборка.Следующий() Цикл
				Если НЕ ЗначениеЗаполнено(Выборка.Арендатор) Тогда
					Продолжить;
				КонецЕсли;
				Строк = Строк + 1;
				Стр = СтрокаАрендатора(Т, Выборка.Арендатор);
				Сумма = ЧислоИлиНоль(Выборка.Сумма);
				Если НЕ ЗначениеЗаполнено(Стр.Договор) И ЗначениеЗаполнено(Выборка.Договор) Тогда
					Стр.Договор = Выборка.Договор;
				КонецЕсли;
				Стр.За12 = Стр.За12 + Сумма;
				Месяцы = МесяцыАренды[Выборка.Арендатор];
				Если Месяцы = Неопределено Тогда
					Месяцы = Новый Соответствие;
					МесяцыАренды.Вставить(Выборка.Арендатор, Месяцы);
				КонецЕсли;
				Месяцы.Вставить(Выборка.Месяц, Истина);
				Стр.МесяцевНачислений = Месяцы.Количество();
				Если Выборка.Месяц = П.НачалоМесяца Тогда
					Стр.Месяц = Стр.Месяц + Сумма;
				ИначеЕсли Выборка.Месяц = П.НачалоПрошлогоМесяца Тогда
					Стр.ПрошлыйМесяц = Стр.ПрошлыйМесяц + Сумма;
				КонецЕсли;
				Если Выборка.Месяц >= ДатаНачалаГода Тогда
					Стр.СНачалаГода = Стр.СНачалаГода + Сумма;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Стр.ПоследнееНачисление) ИЛИ Выборка.Последняя > Стр.ПоследнееНачисление Тогда
					Стр.ПоследнееНачисление = Выборка.Последняя;
				КонецЕсли;
			КонецЦикла;
			Если Строк > 0 Тогда
				Источники.Добавить(МетаДокумента.Синоним + " (" + МетаТЧ.Синоним + "): строк с арендой " + Строк);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Т.Количество() > 0 Тогда
		Арендаторы = Т.ВыгрузитьКолонку("Арендатор");

		// 3. оплаты арендаторов
		Для Каждого ИмяДокумента Из СтрРазделить("ПоступлениеБезналичныхДенежныхСредств,ПриходныйКассовыйОрдер", ",") Цикл
			МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
			Если МетаДокумента = Неопределено ИЛИ МетаДокумента.Реквизиты.Найти("СуммаДокумента") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			РекКонтрагент = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Плательщик,Партнер");
			Если РекКонтрагент = "" Тогда
				Продолжить;
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Д." + РекКонтрагент + " КАК Арендатор,
				|	Д.Дата КАК Дата,
				|	Д.СуммаДокумента КАК Сумма
				|ИЗ
				|	Документ." + ИмяДокумента + " КАК Д
				|ГДЕ
				|	Д.Проведен
				|	И Д.Дата МЕЖДУ &Начало12 И &КонецДня
				|	И Д." + РекКонтрагент + " В (&Арендаторы)
				|УПОРЯДОЧИТЬ ПО
				|	Д.Дата";
			УстановитьПараметры(Запрос, П);
			Запрос.УстановитьПараметр("Начало12", Начало12);
			Запрос.УстановитьПараметр("Арендаторы", Арендаторы);
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Источники.Добавить(МетаДокумента.Синоним + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Пока Выборка.Следующий() Цикл
				Стр = Т.Найти(Выборка.Арендатор, "Арендатор");
				Если Стр = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Сумма = ЧислоИлиНоль(Выборка.Сумма);
				Если Выборка.Дата >= П.НачалоМесяца Тогда
					Стр.Оплачено = Стр.Оплачено + Сумма;
				КонецЕсли;
				Если Выборка.Дата >= ДатаНачалаГода Тогда
					Стр.ОплаченоГод = Стр.ОплаченоГод + Сумма;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Стр.ПоследняяОплата) ИЛИ Выборка.Дата >= Стр.ПоследняяОплата Тогда
					Стр.ПоследняяОплата = Выборка.Дата;
					Стр.СуммаПоследнейОплаты = Сумма;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		// 4. долги и просрочка — из раздела «Долги»
		Если Долги <> Неопределено И Долги.НамДолжны <> Неопределено Тогда
			Для Каждого СтрДолга Из Долги.НамДолжны.ПоКонтрагентам Цикл
				Стр = Т.Найти(СтрДолга.Контрагент, "Арендатор");
				Если Стр <> Неопределено Тогда
					Стр.Долг = СтрДолга.Долг;
					Стр.Просрочено = СтрДолга.Просрочено;
					Стр.МаксПросрочка = СтрДолга.МаксПросрочка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// 5. срок договора
		Для Каждого Стр Из Т Цикл
			Стр.ДоговорДо = РеквизитСсылки(Стр.Договор, "ДатаОкончанияДействия,ДатаОкончания,СрокДействия");
		КонецЦикла;
	КонецЕсли;

	Попытка
		ДобавитьДанныеДоговоровПДФ(Т);
	Исключение
		Источники.Добавить("договоры из PDF: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Т.Сортировать("Месяц Убыв, За12 Убыв");
	Р = Новый Структура;
	Р.Вставить("Таблица", Т);
	Р.Вставить("Источники", Источники);
	// начислено в прошлом месяце не так, как по договору (без НДС, расхождение больше 5 %)
	Расхождения = Новый Массив;
	Если Т.Колонки.Найти("ПоДоговору") <> Неопределено Тогда
		Для Каждого Стр Из Т Цикл
			Если Стр.ПоДоговору = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ПоДоговору = ПлатаБезНДС(Стр.ПоДоговору, П.День);
			Если ПоДоговору > 0 И Макс(Стр.ПрошлыйМесяц - ПоДоговору, ПоДоговору - Стр.ПрошлыйМесяц) > ПоДоговору * 0.05 Тогда
				Расхождения.Добавить(Строка(Стр.Арендатор) + ": начислено " + ДеньгиКратко(Стр.ПрошлыйМесяц) + ", по договору " + ДеньгиКратко(ПоДоговору));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Р.Вставить("Расхождения", Расхождения);
	Р.Вставить("Месяц", Т.Итог("Месяц"));
	Р.Вставить("ПрошлыйМесяц", Т.Итог("ПрошлыйМесяц"));
	Р.Вставить("СНачалаГода", Т.Итог("СНачалаГода"));
	Р.Вставить("Оплачено", Т.Итог("Оплачено"));
	Р.Вставить("Долг", Т.Итог("Долг"));
	Р.Вставить("Просрочено", Т.Итог("Просрочено"));
	Р.Вставить("СПросрочкой", 0);
	Для Каждого Стр Из Т Цикл
		Если Стр.Просрочено > 0 Тогда
			Р.СПросрочкой = Р.СПросрочкой + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;

КонецФункции

&НаСервере
Функция СтрокаАрендатора(Т, Арендатор)

	Стр = Т.Найти(Арендатор, "Арендатор");
	Если Стр = Неопределено Тогда
		Стр = Т.Добавить();
		Стр.Арендатор = Арендатор;
	КонецЕсли;
	Возврат Стр;

КонецФункции

// Что передано в аренду: основные средства из табличной части документа (через запятую, до 5).
&НаСервере
Функция ОбъектыДокументаАренды(Ссылка, МетаДокумента)

	Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
		ИмяПоля = РеквизитКоллекции(МетаТЧ.Реквизиты, "ОсновноеСредство,ОбъектЭксплуатации,ОС,Номенклатура");
		Если ИмяПоля = "" Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 6 Т." + ИмяПоля + " КАК Объект ИЗ Документ." + МетаДокумента.Имя + "." + МетаТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Имена = Новый Массив;
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Имена.Количество() = 5 Тогда
					Имена.Добавить("…");
					Прервать;
				КонецЕсли;
				Имена.Добавить(Строка(Выборка.Объект));
			КонецЦикла;
		Исключение
			Продолжить;
		КонецПопытки;
		Возврат СтрСоединить(Имена, ", ");
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Процедура ВывестиАренду(В, Р, П)

	ЗаголовокРаздела(В, "Арендаторы");
	Если ПоказатьОшибку(В, Р, "Аренда") Тогда
		Возврат;
	КонецЕсли;
	А = Р.Аренда;
	Если А.Таблица.Количество() = 0 Тогда
		Примечание(В, "Арендаторов не найдено: нет проведённых документов «Передача ОС в аренду» и реализаций со словом «аренд» в номенклатуре, содержании или статье доходов за 12 месяцев."
			+ ?(А.Источники.Количество() = 0, "", " Проверено: " + СтрСоединить(А.Источники, "; ") + "."));
		Возврат;
	КонецЕсли;
	НомерМесяца = Месяц(П.НачалоПрошлогоМесяца);
	Шапка(В, "Арендатор", "Начислено с 1-го", "В " + ИмяМесяца(НомерМесяца, Истина), "С начала года", "Оплачено с 1-го", "Долг", "Просрочено", "Последняя оплата");
	Для Каждого Стр Из А.Таблица Цикл
		Ячейка(В, 1, Строка(Стр.Арендатор), Истина, , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Месяц, , Истина);
		ЯчейкаЧисло(В, 3, Стр.ПрошлыйМесяц);
		ЯчейкаЧисло(В, 4, Стр.СНачалаГода);
		ЯчейкаЧисло(В, 5, Стр.Оплачено, ?(Стр.Оплачено > 0, ЦветХорошо(), Неопределено));
		ЯчейкаЧисло(В, 6, Стр.Долг);
		Если Стр.Просрочено > 0 Тогда
			Ячейка(В, 7, ФорматДенег(Стр.Просрочено) + Символы.ПС + "до " + Стр.МаксПросрочка + " дн.", Истина, ЦветКрит(), ФонКрит(), 9, , Истина);
			ВПраво(В, 7, 7);
		Иначе
			ЯчейкаЧисло(В, 7, 0);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ПоследняяОплата) Тогда
			Ячейка(В, 8, Формат(Стр.ПоследняяОплата, "ДФ=dd.MM.yy") + Символы.ПС + ДеньгиКратко(Стр.СуммаПоследнейОплаты), , , , 9, , Истина);
		Иначе
			Ячейка(В, 8, "нет за 12 мес.", , ЦветКрит(), , 9);
		КонецЕсли;
		ВПраво(В, 8, 8);
		РасшифровкаСтроки(В, Стр.Арендатор, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 26;
		СледующаяСтрока(В);

		// подробности одной строкой под арендатором
		Части = Новый Массив;
		Если ЗначениеЗаполнено(Стр.Договор) Тогда
			ТекстДоговора = "договор " + Строка(Стр.Договор);
			Если ЗначениеЗаполнено(Стр.ДоговорДо) И ТипЗнч(Стр.ДоговорДо) = Тип("Дата") Тогда
				Осталось = Цел((НачалоДня(Стр.ДоговорДо) - П.День) / 86400);
				ТекстДоговора = ТекстДоговора + " до " + Формат(Стр.ДоговорДо, "ДФ=dd.MM.yyyy")
					+ ?(Осталось < 0, " (истёк " + (-Осталось) + " дн. назад)", ?(Осталось <= 60, " (осталось " + Осталось + " дн.)", ""));
			КонецЕсли;
			Части.Добавить(ТекстДоговора);
		КонецЕсли;
		Если НЕ ПустаяСтрока(Стр.Объекты) Тогда
			Части.Добавить("арендует: " + Стр.Объекты);
		КонецЕсли;
		Если А.Таблица.Колонки.Найти("ПоДоговору") <> Неопределено И Стр.ПоДоговору <> Неопределено Тогда
			Д = Стр.ПоДоговору;
			ЧастиДоговора = Новый Массив;
			Если Д.Площадь > 0 Тогда
				ЧастиДоговора.Добавить(ФорматЧисла(Д.Площадь) + " м²");
			КонецЕсли;
			Если Д.Ставка > 0 Тогда
				ЧастиДоговора.Добавить(ФорматДенег(Д.Ставка) + " за м²");
			КонецЕсли;
			Если Д.ВМесяц > 0 Тогда
				ЧастиДоговора.Добавить(ФорматДенег(Д.ВМесяц) + " в месяц" + ?(ПустаяСтрока(Д.НДС), "", " " + Д.НДС));
			КонецЕсли;
			Если Д.Индексация > 0 Тогда
				ЧастиДоговора.Добавить("индексация " + Формат(Д.Индексация, "ЧДЦ=1; ЧН=0") + " %");
			КонецЕсли;
			Если ЧастиДоговора.Количество() > 0 Тогда
				Части.Добавить("по договору (PDF): " + СтрСоединить(ЧастиДоговора, ", "));
			КонецЕсли;
			ПоДоговору = ПлатаБезНДС(Д, П.День);
			Если ПоДоговору > 0 И Макс(Стр.ПрошлыйМесяц - ПоДоговору, ПоДоговору - Стр.ПрошлыйМесяц) > ПоДоговору * 0.05 Тогда
				Части.Добавить("ВНИМАНИЕ: в " + ИмяМесяца(НомерМесяца, Истина) + " начислено " + ФорматДенег(Стр.ПрошлыйМесяц)
					+ ", а по договору " + ФорматДенег(ПоДоговору) + " без НДС");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Передано) Тогда
			Части.Добавить("передано " + Формат(Стр.Передано, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Возвращено) И (НЕ ЗначениеЗаполнено(Стр.Передано) ИЛИ Стр.Возвращено > Стр.Передано) Тогда
			Части.Добавить("возврат из аренды " + Формат(Стр.Возвращено, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если Стр.МесяцевНачислений > 0 Тогда
			Части.Добавить("в среднем " + ДеньгиКратко(Стр.За12 / Стр.МесяцевНачислений) + " в месяц (за " + Стр.МесяцевНачислений + " мес.)");
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ПоследнееНачисление) Тогда
			Части.Добавить("последнее начисление " + Формат(Стр.ПоследнееНачисление, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Части.Добавить("оплачено с начала года " + ДеньгиКратко(Стр.ОплаченоГод));
		Ячейка(В, 1, "      " + СтрСоединить(Части, "; "), , ЦветПриглушенный(), , 8, 8, Истина);
		ПодогнатьВысоту(В, СтрСоединить(Части, "; "), 150);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	Ячейка(В, 1, "Итого по арендаторам (" + А.Таблица.Количество() + ")", Истина, , ЦветФонаШапки());
	ЯчейкаЧисло(В, 2, А.Месяц, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 3, А.ПрошлыйМесяц, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 4, А.СНачалаГода, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 5, А.Оплачено, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 6, А.Долг, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 7, А.Просрочено, ?(А.Просрочено > 0, ЦветКрит(), Неопределено), Истина, ЦветФонаШапки());
	Ячейка(В, 8, "", , , ЦветФонаШапки());
	Черта(В, 1, 8, 1, , Ложь);
	СледующаяСтрока(В);
	Примечание(В, "Начисления — строки реализаций без НДС, где в номенклатуре, содержании или статье доходов есть слово «аренд». "
		+ "Оплачено — все поступления от арендатора на счёт и в кассу. Долг и просрочка — общие по контрагенту из раздела «Долги» (если арендатор ещё и покупатель, туда входят и его покупки). "
		+ "Источники: " + СтрСоединить(А.Источники, "; ") + ".");

КонецПроцедуры

&НаСервере
Процедура ВывестиЗаказы(В, Р, П)

	ЗаголовокРаздела(В, "Заказы и отгрузки");
	Если ПоказатьОшибку(В, Р, "Заказы") Тогда
		Возврат;
	КонецЕсли;
	З = Р.Заказы;

	Новые = З.Новые.НайтиСтроки(Новый Структура("ЗаДень", Истина));
	Отгрузки = З.Отгрузки.НайтиСтроки(Новый Структура("ЗаДень", Истина));
	Шапка(В, "", "За " + Формат(П.День, "ДФ=dd.MM"), "", "С 1-го числа", "");
	Ячейка(В, 1, "Новые заказы, руб. (с НДС)");
	ЯчейкаЧисло(В, 2, СуммаСтрок(Новые));
	Ячейка(В, 3, Формат(Новые.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЯчейкаЧисло(В, 4, З.Новые.Итог("Сумма"));
	Ячейка(В, 5, Формат(З.Новые.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЛинияСнизу(В, 1, 5);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Отгружено, руб. (с НДС)");
	ЯчейкаЧисло(В, 2, СуммаСтрок(Отгрузки));
	Ячейка(В, 3, Формат(Отгрузки.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЯчейкаЧисло(В, 4, З.Отгрузки.Итог("Сумма"));
	Ячейка(В, 5, Формат(З.Отгрузки.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЛинияСнизу(В, 1, 5);
	СледующаяСтрока(В);

	СледующаяСтрока(В);
	Подзаголовок(В, "Портфель по продуктам");
	Шапка(В, "Продукт", "Заказов", "Осталось", "Сумма", "На складе", "Выпустить", "Выпуск в сутки", "Загрузка, сут.");
	Для Каждого Гр Из ГруппыНоменклатуры(З.Продукты, "Номенклатура", "Сумма") Цикл
	ВывестиСтрокуГруппы(В, Гр, "3:Осталось:к,4:Сумма:ч,5:СоСклада:к,6:Выпустить:к,7:ВСутки:к", 8);
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаЧисло(В, 2, Стр.Заказов);
		ЯчейкаКоличество(В, 3, Стр.Осталось, Стр.Ед);
		ЯчейкаЧисло(В, 4, Стр.Сумма);
		ЯчейкаКоличество(В, 5, Стр.СоСклада, Стр.Ед);
		ЯчейкаКоличество(В, 6, Стр.Выпустить, Стр.Ед);
		ЯчейкаКоличество(В, 7, Стр.ВСутки, Стр.Ед);
		Ячейка(В, 8, ?(Стр.Загрузка = Неопределено, ?(Стр.Выпустить > 0, "нет выпуска", "—"), Формат(Стр.Загрузка, "ЧДЦ=1; ЧН=0")));
		ВПраво(В, 8, 8);
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Итого", , , З.Портфель);
	Примечание(В, "«На складе» — сколько из портфеля закрывается готовой продукцией. «Загрузка» — сколько суток работы при среднем выпуске за 30 дней нужно на остальное.");

	ВывестиСписокЗаказов(В, З.Просроченные, "Просроченные отгрузки");
	ВывестиСписокЗаказов(В, З.Ближайшие, "Отгрузить в ближайшие " + П.Горизонт + " дн.");

	Если Новые.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Новые заказы за день");
		Шапка(В, "Клиент", "", "", "Номер", "Срок отгрузки", "", "", "Сумма");
		Для Каждого Стр Из Новые Цикл
			Ячейка(В, 1, Строка(Стр.Клиент), , , , , 3, Истина);
			Ячейка(В, 4, Строка(Стр.Номер));
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.Срок), Формат(Стр.Срок, "ДФ=dd.MM.yy"), "—"));
			ЯчейкаЧисло(В, 8, Стр.Сумма);
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;
	Если Отгрузки.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Отгрузки за день");
		Шапка(В, "Клиент", "", "", "Номер", "", "", "", "Сумма");
		Для Каждого Стр Из Отгрузки Цикл
			Ячейка(В, 1, Строка(Стр.Клиент), , , , , 3, Истина);
			Ячейка(В, 4, Строка(Стр.Номер));
			ЯчейкаЧисло(В, 8, Стр.Сумма);
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиСписокЗаказов(В, Таблица, Название)

	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СледующаяСтрока(В);
	Подзаголовок(В, Название + " — " + Таблица.Количество() + " " + Склонение(Таблица.Количество(), "позиция", "позиции", "позиций"));
	Шапка(В, "Клиент / продукт", "Заказ", "Срок", "Осталось", "Со склада", "Статус", "", "Сумма");
	Для Каждого Стр Из Таблица Цикл
		Уровень = ?(СтрНайти(Стр.Покрытие, "просроч") > 0, 0, ?(Стр.Покрытие = "не успеваем", 1, 3));
		Ячейка(В, 1, Строка(Стр.Клиент) + Символы.ПС + Строка(Стр.Номенклатура), , , , 9, , Истина);
		Ячейка(В, 2, Строка(Стр.Номер));
		Ячейка(В, 3, ?(ЗначениеЗаполнено(Стр.Срок), Формат(Стр.Срок, "ДФ=dd.MM"), "—"));
		ЯчейкаКоличество(В, 4, Стр.Осталось, Стр.Ед);
		ЯчейкаКоличество(В, 5, Стр.СоСклада, Стр.Ед);
		Ячейка(В, 6, Стр.Покрытие + ?(Стр.Просрочка > 0, ", " + Стр.Просрочка + " дн.", ""), Истина,
			?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())), ?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())), 9, 7, Истина);
		ЯчейкаЧисло(В, 8, Стр.Сумма);
		РасшифровкаСтроки(В, Стр.Заказ, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

// «Суточный рапорт по заводу» из ERP: вариант отчёта со своими настройками, период — с 1-го числа по дату отчёта.
// Результат вставляется в раздел «Выпуск» как есть, поэтому цифры совпадают с отчётом в ERP.
&НаСервере
Функция СуточныйРапортERP(П)

	Подготовка = ПодготовитьСуточныйРапорт(П);
	Если Подготовка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// компонуем сами по схеме отчёта с нашими датами (и в настройках, и в параметрах схемы),
	// чтобы не подхватились сохранённые в варианте старые даты
	ТД = Новый ТабличныйДокумент;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки = Подготовка.ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	Подготовка.Параметры = ПрименитьПараметрыРапорта(Настройки, Подготовка.Схема, П, Подготовка.ДокументыПлана);
	// без заголовка и блока «Параметры / Отбор» рапорта — дата и план написаны строкой над ним
	Для Каждого ИмяПараметраВывода Из СтрРазделить("ВыводитьЗаголовок,ВыводитьПараметрыДанных,ВыводитьОтбор", ",") Цикл
		Попытка
			Настройки.ПараметрыВывода.УстановитьЗначениеПараметра(ИмяПараметраВывода, ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
		Исключение
			// параметр вывода недоступен — оставляем как есть
		КонецПопытки;
	КонецЦикла;
	Макет = КомпоновщикМакета.Выполнить(Подготовка.Схема, Настройки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, , , Истина);
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(ТД);
	Вывод.Вывести(Процессор);
	Подготовка.Вставить("ТД", ТД);
	Возврат Подготовка;

КонецФункции

// Вариант «Суточный рапорт по заводу»: объект отчёта с загруженными настройками варианта,
// периодом с 1-го числа по дату отчёта и текущим планом производства.
&НаСервере
Функция ПодготовитьСуточныйРапорт(П)

	Если Метаданные.Справочники.Найти("ВариантыОтчетов") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ВО.Ссылка КАК Ссылка, ВО.Наименование КАК Наименование, ВО.Отчет КАК Отчет
		|ИЗ Справочник.ВариантыОтчетов КАК ВО
		|ГДЕ НЕ ВО.ПометкаУдаления И ВО.Наименование ПОДОБНО ""%уточн%рапорт%""");
	Варианты = Запрос.Выполнить().Выгрузить();
	Если Варианты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выбранный = Варианты[0];
	Для Каждого Вар Из Варианты Цикл
		Если СтрНайти(НРег(Вар.Наименование), "завод") > 0 Тогда
			Выбранный = Вар;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ОтчетОбъект = ОбъектОтчетаБазы(Выбранный.Отчет);
	МетаОтчета = ОтчетОбъект.Метаданные();
	Если МетаОтчета.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		ВызватьИсключение "у отчёта «" + Выбранный.Наименование + "» нет схемы компоновки";
	КонецЕсли;
	Схема = ОтчетОбъект.ПолучитьМакет(МетаОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
	ОтчетОбъект.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Настройки = Неопределено;
	Попытка
		Настройки = РеквизитСсылки(Выбранный.Ссылка, "Настройки").Получить();
	Исключение
		Настройки = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Настройки) <> Тип("НастройкиКомпоновкиДанных") Тогда
		Настройки = Схема.НастройкиПоУмолчанию;
	КонецЕсли;
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	// период отчёта — на дату отчёта; параметры узнаём по типу в схеме (период / дата), а дату — ещё и по имени:
	// «начало…» — начало дня, остальные даты — конец дня
	ПериодУстановлен = Ложь;
	УстановленныеПараметры = Новый Массив;
	Для Каждого Пар Из ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		ИмяПараметра = Строка(Пар.Параметр);
		Имя = НРег(ИмяПараметра);
		ОписаниеПараметра = Схема.Параметры.Найти(ИмяПараметра);
		Значение = Неопределено;
		ЭтоПериод = ТипЗнч(Пар.Значение) = Тип("СтандартныйПериод")
			ИЛИ (ОписаниеПараметра <> Неопределено И ОписаниеПараметра.ТипЗначения.СодержитТип(Тип("СтандартныйПериод")));
		ЭтоДата = ТипЗнч(Пар.Значение) = Тип("Дата")
			ИЛИ (ОписаниеПараметра <> Неопределено И ОписаниеПараметра.ТипЗначения.СодержитТип(Тип("Дата")));
		Если ЭтоПериод Тогда
			Значение = Новый СтандартныйПериод(П.День, П.КонецДня);
		ИначеЕсли ЭтоДата Тогда
			Значение = ?(СтрНайти(Имя, "нач") > 0 ИЛИ СтрНайти(Имя, "с") = 1, П.День, П.КонецДня);
		КонецЕсли;
		Если Значение <> Неопределено Тогда
			Пар.Значение = Значение;
			Пар.Использование = Истина;
			ПериодУстановлен = Истина;
			УстановленныеПараметры.Добавить(ИмяПараметра + " = " + ?(ЭтоПериод, Формат(П.День, "ДФ=dd.MM.yyyy"), Формат(Значение, "ДФ='dd.MM.yyyy HH:mm'")));
		КонецЕсли;
	КонецЦикла;
	// пользовательские настройки варианта (если в них свой период) не загружаем — берутся только наши значения
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Новый ПользовательскиеНастройкиКомпоновкиДанных);
	// скрытые параметры схемы (их нет в настройках) — значения по умолчанию в самой схеме, если они не вычисляются
	Для Каждого ПараметрСхемы Из Схема.Параметры Цикл
		Если НЕ ПустаяСтрока(ПараметрСхемы.Выражение) Тогда
			Продолжить;
		КонецЕсли;
		Имя = НРег(ПараметрСхемы.Имя);
		Если ПараметрСхемы.ТипЗначения.СодержитТип(Тип("СтандартныйПериод")) Тогда
			ПараметрСхемы.Значение = Новый СтандартныйПериод(П.День, П.КонецДня);
			ПериодУстановлен = Истина;
		ИначеЕсли ПараметрСхемы.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
			ПараметрСхемы.Значение = ?(СтрНайти(Имя, "нач") > 0, П.День, П.КонецДня);
			ПериодУстановлен = Истина;
		КонецЕсли;
	КонецЦикла;
	// текущий план производства месяца — в параметры и отборы отчёта, где он ожидается
	ДокументыПлана = Новый Массив;
	Попытка
		ПланПроизводства(П, П.НачалоМесяца, КонецМесяца(П.День), Неопределено, ДокументыПлана);
	Исключение
		ДокументыПлана = Новый Массив;
	КонецПопытки;
	ПланПодставлен = Ложь;
	Если ДокументыПлана.Количество() > 0 И Метаданные.Документы.Найти("ПланПроизводства") <> Неопределено Тогда
		ТипПлана = Тип("ДокументСсылка.ПланПроизводства");
		СписокПланов = Новый СписокЗначений;
		СписокПланов.ЗагрузитьЗначения(ДокументыПлана);
		Сценарий = РеквизитСсылки(ДокументыПлана[ДокументыПлана.ВГраница()], "Сценарий");
		Для Каждого Пар Из ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
			ИмяПараметра = Строка(Пар.Параметр);
			ОписаниеПараметра = Схема.Параметры.Найти(ИмяПараметра);
			Если ОписаниеПараметра = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ОписаниеПараметра.ТипЗначения.СодержитТип(ТипПлана) Тогда
				Пар.Значение = ?(ДокументыПлана.Количество() = 1 ИЛИ НЕ ОписаниеПараметра.ДоступенСписокЗначений, ДокументыПлана[ДокументыПлана.ВГраница()], СписокПланов);
				Пар.Использование = Истина;
				ПланПодставлен = Истина;
			ИначеЕсли СтрНайти(НРег(ИмяПараметра), "сценари") > 0 И ЗначениеЗаполнено(Сценарий) И ОписаниеПараметра.ТипЗначения.СодержитТип(ТипЗнч(Сценарий)) Тогда
				Пар.Значение = Сценарий;
				Пар.Использование = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ПодставитьПланВОтбор(ОтчетОбъект.КомпоновщикНастроек.Настройки.Отбор.Элементы, ТипПлана, СписокПланов) Тогда
			ПланПодставлен = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("ОтчетОбъект, Схема, Имя, ПериодУстановлен, ПланПодставлен, ДокументыПлана, Параметры", ОтчетОбъект, Схема,
		Выбранный.Наименование, ПериодУстановлен, ПланПодставлен, ДокументыПлана, СтрСоединить(УстановленныеПараметры, "; "));

КонецФункции

// Отборы отчёта по документу плана (например, сохранённые на старый план) — на текущие планы месяца.
&НаСервере
Функция ПодставитьПланВОтбор(ЭлементыОтбора, ТипПлана, СписокПланов)

	Подставлен = Ложь;
	Для Каждого Элемент Из ЭлементыОтбора Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Если ПодставитьПланВОтбор(Элемент.Элементы, ТипПлана, СписокПланов) Тогда
				Подставлен = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Значение = Элемент.ПравоеЗначение;
		ЭтоПлан = ТипЗнч(Значение) = ТипПлана;
		Если ТипЗнч(Значение) = Тип("СписокЗначений") И Значение.Количество() > 0 Тогда
			ЭтоПлан = ТипЗнч(Значение[0].Значение) = ТипПлана;
		КонецЕсли;
		Если ЭтоПлан Тогда
			Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			Элемент.ПравоеЗначение = СписокПланов;
			Элемент.Использование = Истина;
			Подставлен = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Подставлен;

КонецФункции

// Параметры «Суточного рапорта» в итоговых настройках — по всем параметрам схемы: дата/период — на дату отчёта
// (поля «конец…» — конец дня, остальные — начало дня, как при выборе даты вручную), документ плана — текущий план месяца.
// Значения ставятся принудительно (УстановитьЗначениеПараметра), даже если параметра не было в сохранённом варианте.
&НаСервере
Функция ПрименитьПараметрыРапорта(Настройки, Схема, П, ДокументыПлана)

	Установлено = Новый Массив;
	ТипПлана = ?(Метаданные.Документы.Найти("ПланПроизводства") = Неопределено, Неопределено, Тип("ДокументСсылка.ПланПроизводства"));
	ПланМесяца = ?(ДокументыПлана.Количество() = 0, Неопределено, ДокументыПлана[ДокументыПлана.ВГраница()]);
	Для Каждого ПараметрСхемы Из Схема.Параметры Цикл
		Если НЕ ПустаяСтрока(ПараметрСхемы.Выражение) Тогда
			Продолжить;
		КонецЕсли;
		Имя = НРег(ПараметрСхемы.Имя + " " + ПараметрСхемы.Заголовок);
		Значение = Неопределено;
		// тип параметра в схеме бывает не указан — узнаём ещё по текущему значению и по названию («На дату»)
		ТекущееЗначение = ПараметрСхемы.Значение;
		Попытка
			ЗначениеНастроек = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ПараметрСхемы.Имя));
			Если ЗначениеНастроек <> Неопределено Тогда
				ТекущееЗначение = ЗначениеНастроек.Значение;
			КонецЕсли;
		Исключение
			ТекущееЗначение = ПараметрСхемы.Значение;
		КонецПопытки;
		ЭтоПериодПараметр = ПараметрСхемы.ТипЗначения.СодержитТип(Тип("СтандартныйПериод")) ИЛИ ТипЗнч(ТекущееЗначение) = Тип("СтандартныйПериод");
		ЭтоДатаПараметр = ПараметрСхемы.ТипЗначения.СодержитТип(Тип("Дата")) ИЛИ ТипЗнч(ТекущееЗначение) = Тип("Дата")
			ИЛИ (СтрНайти(Имя, "дат") > 0 И НЕ ПараметрСхемы.ТипЗначения.СодержитТип(Тип("Строка")) И ТипЗнч(ТекущееЗначение) <> Тип("Строка")
				И (ТекущееЗначение = Неопределено ИЛИ ТипЗнч(ТекущееЗначение) = Тип("Дата")));
		Если ЭтоПериодПараметр Тогда
			Значение = Новый СтандартныйПериод(П.День, П.КонецДня);
		ИначеЕсли ЭтоДатаПараметр Тогда
			Значение = ?(СтрНайти(Имя, "конец") > 0 ИЛИ СтрНайти(Имя, "оконч") > 0 ИЛИ СтрНайти(Имя, "по") = 1, П.КонецДня, П.День);
		ИначеЕсли ТипПлана <> Неопределено И ПланМесяца <> Неопределено И ПараметрСхемы.ТипЗначения.СодержитТип(ТипПлана) Тогда
			Значение = ПланМесяца;
		КонецЕсли;
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПараметрСхемы.Значение = Значение;
		Попытка
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрСхемы.Имя, Значение);
		Исключение
			// параметр нельзя менять в настройках — остаётся значение в схеме
		КонецПопытки;
		Установлено.Добавить(?(ПустаяСтрока(ПараметрСхемы.Заголовок), ПараметрСхемы.Имя, ПараметрСхемы.Заголовок) + " = "
			+ ?(ТипЗнч(Значение) = Тип("Дата"), Формат(Значение, "ДФ='dd.MM.yyyy HH:mm'"), ?(ТипЗнч(Значение) = Тип("СтандартныйПериод"), Формат(П.День, "ДФ=dd.MM.yyyy"), Строка(Значение))));
	КонецЦикла;
	Возврат СтрСоединить(Установлено, "; ");

КонецФункции

&НаСервере
Функция ОбъектОтчетаБазы(Отчет)

	Если ТипЗнч(Отчет) = Тип("Строка") Тогда
		Возврат Отчеты[Метаданные.НайтиПоПолномуИмени(Отчет).Имя].Создать();
	ИначеЕсли Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено
		И ТипЗнч(Отчет) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") Тогда
		Возврат ВнешниеОтчеты.Создать(ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(Отчет));
	КонецЕсли;
	ПолноеИмя = РеквизитСсылки(Отчет, "ПолноеИмя");
	Мета = ?(ПолноеИмя = Неопределено, Неопределено, Метаданные.НайтиПоПолномуИмени(ПолноеИмя));
	Если Мета = Неопределено Тогда
		ВызватьИсключение "отчёт не найден в метаданных (" + Строка(ПолноеИмя) + ")";
	КонецЕсли;
	Возврат Отчеты[Мета.Имя].Создать();

КонецФункции

// Цифры с готового листа «Суточного рапорта» — ровно то, что видно на экране. Шапка — строки со словами
// «план», «факт» и т. п. (заголовки групп над колонками учитываются); строки — позиции номенклатуры и участки,
// узнанные по наименованию; итоги и прочие строки пропускаются.
&НаСервере
Функция ДанныеИзЛистаРапорта(ТД, ИмяОтчета)

	Р = Новый Структура("Таблица, Имя, Сопоставление, Ошибка, ЕстьУчасток, Показатели", Неопределено, ИмяОтчета, "", "", Ложь,
		Новый Структура("ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате", "", "", "", ""));
	Высота = ТД.ВысотаТаблицы;
	Ширина = ТД.ШиринаТаблицы;
	Если Высота = 0 ИЛИ Ширина = 0 Тогда
		Р.Ошибка = "отчёт пустой";
		Возврат Р;
	КонецЕсли;
	// шапка таблицы: начинается со строки, где есть «факт» или «выпуск» (строка «Документ план: …» над таблицей
	// сюда не попадает), и продолжается вниз, пока в строке нет чисел (двухэтажная шапка: «Факт» → «Выпуск с нач. мес.», «За сутки»)
	СтрокиШапки = Новый Массив;
	Для НомерСтроки = 1 По Мин(Высота, 60) Цикл
		Если СтрокиШапки.Количество() = 0 Тогда
			Для НомерКолонки = 1 По Ширина Цикл
				Текст = ТекстЯчейкиЛиста(ТД, НомерСтроки, НомерКолонки);
				Если СтрНайти(Текст, "факт") > 0 ИЛИ СтрНайти(Текст, "выпуск") > 0 Тогда
					СтрокиШапки.Добавить(НомерСтроки);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ЕстьЧислоВСтроке(ТД, НомерСтроки, Ширина) ИЛИ НЕ ЕстьТекстВСтроке(ТД, НомерСтроки, Ширина) Тогда
			Прервать;
		Иначе
			СтрокиШапки.Добавить(НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиШапки.Количество() = 0 Тогда
		Р.Ошибка = "в шапке отчёта нет колонки «Факт» / «Выпуск»";
		Возврат Р;
	КонецЕсли;
	ПоследняяШапки = СтрокиШапки[СтрокиШапки.ВГраница()];
	Заголовки = Новый Соответствие;
	Для Каждого НомерСтроки Из СтрокиШапки Цикл
		Предыдущий = "";
		Для НомерКолонки = 1 По Ширина Цикл
			Текст = ТекстЯчейкиЛиста(ТД, НомерСтроки, НомерКолонки);
			// объединённая ячейка группы: текст только в первой колонке — продолжаем его вправо
			Если Текст = "" И НомерСтроки <> ПоследняяШапки Тогда
				Текст = Предыдущий;
			КонецЕсли;
			Предыдущий = Текст;
			Если Текст <> "" Тогда
				Заголовки.Вставить(НомерКолонки, СокрЛП(Строка(Заголовки[НомерКолонки]) + " " + Текст));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// что в какой колонке
	Колонки = Новый Структура("ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате", 0, 0, 0, 0);
	ФактБезПериода = 0;
	Для НомерКолонки = 1 По Ширина Цикл
		Заголовок = Строка(Заголовки[НомерКолонки]);
		Вид = ВидПоказателяРапорта(Заголовок);
		Если Вид = "Факт" Тогда
			Если ФактБезПериода = 0 Тогда
				ФактБезПериода = НомерКолонки;
			КонецЕсли;
		ИначеЕсли Вид <> "" И Колонки[Вид] = 0 Тогда
			Колонки[Вид] = НомерКолонки;
		КонецЕсли;
	КонецЦикла;
	// факт без указания периода: отчёт на одну дату — это факт за сутки (если «с начала месяца» есть отдельно)
	Если ФактБезПериода > 0 Тогда
		Если Колонки.ЗаДень = 0 Тогда
			Колонки.ЗаДень = ФактБезПериода;
		ИначеЕсли Колонки.ЗаМесяц = 0 Тогда
			Колонки.ЗаМесяц = ФактБезПериода;
		КонецЕсли;
	КонецЕсли;
	Если Колонки.ЗаДень = 0 И Колонки.ЗаМесяц = 0 И Колонки.ПланМесяца = 0 Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Заголовки Цикл
			Список.Добавить("«" + Элемент.Значение + "»");
		КонецЦикла;
		Р.Ошибка = "не понял колонки; шапка отчёта: " + СтрСоединить(Список, ", ");
		Возврат Р;
	КонецЕсли;

	// наименования в строках → номенклатура и участки
	Тексты = Новый Массив;
	Для НомерСтроки = ПоследняяШапки + 1 По Высота Цикл
		Для НомерКолонки = 1 По Мин(Ширина, 4) Цикл
			Текст = СокрЛП(ТД.Область(НомерСтроки, НомерКолонки).Текст);
			Если Текст <> "" Тогда
				Тексты.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	НоменклатураПоИмени = СсылкиПоНаименованиям("Номенклатура", Тексты);
	Участки = СсылкиПоНаименованиям("СтруктураПредприятия", Тексты);
	// строки групп («Группа аналитического учёта») — не позиции, даже если название совпало с номенклатурой
	ГруппыУчета = СсылкиПоНаименованиям("ГруппыАналитическогоУчетаНоменклатуры", Тексты);
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Участок");
	Т.Колонки.Добавить("Номенклатура");
	Для Каждого Элемент Из Колонки Цикл
		Т.Колонки.Добавить(Элемент.Ключ, ОписаниеЧисла());
	КонецЦикла;
	ТекущийУчасток = Неопределено;
	Для НомерСтроки = ПоследняяШапки + 1 По Высота Цикл
		Позиция = Неопределено;
		Для НомерКолонки = 1 По Мин(Ширина, 4) Цикл
			Текст = СокрЛП(ТД.Область(НомерСтроки, НомерКолонки).Текст);
			Если Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			Если ГруппыУчета[НРег(Текст)] <> Неопределено Тогда
				Прервать;
			ИначеЕсли Участки[НРег(Текст)] <> Неопределено Тогда
				ТекущийУчасток = Участки[НРег(Текст)];
				Р.ЕстьУчасток = Истина;
				Прервать;
			ИначеЕсли НоменклатураПоИмени[НРег(Текст)] <> Неопределено Тогда
				Позиция = НоменклатураПоИмени[НРег(Текст)];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Позиция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Т.Добавить();
		НовСтр.Участок = ТекущийУчасток;
		НовСтр.Номенклатура = Позиция;
		Для Каждого Элемент Из Колонки Цикл
			Если Элемент.Значение > 0 Тогда
				НовСтр[Элемент.Ключ] = ЧислоИзТекста(ТД.Область(НомерСтроки, Элемент.Значение).Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Т.Количество() = 0 Тогда
		Р.Ошибка = "в строках отчёта не узнана номенклатура (наименования не совпали со справочником)";
		Возврат Р;
	КонецЕсли;
	Т.Свернуть("Участок, Номенклатура", "ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате");
	Р.Таблица = Т;
	Части = Новый Массив;
	Для Каждого Пара Из СтрРазделить("ЗаДень:факт за сутки,ЗаМесяц:факт с 1-го числа,ПланМесяца:план месяца,ПланКДате:план к дате", ",") Цикл
		Ч = СтрРазделить(Пара, ":");
		Номер = Колонки[Ч[0]];
		Р.Показатели[Ч[0]] = ?(Номер = 0, "", "есть");
		Части.Добавить(Ч[1] + " — " + ?(Номер = 0, "нет в отчёте", "«" + Заголовки[Номер] + "»"));
	КонецЦикла;
	Р.Сопоставление = "по листу отчёта: " + СтрСоединить(Части, "; ") + "; позиций " + Т.Количество()
		+ ?(Р.ЕстьУчасток, "", "; участков в отчёте нет — участок из рапортов");
	Возврат Р;

КонецФункции

// План / факт, сутки / с начала месяца / к дате — по заголовку колонки.
&НаСервереБезКонтекста
Функция ВидПоказателяРапорта(Знач Заголовок)

	Заголовок = СтрЗаменить(НРег(Заголовок), "ё", "е");
	Если Заголовок = "" ИЛИ СтрНайти(Заголовок, "%") > 0 ИЛИ СтрНайти(Заголовок, "процент") > 0 ИЛИ СтрНайти(Заголовок, "откл") > 0
		ИЛИ СтрНайти(Заголовок, "выполн") > 0 ИЛИ СтрНайти(Заголовок, "цена") > 0 ИЛИ СтрНайти(Заголовок, "сумм") > 0
		ИЛИ СтрНайти(Заголовок, "стоим") > 0 ИЛИ СтрНайти(Заголовок, "остат") > 0 ИЛИ СтрНайти(Заголовок, "ед.") > 0 Тогда
		Возврат "";
	КонецЕсли;
	ЗаДень = СтрНайти(Заголовок, "сут") > 0 ИЛИ СтрНайти(Заголовок, "день") > 0 ИЛИ СтрНайти(Заголовок, "дня") > 0;
	ЗаМесяц = СтрНайти(Заголовок, "месяц") > 0 ИЛИ СтрНайти(Заголовок, "с нач") > 0 ИЛИ СтрНайти(Заголовок, "нараст") > 0 ИЛИ СтрНайти(Заголовок, "с 1") > 0;
	Если СтрНайти(Заголовок, "план") > 0 Тогда
		Если СтрНайти(Заголовок, "дат") > 0 ИЛИ СтрНайти(Заголовок, "сегодн") > 0 ИЛИ (ЗаДень И ЗаМесяц) Тогда
			Возврат "ПланКДате";
		ИначеЕсли ЗаДень Тогда
			Возврат "";
		КонецЕсли;
		Возврат "ПланМесяца";
	ИначеЕсли СтрНайти(Заголовок, "факт") > 0 ИЛИ СтрНайти(Заголовок, "выпуск") > 0 ИЛИ СтрНайти(Заголовок, "произв") > 0
		ИЛИ СтрНайти(Заголовок, "наработ") > 0 ИЛИ СтрНайти(Заголовок, "выработ") > 0 Тогда
		Если ЗаМесяц Тогда
			Возврат "ЗаМесяц";
		ИначеЕсли ЗаДень Тогда
			Возврат "ЗаДень";
		КонецЕсли;
		Возврат "Факт";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ТекстЯчейкиЛиста(ТД, НомерСтроки, НомерКолонки)

	Возврат СтрЗаменить(НРег(СокрЛП(ТД.Область(НомерСтроки, НомерКолонки).Текст)), Символы.ПС, " ");

КонецФункции

// В строке есть число (строка данных, а не шапки).
&НаСервере
Функция ЕстьЧислоВСтроке(ТД, НомерСтроки, Ширина)

	Для НомерКолонки = 2 По Ширина Цикл
		Текст = СокрЛП(ТД.Область(НомерСтроки, НомерКолонки).Текст);
		Если Текст <> "" И ЧислоИзТекста(Текст) <> 0 И СтрДлина(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", ""), ".", ""), Символы.НПП, "")) > 0 Тогда
			Цифр = 0;
			Для Номер = 1 По СтрДлина(Текст) Цикл
				Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) > 0 Тогда
					Цифр = Цифр + 1;
				КонецЕсли;
			КонецЦикла;
			// «1 234,5» — число; «Выпуск с 1-го» — текст
			Если Цифр * 2 >= СтрДлина(СтрЗаменить(Текст, " ", "")) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЕстьТекстВСтроке(ТД, НомерСтроки, Ширина)

	Для НомерКолонки = 2 По Ширина Цикл
		Если ТекстЯчейкиЛиста(ТД, НомерСтроки, НомерКолонки) <> "" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Наименование (в нижнем регистре) → ссылка справочника для тех наименований, что есть в списке.
&НаСервере
Функция СсылкиПоНаименованиям(ИмяСправочника, Тексты)

	Результат = Новый Соответствие;
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено ИЛИ Тексты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	// по наименованию и по полному наименованию (в отчётах часто выводят его)
	Поля = Новый Массив;
	Поля.Добавить("Наименование");
	Если Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("НаименованиеПолное") <> Неопределено Тогда
		Поля.Добавить("НаименованиеПолное");
	КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Ссылка, ВЫРАЗИТЬ(С." + Поле + " КАК СТРОКА(500)) КАК Имя ИЗ Справочник." + ИмяСправочника + " КАК С
			|ГДЕ НЕ С.ПометкаУдаления И ВЫРАЗИТЬ(С." + Поле + " КАК СТРОКА(500)) В (&Тексты)");
		Запрос.УстановитьПараметр("Тексты", Тексты);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = НРег(СокрЛП(Выборка.Имя));
			Если Результат[Ключ] = Неопределено Тогда
				Результат.Вставить(Ключ, Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзТекста(Знач Текст)

	// только цифры, знак и десятичная запятая: «1 234,5 кг» → 1234.5
	Чистый = "";
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Номер, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Чистый = Чистый + Символ;
		ИначеЕсли (Символ = "," ИЛИ Символ = ".") И СтрНайти(Чистый, ".") = 0 Тогда
			Чистый = Чистый + ".";
		ИначеЕсли Символ = "-" И Чистый = "" Тогда
			Чистый = "-";
		КонецЕсли;
	КонецЦикла;
	Текст = Чистый;
	Если Текст = "" ИЛИ Текст = "-" ИЛИ Текст = "." Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ВывестиСуточныйРапортERP(В, П)

	Рапорт = Неопределено;
	ТекстОшибки = "";
	Попытка
		Рапорт = СуточныйРапортERP(П);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Рапорт = Неопределено Тогда
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			Примечание(В, "Отчёт ERP «Суточный рапорт» не сформирован: " + ТекстОшибки);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Подзаголовок(В, "«" + Рапорт.Имя + "» — отчёт ERP на " + Формат(П.День, "ДФ=dd.MM.yyyy"));
	Если НЕ Рапорт.ПериодУстановлен Тогда
		Примечание(В, "ВНИМАНИЕ: у отчёта не найден параметр периода или даты — он показан с сохранёнными в варианте настройками (дата может быть старой).");
	Иначе
		Примечание(В, "Параметры отчёта: " + Рапорт.Параметры + ".");
	КонецЕсли;
	Если Рапорт.ДокументыПлана.Количество() > 0 Тогда
		Планы = Новый Массив;
		Для Каждого Док Из Рапорт.ДокументыПлана Цикл
			Планы.Добавить(Строка(Док));
		КонецЦикла;
		Примечание(В, ?(Рапорт.ПланПодставлен, "В отчёт подставлен текущий план: ", "Текущий план месяца (в отчёте нет параметра или отбора по плану, он берёт план сам): ")
			+ СтрСоединить(Планы, "; ") + ".");
	КонецЕсли;
	В.Строка = Макс(В.Строка, В.ТД.ВысотаТаблицы + 1);
	В.ТД.Вывести(Рапорт.ТД);
	В.Строка = В.ТД.ВысотаТаблицы + 2;
	Возврат Рапорт;

КонецФункции

&НаСервере
Процедура ВывестиВыпуск(В, Р, П)

	ЗаголовокРаздела(В, "Выпуск продукции и план производства");
	Если ПоказатьОшибку(В, Р, "Выпуск") Тогда
		Возврат;
	КонецЕсли;
	Вып = Р.Выпуск;
	Примечание(В, "Источник: " + Вып.Источник + ". Последний выпуск в базе: "
		+ ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск), Формат(Вып.ПоследнийВыпуск, "ДФ=dd.MM.yyyy"), "нет") + "."
		+ ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск) И НачалоДня(Вып.ПоследнийВыпуск) < П.День - 86400,
			" Рапорты за последние дни ещё не введены — суточные цифры будут нулевыми.", "")
		+ ?(ПустаяСтрока(Вып.СверкаРегистра), "", " " + Вып.СверкаРегистра));
	// главный источник цифр выпуска — отчёт ERP «Суточный рапорт по заводу», как он есть
	Рапорт = ВывестиСуточныйРапортERP(В, П);
	Если Вып.ПоПродуктам.Количество() = 0 Тогда
		Примечание(В, "За месяц нет ни выпуска, ни плана производства.");
		Возврат;
	КонецЕсли;
	МесяцСледующий = Вып.ИмяСледующего;
	СледующаяСтрока(В);
	ВывестиВыпускПоУчасткам(В, Вып, П, Рапорт);

	СледующаяСтрока(В);
	Подзаголовок(В, "Итого продукции по единицам измерения");
	Шапка(В, "Единица", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "План " + ИмяМесяца(Месяц(П.День), Ложь), "% плана", "В сутки (30 дн.)",
		"Нужно в сутки до конца месяца", "План " + МесяцСледующий);
	Для Каждого Стр Из Вып.ПоЕдиницам Цикл
		Ячейка(В, 1, ?(ЗначениеЗаполнено(Стр.Ед), Стр.Ед, "без единицы"));
		ЯчейкаКоличество(В, 2, Стр.ЗаДень, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ЗаМесяц, Стр.Ед);
		ЯчейкаКоличество(В, 4, Стр.ПланМесяца, Стр.Ед);
		Ячейка(В, 5, ?(Стр.ПланМесяца = 0, "—", Формат(Стр.ЗаМесяц / Стр.ПланМесяца * 100, "ЧДЦ=0; ЧН=0") + " %"));
		ВПраво(В, 5, 5);
		ЯчейкаКоличество(В, 6, Стр.За30Дней / 30, Стр.Ед);
		Если Стр.ПланМесяца > 0 И Вып.ОсталосьДней > 0 Тогда
			ЯчейкаКоличество(В, 7, Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц) / Вып.ОсталосьДней, Стр.Ед);
		КонецЕсли;
		ЯчейкаКоличество(В, 8, Стр.ПланСледующего, Стр.Ед);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	Если НЕ Вып.ЕстьПланПроизводства Тогда
		Примечание(В, "Документов «План производства» на этот месяц не найдено" + ?(П.ПланВСутки > 0, "; план взят из настройки «План выпуска в сутки».", "."));
	Иначе
		Примечание(В, "План — из последнего по дате проведённого документа «План производства» на месяц (если планы по подразделениям — "
			+ "последний документ каждого подразделения); продукция и полуфабрикаты; отменённые документы и строки не берутся. "
			+ ?(Вып.ПланПоДатам, "«По плану к дате» — сумма строк плана с датой до дня отчёта.", "«По плану к дате» — план месяца пропорционально прошедшим дням (в плане одна дата на месяц).")
			+ " План на " + МесяцСледующий + " — из планов производства на " + МесяцСледующий + ?(Вып.ЕстьПланСледующего, ".", ": документов пока нет."));
	КонецЕсли;
	Попытка
		ВывестиДокументыПлана(В, П, Вып);
	Исключение
		Примечание(В, "Список планов производства не выведен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	СледующаяСтрока(В);
	Подзаголовок(В, "Выпуск по дням за 30 суток, " + Вып.ГлавнаяЕд);
	Точки = Новый Массив;
	Факт = Новый Массив;
	План = Новый Массив;
	Для Каждого Стр Из Вып.История Цикл
		Точки.Добавить(Формат(Стр.Дата, "ДФ=dd.MM"));
		Факт.Добавить(Стр.Количество);
		План.Добавить(Вып.План);
	КонецЦикла;
	Серии = Новый Массив;
	Серии.Добавить(Новый Структура("Имя, Значения", "Выпуск за сутки", Факт));
	Если Вып.План > 0 Тогда
		Серии.Добавить(Новый Структура("Имя, Значения", "План в среднем за сутки", План));
	КонецЕсли;
	ВывестиГрафик(В, Точки, Серии, 12);

КонецПроцедуры

// Одна таблица выпуска: по участкам — продукция и полуфабрикаты, факт за день и с 1-го числа,
// план месяца, % плана, план к дате, осталось выпустить, план следующего месяца; смены — строкой под позицией.
&НаСервере
Функция СтрокиВыпускаПоУчасткам(Вып)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Участок");
	Т.Колонки.Добавить("Номенклатура");
	Т.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	Т.Колонки.Добавить("ЗаМесяц", ОписаниеЧисла());
	ПоУчасткам = Вып.ПоУчасткам;
	Смены = Новый Соответствие; // участок|номенклатура -> массив «смена — количество»
	Если ПоУчасткам <> Неопределено Тогда
		Для Каждого Стр Из ПоУчасткам Цикл
			ЗаполнитьЗначенияСвойств(Т.Добавить(), Стр);
			Если Вып.ЕстьСмены И Стр.ЗаМесяц <> 0 Тогда
				Ключ = КлючУчасткаПозиции(Стр.Участок, Стр.Номенклатура);
				Если Смены[Ключ] = Неопределено Тогда
					Смены.Вставить(Ключ, Новый Массив);
				КонецЕсли;
				Смены[Ключ].Добавить(?(ЗначениеЗаполнено(Стр.Смена), Строка(Стр.Смена), "без смены") + " — " + ФорматЧисла(Стр.ЗаМесяц));
			КонецЕсли;
		КонецЦикла;
		Т.Свернуть("Участок, Номенклатура", "ЗаДень, ЗаМесяц");
	КонецЕсли;
	// колонки после свёртки: Свернуть() оставляет только перечисленные
	Т.Колонки.Добавить("ИмяУчастка", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Ед");
	Т.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	Т.Колонки.Добавить("ПланМесяца", ОписаниеЧисла());
	Т.Колонки.Добавить("ПланКДате", ОписаниеЧисла());
	Т.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	Т.Колонки.Добавить("Смены", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Порядок", ОписаниеЧисла());

	// план — на тот участок, где позиции выпущено больше всего
	Т.Сортировать("ЗаМесяц Убыв");
	Для Каждого Продукт Из Вып.ПоПродуктам Цикл
		Основная = Т.Найти(Продукт.Номенклатура, "Номенклатура");
		Если Основная = Неопределено Тогда
			Если Продукт.ПланМесяца = 0 И Продукт.ПланСледующего = 0 И Продукт.ЗаМесяц = 0 Тогда
				Продолжить;
			КонецЕсли;
			Основная = Т.Добавить();
			Основная.Номенклатура = Продукт.Номенклатура;
			Основная.ЗаДень = ?(ПоУчасткам = Неопределено, Продукт.ЗаДень, 0);
			Основная.ЗаМесяц = ?(ПоУчасткам = Неопределено, Продукт.ЗаМесяц, 0);
			Основная.ИмяУчастка = ?(ПоУчасткам = Неопределено, "Все участки", "Нет выпуска в рапортах с 1-го числа");
			Основная.Порядок = 1;
		КонецЕсли;
		Основная.ПланМесяца = Продукт.ПланМесяца;
		Основная.ПланКДате = Продукт.ПланКДате;
		Основная.ПланСледующего = Продукт.ПланСледующего;
	КонецЦикла;
	Для Каждого Стр Из Т Цикл
		Продукт = Вып.ПоПродуктам.Найти(Стр.Номенклатура, "Номенклатура");
		Стр.Ед = ?(Продукт = Неопределено, ЕдиницаНоменклатуры(Стр.Номенклатура), Продукт.Ед);
		Стр.Полуфабрикат = ?(Продукт = Неопределено, ЭтоПолуфабрикат(Стр.Номенклатура), Продукт.Полуфабрикат);
		Если Стр.Порядок = 0 Тогда
			Стр.ИмяУчастка = ?(ЗначениеЗаполнено(Стр.Участок), Строка(Стр.Участок), "Участок не указан");
		КонецЕсли;
		Список = Смены[КлючУчасткаПозиции(Стр.Участок, Стр.Номенклатура)];
		Если Список <> Неопределено И Список.Количество() > 1 Тогда
			Стр.Смены = "смены с 1-го: " + СтрСоединить(Список, "; ");
		КонецЕсли;
	КонецЦикла;
	Т.Сортировать("Порядок, ИмяУчастка, Полуфабрикат, ЗаМесяц Убыв, ПланМесяца Убыв");
	Возврат Т;

КонецФункции

&НаСервереБезКонтекста
Функция КлючУчасткаПозиции(Участок, Номенклатура)

	Возврат Строка(Участок) + "|" + Строка(Номенклатура);

КонецФункции

// Данные отчёта ERP «Суточный рапорт по заводу» по участкам и позициям: та же схема, те же параметры и отборы,
// но вместо оформления отчёта — таблица «участок + номенклатура + все его показатели». Какой показатель —
// план или факт, за сутки или с начала месяца — определяется по заголовку колонки отчёта.
&НаСервере
Функция ДанныеСуточногоРапорта(П)

	Подготовка = ПодготовитьСуточныйРапорт(П);
	Если Подготовка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Схема = Подготовка.Схема;
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	НастройкиРапорта = Подготовка.ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	ПрименитьПараметрыРапорта(НастройкиРапорта, Подготовка.Схема, П, Подготовка.ДокументыПлана);
	Компоновщик.ЗагрузитьНастройки(НастройкиРапорта);
	Н = Компоновщик.Настройки;
	Н.Структура.Очистить();
	Н.Выбор.Элементы.Очистить();

	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	ТипПодразделения = ?(Метаданные.Справочники.Найти("СтруктураПредприятия") = Неопределено, Неопределено, Тип("СправочникСсылка.СтруктураПредприятия"));
	ПолеНоменклатуры = Неопределено;
	ПриоритетНоменклатуры = 0;
	ПолеУчастка = Неопределено;
	Ресурсы = Новый Массив;
	ВсеПоля = Новый Массив;
	Для Каждого Доступное Из Н.Выбор.ДоступныеПоляВыбора.Элементы Цикл
		Попытка
			Если Доступное.Папка Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
		ВсеПоля.Добавить(Доступное.Заголовок);
		Если Доступное.Ресурс Тогда
			Ресурсы.Добавить(Доступное);
			Продолжить;
		КонецЕсли;
		ИмяПоля = НРег(Строка(Доступное.Поле));
		Если Доступное.ТипЗначения.СодержитТип(ТипНоменклатуры) Тогда
			Приоритет = ?(ИмяПоля = "номенклатура", 3, ?(СтрНайти(ИмяПоля, "продукц") > 0 ИЛИ СтрНайти(ИмяПоля, "изделие") > 0, 2, 1));
			Если Приоритет > ПриоритетНоменклатуры Тогда
				ПолеНоменклатуры = Доступное.Поле;
				ПриоритетНоменклатуры = Приоритет;
			КонецЕсли;
		ИначеЕсли ПолеУчастка = Неопределено И ТипПодразделения <> Неопределено И Доступное.ТипЗначения.СодержитТип(ТипПодразделения) Тогда
			ПолеУчастка = Доступное.Поле;
		КонецЕсли;
	КонецЦикла;
	Р = Новый Структура("Таблица, Имя, Сопоставление, Поля, Ошибка", Неопределено, Подготовка.Имя, "", СтрСоединить(ВсеПоля, "; "), "");
	Если ПолеНоменклатуры = Неопределено ИЛИ Ресурсы.Количество() = 0 Тогда
		Р.Ошибка = "в отчёте не найдено поле номенклатуры или показатели";
		Возврат Р;
	КонецЕсли;

	Группировка = Н.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для Каждого Поле Из СтрРазделить("Участок,Номенклатура", ",") Цикл
		ПолеОтчета = ?(Поле = "Участок", ПолеУчастка, ПолеНоменклатуры);
		Если ПолеОтчета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЭлементГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ЭлементГруппировки.Поле = ПолеОтчета;
		ЭлементГруппировки.Использование = Истина;
		Выбранное = Н.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Выбранное.Поле = ПолеОтчета;
		Выбранное.Использование = Истина;
	КонецЦикла;
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Для Каждого Ресурс Из Ресурсы Цикл
		Выбранное = Н.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Выбранное.Поле = Ресурс.Поле;
		Выбранное.Использование = Истина;
	КонецЦикла;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Н, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, , , Истина);
	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);

	// какие колонки что значат
	КолонкаНоменклатуры = "";
	КолонкаУчастка = "";
	Показатели = Новый Структура("ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате", "", "", "", "");
	Заголовки = Новый Структура("ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате", "", "", "", "");
	ФактБезПериода = "";
	ФактБезПериодаЗаголовок = "";
	Для Каждого Колонка Из Результат.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(ТипНоменклатуры) И КолонкаНоменклатуры = "" Тогда
			КолонкаНоменклатуры = Колонка.Имя;
			Продолжить;
		КонецЕсли;
		Если ТипПодразделения <> Неопределено И Колонка.ТипЗначения.СодержитТип(ТипПодразделения) И КолонкаУчастка = "" Тогда
			КолонкаУчастка = Колонка.Имя;
			Продолжить;
		КонецЕсли;
		Если НЕ Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			Продолжить;
		КонецЕсли;
		Заголовок = СтрЗаменить(НРег(?(ПустаяСтрока(Колонка.Заголовок), Колонка.Имя, Колонка.Заголовок)), "ё", "е");
		Если СтрНайти(Заголовок, "%") > 0 ИЛИ СтрНайти(Заголовок, "процент") > 0 ИЛИ СтрНайти(Заголовок, "откл") > 0
			ИЛИ СтрНайти(Заголовок, "выполн") > 0 ИЛИ СтрНайти(Заголовок, "цена") > 0 ИЛИ СтрНайти(Заголовок, "сумм") > 0
			ИЛИ СтрНайти(Заголовок, "стоим") > 0 ИЛИ СтрНайти(Заголовок, "остат") > 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаДень = СтрНайти(Заголовок, "сут") > 0 ИЛИ СтрНайти(Заголовок, "день") > 0 ИЛИ СтрНайти(Заголовок, "дня") > 0 ИЛИ СтрНайти(Заголовок, "смен") > 0;
		ЗаМесяц = СтрНайти(Заголовок, "месяц") > 0 ИЛИ СтрНайти(Заголовок, "нач") > 0 ИЛИ СтрНайти(Заголовок, "нараст") > 0 ИЛИ СтрНайти(Заголовок, "с 1") > 0;
		Если СтрНайти(Заголовок, "план") > 0 Тогда
			Если СтрНайти(Заголовок, "дат") > 0 ИЛИ СтрНайти(Заголовок, "сегодн") > 0 ИЛИ (ЗаДень И ЗаМесяц) Тогда
				ЗаполнитьПоказатель(Показатели, Заголовки, "ПланКДате", Колонка);
			ИначеЕсли НЕ ЗаДень Тогда
				ЗаполнитьПоказатель(Показатели, Заголовки, "ПланМесяца", Колонка);
			КонецЕсли;
		ИначеЕсли СтрНайти(Заголовок, "факт") > 0 ИЛИ СтрНайти(Заголовок, "выпуск") > 0 ИЛИ СтрНайти(Заголовок, "произв") > 0
			ИЛИ СтрНайти(Заголовок, "наработ") > 0 ИЛИ СтрНайти(Заголовок, "выработ") > 0 ИЛИ СтрНайти(Заголовок, "колич") > 0
			ИЛИ СтрНайти(Заголовок, "вес") > 0 ИЛИ СтрНайти(Заголовок, "сдан") > 0 Тогда
			Если ЗаДень И НЕ ЗаМесяц Тогда
				ЗаполнитьПоказатель(Показатели, Заголовки, "ЗаДень", Колонка);
			ИначеЕсли ЗаМесяц Тогда
				ЗаполнитьПоказатель(Показатели, Заголовки, "ЗаМесяц", Колонка);
			ИначеЕсли ФактБезПериода = "" Тогда
				ФактБезПериода = Колонка.Имя;
				ФактБезПериодаЗаголовок = ?(ПустаяСтрока(Колонка.Заголовок), Колонка.Имя, Колонка.Заголовок);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// показатель факта без указания периода — это факт за весь период отчёта (с 1-го числа)
	Если Показатели.ЗаМесяц = "" И ФактБезПериода <> "" Тогда
		Показатели.ЗаМесяц = ФактБезПериода;
		Заголовки.ЗаМесяц = ФактБезПериодаЗаголовок;
	КонецЕсли;
	Если КолонкаНоменклатуры = "" ИЛИ (Показатели.ЗаМесяц = "" И Показатели.ПланМесяца = "") Тогда
		Колонки = Новый Массив;
		Для Каждого Колонка Из Результат.Колонки Цикл
			Колонки.Добавить(?(ПустаяСтрока(Колонка.Заголовок), Колонка.Имя, Колонка.Заголовок));
		КонецЦикла;
		Р.Ошибка = "не удалось понять, какие колонки — план и факт; колонки отчёта: " + СтрСоединить(Колонки, "; ");
		Возврат Р;
	КонецЕсли;

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Участок");
	Т.Колонки.Добавить("Номенклатура");
	Для Каждого Показатель Из Показатели Цикл
		Т.Колонки.Добавить(Показатель.Ключ, ОписаниеЧисла());
	КонецЦикла;
	Для Каждого Стр Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(Стр[КолонкаНоменклатуры]) Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Т.Добавить();
		НовСтр.Номенклатура = Стр[КолонкаНоменклатуры];
		НовСтр.Участок = ?(КолонкаУчастка = "", Неопределено, Стр[КолонкаУчастка]);
		Для Каждого Показатель Из Показатели Цикл
			Если Показатель.Значение <> "" Тогда
				НовСтр[Показатель.Ключ] = ЧислоИлиНоль(Стр[Показатель.Значение]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Т.Свернуть("Участок, Номенклатура", "ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате");
	Р.Таблица = Т;
	Части = Новый Массив;
	Для Каждого Пара Из СтрРазделить("ЗаДень:факт за сутки,ЗаМесяц:факт с 1-го числа,ПланМесяца:план месяца,ПланКДате:план к дате", ",") Цикл
		Ч = СтрРазделить(Пара, ":");
		Части.Добавить(Ч[1] + " — " + ?(Заголовки[Ч[0]] = "", "нет в отчёте", "«" + Заголовки[Ч[0]] + "»"));
	КонецЦикла;
	Р.Сопоставление = СтрСоединить(Части, "; ") + ?(КолонкаУчастка = "", "; участка в отчёте нет — участок из рапортов", "");
	Р.Вставить("ЕстьУчасток", КолонкаУчастка <> "");
	Р.Вставить("Показатели", Показатели);
	Возврат Р;

КонецФункции

&НаСервере
Процедура ЗаполнитьПоказатель(Показатели, Заголовки, Ключ, Колонка)

	Если Показатели[Ключ] = "" Тогда
		Показатели[Ключ] = Колонка.Имя;
		Заголовки[Ключ] = ?(ПустаяСтрока(Колонка.Заголовок), Колонка.Имя, Колонка.Заголовок);
	КонецЕсли;

КонецПроцедуры

// Строки таблицы выполнения из данных отчёта ERP: план и факт — как в «Суточном рапорте»; чего в нём нет
// (участок, план следующего месяца, смены) — из рапортов и планов производства.
&НаСервере
Функция СтрокиВыпускаИзРапортаERP(Вып, Данные, П)

	Т = СтрокиВыпускаПоУчасткам(Вып).СкопироватьКолонки();
	Наши = СтрокиВыпускаПоУчасткам(Вып);
	Показатели = Данные.Показатели;
	ДнейВМесяце = День(КонецМесяца(П.День));
	ДнейПрошло = День(П.День);
	Учтены = Новый Соответствие;
	Для Каждого Стр Из Данные.Таблица Цикл
		НовСтр = Т.Добавить();
		НовСтр.Номенклатура = Стр.Номенклатура;
		// основной участок позиции по рапортам — где её выпущено больше всего
		Наша = Неопределено;
		Для Каждого Вариант Из Наши.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура)) Цикл
			Если Наша = Неопределено ИЛИ Вариант.ЗаМесяц > Наша.ЗаМесяц Тогда
				Наша = Вариант;
			КонецЕсли;
		КонецЦикла;
		Продукт = Вып.ПоПродуктам.Найти(Стр.Номенклатура, "Номенклатура");
		Если Данные.ЕстьУчасток Тогда
			НовСтр.Участок = Стр.Участок;
			НовСтр.ИмяУчастка = ?(ЗначениеЗаполнено(Стр.Участок), Строка(Стр.Участок), "Участок не указан");
		ИначеЕсли Наша <> Неопределено Тогда
			НовСтр.Участок = Наша.Участок;
			НовСтр.ИмяУчастка = Наша.ИмяУчастка;
			НовСтр.Порядок = Наша.Порядок;
		Иначе
			НовСтр.ИмяУчастка = "Участок не указан";
		КонецЕсли;
		НовСтр.ЗаДень = ?(Показатели.ЗаДень <> "", Стр.ЗаДень, ?(Наша = Неопределено, 0, Наша.ЗаДень));
		НовСтр.ЗаМесяц = ?(Показатели.ЗаМесяц <> "", Стр.ЗаМесяц, ?(Наша = Неопределено, 0, Наша.ЗаМесяц));
		// план — всегда из документов «План производства» (на основной участок позиции, один раз)
		Если Учтены[Стр.Номенклатура] = Неопределено И Продукт <> Неопределено Тогда
			НовСтр.ПланМесяца = Продукт.ПланМесяца;
			НовСтр.ПланКДате = Продукт.ПланКДате;
			НовСтр.ПланСледующего = Продукт.ПланСледующего;
		КонецЕсли;
		Учтены.Вставить(Стр.Номенклатура, Истина);
		НовСтр.Ед = ?(Продукт = Неопределено, ЕдиницаНоменклатуры(Стр.Номенклатура), Продукт.Ед);
		НовСтр.Полуфабрикат = ?(Продукт = Неопределено, ЭтоПолуфабрикат(Стр.Номенклатура), Продукт.Полуфабрикат);
		Если Наша <> Неопределено И Наша.Участок = НовСтр.Участок Тогда
			НовСтр.Смены = Наша.Смены;
		КонецЕсли;
	КонецЦикла;
	// позиции плана, которых в отчёте нет (не выпускались)
	Для Каждого Продукт Из Вып.ПоПродуктам Цикл
		Если Учтены[Продукт.Номенклатура] = Неопределено И (Продукт.ПланМесяца > 0 ИЛИ Продукт.ПланСледующего > 0) Тогда
			НовСтр = Т.Добавить();
			НовСтр.Номенклатура = Продукт.Номенклатура;
			НовСтр.ИмяУчастка = ?(Продукт.ПланМесяца > 0, "В плане, но выпуска нет", "Только в плане на " + Вып.ИмяСледующего);
			НовСтр.Порядок = 2;
			НовСтр.ПланМесяца = Продукт.ПланМесяца;
			НовСтр.ПланКДате = Продукт.ПланКДате;
			НовСтр.ПланСледующего = Продукт.ПланСледующего;
			НовСтр.Ед = Продукт.Ед;
			НовСтр.Полуфабрикат = Продукт.Полуфабрикат;
		КонецЕсли;
	КонецЦикла;
	Т.Сортировать("Порядок, ИмяУчастка, Полуфабрикат, ЗаМесяц Убыв, ПланМесяца Убыв");
	Возврат Т;

КонецФункции

&НаСервере
Процедура ВывестиВыпускПоУчасткам(В, Вып, П, Рапорт = Неопределено)

	МесяцСледующий = Вып.ИмяСледующего;
	// план и факт — из отчёта ERP «Суточный рапорт по заводу»: сначала с его листа (то, что видно на экране),
	// если не вышло — из его схемы данных, иначе — по рапортам и планам производства
	Данные = Неопределено;
	ТекстИсточника = "";
	ОшибкаЛиста = "";
	Если Рапорт <> Неопределено Тогда
		Попытка
			Данные = ДанныеИзЛистаРапорта(Рапорт.ТД, Рапорт.Имя);
			ОшибкаЛиста = Данные.Ошибка;
		Исключение
			ОшибкаЛиста = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Данные = Неопределено ИЛИ Данные.Таблица = Неопределено Тогда
		Попытка
			Данные = ДанныеСуточногоРапорта(П);
		Исключение
			ТекстИсточника = "данные отчёта ERP не получены: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ОшибкаЛиста <> "" Тогда
		ТекстИсточника = "С листа отчёта цифры не взяты: " + ОшибкаЛиста + ". " + ТекстИсточника;
	КонецЕсли;
	Если Данные <> Неопределено И Данные.Таблица <> Неопределено Тогда
		Т = СтрокиВыпускаИзРапортаERP(Вып, Данные, П);
		// сверка плана документа с колонкой «План» рапорта
		Если Данные.Показатели.ПланМесяца <> "" Тогда
			ПланРапорта = Данные.Таблица.Скопировать(, "Номенклатура, ПланМесяца");
			ПланРапорта.Свернуть("Номенклатура", "ПланМесяца");
			Расхождения = Новый Массив;
			Для Каждого Стр Из ПланРапорта Цикл
				Продукт = Вып.ПоПродуктам.Найти(Стр.Номенклатура, "Номенклатура");
				ВДокументе = ?(Продукт = Неопределено, 0, Продукт.ПланМесяца);
				Если Макс(ВДокументе - Стр.ПланМесяца, Стр.ПланМесяца - ВДокументе) > Макс(ВДокументе, Стр.ПланМесяца) * 0.01 Тогда
					Расхождения.Добавить(Строка(Стр.Номенклатура) + ": документ " + ФорматЧисла(ВДокументе) + ", рапорт " + ФорматЧисла(Стр.ПланМесяца));
				КонецЕсли;
			КонецЦикла;
			Если Расхождения.Количество() > 0 Тогда
				ТекстИсточника = ТекстИсточника + "План документа не совпал с колонкой «План» рапорта по " + Расхождения.Количество() + " поз.: "
					+ Лев(СтрСоединить(Расхождения, "; "), 500) + ". ";
			КонецЕсли;
		КонецЕсли;
		ТекстИсточника = ТекстИсточника + "Факт — из отчёта «" + Данные.Имя + "», " + Данные.Сопоставление
			+ ". План — из документов «План производства» (список документов — ниже).";
	Иначе
		Т = СтрокиВыпускаПоУчасткам(Вып);
		Если Данные <> Неопределено Тогда
			ТекстИсточника = "Из отчёта «" + Данные.Имя + "» данные не взяты (" + Данные.Ошибка + "); план и факт — по рапортам и планам производства.";
		ИначеЕсли ТекстИсточника = "" Тогда
			ТекстИсточника = "Отчёт ERP «Суточный рапорт» не найден; план и факт — по рапортам и планам производства.";
		Иначе
			ТекстИсточника = ТекстИсточника + "; план и факт — по рапортам и планам производства.";
		КонецЕсли;
	КонецЕсли;
	Подзаголовок(В, "План производства и выполнение по участкам (продукция и полуфабрикаты)");
	Шапка(В, "Участок / группа / позиция", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "План " + ИмяМесяца(Месяц(П.День), Ложь), "% плана",
		"По плану к " + Формат(П.День, "ДФ=dd.MM"), "Осталось выпустить", "План " + МесяцСледующий);
	Участки = Т.Скопировать(, "ИмяУчастка, Порядок");
	Участки.Свернуть("ИмяУчастка, Порядок");
	Участки.Сортировать("Порядок, ИмяУчастка");
	Для Каждого Уч Из Участки Цикл
		Строки = Т.НайтиСтроки(Новый Структура("ИмяУчастка", Уч.ИмяУчастка));
		ВывестиИтогУчастка(В, Строки, Уч.ИмяУчастка);
		// внутри участка — по группам номенклатуры, как в других разделах; сначала продукция, потом полуфабрикаты
		Для Каждого Вид Из СтрРазделить("Нет,Да", ",") Цикл
			ЭтогоВида = Новый Массив;
			Для Каждого Стр Из Строки Цикл
				Если Стр.Полуфабрикат = (Вид = "Да") Тогда
					ЭтогоВида.Добавить(Стр);
				КонецЕсли;
			КонецЦикла;
			Если ЭтогоВида.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Гр Из ГруппыНоменклатуры(ЭтогоВида, "Номенклатура", "ЗаМесяц") Цикл
				Гр.Группа = "   " + Строка(Гр.Группа) + ?(Вид = "Да", " (полуфабрикаты)", "");
				ВывестиСтрокуГруппы(В, Гр, "2:ЗаДень:к,3:ЗаМесяц:к,4:ПланМесяца:к,8:ПланСледующего:к", 8);
				Позиции = Новый ТаблицаЗначений;
				Позиции.Колонки.Добавить("Стр");
				Позиции.Колонки.Добавить("ЗаМесяц", ОписаниеЧисла());
				Позиции.Колонки.Добавить("ПланМесяца", ОписаниеЧисла());
				Для Каждого Стр Из Гр.Позиции Цикл
					НовСтр = Позиции.Добавить();
					НовСтр.Стр = Стр;
					НовСтр.ЗаМесяц = Стр.ЗаМесяц;
					НовСтр.ПланМесяца = Стр.ПланМесяца;
				КонецЦикла;
				Позиции.Сортировать("ЗаМесяц Убыв, ПланМесяца Убыв");
				Для Каждого Поз Из Позиции Цикл
					ВывестиСтрокуВыпуска(В, Поз.Стр, МесяцСледующий);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Примечание(В, "Факт — продукция и полуфабрикаты (п/ф) из проведённых суточных рапортов по участкам (подразделение в рапорте)"
		+ ?(Вып.ЕстьСмены, "; если позицию делали в несколько смен — разбивка строкой под ней", "") + ". "
		+ "В строке участка — продукция и отдельно «+ … п/ф» (и в факте, и в плане). " + ТекстИсточника);

КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуВыпуска(В, Стр, МесяцСледующий)

	ПФ = ?(Стр.Полуфабрикат, " п/ф", "");
	ЯчейкаПозиции(В, Строка(Стр.Номенклатура) + ?(Стр.Полуфабрикат, " (п/ф)", ""));
	Для Каждого Пара Из СтрРазделить("2:ЗаДень,3:ЗаМесяц", ",") Цикл
		Ч = СтрРазделить(Пара, ":");
		Значение = Стр[Ч[1]];
		Ячейка(В, Число(Ч[0]), ?(Значение = 0, "—", ФорматЧисла(Значение) + ?(ЗначениеЗаполнено(Стр.Ед), " " + Стр.Ед, "") + ПФ),
			, ?(Значение = 0, ЦветПриглушенный(), Неопределено));
		ВПраво(В, Число(Ч[0]), Число(Ч[0]));
	КонецЦикла;
	ЯчейкаКоличество(В, 4, Стр.ПланМесяца, Стр.Ед);
	Если Стр.ПланМесяца > 0 Тогда
		Процент = Стр.ЗаМесяц / Стр.ПланМесяца * 100;
		Отставание = Стр.ЗаМесяц < Стр.ПланКДате * 0.9;
		Ячейка(В, 5, Формат(Процент, "ЧДЦ=0; ЧН=0") + " %", Истина, ?(Процент >= 100, ЦветХорошо(), ?(Отставание, ЦветКрит(), Неопределено)));
		ЯчейкаКоличество(В, 6, Стр.ПланКДате, Стр.Ед);
		ЯчейкаКоличество(В, 7, Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц), Стр.Ед);
	Иначе
		Ячейка(В, 5, ?(Стр.Полуфабрикат, "п/ф", ?(Стр.ПланСледующего > 0, "план с " + МесяцСледующий, "вне плана")), , ЦветПриглушенный());
	КонецЕсли;
	ВПраво(В, 5, 5);
	ЯчейкаКоличество(В, 8, Стр.ПланСледующего, Стр.Ед);
	РасшифровкаСтроки(В, Стр.Номенклатура, 8);
	ЛинияСнизу(В, 1, 8);
	СледующаяСтрока(В);
	Если НЕ ПустаяСтрока(Стр.Смены) Тогда
		Ячейка(В, 1, "         " + Стр.Смены, , ЦветПриглушенный(), , 8, 8, Истина);
		ПодогнатьВысоту(В, Стр.Смены, 150);
		СледующаяСтрока(В);
	КонецЕсли;

КонецПроцедуры

// Строка участка: продукция и отдельно полуфабрикаты («+ … п/ф»), план и % — по продукции.
&НаСервере
Процедура ВывестиИтогУчастка(В, Строки, Название)

	Фон = Новый Цвет(204, 228, 224);
	Итоги = Новый Структура("Ед, ОднаЕд, ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате, ОсталосьВыпустить, ПланСледующего, ФактПоПлану", "", Истина, 0, 0, 0, 0, 0, 0, 0);
	ИтогиПФ = Новый Структура("Ед, ОднаЕд, ЗаДень, ЗаМесяц, ПланМесяца, ПланКДате, ОсталосьВыпустить, ПланСледующего, ФактПоПлану", "", Истина, 0, 0, 0, 0, 0, 0, 0);
	Для Каждого Стр Из Строки Цикл
		ИтогиВида = ?(Стр.Полуфабрикат, ИтогиПФ, Итоги);
		Если ИтогиВида.Ед = "" Тогда
			ИтогиВида.Ед = Стр.Ед;
		ИначеЕсли Стр.Ед <> ИтогиВида.Ед Тогда
			ИтогиВида.ОднаЕд = Ложь;
		КонецЕсли;
		ИтогиВида.ЗаДень = ИтогиВида.ЗаДень + Стр.ЗаДень;
		ИтогиВида.ЗаМесяц = ИтогиВида.ЗаМесяц + Стр.ЗаМесяц;
		ИтогиВида.ПланМесяца = ИтогиВида.ПланМесяца + Стр.ПланМесяца;
		ИтогиВида.ПланКДате = ИтогиВида.ПланКДате + Стр.ПланКДате;
		ИтогиВида.ОсталосьВыпустить = ИтогиВида.ОсталосьВыпустить + Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц);
		ИтогиВида.ПланСледующего = ИтогиВида.ПланСледующего + Стр.ПланСледующего;
		Если Стр.ПланМесяца > 0 Тогда
			ИтогиВида.ФактПоПлану = ИтогиВида.ФактПоПлану + Стр.ЗаМесяц;
		КонецЕсли;
	КонецЦикла;
	Ячейка(В, 1, Название + " (" + Строки.Количество() + ")", Истина, ЦветАкцент(), Фон, 10, , Истина);
	Для Каждого Описание Из СтрРазделить("ЗаДень:2,ЗаМесяц:3,ПланМесяца:4,ПланКДате:6,ОсталосьВыпустить:7,ПланСледующего:8", ",") Цикл
		Ч = СтрРазделить(Описание, ":");
		Колонка = Число(Ч[1]);
		Текст = ТекстИтогаВыпуска(Итоги, Ч[0]);
		Если ИтогиПФ[Ч[0]] <> 0 Тогда
			Текст = ?(Текст = "—", "", Текст + " + ") + ТекстИтогаВыпуска(ИтогиПФ, Ч[0]) + " п/ф";
		КонецЕсли;
		Ячейка(В, Колонка, Текст, Истина, , Фон, , , Истина);
		ВПраво(В, Колонка, Колонка);
	КонецЦикла;
	Процент = ?(НЕ Итоги.ОднаЕд ИЛИ Итоги.ПланМесяца = 0, "", Формат(Итоги.ФактПоПлану / Итоги.ПланМесяца * 100, "ЧДЦ=0; ЧН=0") + " %");
	Если ИтогиПФ.ОднаЕд И ИтогиПФ.ПланМесяца > 0 Тогда
		Процент = Процент + ?(Процент = "", "", Символы.ПС) + Формат(ИтогиПФ.ФактПоПлану / ИтогиПФ.ПланМесяца * 100, "ЧДЦ=0; ЧН=0") + " % п/ф";
	КонецЕсли;
	Ячейка(В, 5, Процент, Истина, , Фон, , , Истина);
	ВПраво(В, 5, 5);
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 30;
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Функция ТекстИтогаВыпуска(Итоги, Поле)

	Если НЕ Итоги.ОднаЕд Тогда
		Возврат "разные ед.";
	КонецЕсли;
	Возврат ?(Итоги[Поле] = 0, "—", ФорматЧисла(Итоги[Поле]) + ?(ПустаяСтрока(Итоги.Ед), "", " " + Итоги.Ед));

КонецФункции

// Все документы «План производства» на этот и следующий месяц — чтобы сверить, какие взяты в отчёт.
&НаСервере
Процедура ВывестиДокументыПлана(В, П, Вып)

	Мета = Метаданные.Документы.Найти("ПланПроизводства");
	Если Мета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СледующаяСтрока(В);
	Подзаголовок(В, "Документы «План производства» на " + ИмяМесяца(Месяц(П.День), Ложь) + " и " + Вып.ИмяСледующего);
	Шапка(В, "Документ", "Дата", "Период", "Статус", "Организация / подразделение", "Строк", "Количество", "В отчёте");
	ДатаШапки = ?(Мета.Реквизиты.Найти("НачалоПериода") <> Неопределено, "Д.НачалоПериода", "Д.Дата");
	ЕстьОкончание = Мета.Реквизиты.Найти("ОкончаниеПериода") <> Неопределено;
	ЕстьПродукция = Мета.ТабличныеЧасти.Найти("Продукция") <> Неопределено;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка КАК Документ, Д.Дата КАК Дата, Д.Проведен КАК Проведен, " + ДатаШапки + " КАК НачалоПериода, "
		+ ?(ЕстьОкончание, "Д.ОкончаниеПериода", "НЕОПРЕДЕЛЕНО") + " КАК ОкончаниеПериода, "
		+ ?(Мета.Реквизиты.Найти("Статус") <> Неопределено, "Д.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус, "
		+ ?(Мета.Реквизиты.Найти("Организация") <> Неопределено, "Д.Организация", "НЕОПРЕДЕЛЕНО") + " КАК Организация, "
		+ ?(Мета.Реквизиты.Найти("Подразделение") <> Неопределено, "Д.Подразделение", "НЕОПРЕДЕЛЕНО") + " КАК Подразделение
		|ИЗ Документ.ПланПроизводства КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И " + ДатаШапки + " <= &Кон И " + ?(ЕстьОкончание, "Д.ОкончаниеПериода", ДатаШапки) + " >= &Нач
		|УПОРЯДОЧИТЬ ПО Д.Дата");
	Запрос.УстановитьПараметр("Нач", П.НачалоМесяца);
	Запрос.УстановитьПараметр("Кон", КонецМесяца(Вып.НачалоСледующего));
	ДокументыПлана = Запрос.Выполнить().Выгрузить();
	Если ДокументыПлана.Количество() = 0 Тогда
		Примечание(В, "Документов нет.");
		Возврат;
	КонецЕсли;
	Итоги = Новый Соответствие;
	Если ЕстьПродукция Тогда
		ЗапросСтрок = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Документ, КОЛИЧЕСТВО(*) КАК Строк, СУММА(Т.Количество) КАК Количество
			|ИЗ Документ.ПланПроизводства.Продукция КАК Т ГДЕ Т.Ссылка В (&Документы) СГРУППИРОВАТЬ ПО Т.Ссылка");
		ЗапросСтрок.УстановитьПараметр("Документы", ДокументыПлана.ВыгрузитьКолонку("Документ"));
		Выборка = ЗапросСтрок.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Итоги.Вставить(Выборка.Документ, Новый Структура("Строк, Количество", Выборка.Строк, Выборка.Количество));
		КонецЦикла;
	КонецЕсли;
	Для Каждого Стр Из ДокументыПлана Цикл
		Итог = Итоги[Стр.Документ];
		Взят = Вып.ДокументыМесяца.Найти(Стр.Документ) <> Неопределено ИЛИ Вып.ДокументыСледующего.Найти(Стр.Документ) <> Неопределено;
		Ячейка(В, 1, "№ " + СокрЛП(Стр.Документ.Номер));
		Ячейка(В, 2, Формат(Стр.Дата, "ДФ='dd.MM.yy HH:mm'"));
		Ячейка(В, 3, Формат(Стр.НачалоПериода, "ДФ=dd.MM") + ?(ЗначениеЗаполнено(Стр.ОкончаниеПериода), "–" + Формат(Стр.ОкончаниеПериода, "ДФ=dd.MM"), ""));
		Ячейка(В, 4, Строка(Стр.Статус) + ?(Стр.Проведен, "", " (не проведён)"), , , , 9, , Истина);
		Ячейка(В, 5, СокрЛП(Строка(Стр.Организация) + " " + Строка(Стр.Подразделение)), , ЦветПриглушенный(), , 8, , Истина);
		Ячейка(В, 6, ?(Итог = Неопределено, "—", Формат(Итог.Строк, "ЧГ=0")));
		ВПраво(В, 6, 6);
		Ячейка(В, 7, ?(Итог = Неопределено, "—", ФорматЧисла(ЧислоИлиНоль(Итог.Количество))));
		ВПраво(В, 7, 7);
		Ячейка(В, 8, ?(Взят, "взят", "нет"), Взят, ?(Взят, ЦветХорошо(), ЦветПриглушенный()));
		РасшифровкаСтроки(В, Стр.Документ, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	Примечание(В, "«Взят» — из документа взята хотя бы одна позиция: по каждой позиции берётся последний по дате документ на период, где она есть. "
		+ "Двойной щелчок открывает документ. Если в отчёте не та цифра — сравните с документом и напишите, какой документ должен браться.");

КонецПроцедуры

&НаСервере
Процедура СтрокаПлана(В, Название, План, Факт)

	Процент = ?(План = 0, 0, Факт / План * 100);
	Ячейка(В, 1, Название);
	ЯчейкаЧисло(В, 2, План);
	ЯчейкаЧисло(В, 3, Факт);
	Ячейка(В, 4, Формат(Процент, "ЧДЦ=0; ЧН=0") + " %", Истина, ?(Процент >= 100, ЦветХорошо(), ?(Процент >= 90, ЦветВнимание(), ЦветКрит())));
	ВПраво(В, 4, 4);
	ЛинияСнизу(В, 1, 4);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ВывестиСырье(В, Р, П)

	ЗаголовокРаздела(В, "Сырьё и нехватка");
	Если ПоказатьОшибку(В, Р, "Сырье") Тогда
		Возврат;
	КонецЕсли;
	С = Р.Сырье;
	Если С.Материалы.Количество() = 0 Тогда
		Примечание(В, "Не найдено сырья: за 30 дней ничего не списывалось в производство. Укажите группу сырья в настройках отчёта.");
		Возврат;
	КонецЕсли;
	ВсегоРасход = 0;
	Для Каждого Стр Из С.Материалы Цикл
		ВсегоРасход = ВсегоРасход + Стр.ВСутки;
	КонецЦикла;
	Если ВсегоРасход = 0 Тогда
		Примечание(В, "За 30 дней в суточных рапортах (" + СтрСоединить(С.Документы, ", ") + ") не списывалось сырьё со статьями калькуляции «"
			+ П.СтатьиСырья + "». Проверьте настройку «Статьи калькуляции основного сырья».");
		Возврат;
	КонецЕсли;
	Шапка(В, "Материал", "Остаток", "Расход в сутки", "Хватит, дней", "В пути", "Поставка", "Статус", "Заказать");
	Для Каждого Гр Из ГруппыНоменклатуры(С.Материалы, "Номенклатура") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Остаток:к,3:ВСутки:к,5:ВПути:к", 8);
	Для Каждого Стр Из Гр.Позиции Цикл
		Уровень = ?(Стр.Статус = "нехватка", 0, ?(Стр.Статус = "заказать", 1, 3));
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура) + ?(ЗначениеЗаполнено(Стр.Пояснение), Символы.ПС + "      " + Стр.Пояснение, ""));
		ЯчейкаКоличество(В, 2, Стр.Остаток, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ВСутки, Стр.Ед);
		Ячейка(В, 4, ?(Стр.ВСутки <= 0, "—", Формат(Стр.ХватитДней, "ЧДЦ=1; ЧН=0")
			+ ?(Стр.ВПути > 0, " (" + Формат(Стр.ХватитСПоставкой, "ЧДЦ=1; ЧН=0") + ")", "")));
		ВПраво(В, 4, 4);
		ЯчейкаКоличество(В, 5, Стр.ВПути, Стр.Ед);
		Ячейка(В, 6, ?(ЗначениеЗаполнено(Стр.ДатаПоставки), Формат(Стр.ДатаПоставки, "ДФ=dd.MM"), "—"));
		ВПраво(В, 6, 6);
		Ячейка(В, 7, Стр.Статус, Истина, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())),
			?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())));
		Цена = ?(Р.Закупки = Неопределено, 0, ЧислоИлиНоль(Р.Закупки.Цены[Стр.Номенклатура]));
		Если Стр.Заказать > 0 И Цена > 0 Тогда
			Ячейка(В, 8, ФорматЧисла(Стр.Заказать) + " " + Стр.Ед + Символы.ПС + "≈ " + ДеньгиКратко(Стр.Заказать * Цена), , , , 9, , Истина);
			ВПраво(В, 8, 8);
		Иначе
			ЯчейкаКоличество(В, 8, Стр.Заказать, Стр.Ед);
		КонецЕсли;
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = ?(ЗначениеЗаполнено(Стр.Пояснение), 26, 14);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Примечание(В, СтрШаблон("Расход — среднее списание в производство за 30 дней по суточным рапортам. «Хватит» в скобках — вместе с поставкой в пути (заказы поставщикам). "
		+ "Нехватка — кончится раньше поставки или запаса меньше срока поставки (%1 дн.). «Заказать» — на срок поставки плюс %2 дн.", П.СрокПоставки, П.Горизонт));

КонецПроцедуры

#КонецОбласти

#Область ВыводАналитики

&НаСервере
Процедура ВывестиПродажи(В, Р, П)

	ЗаголовокРаздела(В, "Продажи и маржа");
	Если ПоказатьОшибку(В, Р, "Продажи") Тогда
		Возврат;
	КонецЕсли;
	Пр = Р.Продажи;
	НомерМесяца = Месяц(П.НачалоПрошлогоМесяца);
	Если Пр.Месяц = 0 И Пр.ПрошлыйМесяц = 0 Тогда
		Примечание(В, "Продаж за два месяца не найдено (" + Пр.Источник + "). Проверьте организацию в настройках или пришлите файл диагностики.");
		Возврат;
	КонецЕсли;

	Шапка(В, "Выручка без НДС", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "То же в прошлом мес.", "Изменение", "Весь " + ИмяМесяца(НомерМесяца, Ложь));
	Ячейка(В, 1, "Отгрузки покупателям");
	ЯчейкаЧисло(В, 2, Пр.ЗаДень);
	ЯчейкаЧисло(В, 3, Пр.Месяц, , Истина);
	ЯчейкаЧисло(В, 4, Пр.ПрошлыйПериод);
	ЯчейкаПроцента(В, 5, Пр.Изменение);
	ЯчейкаЧисло(В, 6, Пр.ПрошлыйМесяц);
	ЛинияСнизу(В, 1, 6);
	СледующаяСтрока(В);
	Примечание(В, "Источник: " + Пр.Источник + ". «То же в прошлом месяце» — с 1-го по " + Формат(П.КонецПрошлогоПериода, "ДФ='d MMMM'") + ": сравнение равных отрезков.");

	СледующаяСтрока(В);
	Подзаголовок(В, "По группам номенклатуры с начала месяца");
	Шапка(В, "Группа / номенклатура", "Количество", "Выручка", "Доля", "Средняя цена", "Цена в " + ИмяМесяца(НомерМесяца, Истина), "Изм. цены", "Выручка за то же в прошл.");
	Группы = ГруппыПродаж(Пр.ПоНоменклатуре);
	Для Каждого Гр Из Группы Цикл
		Фон = Новый Цвет(226, 240, 238);
		Ячейка(В, 1, Строка(Гр.Группа) + " (" + Гр.Позиции.Количество() + ")", Истина, ЦветАкцент(), Фон, , , Истина);
		Если ЗначениеЗаполнено(Гр.Ед) Тогда
			Ячейка(В, 2, ФорматЧисла(Гр.Количество) + " " + Гр.Ед, Истина, , Фон);
		Иначе
			Ячейка(В, 2, "разные ед.", , ЦветПриглушенный(), Фон);
		КонецЕсли;
		ВПраво(В, 2, 2);
		ЯчейкаЧисло(В, 3, Гр.Сумма, , Истина, Фон);
		Ячейка(В, 4, ?(Пр.Месяц = 0, "—", Формат(Гр.Сумма / Пр.Месяц * 100, "ЧДЦ=1; ЧН=0") + " %"), Истина, , Фон);
		ВПраво(В, 4, 4);
		Ячейка(В, 5, ?(Гр.Цена = 0, "", ФорматДенег(Гр.Цена)), Истина, , Фон);
		ВПраво(В, 5, 5);
		Ячейка(В, 6, ?(Гр.ЦенаПрошлМесяц = 0, "", ФорматДенег(Гр.ЦенаПрошлМесяц)), , , Фон);
		ВПраво(В, 6, 6);
		Если Гр.ИзмЦены = Неопределено Тогда
			Ячейка(В, 7, "", , , Фон);
		Иначе
			Ячейка(В, 7, ?(Гр.ИзмЦены > 0, "+", "") + Формат(Гр.ИзмЦены, "ЧДЦ=1; ЧН=0") + " %", Истина, ?(Гр.ИзмЦены > 0, ЦветХорошо(), ?(Гр.ИзмЦены < 0, ЦветКрит(), Неопределено)), Фон);
		КонецЕсли;
		ВПраво(В, 7, 7);
		ЯчейкаЧисло(В, 8, Гр.СуммаПрошл, , Истина, Фон);
		РасшифровкаСтроки(В, Гр.Группа, 8);
		СледующаяСтрока(В);
		Номер = 0;
		Для Каждого Стр Из Гр.Позиции Цикл
			Номер = Номер + 1;
			Если Номер > 15 Тогда
				Ячейка(В, 1, "      …и ещё " + (Гр.Позиции.Количество() - 15) + " поз. на " + ДеньгиКратко(Гр.СуммаОстальных), , ЦветПриглушенный(), , 8, 8);
				СледующаяСтрока(В);
				Прервать;
			КонецЕсли;
			Ячейка(В, 1, "      " + Строка(Стр.Ключ), , , , 8, , Истина);
			ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
			ЯчейкаЧисло(В, 3, Стр.Сумма);
			ЯчейкаПроцента(В, 4, ?(Пр.Месяц = 0, Неопределено, Стр.Сумма / Пр.Месяц * 100), Ложь);
			ЯчейкаЧисло(В, 5, Стр.Цена);
			ЯчейкаЧисло(В, 6, Стр.ЦенаПрошлМесяц);
			ЯчейкаПроцента(В, 7, Стр.ИзмЦены);
			ЯчейкаЧисло(В, 8, Стр.СуммаПрошл);
			РасшифровкаСтроки(В, Стр.Ключ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Итого", , Пр.Месяц);
	Примечание(В, "Группа — папка справочника «Номенклатура», в которой лежит позиция (если папки нет — вид номенклатуры). "
		+ "Двойной щелчок по строке группы открывает папку, по позиции — карточку номенклатуры. Количество группы показано, если у всех позиций одна единица.");

	СледующаяСтрока(В);
	Подзаголовок(В, "Крупнейшие покупатели с начала месяца");
	Шапка(В, "Покупатель", "Выручка", "Доля", "То же в прошл. мес.", "Изменение");
	Номер = 0;
	Для Каждого Стр Из Пр.ПоКонтрагентам Цикл
		Номер = Номер + 1;
		Если Номер > 10 ИЛИ Стр.Сумма = 0 Тогда
			Прервать;
		КонецЕсли;
		Ячейка(В, 1, Строка(Стр.Ключ), , , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Сумма);
		ЯчейкаПроцента(В, 3, ?(Пр.Месяц = 0, Неопределено, Стр.Сумма / Пр.Месяц * 100), Ложь);
		ЯчейкаЧисло(В, 4, Стр.СуммаПрошл);
		ЯчейкаПроцента(В, 5, ?(Стр.СуммаПрошл = 0, Неопределено, (Стр.Сумма / Стр.СуммаПрошл - 1) * 100));
		РасшифровкаСтроки(В, Стр.Ключ, 5);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;
	Пропавшие = Новый Массив;
	Для Каждого Стр Из Пр.ПоКонтрагентам Цикл
		Если Стр.Сумма = 0 И Стр.СуммаПрошлМесяц >= 500000 И Пропавшие.Количество() < 8 Тогда
			Пропавшие.Добавить(Строка(Стр.Ключ) + " (" + ДеньгиКратко(Стр.СуммаПрошлМесяц) + ")");
		КонецЕсли;
	КонецЦикла;
	Если Пропавшие.Количество() > 0 Тогда
		Примечание(В, "В прошлом месяце покупали, в этом ещё нет: " + СтрСоединить(Пропавшие, ", ") + ".");
	КонецЕсли;

	// прибыль по прямым затратам
	СледующаяСтрока(В);
	Если Р.Маржа = Неопределено Тогда
		Примечание(В, "Прибыль по прямым затратам не посчитана: " + ?(Р.Ошибки["Маржа"] = Неопределено, "нет данных", Р.Ошибки["Маржа"]));
		Возврат;
	КонецЕсли;
	Если Р.Маржа.СебестоимостьПрошлого = 0 Тогда
		Примечание(В, "Прибыль по прямым затратам не показана: себестоимость продаж за " + ИмяМесяца(НомерМесяца, Ложь)
			+ " в ERP не рассчитана. Она появится после закрытия месяца (Финансовый результат и контроллинг → Закрытие месяца).");
		Возврат;
	КонецЕсли;
	ВывестиМаржу(В, Р.Маржа.Прошлый, "Прибыль по прямым затратам за " + ИмяМесяца(НомерМесяца, Ложь));
	Если Р.Маржа.СебестоимостьТекущего > 0 Тогда
		СледующаяСтрока(В);
		ВывестиМаржу(В, Р.Маржа.Текущий, "Прибыль по прямым затратам с начала месяца");
	Иначе
		Примечание(В, "Себестоимость текущего месяца ERP рассчитывает при закрытии месяца, поэтому прибыль показана за прошлый месяц.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиМаржу(В, Т, Название)

	Подзаголовок(В, Название);
	Если Т.Количество() = 0 Тогда
		Примечание(В, "Нет данных о выручке и себестоимости за этот период.");
		Возврат;
	КонецЕсли;
	Шапка(В, "Номенклатура", "Выручка без НДС", "Прямые затраты", "Прибыль по прямым", "Рентабельность");
	Для Каждого Гр Из ГруппыНоменклатуры(Т, "Номенклатура", "Выручка") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Выручка:ч,3:Прямые:ч,4:Прибыль:ч", 5);
	ВыручкаГруппы = 0;
	ПрибыльГруппы = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		ВыручкаГруппы = ВыручкаГруппы + ЧислоИлиНоль(Стр.Выручка);
		ПрибыльГруппы = ПрибыльГруппы + ЧислоИлиНоль(Стр.Прибыль);
	КонецЦикла;
	В.Строка = В.Строка - 1;
	Ячейка(В, 5, ?(ВыручкаГруппы = 0, "—", Формат(ПрибыльГруппы / ВыручкаГруппы * 100, "ЧДЦ=1; ЧН=0") + " %"), Истина, , Новый Цвет(226, 240, 238));
	ВПраво(В, 5, 5);
	В.Строка = В.Строка + 1;
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		Уровень = ?(Стр.Рентабельность = Неопределено, -1, ?(Стр.Рентабельность < 0, 0, ?(Стр.Рентабельность < 10, 1, -1)));
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаЧисло(В, 2, Стр.Выручка);
		ЯчейкаЧисло(В, 3, Стр.Прямые);
		ЯчейкаЧисло(В, 4, Стр.Прибыль, ?(Стр.Прибыль < 0, ЦветКрит(), Неопределено));
		ЯчейкаПроцента(В, 5, Стр.Рентабельность, Ложь, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), Неопределено)));
		РасшифровкаСтроки(В, Стр.Номенклатура, 5);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Выручка = Т.Итог("Выручка");
	Прибыль = Т.Итог("Прибыль");
	СтрокаИтога(В, "Итого", Выручка, Т.Итог("Прямые"), Прибыль);
	В.Строка = В.Строка - 1;
	Ячейка(В, 5, ?(Выручка = 0, "—", Формат(Прибыль / Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"), Истина, , ЦветФонаШапки());
	ВПраво(В, 5, 5);
	В.Строка = В.Строка + 1;
	Косвенные = Т.Итог("Косвенные");
	Примечание(В, "Прямые затраты — материалы, доп. расходы, трудозатраты и переменные статьи затрат, вошедшие в себестоимость проданного. "
		+ "Косвенные (постоянные статьи, распределённые на продукцию) сюда не входят: за период " + ДеньгиКратко(Косвенные)
		+ "; прибыль после них " + ДеньгиКратко(Прибыль - Косвенные) + ".");

КонецПроцедуры

&НаСервере
Процедура ВывестиЗакупки(В, Р, П)

	ЗаголовокРаздела(В, "Закупки и цены сырья");
	Если ПоказатьОшибку(В, Р, "Закупки") Тогда
		Возврат;
	КонецЕсли;
	З = Р.Закупки;
	НомерМесяца = Месяц(П.НачалоПрошлогоМесяца);
	Шапка(В, "Поступления без НДС", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "То же в прошлом мес.", "Изменение", "Весь " + ИмяМесяца(НомерМесяца, Ложь));
	Ячейка(В, 1, "Закуплено у поставщиков");
	ЯчейкаЧисло(В, 2, З.ЗаДень);
	ЯчейкаЧисло(В, 3, З.Месяц, , Истина);
	ЯчейкаЧисло(В, 4, З.ПрошлыйПериод);
	ЯчейкаПроцента(В, 5, З.Изменение);
	ЯчейкаЧисло(В, 6, З.ПрошлыйМесяц);
	ЛинияСнизу(В, 1, 6);
	СледующаяСтрока(В);

	СледующаяСтрока(В);
	Подзаголовок(В, ?(З.Свойство("ТолькоОсновное"), "Основное сырьё", "Закупки") + ": что и почём покупаем (с начала месяца и в прошлом месяце)");
	Шапка(В, "Номенклатура", "Количество", "Сумма", "Средняя цена", "Цена в " + ИмяМесяца(НомерМесяца, Истина), "Изм. цены", "Кол-во в " + ИмяМесяца(НомерМесяца, Истина));
	Для Каждого Гр Из ГруппыНоменклатуры(З.ПоНоменклатуре, "Ключ", "Сумма") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Количество:к,3:Сумма:ч,7:КоличествоПрошлМесяц:к", 7);
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		Рост = Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены >= 5;
		ЯчейкаПозиции(В, Строка(Стр.Ключ));
		ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
		ЯчейкаЧисло(В, 3, Стр.Сумма);
		ЯчейкаЧисло(В, 4, Стр.Цена);
		ЯчейкаЧисло(В, 5, Стр.ЦенаПрошлМесяц);
		ЯчейкаПроцента(В, 6, Стр.ИзмЦены, Истина, ?(Рост, ЦветКрит(), ?(Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены <= -5, ЦветХорошо(), Неопределено)), Ложь);
		ЯчейкаКоличество(В, 7, Стр.КоличествоПрошлМесяц, Стр.Ед);
		РасшифровкаСтроки(В, Стр.Ключ, 7);
		ЛинияСнизу(В, 1, 7);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Примечание(В, "Изменение цены — средняя цена этого месяца к средней цене прошлого. Красным — подорожание от 5 %, зелёным — подешевление от 5 %.");

	СледующаяСтрока(В);
	Подзаголовок(В, "Крупнейшие поставщики с начала месяца");
	Шапка(В, "Поставщик", "Сумма", "Доля", "То же в прошл. мес.", "Изменение");
	Номер = 0;
	Для Каждого Стр Из З.ПоКонтрагентам Цикл
		Номер = Номер + 1;
		Если Номер > 10 ИЛИ Стр.Сумма = 0 Тогда
			Прервать;
		КонецЕсли;
		Ячейка(В, 1, Строка(Стр.Ключ), , , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Сумма);
		ЯчейкаПроцента(В, 3, ?(З.Месяц = 0, Неопределено, Стр.Сумма / З.Месяц * 100), Ложь);
		ЯчейкаЧисло(В, 4, Стр.СуммаПрошл);
		ЯчейкаПроцента(В, 5, ?(Стр.СуммаПрошл = 0, Неопределено, (Стр.Сумма / Стр.СуммаПрошл - 1) * 100));
		РасшифровкаСтроки(В, Стр.Ключ, 5);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиЗапасы(В, Р, П)

	ЗаголовокРаздела(В, "Остатки готовой продукции и сколько осталось отгрузить");
	Если ПоказатьОшибку(В, Р, "Запасы") Тогда
		Возврат;
	КонецЕсли;
	Зп = Р.Запасы;
	Шапка(В, "Продукт", "Остаток на складах", "Стоимость по цене продажи", "Осталось отгрузить по заказам", "Не хватает под заказы",
		"Отгрузки в сутки", "Дней запаса", "Статус");
	Для Каждого Гр Из ГруппыНоменклатуры(Зп.Таблица, "Номенклатура", "Стоимость") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Остаток:к,3:Стоимость:ч,4:ВЗаказах:к,5:НеХватает:к,6:ОтгрузкиВСутки:к", 8);
	Для Каждого Стр Из Гр.Позиции Цикл
		Уровень = ?(Стр.Статус = "мало", 0, ?(Стр.Статус = "в норме", 3, 1));
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаКоличество(В, 2, Стр.Остаток, Стр.Ед);
		ЯчейкаЧисло(В, 3, Стр.Стоимость);
		ЯчейкаКоличество(В, 4, Стр.ВЗаказах, Стр.Ед);
		Если Стр.НеХватает > 0 Тогда
			Ячейка(В, 5, ФорматЧисла(Стр.НеХватает) + " " + Стр.Ед, Истина, ЦветКрит(), ФонКрит());
			ВПраво(В, 5, 5);
		КонецЕсли;
		ЯчейкаКоличество(В, 6, Стр.ОтгрузкиВСутки, Стр.Ед);
		Ячейка(В, 7, ?(Стр.ОтгрузкиВСутки = 0, "—", Формат(Стр.ДнейЗапаса, "ЧДЦ=1; ЧН=0")));
		ВПраво(В, 7, 7);
		Ячейка(В, 8, Стр.Статус, Истина, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())),
			?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())));
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Всего готовой продукции", , Зп.Всего);
	Примечание(В, "Все позиции готовой продукции: что выпускали или продавали за 2 месяца и что есть в открытых заказах клиентов. "
		+ "«Осталось отгрузить» — неотгруженный остаток открытых заказов; «не хватает» — заказы минус остаток на складах. "
		+ "Отгрузки в сутки — среднее за 30 дней (источник — как в разделе «Продажи»). «Мало» — запаса меньше чем на 3 дня и заказов больше остатка; "
		+ "«затоваривание» — запаса больше чем на 45 дней.");

КонецПроцедуры

&НаСервере
Процедура ЯчейкаПроцента(В, Колонка, Значение, СоЗнаком = Истина, ЦвТекста = Неопределено, Раскрашивать = Истина)

	Если Значение = Неопределено Тогда
		Ячейка(В, Колонка, "—", , ЦветПриглушенный());
	Иначе
		Цвет = ЦвТекста;
		Если Цвет = Неопределено И СоЗнаком И Раскрашивать Тогда
			Цвет = ?(Значение > 0, ЦветХорошо(), ?(Значение < 0, ЦветКрит(), Неопределено));
		КонецЕсли;
		Ячейка(В, Колонка, ?(СоЗнаком И Значение > 0, "+", "") + Формат(Значение, "ЧДЦ=1; ЧН=0") + " %", , Цвет);
	КонецЕсли;
	ВПраво(В, Колонка, Колонка);

КонецПроцедуры

&НаСервере
Функция ИмяМесяца(НомерМесяца, Предложный)

	Если Предложный Тогда
		Имена = СтрРазделить("январе,феврале,марте,апреле,мае,июне,июле,августе,сентябре,октябре,ноябре,декабре", ",");
	Иначе
		Имена = СтрРазделить("январь,февраль,март,апрель,май,июнь,июль,август,сентябрь,октябрь,ноябрь,декабрь", ",");
	КонецЕсли;
	Возврат Имена[НомерМесяца - 1];

КонецФункции

&НаСервере
Процедура ВывестиПотребность(В, Р, П)

	ЗаголовокРаздела(В, "Основное сырьё на план производства");
	Если ПоказатьОшибку(В, Р, "Потребность") Тогда
		Возврат;
	КонецЕсли;
	Пт = Р.Потребность;
	Примечание(В, ?(Пт.ЕстьПлан, "Этот месяц — остаток документов «План производства» (план минус уже выпущенное).",
		"Этот месяц — документов «План производства» нет, оценка по выпуску последних 30 дней на оставшиеся дни.")
		+ ?(Пт.ЕстьПланСледующего, " Следующий месяц — по его плану производства.", " Следующий месяц — плана нет, оценка по выпуску 30 дней.")
		+ " Если заказов клиентов со сроком в этом (следующем) месяце к выпуску больше, чем по плану, берутся заказы."
		+ " Нормы — из ресурсных спецификаций (та, что указана в плане, иначе последняя из суточных рапортов); количества пересчитаны в базовые единицы, полуфабрикаты разложены до сырья."
		+ " Сырьё — статьи калькуляции «" + П.СтатьиСырья + "».");

	Если Пт.Таблица.Количество() = 0 Тогда
		Примечание(В, "Потребность не посчитана: для продукции плана не нашлось спецификаций с основным сырьём.");
	Иначе
		Шапка(В, "Сырьё", "На остаток плана месяца", "На план след. месяца", "Остаток на складах", "В пути", "Не хватит в этом месяце", "Не хватит на 2 месяца", "Докупить на сумму");
		Для Каждого Гр Из ГруппыНоменклатуры(Пт.Таблица, "Номенклатура", "СуммаДокупки") Цикл
		ВывестиСтрокуГруппы(В, Гр, "2:ОстатокПлана:к,3:ПланСледующего:к,4:Остаток:к,5:ВПути:к,8:СуммаДокупки:ч", 8);
		Для Каждого Стр Из Гр.Позиции Цикл
			ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
			ЯчейкаКоличество(В, 2, Стр.ОстатокПлана, Стр.Ед);
			ЯчейкаКоличество(В, 3, Стр.ПланСледующего, Стр.Ед);
			ЯчейкаКоличество(В, 4, Стр.Остаток, Стр.Ед);
			ЯчейкаКоличество(В, 5, Стр.ВПути, Стр.Ед);
			Если Стр.НехваткаМесяц > 0 Тогда
				Ячейка(В, 6, ФорматЧисла(Стр.НехваткаМесяц) + " " + Стр.Ед, Истина, ЦветКрит(), ФонКрит());
			Иначе
				Ячейка(В, 6, "хватает", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 6, 6);
			Если Стр.НехваткаДвухМесяцев > 0 Тогда
				Ячейка(В, 7, ФорматЧисла(Стр.НехваткаДвухМесяцев) + " " + Стр.Ед, Истина, ЦветВнимание(), ФонВнимание());
			Иначе
				Ячейка(В, 7, "хватает", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 7, 7);
			Если Стр.СуммаДокупки > 0 Тогда
				ЯчейкаЧисло(В, 8, Стр.СуммаДокупки, , Истина);
			ИначеЕсли Стр.НехваткаДвухМесяцев > 0 Тогда
				Ячейка(В, 8, "нет цены", , ЦветПриглушенный());
				ВПраво(В, 8, 8);
			КонецЕсли;
			РасшифровкаСтроки(В, Стр.Номенклатура, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
		СтрокаИтога(В, "Докупить сырья на 2 месяца", , , , );
		В.Строка = В.Строка - 1;
		Для К = 2 По 7 Цикл
			Ячейка(В, К, "", , , ЦветФонаШапки());
		КонецЦикла;
		ЯчейкаЧисло(В, 8, Пт.СуммаДокупки, , Истина, ЦветФонаШапки());
		В.Строка = В.Строка + 1;
		Примечание(В, "«В пути» — все незакрытые заказы поставщикам; на этот месяц засчитаны поставки с датой поступления до конца месяца, на 2 месяца — до конца следующего. "
			+ "Сумма — по последней цене закупки без НДС.");
	КонецЕсли;
	Если Пт.НеРазложены.Количество() > 0 Тогда
		Примечание(В, "Не посчитано сырьё полуфабрикатов без спецификации: " + Лев(СтрСоединить(Пт.НеРазложены, ", "), 400)
			+ ". Заведите на них ресурсные спецификации — иначе потребность занижена.");
	КонецЕсли;
	Если Пт.УбраноПолуфабрикатов.Количество() > 0 Тогда
		Примечание(В, "Не считались отдельно (уже входят в спецификации другой продукции): " + Лев(СтрСоединить(Пт.УбраноПолуфабрикатов, ", "), 400) + ".");
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Продукция плана: на что считается сырьё");
	Шапка(В, "Продукт", "Выпустить в этом месяце", "Выпустить в след. месяце", "Из них по заказам (этот / след.)", "Спецификация");
	Для Каждого Гр Из ГруппыНоменклатуры(Пт.План, "Номенклатура", "ОстатокПлана") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:ОстатокПлана:к,3:ПланСледующего:к", 8);
	Для Каждого Стр Из Гр.Позиции Цикл
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаКоличество(В, 2, Стр.ОстатокПлана, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ПланСледующего, Стр.Ед);
		Если Стр.НаЗаказы + Стр.ЗаказыСледующего > 0 Тогда
			Ячейка(В, 4, ФорматЧисла(Стр.НаЗаказы) + " / " + ФорматЧисла(Стр.ЗаказыСледующего) + " " + Стр.Ед, , ЦветПриглушенный());
			ВПраво(В, 4, 4);
		КонецЕсли;
		Если Стр.Нормы = Неопределено Тогда
			Ячейка(В, 5, Стр.ИсточникНорм, , ЦветКрит(), , 9, 8);
		Иначе
			Ячейка(В, 5, Строка(Стр.Спецификация), , ЦветПриглушенный(), , 9, 8);
		КонецЕсли;
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;

	Если Пт.Затраты.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Основное сырьё в себестоимости продукта (нормы спецификации × последние цены закупки)");
		Шапка(В, "Продукт", "Сырьё на 1 ед.", "Цена продажи", "Доля сырья", "После сырья", "Главное сырьё в стоимости");
		Для Каждого Гр Из ГруппыНоменклатуры(Пт.Затраты, "Номенклатура") Цикл
		ВывестиСтрокуГруппы(В, Гр, "", 8);
		Для Каждого Стр Из Гр.Позиции Цикл
			Уровень = ?(Стр.Доля = Неопределено, -1, ?(Стр.Доля >= 90, 0, ?(Стр.Доля >= 70, 1, -1)));
			ЯчейкаПозиции(В, Строка(Стр.Номенклатура) + ?(ЗначениеЗаполнено(Стр.Ед), ", за 1 " + Стр.Ед, ""));
			ЯчейкаЧисло(В, 2, Стр.НаЕдиницу);
			ЯчейкаЧисло(В, 3, Стр.ЦенаПродажи);
			ЯчейкаПроцента(В, 4, Стр.Доля, Ложь, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), Неопределено)));
			Если Стр.ЦенаПродажи > 0 Тогда
				ЯчейкаЧисло(В, 5, Стр.ЦенаПродажи - Стр.НаЕдиницу, ?(Стр.ЦенаПродажи < Стр.НаЕдиницу, ЦветКрит(), Неопределено));
			КонецЕсли;
			Ячейка(В, 6, Строка(Стр.Главное) + ?(ЗначениеЗаполнено(Стр.БезЦены), "; нет цены закупки: " + Стр.БезЦены, ""), , ЦветПриглушенный(), , 9, 8, Истина);
			ПодогнатьВысоту(В, Строка(Стр.Главное) + Строка(Стр.БезЦены), 60);
			РасшифровкаСтроки(В, Стр.Номенклатура, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
		Примечание(В, "Цена продажи — средняя за месяц без НДС. «После сырья» — что остаётся с единицы на переработку, зарплату, энергию и прибыль. "
			+ "Это оценка по нормам спецификаций и последним ценам закупки — для сравнения с фактической себестоимостью после закрытия месяца.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиЦеныЗакупок(В, Р, П)

	ЗаголовокРаздела(В, "Закупочные цены за 12 месяцев");
	Если ПоказатьОшибку(В, Р, "ЗакупкиГод") Тогда
		Возврат;
	КонецЕсли;
	Зг = Р.ЗакупкиГод;
	Если Зг.Материалы.Количество() = 0 Тогда
		Примечание(В, ?(Зг.Свойство("ТолькоОсновное"), "За 12 месяцев закупок основного сырья нет.", "За 12 месяцев закупок не найдено."));
		Возврат;
	КонецЕсли;

	Подзаголовок(В, ?(Зг.Свойство("ТолькоОсновное"), "Основное сырьё: цены и их изменение за год", "Цены и их изменение за год (по сумме закупок)"));
	Шапка(В, "Материал", "Куплено за год", "Сумма за год", "Мин. цена", "Макс. цена", "Цена в начале", "Последняя цена", "Изменение");
	Для Каждого Гр Из ГруппыНоменклатуры(Зг.Материалы, "Номенклатура", "Сумма") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Количество:к,3:Сумма:ч", 8);
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
		ЯчейкаЧисло(В, 3, Стр.Сумма);
		ЯчейкаЧисло(В, 4, Стр.МинЦена);
		ЯчейкаЧисло(В, 5, Стр.МаксЦена);
		Ячейка(В, 6, ФорматДенег(Стр.ПерваяЦена) + Символы.ПС + Формат(Стр.ПервыйМесяц, "ДФ='MMM yy'"), , , , 9, , Истина);
		ВПраво(В, 6, 6);
		Ячейка(В, 7, ФорматДенег(Стр.ПоследняяЦена) + Символы.ПС + Формат(Стр.ПоследнийМесяц, "ДФ='MMM yy'"), Истина, , , 9, , Истина);
		ВПраво(В, 7, 7);
		ЯчейкаПроцента(В, 8, Стр.ИзмГод, Истина, ?(Стр.ИзмГод = Неопределено, Неопределено, ?(Стр.ИзмГод > 0, ЦветКрит(), ЦветХорошо())));
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Если Зг.Свойство("ТолькоОсновное") Тогда
		СтрокаИтога(В, "Итого по основному сырью", , Зг.Материалы.Итог("Сумма"));
		Примечание(В, "Всего закуплено за 12 месяцев (всё, включая услуги и прочее): " + ДеньгиКратко(Зг.ЗаГод) + ".");
	Иначе
		СтрокаИтога(В, "Всего закуплено за 12 месяцев", , Зг.ЗаГод);
	КонецЕсли;
	Примечание(В, "Цены без НДС, средние за месяц. Изменение — последняя цена к цене первого месяца с закупками. Красным — подорожание, зелёным — подешевление.");

	// матрица: месяцы по строкам, 7 крупнейших материалов по столбцам
	СледующаяСтрока(В);
	Подзаголовок(В, "Средняя цена по месяцам, руб. за единицу");
	Колонок = Мин(7, Зг.Материалы.Количество());
	Для К = 0 По Колонок - 1 Цикл
		Ячейка(В, К + 2, Строка(Зг.Материалы[К].Номенклатура), Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8, , Истина);
		ВПраво(В, К + 2, К + 2);
	КонецЦикла;
	Ячейка(В, 1, "Месяц", Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8);
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 36;
	СледующаяСтрока(В);
	Для Каждого НачалоМес Из Зг.Месяцы Цикл
		Ячейка(В, 1, ИмяМесяца(Месяц(НачалоМес), Ложь) + " " + Формат(Год(НачалоМес), "ЧГ=0"), НачалоМес = П.НачалоМесяца);
		Для К = 0 По Колонок - 1 Цикл
			Мат = Зг.Материалы[К];
			Цена = Мат.Помесячно[НачалоМес];
			Если Цена = Неопределено Тогда
				Ячейка(В, К + 2, "—", , ЦветПриглушенный());
			Иначе
				Цвет = Неопределено;
				Если Цена = Мат.МаксЦена И Мат.МаксЦена > Мат.МинЦена Тогда
					Цвет = ЦветКрит();
				ИначеЕсли Цена = Мат.МинЦена И Мат.МаксЦена > Мат.МинЦена Тогда
					Цвет = ЦветХорошо();
				КонецЕсли;
				Ячейка(В, К + 2, ФорматДенег(Цена), , Цвет);
			КонецЕсли;
			ВПраво(В, К + 2, К + 2);
		КонецЦикла;
		ЛинияСнизу(В, 1, Колонок + 1);
		СледующаяСтрока(В);
	КонецЦикла;
	Ячейка(В, 1, "Средняя за год", Истина, , ЦветФонаШапки());
	Для К = 0 По Колонок - 1 Цикл
		Мат = Зг.Материалы[К];
		Ячейка(В, К + 2, ФорматДенег(?(Мат.Количество = 0, 0, Мат.Сумма / Мат.Количество)), Истина, , ЦветФонаШапки());
		ВПраво(В, К + 2, К + 2);
	КонецЦикла;
	СледующаяСтрока(В);
	Примечание(В, "Красным — самая высокая цена за год, зелёным — самая низкая. Средняя за год — сумма закупок, делённая на количество.");

	// графики цены по месяцам для главных материалов: цена и средняя за год
	Для К = 0 По Мин(4, Зг.Материалы.Количество()) - 1 Цикл
		Мат = Зг.Материалы[К];
		СледующаяСтрока(В);
		Подзаголовок(В, Строка(Мат.Номенклатура) + ": цена закупки по месяцам, руб. за " + ?(ЗначениеЗаполнено(Мат.Ед), Мат.Ед, "ед."));
		Точки = Новый Массив;
		Цены = Новый Массив;
		Средние = Новый Массив;
		Средняя = ?(Мат.Количество = 0, 0, Мат.Сумма / Мат.Количество);
		Для Каждого НачалоМес Из Зг.Месяцы Цикл
			Точки.Добавить(Формат(НачалоМес, "ДФ='MMM yy'"));
			Цены.Добавить(Мат.Помесячно[НачалоМес]);
			Средние.Добавить(Средняя);
		КонецЦикла;
		Серии = Новый Массив;
		Серии.Добавить(Новый Структура("Имя, Значения", "Цена за месяц", Цены));
		Серии.Добавить(Новый Структура("Имя, Значения", "Средняя за год", Средние));
		ВывестиГрафик(В, Точки, Серии, 11);
	КонецЦикла;

	Если Зг.Сравнение.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Цены разных поставщиков за 3 месяца");
		Шапка(В, "Материал / поставщик", "Куплено", "Цена", "Дороже лучшей", "Переплата");
		Текущий = Неопределено;
		Для Каждого Гр Из ГруппыНоменклатуры(Зг.Сравнение, "Номенклатура", "Переплата") Цикл
		ВывестиСтрокуГруппы(В, Гр, "5:Переплата:ч", 5);
		Для Каждого Стр Из Гр.Позиции Цикл
			Если Стр.Номенклатура <> Текущий Тогда
				Текущий = Стр.Номенклатура;
				Ячейка(В, 1, "      " + Строка(Текущий), Истина, , , 8, 5, Истина);
				РасшифровкаСтроки(В, Текущий, 5);
				СледующаяСтрока(В);
			КонецЕсли;
			Ячейка(В, 1, "            " + Строка(Стр.Контрагент), , ?(Стр.Лучший, ЦветХорошо(), Неопределено), , 8, , Истина);
			ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
			ЯчейкаЧисло(В, 3, Стр.Цена, ?(Стр.Лучший, ЦветХорошо(), Неопределено), Стр.Лучший);
			Если Стр.Лучший Тогда
				Ячейка(В, 4, "лучшая цена", , ЦветХорошо());
			Иначе
				Ячейка(В, 4, "+" + Формат(Стр.Отклонение, "ЧДЦ=1; ЧН=0") + " %", , ?(Стр.Отклонение >= 5, ЦветКрит(), ЦветВнимание()));
			КонецЕсли;
			ВПраво(В, 4, 4);
			ЯчейкаЧисло(В, 5, Стр.Переплата, ?(Стр.Переплата > 0, ЦветКрит(), Неопределено));
			РасшифровкаСтроки(В, Стр.Контрагент, 5);
			ЛинияСнизу(В, 1, 5);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
		СтрокаИтога(В, "Переплата против лучших цен", , , , Зг.Переплата);
		Примечание(В, "Переплата — сколько сэкономили бы, если бы весь объём за 3 месяца купили по лучшей цене. Разные цены бывают из-за качества, сроков и доставки — сверьте условия.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПримитивыВывода

&НаСервере
Процедура СледующаяСтрока(В, Сколько = 1)

	Если Сколько < 1 Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 5;
		В.Строка = В.Строка + 1;
	Иначе
		В.Строка = В.Строка + Сколько;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Ячейка(В, Колонка, Значение, Жирный = Ложь, ЦвТекста = Неопределено, ЦвФона = Неопределено, Размер = 9, КолонкаПо = 0, Переносить = Ложь)

	Обл = В.ТД.Область(В.Строка, Колонка, В.Строка, Макс(Колонка, КолонкаПо));
	Если КолонкаПо > Колонка Тогда
		Обл.Объединить();
	КонецЕсли;
	Обл.Текст = Строка(Значение);
	Обл.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Если ЦвТекста <> Неопределено Тогда
		Обл.ЦветТекста = ЦвТекста;
	КонецЕсли;
	Если ЦвФона <> Неопределено Тогда
		Обл.ЦветФона = ЦвФона;
	КонецЕсли;
	Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Если Переносить Тогда
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Иначе
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЯчейкаЧисло(В, Колонка, Значение, ЦвТекста = Неопределено, Жирный = Ложь, ЦвФона = Неопределено)

	Ячейка(В, Колонка, ФорматДенег(Значение), Жирный, ЦвТекста, ЦвФона);
	ВПраво(В, Колонка, Колонка);

КонецПроцедуры

&НаСервере
Процедура ЯчейкаКоличество(В, Колонка, Значение, Ед)

	Если Значение = 0 Тогда
		Ячейка(В, Колонка, "—", , ЦветПриглушенный());
	Иначе
		Ячейка(В, Колонка, ФорматЧисла(Значение) + ?(ЗначениеЗаполнено(Ед), " " + Ед, ""));
	КонецЕсли;
	ВПраво(В, Колонка, Колонка);

КонецПроцедуры

&НаСервере
Процедура ВПраво(В, ОтКолонки, ДоКолонки)

	В.ТД.Область(В.Строка, ОтКолонки, В.Строка, ДоКолонки).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;

КонецПроцедуры

&НаСервере
Процедура ЗаголовокРаздела(В, Название)

	СледующаяСтрока(В);
	Ячейка(В, 1, Название, Истина, ЦветАкцент(), , 13, 8);
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 22;
	Черта(В, 1, 8, 2, ЦветАкцент());
	СледующаяСтрока(В);
	СледующаяСтрока(В, 0.5);

КонецПроцедуры

&НаСервере
Процедура Подзаголовок(В, Название)

	Ячейка(В, 1, Название, Истина, , , 10, 8);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура Шапка(В, К1, К2 = "", К3 = "", К4 = "", К5 = "", К6 = "", К7 = "", К8 = "")

	Значения = Новый Массив;
	Значения.Добавить(К1);
	Значения.Добавить(К2);
	Значения.Добавить(К3);
	Значения.Добавить(К4);
	Значения.Добавить(К5);
	Значения.Добавить(К6);
	Значения.Добавить(К7);
	Значения.Добавить(К8);
	Последняя = 1;
	Для Индекс = 0 По 7 Цикл
		Если ЗначениеЗаполнено(Значения[Индекс]) Тогда
			Последняя = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Для Индекс = 0 По Последняя - 1 Цикл
		Ячейка(В, Индекс + 1, Значения[Индекс], Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8, , Истина);
		Если Индекс > 0 Тогда
			ВПраво(В, Индекс + 1, Индекс + 1);
		КонецЕсли;
	КонецЦикла;
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 18;
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура СтрокаИтога(В, Название, З2 = Неопределено, З3 = Неопределено, З4 = Неопределено, З5 = Неопределено)

	Значения = Новый Массив;
	Значения.Добавить(З2);
	Значения.Добавить(З3);
	Значения.Добавить(З4);
	Значения.Добавить(З5);
	Последняя = 1;
	Для Индекс = 0 По 3 Цикл
		Если Значения[Индекс] <> Неопределено Тогда
			Последняя = Индекс + 2;
		КонецЕсли;
	КонецЦикла;
	Ячейка(В, 1, Название, Истина, , ЦветФонаШапки());
	Для Индекс = 0 По Последняя - 2 Цикл
		Если Значения[Индекс] = Неопределено Тогда
			Ячейка(В, Индекс + 2, "", , , ЦветФонаШапки());
		Иначе
			ЯчейкаЧисло(В, Индекс + 2, Значения[Индекс], , Истина, ЦветФонаШапки());
		КонецЕсли;
	КонецЦикла;
	Черта(В, 1, Последняя, 1, , Ложь);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура Примечание(В, ТекстПримечания)

	Ячейка(В, 1, ТекстПримечания, , ЦветПриглушенный(), , 8, 8, Истина);
	ПодогнатьВысоту(В, ТекстПримечания, 160);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ПодогнатьВысоту(В, ТекстЯчейки, СимволовВСтроке)

	Строк = Цел(СтрДлина(ТекстЯчейки) / СимволовВСтроке) + 1;
	Если Строк > 1 Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 12 * Строк;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Черта(В, ОтКолонки, ДоКолонки, Толщина = 1, Цвет = Неопределено, Снизу = Истина)

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, Толщина);
	Обл = В.ТД.Область(В.Строка, ОтКолонки, В.Строка, ДоКолонки);
	Если Снизу Тогда
		Обл.ГраницаСнизу = Линия;
	Иначе
		Обл.ГраницаСверху = Линия;
	КонецЕсли;
	Обл.ЦветРамки = ?(Цвет = Неопределено, Новый Цвет(24, 32, 31), Цвет);

КонецПроцедуры

&НаСервере
Процедура ЛинияСнизу(В, ОтКолонки, ДоКолонки)

	Обл = В.ТД.Область(В.Строка, ОтКолонки, В.Строка, ДоКолонки);
	Обл.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Обл.ЦветРамки = Новый Цвет(225, 231, 229);

КонецПроцедуры

&НаСервере
Процедура ВывестиГрафик(В, Точки, Серии, ВысотаСтрок = 12)

	// линейный график 1С (объект «Диаграмма») в табличном документе
	Верх = В.Строка;
	Попытка
		Рисунок = В.ТД.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Диаграмма);
		Рисунок.Расположить(В.ТД.Область(Верх, 1, Верх + ВысотаСтрок - 1, 8));
		Диаграмма = Рисунок.Объект;
		Диаграмма.Обновление = Ложь;
		Диаграмма.ТипДиаграммы = ТипДиаграммы.График;
		Диаграмма.ОтображатьЗаголовок = Ложь;
		Диаграмма.ОтображатьЛегенду = Серии.Количество() > 1;
		Подписи = Новый Массив;
		Для Каждого Подпись Из Точки Цикл
			Подписи.Добавить(Диаграмма.УстановитьТочку(Подпись));
		КонецЦикла;
		Для Каждого Опис Из Серии Цикл
			Серия = Диаграмма.УстановитьСерию(Опис.Имя);
			Для Индекс = 0 По Подписи.ВГраница() Цикл
				ЗначениеТочки = Опис.Значения[Индекс];
				Если ЗначениеТочки <> Неопределено Тогда
					Диаграмма.УстановитьЗначение(Подписи[Индекс], Серия, ЗначениеТочки);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Диаграмма.Обновление = Истина;
		В.Строка = Верх + ВысотаСтрок;
	Исключение
		// диаграмма недоступна — остаются таблицы
		В.Строка = Верх;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура Полоса(В, ОтКолонки, ДоКолонки, Доля, Цвет, ДоляПлана)

	// горизонтальная полоса из символов █: примерно 15 символов на колонку, лишнее обрезается
	Ячеек = ДоКолонки - ОтКолонки + 1;
	Заполнено = Окр(Мин(Доля, 1) * Ячеек * 15);
	Для К = 0 По Ячеек - 1 Цикл
		Блоков = Мин(15, Макс(0, Заполнено - К * 15));
		Обл = В.ТД.Область(В.Строка, ОтКолонки + К, В.Строка, ОтКолонки + К);
		Обл.Текст = Лев("████████████████████", Блоков);
		Обл.Шрифт = Новый Шрифт("Arial", 9);
		Обл.ЦветТекста = Цвет;
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
	КонецЦикла;
	Если ДоляПлана > 0 Тогда
		Колонка = ОтКолонки + Мин(Ячеек - 1, Цел(ДоляПлана * Ячеек - 0.0001));
		Обл = В.ТД.Область(В.Строка, Колонка, В.Строка, Колонка);
		Обл.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		Обл.ЦветРамки = Новый Цвет(24, 32, 31);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РасшифровкаСтроки(В, Значение, ДоКолонки)

	// двойной щелчок по строке открывает документ, контрагента или номенклатуру
	Если ЗначениеЗаполнено(Значение) И ТипЗнч(Значение) <> Тип("Строка") Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, ДоКолонки).Расшифровка = Значение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоказатьОшибку(В, Р, Раздел)

	Ошибка = Р.Ошибки[Раздел];
	Если Ошибка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Ячейка(В, 1, "Раздел не сформирован: " + Ошибка, , ЦветКрит(), ФонКрит(), 9, 8, Истина);
	ПодогнатьВысоту(В, Ошибка, 120);
	СледующаяСтрока(В);
	Функции = Новый Структура("Продажи, Закупки, Маржа, Запасы, Сырье, Заказы, Выпуск, Деньги, Долги",
		"ПолучитьПродажи", "ПолучитьОбороты", "ПолучитьМаржу", "ПолучитьЗапасы", "ПолучитьСырье", "ПолучитьЗаказы", "ПолучитьВыпуск", "ПолучитьДеньги", "ПолучитьДолги");
	ИмяФункции = "Получить" + Раздел;
	Функции.Свойство(Раздел, ИмяФункции);
	Примечание(В, "Сфотографируйте эту строку и пришлите. Для программиста 1С: запрос раздела — в функции " + ИмяФункции + "() модуля формы.");
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ДоговорыАрендыИзПДФ

// Договоры аренды в PDF, прикреплённые к карточке арендатора или его договора, распознаются без интернета
// на компьютере пользователя: Windows сам рисует страницы PDF и распознаёт текст (встроенное распознавание Windows 10/11), скрипт
// находит площадь, арендную плату, ставку за м², НДС, срок и индексацию. Результаты запоминаются и
// показываются в разделе «Арендаторы»; кнопкой «Записать в карточки» — в доп. реквизиты договора.

&НаКлиенте
Процедура ДоговорыИзПДФ(Команда)

	РаспознатьДоговорыНаКлиенте(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ДоговорыИзПДФЗаново(Команда)

	РаспознатьДоговорыНаКлиенте(Истина);

КонецПроцедуры

// Распознавание идёт на этом компьютере (не на сервере 1С: служба сервера работает без пользователя,
// и встроенное распознавание Windows там не работает), по одному договору, 1С при этом не зависает.
&НаКлиенте
Асинх Процедура РаспознатьДоговорыНаКлиенте(Заново)

	Попытка
		Подготовка = ПодготовитьДоговорыНаСервере(Заново);
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Договоры из PDF", ПодробноеПредставлениеОшибки(Инфо));
		ПоказатьПредупреждение(, "Договоры не распознаны:" + Символы.ПС + КраткоеПредставлениеОшибки(Инфо));
		Возврат;
	КонецПопытки;
	Всего = Подготовка.Файлы.Количество();
	Ошибок = 0;
	Если Всего > 0 Тогда
		Попытка
			Корень = Ждать КаталогВременныхФайловАсинх();
			Если НЕ СтрЗаканчиваетсяНа(Корень, "\") Тогда
				Корень = Корень + "\";
			КонецЕсли;
			Каталог = Корень + "dogovory_" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0") + "\";
			Ждать СоздатьКаталогАсинх(Каталог);
			ПутьСкрипта = Каталог + "raspoznat.ps1";
			ТекстСкрипта = Новый ТекстовыйДокумент;
			ТекстСкрипта.УстановитьТекст(Подготовка.Скрипт);
			Ждать ТекстСкрипта.ЗаписатьАсинх(ПутьСкрипта, КодировкаТекста.UTF8);
		Исключение
			Инфо = ИнформацияОбОшибке();
			ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Договоры из PDF: временная папка", ПодробноеПредставлениеОшибки(Инфо));
			ПоказатьПредупреждение(, "Не удалось подготовить временную папку:" + Символы.ПС + КраткоеПредставлениеОшибки(Инфо));
			Возврат;
		КонецПопытки;
		Номер = 0;
		Для Каждого Описание Из Подготовка.Файлы Цикл
			Номер = Номер + 1;
			Состояние("Распознаю договор " + Номер + " из " + Всего, Номер / Всего * 100, Описание.Имя);
			ТекстJSON = "";
			ТекстЖурнала = "";
			КодВозврата = -1;
			Попытка
				Папка = Каталог + "f" + Формат(Номер, "ЧГ=0") + "\";
				Ждать СоздатьКаталогАсинх(Папка);
				Данные = ПолучитьИзВременногоХранилища(ДанныеФайлаДоговора(Описание.Файл, УникальныйИдентификатор));
				Ждать Данные.ЗаписатьАсинх(Папка + "dogovor.pdf");
				КодВозврата = Ждать ЗапуститьПриложениеАсинх("powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File """ + ПутьСкрипта
					+ """ -Dir """ + Лев(Папка, СтрДлина(Папка) - 1) + """ -MaxPages 10 -MaxSeconds 180", Папка, Истина);
				ТекстJSON = Ждать ПрочитатьТекстНаКлиенте(Папка + "dogovor.pdf.json");
				ТекстЖурнала = Ждать ПрочитатьТекстНаКлиенте(Папка + "log.txt");
			Исключение
				ТекстЖурнала = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
			Если НЕ ЗаписатьРезультатДоговораНаСервере(Описание, ТекстJSON, ТекстЖурнала, КодВозврата) Тогда
				Ошибок = Ошибок + 1;
			КонецЕсли;
			// «нет распознавания» одинаково для всех файлов — дальше не мучаемся
			Если КодВозврата = 2 ИЛИ КодВозврата = 3 Тогда
				ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Договоры из PDF", ТекстЖурнала);
				ПоказатьПредупреждение(, "Распознавание на этом компьютере недоступно:" + Символы.ПС + ТекстЖурнала);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Попытка
			Ждать УдалитьФайлыАсинх(Каталог);
		Исключение
			// временную папку удалит система
		КонецПопытки;
	КонецЕсли;
	Итог = ЗавершитьДоговорыНаСервере(Подготовка.Ключи);
	ПоказатьПредупреждение(, СтрШаблон("Файлов PDF у арендаторов: %1. Распознано сейчас: %2 (с ошибками: %3), без изменений с прошлого раза: %4.",
		Подготовка.Ключи.Количество(), Всего, Ошибок, Подготовка.Пропущено) + Символы.ПС + Символы.ПС + Итог);

КонецПроцедуры

&НаКлиенте
Асинх Функция ПрочитатьТекстНаКлиенте(Путь)

	Попытка
		Документ = Новый ТекстовыйДокумент;
		Ждать Документ.ПрочитатьАсинх(Путь, КодировкаТекста.UTF8);
		Возврат СокрЛП(Документ.ПолучитьТекст());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ЗаписатьДоговорыВКарточки(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗаписатьДоговорыВКарточкиПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Записать найденные площадь, плату, ставку, срок и индексацию в дополнительные реквизиты договоров?"
		+ Символы.ПС + "Заполняются только пустые реквизиты; то, что уже заполнено, не меняется.", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДоговорыВКарточкиПослеВопроса(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Итог = ЗаписатьДоговорыНаСервере();
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Запись договоров", ПодробноеПредставлениеОшибки(Инфо));
		ПоказатьПредупреждение(, "Не записано:" + Символы.ПС + КраткоеПредставлениеОшибки(Инфо));
		Возврат;
	КонецПопытки;
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

// Какие PDF распознать: файлы арендаторов и их договоров, кроме не менявшихся с прошлого раза.
&НаСервере
Функция ПодготовитьДоговорыНаСервере(Заново)

	СохранитьНастройки();
	П = ПараметрыОтчета();
	Аренда = ПолучитьАренду(П, Неопределено);
	Если Аренда.Таблица.Количество() = 0 Тогда
		ВызватьИсключение "арендаторы не найдены (нет передачи ОС в аренду и начислений аренды за 12 месяцев)";
	КонецЕсли;
	Файлы = ФайлыДоговоровАренды(Аренда);
	Если Файлы.Количество() = 0 Тогда
		ВызватьИсключение "у арендаторов (" + Аренда.Таблица.Количество() + ") и их договоров нет прикреплённых файлов PDF";
	КонецЕсли;
	Кэш = ЗагрузитьДоговорыПДФ();
	Р = Новый Структура("Файлы, Ключи, Пропущено, Скрипт", Новый Массив, Новый Массив, 0, ТекстСкриптаРаспознавания());
	Для Каждого Стр Из Файлы Цикл
		Ключ = Строка(Стр.Файл.УникальныйИдентификатор());
		Р.Ключи.Добавить(Ключ);
		Было = Кэш[Ключ];
		Если НЕ Заново И ТипЗнч(Было) = Тип("Структура") И Было.Изменен = Стр.Изменен И ПустаяСтрока(Было.Ошибка) Тогда
			Было.Арендатор = Стр.Арендатор;
			Р.Пропущено = Р.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		СтрАренды = Аренда.Таблица.Найти(Стр.Арендатор, "Арендатор");
		Р.Файлы.Добавить(Новый Структура("Файл, Имя, Владелец, Арендатор, Изменен, ДоговорАренды", Стр.Файл, Стр.Имя, Стр.Владелец,
			Стр.Арендатор, Стр.Изменен, ?(СтрАренды = Неопределено, Неопределено, СтрАренды.Договор)));
	КонецЦикла;
	СохранитьДоговорыПДФ(Кэш);
	Возврат Р;

КонецФункции

&НаСервере
Функция ДанныеФайлаДоговора(Файл, ИдентификаторФормы)

	Возврат ПоместитьВоВременноеХранилище(РаботаСФайлами.ДвоичныеДанныеФайла(Файл), ИдентификаторФормы);

КонецФункции

// Результат одного файла — в сохранённые договоры. Истина, если распознано без ошибки.
&НаСервере
Функция ЗаписатьРезультатДоговораНаСервере(Описание, ТекстJSON, ТекстЖурнала, КодВозврата)

	Результат = НовыйРезультатДоговора(Описание, "");
	Если ПустаяСтрока(ТекстJSON) Тогда
		Результат.Ошибка = ?(ПустаяСтрока(ТекстЖурнала), "нет результата распознавания (код " + КодВозврата + ")", Лев(ТекстЖурнала, 300));
	Иначе
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ТекстJSON);
			Найдено = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			ЗаполнитьРезультатДоговора(Результат, Найдено);
			Результат.Договор = ДоговорАрендатора(Описание, Результат.Номер, Описание.ДоговорАренды);
		Исключение
			Результат.Ошибка = "результат не прочитан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Кэш = ЗагрузитьДоговорыПДФ();
	Кэш.Вставить(Строка(Описание.Файл.УникальныйИдентификатор()), Результат);
	СохранитьДоговорыПДФ(Кэш);
	Возврат ПустаяСтрока(Результат.Ошибка);

КонецФункции

// Оставить только файлы, которые сейчас есть у арендаторов, и показать таблицу.
&НаСервере
Функция ЗавершитьДоговорыНаСервере(Ключи)

	Кэш = ЗагрузитьДоговорыПДФ();
	Актуальные = Новый Соответствие;
	Для Каждого Ключ Из Ключи Цикл
		Если Кэш[Ключ] <> Неопределено Тогда
			Актуальные.Вставить(Ключ, Кэш[Ключ]);
		КонецЕсли;
	КонецЦикла;
	СохранитьДоговорыПДФ(Актуальные);
	ЭтаФорма["ДокументОтчета"] = ВывестиДоговорыПДФ(Актуальные, ПараметрыОтчета());
	Возврат "Проверьте цифры в таблице (рядом — цитата из договора). Если всё верно — «Записать договоры в карточки». "
		+ "В разделе «Арендаторы» ежедневного отчёта начисления теперь сверяются с договором.";

КонецФункции

&НаСервере
Функция ФайлыДоговоровАренды(Аренда)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Файл");
	Т.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Владелец");
	Т.Колонки.Добавить("Арендатор");
	Т.Колонки.Добавить("Изменен");
	Арендаторы = Аренда.Таблица.ВыгрузитьКолонку("Арендатор");
	// договоры арендаторов — к ним тоже прикрепляют файлы
	ДоговорАрендатор = Новый Соответствие;
	Договоры = Новый Массив;
	МетаДоговоров = Метаданные.Справочники.Найти("ДоговорыКонтрагентов");
	Если МетаДоговоров <> Неопределено И МетаДоговоров.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Контрагент КАК Контрагент ИЗ Справочник.ДоговорыКонтрагентов КАК Д
			|ГДЕ НЕ Д.ПометкаУдаления И Д.Контрагент В (&Арендаторы)");
		Запрос.УстановитьПараметр("Арендаторы", Арендаторы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Договоры.Добавить(Выборка.Ссылка);
			ДоговорАрендатор.Вставить(Выборка.Ссылка, Выборка.Контрагент);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Опис Из СтрРазделить("КонтрагентыПрисоединенныеФайлы,ДоговорыКонтрагентовПрисоединенныеФайлы", ",") Цикл
		Мета = Метаданные.Справочники.Найти(Опис);
		Если Мета = Неопределено ИЛИ Мета.Реквизиты.Найти("ВладелецФайла") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Владельцы = ?(СтрНачинаетсяС(Опис, "Договоры"), Договоры, Арендаторы);
		Если Владельцы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Ф.Ссылка КАК Файл, Ф.Наименование КАК Имя, Ф.ВладелецФайла КАК Владелец, "
			+ ?(Мета.Реквизиты.Найти("Расширение") <> Неопределено, "Ф.Расширение", """""") + " КАК Расширение, "
			+ ?(Мета.Реквизиты.Найти("ДатаМодификацииУниверсальная") <> Неопределено, "Ф.ДатаМодификацииУниверсальная", "ДАТАВРЕМЯ(1, 1, 1)") + " КАК Изменен
			|ИЗ Справочник." + Опис + " КАК Ф
			|ГДЕ НЕ Ф.ПометкаУдаления И Ф.ВладелецФайла В (&Владельцы)");
		Запрос.УстановитьПараметр("Владельцы", Владельцы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Расширение = НРег(СокрЛП(Выборка.Расширение));
			Если Расширение <> "pdf" И НЕ СтрЗаканчиваетсяНа(НРег(Выборка.Имя), ".pdf") Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Т.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
			НовСтр.Арендатор = ?(ДоговорАрендатор[Выборка.Владелец] = Неопределено, Выборка.Владелец, ДоговорАрендатор[Выборка.Владелец]);
		КонецЦикла;
	КонецЦикла;
	Возврат Т;

КонецФункции

&НаСервере
Функция НовыйРезультатДоговора(СтрокаФайла, Ошибка)

	Р = Новый Структура("Файл, Имя, Арендатор, Владелец, Договор, Изменен, Ошибка, Распознан", СтрокаФайла.Файл, СтрокаФайла.Имя,
		СтрокаФайла.Арендатор, СтрокаФайла.Владелец, Неопределено, СтрокаФайла.Изменен, Ошибка, ТекущаяДатаСеанса());
	Для Каждого Имя Из СтрРазделить("Площадь,Ставка,ВМесяц,Индексация,Страниц,Символов", ",") Цикл
		Р.Вставить(Имя, 0);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("НДС,Адрес,Номер,ЦитатаПлощадь,ЦитатаСтавка,ЦитатаВМесяц,ЦитатаСрок,ЦитатаИндексация", ",") Цикл
		Р.Вставить(Имя, "");
	КонецЦикла;
	Р.Вставить("СрокДо", Дата(1, 1, 1));
	Р.Вставить("ДатаДоговора", Дата(1, 1, 1));
	Если ТипЗнч(СтрокаФайла.Владелец) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Р.Договор = СтрокаФайла.Владелец;
	КонецЕсли;
	Возврат Р;

КонецФункции

&НаСервере
Процедура ЗаполнитьРезультатДоговора(Р, Найдено)

	Для Каждого Элемент Из Найдено Цикл
		Если НЕ Р.Свойство(Элемент.Ключ) ИЛИ Элемент.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Р[Элемент.Ключ]) = Тип("Число") Тогда
			Р[Элемент.Ключ] = ЧислоИлиНоль(Элемент.Значение);
		ИначеЕсли ТипЗнч(Р[Элемент.Ключ]) = Тип("Дата") Тогда
			Р[Элемент.Ключ] = ДатаИзСтроки(Строка(Элемент.Значение));
		Иначе
			Р[Элемент.Ключ] = Строка(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	// нет общей платы, но есть площадь и ставка
	Если Р.ВМесяц = 0 И Р.Площадь > 0 И Р.Ставка > 0 Тогда
		Р.ВМесяц = Окр(Р.Площадь * Р.Ставка, 2);
		Р.ЦитатаВМесяц = "площадь × ставка";
	КонецЕсли;
	Если Р.Символов = 0 И ПустаяСтрока(Р.Ошибка) Тогда
		Р.Ошибка = "текст не распознан";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДатаИзСтроки(Текст)

	// «2026-01-31»
	Если СтрДлина(Текст) <> 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Прав(Текст, 2)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

// Договор, к которому относится PDF: файл прикреплён к договору; иначе договор арендатора с тем же номером;
// иначе договор аренды из раздела «Арендаторы»; иначе единственный договор арендатора.
&НаСервере
Функция ДоговорАрендатора(СтрокаФайла, НомерИзТекста, ДоговорАренды)

	Если ТипЗнч(СтрокаФайла.Владелец) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Возврат СтрокаФайла.Владелец;
	КонецЕсли;
	Если Метаданные.Справочники.Найти("ДоговорыКонтрагентов") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Номер КАК Номер ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И Д.Контрагент = &Арендатор");
	Запрос.УстановитьПараметр("Арендатор", СтрокаФайла.Арендатор);
	Попытка
		Договоры = Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Номер = НРег(СтрЗаменить(НомерИзТекста, " ", ""));
	Если Номер <> "" Тогда
		Для Каждого Стр Из Договоры Цикл
			НомерДоговора = НРег(СтрЗаменить(СокрЛП(Стр.Номер), " ", ""));
			Если НомерДоговора <> "" И (НомерДоговора = Номер ИЛИ СтрНайти(Номер, НомерДоговора) > 0 ИЛИ СтрНайти(НомерДоговора, Номер) > 0) Тогда
				Возврат Стр.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДоговорАренды) Тогда
		Возврат ДоговорАренды;
	КонецЕсли;
	Возврат ?(Договоры.Количество() = 1, Договоры[0].Ссылка, Неопределено);

КонецФункции

&НаСервере
Функция ПрочитатьТекстФайла(Путь)

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат СокрЛП(?(Текст = Неопределено, "", Текст));

