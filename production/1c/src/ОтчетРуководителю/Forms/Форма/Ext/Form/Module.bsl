	КонецПопытки;
	ЭтаФорма["ДокументОтчета"] = Вывести(Р, П);

КонецПроцедуры

#КонецОбласти

#Область Деньги

&НаСервере
Функция ПолучитьДеньги(П, Долги)

	Р = Новый Структура;
	Счета = Новый ТаблицаЗначений;
	Счета.Колонки.Добавить("Вид");
	Счета.Колонки.Добавить("Счет");
	Счета.Колонки.Добавить("Вчера", ОписаниеЧисла());
	Счета.Колонки.Добавить("Сегодня", ОписаниеЧисла());

	Платежи = Новый ТаблицаЗначений;
	Платежи.Колонки.Добавить("Документ");
	Платежи.Колонки.Добавить("День");
	Платежи.Колонки.Добавить("Приход", ОписаниеЧисла());
	Платежи.Колонки.Добавить("Расход", ОписаниеЧисла());

	Регистры = Новый Массив;
	Регистры.Добавить(Новый Структура("Регистр, Измерение, Вид", "ДенежныеСредстваБезналичные", "БанковскийСчет,Счет", "Банк"));
	Регистры.Добавить(Новый Структура("Регистр, Измерение, Вид", "ДенежныеСредстваНаличные", "Касса", "Касса"));

	Для Каждого Опис Из Регистры Цикл
		Если Метаданные.РегистрыНакопления.Найти(Опис.Регистр) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = РесурсРегистра(Опис.Регистр, "СуммаРегл,Сумма");
		Измерение = ИзмерениеРегистра(Опис.Регистр, Опис.Измерение);
		Условие = УсловиеОрганизации(Опис.Регистр, П);

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т." + Измерение + " КАК Счет,
			|	Т." + Ресурс + "НачальныйОстаток КАК Вчера,
			|	Т." + Ресурс + "КонечныйОстаток КАК Сегодня
			|ИЗ
			|	РегистрНакопления." + Опис.Регистр + ".ОстаткиИОбороты(&НачалоДня, &КонецДня" + ?(Условие = "", "", ", , , " + Условие) + ") КАК Т";
		УстановитьПараметры(Запрос, П);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Вчера = 0 И Выборка.Сегодня = 0 Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Счета.Добавить();
			НовСтр.Вид = Опис.Вид;
			НовСтр.Счет = Выборка.Счет;
			НовСтр.Вчера = Выборка.Вчера;
			НовСтр.Сегодня = Выборка.Сегодня;
		КонецЦикла;

		// движения за месяц по документам: приход и расход каждого документа
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Регистратор КАК Документ,
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК День,
			|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Приход,
			|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Расход
			|ИЗ
			|	РегистрНакопления." + Опис.Регистр + " КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &НачалоДенег И &КонецДня
			|	И Т.Активность" + УсловиеНеПлатежей() + ?(Условие = "", "", "
			|	И Т." + Условие) + "
			|СГРУППИРОВАТЬ ПО
			|	Т.Регистратор,
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Платежи.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;

	Платежи.Свернуть("Документ, День", "Приход, Расход");

	// депозиты: отдельные «депозитные» банковские счета убираем из остатков на счетах и показываем депозитами
	ДепозитныеСчета = Счета.СкопироватьКолонки();
	Для Каждого Стр Из Счета.Скопировать() Цикл
		Если СтрНайти(НРег(Строка(Стр.Счет)), "депозит") > 0 Тогда
			ЗаполнитьЗначенияСвойств(ДепозитныеСчета.Добавить(), Стр);
			Счета.Удалить(Счета.Найти(Стр.Счет, "Счет"));
		КонецЕсли;
	КонецЦикла;
	Счета.Сортировать("Вид, Сегодня Убыв");
	Р.Вставить("Счета", Счета);
	Р.Вставить("Итого", Счета.Итог("Сегодня"));
	Р.Вставить("ИтогоВчера", Счета.Итог("Вчера"));
	Депозиты = Новый Структура("Вчера, Сегодня, Источник, Ошибка, Пути", 0, 0, "", "", Новый Массив);
	Попытка
		Депозиты = ПолучитьДепозиты(П);
	Исключение
		Депозиты.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ДепозитныеСчета.Количество() > 0 И СтрНайти(Депозиты.Источник, "55.03") = 0 Тогда
		Депозиты.Вчера = Депозиты.Вчера + ДепозитныеСчета.Итог("Вчера");
		Депозиты.Сегодня = Депозиты.Сегодня + ДепозитныеСчета.Итог("Сегодня");
		Депозиты.Источник = ?(ПустаяСтрока(Депозиты.Источник), "", Депозиты.Источник + "; ")
			+ "банковские счета со словом «депозит» в названии (" + ДепозитныеСчета.Количество() + ")";
	КонецЕсли;
	Р.Вставить("Депозиты", Депозиты);
	Р.Вставить("ВсегоСДепозитами", Р.Итого + Депозиты.Сегодня);
	Р.Вставить("ВсегоСДепозитамиВчера", Р.ИтогоВчера + Депозиты.Вчера);

	// реквизиты платёжных документов месяца одним запросом на вид документа
	ДокументыМесяца = Новый Массив;
	Для Каждого Пл Из Платежи Цикл
		Если Пл.День >= П.НачалоМесяца И НЕ ЭтоПеремещениеДенег(Пл) Тогда
			ДокументыМесяца.Добавить(Пл.Документ);
		КонецЕсли;
	КонецЦикла;
	Поля = Новый Структура;
	Поля.Вставить("Контрагент", "Контрагент,Партнер,ПодотчетноеЛицо,Получатель,Плательщик");
	Поля.Вставить("Статья", "СтатьяДвиженияДенежныхСредств,СтатьяДДС");
	Поля.Вставить("Назначение", "НазначениеПлатежа,Основание,Комментарий");
	Реквизиты = Новый Соответствие;
	Если ДокументыМесяца.Количество() <= 3000 Тогда
		Реквизиты = РеквизитыДокументов(ДокументыМесяца, Поля);
	КонецЕсли;

	ЗаДень = Новый ТаблицаЗначений;
	ЗаДень.Колонки.Добавить("Вид");
	ЗаДень.Колонки.Добавить("Документ");
	ЗаДень.Колонки.Добавить("Контрагент");
	ЗаДень.Колонки.Добавить("Статья");
	ЗаДень.Колонки.Добавить("Назначение");
	ЗаДень.Колонки.Добавить("Сумма", ОписаниеЧисла());
	ЗаМесяц = ЗаДень.СкопироватьКолонки();
	ЗаМесяц.Колонки.Добавить("Приход", ОписаниеЧисла());
	ЗаМесяц.Колонки.Добавить("Расход", ОписаниеЧисла());
	Приход = 0;
	Расход = 0;
	ПриходМесяц = 0;
	РасходМесяц = 0;
	Перемещений = 0;
	ЧистоПоДням = Новый Соответствие;
	Для Каждого Пл Из Платежи Цикл
		ЧистоПоДням.Вставить(Пл.День, ЧислоИлиНоль(ЧистоПоДням[Пл.День]) + Пл.Приход - Пл.Расход);
		Если Пл.День < П.НачалоМесяца Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоПеремещениеДенег(Пл) Тогда
			Если Пл.День = П.День Тогда
				Перемещений = Перемещений + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПриходМесяц = ПриходМесяц + Пл.Приход;
		РасходМесяц = РасходМесяц + Пл.Расход;
		Рекв = Реквизиты[Пл.Документ];
		Если Рекв = Неопределено Тогда
			Рекв = Новый Структура("Контрагент, Статья, Назначение");
		КонецЕсли;
		НовСтр = ЗаМесяц.Добавить();
		НовСтр.Документ = Пл.Документ;
		НовСтр.Контрагент = Рекв.Контрагент;
		НовСтр.Статья = ?(ЗначениеЗаполнено(Рекв.Статья), Рекв.Статья, "Статья не указана");
		НовСтр.Приход = Пл.Приход;
		НовСтр.Расход = Пл.Расход;
		Если Пл.День <> П.День Тогда
			Продолжить;
		КонецЕсли;
		Приход = Приход + Пл.Приход;
		Расход = Расход + Пл.Расход;
		Сальдо = Пл.Приход - Пл.Расход;
		НовСтр = ЗаДень.Добавить();
		НовСтр.Вид = ?(Сальдо >= 0, "приход", "расход");
		НовСтр.Документ = Пл.Документ;
		НовСтр.Сумма = Макс(Сальдо, -Сальдо);
		НовСтр.Контрагент = Рекв.Контрагент;
		НовСтр.Статья = Рекв.Статья;
		НовСтр.Назначение = Рекв.Назначение;
	КонецЦикла;
	ЗаДень.Сортировать("Вид, Сумма Убыв"); // сначала поступления, потом платежи
	Р.Вставить("Платежи", ЗаДень);
	Р.Вставить("Приход", Приход);
	Р.Вставить("Расход", Расход);
	Р.Вставить("ПриходМесяц", ПриходМесяц);
	Р.Вставить("РасходМесяц", РасходМесяц);
	Р.Вставить("Перемещений", Перемещений);

	Расшифровка = Новый Соответствие;
	Если ДокументыМесяца.Количество() <= 3000 Тогда
		Расшифровка = СтатьиИзРасшифровки(ДокументыМесяца);
	КонецЕсли;
	ПоСтатьям = Новый ТаблицаЗначений;
	ПоСтатьям.Колонки.Добавить("Статья");
	ПоСтатьям.Колонки.Добавить("Приход", ОписаниеЧисла());
	ПоСтатьям.Колонки.Добавить("Расход", ОписаниеЧисла());
	Для Каждого Стр Из ЗаМесяц Цикл
		Части = Расшифровка[Стр.Документ];
		Всего = 0;
		Если Части <> Неопределено Тогда
			Для Каждого Часть Из Части Цикл
				Всего = Всего + Часть.Сумма;
			КонецЦикла;
		КонецЕсли;
		Если Всего = 0 Тогда
			ЗаполнитьЗначенияСвойств(ПоСтатьям.Добавить(), Стр);
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из Части Цикл
			НовСтр = ПоСтатьям.Добавить();
			НовСтр.Статья = ?(ЗначениеЗаполнено(Часть.Статья), Часть.Статья, "Статья не указана");
			НовСтр.Приход = Стр.Приход * Часть.Сумма / Всего;
			НовСтр.Расход = Стр.Расход * Часть.Сумма / Всего;
		КонецЦикла;
	КонецЦикла;
	ПоСтатьям.Свернуть("Статья", "Приход, Расход");
	ПоСтатьям.Колонки.Добавить("Оборот", ОписаниеЧисла());
	Для Каждого Стр Из ПоСтатьям Цикл
		Стр.Оборот = Стр.Приход + Стр.Расход;
	КонецЦикла;
	ПоСтатьям.Сортировать("Оборот Убыв");
	Р.Вставить("ПоСтатьям", ПоСтатьям);
	ПоКонтрагентам = ЗаМесяц.Скопировать(, "Контрагент, Приход, Расход");
	ПоКонтрагентам.Свернуть("Контрагент", "Приход, Расход");
	ПоКонтрагентам.Сортировать("Расход Убыв");
	Получатели = ПоКонтрагентам.СкопироватьКолонки();
	Для Каждого Стр Из ПоКонтрагентам Цикл
		Если Стр.Расход > 0 И Получатели.Количество() < 10 Тогда
			ЗаполнитьЗначенияСвойств(Получатели.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	ПоКонтрагентам.Сортировать("Приход Убыв");
	Плательщики = ПоКонтрагентам.СкопироватьКолонки();
	Для Каждого Стр Из ПоКонтрагентам Цикл
		Если Стр.Приход > 0 И Плательщики.Количество() < 10 Тогда
			ЗаполнитьЗначенияСвойств(Плательщики.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Р.Вставить("Плательщики", Плательщики);
	Р.Вставить("Получатели", Получатели);

	Р.Вставить("Динамика", ОстаткиДенегПоДням(П));
	Возврат Р;

КонецФункции

// Остаток депозитов на начало и конец дня отчёта. Пробуем по очереди, первый непустой — ответ:
// 1) регистры остатков, где договор кредита/депозита — измерение или реквизит измерения
//    (в ERP 2.5 — через «Объекты расчетов» или ключи аналитики), тип договора «Депозит», основной долг;
// 2) платёжные документы: размещено на депозиты минус возвращено с депозитов (оценка);
// 3) бухучёт: остаток счетов 55.03 и 55.04 (после закрытия месяца).
&НаСервере
Функция ПолучитьДепозиты(П)

	Р = Новый Структура("Вчера, Сегодня, Источник, Ошибка, Пути", 0, 0, "", "", Новый Массив);
	Если Метаданные.Справочники.Найти("ДоговорыКредитовИДепозитов") <> Неопределено Тогда
		Для Каждого Путь Из ПутиКДоговорамДепозитов() Цикл
			Попытка
				Итог = ДепозитыПоРегистру(Путь, П);
			Исключение
				Р.Пути.Добавить(Путь.Регистр + "." + Путь.Поле + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Р.Пути.Добавить(Путь.Регистр + "." + Путь.Поле + ": договоров депозитов " + Итог.Договоров + ", остаток " + Формат(Итог.Сегодня, "ЧДЦ=0; ЧН=0"));
			Если Итог.Договоров > 0 Тогда
				Р.Вчера = Итог.Вчера;
				Р.Сегодня = Итог.Сегодня;
				Р.Источник = "договоры депозитов (" + Итог.Договоров + "), регистр «" + Метаданные.РегистрыНакопления[Путь.Регистр].Синоним + "»";
				Возврат Р;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Попытка
		Итог = ДепозитыПоПлатежам(П);
		Р.Пути.Добавить("платёжные документы: размещено минус возвращено " + Формат(Итог.Сегодня, "ЧДЦ=0; ЧН=0") + " (документов " + Итог.Документов + ")");
		Если Итог.Сегодня > 0 Тогда
			Р.Вчера = Итог.Вчера;
			Р.Сегодня = Итог.Сегодня;
			Р.Источник = "оценка по платёжным документам: размещено на депозиты минус возвращено (проценты в возвратах могут её занижать)";
			Возврат Р;
		КонецЕсли;
	Исключение
		Р.Пути.Добавить("платёжные документы: ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// бухучёт, счета 55.03 и 55.04
	Если Метаданные.ПланыСчетов.Найти("Хозрасчетный") <> Неопределено Тогда
		Счета = Новый Массив;
		Для Каждого КодСчета Из СтрРазделить("55.03,55.04", ",") Цикл
			Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета);
			Если ЗначениеЗаполнено(Счет) Тогда
				Счета.Добавить(Счет);
			КонецЕсли;
		КонецЦикла;
		Если Счета.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	ЕСТЬNULL(СУММА(Т.СуммаНачальныйОстатокДт - Т.СуммаНачальныйОстатокКт), 0) КАК Вчера,
				|	ЕСТЬNULL(СУММА(Т.СуммаКонечныйОстатокДт - Т.СуммаКонечныйОстатокКт), 0) КАК Сегодня
				|ИЗ
				|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоДня, &КонецДня, , , Счет В ИЕРАРХИИ (&СчетаДепозитов), , "
				+ ?(ЗначениеЗаполнено(П.Организация), "Организация = &Организация", "") + ") КАК Т";
			УстановитьПараметры(Запрос, П);
			Запрос.УстановитьПараметр("СчетаДепозитов", Счета);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Р.Пути.Добавить("бухучёт 55.03/55.04: " + Формат(Выборка.Сегодня, "ЧДЦ=0; ЧН=0"));
				Если Выборка.Вчера <> 0 ИЛИ Выборка.Сегодня <> 0 Тогда
					Р.Вчера = Выборка.Вчера;
					Р.Сегодня = Выборка.Сегодня;
					Р.Источник = "бухучёт, счета 55.03 и 55.04 (актуально после закрытия месяца)";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Р;

КонецФункции

// Где в регистрах остатков лежит договор кредита/депозита: само измерение или реквизит измерения
// (Объект, Договор, ОбъектРасчетов) — например, «Объекты расчетов» или ключи аналитики в ERP 2.5.
&НаСервере
Функция ПутиКДоговорамДепозитов()

	ТипДоговора = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов");
	Пути = Новый Массив;
	Для Каждого МетаРегистра Из Метаданные.РегистрыНакопления Цикл
		Если МетаРегистра.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = РесурсРегистра(МетаРегистра.Имя, "СуммаРегл,Сумма,СуммаВВалютеДоговора,СуммаУпр");
		Если Ресурс = "" Тогда
			Продолжить;
		КонецЕсли;
		ИмяТипаСуммы = "";
		Для Каждого Измерение Из МетаРегистра.Измерения Цикл
			Если СтрНайти(Измерение.Имя, "ТипСуммы") > 0 ИЛИ СтрНайти(Измерение.Имя, "ВидСуммы") > 0 Тогда
				ИмяТипаСуммы = Измерение.Имя;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Измерение Из МетаРегистра.Измерения Цикл
			Поле = "";
			Если Измерение.Тип.СодержитТип(ТипДоговора) Тогда
				Поле = Измерение.Имя;
			Иначе
				Для Каждого ТипИзмерения Из Измерение.Тип.Типы() Цикл
					МетаТипа = Метаданные.НайтиПоТипу(ТипИзмерения);
					Если МетаТипа = Неопределено ИЛИ НЕ Метаданные.Справочники.Содержит(МетаТипа) Тогда
						Продолжить;
					КонецЕсли;
					Для Каждого ИмяРеквизита Из СтрРазделить("Объект,Договор,ОбъектРасчетов", ",") Цикл
						МетаРеквизита = МетаТипа.Реквизиты.Найти(ИмяРеквизита);
						Если МетаРеквизита <> Неопределено И МетаРеквизита.Тип.СодержитТип(ТипДоговора) Тогда
							Поле = Измерение.Имя + "." + ИмяРеквизита;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если Поле <> "" Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если Поле <> "" Тогда
				Пути.Добавить(Новый Структура("Регистр, Поле, Ресурс, ТипСуммы", МетаРегистра.Имя, Поле, Ресурс, ИмяТипаСуммы));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Пути;

КонецФункции

&НаСервере
Функция ДепозитыПоРегистру(Путь, П)

	Итог = Новый Структура("Вчера, Сегодня, Договоров", 0, 0, 0);
	Условие = УсловиеОрганизации(Путь.Регистр, П);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Т." + Путь.Поле + " КАК Справочник.ДоговорыКредитовИДепозитов) КАК Договор,
		|	" + ?(Путь.ТипСуммы = "", "НЕОПРЕДЕЛЕНО", "Т." + Путь.ТипСуммы) + " КАК ТипСуммы,
		|	СУММА(Т." + Путь.Ресурс + "НачальныйОстаток) КАК Вчера,
		|	СУММА(Т." + Путь.Ресурс + "КонечныйОстаток) КАК Сегодня
		|ИЗ
		|	РегистрНакопления." + Путь.Регистр + ".ОстаткиИОбороты(&НачалоДня, &КонецДня" + ?(Условие = "", "", ", , , " + Условие) + ") КАК Т
		|ГДЕ
		|	Т." + Путь.Поле + " ССЫЛКА Справочник.ДоговорыКредитовИДепозитов
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(Т." + Путь.Поле + " КАК Справочник.ДоговорыКредитовИДепозитов)" + ?(Путь.ТипСуммы = "", "", ",
		|	Т." + Путь.ТипСуммы);
	УстановитьПараметры(Запрос, П);
	Таблица = Запрос.Выполнить().Выгрузить();
	ЕстьОсновнойДолг = Ложь;
	Для Каждого Стр Из Таблица Цикл
		Если ЭтоОсновнойДолг(Стр.ТипСуммы) Тогда
			ЕстьОсновнойДолг = Истина;
		КонецЕсли;
	КонецЦикла;
	ЕстьТипДоговора = Метаданные.Справочники.ДоговорыКредитовИДепозитов.Реквизиты.Найти("ТипДоговора") <> Неопределено;
	ПоДоговорам = Новый Соответствие;
	Для Каждого Стр Из Таблица Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Договор) ИЛИ (ЕстьОсновнойДолг И НЕ ЭтоОсновнойДолг(Стр.ТипСуммы)) Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьТипДоговора И СтрНайти(НРег(Строка(Стр.Договор.ТипДоговора)), "депозит") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Было = ПоДоговорам[Стр.Договор];
		Если Было = Неопределено Тогда
			Было = Новый Структура("Вчера, Сегодня", 0, 0);
			ПоДоговорам.Вставить(Стр.Договор, Было);
		КонецЕсли;
		Было.Вчера = Было.Вчера + ЧислоИлиНоль(Стр.Вчера);
		Было.Сегодня = Было.Сегодня + ЧислоИлиНоль(Стр.Сегодня);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоДоговорам Цикл
		Итог.Вчера = Итог.Вчера + Макс(КлючИЗначение.Значение.Вчера, -КлючИЗначение.Значение.Вчера);
		Итог.Сегодня = Итог.Сегодня + Макс(КлючИЗначение.Значение.Сегодня, -КлючИЗначение.Значение.Сегодня);
		Если КлючИЗначение.Значение.Сегодня <> 0 ИЛИ КлючИЗначение.Значение.Вчера <> 0 Тогда
			Итог.Договоров = Итог.Договоров + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоОсновнойДолг(ТипСуммы)

	Текст = НРег(Строка(ТипСуммы));
	Возврат СтрНайти(Текст, "основн") > 0 ИЛИ СтрНайти(Текст, "тело") > 0 ИЛИ (СтрНайти(Текст, "долг") > 0 И СтрНайти(Текст, "процент") = 0);

КонецФункции

// Оценка по платёжным документам за всё время до дня отчёта: списания с операцией «…депозит…»
// (размещение) минус поступления с операцией «…депозит…» (возврат).
&НаСервере
Функция ДепозитыПоПлатежам(П)

	Итог = Новый Структура("Вчера, Сегодня, Документов", 0, 0, 0);
	Для Каждого Опис Из СтрРазделить("СписаниеБезналичныхДенежныхСредств:1,ПоступлениеБезналичныхДенежныхСредств:-1", ",") Цикл
		Части = СтрРазделить(Опис, ":");
		МетаДокумента = Метаданные.Документы.Найти(Части[0]);
		Если МетаДокумента = Неопределено ИЛИ МетаДокумента.Реквизиты.Найти("ХозяйственнаяОперация") = Неопределено
			ИЛИ МетаДокумента.Реквизиты.Найти("СуммаДокумента") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Знак = Число(Части[1]);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Д.ХозяйственнаяОперация КАК Операция,
			|	КОЛИЧЕСТВО(*) КАК Документов,
			|	СУММА(ВЫБОР КОГДА Д.Дата < &НачалоДня ТОГДА Д.СуммаДокумента ИНАЧЕ 0 КОНЕЦ) КАК Вчера,
			|	СУММА(Д.СуммаДокумента) КАК Сегодня
			|ИЗ
			|	Документ." + Части[0] + " КАК Д
			|ГДЕ
			|	Д.Проведен
			|	И Д.Дата <= &КонецДня" + ?(ЗначениеЗаполнено(П.Организация) И МетаДокумента.Реквизиты.Найти("Организация") <> Неопределено, "
			|	И Д.Организация = &Организация", "") + "
			|СГРУППИРОВАТЬ ПО
			|	Д.ХозяйственнаяОперация";
		УстановитьПараметры(Запрос, П);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстОперации = НРег(Строка(Выборка.Операция));
			Если СтрНайти(ТекстОперации, "депозит") = 0 ИЛИ СтрНайти(ТекстОперации, "процент") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Итог.Документов = Итог.Документов + Выборка.Документов;
			Итог.Вчера = Итог.Вчера + Знак * ЧислоИлиНоль(Выборка.Вчера);
			Итог.Сегодня = Итог.Сегодня + Знак * ЧислоИлиНоль(Выборка.Сегодня);
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Переоценка валютных счетов и корректировки регистров меняют остаток, но это не платежи.
&НаСервере
Функция УсловиеНеПлатежей()

	Части = Новый Массив;
	Для Каждого Имя Из СтрРазделить("РасчетКурсовыхРазниц,КорректировкаРегистров,ЗакрытиеМесяца", ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Части.Добавить("
			|	И НЕ Т.Регистратор ССЫЛКА Документ." + Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

&НаСервере
Функция ОстаткиДенегПоДням(П)

	// остаток денег на конец каждого из 14 дней — прямо из остатков регистров
	Динамика = Новый ТаблицаЗначений;
	Динамика.Колонки.Добавить("Дата");
	Динамика.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Для Д = 0 По 13 Цикл
		НовСтр = Динамика.Добавить();
		НовСтр.Дата = П.День - (13 - Д) * 86400;
	КонецЦикла;
	Для Каждого ИмяРегистра Из СтрРазделить("ДенежныеСредстваБезналичные,ДенежныеСредстваНаличные", ",") Цикл
		Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = РесурсРегистра(ИмяРегистра, "СуммаРегл,Сумма");
		Условие = УсловиеОрганизации(ИмяРегистра, П);
		Измерение = ИзмерениеРегистра(ИмяРегистра, "БанковскийСчет,Счет,Касса");
		ПолеСчета = ?(Измерение = "", "НЕОПРЕДЕЛЕНО", "Т%1." + Измерение);
		Части = Новый Массив;
		Запрос = Новый Запрос;
		Для Каждого Стр Из Динамика Цикл
			Номер = Формат(Динамика.Индекс(Стр), "ЧН=0; ЧГ=0");
			Счет = СтрЗаменить(ПолеСчета, "%1", Номер);
			Части.Добавить("ВЫБРАТЬ " + Номер + " КАК Номер, " + Счет + " КАК Счет, ЕСТЬNULL(СУММА(Т" + Номер + "." + Ресурс + "Остаток), 0) КАК Остаток
			|ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(&Граница" + Номер + ?(Условие = "", "", ", " + Условие) + ") КАК Т" + Номер
			+ ?(Измерение = "", "", "
			|СГРУППИРОВАТЬ ПО " + Счет));
			Запрос.УстановитьПараметр("Граница" + Номер, Новый Граница(КонецДня(Стр.Дата), ВидГраницы.Включая));
		КонецЦикла;
		Запрос.Текст = СтрСоединить(Части, "
		|ОБЪЕДИНИТЬ ВСЕ
		|");
		Запрос.УстановитьПараметр("Организация", П.Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			// счета «депозит» показываются отдельной строкой, в остаток на счетах не входят
			Если СтрНайти(НРег(Строка(Выборка.Счет)), "депозит") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Динамика[Выборка.Номер].Остаток = Динамика[Выборка.Номер].Остаток + Выборка.Остаток;
		КонецЦикла;
	КонецЦикла;
	Возврат Динамика;

КонецФункции

&НаСервере
Функция СтатьиИзРасшифровки(Ссылки)

	// статьи ДДС из табличной части «Расшифровка платежа» платёжных документов:
	// документ → массив (статья, сумма)
	Результат = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Попытка
			ИмяВида = Ссылка.Метаданные().Имя;
		Исключение
			Продолжить;
		КонецПопытки;
		Если ПоВидам[ИмяВида] = Неопределено Тогда
			ПоВидам.Вставить(ИмяВида, Новый Массив);
		КонецЕсли;
		ПоВидам[ИмяВида].Добавить(Ссылка);
	КонецЦикла;
	Для Каждого Элемент Из ПоВидам Цикл
		Мета = Метаданные.Документы.Найти(Элемент.Ключ);
		Если Мета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТЧ = Мета.ТабличныеЧасти.Найти("РасшифровкаПлатежа");
		Если ТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РекСтатья = РеквизитКоллекции(ТЧ.Реквизиты, "СтатьяДвиженияДенежныхСредств,СтатьяДДС");
		РекСумма = РеквизитКоллекции(ТЧ.Реквизиты, "Сумма,СуммаВзаиморасчетов,СуммаРегл");
		Если РекСтатья = "" ИЛИ РекСумма = "" Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Ссылка КАК Документ,
			|	Т." + РекСтатья + " КАК Статья,
			|	СУММА(Т." + РекСумма + ") КАК Сумма
			|ИЗ
			|	Документ." + Элемент.Ключ + ".РасшифровкаПлатежа КАК Т
			|ГДЕ
			|	Т.Ссылка В (&Ссылки)
			|СГРУППИРОВАТЬ ПО
			|	Т.Ссылка,
			|	Т." + РекСтатья;
		Запрос.УстановитьПараметр("Ссылки", Элемент.Значение);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Продолжить;
		КонецПопытки;
		Пока Выборка.Следующий() Цикл
			Если Результат[Выборка.Документ] = Неопределено Тогда
				Результат.Вставить(Выборка.Документ, Новый Массив);
			КонецЕсли;
			Результат[Выборка.Документ].Добавить(Новый Структура("Статья, Сумма", Выборка.Статья, Выборка.Сумма));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЭтоПеремещениеДенег(Платеж)

	// один документ и принёс, и списал деньги на своих счетах — это перемещение
	Если Платеж.Приход <> 0 И Платеж.Расход <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Имя = Платеж.Документ.Метаданные().Имя;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Для Каждого Часть Из СтрРазделить("Перемещени,ДругуюКассу,Инкассац,ВнесениеНаличных,СнятиеНаличных,КонвертацияВалют", ",") Цикл
		Если СтрНайти(Имя, Часть) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	// перевод между своими счетами в ERP — два документа (списание и поступление), каждый только
	// с одной стороной, поэтому узнаём их по хозяйственной операции
	Операция = РеквизитСсылки(Платеж.Документ, "ХозяйственнаяОперация");
	Если ЗначениеЗаполнено(Операция) Тогда
		Текст = СтрЗаменить(НРег(Строка(Операция)), "ё", "е");
		Для Каждого Часть Из СтрРазделить("перемещ,внутренн,на другой счет,с другого счета,в другую кассу,из другой кассы,"
			+ "кассу ккм,кассы ккм,в банк,из банка,получение наличных,инкассац,конвертац,покупка валюты,продажа валюты", ",") Цикл
			Если СтрНайти(Текст, Часть) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		// размещение и возврат депозита — деньги остаются свои (показаны строкой «Депозиты»); проценты — доход
		Если СтрНайти(Текст, "депозит") > 0 И СтрНайти(Текст, "процент") = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция СуммаКСроку(Позиции, ДатаДня)

	Сумма = 0;
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) И НачалоДня(Поз.Срок) = ДатаДня Тогда
			Сумма = Сумма + Поз.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

#КонецОбласти

#Область Долги

&НаСервере
Функция ПолучитьДолги(ИмяРегистра, ЗапасноеИмя, П)

	Рег = ИмяРегистра;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Рег = ЗапасноеИмя;
	КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистров " + ИмяРегистра + " и " + ЗапасноеИмя;
	КонецЕсли;

	Поля = Новый Массив;
	Группировки = Новый Массив;
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаПоПартнерам") <> "" Тогда
		Поля.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер) КАК Контрагент");
		Группировки.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер)");
	Иначе
		ИзмКонтрагент = ИзмерениеРегистра(Рег, "Контрагент,Партнер");
		Поля.Добавить(?(ИзмКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмКонтрагент) + " КАК Контрагент");
		Если ИзмКонтрагент <> "" Тогда
			Группировки.Добавить("Т." + ИзмКонтрагент);
		КонецЕсли;
	КонецЕсли;
	ИзмДокумент = ИзмерениеРегистра(Рег, "ОбъектРасчетов,ДокументРасчетов,РасчетныйДокумент,ЗаказКлиента,Заказ,ДокументРегистратор");
	Поля.Добавить(?(ИзмДокумент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмДокумент) + " КАК Документ");
	Если ИзмДокумент <> "" Тогда
		Группировки.Добавить("Т." + ИзмДокумент);
	КонецЕсли;
	ИзмСрок = ИзмерениеРегистра(Рег, "ДатаПлановогоПогашения,ДатаПлатежа,СрокОплаты,ДатаПогашения");
	Поля.Добавить(?(ИзмСрок = "", "ДАТАВРЕМЯ(1, 1, 1)", "Т." + ИзмСрок) + " КАК Срок");
	Если ИзмСрок <> "" Тогда
		Группировки.Добавить("Т." + ИзмСрок);
	КонецЕсли;
	Ресурс = РесурсРегистра(Рег, "ДолгРегл,Долг,ДолгУпр,СуммаРегл,Сумма");
	Если Ресурс = "" Тогда
		ВызватьИсключение "в регистре " + Рег + " не найден ресурс суммы долга";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(Поля, ",
		|	") + ",
		|	СУММА(Т." + Ресурс + "Остаток) КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница" + ?(Условие = "", "", ", " + Условие) + ") КАК Т" + ?(Группировки.Количество() = 0, "", "
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(Группировки, ",
		|	")) + "
		|ИМЕЮЩИЕ
		|	СУММА(Т." + Ресурс + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Позиции = Запрос.Выполнить().Выгрузить();

	// тот же запрос на начало месяца: как изменился долг
	Запрос.УстановитьПараметр("Граница", П.НачалоМесяца);
	ВсегоНаНачало = 0;
	ПросроченоНаНачало = 0;
	Для Каждого Поз Из Запрос.Выполнить().Выгрузить() Цикл
		ВсегоНаНачало = ВсегоНаНачало + Поз.Сумма;
		Если ЗначениеЗаполнено(Поз.Срок) И Поз.Срок < П.НачалоМесяца Тогда
			ПросроченоНаНачало = ПросроченоНаНачало + Поз.Сумма;
		КонецЕсли;
	КонецЦикла;

	Позиции.Колонки.Добавить("Просрочка", ОписаниеЧисла());
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) Тогда
			Поз.Просрочка = Цел((П.День - НачалоДня(Поз.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;
	Позиции.Сортировать("Просрочка Убыв, Сумма Убыв");

	Корзины = Новый Массив;
	Для Каждого Опис Из ОписаниеКорзин() Цикл
		Корзины.Добавить(Новый Структура("Заголовок, Сумма", Опис.Заголовок, 0));
	КонецЦикла;
	Всего = 0;
	Просрочено = 0;
	ВБлижайшие = 0;
	ПоКонтрагентам = Новый ТаблицаЗначений;
	ПоКонтрагентам.Колонки.Добавить("Контрагент");
	ПоКонтрагентам.Колонки.Добавить("Долг", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Просрочено", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("МаксПросрочка", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Документов", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("БлижайшийСрок");
	Ближайшие = Позиции.СкопироватьКолонки();
	Для Каждого Поз Из Позиции Цикл
		Всего = Всего + Поз.Сумма;
		НовСтр = ПоКонтрагентам.Найти(Поз.Контрагент, "Контрагент");
		Если НовСтр = Неопределено Тогда
			НовСтр = ПоКонтрагентам.Добавить();
			НовСтр.Контрагент = Поз.Контрагент;
		КонецЕсли;
		НовСтр.Долг = НовСтр.Долг + Поз.Сумма;
		НовСтр.Документов = НовСтр.Документов + 1;
		Если Поз.Просрочка > 0 Тогда
			Просрочено = Просрочено + Поз.Сумма;
			НовСтр.Просрочено = НовСтр.Просрочено + Поз.Сумма;
			НовСтр.МаксПросрочка = Макс(НовСтр.МаксПросрочка, Поз.Просрочка);
		ИначеЕсли ЗначениеЗаполнено(Поз.Срок) Тогда
			Если НЕ ЗначениеЗаполнено(НовСтр.БлижайшийСрок) ИЛИ Поз.Срок < НовСтр.БлижайшийСрок Тогда
				НовСтр.БлижайшийСрок = Поз.Срок;
			КонецЕсли;
			Если -Поз.Просрочка <= П.Горизонт Тогда
				ВБлижайшие = ВБлижайшие + Поз.Сумма;
				ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Поз);
			КонецЕсли;
		КонецЕсли;
		Индекс = 0;
		Для Каждого Опис Из ОписаниеКорзин() Цикл
			Если Поз.Просрочка >= Опис.От И Поз.Просрочка <= Опис.До Тогда
				Корзины[Индекс].Сумма = Корзины[Индекс].Сумма + Поз.Сумма;
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	ПоКонтрагентам.Сортировать("Просрочено Убыв, Долг Убыв");
	Ближайшие.Сортировать("Срок");

	Р = Новый Структура;
	Р.Вставить("Регистр", Рег);
	Р.Вставить("ЕстьСроки", ИзмСрок <> "");
	Р.Вставить("Позиции", Позиции);
	Р.Вставить("Всего", Всего);
	Р.Вставить("Просрочено", Просрочено);
	Р.Вставить("ВБлижайшие", ВБлижайшие);
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Корзины", Корзины);
	Р.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	Р.Вставить("ВсегоНаНачало", ВсегоНаНачало);
	Р.Вставить("ПросроченоНаНачало", ПросроченоНаНачало);
	Возврат Р;

КонецФункции

&НаСервере
Функция ОписаниеКорзин()

	Корзины = Новый Массив;
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Срок не наступил", -100000, 0));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "1–30 дней", 1, 30));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "31–60 дней", 31, 60));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "61–90 дней", 61, 90));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Более 90 дней", 91, 100000));
	Возврат Корзины;

КонецФункции

#КонецОбласти

#Область Выпуск

&НаСервере
Функция ДокументыПроизводства(П, ВключаяПередачу = Ложь)

	// документы выпуска (приход на склад) и списания в производство (расход):
	// известные имена ERP плюс все виды документов, которые за 60 дней двигали склад
	// и в имени которых есть «производ», «выпуск», «этап», «сборк», «переработ», «продукц»
	Кандидаты = "ЭтапПроизводства2_2,ВыпускПродукции,ПроизводствоБезЗаказа";
	Если ВключаяПередачу Тогда
		Кандидаты = Кандидаты + ",ПередачаМатериаловВПроизводство";
	КонецЕсли;
	Найдено = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Кандидаты, ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Найдено.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Слова = СтрРазделить("производ,выпуск,этап,сборк,переработ,продукц" + ?(ВключаяПередачу, ",передачаматериал,потреблен,списаниематериал", ""), ",");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5000
		|	Т.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК Т
		|ГДЕ
		|	Т.Период МЕЖДУ &Начало60 И &КонецДня
		|	И Т.ВидДвижения = &ВидДвижения
		|	И Т.Активность";
	Запрос.УстановитьПараметр("Начало60", П.День - 59 * 86400);
	Запрос.УстановитьПараметр("КонецДня", П.КонецДня);
	Запрос.УстановитьПараметр("ВидДвижения", ?(ВключаяПередачу, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход));
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Найдено;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Попытка
			Имя = Выборка.Регистратор.Метаданные().Имя;
		Исключение
			Продолжить;
		КонецПопытки;
		Если Найдено.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяНРег = НРег(Имя);
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(ИмяНРег, Слово) > 0 И СтрНайти(ИмяНРег, "возврат") = 0 Тогда
				Найдено.Добавить(Имя);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

&НаСервере
Функция УсловиеРегистратора(СписокДокументов)

	Части = Новый Массив;
	Для Каждого Имя Из СписокДокументов Цикл
		Части.Добавить("Т.Регистратор ССЫЛКА Документ." + Имя);
	КонецЦикла;
	Возврат "(" + СтрСоединить(Части, " ИЛИ ") + ")";

КонецФункции

// Выпуск прямо из суточных (сменных) рапортов — документов «Производство без заказа» и завершённых
// «Этапов производства»: все выходные изделия, и продукция, и полуфабрикаты, с участком (подразделением)
// и сменой, если она есть в документе. Так цифры совпадают с рапортами, даже если регистр выпуска не заполнен.
&НаСервере
Функция ВыпускПоРапортам(П, Начало)

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("День");
	Строки.Колонки.Добавить("Номенклатура");
	Строки.Колонки.Добавить("Участок");
	Строки.Колонки.Добавить("Смена");
	Строки.Колонки.Добавить("Количество", ОписаниеЧисла());
	Р = Новый Структура("Строки, Источники, ЕстьСмены, Документов", Строки, Новый Массив, Ложь, 0);
	// «Отчёт производства за смену» (сменный / суточный рапорт), «Производство без заказа», этапы производства,
	// и любые документы, в названии которых есть «рапорт» или «отчёт … за смену»
	ВидыДокументов = Новый Массив;
	Для Каждого Имя Из СтрРазделить("ОтчетПроизводстваЗаСмену,ПроизводствоБезЗаказа,ЭтапПроизводства2_2", ",") Цикл
		ВидыДокументов.Добавить(Имя);
	КонецЦикла;
	Для Каждого МетаДок Из Метаданные.Документы Цикл
		Название = НРег(МетаДок.Имя + " " + МетаДок.Синоним);
		Если ВидыДокументов.Найти(МетаДок.Имя) = Неопределено
			И (СтрНайти(Название, "рапорт") > 0 ИЛИ (СтрНайти(Название, "отчет") > 0 И СтрНайти(Название, "смен") > 0)) Тогда
			ВидыДокументов.Добавить(МетаДок.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Опис Из ВидыДокументов Цикл
		Мета = Метаданные.Документы.Найти(Опис);
		Если Мета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// все табличные части с выпуском: продукция, выходные изделия, полуфабрикаты (раньше бралась только первая)
		ТабличныеЧастиВыпуска = Новый Массив;
		Для Каждого ИмяТЧ Из СтрРазделить("ВыходныеИзделия,Продукция,Выпуск,ВыпущеннаяПродукция,Полуфабрикаты,ВыходныеПолуфабрикаты", ",") Цикл
			Если Мета.ТабличныеЧасти.Найти(ИмяТЧ) <> Неопределено Тогда
				ТабличныеЧастиВыпуска.Добавить(Мета.ТабличныеЧасти[ИмяТЧ]);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТЧ Из ТабличныеЧастиВыпуска Цикл
		Если ТЧ.Реквизиты.Найти("Номенклатура") = Неопределено
			ИЛИ (ТЧ.Реквизиты.Найти("Количество") = Неопределено И ТЧ.Реквизиты.Найти("КоличествоУпаковок") = Неопределено
				И ТЧ.Реквизиты.Найти("опти_Количество") = Неопределено) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ВыражениеКоличестваВСпецификации(ТЧ, "Т");
		// участок: подразделение-производитель из шапки рапорта (в строках «Подразделение» бывает получателем);
		// если в шапке его нет — из строки
		РекУчасток = РеквизитКоллекции(Мета.Реквизиты, "Подразделение,Участок,ПодразделениеДиспетчер");
		ПолеУчастка = ?(РекУчасток = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекУчасток);
		ПолеУчасткаСтроки = ?(ТЧ.Реквизиты.Найти("Подразделение") = Неопределено, "НЕОПРЕДЕЛЕНО", "Т.Подразделение");
		// смена: любой реквизит со словом «смен» в строке или шапке
		ПолеСмены = "НЕОПРЕДЕЛЕНО";
		Для Каждого Рек Из ТЧ.Реквизиты Цикл
			Если СтрНайти(НРег(Рек.Имя), "смен") > 0 Тогда
				ПолеСмены = "Т." + Рек.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПолеСмены = "НЕОПРЕДЕЛЕНО" Тогда
			Для Каждого Рек Из Мета.Реквизиты Цикл
				Если СтрНайти(НРег(Рек.Имя), "смен") > 0 Тогда
					ПолеСмены = "Т.Ссылка." + Рек.Имя;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ЕстьСтатус = Мета.Реквизиты.Найти("Статус") <> Неопределено;
		Условия = Новый Массив;
		Условия.Добавить("Т.Ссылка.Проведен");
		Условия.Добавить("Т.Ссылка.Дата МЕЖДУ &Начало И &КонецДня");
		Если ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено Тогда
			Условия.Добавить("(Т.Ссылка.Организация = &Организация ИЛИ Т.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))");
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК День,
			|	Т.Номенклатура КАК Номенклатура,
			|	" + ПолеУчастка + " КАК Участок,
			|	" + ПолеУчасткаСтроки + " КАК УчастокСтроки,
			|	" + ПолеСмены + " КАК Смена,
			|	" + ?(ЕстьСтатус, "Т.Ссылка.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус,
			|	СУММА(" + Количество + ") КАК Количество
			|ИЗ
			|	Документ." + Опис + "." + ТЧ.Имя + " КАК Т
			|ГДЕ
			|	" + СтрСоединить(Условия, "
			|	И ") + "
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ),
			|	Т.Номенклатура" + ?(ПолеУчастка = "НЕОПРЕДЕЛЕНО", "", ",
			|	" + ПолеУчастка) + ?(ПолеУчасткаСтроки = "НЕОПРЕДЕЛЕНО", "", ",
			|	" + ПолеУчасткаСтроки) + ?(ПолеСмены = "НЕОПРЕДЕЛЕНО", "", ",
			|	" + ПолеСмены) + ?(ЕстьСтатус, ",
			|	Т.Ссылка.Статус", "");
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("Начало", Начало);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Р.Источники.Добавить(Мета.Синоним + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Строк = 0;
		Пока Выборка.Следующий() Цикл
			// у этапа производства выпуск — только когда этап завершён
			Если ЕстьСтатус И Опис = "ЭтапПроизводства2_2" И СтрНайти(НРег(Строка(Выборка.Статус)), "заверш") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) ИЛИ ЧислоИлиНоль(Выборка.Количество) = 0 Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
			Если НЕ ЗначениеЗаполнено(НовСтр.Участок) Тогда
				НовСтр.Участок = Выборка.УчастокСтроки; // в шапке не указан — берём из строки
			КонецЕсли;
			Строк = Строк + 1;
		КонецЦикла;
		Если Строк > 0 Тогда
			Р.Источники.Добавить(Мета.Синоним + "." + ТЧ.Синоним + ?(ПолеСмены = "НЕОПРЕДЕЛЕНО", "", ", смена — " + Сред(ПолеСмены, СтрНайти(ПолеСмены, ".", НаправлениеПоиска.СКонца) + 1)));
			Р.ЕстьСмены = Р.ЕстьСмены ИЛИ ПолеСмены <> "НЕОПРЕДЕЛЕНО";
		КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Строки.Свернуть("День, Номенклатура, Участок, Смена", "Количество");
	Возврат Р;

КонецФункции

// Наработка по участкам и сменам: продукция и полуфабрикаты за день, с 1-го числа, за 7 и 30 дней.
&НаСервере
Функция НаработкаПоУчасткам(Строки, П, ПоПродуктам)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Участок");
	Т.Колонки.Добавить("Смена");
	Т.Колонки.Добавить("Номенклатура");
	Т.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	Т.Колонки.Добавить("ЗаМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("За7Дней", ОписаниеЧисла());
	Т.Колонки.Добавить("За30Дней", ОписаниеЧисла());
	Для Каждого Стр Из Строки Цикл
		НовСтр = Т.Добавить();
		НовСтр.Участок = Стр.Участок;
		НовСтр.Смена = Стр.Смена;
		НовСтр.Номенклатура = Стр.Номенклатура;
		Если Стр.День = П.День Тогда
			НовСтр.ЗаДень = Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.НачалоМесяца Тогда
			НовСтр.ЗаМесяц = Стр.Количество;
		КонецЕсли;
		Если Стр.День > П.День - 7 * 86400 Тогда
			НовСтр.За7Дней = Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.Начало30 Тогда
			НовСтр.За30Дней = Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	Т.Свернуть("Участок, Смена, Номенклатура", "ЗаДень, ЗаМесяц, За7Дней, За30Дней");
	// колонки после свёртки: Свернуть() оставляет только перечисленные
	Т.Колонки.Добавить("Ед");
	Т.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	Для Каждого Стр Из Т Цикл
		Продукт = ПоПродуктам.Найти(Стр.Номенклатура, "Номенклатура");
		Стр.Ед = ?(Продукт = Неопределено, ЕдиницаНоменклатуры(Стр.Номенклатура), Продукт.Ед);
		Стр.Полуфабрикат = ?(Продукт = Неопределено, ЭтоПолуфабрикат(Стр.Номенклатура), Продукт.Полуфабрикат);
	КонецЦикла;
	Т.Сортировать("Участок, Смена, Полуфабрикат, ЗаМесяц Убыв");
	Возврат Т;

КонецФункции

// Сверка с регистром «Выпуск продукции» за месяц: позиции, где цифры расходятся больше чем на 1 %.
&НаСервере
Функция СверкаСРегистромВыпуска(ПоПродуктам, П)

	Если Метаданные.РегистрыНакопления.Найти("ВыпускПродукции") = Неопределено
		ИЛИ ИзмерениеРегистра("ВыпускПродукции", "АналитикаУчетаНоменклатуры") = ""
		ИЛИ РесурсРегистра("ВыпускПродукции", "Количество") = "" Тогда
		Возврат "";
	КонецЕсли;
	Условие = УсловиеОрганизации("ВыпускПродукции", П);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Т.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура, СУММА(Т.КоличествоОборот) КАК Количество
		|ИЗ РегистрНакопления.ВыпускПродукции.Обороты(&НачалоМесяца, &КонецДня" + ?(Условие = "", "", ", , " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО Т.АналитикаУчетаНоменклатуры.Номенклатура");
	УстановитьПараметры(Запрос, П);
	ВРегистре = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВРегистре.Вставить(Выборка.Номенклатура, ЧислоИлиНоль(Выборка.Количество));
	КонецЦикла;
	Расходится = Новый Массив;
	Для Каждого Стр Из ПоПродуктам Цикл
		Было = ЧислоИлиНоль(ВРегистре[Стр.Номенклатура]);
		Если Макс(Стр.ЗаМесяц - Было, Было - Стр.ЗаМесяц) > Макс(Стр.ЗаМесяц, Было) * 0.01 Тогда
			Расходится.Добавить(Строка(Стр.Номенклатура) + ": рапорты " + ФорматЧисла(Стр.ЗаМесяц) + ", регистр " + ФорматЧисла(Было));
		КонецЕсли;
	КонецЦикла;
	Если Расходится.Количество() = 0 Тогда
		Возврат "С регистром «Выпуск продукции» за месяц совпадает.";
	КонецЕсли;
	Возврат "В регистре «Выпуск продукции» за месяц другие цифры по " + Расходится.Количество() + " поз. (рапорты не все проведены или регистр не заполнен): "
		+ Лев(СтрСоединить(Расходится, "; "), 600) + ".";

КонецФункции

&НаСервере
Функция ПолучитьВыпуск(П)

	// выпуск — из суточных рапортов («Производство без заказа», завершённые этапы производства);
	// если их нет — из регистра ERP «Выпуск продукции»; если и его нет — приход на склад документами производства
	СписокДокументов = ДокументыПроизводства(П);
	Начало = Мин(П.НачалоМесяца, П.Начало30);
	Запрос = Новый Запрос;
	ИзРегистра = Метаданные.РегистрыНакопления.Найти("ВыпускПродукции") <> Неопределено
		И ИзмерениеРегистра("ВыпускПродукции", "АналитикаУчетаНоменклатуры") <> ""
		И РесурсРегистра("ВыпускПродукции", "Количество") <> "";
	Если ИзРегистра И СписокДокументов.Количество() > 0 Тогда
		// регистр есть, но в этой базе может не вестись — тогда считаем по приходу на склад
		Проверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Период КАК Период ИЗ РегистрНакопления.ВыпускПродукции КАК Т ГДЕ Т.Период МЕЖДУ &Начало И &КонецДня");
		Проверка.УстановитьПараметр("Начало", Начало);
		Проверка.УстановитьПараметр("КонецДня", П.КонецДня);
		ИзРегистра = НЕ Проверка.Выполнить().Пустой();
	КонецЕсли;
	Рапорты = ВыпускПоРапортам(П, Начало);
	Если Рапорты.Строки.Количество() > 0 Тогда
		Строки = Рапорты.Строки.Скопировать(, "День, Номенклатура, Количество");
		Строки.Свернуть("День, Номенклатура", "Количество");
		Источник = "суточные рапорты: " + СтрСоединить(Рапорты.Источники, "; ");
		ПоследнийВыпуск = Неопределено;
		Для Каждого Стр Из Строки Цикл
			Если ПоследнийВыпуск = Неопределено ИЛИ Стр.День > ПоследнийВыпуск Тогда
				ПоследнийВыпуск = Стр.День;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ИзРегистра Тогда
		Условие = УсловиеОрганизации("ВыпускПродукции", П);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Период КАК День,
			|	Т.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|	СУММА(Т.КоличествоОборот) КАК Количество
			|ИЗ
			|	РегистрНакопления.ВыпускПродукции.Обороты(&Начало, &КонецДня, День" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
			|СГРУППИРОВАТЬ ПО
			|	Т.Период,
			|	Т.АналитикаУчетаНоменклатуры.Номенклатура";
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("Начало", Начало);
		Строки = Запрос.Выполнить().Выгрузить();
		Источник = "регистр «Выпуск продукции»";
		Запрос.Текст =
			"ВЫБРАТЬ
			|	МАКСИМУМ(Т.Период) КАК Дата
			|ИЗ
			|	РегистрНакопления.ВыпускПродукции КАК Т
			|ГДЕ
			|	Т.Период <= &КонецДня" + ?(Условие = "", "", "
			|	И Т." + Условие);
		Выборка = Запрос.Выполнить().Выбрать();
		ПоследнийВыпуск = ?(Выборка.Следующий(), Выборка.Дата, Неопределено);
	Иначе
		Если СписокДокументов.Количество() = 0 Тогда
			ВызватьИсключение "не найдены ни регистр «Выпуск продукции», ни документы выпуска";
		КонецЕсли;
		Ресурс = РесурсРегистра("ТоварыНаСкладах", "ВНаличии,Количество");
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК День,
			|	Т.Номенклатура КАК Номенклатура,
			|	СУММА(Т." + Ресурс + ") КАК Количество
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &Начало И &КонецДня
			|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|	И Т.Активность
			|	И " + УсловиеРегистратора(СписокДокументов) + "
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ),
			|	Т.Номенклатура";
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("Начало", Начало);
		Строки = Запрос.Выполнить().Выгрузить();
		Источник = "приход на склад документами " + СтрСоединить(СписокДокументов, ", ");
		ПоследнийВыпуск = Неопределено;
		Для Каждого Стр Из Строки Цикл
			Если ПоследнийВыпуск = Неопределено ИЛИ Стр.День > ПоследнийВыпуск Тогда
				ПоследнийВыпуск = Стр.День;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// план производства на этот и следующий месяц
	ДокументыМесяца = Новый Массив;
	ДокументыСледующего = Новый Массив;
	ПланМесяц = ПланПроизводства(П, П.НачалоМесяца, КонецМесяца(П.День), Неопределено, ДокументыМесяца);
	НачалоСледующего = ДобавитьМесяц(П.НачалоМесяца, 1);
	ПланСледующий = ПланПроизводства(П, НачалоСледующего, КонецМесяца(НачалоСледующего), Неопределено, ДокументыСледующего);
	// сколько по плану должно быть выпущено к дате отчёта: если план расписан по дням/неделям — по его датам,
	// если весь план месяца на одну дату (1-е число) — пропорционально прошедшим дням
	ПланДоДаты = ПланПроизводства(П, П.НачалоМесяца, КонецМесяца(П.День), КонецДня(П.День));
	ДнейВМесяце = День(КонецМесяца(П.День));
	ДнейПрошло = День(П.День);
	ПланПоДатам = Ложь;
	Для Каждого Стр Из ПланМесяц Цикл
		СтрДо = ПланДоДаты.Найти(Стр.Номенклатура, "Номенклатура");
		Если СтрДо = Неопределено ИЛИ СтрДо.Количество < Стр.Количество Тогда
			ПланПоДатам = ДнейПрошло < ДнейВМесяце;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ПоПродуктам = Новый ТаблицаЗначений;
	ПоПродуктам.Колонки.Добавить("Номенклатура");
	ПоПродуктам.Колонки.Добавить("Ед");
	ПоПродуктам.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	ПоПродуктам.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ЗаМесяц", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("За7Дней", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("За30Дней", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ПланМесяца", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ПланКДате", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("Спецификация");
	Для Каждого Стр Из Строки Цикл
		НовСтр = СтрокаПродукта(ПоПродуктам, Стр.Номенклатура);
		Если Стр.День = П.День Тогда
			НовСтр.ЗаДень = НовСтр.ЗаДень + Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.НачалоМесяца Тогда
			НовСтр.ЗаМесяц = НовСтр.ЗаМесяц + Стр.Количество;
		КонецЕсли;
		Если Стр.День > П.День - 7 * 86400 Тогда
			НовСтр.За7Дней = НовСтр.За7Дней + Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.Начало30 Тогда
			НовСтр.За30Дней = НовСтр.За30Дней + Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	ПолуфабрикатыПлана = Новый Соответствие;
	Для Каждого Стр Из ПланМесяц Цикл
		Если Стр.Полуфабрикат Тогда
			ПолуфабрикатыПлана.Вставить(Стр.Номенклатура, Истина);
		КонецЕсли;
		НовСтр = СтрокаПродукта(ПоПродуктам, Стр.Номенклатура);
		НовСтр.ПланМесяца = НовСтр.ПланМесяца + Стр.Количество;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда
			НовСтр.Спецификация = Стр.Спецификация;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ПланСледующий Цикл
		Если Стр.Полуфабрикат Тогда
			ПолуфабрикатыПлана.Вставить(Стр.Номенклатура, Истина);
		КонецЕсли;
		НовСтр = СтрокаПродукта(ПоПродуктам, Стр.Номенклатура);
		НовСтр.ПланСледующего = НовСтр.ПланСледующего + Стр.Количество;
		Если НЕ ЗначениеЗаполнено(НовСтр.Спецификация) И ЗначениеЗаполнено(Стр.Спецификация) Тогда
			НовСтр.Спецификация = Стр.Спецификация;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ПоПродуктам Цикл
		// полуфабрикат — по виду номенклатуры или по отметке в строке плана; в плане он тоже есть
		Стр.Полуфабрикат = ЭтоПолуфабрикат(Стр.Номенклатура) ИЛИ ПолуфабрикатыПлана[Стр.Номенклатура] <> Неопределено;
		Если ПланПоДатам Тогда
			СтрДо = ПланДоДаты.Найти(Стр.Номенклатура, "Номенклатура");
			Стр.ПланКДате = ?(СтрДо = Неопределено, 0, СтрДо.Количество);
		Иначе
			Стр.ПланКДате = Стр.ПланМесяца * ДнейПрошло / ДнейВМесяце;
		КонецЕсли;
	КонецЦикла;
	ПоПродуктам.Сортировать("Полуфабрикат, ПланМесяца Убыв, ЗаМесяц Убыв");

	// итоги складываются только в одной единице — той, в которой больше всего выпуска (обычно кг)
	ПоЕдиницам = ПоПродуктам.Скопировать(Новый Структура("Полуфабрикат", Ложь), "Ед, ЗаДень, ЗаМесяц, За7Дней, За30Дней, ПланМесяца, ПланСледующего, ПланКДате");
	ПоЕдиницам.Свернуть("Ед", "ЗаДень, ЗаМесяц, За7Дней, За30Дней, ПланМесяца, ПланСледующего, ПланКДате");
	ПоЕдиницам.Сортировать("ЗаМесяц Убыв, ПланМесяца Убыв");
	ГлавнаяЕд = ?(ПоЕдиницам.Количество() = 0, "", ПоЕдиницам[0].Ед);

	ПоДням = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Если ЕдиницаНоменклатуры(Стр.Номенклатура) = ГлавнаяЕд И НЕ ЭтоПолуфабрикатИзТаблицы(ПоПродуктам, Стр.Номенклатура) Тогда
			ПоДням.Вставить(Стр.День, ЧислоИлиНоль(ПоДням[Стр.День]) + Стр.Количество);
		КонецЕсли;
	КонецЦикла;
	История = Новый ТаблицаЗначений;
	История.Колонки.Добавить("Дата");
	История.Колонки.Добавить("Количество", ОписаниеЧисла());
	Для Д = 0 По 29 Цикл
		ДатаДня = П.Начало30 + Д * 86400;
		НовСтр = История.Добавить();
		НовСтр.Дата = ДатаДня;
		НовСтр.Количество = ЧислоИлиНоль(ПоДням[ДатаДня]);
	КонецЦикла;

	Главная = ?(ПоЕдиницам.Количество() = 0, Неопределено, ПоЕдиницам[0]);
	ЗаМесяц = ?(Главная = Неопределено, 0, Главная.ЗаМесяц);
	ПланМесяца = ?(Главная = Неопределено ИЛИ Главная.ПланМесяца = 0, П.ПланВСутки * ДнейВМесяце, Главная.ПланМесяца);
	ВСутки = ?(Главная = Неопределено, 0, Главная.За30Дней / 30);
	Р = Новый Структура;
	Р.Вставить("ПоПродуктам", ПоПродуктам);
	Р.Вставить("ПоЕдиницам", ПоЕдиницам);
	Р.Вставить("ГлавнаяЕд", ГлавнаяЕд);
	Р.Вставить("История", История);
	Р.Вставить("ЗаДень", ?(Главная = Неопределено, 0, Главная.ЗаДень));
	Р.Вставить("ЗаМесяц", ЗаМесяц);
	Р.Вставить("ВСутки", ВСутки);
	Р.Вставить("План", ПланМесяца / ДнейВМесяце);
	Р.Вставить("ПланМесяца", ПланМесяца);
	Р.Вставить("ЕстьПланПроизводства", ПланМесяц.Количество() > 0);
	Р.Вставить("ЕстьПланСледующего", ПланСледующий.Количество() > 0);
	Р.Вставить("Документы", СписокДокументов);
	Р.Вставить("Источник", Источник);
	Р.Вставить("ПоследнийВыпуск", ПоследнийВыпуск);
	Р.Вставить("ПланНаСегодня", ?(Главная <> Неопределено И Главная.ПланМесяца > 0, Главная.ПланКДате, ПланМесяца * ДнейПрошло / ДнейВМесяце));
	Р.Вставить("ПланПоДатам", ПланПоДатам);
	Р.Вставить("ПланСледующегоМесяца", ?(Главная = Неопределено, 0, Главная.ПланСледующего));
	Р.Вставить("ИмяСледующего", ИмяМесяца(Месяц(НачалоСледующего), Ложь));
	Р.Вставить("Прогноз", ЗаМесяц + ВСутки * (ДнейВМесяце - ДнейПрошло));
	Р.Вставить("ОсталосьДней", ДнейВМесяце - ДнейПрошло);
	Р.Вставить("ДокументыМесяца", ДокументыМесяца);
	Р.Вставить("ДокументыСледующего", ДокументыСледующего);
	Р.Вставить("НачалоСледующего", НачалоСледующего);
	Р.Вставить("ПоУчасткам", ?(Рапорты.Строки.Количество() = 0, Неопределено, НаработкаПоУчасткам(Рапорты.Строки, П, ПоПродуктам)));
	Р.Вставить("ЕстьСмены", Рапорты.ЕстьСмены);
	Сверка = "";
	Если Рапорты.Строки.Количество() > 0 Тогда
		Попытка
			Сверка = СверкаСРегистромВыпуска(ПоПродуктам, П);
		Исключение
			Сверка = "";
		КонецПопытки;
	КонецЕсли;
	Р.Вставить("СверкаРегистра", Сверка);
	Возврат Р;

КонецФункции

&НаСервере
Функция СтрокаПродукта(ПоПродуктам, Номенклатура)

	Стр = ПоПродуктам.Найти(Номенклатура, "Номенклатура");
	Если Стр = Неопределено Тогда
		Стр = ПоПродуктам.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Ед = ЕдиницаНоменклатуры(Номенклатура);
	КонецЕсли;
	Возврат Стр;

КонецФункции

&НаСервере
Функция ЭтоПолуфабрикат(Номенклатура)

	Вид = НРег(Строка(РеквизитСсылки(Номенклатура, "ВидНоменклатуры")));
	Возврат СтрНайти(Вид, "полуфабрикат") > 0;

КонецФункции

&НаСервере
Функция ЭтоПолуфабрикатИзТаблицы(ПоПродуктам, Номенклатура)

	Стр = ПоПродуктам.Найти(Номенклатура, "Номенклатура");
	Возврат Стр <> Неопределено И Стр.Полуфабрикат;

КонецФункции

&НаСервере
Функция ПланПроизводства(П, НачалоПериода, КонецПериода, ДоДаты = Неопределено, ДокументыПлана = Неопределено)

	// план на период — из ПОСЛЕДНЕГО по дате документа «План производства», составленного на этот месяц:
	// ВСЕ его строки, как в документе (даты строк не важны; если документ на несколько месяцев — строки с датой в месяце);
	// продукция и полуфабрикаты; отменённые документы и строки не берутся.
	// ДоДаты — только строки с датой выпуска не позже этой даты (план к дате отчёта).
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Количество", ОписаниеЧисла());
	Результат.Колонки.Добавить("Спецификация");
	Результат.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	Мета = Метаданные.Документы.Найти("ПланПроизводства");
	Если Мета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	// все табличные части плана с номенклатурой и количеством (продукция, полуфабрикаты…), кроме материалов;
	// документы — и проведённые, и записанные, кроме помеченных на удаление
	ДатаШапки = ?(Мета.Реквизиты.Найти("НачалоПериода") <> Неопределено, "Т.Ссылка.НачалоПериода", "Т.Ссылка.Дата");
	ОкончаниеШапки = ?(Мета.Реквизиты.Найти("ОкончаниеПериода") <> Неопределено, "Т.Ссылка.ОкончаниеПериода", ДатаШапки);
	Части = Новый Массив;
	Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
		ИмяТЧ = НРег(ТЧ.Имя);
		Реквизиты = ТЧ.Реквизиты;
		Если Реквизиты.Найти("Номенклатура") = Неопределено
			ИЛИ (Реквизиты.Найти("Количество") = Неопределено И Реквизиты.Найти("КоличествоУпаковок") = Неопределено)
			ИЛИ СтрНайти(ИмяТЧ, "материал") > 0 ИЛИ СтрНайти(ИмяТЧ, "ресурс") > 0 ИЛИ СтрНайти(ИмяТЧ, "трудо") > 0
			ИЛИ СтрНайти(ИмяТЧ, "услуг") > 0 ИЛИ СтрНайти(ИмяТЧ, "работ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Отборы = Новый Массив;
		Для Каждого Имя Из СтрРазделить("Отменено,Замещен", ",") Цикл
			Если Реквизиты.Найти(Имя) <> Неопределено Тогда
				Отборы.Добавить("НЕ Т." + Имя);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено Тогда
			// в планах организация часто не заполнена (план — по подразделению): такие тоже берём
			Отборы.Добавить("(Т.Ссылка.Организация = &Организация ИЛИ Т.Ссылка.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))");
		КонецЕсли;
		ДатаСтроки = РеквизитКоллекции(Реквизиты, "ДатаВыпуска,Период,ДатаПотребности,Дата");
		ПолеДаты = ?(ДатаСтроки <> "",
			"ВЫБОР КОГДА Т." + ДатаСтроки + " = ДАТАВРЕМЯ(1, 1, 1) ТОГДА " + ДатаШапки + " ИНАЧЕ Т." + ДатаСтроки + " КОНЕЦ", ДатаШапки);
		// количество в базовых единицах; если не пересчитано — из упаковок
		ВУпаковках = ВыражениеКоличестваУпаковок(ТЧ, "Т");
		Если Реквизиты.Найти("Количество") = Неопределено Тогда
			Количество = ВУпаковках;
		ИначеЕсли Реквизиты.Найти("КоличествоУпаковок") = Неопределено Тогда
			Количество = "Т.Количество";
		Иначе
			Количество = "ВЫБОР КОГДА Т.Количество <> 0 ТОГДА Т.Количество ИНАЧЕ " + ВУпаковках + " КОНЕЦ";
		КонецЕсли;
		ЭтоПолуфабрикаты = СтрНайти(ИмяТЧ, "полуфабрикат") > 0;
		Части.Добавить(
			"ВЫБРАТЬ
			|	Т.Ссылка КАК Документ,
			|	Т.Ссылка.Дата КАК ДатаДокумента,
			|	Т.Номенклатура КАК Номенклатура,
			|	НАЧАЛОПЕРИОДА(" + ПолеДаты + ", ДЕНЬ) КАК ДатаВыпуска,
			|	" + ?(Реквизиты.Найти("Спецификация") <> Неопределено, "Т.Спецификация", "НЕОПРЕДЕЛЕНО") + " КАК Спецификация,
			|	" + ?(Мета.Реквизиты.Найти("Сценарий") <> Неопределено, "Т.Ссылка.Сценарий", "НЕОПРЕДЕЛЕНО") + " КАК Сценарий,
			|	" + ?(Мета.Реквизиты.Найти("Статус") <> Неопределено, "Т.Ссылка.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус,
			|	" + ?(Мета.Реквизиты.Найти("Подразделение") <> Неопределено, "Т.Ссылка.Подразделение", "НЕОПРЕДЕЛЕНО") + " КАК Подразделение,
			|	" + ?(ЭтоПолуфабрикаты, "ИСТИНА", ?(Реквизиты.Найти("Полуфабрикат") <> Неопределено, "Т.Полуфабрикат", "ЛОЖЬ")) + " КАК Полуфабрикат,
			|	" + Количество + " КАК Количество
			|ИЗ
			|	Документ.ПланПроизводства." + ТЧ.Имя + " КАК Т
			|ГДЕ
			|	НЕ Т.Ссылка.ПометкаУдаления
			|	И (" + ДатаШапки + " >= &НачалоПлана И " + ОкончаниеШапки + " <= &КонецПлана
			|		ИЛИ " + ДатаШапки + " <= &КонецПлана И " + ОкончаниеШапки + " >= &НачалоПлана И " + ПолеДаты + " МЕЖДУ &НачалоПлана И &КонецПлана)" + ?(Отборы.Количество() = 0, "", "
			|	И " + СтрСоединить(Отборы, "
			|	И ")));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Части, "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|") + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаДокумента,
		|	Документ";
	Запрос.УстановитьПараметр("НачалоПлана", НачалоПериода);
	Запрос.УстановитьПараметр("Организация", П.Организация);
	Запрос.УстановитьПараметр("КонецПлана", КонецПериода);
	Строки = Запрос.Выполнить().Выгрузить();

	// план — ОДИН документ: последний по дате неотменённый «План производства» на этот месяц, все его строки
	// (так же, как «Суточный рапорт по заводу», которому этот документ передаётся параметром «Документ план»)
	ДокументМесяца = Неопределено;
	Для Каждого Стр Из Строки Цикл
		Если СтрНайти(НРег(Строка(Стр.Статус)), "отмен") = 0 Тогда
			ДокументМесяца = Стр.Документ; // строки упорядочены по дате документа
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Строки Цикл
		Если Стр.Документ <> ДокументМесяца Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ДокументыПлана) = Тип("Массив") И ДокументыПлана.Найти(Стр.Документ) = Неопределено Тогда
			ДокументыПлана.Добавить(Стр.Документ);
		КонецЕсли;
		Если ДоДаты <> Неопределено И Стр.ДатаВыпуска > ДоДаты Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
	КонецЦикла;
	Полуфабрикаты = Новый Соответствие;
	Для Каждого Стр Из Результат Цикл
		Если Стр.Полуфабрикат Тогда
			Полуфабрикаты.Вставить(Стр.Номенклатура, Истина);
		КонецЕсли;
	КонецЦикла;
	Спецификации = Новый Соответствие;
	Для Каждого Стр Из Результат Цикл
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда
			Спецификации.Вставить(Стр.Номенклатура, Стр.Спецификация);
		КонецЕсли;
	КонецЦикла;
	Результат.Свернуть("Номенклатура", "Количество");
	Результат.Колонки.Добавить("Спецификация");
	Результат.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	Для Каждого Стр Из Результат Цикл
		Стр.Спецификация = Спецификации[Стр.Номенклатура];
		Стр.Полуфабрикат = Полуфабрикаты[Стр.Номенклатура] <> Неопределено;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Заказы

&НаСервере
Функция ПолучитьЗаказы(П, Выпуск)

	// остаток к отгрузке: из регистра заказов, если он есть в конфигурации,
	// иначе по документам (заказано минус отгружено реализациями)
	Опис = ОписаниеРегистраЗаказов();
	Если Опис = Неопределено Тогда
		Открытые = ОстаткиЗаказовПоДокументам(П);
		Источник = "по документам: заказы клиентов минус реализации за 180 дней";
		ЕстьСумма = Истина;
	Иначе
		Открытые = ОстаткиЗаказовПоРегистру(Опис, П);
		Источник = "регистр " + Опис.Регистр;
		ЕстьСумма = Опис.РесСумма <> "";
	КонецЕсли;
	Открытые.Колонки.Добавить("Номер");
	Открытые.Колонки.Добавить("Клиент");
	Открытые.Колонки.Добавить("Срок");
	Открытые.Колонки.Добавить("Ед");
	Открытые.Колонки.Добавить("СоСклада", ОписаниеЧисла());
	Открытые.Колонки.Добавить("Покрытие");
	Открытые.Колонки.Добавить("Просрочка", ОписаниеЧисла());

	Кэш = Новый Соответствие;
	Для Каждого Стр Из Открытые Цикл
		Данные = Кэш[Стр.Заказ];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Номер, Клиент, Срок, Цены", "", "", Неопределено, Неопределено);
			Попытка
				Данные.Номер = Стр.Заказ.Номер;
			Исключение
				Данные.Номер = Строка(Стр.Заказ);
			КонецПопытки;
			Данные.Клиент = РеквизитСсылки(Стр.Заказ, "Контрагент,Партнер");
			Данные.Срок = РеквизитСсылки(Стр.Заказ, "ДатаОтгрузки,ЖелаемаяДатаОтгрузки,ДатаПоступления");
			Кэш.Вставить(Стр.Заказ, Данные);
		КонецЕсли;
		Стр.Номер = Данные.Номер;
		Стр.Клиент = Данные.Клиент;
		Стр.Срок = Данные.Срок;
		Стр.Ед = ЕдиницаНоменклатуры(Стр.Номенклатура);
		Если НЕ ЕстьСумма Тогда
			Стр.Сумма = Стр.Осталось * ЦенаВЗаказе(Стр.Заказ, Стр.Номенклатура);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Срок) Тогда
			Стр.Просрочка = Цел((П.День - НачалоДня(Стр.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;

	// склад готовой продукции по заказам в порядке сроков, остальное — из выпуска
	Склад = ОстаткиНаСкладах(Открытые.ВыгрузитьКолонку("Номенклатура"), П);
	Темп = Новый Соответствие;
	Если Выпуск <> Неопределено Тогда
		Для Каждого Стр Из Выпуск.ПоПродуктам Цикл
			Темп.Вставить(Стр.Номенклатура, Стр.За30Дней / 30);
		КонецЦикла;
	КонецЕсли;
	Открытые.Колонки.Добавить("Порядок");
	Для Каждого Стр Из Открытые Цикл
		Стр.Порядок = ?(ЗначениеЗаполнено(Стр.Срок), Стр.Срок, '39991231');
	КонецЦикла;
	Открытые.Сортировать("Порядок");
	Зарезервировано = Новый Соответствие;
	Услуги = Новый Соответствие;
	Для Каждого Стр Из Открытые Цикл
		ЕстьНаСкладе = ?(Склад[Стр.Номенклатура] = Неопределено, 0, Склад[Стр.Номенклатура]);
		Стр.СоСклада = Мин(ЕстьНаСкладе, Стр.Осталось);
		Склад.Вставить(Стр.Номенклатура, ЕстьНаСкладе - Стр.СоСклада);
		Нужно = Стр.Осталось - Стр.СоСклада;
		Если Услуги[Стр.Номенклатура] = Неопределено Тогда
			Услуги.Вставить(Стр.Номенклатура, ЭтоУслуга(Стр.Номенклатура));
		КонецЕсли;
		Если Услуги[Стр.Номенклатура] Тогда
			Стр.СоСклада = Стр.Осталось; // услуги не выпускаются и не лежат на складе
			Стр.Покрытие = "услуга";
		ИначеЕсли НЕ ЗначениеЗаполнено(Стр.Срок) Тогда
			Стр.Покрытие = "без срока";
		ИначеЕсли Нужно <= 0 Тогда
			Стр.Покрытие = ?(Стр.Просрочка > 0, "просрочен, есть на складе", "есть на складе");
		ИначеЕсли Стр.Просрочка > 0 Тогда
			Стр.Покрытие = "просрочен";
			// просроченный заказ всё равно занимает выпуск — следующие заказы ждут его
			Зарезервировано.Вставить(Стр.Номенклатура, ЧислоИлиНоль(Зарезервировано[Стр.Номенклатура]) + Нужно);
		Иначе
			Дней = Цел((НачалоДня(Стр.Срок) - П.День) / 86400);
			Уже = ?(Зарезервировано[Стр.Номенклатура] = Неопределено, 0, Зарезервировано[Стр.Номенклатура]);
			ВСутки = ?(Темп[Стр.Номенклатура] = Неопределено, 0, Темп[Стр.Номенклатура]);
			Стр.Покрытие = ?(ВСутки * Дней - Уже >= Нужно, "успеваем выпустить", "не успеваем");
			Зарезервировано.Вставить(Стр.Номенклатура, Уже + Нужно);
		КонецЕсли;
	КонецЦикла;

	// портфель по продуктам
	Продукты = Открытые.Скопировать(, "Номенклатура, Ед, Осталось, Сумма, СоСклада");
	Продукты.Колонки.Добавить("Заказов", ОписаниеЧисла());
	Продукты.ЗаполнитьЗначения(1, "Заказов");
	Продукты.Свернуть("Номенклатура, Ед", "Осталось, Сумма, СоСклада, Заказов");
	Продукты.Колонки.Добавить("Выпустить", ОписаниеЧисла());
	Продукты.Колонки.Добавить("ВСутки", ОписаниеЧисла());
	Продукты.Колонки.Добавить("Загрузка");
	Для Каждого Стр Из Продукты Цикл
		Стр.Выпустить = Стр.Осталось - Стр.СоСклада;
		Стр.ВСутки = ?(Темп[Стр.Номенклатура] = Неопределено, 0, Темп[Стр.Номенклатура]);
		Стр.Загрузка = ?(Стр.ВСутки > 0, Стр.Выпустить / Стр.ВСутки, Неопределено);
	КонецЦикла;
	Продукты.Сортировать("Сумма Убыв");

	Р = Новый Структура;
	Р.Вставить("Открытые", Открытые);
	Р.Вставить("Продукты", Продукты);
	Р.Вставить("Портфель", Открытые.Итог("Сумма"));
	Р.Вставить("Заказов", Открытые.Скопировать(, "Заказ").Количество());
	Свернутые = Открытые.Скопировать(, "Заказ");
	Свернутые.Свернуть("Заказ");
	Р.Заказов = Свернутые.Количество();
	Р.Вставить("Просроченные", ОтобратьСтроки(Открытые, "просроч"));
	Р.Вставить("НеУспеваем", ОтобратьСтроки(Открытые, "не успеваем"));
	Ближайшие = Открытые.СкопироватьКолонки();
	Для Каждого Стр Из Открытые Цикл
		Если ЗначениеЗаполнено(Стр.Срок) И Стр.Просрочка <= 0 И -Стр.Просрочка <= П.Горизонт Тогда
			ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Новые", НовыеЗаказы(П));
	Р.Вставить("Отгрузки", ОтгрузкиЗаМесяц(П));
	Р.Вставить("Источник", Источник);
	Возврат Р;

КонецФункции

&НаСервере
Функция ОписаниеРегистраЗаказов()

	// только регистр «Заказы клиентов»; в ERP 2.5 его нет — тогда остаток считается по документам
	Для Каждого Имя Из СтрРазделить("ЗаказыКлиентов", ",") Цикл
		Опис = ОписаниеРегистраЗаказовПоИмени(Имя, "");
		Если Опис <> Неопределено Тогда
			Возврат Опис;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ОписаниеРегистраЗаказовПоИмени(ИмяРегистра, ИмяИзмерения)

	Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИзмЗаказ = ?(ИмяИзмерения = "", ИзмерениеРегистра(ИмяРегистра, "ЗаказКлиента,Распоряжение,Заказ"), ИмяИзмерения);
	РесКоличество = РесурсРегистра(ИмяРегистра, "КОформлению,КОтгрузке,Заказано");
	Если ИзмЗаказ = "" ИЛИ РесКоличество = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Регистр, ИзмЗаказ, РесКоличество, РесСумма",
		ИмяРегистра, ИзмЗаказ, РесКоличество, РесурсРегистра(ИмяРегистра, "Сумма,СуммаРегл"));

