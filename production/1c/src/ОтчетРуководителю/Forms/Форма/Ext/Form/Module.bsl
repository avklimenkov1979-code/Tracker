&НаСервере
Функция РеквизитСсылки(Ссылка, Варианты)

	// первый из перечисленных реквизитов, который есть у объекта; иначе Неопределено
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		М = Ссылка.Метаданные();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если М.Реквизиты.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Значение = Ссылка[СокрЛП(Имя)];
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

