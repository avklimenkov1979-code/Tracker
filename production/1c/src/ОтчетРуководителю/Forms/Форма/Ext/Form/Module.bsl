&НаСервере
Процедура ВывестиГрафик(В, Точки, Серии, ВысотаСтрок = 12)

	// линейный график 1С (объект «Диаграмма») в табличном документе
	Верх = В.Строка;
	Попытка
		Рисунок = В.ТД.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Диаграмма);
		Рисунок.Расположить(В.ТД.Область(Верх, 1, Верх + ВысотаСтрок - 1, 8));
		Диаграмма = Рисунок.Объект;
		Диаграмма.Обновление = Ложь;
		Диаграмма.ТипДиаграммы = ТипДиаграммы.График;
		Диаграмма.ОтображатьЗаголовок = Ложь;
		Диаграмма.ОтображатьЛегенду = Серии.Количество() > 1;
		Подписи = Новый Массив;
		Для Каждого Подпись Из Точки Цикл
			Подписи.Добавить(Диаграмма.УстановитьТочку(Подпись));
		КонецЦикла;
		Для Каждого Опис Из Серии Цикл
			Серия = Диаграмма.УстановитьСерию(Опис.Имя);
			Для Индекс = 0 По Подписи.ВГраница() Цикл
				ЗначениеТочки = Опис.Значения[Индекс];
				Если ЗначениеТочки <> Неопределено Тогда
					Диаграмма.УстановитьЗначение(Подписи[Индекс], Серия, ЗначениеТочки);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Диаграмма.Обновление = Истина;
		В.Строка = Верх + ВысотаСтрок;
	Исключение
		// диаграмма недоступна — остаются таблицы
		В.Строка = Верх;
	КонецПопытки;

