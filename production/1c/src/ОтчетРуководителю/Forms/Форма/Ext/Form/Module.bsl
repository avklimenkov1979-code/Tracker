// Отчёт руководителю за день: деньги, долги, заказы, выпуск, нехватка сырья.
// Внешняя обработка для 1С:ERP Управление предприятием 2.4 / 2.5 (платформа 8.3.10+).
// Собирается из этой папки файлом СОБРАТЬ.bat (см. production/1c/README.md).
//
// Это модуль основной формы. Реквизиты и элементы формы создаются из кода
// в ПриСозданииНаСервере, поэтому Form.xml почти пустой.
//
// Регистры и поля ищутся по метаданным, поэтому отчёт переносит разницу между
// релизами ERP. Если какой-то раздел не получится собрать, отчёт покажет текст
// ошибки в этом разделе, а остальные разделы сформирует как обычно.
// Все запросы — в функциях Получить*(): их и правят, если в базе что-то иначе.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизитыФормы();
	СоздатьЭлементыФормы();
	ЗагрузитьНастройки();
	ЭтаФорма["ДатаОтчета"] = НачалоДня(ТекущаяДатаСеанса());
	ЭтаФорма.Заголовок = "Отчёт руководителю";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтаФорма["ДатаОтчета"]) Тогда
		ПоказатьПредупреждение(, "Укажите дату отчёта.");
		Возврат;
	КонецЕсли;
	Состояние("Формирую отчёт руководителю...");
	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура Вчера(Команда)

	ЭтаФорма["ДатаОтчета"] = НачалоДня(ЭтаФорма["ДатаОтчета"]) - 86400;
	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура Сегодня(Команда)

	ЭтаФорма["ДатаОтчета"] = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса());
	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибке(Команда)

	Состояние("Собираю сведения об ошибке...");
	Адрес = ОтчетОбОшибкеНаСервере(СведенияОКлиенте());
	ИмяФайла = "Ошибка_отчет_руководителю_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	ПоказатьОповещениеПользователя("Сохраните файл и пришлите его в чат", , ИмяФайла);
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)

	Состояние("Собираю сведения о базе для настройки отчёта...");
	Адрес = ДиагностикаНаСервере();
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, "Диагностика_отчета_руководителю.txt");
	Исключение
		ПоказатьПредупреждение(, "Текст диагностики показан в окне. Сохраните его: Ещё → Сохранить как, и пришлите файл.");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СообщениеОбОшибке

// Кнопка «Сообщить об ошибке» собирает в один текстовый файл всё, что нужно, чтобы найти причину:
// версии программы, 1С и конфигурации, настройки отчёта, полный текст ошибок разделов
// (с номером строки модуля), сообщения на экране и ошибки из журнала регистрации за 2 часа.
// Названий контрагентов и сумм в файле нет — только тексты ошибок.

&НаКлиенте
Процедура Сформировать()

	Попытка
		СформироватьНаСервере();
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Формирование отчёта", ПодробноеПредставлениеОшибки(Инфо));
		ПоказатьПредупреждение(, "Отчёт не сформировался:" + Символы.ПС + КраткоеПредставлениеОшибки(Инфо) + Символы.ПС + Символы.ПС
			+ "Нажмите «Сообщить об ошибке» и пришлите сохранённый файл в чат.");
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция СведенияОКлиенте()

	Сведения = Новый Структура("Платформа, ОС, Сообщения", "", "", "");
	Попытка
		СисИнфо = Новый СистемнаяИнформация;
		Сведения.Платформа = СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + ")";
		Сведения.ОС = СисИнфо.ВерсияОС;
	Исключение
		// не критично
	КонецПопытки;
	Возврат Сведения;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьЗаписьЖурнала(Знач Журнал, Где, ТекстОшибки)

	Запись = "[" + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + Где + ":" + Символы.ПС + ТекстОшибки;
	Если ПустаяСтрока(Журнал) Тогда
		Возврат Запись;
	КонецЕсли;
	Возврат Журнал + Символы.ПС + Символы.ПС + Запись;

КонецФункции

&НаСервере
Процедура ЗапомнитьОшибкуРаздела(Р, Раздел, Инфо)

	Р.Ошибки.Вставить(Раздел, КраткоеПредставлениеОшибки(Инфо));
	ЭтаФорма["ЖурналОшибок"] = ДобавитьЗаписьЖурнала(ЭтаФорма["ЖурналОшибок"], "Раздел «" + Раздел + "»", ПодробноеПредставлениеОшибки(Инфо));

КонецПроцедуры

&НаСервере
Функция ВерсияПрограммы()

	Попытка
		Возврат РеквизитФормыВЗначение("Объект").СведенияОВнешнейОбработке().Версия;
	Исключение
		Возврат "не определена";
	КонецПопытки;

КонецФункции

&НаСервере
Функция ОтчетОбОшибкеНаСервере(СведенияКлиента)

	Строки = Новый Массив;
	Строки.Добавить("СООБЩЕНИЕ ОБ ОШИБКЕ: Отчёт руководителю, версия " + ВерсияПрограммы());
	Строки.Добавить("Составлено: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'") + ", пользователь: " + ИмяПользователя());
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия);
	Попытка
		СисИнфо = Новый СистемнаяИнформация;
		Строки.Добавить("1С на сервере: " + СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + ")");
	Исключение
		// не критично
	КонецПопытки;
	Строки.Добавить("1С на компьютере: " + СведенияКлиента.Платформа + "; " + СведенияКлиента.ОС);
	Строки.Добавить("База: " + ?(СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "file=") > 0, "файловая", "на сервере 1С"));

	Строки.Добавить("");
	Строки.Добавить("НАСТРОЙКИ ОТЧЁТА");
	Для Каждого ИмяНастройки Из СтрРазделить("ДатаОтчета,Организация,ГруппаСырья,СтатьиСырья,ПланВыпускаВСутки,НеснижаемыйОстаток,ГоризонтДней,СрокПоставкиДней,РезервДней,КрупныйПлатеж", ",") Цикл
		Строки.Добавить("  " + ИмяНастройки + " = " + ЭтаФорма[ИмяНастройки]);
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ ПРИ ПОСЛЕДНЕМ ФОРМИРОВАНИИ");
	Строки.Добавить(?(ПустаяСтрока(ЭтаФорма["ЖурналОшибок"]), "  нет (если отчёт показывает неверные цифры — нажмите ещё «Диагностика» и пришлите оба файла)", ЭтаФорма["ЖурналОшибок"]));

	Если НЕ ПустаяСтрока(СведенияКлиента.Сообщения) Тогда
		Строки.Добавить("");
		Строки.Добавить("СООБЩЕНИЯ НА ЭКРАНЕ");
		Строки.Добавить(СведенияКлиента.Сообщения);
	КонецЕсли;

	ДобавитьЖурналРегистрации(Строки);

	Текст = СтрСоединить(Строки, Символы.ПС);
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ДобавитьЖурналРегистрации(Строки)

	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ ИЗ ЖУРНАЛА РЕГИСТРАЦИИ ЗА 2 ЧАСА (этот пользователь)");
	Попытка
		ТаблицаЖурнала = Новый ТаблицаЗначений;
		Отбор = Новый Структура;
		Отбор.Вставить("ДатаНачала", ТекущаяДатаСеанса() - 7200);
		Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
		Отбор.Вставить("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь());
		ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, , , 200);
		Если ТаблицаЖурнала.Количество() = 0 Тогда
			Строки.Добавить("  нет");
		КонецЕсли;
		Первая = Макс(0, ТаблицаЖурнала.Количество() - 20);
		Для Индекс = Первая По ТаблицаЖурнала.Количество() - 1 Цикл
			ЗаписьЖ = ТаблицаЖурнала[Индекс];
			Строки.Добавить("[" + Формат(ЗаписьЖ.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + ЗаписьЖ.Событие + ": " + Лев(ЗаписьЖ.Комментарий, 3000));
		КонецЦикла;
	Исключение
		Строки.Добавить("  недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ФормаИзКода

&НаСервере
Процедура СоздатьРеквизитыФормы()

	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ТипДни = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный));

	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаОтчета", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), , "Дата"));
	Добавляемые.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Добавляемые.Добавить(Новый РеквизитФормы("ГруппаСырья", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), , "Группа сырья"));
	Добавляемые.Добавить(Новый РеквизитФормы("ПланВыпускаВСутки", ТипЧисло, , "План выпуска в сутки"));
	Добавляемые.Добавить(Новый РеквизитФормы("СтатьиСырья", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)), , "Статьи калькуляции основного сырья"));
	Добавляемые.Добавить(Новый РеквизитФормы("НеснижаемыйОстаток", ТипЧисло, , "Неснижаемый остаток, руб."));
	Добавляемые.Добавить(Новый РеквизитФормы("ГоризонтДней", ТипДни, , "Прогноз, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("СрокПоставкиДней", ТипДни, , "Срок поставки сырья, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("РезервДней", ТипДни, , "Резерв сверх срока поставки, дней"));
	Добавляемые.Добавить(Новый РеквизитФормы("КрупныйПлатеж", ТипЧисло, , "Крупный платёж от, руб."));
	Добавляемые.Добавить(Новый РеквизитФормы("ДокументОтчета", Новый ОписаниеТипов("ТабличныйДокумент"), , "Отчёт"));
	Добавляемые.Добавить(Новый РеквизитФормы("ЖурналОшибок", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(Добавляемые);

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы()

	Команда = Команды.Добавить("СформироватьОтчет");
	Команда.Заголовок = "Сформировать";
	Команда.Действие = "СформироватьОтчет";
	Команда.Подсказка = "Собрать отчёт на выбранную дату";

	Команда = Команды.Добавить("Вчера");
	Команда.Заголовок = "← Вчера";
	Команда.Действие = "Вчера";

	Команда = Команды.Добавить("Диагностика");
	Команда.Заголовок = "Диагностика";
	Команда.Действие = "Диагностика";
	Команда.Подсказка = "Собрать сведения о базе в файл — для настройки отчёта под вашу базу";

	Команда = Команды.Добавить("СообщитьОбОшибке");
	Команда.Заголовок = "Сообщить об ошибке";
	Команда.Действие = "СообщитьОбОшибке";
	Команда.Подсказка = "Собрать в один файл тексты ошибок и версии программы и 1С, чтобы прислать его в чат";

	Команда = Команды.Добавить("Сегодня");
	Команда.Заголовок = "Сегодня";
	Команда.Действие = "Сегодня";

	// командная панель формы: свойство формы, а не элемент «КоманднаяПанель»
	Панель = Элементы.Найти("ФормаКоманднаяПанель");
	Если Панель = Неопределено Тогда
		Панель = ЭтаФорма.КоманднаяПанель;
	КонецЕсли;
	Кнопка = Элементы.Добавить("КнопкаСформировать", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "СформироватьОтчет";
	Кнопка.КнопкаПоУмолчанию = Истина;
	Кнопка = Элементы.Добавить("КнопкаВчера", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "Вчера";
	Кнопка = Элементы.Добавить("КнопкаСегодня", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "Сегодня";
	Кнопка = Элементы.Добавить("КнопкаДиагностика", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "Диагностика";
	Кнопка = Элементы.Добавить("КнопкаСообщитьОбОшибке", Тип("КнопкаФормы"), Панель);
	Кнопка.ИмяКоманды = "СообщитьОбОшибке";

	Группа = Элементы.Добавить("ГруппаОсновные", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Группа.ОтображатьЗаголовок = Ложь;
	ДобавитьПоле("ДатаОтчета", Группа);
	ДобавитьПоле("Организация", Группа, "Пусто — все организации");

	Группа = Элементы.Добавить("ГруппаНастройки", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Настройки отчёта";
	Попытка
		Группа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
		Группа.Скрыта = Истина;
	Исключение
		// старая платформа: группа просто показывается раскрытой
	КонецПопытки;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Строка1 = Элементы.Добавить("ГруппаНастройки1", Тип("ГруппаФормы"), Группа);
	Строка1.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Строка1.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Строка1.ОтображатьЗаголовок = Ложь;
	Строка2 = Элементы.Добавить("ГруппаНастройки2", Тип("ГруппаФормы"), Группа);
	Строка2.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Строка2.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Строка2.ОтображатьЗаголовок = Ложь;
	ДобавитьПоле("ГруппаСырья", Строка1, "Папка номенклатуры с сырьём. Пусто — всё, что списывалось в производство за 30 дней");
	ДобавитьПоле("ПланВыпускаВСутки", Строка1, "Нужен, только если нет документов «План производства». В основной единице продукции (обычно кг)");
	ДобавитьПоле("СтатьиСырья", Строка1, "Какое сырьё считать основным: части названий статей калькуляции через запятую");
	ДобавитьПоле("НеснижаемыйОстаток", Строка1);
	ДобавитьПоле("ГоризонтДней", Строка2);
	ДобавитьПоле("СрокПоставкиДней", Строка2);
	ДобавитьПоле("РезервДней", Строка2);
	ДобавитьПоле("КрупныйПлатеж", Строка2);

	Поле = Элементы.Добавить("ДокументОтчета", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	Поле.ПутьКДанным = "ДокументОтчета";
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоле(Имя, Родитель, Подсказка = "")

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = Имя;
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Поле.Подсказка = Подсказка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()

	ЭтаФорма["ГоризонтДней"] = 7;
	ЭтаФорма["СрокПоставкиДней"] = 7;
	ЭтаФорма["РезервДней"] = 3;
	ЭтаФорма["КрупныйПлатеж"] = 3000000;
	ЭтаФорма["СтатьиСырья"] = "Сырье основное";
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("ОтчетРуководителю", "Настройки");
	Если ТипЗнч(Сохраненные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Сохраненные Цикл
		Попытка
			ЭтаФорма[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		Исключение
			// реквизит переименован в новой версии отчёта — пропускаем
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()

	Настройки = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Организация,ГруппаСырья,ПланВыпускаВСутки,СтатьиСырья,НеснижаемыйОстаток,ГоризонтДней,СрокПоставкиДней,РезервДней,КрупныйПлатеж", ",") Цикл
		Настройки.Вставить(Имя, ЭтаФорма[Имя]);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ОтчетРуководителю", "Настройки", Настройки);

КонецПроцедуры

#КонецОбласти

#Область Формирование

&НаСервере
Функция ПараметрыОтчета()

	ДеньОтчета = НачалоДня(ЭтаФорма["ДатаОтчета"]);
	П = Новый Структура;
	П.Вставить("День", ДеньОтчета);
	П.Вставить("НачалоДня", ДеньОтчета);
	П.Вставить("КонецДня", КонецДня(ДеньОтчета));
	П.Вставить("Граница", Новый Граница(КонецДня(ДеньОтчета), ВидГраницы.Включая));
	П.Вставить("НачалоМесяца", НачалоМесяца(ДеньОтчета));
	П.Вставить("Начало14", ДеньОтчета - 13 * 86400);
	П.Вставить("Начало30", ДеньОтчета - 29 * 86400);
	П.Вставить("НачалоДенег", Мин(НачалоМесяца(ДеньОтчета), ДеньОтчета - 13 * 86400));
	П.Вставить("НачалоПрошлогоМесяца", ДобавитьМесяц(НачалоМесяца(ДеньОтчета), -1));
	П.Вставить("КонецПрошлогоПериода", КонецДня(ДобавитьМесяц(ДеньОтчета, -1)));
	П.Вставить("Организация", ЭтаФорма["Организация"]);
	П.Вставить("ГруппаСырья", ЭтаФорма["ГруппаСырья"]);
	П.Вставить("ПланВСутки", ЭтаФорма["ПланВыпускаВСутки"]);
	П.Вставить("СтатьиСырья", ?(ПустаяСтрока(ЭтаФорма["СтатьиСырья"]), "Сырье основное", ЭтаФорма["СтатьиСырья"]));
	П.Вставить("НеснижаемыйОстаток", ЭтаФорма["НеснижаемыйОстаток"]);
	П.Вставить("Горизонт", Макс(1, ЭтаФорма["ГоризонтДней"]));
	П.Вставить("СрокПоставки", ЭтаФорма["СрокПоставкиДней"]);
	П.Вставить("Резерв", ЭтаФорма["РезервДней"]);
	П.Вставить("КрупныйПлатеж", ЭтаФорма["КрупныйПлатеж"]);
	Возврат П;

КонецФункции

&НаСервере
Процедура СформироватьНаСервере()

	СохранитьНастройки();
	ЭтаФорма["ЖурналОшибок"] = "";

	П = ПараметрыОтчета();

	Р = Новый Структура;
	Р.Вставить("Ошибки", Новый Соответствие);
	Р.Вставить("Сигналы", НоваяТаблицаСигналов());

	Р.Вставить("Долги", Неопределено);
	Попытка
		Р.Долги = Новый Структура("НамДолжны, МыДолжны",
			ПолучитьДолги("РасчетыСКлиентамиПоСрокам", "РасчетыСКлиентами", П),
			ПолучитьДолги("РасчетыСПоставщикамиПоСрокам", "РасчетыСПоставщиками", П));
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Долги", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Деньги", Неопределено);
	Попытка
		Р.Деньги = ПолучитьДеньги(П, Р.Долги);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Деньги", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Выпуск", Неопределено);
	Попытка
		Р.Выпуск = ПолучитьВыпуск(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Выпуск", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Заказы", Неопределено);
	Попытка
		Р.Заказы = ПолучитьЗаказы(П, Р.Выпуск);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Заказы", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Сырье", Неопределено);
	Попытка
		Р.Сырье = ПолучитьСырье(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Сырье", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Продажи", Неопределено);
	Попытка
		Р.Продажи = ПолучитьПродажи(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Продажи", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Маржа", Неопределено);
	Попытка
		Р.Маржа = ПолучитьМаржу(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Маржа", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Закупки", Неопределено);
	Попытка
		Р.Закупки = ПолучитьОбороты("ПриобретениеТоваровУслуг", П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Закупки", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("ЗакупкиГод", Неопределено);
	Попытка
		Р.ЗакупкиГод = ПолучитьЗакупкиГод(П);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "ЗакупкиГод", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Запасы", Неопределено);
	Попытка
		Р.Запасы = ПолучитьЗапасы(П, Р.Выпуск, Р.Продажи, Р.Заказы);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Запасы", ИнформацияОбОшибке());
	КонецПопытки;

	Р.Вставить("Потребность", Неопределено);
	Попытка
		Р.Потребность = ПолучитьПотребность(П, Р);
	Исключение
		ЗапомнитьОшибкуРаздела(Р, "Потребность", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ОставитьОсновноеВЗакупках(Р);
	Исключение
		// если не получилось — закупки показываются целиком
	КонецПопытки;

	СобратьСигналы(Р, П);
	ЭтаФорма["ДокументОтчета"] = Вывести(Р, П);

КонецПроцедуры

#КонецОбласти

#Область Деньги

&НаСервере
Функция ПолучитьДеньги(П, Долги)

	Р = Новый Структура;
	Счета = Новый ТаблицаЗначений;
	Счета.Колонки.Добавить("Вид");
	Счета.Колонки.Добавить("Счет");
	Счета.Колонки.Добавить("Вчера", ОписаниеЧисла());
	Счета.Колонки.Добавить("Сегодня", ОписаниеЧисла());

	Платежи = Новый ТаблицаЗначений;
	Платежи.Колонки.Добавить("Документ");
	Платежи.Колонки.Добавить("День");
	Платежи.Колонки.Добавить("Приход", ОписаниеЧисла());
	Платежи.Колонки.Добавить("Расход", ОписаниеЧисла());

	Регистры = Новый Массив;
	Регистры.Добавить(Новый Структура("Регистр, Измерение, Вид", "ДенежныеСредстваБезналичные", "БанковскийСчет,Счет", "Банк"));
	Регистры.Добавить(Новый Структура("Регистр, Измерение, Вид", "ДенежныеСредстваНаличные", "Касса", "Касса"));

	Для Каждого Опис Из Регистры Цикл
		Если Метаданные.РегистрыНакопления.Найти(Опис.Регистр) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = РесурсРегистра(Опис.Регистр, "СуммаРегл,Сумма");
		Измерение = ИзмерениеРегистра(Опис.Регистр, Опис.Измерение);
		Условие = УсловиеОрганизации(Опис.Регистр, П);

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т." + Измерение + " КАК Счет,
			|	Т." + Ресурс + "НачальныйОстаток КАК Вчера,
			|	Т." + Ресурс + "КонечныйОстаток КАК Сегодня
			|ИЗ
			|	РегистрНакопления." + Опис.Регистр + ".ОстаткиИОбороты(&НачалоДня, &КонецДня" + ?(Условие = "", "", ", , , " + Условие) + ") КАК Т";
		УстановитьПараметры(Запрос, П);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Вчера = 0 И Выборка.Сегодня = 0 Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Счета.Добавить();
			НовСтр.Вид = Опис.Вид;
			НовСтр.Счет = Выборка.Счет;
			НовСтр.Вчера = Выборка.Вчера;
			НовСтр.Сегодня = Выборка.Сегодня;
		КонецЦикла;

		// движения за месяц по документам: приход и расход каждого документа
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Регистратор КАК Документ,
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК День,
			|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Приход,
			|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) ТОГДА Т." + Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Расход
			|ИЗ
			|	РегистрНакопления." + Опис.Регистр + " КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &НачалоДенег И &КонецДня
			|	И Т.Активность" + ?(Условие = "", "", "
			|	И Т." + Условие) + "
			|СГРУППИРОВАТЬ ПО
			|	Т.Регистратор,
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Платежи.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;

	Платежи.Свернуть("Документ, День", "Приход, Расход");
	Счета.Сортировать("Вид, Сегодня Убыв");
	Р.Вставить("Счета", Счета);
	Р.Вставить("Итого", Счета.Итог("Сегодня"));
	Р.Вставить("ИтогоВчера", Счета.Итог("Вчера"));

	// реквизиты платёжных документов месяца одним запросом на вид документа
	ДокументыМесяца = Новый Массив;
	Для Каждого Пл Из Платежи Цикл
		Если Пл.День >= П.НачалоМесяца И НЕ ЭтоПеремещениеДенег(Пл) Тогда
			ДокументыМесяца.Добавить(Пл.Документ);
		КонецЕсли;
	КонецЦикла;
	Поля = Новый Структура;
	Поля.Вставить("Контрагент", "Контрагент,Партнер,ПодотчетноеЛицо,Получатель,Плательщик");
	Поля.Вставить("Статья", "СтатьяДвиженияДенежныхСредств,СтатьяДДС");
	Поля.Вставить("Назначение", "НазначениеПлатежа,Основание,Комментарий");
	Реквизиты = Новый Соответствие;
	Если ДокументыМесяца.Количество() <= 3000 Тогда
		Реквизиты = РеквизитыДокументов(ДокументыМесяца, Поля);
	КонецЕсли;

	ЗаДень = Новый ТаблицаЗначений;
	ЗаДень.Колонки.Добавить("Вид");
	ЗаДень.Колонки.Добавить("Документ");
	ЗаДень.Колонки.Добавить("Контрагент");
	ЗаДень.Колонки.Добавить("Статья");
	ЗаДень.Колонки.Добавить("Назначение");
	ЗаДень.Колонки.Добавить("Сумма", ОписаниеЧисла());
	ЗаМесяц = ЗаДень.СкопироватьКолонки();
	ЗаМесяц.Колонки.Добавить("Приход", ОписаниеЧисла());
	ЗаМесяц.Колонки.Добавить("Расход", ОписаниеЧисла());
	Приход = 0;
	Расход = 0;
	ПриходМесяц = 0;
	РасходМесяц = 0;
	Перемещений = 0;
	ЧистоПоДням = Новый Соответствие;
	Для Каждого Пл Из Платежи Цикл
		ЧистоПоДням.Вставить(Пл.День, ЧислоИлиНоль(ЧистоПоДням[Пл.День]) + Пл.Приход - Пл.Расход);
		Если Пл.День < П.НачалоМесяца Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоПеремещениеДенег(Пл) Тогда
			Если Пл.День = П.День Тогда
				Перемещений = Перемещений + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПриходМесяц = ПриходМесяц + Пл.Приход;
		РасходМесяц = РасходМесяц + Пл.Расход;
		Рекв = Реквизиты[Пл.Документ];
		Если Рекв = Неопределено Тогда
			Рекв = Новый Структура("Контрагент, Статья, Назначение");
		КонецЕсли;
		НовСтр = ЗаМесяц.Добавить();
		НовСтр.Документ = Пл.Документ;
		НовСтр.Контрагент = Рекв.Контрагент;
		НовСтр.Статья = ?(ЗначениеЗаполнено(Рекв.Статья), Рекв.Статья, "Статья не указана");
		НовСтр.Приход = Пл.Приход;
		НовСтр.Расход = Пл.Расход;
		Если Пл.День <> П.День Тогда
			Продолжить;
		КонецЕсли;
		Приход = Приход + Пл.Приход;
		Расход = Расход + Пл.Расход;
		Сальдо = Пл.Приход - Пл.Расход;
		НовСтр = ЗаДень.Добавить();
		НовСтр.Вид = ?(Сальдо >= 0, "приход", "расход");
		НовСтр.Документ = Пл.Документ;
		НовСтр.Сумма = Макс(Сальдо, -Сальдо);
		НовСтр.Контрагент = Рекв.Контрагент;
		НовСтр.Статья = Рекв.Статья;
		НовСтр.Назначение = Рекв.Назначение;
	КонецЦикла;
	ЗаДень.Сортировать("Вид Убыв, Сумма Убыв");
	Р.Вставить("Платежи", ЗаДень);
	Р.Вставить("Приход", Приход);
	Р.Вставить("Расход", Расход);
	Р.Вставить("ПриходМесяц", ПриходМесяц);
	Р.Вставить("РасходМесяц", РасходМесяц);
	Р.Вставить("Перемещений", Перемещений);

	Расшифровка = Новый Соответствие;
	Если ДокументыМесяца.Количество() <= 3000 Тогда
		Расшифровка = СтатьиИзРасшифровки(ДокументыМесяца);
	КонецЕсли;
	ПоСтатьям = Новый ТаблицаЗначений;
	ПоСтатьям.Колонки.Добавить("Статья");
	ПоСтатьям.Колонки.Добавить("Приход", ОписаниеЧисла());
	ПоСтатьям.Колонки.Добавить("Расход", ОписаниеЧисла());
	Для Каждого Стр Из ЗаМесяц Цикл
		Части = Расшифровка[Стр.Документ];
		Всего = 0;
		Если Части <> Неопределено Тогда
			Для Каждого Часть Из Части Цикл
				Всего = Всего + Часть.Сумма;
			КонецЦикла;
		КонецЕсли;
		Если Всего = 0 Тогда
			ЗаполнитьЗначенияСвойств(ПоСтатьям.Добавить(), Стр);
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из Части Цикл
			НовСтр = ПоСтатьям.Добавить();
			НовСтр.Статья = ?(ЗначениеЗаполнено(Часть.Статья), Часть.Статья, "Статья не указана");
			НовСтр.Приход = Стр.Приход * Часть.Сумма / Всего;
			НовСтр.Расход = Стр.Расход * Часть.Сумма / Всего;
		КонецЦикла;
	КонецЦикла;
	ПоСтатьям.Свернуть("Статья", "Приход, Расход");
	ПоСтатьям.Колонки.Добавить("Оборот", ОписаниеЧисла());
	Для Каждого Стр Из ПоСтатьям Цикл
		Стр.Оборот = Стр.Приход + Стр.Расход;
	КонецЦикла;
	ПоСтатьям.Сортировать("Оборот Убыв");
	Р.Вставить("ПоСтатьям", ПоСтатьям);
	ПоКонтрагентам = ЗаМесяц.Скопировать(, "Контрагент, Приход, Расход");
	ПоКонтрагентам.Свернуть("Контрагент", "Приход, Расход");
	ПоКонтрагентам.Сортировать("Расход Убыв");
	Получатели = ПоКонтрагентам.СкопироватьКолонки();
	Для Каждого Стр Из ПоКонтрагентам Цикл
		Если Стр.Расход > 0 И Получатели.Количество() < 10 Тогда
			ЗаполнитьЗначенияСвойств(Получатели.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	ПоКонтрагентам.Сортировать("Приход Убыв");
	Плательщики = ПоКонтрагентам.СкопироватьКолонки();
	Для Каждого Стр Из ПоКонтрагентам Цикл
		Если Стр.Приход > 0 И Плательщики.Количество() < 10 Тогда
			ЗаполнитьЗначенияСвойств(Плательщики.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Р.Вставить("Плательщики", Плательщики);
	Р.Вставить("Получатели", Получатели);

	Р.Вставить("Динамика", ОстаткиДенегПоДням(П));
	Возврат Р;

КонецФункции

&НаСервере
Функция ОстаткиДенегПоДням(П)

	// остаток денег на конец каждого из 14 дней — прямо из остатков регистров
	Динамика = Новый ТаблицаЗначений;
	Динамика.Колонки.Добавить("Дата");
	Динамика.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Для Д = 0 По 13 Цикл
		НовСтр = Динамика.Добавить();
		НовСтр.Дата = П.День - (13 - Д) * 86400;
	КонецЦикла;
	Для Каждого ИмяРегистра Из СтрРазделить("ДенежныеСредстваБезналичные,ДенежныеСредстваНаличные", ",") Цикл
		Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = РесурсРегистра(ИмяРегистра, "СуммаРегл,Сумма");
		Условие = УсловиеОрганизации(ИмяРегистра, П);
		Части = Новый Массив;
		Запрос = Новый Запрос;
		Для Каждого Стр Из Динамика Цикл
			Номер = Формат(Динамика.Индекс(Стр), "ЧН=0; ЧГ=0");
			Части.Добавить("ВЫБРАТЬ " + Номер + " КАК Номер, ЕСТЬNULL(СУММА(Т" + Номер + "." + Ресурс + "Остаток), 0) КАК Остаток
			|ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(&Граница" + Номер + ?(Условие = "", "", ", " + Условие) + ") КАК Т" + Номер);
			Запрос.УстановитьПараметр("Граница" + Номер, Новый Граница(КонецДня(Стр.Дата), ВидГраницы.Включая));
		КонецЦикла;
		Запрос.Текст = СтрСоединить(Части, "
		|ОБЪЕДИНИТЬ ВСЕ
		|");
		Запрос.УстановитьПараметр("Организация", П.Организация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Динамика[Выборка.Номер].Остаток = Динамика[Выборка.Номер].Остаток + Выборка.Остаток;
		КонецЦикла;
	КонецЦикла;
	Возврат Динамика;

КонецФункции

&НаСервере
Функция СтатьиИзРасшифровки(Ссылки)

	// статьи ДДС из табличной части «Расшифровка платежа» платёжных документов:
	// документ → массив (статья, сумма)
	Результат = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Попытка
			ИмяВида = Ссылка.Метаданные().Имя;
		Исключение
			Продолжить;
		КонецПопытки;
		Если ПоВидам[ИмяВида] = Неопределено Тогда
			ПоВидам.Вставить(ИмяВида, Новый Массив);
		КонецЕсли;
		ПоВидам[ИмяВида].Добавить(Ссылка);
	КонецЦикла;
	Для Каждого Элемент Из ПоВидам Цикл
		Мета = Метаданные.Документы.Найти(Элемент.Ключ);
		Если Мета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТЧ = Мета.ТабличныеЧасти.Найти("РасшифровкаПлатежа");
		Если ТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РекСтатья = РеквизитКоллекции(ТЧ.Реквизиты, "СтатьяДвиженияДенежныхСредств,СтатьяДДС");
		РекСумма = РеквизитКоллекции(ТЧ.Реквизиты, "Сумма,СуммаВзаиморасчетов,СуммаРегл");
		Если РекСтатья = "" ИЛИ РекСумма = "" Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Ссылка КАК Документ,
			|	Т." + РекСтатья + " КАК Статья,
			|	СУММА(Т." + РекСумма + ") КАК Сумма
			|ИЗ
			|	Документ." + Элемент.Ключ + ".РасшифровкаПлатежа КАК Т
			|ГДЕ
			|	Т.Ссылка В (&Ссылки)
			|СГРУППИРОВАТЬ ПО
			|	Т.Ссылка,
			|	Т." + РекСтатья;
		Запрос.УстановитьПараметр("Ссылки", Элемент.Значение);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Продолжить;
		КонецПопытки;
		Пока Выборка.Следующий() Цикл
			Если Результат[Выборка.Документ] = Неопределено Тогда
				Результат.Вставить(Выборка.Документ, Новый Массив);
			КонецЕсли;
			Результат[Выборка.Документ].Добавить(Новый Структура("Статья, Сумма", Выборка.Статья, Выборка.Сумма));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЭтоПеремещениеДенег(Платеж)

	// один документ и принёс, и списал деньги на своих счетах — это перемещение
	Если Платеж.Приход <> 0 И Платеж.Расход <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Имя = Платеж.Документ.Метаданные().Имя;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Для Каждого Часть Из СтрРазделить("Перемещени,ДругуюКассу,Инкассац,ВнесениеНаличных,СнятиеНаличных,КонвертацияВалют", ",") Цикл
		Если СтрНайти(Имя, Часть) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Операция = РеквизитСсылки(Платеж.Документ, "ХозяйственнаяОперация");
	Если ЗначениеЗаполнено(Операция) Тогда
		Текст = НРег(Строка(Операция));
		Возврат СтрНайти(Текст, "перемещ") > 0 ИЛИ СтрНайти(Текст, "внутренн") > 0
			ИЛИ СтрНайти(Текст, "сдача денежных средств в банк") > 0 ИЛИ СтрНайти(Текст, "получение наличных") > 0;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция СуммаКСроку(Позиции, ДатаДня)

	Сумма = 0;
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) И НачалоДня(Поз.Срок) = ДатаДня Тогда
			Сумма = Сумма + Поз.Сумма;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

#КонецОбласти

#Область Долги

&НаСервере
Функция ПолучитьДолги(ИмяРегистра, ЗапасноеИмя, П)

	Рег = ИмяРегистра;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Рег = ЗапасноеИмя;
	КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистров " + ИмяРегистра + " и " + ЗапасноеИмя;
	КонецЕсли;

	Поля = Новый Массив;
	Группировки = Новый Массив;
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаПоПартнерам") <> "" Тогда
		Поля.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер) КАК Контрагент");
		Группировки.Добавить("ЕСТЬNULL(Т.АналитикаУчетаПоПартнерам.Контрагент, Т.АналитикаУчетаПоПартнерам.Партнер)");
	Иначе
		ИзмКонтрагент = ИзмерениеРегистра(Рег, "Контрагент,Партнер");
		Поля.Добавить(?(ИзмКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмКонтрагент) + " КАК Контрагент");
		Если ИзмКонтрагент <> "" Тогда
			Группировки.Добавить("Т." + ИзмКонтрагент);
		КонецЕсли;
	КонецЕсли;
	ИзмДокумент = ИзмерениеРегистра(Рег, "ОбъектРасчетов,ДокументРасчетов,РасчетныйДокумент,ЗаказКлиента,Заказ,ДокументРегистратор");
	Поля.Добавить(?(ИзмДокумент = "", "НЕОПРЕДЕЛЕНО", "Т." + ИзмДокумент) + " КАК Документ");
	Если ИзмДокумент <> "" Тогда
		Группировки.Добавить("Т." + ИзмДокумент);
	КонецЕсли;
	ИзмСрок = ИзмерениеРегистра(Рег, "ДатаПлановогоПогашения,ДатаПлатежа,СрокОплаты,ДатаПогашения");
	Поля.Добавить(?(ИзмСрок = "", "ДАТАВРЕМЯ(1, 1, 1)", "Т." + ИзмСрок) + " КАК Срок");
	Если ИзмСрок <> "" Тогда
		Группировки.Добавить("Т." + ИзмСрок);
	КонецЕсли;
	Ресурс = РесурсРегистра(Рег, "ДолгРегл,Долг,ДолгУпр,СуммаРегл,Сумма");
	Если Ресурс = "" Тогда
		ВызватьИсключение "в регистре " + Рег + " не найден ресурс суммы долга";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(Поля, ",
		|	") + ",
		|	СУММА(Т." + Ресурс + "Остаток) КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница" + ?(Условие = "", "", ", " + Условие) + ") КАК Т" + ?(Группировки.Количество() = 0, "", "
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(Группировки, ",
		|	")) + "
		|ИМЕЮЩИЕ
		|	СУММА(Т." + Ресурс + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Позиции = Запрос.Выполнить().Выгрузить();

	// тот же запрос на начало месяца: как изменился долг
	Запрос.УстановитьПараметр("Граница", П.НачалоМесяца);
	ВсегоНаНачало = 0;
	ПросроченоНаНачало = 0;
	Для Каждого Поз Из Запрос.Выполнить().Выгрузить() Цикл
		ВсегоНаНачало = ВсегоНаНачало + Поз.Сумма;
		Если ЗначениеЗаполнено(Поз.Срок) И Поз.Срок < П.НачалоМесяца Тогда
			ПросроченоНаНачало = ПросроченоНаНачало + Поз.Сумма;
		КонецЕсли;
	КонецЦикла;

	Позиции.Колонки.Добавить("Просрочка", ОписаниеЧисла());
	Для Каждого Поз Из Позиции Цикл
		Если ЗначениеЗаполнено(Поз.Срок) Тогда
			Поз.Просрочка = Цел((П.День - НачалоДня(Поз.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;
	Позиции.Сортировать("Просрочка Убыв, Сумма Убыв");

	Корзины = Новый Массив;
	Для Каждого Опис Из ОписаниеКорзин() Цикл
		Корзины.Добавить(Новый Структура("Заголовок, Сумма", Опис.Заголовок, 0));
	КонецЦикла;
	Всего = 0;
	Просрочено = 0;
	ВБлижайшие = 0;
	ПоКонтрагентам = Новый ТаблицаЗначений;
	ПоКонтрагентам.Колонки.Добавить("Контрагент");
	ПоКонтрагентам.Колонки.Добавить("Долг", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Просрочено", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("МаксПросрочка", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("Документов", ОписаниеЧисла());
	ПоКонтрагентам.Колонки.Добавить("БлижайшийСрок");
	Ближайшие = Позиции.СкопироватьКолонки();
	Для Каждого Поз Из Позиции Цикл
		Всего = Всего + Поз.Сумма;
		НовСтр = ПоКонтрагентам.Найти(Поз.Контрагент, "Контрагент");
		Если НовСтр = Неопределено Тогда
			НовСтр = ПоКонтрагентам.Добавить();
			НовСтр.Контрагент = Поз.Контрагент;
		КонецЕсли;
		НовСтр.Долг = НовСтр.Долг + Поз.Сумма;
		НовСтр.Документов = НовСтр.Документов + 1;
		Если Поз.Просрочка > 0 Тогда
			Просрочено = Просрочено + Поз.Сумма;
			НовСтр.Просрочено = НовСтр.Просрочено + Поз.Сумма;
			НовСтр.МаксПросрочка = Макс(НовСтр.МаксПросрочка, Поз.Просрочка);
		ИначеЕсли ЗначениеЗаполнено(Поз.Срок) Тогда
			Если НЕ ЗначениеЗаполнено(НовСтр.БлижайшийСрок) ИЛИ Поз.Срок < НовСтр.БлижайшийСрок Тогда
				НовСтр.БлижайшийСрок = Поз.Срок;
			КонецЕсли;
			Если -Поз.Просрочка <= П.Горизонт Тогда
				ВБлижайшие = ВБлижайшие + Поз.Сумма;
				ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Поз);
			КонецЕсли;
		КонецЕсли;
		Индекс = 0;
		Для Каждого Опис Из ОписаниеКорзин() Цикл
			Если Поз.Просрочка >= Опис.От И Поз.Просрочка <= Опис.До Тогда
				Корзины[Индекс].Сумма = Корзины[Индекс].Сумма + Поз.Сумма;
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	ПоКонтрагентам.Сортировать("Просрочено Убыв, Долг Убыв");
	Ближайшие.Сортировать("Срок");

	Р = Новый Структура;
	Р.Вставить("Регистр", Рег);
	Р.Вставить("ЕстьСроки", ИзмСрок <> "");
	Р.Вставить("Позиции", Позиции);
	Р.Вставить("Всего", Всего);
	Р.Вставить("Просрочено", Просрочено);
	Р.Вставить("ВБлижайшие", ВБлижайшие);
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Корзины", Корзины);
	Р.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	Р.Вставить("ВсегоНаНачало", ВсегоНаНачало);
	Р.Вставить("ПросроченоНаНачало", ПросроченоНаНачало);
	Возврат Р;

КонецФункции

&НаСервере
Функция ОписаниеКорзин()

	Корзины = Новый Массив;
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Срок не наступил", -100000, 0));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "1–30 дней", 1, 30));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "31–60 дней", 31, 60));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "61–90 дней", 61, 90));
	Корзины.Добавить(Новый Структура("Заголовок, От, До", "Более 90 дней", 91, 100000));
	Возврат Корзины;

КонецФункции

#КонецОбласти

#Область Выпуск

&НаСервере
Функция ДокументыПроизводства(П, ВключаяПередачу = Ложь)

	// документы выпуска (приход на склад) и списания в производство (расход):
	// известные имена ERP плюс все виды документов, которые за 60 дней двигали склад
	// и в имени которых есть «производ», «выпуск», «этап», «сборк», «переработ», «продукц»
	Кандидаты = "ЭтапПроизводства2_2,ВыпускПродукции,ПроизводствоБезЗаказа";
	Если ВключаяПередачу Тогда
		Кандидаты = Кандидаты + ",ПередачаМатериаловВПроизводство";
	КонецЕсли;
	Найдено = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Кандидаты, ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Найдено.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Слова = СтрРазделить("производ,выпуск,этап,сборк,переработ,продукц" + ?(ВключаяПередачу, ",передачаматериал,потреблен,списаниематериал", ""), ",");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5000
		|	Т.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК Т
		|ГДЕ
		|	Т.Период МЕЖДУ &Начало60 И &КонецДня
		|	И Т.ВидДвижения = &ВидДвижения
		|	И Т.Активность";
	Запрос.УстановитьПараметр("Начало60", П.День - 59 * 86400);
	Запрос.УстановитьПараметр("КонецДня", П.КонецДня);
	Запрос.УстановитьПараметр("ВидДвижения", ?(ВключаяПередачу, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход));
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Найдено;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Попытка
			Имя = Выборка.Регистратор.Метаданные().Имя;
		Исключение
			Продолжить;
		КонецПопытки;
		Если Найдено.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяНРег = НРег(Имя);
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(ИмяНРег, Слово) > 0 И СтрНайти(ИмяНРег, "возврат") = 0 Тогда
				Найдено.Добавить(Имя);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

&НаСервере
Функция УсловиеРегистратора(СписокДокументов)

	Части = Новый Массив;
	Для Каждого Имя Из СписокДокументов Цикл
		Части.Добавить("Т.Регистратор ССЫЛКА Документ." + Имя);
	КонецЦикла;
	Возврат "(" + СтрСоединить(Части, " ИЛИ ") + ")";

КонецФункции

&НаСервере
Функция ПолучитьВыпуск(П)

	// выпуск — из регистра ERP «Выпуск продукции» (его ведут документы «Производство без заказа»,
	// «Этап производства» и др.); если регистра нет — приход на склад документами производства
	СписокДокументов = ДокументыПроизводства(П);
	Начало = Мин(П.НачалоМесяца, П.Начало30);
	Запрос = Новый Запрос;
	ИзРегистра = Метаданные.РегистрыНакопления.Найти("ВыпускПродукции") <> Неопределено
		И ИзмерениеРегистра("ВыпускПродукции", "АналитикаУчетаНоменклатуры") <> ""
		И РесурсРегистра("ВыпускПродукции", "Количество") <> "";
	Если ИзРегистра Тогда
		Условие = УсловиеОрганизации("ВыпускПродукции", П);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Период КАК День,
			|	Т.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|	СУММА(Т.КоличествоОборот) КАК Количество
			|ИЗ
			|	РегистрНакопления.ВыпускПродукции.Обороты(&Начало, &КонецДня, День" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
			|СГРУППИРОВАТЬ ПО
			|	Т.Период,
			|	Т.АналитикаУчетаНоменклатуры.Номенклатура";
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("Начало", Начало);
		Строки = Запрос.Выполнить().Выгрузить();
		Источник = "регистр «Выпуск продукции»";
		Запрос.Текст =
			"ВЫБРАТЬ
			|	МАКСИМУМ(Т.Период) КАК Дата
			|ИЗ
			|	РегистрНакопления.ВыпускПродукции КАК Т
			|ГДЕ
			|	Т.Период <= &КонецДня" + ?(Условие = "", "", "
			|	И Т." + Условие);
		Выборка = Запрос.Выполнить().Выбрать();
		ПоследнийВыпуск = ?(Выборка.Следующий(), Выборка.Дата, Неопределено);
	Иначе
		Если СписокДокументов.Количество() = 0 Тогда
			ВызватьИсключение "не найдены ни регистр «Выпуск продукции», ни документы выпуска";
		КонецЕсли;
		Ресурс = РесурсРегистра("ТоварыНаСкладах", "ВНаличии,Количество");
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ) КАК День,
			|	Т.Номенклатура КАК Номенклатура,
			|	СУММА(Т." + Ресурс + ") КАК Количество
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &Начало И &КонецДня
			|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|	И Т.Активность
			|	И " + УсловиеРегистратора(СписокДокументов) + "
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Период, ДЕНЬ),
			|	Т.Номенклатура";
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("Начало", Начало);
		Строки = Запрос.Выполнить().Выгрузить();
		Источник = "приход на склад документами " + СтрСоединить(СписокДокументов, ", ");
		ПоследнийВыпуск = Неопределено;
		Для Каждого Стр Из Строки Цикл
			Если ПоследнийВыпуск = Неопределено ИЛИ Стр.День > ПоследнийВыпуск Тогда
				ПоследнийВыпуск = Стр.День;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// план производства на этот и следующий месяц
	ПланМесяц = ПланПроизводства(П, П.НачалоМесяца, КонецМесяца(П.День));
	НачалоСледующего = ДобавитьМесяц(П.НачалоМесяца, 1);
	ПланСледующий = ПланПроизводства(П, НачалоСледующего, КонецМесяца(НачалоСледующего));

	ПоПродуктам = Новый ТаблицаЗначений;
	ПоПродуктам.Колонки.Добавить("Номенклатура");
	ПоПродуктам.Колонки.Добавить("Ед");
	ПоПродуктам.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	ПоПродуктам.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ЗаМесяц", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("За7Дней", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("За30Дней", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ПланМесяца", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	ПоПродуктам.Колонки.Добавить("Спецификация");
	Для Каждого Стр Из Строки Цикл
		НовСтр = СтрокаПродукта(ПоПродуктам, Стр.Номенклатура);
		Если Стр.День = П.День Тогда
			НовСтр.ЗаДень = НовСтр.ЗаДень + Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.НачалоМесяца Тогда
			НовСтр.ЗаМесяц = НовСтр.ЗаМесяц + Стр.Количество;
		КонецЕсли;
		Если Стр.День > П.День - 7 * 86400 Тогда
			НовСтр.За7Дней = НовСтр.За7Дней + Стр.Количество;
		КонецЕсли;
		Если Стр.День >= П.Начало30 Тогда
			НовСтр.За30Дней = НовСтр.За30Дней + Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ПланМесяц Цикл
		НовСтр = СтрокаПродукта(ПоПродуктам, Стр.Номенклатура);
		НовСтр.ПланМесяца = НовСтр.ПланМесяца + Стр.Количество;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда
			НовСтр.Спецификация = Стр.Спецификация;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ПланСледующий Цикл
		НовСтр = СтрокаПродукта(ПоПродуктам, Стр.Номенклатура);
		НовСтр.ПланСледующего = НовСтр.ПланСледующего + Стр.Количество;
		Если НЕ ЗначениеЗаполнено(НовСтр.Спецификация) И ЗначениеЗаполнено(Стр.Спецификация) Тогда
			НовСтр.Спецификация = Стр.Спецификация;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ПоПродуктам Цикл
		Стр.Полуфабрикат = Стр.ПланМесяца = 0 И Стр.ПланСледующего = 0 И ЭтоПолуфабрикат(Стр.Номенклатура);
	КонецЦикла;
	ПоПродуктам.Сортировать("Полуфабрикат, ПланМесяца Убыв, ЗаМесяц Убыв");

	// итоги складываются только в одной единице — той, в которой больше всего выпуска (обычно кг)
	ПоЕдиницам = ПоПродуктам.Скопировать(Новый Структура("Полуфабрикат", Ложь), "Ед, ЗаДень, ЗаМесяц, За7Дней, За30Дней, ПланМесяца, ПланСледующего");
	ПоЕдиницам.Свернуть("Ед", "ЗаДень, ЗаМесяц, За7Дней, За30Дней, ПланМесяца, ПланСледующего");
	ПоЕдиницам.Сортировать("ЗаМесяц Убыв, ПланМесяца Убыв");
	ГлавнаяЕд = ?(ПоЕдиницам.Количество() = 0, "", ПоЕдиницам[0].Ед);

	ПоДням = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Если ЕдиницаНоменклатуры(Стр.Номенклатура) = ГлавнаяЕд И НЕ ЭтоПолуфабрикатИзТаблицы(ПоПродуктам, Стр.Номенклатура) Тогда
			ПоДням.Вставить(Стр.День, ЧислоИлиНоль(ПоДням[Стр.День]) + Стр.Количество);
		КонецЕсли;
	КонецЦикла;
	История = Новый ТаблицаЗначений;
	История.Колонки.Добавить("Дата");
	История.Колонки.Добавить("Количество", ОписаниеЧисла());
	Для Д = 0 По 29 Цикл
		ДатаДня = П.Начало30 + Д * 86400;
		НовСтр = История.Добавить();
		НовСтр.Дата = ДатаДня;
		НовСтр.Количество = ЧислоИлиНоль(ПоДням[ДатаДня]);
	КонецЦикла;

	Главная = ?(ПоЕдиницам.Количество() = 0, Неопределено, ПоЕдиницам[0]);
	ДнейВМесяце = День(КонецМесяца(П.День));
	ДнейПрошло = День(П.День);
	ЗаМесяц = ?(Главная = Неопределено, 0, Главная.ЗаМесяц);
	ПланМесяца = ?(Главная = Неопределено ИЛИ Главная.ПланМесяца = 0, П.ПланВСутки * ДнейВМесяце, Главная.ПланМесяца);
	ВСутки = ?(Главная = Неопределено, 0, Главная.За30Дней / 30);
	Р = Новый Структура;
	Р.Вставить("ПоПродуктам", ПоПродуктам);
	Р.Вставить("ПоЕдиницам", ПоЕдиницам);
	Р.Вставить("ГлавнаяЕд", ГлавнаяЕд);
	Р.Вставить("История", История);
	Р.Вставить("ЗаДень", ?(Главная = Неопределено, 0, Главная.ЗаДень));
	Р.Вставить("ЗаМесяц", ЗаМесяц);
	Р.Вставить("ВСутки", ВСутки);
	Р.Вставить("План", ПланМесяца / ДнейВМесяце);
	Р.Вставить("ПланМесяца", ПланМесяца);
	Р.Вставить("ЕстьПланПроизводства", ПланМесяц.Количество() > 0);
	Р.Вставить("Документы", СписокДокументов);
	Р.Вставить("Источник", Источник);
	Р.Вставить("ПоследнийВыпуск", ПоследнийВыпуск);
	Р.Вставить("ПланНаСегодня", ПланМесяца * ДнейПрошло / ДнейВМесяце);
	Р.Вставить("Прогноз", ЗаМесяц + ВСутки * (ДнейВМесяце - ДнейПрошло));
	Р.Вставить("ОсталосьДней", ДнейВМесяце - ДнейПрошло);
	Возврат Р;

КонецФункции

&НаСервере
Функция СтрокаПродукта(ПоПродуктам, Номенклатура)

	Стр = ПоПродуктам.Найти(Номенклатура, "Номенклатура");
	Если Стр = Неопределено Тогда
		Стр = ПоПродуктам.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Ед = ЕдиницаНоменклатуры(Номенклатура);
	КонецЕсли;
	Возврат Стр;

КонецФункции

&НаСервере
Функция ЭтоПолуфабрикат(Номенклатура)

	Вид = НРег(Строка(РеквизитСсылки(Номенклатура, "ВидНоменклатуры")));
	Возврат СтрНайти(Вид, "полуфабрикат") > 0;

КонецФункции

&НаСервере
Функция ЭтоПолуфабрикатИзТаблицы(ПоПродуктам, Номенклатура)

	Стр = ПоПродуктам.Найти(Номенклатура, "Номенклатура");
	Возврат Стр <> Неопределено И Стр.Полуфабрикат;

КонецФункции

&НаСервере
Функция ПланПроизводства(П, НачалоПериода, КонецПериода)

	// строки документов «План производства» с выпуском в периоде; если один и тот же продукт
	// на одну дату есть в нескольких документах (корректировки) — берём последний документ
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Количество", ОписаниеЧисла());
	Результат.Колонки.Добавить("Спецификация");
	Мета = Метаданные.Документы.Найти("ПланПроизводства");
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("Продукция") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Реквизиты = Мета.ТабличныеЧасти.Продукция.Реквизиты;
	Отборы = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Отменено,Замещен,Полуфабрикат", ",") Цикл
		Если Реквизиты.Найти(Имя) <> Неопределено Тогда
			Отборы.Добавить("НЕ Т." + Имя);
		КонецЕсли;
	КонецЦикла;
	ПолеДаты = ?(Реквизиты.Найти("ДатаВыпуска") <> Неопределено,
		"ВЫБОР КОГДА Т.ДатаВыпуска = ДАТАВРЕМЯ(1, 1, 1) ТОГДА Т.Ссылка.НачалоПериода ИНАЧЕ Т.ДатаВыпуска КОНЕЦ", "Т.Ссылка.НачалоПериода");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Документ,
		|	Т.Ссылка.Дата КАК ДатаДокумента,
		|	Т.Номенклатура КАК Номенклатура,
		|	НАЧАЛОПЕРИОДА(" + ПолеДаты + ", ДЕНЬ) КАК ДатаВыпуска,
		|	" + ?(Реквизиты.Найти("Спецификация") <> Неопределено, "Т.Спецификация", "НЕОПРЕДЕЛЕНО") + " КАК Спецификация,
		|	Т.Количество КАК Количество
		|ИЗ
		|	Документ.ПланПроизводства.Продукция КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И НЕ Т.Ссылка.ПометкаУдаления
		|	И " + ПолеДаты + " МЕЖДУ &НачалоПлана И &КонецПлана" + ?(Отборы.Количество() = 0, "", "
		|	И " + СтрСоединить(Отборы, "
		|	И ")) + "
		|УПОРЯДОЧИТЬ ПО
		|	ДатаДокумента";
	Запрос.УстановитьПараметр("НачалоПлана", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПлана", КонецПериода);
	Строки = Запрос.Выполнить().Выгрузить();

	// для каждой пары «продукт + дата выпуска» оставляем строки только последнего документа
	Последний = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Последний.Вставить(КлючПлана(Стр), Стр.Документ);
	КонецЦикла;
	Для Каждого Стр Из Строки Цикл
		Если Последний[КлючПлана(Стр)] = Стр.Документ Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Спецификации = Новый Соответствие;
	Для Каждого Стр Из Результат Цикл
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда
			Спецификации.Вставить(Стр.Номенклатура, Стр.Спецификация);
		КонецЕсли;
	КонецЦикла;
	Результат.Свернуть("Номенклатура", "Количество");
	Результат.Колонки.Добавить("Спецификация");
	Для Каждого Стр Из Результат Цикл
		Стр.Спецификация = Спецификации[Стр.Номенклатура];
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция КлючПлана(Стр)

	Возврат Строка(Стр.Номенклатура.УникальныйИдентификатор()) + Формат(Стр.ДатаВыпуска, "ДФ=yyyyMMdd");

КонецФункции

#КонецОбласти

#Область Заказы

&НаСервере
Функция ПолучитьЗаказы(П, Выпуск)

	// остаток к отгрузке: из регистра заказов, если он есть в конфигурации,
	// иначе по документам (заказано минус отгружено реализациями)
	Опис = ОписаниеРегистраЗаказов();
	Если Опис = Неопределено Тогда
		Открытые = ОстаткиЗаказовПоДокументам(П);
		Источник = "по документам: заказы клиентов минус реализации за 180 дней";
		ЕстьСумма = Истина;
	Иначе
		Открытые = ОстаткиЗаказовПоРегистру(Опис, П);
		Источник = "регистр " + Опис.Регистр;
		ЕстьСумма = Опис.РесСумма <> "";
	КонецЕсли;
	Открытые.Колонки.Добавить("Номер");
	Открытые.Колонки.Добавить("Клиент");
	Открытые.Колонки.Добавить("Срок");
	Открытые.Колонки.Добавить("Ед");
	Открытые.Колонки.Добавить("СоСклада", ОписаниеЧисла());
	Открытые.Колонки.Добавить("Покрытие");
	Открытые.Колонки.Добавить("Просрочка", ОписаниеЧисла());

	Кэш = Новый Соответствие;
	Для Каждого Стр Из Открытые Цикл
		Данные = Кэш[Стр.Заказ];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Номер, Клиент, Срок, Цены", "", "", Неопределено, Неопределено);
			Попытка
				Данные.Номер = Стр.Заказ.Номер;
			Исключение
				Данные.Номер = Строка(Стр.Заказ);
			КонецПопытки;
			Данные.Клиент = РеквизитСсылки(Стр.Заказ, "Контрагент,Партнер");
			Данные.Срок = РеквизитСсылки(Стр.Заказ, "ДатаОтгрузки,ЖелаемаяДатаОтгрузки,ДатаПоступления");
			Кэш.Вставить(Стр.Заказ, Данные);
		КонецЕсли;
		Стр.Номер = Данные.Номер;
		Стр.Клиент = Данные.Клиент;
		Стр.Срок = Данные.Срок;
		Стр.Ед = ЕдиницаНоменклатуры(Стр.Номенклатура);
		Если НЕ ЕстьСумма Тогда
			Стр.Сумма = Стр.Осталось * ЦенаВЗаказе(Стр.Заказ, Стр.Номенклатура);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Срок) Тогда
			Стр.Просрочка = Цел((П.День - НачалоДня(Стр.Срок)) / 86400);
		КонецЕсли;
	КонецЦикла;

	// склад готовой продукции по заказам в порядке сроков, остальное — из выпуска
	Склад = ОстаткиНаСкладах(Открытые.ВыгрузитьКолонку("Номенклатура"), П);
	Темп = Новый Соответствие;
	Если Выпуск <> Неопределено Тогда
		Для Каждого Стр Из Выпуск.ПоПродуктам Цикл
			Темп.Вставить(Стр.Номенклатура, Стр.За30Дней / 30);
		КонецЦикла;
	КонецЕсли;
	Открытые.Колонки.Добавить("Порядок");
	Для Каждого Стр Из Открытые Цикл
		Стр.Порядок = ?(ЗначениеЗаполнено(Стр.Срок), Стр.Срок, '39991231');
	КонецЦикла;
	Открытые.Сортировать("Порядок");
	Зарезервировано = Новый Соответствие;
	Для Каждого Стр Из Открытые Цикл
		ЕстьНаСкладе = ?(Склад[Стр.Номенклатура] = Неопределено, 0, Склад[Стр.Номенклатура]);
		Стр.СоСклада = Мин(ЕстьНаСкладе, Стр.Осталось);
		Склад.Вставить(Стр.Номенклатура, ЕстьНаСкладе - Стр.СоСклада);
		Нужно = Стр.Осталось - Стр.СоСклада;
		Если НЕ ЗначениеЗаполнено(Стр.Срок) Тогда
			Стр.Покрытие = "без срока";
		ИначеЕсли Нужно <= 0 Тогда
			Стр.Покрытие = ?(Стр.Просрочка > 0, "просрочен, есть на складе", "есть на складе");
		ИначеЕсли Стр.Просрочка > 0 Тогда
			Стр.Покрытие = "просрочен";
		Иначе
			Дней = Цел((НачалоДня(Стр.Срок) - П.День) / 86400);
			Уже = ?(Зарезервировано[Стр.Номенклатура] = Неопределено, 0, Зарезервировано[Стр.Номенклатура]);
			ВСутки = ?(Темп[Стр.Номенклатура] = Неопределено, 0, Темп[Стр.Номенклатура]);
			Стр.Покрытие = ?(ВСутки * Дней - Уже >= Нужно, "успеваем выпустить", "не успеваем");
			Зарезервировано.Вставить(Стр.Номенклатура, Уже + Нужно);
		КонецЕсли;
	КонецЦикла;

	// портфель по продуктам
	Продукты = Открытые.Скопировать(, "Номенклатура, Ед, Осталось, Сумма, СоСклада");
	Продукты.Колонки.Добавить("Заказов", ОписаниеЧисла());
	Продукты.ЗаполнитьЗначения(1, "Заказов");
	Продукты.Свернуть("Номенклатура, Ед", "Осталось, Сумма, СоСклада, Заказов");
	Продукты.Колонки.Добавить("Выпустить", ОписаниеЧисла());
	Продукты.Колонки.Добавить("ВСутки", ОписаниеЧисла());
	Продукты.Колонки.Добавить("Загрузка");
	Для Каждого Стр Из Продукты Цикл
		Стр.Выпустить = Стр.Осталось - Стр.СоСклада;
		Стр.ВСутки = ?(Темп[Стр.Номенклатура] = Неопределено, 0, Темп[Стр.Номенклатура]);
		Стр.Загрузка = ?(Стр.ВСутки > 0, Стр.Выпустить / Стр.ВСутки, Неопределено);
	КонецЦикла;
	Продукты.Сортировать("Сумма Убыв");

	Р = Новый Структура;
	Р.Вставить("Открытые", Открытые);
	Р.Вставить("Продукты", Продукты);
	Р.Вставить("Портфель", Открытые.Итог("Сумма"));
	Р.Вставить("Заказов", Открытые.Скопировать(, "Заказ").Количество());
	Свернутые = Открытые.Скопировать(, "Заказ");
	Свернутые.Свернуть("Заказ");
	Р.Заказов = Свернутые.Количество();
	Р.Вставить("Просроченные", ОтобратьСтроки(Открытые, "просроч"));
	Р.Вставить("НеУспеваем", ОтобратьСтроки(Открытые, "не успеваем"));
	Ближайшие = Открытые.СкопироватьКолонки();
	Для Каждого Стр Из Открытые Цикл
		Если ЗначениеЗаполнено(Стр.Срок) И Стр.Просрочка <= 0 И -Стр.Просрочка <= П.Горизонт Тогда
			ЗаполнитьЗначенияСвойств(Ближайшие.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Р.Вставить("Ближайшие", Ближайшие);
	Р.Вставить("Новые", НовыеЗаказы(П));
	Р.Вставить("Отгрузки", ОтгрузкиЗаМесяц(П));
	Р.Вставить("Источник", Источник);
	Возврат Р;

КонецФункции

&НаСервере
Функция ОписаниеРегистраЗаказов()

	// только регистр «Заказы клиентов»; в ERP 2.5 его нет — тогда остаток считается по документам
	Для Каждого Имя Из СтрРазделить("ЗаказыКлиентов", ",") Цикл
		Опис = ОписаниеРегистраЗаказовПоИмени(Имя, "");
		Если Опис <> Неопределено Тогда
			Возврат Опис;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ОписаниеРегистраЗаказовПоИмени(ИмяРегистра, ИмяИзмерения)

	Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИзмЗаказ = ?(ИмяИзмерения = "", ИзмерениеРегистра(ИмяРегистра, "ЗаказКлиента,Распоряжение,Заказ"), ИмяИзмерения);
	РесКоличество = РесурсРегистра(ИмяРегистра, "КОформлению,КОтгрузке,Заказано");
	Если ИзмЗаказ = "" ИЛИ РесКоличество = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Регистр, ИзмЗаказ, РесКоличество, РесСумма",
		ИмяРегистра, ИзмЗаказ, РесКоличество, РесурсРегистра(ИмяРегистра, "Сумма,СуммаРегл"));

КонецФункции

&НаСервере
Функция ОстаткиЗаказовПоРегистру(Опис, П)

	Условие = "";
	Если ЗначениеЗаполнено(П.Организация) Тогда
		Условие = Опис.ИзмЗаказ + ".Организация = &Организация";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т." + Опис.ИзмЗаказ + " КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + Опис.РесКоличество + "Остаток) КАК Осталось,
		|	" + ?(Опис.РесСумма = "", "0", "СУММА(Т." + Опис.РесСумма + "Остаток)") + " КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Опис.Регистр + ".Остатки(&Граница" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т." + Опис.ИзмЗаказ + ",
		|	Т.Номенклатура
		|ИМЕЮЩИЕ
		|	СУММА(Т." + Опис.РесКоличество + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ОстаткиЗаказовПоДокументам(П)

	Если Метаданные.Документы.Найти("ЗаказКлиента") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет ни регистра заказов клиентов, ни документа ЗаказКлиента";
	КонецЕсли;
	МетаЗаказ = Метаданные.Документы.ЗаказКлиента;
	ТЧЗаказа = МетаЗаказ.ТабличныеЧасти.Найти("Товары");
	Если ТЧЗаказа = Неопределено Тогда
		ВызватьИсключение "у документа ЗаказКлиента нет табличной части Товары";
	КонецЕсли;
	ОтборОтмененных = ?(ТЧЗаказа.Реквизиты.Найти("Отменено") = Неопределено, "", "
		|	И НЕ Т.Отменено");
	ОтборОрганизации = ?(ЗначениеЗаполнено(П.Организация) И МетаЗаказ.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Т.Ссылка.Организация = &Организация", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т.Количество) КАК Заказано,
		|	СУММА(" + ВыражениеСуммыБезНДС("ЗаказКлиента") + ") КАК Сумма
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &Начало180 И &КонецДня" + ОтборОтмененных + ОтборОрганизации + "
		|СГРУППИРОВАТЬ ПО
		|	Т.Ссылка,
		|	Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Начало180", П.День - 179 * 86400);
	Заказы = Запрос.Выполнить().Выгрузить();

	// отгружено по этим заказам
	Отгружено = Новый Соответствие;
	МетаРеализация = Метаданные.Документы.Найти("РеализацияТоваровУслуг");
	ПолеЗаказа = "";
	Если МетаРеализация <> Неопределено И МетаРеализация.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
		Если МетаРеализация.ТабличныеЧасти.Товары.Реквизиты.Найти("ЗаказКлиента") <> Неопределено Тогда
			ПолеЗаказа = "Т.ЗаказКлиента";
		ИначеЕсли МетаРеализация.Реквизиты.Найти("ЗаказКлиента") <> Неопределено Тогда
			ПолеЗаказа = "Т.Ссылка.ЗаказКлиента";
		КонецЕсли;
	КонецЕсли;
	Если ПолеЗаказа <> "" Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	" + ПолеЗаказа + " КАК Заказ,
			|	Т.Номенклатура КАК Номенклатура,
			|	СУММА(Т.Количество) КАК Количество
			|ИЗ
			|	Документ.РеализацияТоваровУслуг.Товары КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &Начало180 И &КонецДня
			|	И " + ПолеЗаказа + " В (&Заказы)
			|СГРУППИРОВАТЬ ПО
			|	" + ПолеЗаказа + ",
			|	Т.Номенклатура";
		Запрос.УстановитьПараметр("Заказы", Заказы.ВыгрузитьКолонку("Заказ"));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = Строка(Выборка.Заказ.УникальныйИдентификатор()) + "|" + Строка(Выборка.Номенклатура.УникальныйИдентификатор());
			Отгружено.Вставить(Ключ, ЧислоИлиНоль(Отгружено[Ключ]) + Выборка.Количество);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Заказ");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Осталось", ОписаниеЧисла());
	Результат.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Закрытые = Новый Соответствие;
	Для Каждого Стр Из Заказы Цикл
		Закрыт = Закрытые[Стр.Заказ];
		Если Закрыт = Неопределено Тогда
			Статус = НРег(Строка(РеквизитСсылки(Стр.Заказ, "Статус")));
			Закрыт = СтрНайти(Статус, "закрыт") > 0 ИЛИ СтрНайти(Статус, "отмен") > 0 ИЛИ СтрНайти(Статус, "выполнен") > 0;
			Закрытые.Вставить(Стр.Заказ, Закрыт);
		КонецЕсли;
		Если Закрыт ИЛИ Стр.Заказано <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка(Стр.Заказ.УникальныйИдентификатор()) + "|" + Строка(Стр.Номенклатура.УникальныйИдентификатор());
		Осталось = Стр.Заказано - ЧислоИлиНоль(Отгружено[Ключ]);
		Если Осталось <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Результат.Добавить();
		НовСтр.Заказ = Стр.Заказ;
		НовСтр.Номенклатура = Стр.Номенклатура;
		НовСтр.Осталось = Осталось;
		НовСтр.Сумма = Стр.Сумма * Осталось / Стр.Заказано;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ОтобратьСтроки(Таблица, Подстрока)

	Результат = Таблица.СкопироватьКолонки();
	Для Каждого Стр Из Таблица Цикл
		Если СтрНайти(Стр.Покрытие, Подстрока) = 1 Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЦенаВЗаказе(Заказ, Номенклатура)

	Попытка
		Для Каждого Стр Из Заказ.Товары Цикл
			Если Стр.Номенклатура = Номенклатура И Стр.Количество <> 0 Тогда
				Возврат Стр.Сумма / Стр.Количество;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// у заказа нет табличной части Товары
	КонецПопытки;
	Возврат 0;

КонецФункции

&НаСервере
Функция ОстаткиНаСкладах(СписокНоменклатуры, П)

	Ресурс = РесурсРегистра("ТоварыНаСкладах", "ВНаличии,Количество");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + Ресурс + "Остаток) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, Номенклатура В (&Список)) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Список", СписокНоменклатуры);
	Остатки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;
	Возврат Остатки;

КонецФункции

&НаСервере
Функция НовыеЗаказы(П)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("Клиент");
	Таблица.Колонки.Добавить("Срок");
	Таблица.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ЗаДень", Новый ОписаниеТипов("Булево"));
	Если Метаданные.Документы.Найти("ЗаказКлиента") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Документ,
		|	Д.Дата КАК Дата
		|ИЗ
		|	Документ.ЗаказКлиента КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И Д.Дата МЕЖДУ &НачалоМесяца И &КонецДня" + ?(ЗначениеЗаполнено(П.Организация), "
		|	И Д.Организация = &Организация", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Д.Дата";
	УстановитьПараметры(Запрос, П);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Документ = Выборка.Документ;
		НовСтр.ЗаДень = НачалоДня(Выборка.Дата) = П.День;
		НовСтр.Сумма = ЧислоИлиНоль(РеквизитСсылки(Выборка.Документ, "СуммаДокумента"));
		Если НовСтр.ЗаДень Тогда
			НовСтр.Номер = Выборка.Документ.Номер;
			НовСтр.Клиент = РеквизитСсылки(Выборка.Документ, "Контрагент,Партнер");
			НовСтр.Срок = РеквизитСсылки(Выборка.Документ, "ДатаОтгрузки,ЖелаемаяДатаОтгрузки");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

