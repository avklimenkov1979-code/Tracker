#Область ОбезличиваниеДляЧата

// ОДИНАКОВЫЙ БЛОК ВО ВСЕХ ОБРАБОТКАХ (источник — 1c_tools/obezlichivanie_template.bsl, вставляется 1c_tools/insert_obezl.py).
//
// Всё, что обработка сохраняет в файл для чата, проходит через ОбезлТекст:
//  * названия организаций, контрагентов, партнёров, людей, пользователей, номенклатуры, договоров, контрактов,
//    банковских счетов, касс, складов, подразделений (и их ИНН, КПП, полные наименования, номера счетов)
//    заменяются кодами вида «Контрагент-3fa91c»;
//  * имя пользователя 1С, имя компьютера, адрес сервера и имя базы — заменяются;
//  * любые числа из 9 и более цифр подряд (ИНН, КПП, ОГРН, счета, БИК, телефоны) — звёздочками; e-mail — «[e-mail]».
// Код — это первые 6 знаков SHA-256 от секретного ключа и внутреннего идентификатора объекта. Ключ создаётся один раз,
// хранится только в вашей базе (хранилище общих настроек, у каждого пользователя свой) и в файлы не попадает.
// Поэтому по коду нельзя узнать объект без вашей базы, а один объект во всех файлах получает один и тот же код.
// Словарь «код → объект» сохраняется там же: кнопка «Расшифровать код» показывает, что за объект.

&НаСервереБезКонтекста
Функция ОбезлКонтекст()

	Контекст = Новый Структура("Ключ, Словарь", "", Новый Соответствие);
	Сохраненный = Неопределено;
	Попытка
		Сохраненный = ХранилищеОбщихНастроек.Загрузить("ОбезличиваниеДляЧата", "Ключ");
	Исключение
		Сохраненный = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Сохраненный) = Тип("Строка") И СтрДлина(Сохраненный) >= 32 Тогда
		Контекст.Ключ = Сохраненный;
	Иначе
		Контекст.Ключ = Строка(Новый УникальныйИдентификатор) + Строка(Новый УникальныйИдентификатор);
		Попытка
			ХранилищеОбщихНастроек.Сохранить("ОбезличиваниеДляЧата", "Ключ", Контекст.Ключ);
		Исключение
			// без сохранения коды будут другими в следующем файле, но всё равно нечитаемыми
			Контекст.Ключ = Контекст.Ключ;
		КонецПопытки;
	КонецЕсли;
	Возврат Контекст;

КонецФункции

&НаСервереБезКонтекста
Функция ОбезлХеш(Текст, Контекст)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Контекст.Ключ + "|" + Текст);
	Возврат НРег(Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма), 6));

КонецФункции

// Код объекта: «Вид-хеш». Для перечислений, чисел, дат, булевых — само значение (это не секрет).
&НаСервереБезКонтекста
Функция ОбезлКод(Значение, Контекст)

	Если Значение = NULL ИЛИ Значение = Неопределено Тогда
		Возврат "не указан";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда
		Если ПустаяСтрока(Значение) Тогда
			Возврат "не указан";
		КонецЕсли;
		Код = "Текст-" + ОбезлХеш(Значение, Контекст);
		Контекст.Словарь.Вставить(Код, Значение);
		Возврат Код;
	КонецЕсли;
	МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаЗначения = Неопределено Тогда
		Возврат "значение";
	КонецЕсли;
	Если Метаданные.Перечисления.Содержит(МетаЗначения) ИЛИ Метаданные.ПланыСчетов.Содержит(МетаЗначения)
		ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "не указан";
	КонецЕсли;
	Попытка
		Идентификатор = Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат "значение";
	КонецПопытки;
	Код = ОбезлВид(МетаЗначения) + "-" + ОбезлХеш(МетаЗначения.ПолноеИмя() + Идентификатор, Контекст);
	Контекст.Словарь.Вставить(Код, Значение);
	Возврат Код;

КонецФункции

&НаСервереБезКонтекста
