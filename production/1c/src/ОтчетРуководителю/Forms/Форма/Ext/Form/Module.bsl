&НаСервере
Функция ОстаткиЗаказовПоДокументам(П)

	Если Метаданные.Документы.Найти("ЗаказКлиента") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет ни регистра заказов клиентов, ни документа ЗаказКлиента";
	КонецЕсли;
	МетаЗаказ = Метаданные.Документы.ЗаказКлиента;
	ТЧЗаказа = МетаЗаказ.ТабличныеЧасти.Найти("Товары");
	Если ТЧЗаказа = Неопределено Тогда
		ВызватьИсключение "у документа ЗаказКлиента нет табличной части Товары";
	КонецЕсли;
	ОтборОтмененных = ?(ТЧЗаказа.Реквизиты.Найти("Отменено") = Неопределено, "", "
		|	И НЕ Т.Отменено");
	ОтборОрганизации = ?(ЗначениеЗаполнено(П.Организация) И МетаЗаказ.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Т.Ссылка.Организация = &Организация", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т.Количество) КАК Заказано,
		|	СУММА(" + ВыражениеСуммыБезНДС("ЗаказКлиента") + ") КАК Сумма
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &Начало180 И &КонецДня" + ОтборОтмененных + ОтборОрганизации + "
		|СГРУППИРОВАТЬ ПО
		|	Т.Ссылка,
		|	Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Начало180", П.День - 179 * 86400);
	Заказы = Запрос.Выполнить().Выгрузить();

	// отгружено по этим заказам
	Отгружено = Новый Соответствие;
	МетаРеализация = Метаданные.Документы.Найти("РеализацияТоваровУслуг");
	ПолеЗаказа = "";
	Если МетаРеализация <> Неопределено И МетаРеализация.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
		Если МетаРеализация.ТабличныеЧасти.Товары.Реквизиты.Найти("ЗаказКлиента") <> Неопределено Тогда
			ПолеЗаказа = "Т.ЗаказКлиента";
		ИначеЕсли МетаРеализация.Реквизиты.Найти("ЗаказКлиента") <> Неопределено Тогда
			ПолеЗаказа = "Т.Ссылка.ЗаказКлиента";
		КонецЕсли;
	КонецЕсли;
	Если ПолеЗаказа <> "" Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	" + ПолеЗаказа + " КАК Заказ,
			|	Т.Номенклатура КАК Номенклатура,
			|	СУММА(Т.Количество) КАК Количество
			|ИЗ
			|	Документ.РеализацияТоваровУслуг.Товары КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &Начало180 И &КонецДня
			|	И " + ПолеЗаказа + " В (&Заказы)
			|СГРУППИРОВАТЬ ПО
			|	" + ПолеЗаказа + ",
			|	Т.Номенклатура";
		Запрос.УстановитьПараметр("Заказы", Заказы.ВыгрузитьКолонку("Заказ"));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = Строка(Выборка.Заказ.УникальныйИдентификатор()) + "|" + Строка(Выборка.Номенклатура.УникальныйИдентификатор());
			Отгружено.Вставить(Ключ, ЧислоИлиНоль(Отгружено[Ключ]) + Выборка.Количество);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Заказ");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Осталось", ОписаниеЧисла());
	Результат.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Закрытые = Новый Соответствие;
	Для Каждого Стр Из Заказы Цикл
		Закрыт = Закрытые[Стр.Заказ];
		Если Закрыт = Неопределено Тогда
			Статус = НРег(Строка(РеквизитСсылки(Стр.Заказ, "Статус")));
			Закрыт = СтрНайти(Статус, "закрыт") > 0 ИЛИ СтрНайти(Статус, "отмен") > 0 ИЛИ СтрНайти(Статус, "выполнен") > 0;
			Закрытые.Вставить(Стр.Заказ, Закрыт);
		КонецЕсли;
		Если Закрыт ИЛИ Стр.Заказано <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка(Стр.Заказ.УникальныйИдентификатор()) + "|" + Строка(Стр.Номенклатура.УникальныйИдентификатор());
		Осталось = Стр.Заказано - ЧислоИлиНоль(Отгружено[Ключ]);
		Если Осталось <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Результат.Добавить();
		НовСтр.Заказ = Стр.Заказ;
		НовСтр.Номенклатура = Стр.Номенклатура;
		НовСтр.Осталось = Осталось;
		НовСтр.Сумма = Стр.Сумма * Осталось / Стр.Заказано;
	КонецЦикла;
	Возврат Результат;

