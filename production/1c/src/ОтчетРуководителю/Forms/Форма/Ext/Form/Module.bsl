&НаСервере
Процедура ПодогнатьВысоту(В, ТекстЯчейки, СимволовВСтроке)

	Строк = Цел(СтрДлина(ТекстЯчейки) / СимволовВСтроке) + 1;
	Если Строк > 1 Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 12 * Строк;
	КонецЕсли;

