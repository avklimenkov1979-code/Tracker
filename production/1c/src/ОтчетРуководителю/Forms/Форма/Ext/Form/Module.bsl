&НаСервере
Функция ЭтоОсновноеСырье(Статья, П)

	ТекстСтатьи = СтрЗаменить(НРег(Строка(Статья)), "ё", "е");
	Для Каждого Слово Из СтрРазделить(П.СтатьиСырья, ",;") Цикл
		Слово = СтрЗаменить(НРег(СокрЛП(Слово)), "ё", "е");
		Если Слово <> "" И СтрНайти(ТекстСтатьи, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция РасходСырья(П, НачалоПериода)

	// фактический расход сырья в производство по строкам документов: номенклатура, количество
	// за период и за последние 14 дней; только основное сырьё (статья калькуляции или группа)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("За30", ОписаниеЧисла());
	Результат.Колонки.Добавить("За14", ОписаниеЧисла());
	Для Каждого Опис Из ИсточникиРасходаСырья() Цикл
		Мета = Метаданные.Документы.Найти(Опис.Документ);
		Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти(Опис.ТЧ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты = Мета.ТабличныеЧасти[Опис.ТЧ].Реквизиты;
		Если Реквизиты.Найти("Количество") = Неопределено ИЛИ Реквизиты.Найти("Номенклатура") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЕстьСтатья = Реквизиты.Найти("СтатьяКалькуляции") <> Неопределено;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Т.Номенклатура КАК Номенклатура,
			|	" + ?(ЕстьСтатья, "Т.СтатьяКалькуляции", "НЕОПРЕДЕЛЕНО") + " КАК Статья,
			|	СУММА(Т.Количество) КАК За30,
			|	СУММА(ВЫБОР КОГДА Т.Ссылка.Дата >= &Начало14 ТОГДА Т.Количество ИНАЧЕ 0 КОНЕЦ) КАК За14
			|ИЗ
			|	Документ." + Опис.Документ + "." + Опис.ТЧ + " КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &НачалоРасхода И &КонецДня" + ?(ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено, "
			|	И Т.Ссылка.Организация = &Организация", "") + ?(ЗначениеЗаполнено(П.ГруппаСырья), "
			|	И Т.Номенклатура В ИЕРАРХИИ (&ГруппаСырья)", "") + "
			|СГРУППИРОВАТЬ ПО
			|	Т.Номенклатура" + ?(ЕстьСтатья, ",
			|	Т.СтатьяКалькуляции", "");
		УстановитьПараметры(Запрос, П);
		Запрос.УстановитьПараметр("НачалоРасхода", НачалоПериода);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(П.ГруппаСырья) И НЕ ЭтоОсновноеСырье(Выборка.Статья, П) Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;
	Результат.Свернуть("Номенклатура", "За30, За14");
	Результат.Сортировать("За30 Убыв");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьСырье(П)

	// основное сырьё — то, что за 30 дней списано в суточных рапортах и этапах производства
	// по статьям калькуляции из настройки (по умолчанию «Сырье основное»);
	// если в настройках задана группа сырья — всё сырьё этой группы
	Расходы = РасходСырья(П, П.Начало30);
	СписокДокументов = Новый Массив;
	Для Каждого Опис Из ИсточникиРасходаСырья() Цикл
		Если Метаданные.Документы.Найти(Опис.Документ) <> Неопределено Тогда
			СписокДокументов.Добавить(Опис.Документ);
		КонецЕсли;
	КонецЦикла;
	Материалы = Расходы.ВыгрузитьКолонку("Номенклатура");
	Если ЗначениеЗаполнено(П.ГруппаСырья) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Т.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, Номенклатура В ИЕРАРХИИ (&ГруппаСырья)) КАК Т";
		УстановитьПараметры(Запрос, П);
		Для Каждого Ном Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура") Цикл
			Если Материалы.Найти(Ном) = Неопределено Тогда
				Материалы.Добавить(Ном);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Остатки = ОстаткиНаСкладах(Материалы, П);
	ВПути = ПоставкиВПути(Материалы, П);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Ед");
	Таблица.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВСутки", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ХватитДней", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ХватитСПоставкой", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВПути", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ДатаПоставки");
	Таблица.Колонки.Добавить("Статус");
	Таблица.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Пояснение");
	Таблица.Колонки.Добавить("Заказать", ОписаниеЧисла());

	Для Каждого Ном Из Материалы Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Номенклатура = Ном;
		НовСтр.Ед = ЕдиницаНоменклатуры(Ном);
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Ном]);
		Расход = Расходы.Найти(Ном, "Номенклатура");
		НовСтр.ВСутки = ?(Расход = Неопределено, 0, Расход.За30 / 30);
		Поставка = ВПути[Ном];
		Если Поставка <> Неопределено Тогда
			НовСтр.ВПути = Поставка.Количество;
			НовСтр.ДатаПоставки = Поставка.Дата;
		КонецЕсли;
		ОценитьМатериал(НовСтр, П);
	КонецЦикла;
	Таблица.Сортировать("Порядок, ХватитДней");

	Р = Новый Структура;
	Р.Вставить("Материалы", Таблица);
	Р.Вставить("Нехватка", Таблица.НайтиСтроки(Новый Структура("Статус", "нехватка")));
	Р.Вставить("Документы", СписокДокументов);
	Р.Вставить("Заказать", Таблица.НайтиСтроки(Новый Структура("Статус", "заказать")));
	Возврат Р;

КонецФункции

&НаСервере
Процедура ОценитьМатериал(НовСтр, П)

	НовСтр.Статус = "в норме";
	НовСтр.Порядок = 2;
	Если НовСтр.ВСутки <= 0 Тогда
		НовСтр.Пояснение = "За 30 дней в производство не списывался";
		НовСтр.Порядок = 3;
		Возврат;
	КонецЕсли;
	НовСтр.ХватитДней = НовСтр.Остаток / НовСтр.ВСутки;
	НовСтр.ХватитСПоставкой = (НовСтр.Остаток + НовСтр.ВПути) / НовСтр.ВСутки;
	Кончится = П.День + Цел(НовСтр.ХватитДней) * 86400;
	Если НовСтр.ВПути > 0 И ЗначениеЗаполнено(НовСтр.ДатаПоставки) И НачалоДня(НовСтр.ДатаПоставки) > Кончится Тогда
		Простой = Цел((НачалоДня(НовСтр.ДатаПоставки) - Кончится) / 86400);
		НовСтр.Статус = "нехватка";
		НовСтр.Пояснение = СтрШаблон("Закончится %1, поставка %2 — простой около %3 %4",
			Формат(Кончится, "ДФ=dd.MM"), Формат(НовСтр.ДатаПоставки, "ДФ=dd.MM"), Простой, Склонение(Простой, "дня", "дней", "дней"));
	ИначеЕсли НовСтр.ВПути = 0 И НовСтр.ХватитДней < П.СрокПоставки Тогда
		НовСтр.Статус = "нехватка";
		НовСтр.Пояснение = СтрШаблон("Хватит на %1 дн., а поставка идёт %2 дн. — заказать сегодня",
			Формат(НовСтр.ХватитДней, "ЧДЦ=1; ЧН=0"), П.СрокПоставки);
	ИначеЕсли НовСтр.ХватитСПоставкой < П.СрокПоставки + П.Резерв Тогда
		НовСтр.Статус = "заказать";
		НовСтр.Пояснение = "Запас меньше срока поставки с резервом";
	КонецЕсли;
	Если НовСтр.Статус <> "в норме" Тогда
		НовСтр.Порядок = ?(НовСтр.Статус = "нехватка", 0, 1);
		НовСтр.Заказать = Макс(0, НовСтр.ВСутки * (П.СрокПоставки + П.Горизонт) - НовСтр.Остаток - НовСтр.ВПути);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоставкиВПути(Материалы, П)

	Результат = Новый Соответствие;
	Рег = "ЗаказыПоставщикам";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ИзмЗаказ = ИзмерениеРегистра(Рег, "ЗаказПоставщику,Распоряжение,Заказ");
	РесКоличество = РесурсРегистра(Рег, "КПоступлению,КОформлению,Заказано");
	Если ИзмЗаказ = "" ИЛИ РесКоличество = "" Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т." + ИзмЗаказ + " КАК Заказ,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т." + РесКоличество + "Остаток) КАК Количество
		|ИЗ
		|	РегистрНакопления." + Рег + ".Остатки(&Граница, Номенклатура В (&Список)) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т." + ИзмЗаказ + ",
		|	Т.Номенклатура
		|ИМЕЮЩИЕ
		|	СУММА(Т." + РесКоличество + "Остаток) > 0";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Список", Материалы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаДня = РеквизитСсылки(Выборка.Заказ, "ДатаПоступления,ЖелаемаяДатаПоступления");
		Было = Результат[Выборка.Номенклатура];
		Если Было = Неопределено Тогда
			Было = Новый Структура("Количество, Дата", 0, ДатаДня);
			Результат.Вставить(Выборка.Номенклатура, Было);
		ИначеЕсли ЗначениеЗаполнено(ДатаДня) И (НЕ ЗначениеЗаполнено(Было.Дата) ИЛИ ДатаДня < Было.Дата) Тогда
			Было.Дата = ДатаДня;
		КонецЕсли;
		Было.Количество = Было.Количество + Выборка.Количество;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПродажиЗакупкиЗапасы

&НаСервере
Функция РеквизитКоллекции(Коллекция, Варианты)

	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если Коллекция.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Возврат СокрЛП(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Функция ВыражениеСуммыБезНДС(ИмяДокумента)

	// сумма строки табличной части «Товары» без НДС
	Мета = Метаданные.Документы[ИмяДокумента];
	Реквизиты = Мета.ТабличныеЧасти.Товары.Реквизиты;
	ЕстьНДС = Реквизиты.Найти("СуммаНДС") <> Неопределено;
	Если Реквизиты.Найти("СуммаСНДС") <> Неопределено И ЕстьНДС Тогда
		Возврат "Т.СуммаСНДС - Т.СуммаНДС";
	ИначеЕсли Реквизиты.Найти("Сумма") <> Неопределено Тогда
		Если ЕстьНДС И Мета.Реквизиты.Найти("ЦенаВключаетНДС") <> Неопределено Тогда
			Возврат "ВЫБОР КОГДА Т.Ссылка.ЦенаВключаетНДС ТОГДА Т.Сумма - Т.СуммаНДС ИНАЧЕ Т.Сумма КОНЕЦ";
		КонецЕсли;
		Возврат "Т.Сумма";
	КонецЕсли;
	Возврат "0";

КонецФункции

&НаСервере
Функция СтрокиДокументов(ИмяДокумента, П)

	// строки «Товары» проведённых документов с начала прошлого месяца по дату отчёта:
	// день, контрагент, номенклатура, количество, сумма без НДС
	Мета = Метаданные.Документы.Найти(ИмяДокумента);
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет документа " + ИмяДокумента + " с табличной частью Товары";
	КонецЕсли;
	РекКонтрагент = РеквизитКоллекции(Мета.Реквизиты, "Контрагент,Партнер");
	ПолеКонтрагента = ?(РекКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекКонтрагент);
	ОтборОрганизации = ?(ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Т.Ссылка.Организация = &Организация", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК День,
		|	" + ПолеКонтрагента + " КАК Контрагент,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т.Количество) КАК Количество,
		|	СУММА(" + ВыражениеСуммыБезНДС(ИмяДокумента) + ") КАК Сумма
		|ИЗ
		|	Документ." + ИмяДокумента + ".Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &НачалоПрошлогоМесяца И &КонецДня" + ОтборОрганизации + "
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ),
		|	" + ?(РекКонтрагент = "", "", ПолеКонтрагента + ",
		|	") + "Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция СвестиПоПериодам(Строки, П, ПолеГруппы)

	// сводка по номенклатуре или контрагенту: текущий месяц, тот же период прошлого месяца,
	// весь прошлый месяц, последние 30 дней
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Ключ");
	Т.Колонки.Добавить("Количество", ОписаниеЧисла());
	Т.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Т.Колонки.Добавить("ЗаДень", ОписаниеЧисла());
	Т.Колонки.Добавить("КоличествоПрошл", ОписаниеЧисла());
	Т.Колонки.Добавить("СуммаПрошл", ОписаниеЧисла());
	Т.Колонки.Добавить("КоличествоПрошлМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("СуммаПрошлМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("Количество30", ОписаниеЧисла());
	Для Каждого Стр Из Строки Цикл
		НовСтр = Т.Добавить();
		НовСтр.Ключ = Стр[ПолеГруппы];
		Если Стр.День >= П.НачалоМесяца Тогда
			НовСтр.Количество = Стр.Количество;
			НовСтр.Сумма = Стр.Сумма;
			Если Стр.День = П.День Тогда
				НовСтр.ЗаДень = Стр.Сумма;
			КонецЕсли;
		Иначе
			НовСтр.КоличествоПрошлМесяц = Стр.Количество;
			НовСтр.СуммаПрошлМесяц = Стр.Сумма;
			Если Стр.День <= П.КонецПрошлогоПериода Тогда
				НовСтр.КоличествоПрошл = Стр.Количество;
				НовСтр.СуммаПрошл = Стр.Сумма;
			КонецЕсли;
		КонецЕсли;
		Если Стр.День >= П.Начало30 Тогда
			НовСтр.Количество30 = Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	Т.Свернуть("Ключ", "Количество, Сумма, ЗаДень, КоличествоПрошл, СуммаПрошл, КоличествоПрошлМесяц, СуммаПрошлМесяц, Количество30");
	Т.Сортировать("Сумма Убыв, СуммаПрошлМесяц Убыв");
	Возврат Т;

КонецФункции

// Группа каждой позиции: папка справочника «Номенклатура», а если её нет — вид номенклатуры.
// Одно правило для всех разделов отчёта — как в «Продажах».
&НаСервере
Функция ГруппыПозиций(Список)

	ГруппаПозиции = Новый Соответствие;
	МетаНом = Метаданные.Справочники.Найти("Номенклатура");
	Если МетаНом <> Неопределено И Список.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Н.Ссылка КАК Ссылка,
			|	" + ?(МетаНом.Иерархический, "Н.Родитель", "НЕОПРЕДЕЛЕНО") + " КАК Родитель,
			|	" + ?(МетаНом.Реквизиты.Найти("ВидНоменклатуры") <> Неопределено, "Н.ВидНоменклатуры", "НЕОПРЕДЕЛЕНО") + " КАК Вид
			|ИЗ
			|	Справочник.Номенклатура КАК Н
			|ГДЕ
			|	Н.Ссылка В (&Список)";
		Запрос.УстановитьПараметр("Список", Список);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ГруппаПозиции.Вставить(Выборка.Ссылка, ?(ЗначениеЗаполнено(Выборка.Родитель), Выборка.Родитель,
				?(ЗначениеЗаполнено(Выборка.Вид), Выборка.Вид, "Без группы")));
		КонецЦикла;
	КонецЕсли;
	Возврат ГруппаПозиции;

КонецФункции

// Строки таблицы (или массива строк) по группам номенклатуры. Внутри группы — исходный порядок строк;
// группы — по убыванию суммы поля ПолеВеса (если задано), иначе в порядке первой позиции.
&НаСервере
Функция ГруппыНоменклатуры(Строки, ИмяПоля = "Номенклатура", ПолеВеса = "")

	Список = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Список.Добавить(Стр[ИмяПоля]);
	КонецЦикла;
	ГруппаПозиции = ГруппыПозиций(Список);
	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Группа");
	Группы.Колонки.Добавить("Позиции");
	Группы.Колонки.Добавить("Ед");
	Группы.Колонки.Добавить("ОднаЕд", Новый ОписаниеТипов("Булево"));
	Группы.Колонки.Добавить("Вес", ОписаниеЧисла());
	Группы.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Для Каждого Стр Из Строки Цикл
		Группа = ГруппаПозиции[Стр[ИмяПоля]];
		Если Группа = Неопределено Тогда
			Группа = "Без группы";
		КонецЕсли;
		Гр = Группы.Найти(Группа, "Группа");
		Ед = "";
		Попытка
			Ед = Стр.Ед;
		Исключение
			Ед = "";
		КонецПопытки;
		Если Гр = Неопределено Тогда
			Гр = Группы.Добавить();
			Гр.Группа = Группа;
			Гр.Позиции = Новый Массив;
			Гр.Ед = Ед;
			Гр.ОднаЕд = Истина;
			Гр.Порядок = Группы.Количество();
		КонецЕсли;
		Гр.Позиции.Добавить(Стр);
		Если Гр.Ед <> Ед Тогда
			Гр.ОднаЕд = Ложь;
		КонецЕсли;
		Если ПолеВеса <> "" Тогда
			Гр.Вес = Гр.Вес + ЧислоИлиНоль(Стр[ПолеВеса]);
		КонецЕсли;
	КонецЦикла;
	Группы.Сортировать(?(ПолеВеса = "", "Порядок", "Вес Убыв, Порядок"));
	Возврат Группы;

КонецФункции

// Строка группы как в «Продажах»: название (число позиций), итоги колонок.
// Колонки — «2:Поле:к,3:Поле:ч»: к — количество (с единицей, если она у группы одна), ч — число/деньги.
&НаСервере
Процедура ВывестиСтрокуГруппы(В, Гр, Колонки, ДоКолонки)

	Фон = Новый Цвет(226, 240, 238);
	Ячейка(В, 1, Строка(Гр.Группа) + " (" + Гр.Позиции.Количество() + ")", Истина, ЦветАкцент(), Фон, , , Истина);
	Итоги = Новый Соответствие;
	Для Каждого Описание Из СтрРазделить(Колонки, ",", Ложь) Цикл
		Части = СтрРазделить(Описание, ":");
		Итоги.Вставить(Число(Части[0]), Части);
	КонецЦикла;
	Для НомерКолонки = 2 По ДоКолонки Цикл
		Части = Итоги[НомерКолонки];
		Если Части = Неопределено Тогда
			Ячейка(В, НомерКолонки, "", , , Фон);
			Продолжить;
		КонецЕсли;
		Сумма = 0;
		Для Каждого Стр Из Гр.Позиции Цикл
			Сумма = Сумма + ЧислоИлиНоль(Стр[Части[1]]);
		КонецЦикла;
		Если Части[2] = "к" Тогда
			Если Гр.ОднаЕд Тогда
				Ячейка(В, НомерКолонки, ?(Сумма = 0, "—", ФорматЧисла(Сумма) + ?(ЗначениеЗаполнено(Гр.Ед), " " + Гр.Ед, "")), Истина, , Фон);
			Иначе
				Ячейка(В, НомерКолонки, "разные ед.", , ЦветПриглушенный(), Фон);
			КонецЕсли;
			ВПраво(В, НомерКолонки, НомерКолонки);
		Иначе
			ЯчейкаЧисло(В, НомерКолонки, Сумма, , Истина, Фон);
		КонецЕсли;
	КонецЦикла;
	РасшифровкаСтроки(В, Гр.Группа, ДоКолонки);
	СледующаяСтрока(В);

КонецПроцедуры

// Название позиции внутри группы — с отступом и мелким шрифтом, как в «Продажах».
&НаСервере
Процедура ЯчейкаПозиции(В, Текст)

	Ячейка(В, 1, "      " + Текст, , , , 8, , Истина);

КонецПроцедуры

// Строка «…и ещё N поз.», если в группе больше Предел позиций.
&НаСервере
Функция ПрерватьГруппу(В, Гр, Номер, Предел = 15)

	Если Номер <= Предел Тогда
		Возврат Ложь;
	КонецЕсли;
	Ячейка(В, 1, "      …и ещё " + (Гр.Позиции.Количество() - Предел) + " поз.", , ЦветПриглушенный(), , 8, 8);
	СледующаяСтрока(В);
	Возврат Истина;

КонецФункции

&НаСервере
Функция ГруппыПродаж(ПоНоменклатуре)

	ГруппаПозиции = ГруппыПозиций(ПоНоменклатуре.ВыгрузитьКолонку("Ключ"));

	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Группа");
	Группы.Колонки.Добавить("Позиции");
	Группы.Колонки.Добавить("Ед");
	Группы.Колонки.Добавить("ОднаЕд", Новый ОписаниеТипов("Булево"));
	Группы.Колонки.Добавить("Количество", ОписаниеЧисла());
	Группы.Колонки.Добавить("КоличествоПрошлМесяц", ОписаниеЧисла());
	Группы.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Группы.Колонки.Добавить("СуммаПрошл", ОписаниеЧисла());
	Группы.Колонки.Добавить("СуммаПрошлМесяц", ОписаниеЧисла());
	Группы.Колонки.Добавить("СуммаОстальных", ОписаниеЧисла());
	Группы.Колонки.Добавить("Цена", ОписаниеЧисла());
	Группы.Колонки.Добавить("ЦенаПрошлМесяц", ОписаниеЧисла());
	Группы.Колонки.Добавить("ИзмЦены");
	Для Каждого Стр Из ПоНоменклатуре Цикл
		Если Стр.Сумма = 0 И Стр.СуммаПрошл = 0 И Стр.СуммаПрошлМесяц = 0 Тогда
			Продолжить;
		КонецЕсли;
		Группа = ГруппаПозиции[Стр.Ключ];
		Если Группа = Неопределено Тогда
			Группа = "Без группы";
		КонецЕсли;
		Гр = Группы.Найти(Группа, "Группа");
		Если Гр = Неопределено Тогда
			Гр = Группы.Добавить();
			Гр.Группа = Группа;
			Гр.Позиции = Новый Массив;
			Гр.Ед = Стр.Ед;
			Гр.ОднаЕд = Истина;
		КонецЕсли;
		Гр.Позиции.Добавить(Стр);
		Если Гр.Ед <> Стр.Ед Тогда
			Гр.ОднаЕд = Ложь;
		КонецЕсли;
		Гр.Количество = Гр.Количество + Стр.Количество;
		Гр.КоличествоПрошлМесяц = Гр.КоличествоПрошлМесяц + Стр.КоличествоПрошлМесяц;
		Гр.Сумма = Гр.Сумма + Стр.Сумма;
		Гр.СуммаПрошл = Гр.СуммаПрошл + Стр.СуммаПрошл;
		Гр.СуммаПрошлМесяц = Гр.СуммаПрошлМесяц + Стр.СуммаПрошлМесяц;
		Если Гр.Позиции.Количество() > 15 Тогда
			Гр.СуммаОстальных = Гр.СуммаОстальных + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Гр Из Группы Цикл
		Если НЕ Гр.ОднаЕд Тогда
			Гр.Ед = "";
			Продолжить;
		КонецЕсли;
		Гр.Цена = ?(Гр.Количество = 0, 0, Гр.Сумма / Гр.Количество);
		Гр.ЦенаПрошлМесяц = ?(Гр.КоличествоПрошлМесяц = 0, 0, Гр.СуммаПрошлМесяц / Гр.КоличествоПрошлМесяц);
		Если Гр.Цена > 0 И Гр.ЦенаПрошлМесяц > 0 Тогда
			Гр.ИзмЦены = (Гр.Цена / Гр.ЦенаПрошлМесяц - 1) * 100;
		КонецЕсли;
	КонецЦикла;
	Группы.Сортировать("Сумма Убыв, СуммаПрошлМесяц Убыв");
	Возврат Группы;

КонецФункции

&НаСервере
Функция ПолучитьПродажи(П)

	// выручка — из регистра ERP «Выручка и себестоимость продаж» (по нему строится стандартный
	// отчёт «Валовая прибыль», возвраты уже вычтены); если он пуст — по документам реализации
	Строки = Неопределено;
	Попытка
		Строки = СтрокиВыручки(П);
	Исключение
		Строки = Неопределено;
	КонецПопытки;
	Если Строки <> Неопределено И Строки.Итог("Сумма") <> 0 Тогда
		Р = ПолучитьОбороты("", П, Строки);
		Р.Вставить("Источник", "регистр «Выручка и себестоимость продаж», без НДС, за вычетом возвратов");
	Иначе
		Р = ПолучитьОбороты("РеализацияТоваровУслуг", П);
		Р.Вставить("Источник", "документы «Реализация товаров и услуг», без НДС; возвраты не вычтены");
	КонецЕсли;
	Возврат Р;

КонецФункции

&НаСервере
Функция СтрокиВыручки(П)

	Рег = "ВыручкаИСебестоимостьПродаж";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выручка = РесурсРегистра(Рег, "СуммаВыручкиБезНДС,СуммаВыручкиРегл,СуммаВыручки");
	Если Выручка = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Количество = РесурсРегистра(Рег, "Количество");
	ПолеНоменклатуры = "НЕОПРЕДЕЛЕНО";
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаНоменклатуры") <> "" Тогда
		ПолеНоменклатуры = "Т.АналитикаУчетаНоменклатуры.Номенклатура";
	ИначеЕсли ИзмерениеРегистра(Рег, "Номенклатура") <> "" Тогда
		ПолеНоменклатуры = "Т.Номенклатура";
	КонецЕсли;
	ПолеКонтрагента = "НЕОПРЕДЕЛЕНО";
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаПоПартнерам") <> "" Тогда
		ПолеКонтрагента = "Т.АналитикаУчетаПоПартнерам.Контрагент";
	ИначеЕсли ИзмерениеРегистра(Рег, "Контрагент,Партнер") <> "" Тогда
		ПолеКонтрагента = "Т." + ИзмерениеРегистра(Рег, "Контрагент,Партнер");
	КонецЕсли;
	Группировки = Новый Массив;
	Группировки.Добавить("Т.Период");
	Если ПолеНоменклатуры <> "НЕОПРЕДЕЛЕНО" Тогда
		Группировки.Добавить(ПолеНоменклатуры);
	КонецЕсли;
	Если ПолеКонтрагента <> "НЕОПРЕДЕЛЕНО" Тогда
		Группировки.Добавить(ПолеКонтрагента);
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Период КАК День,
		|	" + ПолеКонтрагента + " КАК Контрагент,
		|	" + ПолеНоменклатуры + " КАК Номенклатура,
		|	" + ?(Количество = "", "0", "СУММА(Т." + Количество + "Оборот)") + " КАК Количество,
		|	СУММА(Т." + Выручка + "Оборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления." + Рег + ".Обороты(&НачалоПрошлогоМесяца, &КонецДня, День" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО
		|	" + СтрСоединить(Группировки, ",
		|	");
	УстановитьПараметры(Запрос, П);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ПолучитьОбороты(ИмяДокумента, П, Знач Строки = Неопределено)

	Если Строки = Неопределено Тогда
		Строки = СтрокиДокументов(ИмяДокумента, П);
	КонецЕсли;
	Р = Новый Структура;
	Р.Вставить("ПоНоменклатуре", СвестиПоПериодам(Строки, П, "Номенклатура"));
	Р.Вставить("ПоКонтрагентам", СвестиПоПериодам(Строки, П, "Контрагент"));
	Т = Р.ПоНоменклатуре;
	Р.Вставить("ЗаДень", Т.Итог("ЗаДень"));
	Р.Вставить("Месяц", Т.Итог("Сумма"));
	Р.Вставить("ПрошлыйПериод", Т.Итог("СуммаПрошл"));
	Р.Вставить("ПрошлыйМесяц", Т.Итог("СуммаПрошлМесяц"));
	Р.Вставить("Изменение", ?(Р.ПрошлыйПериод = 0, Неопределено, (Р.Месяц / Р.ПрошлыйПериод - 1) * 100));
	Т.Колонки.Добавить("Ед");
	Т.Колонки.Добавить("Цена", ОписаниеЧисла());
	Т.Колонки.Добавить("ЦенаПрошлМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("ИзмЦены");
	Цены = Новый Соответствие;
	Для Каждого Стр Из Т Цикл
		Стр.Ед = ЕдиницаНоменклатуры(Стр.Ключ);
		Стр.Цена = ?(Стр.Количество = 0, 0, Стр.Сумма / Стр.Количество);
		Стр.ЦенаПрошлМесяц = ?(Стр.КоличествоПрошлМесяц = 0, 0, Стр.СуммаПрошлМесяц / Стр.КоличествоПрошлМесяц);
		Если Стр.Цена > 0 И Стр.ЦенаПрошлМесяц > 0 Тогда
			Стр.ИзмЦены = (Стр.Цена / Стр.ЦенаПрошлМесяц - 1) * 100;
		КонецЕсли;
		Цены.Вставить(Стр.Ключ, ?(Стр.Цена > 0, Стр.Цена, Стр.ЦенаПрошлМесяц));
	КонецЦикла;
	Р.Вставить("Цены", Цены);
	Возврат Р;

КонецФункции

&НаСервере
Функция ПолучитьМаржу(П)

	// прибыль по прямым затратам по продуктам из регистра выручки и себестоимости ERP;
	// себестоимость текущего месяца появляется после закрытия месяца
	Рег = "ВыручкаИСебестоимостьПродаж";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет регистра ВыручкаИСебестоимостьПродаж";
	КонецЕсли;
	Выручка = РесурсРегистра(Рег, "СуммаВыручкиБезНДС,СуммаВыручкиРегл,СуммаВыручки");
	Состав = СоставСебестоимости(Рег, Ложь);
	Если Выручка = "" ИЛИ Состав.Количество() = 0 Тогда
		ВызватьИсключение "в регистре " + Рег + " не найдены ресурсы выручки и себестоимости";
	КонецЕсли;
	ПолеНоменклатуры = "НЕОПРЕДЕЛЕНО";
	Если ИзмерениеРегистра(Рег, "АналитикаУчетаНоменклатуры") <> "" Тогда
		ПолеНоменклатуры = "Т.АналитикаУчетаНоменклатуры.Номенклатура";
	ИначеЕсли ИзмерениеРегистра(Рег, "Номенклатура") <> "" Тогда
		ПолеНоменклатуры = "Т.Номенклатура";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Период КАК Период,
		|	" + ПолеНоменклатуры + " КАК Номенклатура,
		|	СУММА(Т." + Выручка + "Оборот) КАК Выручка,
		|	" + ПоляСебестоимости(Состав) + "
		|ИЗ
		|	РегистрНакопления." + Рег + ".Обороты(&НачалоПрошлогоМесяца, &КонецДня, Месяц" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Период" + ?(ПолеНоменклатуры = "НЕОПРЕДЕЛЕНО", "", ",
		|	" + ПолеНоменклатуры);
	УстановитьПараметры(Запрос, П);
	Строки = Запрос.Выполнить().Выгрузить();
	Ресурсы = РазложитьСебестоимость(Строки, Состав);

	Р = Новый Структура;
	Р.Вставить("РесурсСебестоимости", Ресурсы);
	Для Каждого Период Из СтрРазделить("Прошлый,Текущий", ",") Цикл
		Начало = ?(Период = "Текущий", П.НачалоМесяца, П.НачалоПрошлогоМесяца);
		Т = Новый ТаблицаЗначений;
		Т.Колонки.Добавить("Номенклатура");
		Т.Колонки.Добавить("Выручка", ОписаниеЧисла());
		Т.Колонки.Добавить("Прямые", ОписаниеЧисла());
		Т.Колонки.Добавить("Косвенные", ОписаниеЧисла());
		Для Каждого Стр Из Строки Цикл
			Если НачалоМесяца(Стр.Период) = Начало Тогда
				ЗаполнитьЗначенияСвойств(Т.Добавить(), Стр);
			КонецЕсли;
		КонецЦикла;
		Т.Свернуть("Номенклатура", "Выручка, Прямые, Косвенные");
		Т.Колонки.Добавить("Прибыль", ОписаниеЧисла());
		Т.Колонки.Добавить("Рентабельность");
		Для Каждого Стр Из Т Цикл
			Стр.Прибыль = Стр.Выручка - Стр.Прямые;
			Стр.Рентабельность = ?(Стр.Выручка = 0, Неопределено, Стр.Прибыль / Стр.Выручка * 100);
		КонецЦикла;
		Т.Сортировать("Выручка Убыв");
		Р.Вставить(Период, Т);
	КонецЦикла;
	Р.Вставить("СебестоимостьТекущего", Р.Текущий.Итог("Прямые") + Р.Текущий.Итог("Косвенные"));
	Р.Вставить("СебестоимостьПрошлого", Р.Прошлый.Итог("Прямые") + Р.Прошлый.Итог("Косвенные"));
	Р.Вставить("КосвенныеПрошлого", Р.Прошлый.Итог("Косвенные"));
	Р.Вставить("КосвенныеТекущего", Р.Текущий.Итог("Косвенные"));
	Возврат Р;

КонецФункции

// Части себестоимости в регистре ERP «Выручка и себестоимость продаж».
// Прямые: материалы (стоимость), доп. расходы, трудозатраты, постатейные переменные.
// Косвенные: постатейные постоянные (общепроизводственные, распределённые на продукцию).
// Для каждой части — варианты ресурса по порядку; берётся первый, в котором за период есть суммы.
&НаСервере
Функция СоставСебестоимости(Рег, Регл)

	Если Регл Тогда
		Варианты = "Прямые:СтоимостьРегл|Прямые:ДопРасходыРегл,СтоимостьДопРасходыРегл|Прямые:ТрудозатратыРегл"
			+ "|Прямые:ПостатейныеПеременныеРегл|Косвенные:ПостатейныеПостоянныеРегл";
	Иначе
		Варианты = "Прямые:СтоимостьБезНДС,Стоимость,СтоимостьРегл"
			+ "|Прямые:ДопРасходыБезНДС,СтоимостьДопРасходыБезНДС,ДопРасходы,СтоимостьДопРасходы,ДопРасходыРегл,СтоимостьДопРасходыРегл"
			+ "|Прямые:Трудозатраты,ТрудозатратыРегл"
			+ "|Прямые:ПостатейныеПеременныеБезНДС,ПостатейныеПеременныеСНДС,ПостатейныеПеременныеРегл"
			+ "|Косвенные:ПостатейныеПостоянныеБезНДС,ПостатейныеПостоянныеСНДС,ПостатейныеПостоянныеРегл";
	КонецЕсли;
	Состав = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Варианты, "|") Цикл
		Пара = СтрРазделить(Часть, ":");
		Имена = Новый Массив;
		Для Каждого Имя Из СтрРазделить(Пара[1], ",") Цикл
			Если РесурсРегистра(Рег, Имя) <> "" Тогда
				Имена.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Если Имена.Количество() > 0 Тогда
			Состав.Добавить(Новый Структура("Вид, Имена", Пара[0], Имена));
		КонецЕсли;
	КонецЦикла;
	Возврат Состав;

КонецФункции

&НаСервере
Функция ПоляСебестоимости(Состав)

	Поля = Новый Массив;
	Для Каждого Часть Из Состав Цикл
		Для Каждого Имя Из Часть.Имена Цикл
			Поля.Добавить("СУММА(Т." + Имя + "Оборот) КАК " + Имя);
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Поля, ",
	|	");

КонецФункции

// Добавляет в строки колонки «Прямые» и «Косвенные»; возвращает, какие ресурсы взяты.
&НаСервере
Функция РазложитьСебестоимость(Строки, Состав)

	Строки.Колонки.Добавить("Прямые", ОписаниеЧисла());
	Строки.Колонки.Добавить("Косвенные", ОписаниеЧисла());
	Взяты = Новый Массив;
	Для Каждого Часть Из Состав Цикл
		Выбранный = "";
		Для Каждого Имя Из Часть.Имена Цикл
			Если Строки.Итог(Имя) <> 0 Тогда
				Выбранный = Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Выбранный = "" Тогда
			Продолжить;
		КонецЕсли;
		Взяты.Добавить(Выбранный + " (" + НРег(Часть.Вид) + ")");
		Для Каждого Стр Из Строки Цикл
			Стр[Часть.Вид] = Стр[Часть.Вид] + ЧислоИлиНоль(Стр[Выбранный]);
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Взяты, ", ");

КонецФункции

&НаСервере
Функция ПолучитьЗапасы(П, Выпуск, Продажи, Заказы)

	// готовая продукция: всё, что выпускали или продавали за два месяца
	Продукты = Новый Массив;
	Если Выпуск <> Неопределено Тогда
		Для Каждого Стр Из Выпуск.ПоПродуктам Цикл
			Продукты.Добавить(Стр.Номенклатура);
		КонецЦикла;
	КонецЕсли;
	Если Продажи <> Неопределено Тогда
		Для Каждого Стр Из Продажи.ПоНоменклатуре Цикл
			Если Продукты.Найти(Стр.Ключ) = Неопределено И Продукты.Количество() < 300 Тогда
				Продукты.Добавить(Стр.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Продукты.Количество() = 0 Тогда
		ВызватьИсключение "нет данных о выпуске и продажах, не понятно, что считать готовой продукцией";
	КонецЕсли;
	Остатки = ОстаткиНаСкладах(Продукты, П);

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Номенклатура");
	Т.Колонки.Добавить("Ед");
	Т.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Т.Колонки.Добавить("ОтгрузкиВСутки", ОписаниеЧисла());
	Т.Колонки.Добавить("ВыпускВСутки", ОписаниеЧисла());
	Т.Колонки.Добавить("ВЗаказах", ОписаниеЧисла());
	Т.Колонки.Добавить("ДнейЗапаса", ОписаниеЧисла());
	Т.Колонки.Добавить("Статус");
	Т.Колонки.Добавить("Порядок", ОписаниеЧисла());
	Для Каждого Ном Из Продукты Цикл
		НовСтр = Т.Добавить();
		НовСтр.Номенклатура = Ном;
		НовСтр.Ед = ЕдиницаНоменклатуры(Ном);
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Ном]);
		Если Продажи <> Неопределено Тогда
			Стр = Продажи.ПоНоменклатуре.Найти(Ном, "Ключ");
			Если Стр <> Неопределено Тогда
				НовСтр.ОтгрузкиВСутки = Стр.Количество30 / 30;
			КонецЕсли;
		КонецЕсли;
		Если Выпуск <> Неопределено Тогда
			Стр = Выпуск.ПоПродуктам.Найти(Ном, "Номенклатура");
			Если Стр <> Неопределено Тогда
				НовСтр.ВыпускВСутки = Стр.За30Дней / 30;
			КонецЕсли;
		КонецЕсли;
		Если Заказы <> Неопределено Тогда
			Стр = Заказы.Продукты.Найти(Ном, "Номенклатура");
			Если Стр <> Неопределено Тогда
				НовСтр.ВЗаказах = Стр.Осталось;
			КонецЕсли;
		КонецЕсли;
		НовСтр.Статус = "в норме";
		НовСтр.Порядок = 2;
		Если НовСтр.ОтгрузкиВСутки > 0 Тогда
			НовСтр.ДнейЗапаса = НовСтр.Остаток / НовСтр.ОтгрузкиВСутки;
			Если НовСтр.ДнейЗапаса < 3 И НовСтр.ВЗаказах > НовСтр.Остаток Тогда
				НовСтр.Статус = "мало";
				НовСтр.Порядок = 0;
			ИначеЕсли НовСтр.ДнейЗапаса > 45 Тогда
				НовСтр.Статус = "затоваривание";
				НовСтр.Порядок = 1;
			КонецЕсли;
		ИначеЕсли НовСтр.Остаток > 0 Тогда
			НовСтр.Статус = "нет продаж 30 дн.";
			НовСтр.Порядок = 1;
		КонецЕсли;
		Если НовСтр.Остаток = 0 И НовСтр.ОтгрузкиВСутки = 0 И НовСтр.ВЗаказах = 0 Тогда
			Т.Удалить(НовСтр);
		КонецЕсли;
	КонецЦикла;
	// только крупные: по стоимости остатка (цена продажи), мелочь — одной строкой «прочие»
	Т.Колонки.Добавить("Стоимость", ОписаниеЧисла());
	Для Каждого Стр Из Т Цикл
		Цена = 0;
		Если Продажи <> Неопределено Тогда
			Продажа = Продажи.ПоНоменклатуре.Найти(Стр.Номенклатура, "Ключ");
			Если Продажа <> Неопределено Тогда
				Цена = ?(Продажа.Цена > 0, Продажа.Цена, Продажа.ЦенаПрошлМесяц);
			КонецЕсли;
		КонецЕсли;
		Стр.Стоимость = Стр.Остаток * Цена;
	КонецЦикла;
	ВсегоСтоимость = Т.Итог("Стоимость");
	Т.Сортировать("Стоимость Убыв, Остаток Убыв");
	Крупные = Т.СкопироватьКолонки();
	Прочие = Новый Структура("Количество, Стоимость", 0, 0);
	Для Каждого Стр Из Т Цикл
		Крупная = Крупные.Количество() < 12 И (ВсегоСтоимость = 0 ИЛИ Стр.Стоимость >= ВсегоСтоимость * 0.02);
		Если Крупная Тогда
			ЗаполнитьЗначенияСвойств(Крупные.Добавить(), Стр);
		Иначе
			Прочие.Количество = Прочие.Количество + 1;
			Прочие.Стоимость = Прочие.Стоимость + Стр.Стоимость;
		КонецЕсли;
	КонецЦикла;
	Р = Новый Структура("Таблица, Прочие, Всего", Крупные, Прочие, ВсегоСтоимость);
	Возврат Р;

КонецФункции

&НаСервере
Функция РеквизитыДокументов(Ссылки, Поля)

	// значения реквизитов для многих документов разных видов: один запрос на вид документа.
	// Поля — Структура: ключ результата → варианты имени реквизита через запятую.
	Результат = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Попытка
			Вид = Ссылка.Метаданные().ПолноеИмя();
		Исключение
			Продолжить;
		КонецПопытки;
		Если ПоВидам[Вид] = Неопределено Тогда
			ПоВидам.Вставить(Вид, Новый Массив);
		КонецЕсли;
		ПоВидам[Вид].Добавить(Ссылка);
	КонецЦикла;
	Для Каждого Элемент Из ПоВидам Цикл
		Мета = Элемент.Значение[0].Метаданные();
		Имена = Новый Структура;
		Список = Новый Массив;
		Для Каждого Поле Из Поля Цикл
			Имя = РеквизитКоллекции(Мета.Реквизиты, Поле.Значение);
			Имена.Вставить(Поле.Ключ, Имя);
			Если Имя <> "" И Список.Найти(Имя) = Неопределено Тогда
				Список.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Если Список.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Элемент.Значение, СтрСоединить(Список, ","));
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого Ссылка Из Элемент.Значение Цикл
			ЗначенияСсылки = Значения[Ссылка];
			Стр = Новый Структура;
			Для Каждого Поле Из Имена Цикл
				Стр.Вставить(Поле.Ключ, ?(Поле.Значение = "" ИЛИ ЗначенияСсылки = Неопределено, Неопределено, ЗначенияСсылки[Поле.Значение]));
			КонецЦикла;
			Результат.Вставить(Ссылка, Стр);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЦеныЗакупокИПотребность

&НаСервере
Функция ЭтоУслуга(Номенклатура)

	ТипНоменклатуры = НРег(Строка(РеквизитСсылки(Номенклатура, "ТипНоменклатуры")));
	Возврат СтрНайти(ТипНоменклатуры, "услуг") > 0 ИЛИ СтрНайти(ТипНоменклатуры, "работ") > 0;

КонецФункции

&НаСервере
Функция ПолучитьЗакупкиГод(П)

	// закупки за 12 месяцев: средняя цена по месяцам, разброс, изменение за год,
	// сравнение поставщиков за последние 3 месяца
	Мета = Метаданные.Документы.Найти("ПриобретениеТоваровУслуг");
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет документа ПриобретениеТоваровУслуг с табличной частью Товары";
	КонецЕсли;
	РекКонтрагент = РеквизитКоллекции(Мета.Реквизиты, "Контрагент,Партнер");
	ПолеКонтрагента = ?(РекКонтрагент = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекКонтрагент);
	ОтборОрганизации = ?(ЗначениеЗаполнено(П.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Т.Ссылка.Организация = &Организация", "");
	ОтборГруппы = ?(ЗначениеЗаполнено(П.ГруппаСырья), "
		|	И Т.Номенклатура В ИЕРАРХИИ (&ГруппаСырья)", "");
	НачалоГода = ДобавитьМесяц(П.НачалоМесяца, -11);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ) КАК Месяц,
		|	" + ПолеКонтрагента + " КАК Контрагент,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т.Количество) КАК Количество,
		|	СУММА(" + ВыражениеСуммыБезНДС("ПриобретениеТоваровУслуг") + ") КАК Сумма
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &НачалоГода И &КонецДня" + ОтборОрганизации + ОтборГруппы + "
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ),
		|	" + ?(РекКонтрагент = "", "", ПолеКонтрагента + ",
		|	") + "Т.Номенклатура";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода);
	Строки = Запрос.Выполнить().Выгрузить();

	Месяцы = Новый Массив;
	Для Н = 0 По 11 Цикл
		Месяцы.Добавить(ДобавитьМесяц(НачалоГода, Н));
	КонецЦикла;

	Итоги = Строки.Скопировать(, "Номенклатура, Количество, Сумма");
	Итоги.Свернуть("Номенклатура", "Количество, Сумма");
	Итоги.Сортировать("Сумма Убыв");
	ПоМесяцам = Строки.Скопировать(, "Номенклатура, Месяц, Количество, Сумма");
	ПоМесяцам.Свернуть("Номенклатура, Месяц", "Количество, Сумма");
	ПоМесяцам.Сортировать("Месяц");

	// последняя известная цена закупки по каждой позиции
	Последние = Новый Соответствие;
	Для Каждого Стр Из ПоМесяцам Цикл
		Если Стр.Количество > 0 И Стр.Сумма > 0 Тогда
			Последние.Вставить(Стр.Номенклатура, Стр.Сумма / Стр.Количество);
		КонецЕсли;
	КонецЦикла;

	Материалы = Новый ТаблицаЗначений;
	Материалы.Колонки.Добавить("Номенклатура");
	Материалы.Колонки.Добавить("Ед");
	Материалы.Колонки.Добавить("Количество", ОписаниеЧисла());
	Материалы.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Материалы.Колонки.Добавить("МинЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("МаксЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("ПерваяЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("ПервыйМесяц");
	Материалы.Колонки.Добавить("ПоследняяЦена", ОписаниеЧисла());
	Материалы.Колонки.Добавить("ПоследнийМесяц");
	Материалы.Колонки.Добавить("ИзмГод");
	Материалы.Колонки.Добавить("Помесячно");
	Для Каждого Ит Из Итоги Цикл
		Если Материалы.Количество() >= 300 Тогда
			Прервать;
		КонецЕсли;
		Если Ит.Сумма <= 0 ИЛИ Ит.Количество <= 0 ИЛИ ЭтоУслуга(Ит.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Ит);
		НовСтр.Ед = ЕдиницаНоменклатуры(Ит.Номенклатура);
		НовСтр.Помесячно = Новый Соответствие;
		Для Каждого Стр Из ПоМесяцам.НайтиСтроки(Новый Структура("Номенклатура", Ит.Номенклатура)) Цикл
			Если Стр.Количество <= 0 ИЛИ Стр.Сумма <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Цена = Стр.Сумма / Стр.Количество;
			НовСтр.Помесячно.Вставить(Стр.Месяц, Цена);
			Если НовСтр.МинЦена = 0 ИЛИ Цена < НовСтр.МинЦена Тогда
				НовСтр.МинЦена = Цена;
			КонецЕсли;
			НовСтр.МаксЦена = Макс(НовСтр.МаксЦена, Цена);
			Если НовСтр.ПервыйМесяц = Неопределено Тогда
				НовСтр.ПервыйМесяц = Стр.Месяц;
				НовСтр.ПерваяЦена = Цена;
			КонецЕсли;
			НовСтр.ПоследнийМесяц = Стр.Месяц;
			НовСтр.ПоследняяЦена = Цена;
		КонецЦикла;
		Если НовСтр.ПерваяЦена > 0 И НовСтр.ПоследнийМесяц <> НовСтр.ПервыйМесяц Тогда
			НовСтр.ИзмГод = (НовСтр.ПоследняяЦена / НовСтр.ПерваяЦена - 1) * 100;
		КонецЕсли;
	КонецЦикла;

	// поставщики за 3 месяца: кто дешевле по одной и той же позиции
	Начало3 = ДобавитьМесяц(П.НачалоМесяца, -2);
	Последние3 = Строки.СкопироватьКолонки();
	Для Каждого Стр Из Строки Цикл
		Если Стр.Месяц >= Начало3 Тогда
			ЗаполнитьЗначенияСвойств(Последние3.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;
	Последние3.Свернуть("Номенклатура, Контрагент", "Количество, Сумма");
	Сравнение = Новый ТаблицаЗначений;
	Сравнение.Колонки.Добавить("Номенклатура");
	Сравнение.Колонки.Добавить("Контрагент");
	Сравнение.Колонки.Добавить("Ед");
	Сравнение.Колонки.Добавить("Количество", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Цена", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Отклонение", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Переплата", ОписаниеЧисла());
	Сравнение.Колонки.Добавить("Лучший", Новый ОписаниеТипов("Булево"));
	Переплата = 0;
	Для Каждого Мат Из Материалы Цикл
		Варианты = Последние3.НайтиСтроки(Новый Структура("Номенклатура", Мат.Номенклатура));
		Если Варианты.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Лучшая = 0;
		Для Каждого Стр Из Варианты Цикл
			Если Стр.Количество > 0 И Стр.Сумма > 0 И (Лучшая = 0 ИЛИ Стр.Сумма / Стр.Количество < Лучшая) Тогда
				Лучшая = Стр.Сумма / Стр.Количество;
			КонецЕсли;
		КонецЦикла;
		Если Лучшая = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Стр Из Варианты Цикл
			Если Стр.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = Сравнение.Добавить();
			НовСтр.Номенклатура = Мат.Номенклатура;
			НовСтр.Контрагент = Стр.Контрагент;
			НовСтр.Ед = Мат.Ед;
			НовСтр.Количество = Стр.Количество;
			НовСтр.Цена = Стр.Сумма / Стр.Количество;
			НовСтр.Отклонение = (НовСтр.Цена / Лучшая - 1) * 100;
			НовСтр.Переплата = (НовСтр.Цена - Лучшая) * Стр.Количество;
			НовСтр.Лучший = НовСтр.Отклонение < 0.05;
			Переплата = Переплата + НовСтр.Переплата;
		КонецЦикла;
	КонецЦикла;

	Р = Новый Структура;
	Р.Вставить("Месяцы", Месяцы);
	Р.Вставить("Материалы", Материалы);
	Р.Вставить("Последние", Последние);
	Р.Вставить("Сравнение", Сравнение);
	Р.Вставить("Переплата", Переплата);
	Р.Вставить("ЗаГод", Итоги.Итог("Сумма"));
	Возврат Р;

КонецФункции

&НаСервере
Функция ВыражениеКоличестваВСпецификации(ТЧ, Псевдоним)

	// количество строки спецификации в базовых единицах номенклатуры:
	// поле «опти_Количество» (если заполнено), иначе количество упаковок × коэффициент упаковки
	ВУпаковках = Псевдоним + ".КоличествоУпаковок";
	МетаУпаковок = Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения");
	Если ТЧ.Реквизиты.Найти("Упаковка") <> Неопределено И МетаУпаковок <> Неопределено
		И МетаУпаковок.Реквизиты.Найти("Числитель") <> Неопределено И МетаУпаковок.Реквизиты.Найти("Знаменатель") <> Неопределено Тогда
		ВУпаковках = Псевдоним + ".КоличествоУпаковок * ЕСТЬNULL(ВЫБОР КОГДА " + Псевдоним + ".Упаковка.Знаменатель > 0 И "
			+ Псевдоним + ".Упаковка.Числитель > 0 ТОГДА " + Псевдоним + ".Упаковка.Числитель / " + Псевдоним + ".Упаковка.Знаменатель ИНАЧЕ 1 КОНЕЦ, 1)";
	КонецЕсли;
	Если ТЧ.Реквизиты.Найти("Количество") <> Неопределено Тогда
		Возврат Псевдоним + ".Количество";
	ИначеЕсли ТЧ.Реквизиты.Найти("опти_Количество") <> Неопределено Тогда
		Возврат "ВЫБОР КОГДА " + Псевдоним + ".опти_Количество <> 0 ТОГДА " + Псевдоним + ".опти_Количество ИНАЧЕ " + ВУпаковках + " КОНЕЦ";
	КонецЕсли;
	Возврат ВУпаковках;

КонецФункции

&НаСервере
Функция СпецификацииИзПроизводства(П)

	// какая спецификация последней применялась в суточных рапортах для каждого продукта (90 дней)
	Результат = Новый Соответствие;
	Мета = Метаданные.Документы.Найти("ПроизводствоБезЗаказа");
	Если Мета = Неопределено ИЛИ Мета.ТабличныеЧасти.Найти("ВыходныеИзделия") = Неопределено
		ИЛИ Мета.ТабличныеЧасти.ВыходныеИзделия.Реквизиты.Найти("Спецификация") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Спецификация КАК Спецификация,
		|	МАКСИМУМ(Т.Ссылка.Дата) КАК Дата
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.Дата МЕЖДУ &Начало90 И &КонецДня
		|	И Т.Спецификация <> ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура,
		|	Т.Спецификация
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	Запрос.УстановитьПараметр("Начало90", П.День - 89 * 86400);
	Запрос.УстановитьПараметр("КонецДня", П.КонецДня);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Спецификация);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция НормыИзСпецификаций(Продукты, П, ЗаданныеСпецификации = Неопределено)

	// нормы на 1 базовую единицу продукта: материал → (норма, статья калькуляции).
	// Спецификация: из плана производства, иначе последняя из суточных рапортов, иначе действующая.
	// Строки со статьёй «Полуфабрикат» раскладываются по спецификации полуфабриката (до 5 уровней).
	Результат = Новый Соответствие;
	МетаСпец = Метаданные.Справочники.Найти("РесурсныеСпецификации");
	Если МетаСпец = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ТЧВыход = МетаСпец.ТабличныеЧасти.Найти("ВыходныеИзделия");
	ТЧМатериалы = МетаСпец.ТабличныеЧасти.Найти("МатериалыИУслуги");
	Если ТЧВыход = Неопределено ИЛИ ТЧМатериалы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЕстьСтатус = МетаСпец.Реквизиты.Найти("Статус") <> Неопределено;
	ЕстьСтатья = ТЧМатериалы.Реквизиты.Найти("СтатьяКалькуляции") <> Неопределено;
	ИзПроизводства = СпецификацииИзПроизводства(П);

	Прямые = Новый Соответствие;
	ВыбраннаяСпецификация = Новый Соответствие;
	Запрошено = Новый Соответствие;
	Очередь = Новый Массив;
	Для Каждого Ном Из Продукты Цикл
		Очередь.Добавить(Ном);
	КонецЦикла;
	Запрос = Новый Запрос;
	Для Уровень = 1 По 5 Цикл
		Список = Новый Массив;
		Для Каждого Ном Из Очередь Цикл
			Если Запрошено[Ном] = Неопределено Тогда
				Список.Добавить(Ном);
				Запрошено.Вставить(Ном, Истина);
			КонецЕсли;
		КонецЦикла;
		Если Список.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// спецификация для каждого продукта
		БезСпецификации = Новый Массив;
		Для Каждого Ном Из Список Цикл
			Спец = Неопределено;
			Если ЗаданныеСпецификации <> Неопределено Тогда
				Спец = ЗаданныеСпецификации[Ном];
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Спец) Тогда
				Спец = ИзПроизводства[Ном];
			КонецЕсли;
			Если ЗначениеЗаполнено(Спец) Тогда
				ВыбраннаяСпецификация.Вставить(Ном, Спец);
			Иначе
				БезСпецификации.Добавить(Ном);
			КонецЕсли;
		КонецЦикла;
		Если БезСпецификации.Количество() > 0 Тогда
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Вых.Ссылка КАК Спецификация,
				|	Вых.Номенклатура КАК Продукт,
				|	" + ?(ЕстьСтатус, "Вых.Ссылка.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус
				|ИЗ
				|	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК Вых
				|ГДЕ
				|	НЕ Вых.Ссылка.ПометкаУдаления
				|	И Вых.Номенклатура В (&Список)";
			Запрос.УстановитьПараметр("Список", БезСпецификации);
			Действующая = Новый Соответствие;
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Действует = НЕ ЕстьСтатус ИЛИ СтрНайти(НРег(Строка(Выборка.Статус)), "действ") > 0;
				Если ВыбраннаяСпецификация[Выборка.Продукт] = Неопределено ИЛИ (Действует И НЕ Действующая[Выборка.Продукт] = Истина) Тогда
					ВыбраннаяСпецификация.Вставить(Выборка.Продукт, Выборка.Спецификация);
					Действующая.Вставить(Выборка.Продукт, Действует);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Спецификации = Новый Массив;
		Для Каждого Ном Из Список Цикл
			Спец = ВыбраннаяСпецификация[Ном];
			Если ЗначениеЗаполнено(Спец) И Спецификации.Найти(Спец) = Неопределено Тогда
				Спецификации.Добавить(Спец);
			КонецЕсли;
		КонецЦикла;
		Если Спецификации.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// сколько продукта выходит по спецификации (в базовых единицах)
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Вых.Ссылка КАК Спецификация,
			|	Вых.Номенклатура КАК Продукт,
			|	СУММА(" + ВыражениеКоличестваВСпецификации(ТЧВыход, "Вых") + ") КАК Выход
			|ИЗ
			|	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК Вых
			|ГДЕ
			|	Вых.Ссылка В (&Спецификации)
			|СГРУППИРОВАТЬ ПО
			|	Вых.Ссылка,
			|	Вых.Номенклатура";
		Запрос.УстановитьПараметр("Спецификации", Спецификации);
		Выходы = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Выходы.Вставить(Строка(Выборка.Спецификация.УникальныйИдентификатор()) + "|" + Строка(Выборка.Продукт.УникальныйИдентификатор()), Выборка.Выход);
		КонецЦикла;

		// материалы спецификаций (в базовых единицах)
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Мат.Ссылка КАК Спецификация,
			|	Мат.Номенклатура КАК Материал,
			|	" + ?(ЕстьСтатья, "Мат.СтатьяКалькуляции", "НЕОПРЕДЕЛЕНО") + " КАК Статья,
			|	СУММА(" + ВыражениеКоличестваВСпецификации(ТЧМатериалы, "Мат") + ") КАК Количество
			|ИЗ
			|	Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК Мат
			|ГДЕ
			|	Мат.Ссылка В (&Спецификации)
			|СГРУППИРОВАТЬ ПО
			|	Мат.Ссылка,
			|	Мат.Номенклатура" + ?(ЕстьСтатья, ",
			|	Мат.СтатьяКалькуляции", "");
		Материалы = Запрос.Выполнить().Выгрузить();
		Очередь = Новый Массив;
		Для Каждого Ном Из Список Цикл
			Спец = ВыбраннаяСпецификация[Ном];
			Если НЕ ЗначениеЗаполнено(Спец) Тогда
				Продолжить;
			КонецЕсли;
			Выход = ЧислоИлиНоль(Выходы[Строка(Спец.УникальныйИдентификатор()) + "|" + Строка(Ном.УникальныйИдентификатор())]);
			Если Выход <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Строки = Новый Массив;
			Для Каждого Стр Из Материалы.НайтиСтроки(Новый Структура("Спецификация", Спец)) Цикл
				Если НЕ ЗначениеЗаполнено(Стр.Материал) Тогда
					Продолжить;
				КонецЕсли;
				Полуфабрикат = СтрНайти(НРег(Строка(Стр.Статья)), "полуфабрикат") > 0;
				Строки.Добавить(Новый Структура("Материал, Норма, Статья, Полуфабрикат", Стр.Материал, Стр.Количество / Выход, Стр.Статья, Полуфабрикат));
				Если Полуфабрикат Тогда
					Очередь.Добавить(Стр.Материал);
				КонецЕсли;
			КонецЦикла;
			Прямые.Вставить(Ном, Строки);
		КонецЦикла;
	КонецЦикла;

	Для Каждого Ном Из Продукты Цикл
		Если Прямые[Ном] <> Неопределено Тогда
			Итог = Новый Соответствие;
			РазвернутьНормы(Прямые, Ном, 1, 1, Итог);
			Результат.Вставить(Ном, Итог);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Спецификации", ВыбраннаяСпецификация);
	Возврат Результат;

КонецФункции

&НаСервере
Процедура РазвернутьНормы(Прямые, Номенклатура, Множитель, Глубина, Итог)

	Для Каждого Стр Из Прямые[Номенклатура] Цикл
		Вложенные = Прямые[Стр.Материал];
		Если Стр.Полуфабрикат И Вложенные <> Неопределено И Глубина < 5 И Стр.Материал <> Номенклатура Тогда
			РазвернутьНормы(Прямые, Стр.Материал, Множитель * Стр.Норма, Глубина + 1, Итог);
		Иначе
			Было = Итог[Стр.Материал];
			Если Было = Неопределено Тогда
				Итог.Вставить(Стр.Материал, Новый Структура("Норма, Статья", Множитель * Стр.Норма, Стр.Статья));
			Иначе
				Было.Норма = Было.Норма + Множитель * Стр.Норма;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьПотребность(П, Р)

	// потребность в основном сырье: остаток плана производства месяца, план следующего месяца
	// и выпуск под заказы × нормы спецификаций; сравнение с остатками и поставками в пути
	Если Р.Выпуск = Неопределено Тогда
		ВызватьИсключение "нет данных о выпуске и плане производства";
	КонецЕсли;
	Вып = Р.Выпуск;
	ЕстьПлан = Вып.ЕстьПланПроизводства;
	План = Новый ТаблицаЗначений;
	План.Колонки.Добавить("Номенклатура");
	План.Колонки.Добавить("Ед");
	План.Колонки.Добавить("ОстатокПлана", ОписаниеЧисла());
	План.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	План.Колонки.Добавить("НаЗаказы", ОписаниеЧисла());
	План.Колонки.Добавить("Нормы");
	План.Колонки.Добавить("ИсточникНорм");
	План.Колонки.Добавить("Спецификация");
	Спецификации = Новый Соответствие;
	Для Каждого Стр Из Вып.ПоПродуктам Цикл
		Если Стр.Полуфабрикат Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = План.Добавить();
		НовСтр.Номенклатура = Стр.Номенклатура;
		НовСтр.Ед = Стр.Ед;
		Если ЕстьПлан Тогда
			НовСтр.ОстатокПлана = Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц);
			НовСтр.ПланСледующего = Стр.ПланСледующего;
		Иначе
			НовСтр.ОстатокПлана = Стр.За30Дней / 30 * Вып.ОсталосьДней;
			НовСтр.ПланСледующего = Стр.За30Дней;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Спецификация) Тогда
			Спецификации.Вставить(Стр.Номенклатура, Стр.Спецификация);
		КонецЕсли;
	КонецЦикла;
	Если Р.Заказы <> Неопределено Тогда
		Для Каждого Стр Из Р.Заказы.Продукты Цикл
			НовСтр = План.Найти(Стр.Номенклатура, "Номенклатура");
			Если НовСтр = Неопределено Тогда
				НовСтр = План.Добавить();
				НовСтр.Номенклатура = Стр.Номенклатура;
				НовСтр.Ед = Стр.Ед;
			КонецЕсли;
			НовСтр.НаЗаказы = Макс(0, Стр.Выпустить);
		КонецЦикла;
	КонецЕсли;
	// продукты без плана и заказов не нужны
	// с конца: число строк запоминается один раз, иначе после удаления индекс уходит за границы
	ВсегоСтрок = План.Количество();
	Для Индекс = 1 По ВсегоСтрок Цикл
		Стр = План[ВсегоСтрок - Индекс];
		Если Стр.ОстатокПлана = 0 И Стр.ПланСледующего = 0 И Стр.НаЗаказы = 0 Тогда
			План.Удалить(Стр);
		КонецЕсли;
	КонецЦикла;

	Нормы = НормыИзСпецификаций(План.ВыгрузитьКолонку("Номенклатура"), П, Спецификации);
	Выбранные = Нормы["Спецификации"];
	ПоСпецификациям = 0;
	БезНорм = Новый Массив;
	Для Каждого Стр Из План Цикл
		Стр.Нормы = Нормы[Стр.Номенклатура];
		Если Стр.Нормы <> Неопределено И Стр.Нормы.Количество() > 0 Тогда
			Стр.ИсточникНорм = "спецификация";
			Стр.Спецификация = ?(Выбранные = Неопределено, Неопределено, Выбранные[Стр.Номенклатура]);
			ПоСпецификациям = ПоСпецификациям + 1;
		Иначе
			Стр.Нормы = Неопределено;
			Стр.ИсточникНорм = "нет спецификации";
			БезНорм.Добавить(Строка(Стр.Номенклатура));
		КонецЕсли;
	КонецЦикла;

	Потребность = Новый Соответствие;
	Для Каждого Стр Из План Цикл
		Если Стр.Нормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Стр.Нормы Цикл
			Если НЕ ЭтоОсновноеСырье(Элемент.Значение.Статья, П) Тогда
				Продолжить;
			КонецЕсли;
			Нужно = Потребность[Элемент.Ключ];
			Если Нужно = Неопределено Тогда
				Нужно = Новый Структура("ОстатокПлана, ПланСледующего, НаЗаказы", 0, 0, 0);
				Потребность.Вставить(Элемент.Ключ, Нужно);
			КонецЕсли;
			Норма = Элемент.Значение.Норма;
			Нужно.ОстатокПлана = Нужно.ОстатокПлана + Стр.ОстатокПлана * Норма;
			Нужно.ПланСледующего = Нужно.ПланСледующего + Стр.ПланСледующего * Норма;
			Нужно.НаЗаказы = Нужно.НаЗаказы + Стр.НаЗаказы * Норма;
		КонецЦикла;
	КонецЦикла;

	Материалы = Новый Массив;
	Для Каждого Элемент Из Потребность Цикл
		Материалы.Добавить(Элемент.Ключ);
	КонецЦикла;
	Остатки = ОстаткиНаСкладах(Материалы, П);
	ВПути = ПоставкиВПути(Материалы, П);
	Цены = ЦеныСырья(Р);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Ед");
	Таблица.Колонки.Добавить("ОстатокПлана", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ПланСледующего", ОписаниеЧисла());
	Таблица.Колонки.Добавить("НаЗаказы", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Остаток", ОписаниеЧисла());
	Таблица.Колонки.Добавить("ВПути", ОписаниеЧисла());
	Таблица.Колонки.Добавить("НехваткаМесяц", ОписаниеЧисла());
	Таблица.Колонки.Добавить("НехваткаДвухМесяцев", ОписаниеЧисла());
	Таблица.Колонки.Добавить("Цена", ОписаниеЧисла());
	Таблица.Колонки.Добавить("СуммаДокупки", ОписаниеЧисла());
	Для Каждого Элемент Из Потребность Цикл
		НовСтр = Таблица.Добавить();
		НовСтр.Номенклатура = Элемент.Ключ;
		НовСтр.Ед = ЕдиницаНоменклатуры(Элемент.Ключ);
		НовСтр.ОстатокПлана = Элемент.Значение.ОстатокПлана;
		НовСтр.ПланСледующего = Элемент.Значение.ПланСледующего;
		НовСтр.НаЗаказы = Элемент.Значение.НаЗаказы;
		НовСтр.Остаток = ЧислоИлиНоль(Остатки[Элемент.Ключ]);
		Поставка = ВПути[Элемент.Ключ];
		НовСтр.ВПути = ?(Поставка = Неопределено, 0, Поставка.Количество);
		Есть = НовСтр.Остаток + НовСтр.ВПути;
		НовСтр.НехваткаМесяц = Макс(0, НовСтр.ОстатокПлана - Есть);
		НовСтр.НехваткаДвухМесяцев = Макс(0, НовСтр.ОстатокПлана + НовСтр.ПланСледующего - Есть);
		НовСтр.Цена = ЧислоИлиНоль(Цены[Элемент.Ключ]);
		НовСтр.СуммаДокупки = НовСтр.НехваткаДвухМесяцев * НовСтр.Цена;
	КонецЦикла;
	Таблица.Сортировать("СуммаДокупки Убыв, НехваткаДвухМесяцев Убыв, ОстатокПлана Убыв");

	// стоимость основного сырья на единицу продукта по нормам и последним ценам закупки
	Затраты = Новый ТаблицаЗначений;
	Затраты.Колонки.Добавить("Номенклатура");
	Затраты.Колонки.Добавить("Ед");
	Затраты.Колонки.Добавить("НаЕдиницу", ОписаниеЧисла());
	Затраты.Колонки.Добавить("ЦенаПродажи", ОписаниеЧисла());
	Затраты.Колонки.Добавить("Доля");
	Затраты.Колонки.Добавить("БезЦены");
	Затраты.Колонки.Добавить("Главное");
	Затраты.Колонки.Добавить("Спецификация");
	Для Каждого Стр Из План Цикл
		Если Стр.Нормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Затраты.Добавить();
		НовСтр.Номенклатура = Стр.Номенклатура;
		НовСтр.Ед = Стр.Ед;
		НовСтр.Спецификация = Стр.Спецификация;
		НетЦены = Новый Массив;
		Крупнейшая = 0;
		Для Каждого Элемент Из Стр.Нормы Цикл
			Если НЕ ЭтоОсновноеСырье(Элемент.Значение.Статья, П) Тогда
				Продолжить;
			КонецЕсли;
			Цена = ЧислоИлиНоль(Цены[Элемент.Ключ]);
			Если Цена = 0 Тогда
				НетЦены.Добавить(Строка(Элемент.Ключ));
			КонецЕсли;
			Сумма = Элемент.Значение.Норма * Цена;
			НовСтр.НаЕдиницу = НовСтр.НаЕдиницу + Сумма;
			Если Сумма > Крупнейшая Тогда
				Крупнейшая = Сумма;
				НовСтр.Главное = Строка(Элемент.Ключ) + " — " + Формат(Сумма / Макс(НовСтр.НаЕдиницу, 0.01) * 100, "ЧДЦ=0") + " %";
			КонецЕсли;
		КонецЦикла;
		Если Крупнейшая > 0 И НовСтр.НаЕдиницу > 0 Тогда
			// доля главной статьи считается от итоговой стоимости
			Для Каждого Элемент Из Стр.Нормы Цикл
				Если ЭтоОсновноеСырье(Элемент.Значение.Статья, П) И Элемент.Значение.Норма * ЧислоИлиНоль(Цены[Элемент.Ключ]) = Крупнейшая Тогда
					НовСтр.Главное = Строка(Элемент.Ключ) + " — " + Формат(Крупнейшая / НовСтр.НаЕдиницу * 100, "ЧДЦ=0") + " %";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		НовСтр.БезЦены = СтрСоединить(НетЦены, ", ");
		Если Р.Продажи <> Неопределено Тогда
			Продажа = Р.Продажи.ПоНоменклатуре.Найти(Стр.Номенклатура, "Ключ");
			Если Продажа <> Неопределено Тогда
				НовСтр.ЦенаПродажи = ?(Продажа.Цена > 0, Продажа.Цена, Продажа.ЦенаПрошлМесяц);
			КонецЕсли;
		КонецЕсли;
		Если НовСтр.ЦенаПродажи > 0 Тогда
			НовСтр.Доля = НовСтр.НаЕдиницу / НовСтр.ЦенаПродажи * 100;
		КонецЕсли;
	КонецЦикла;
	Затраты.Сортировать("НаЕдиницу Убыв");

	Результат = Новый Структура;
	Результат.Вставить("План", План);
	Результат.Вставить("ЕстьПлан", ЕстьПлан);
	Результат.Вставить("Таблица", Таблица);
	Результат.Вставить("Затраты", Затраты);
	Результат.Вставить("ПоСпецификациям", ПоСпецификациям);
	Результат.Вставить("БезНорм", БезНорм);
	Результат.Вставить("СуммаДокупки", Таблица.Итог("СуммаДокупки"));
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЦеныСырья(Р)

	// последняя цена закупки без НДС: за 12 месяцев, иначе за текущий и прошлый месяц
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Возврат Р.ЗакупкиГод.Последние;
	ИначеЕсли Р.Закупки <> Неопределено Тогда
		Возврат Р.Закупки.Цены;
	КонецЕсли;
	Возврат Новый Соответствие;

КонецФункции

#КонецОбласти

#Область Диагностика

&НаСервере
Процедура ОставитьОсновноеСырье(Р)

	// основное сырьё — позиции, на которые приходится 90 % затрат на сырьё за 30 дней
	// (расход или потребность × последняя цена закупки), но не больше 12; остальное скрываем
	Цены = Новый Соответствие;
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Цены = Р.ЗакупкиГод.Последние;
	ИначеЕсли Р.Закупки <> Неопределено Тогда
		Цены = Р.Закупки.Цены;
	КонецЕсли;
	Стоимость = Новый ТаблицаЗначений;
	Стоимость.Колонки.Добавить("Номенклатура");
	Стоимость.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Если Р.Сырье <> Неопределено Тогда
		Для Каждого Стр Из Р.Сырье.Материалы Цикл
			НовСтр = Стоимость.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			НовСтр.Сумма = Стр.ВСутки * 30 * ЧислоИлиНоль(Цены[Стр.Номенклатура]);
		КонецЦикла;
	КонецЕсли;
	Если Р.Потребность <> Неопределено Тогда
		Для Каждого Стр Из Р.Потребность.Таблица Цикл
			НовСтр = Стоимость.Добавить();
			НовСтр.Номенклатура = Стр.Номенклатура;
			НовСтр.Сумма = Стр.На30 * ЧислоИлиНоль(Цены[Стр.Номенклатура]);
		КонецЦикла;
	КонецЕсли;
	// по каждой позиции — большая из двух оценок
	Стоимость.Сортировать("Сумма Убыв");
	Основное = Новый Соответствие;
	Учтено = Новый Соответствие;
	Всего = 0;
	Для Каждого Стр Из Стоимость Цикл
		Если Учтено[Стр.Номенклатура] = Неопределено Тогда
			Учтено.Вставить(Стр.Номенклатура, Истина);
			Всего = Всего + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Если Всего = 0 Тогда
		Возврат;
	КонецЕсли;
	Накоплено = 0;
	Учтено = Новый Соответствие;
	Для Каждого Стр Из Стоимость Цикл
		Если Учтено[Стр.Номенклатура] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтено.Вставить(Стр.Номенклатура, Истина);
		Если Основное.Количество() >= 12 ИЛИ (Накоплено >= Всего * 0.9 И Основное.Количество() >= 3) ИЛИ Стр.Сумма = 0 Тогда
			Прервать;
		КонецЕсли;
		Основное.Вставить(Стр.Номенклатура, Истина);
		Накоплено = Накоплено + Стр.Сумма;
	КонецЦикла;

	Если Р.Сырье <> Неопределено Тогда
		Т = Р.Сырье.Материалы;
		Скрыто = 0;
		// с конца: число строк запоминается один раз, иначе после удаления индекс уходит за границы
		ВсегоСтрок = Т.Количество();
		Для Индекс = 1 По ВсегоСтрок Цикл
			Стр = Т[ВсегоСтрок - Индекс];
			Если Основное[Стр.Номенклатура] = Неопределено Тогда
				Т.Удалить(Стр);
				Скрыто = Скрыто + 1;
			КонецЕсли;
		КонецЦикла;
		Р.Сырье.Нехватка = Т.НайтиСтроки(Новый Структура("Статус", "нехватка"));
		Р.Сырье.Заказать = Т.НайтиСтроки(Новый Структура("Статус", "заказать"));
		Р.Сырье.Вставить("Скрыто", Скрыто);
	КонецЕсли;
	Если Р.Потребность <> Неопределено Тогда
		Т = Р.Потребность.Таблица;
		Скрыто = 0;
		// с конца: число строк запоминается один раз, иначе после удаления индекс уходит за границы
		ВсегоСтрок = Т.Количество();
		Для Индекс = 1 По ВсегоСтрок Цикл
			Стр = Т[ВсегоСтрок - Индекс];
			Если Основное[Стр.Номенклатура] = Неопределено Тогда
				Т.Удалить(Стр);
				Скрыто = Скрыто + 1;
			КонецЕсли;
		КонецЦикла;
		Р.Потребность.СуммаДокупки = Т.Итог("СуммаДокупки");
		Р.Потребность.Вставить("Скрыто", Скрыто);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОставитьОсновноеВЗакупках(Р)

	// в таблицах закупок оставляем только основное сырьё (итоги по закупкам не меняются)
	Основное = Новый Соответствие;
	Если Р.Сырье <> Неопределено Тогда
		Для Каждого Стр Из Р.Сырье.Материалы Цикл
			Основное.Вставить(Стр.Номенклатура, Истина);
		КонецЦикла;
	КонецЕсли;
	Если Р.Потребность <> Неопределено Тогда
		Для Каждого Стр Из Р.Потребность.Таблица Цикл
			Основное.Вставить(Стр.Номенклатура, Истина);
		КонецЦикла;
	КонецЕсли;
	Если Основное.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Таблицы = Новый Массив;
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Таблицы.Добавить(Новый Структура("Т, Поле", Р.ЗакупкиГод.Материалы, "Номенклатура"));
		Таблицы.Добавить(Новый Структура("Т, Поле", Р.ЗакупкиГод.Сравнение, "Номенклатура"));
	КонецЕсли;
	Если Р.Закупки <> Неопределено Тогда
		Таблицы.Добавить(Новый Структура("Т, Поле", Р.Закупки.ПоНоменклатуре, "Ключ"));
	КонецЕсли;
	Для Каждого Опис Из Таблицы Цикл
		// с конца: число строк запоминается один раз, иначе после удаления индекс уходит за границы
		ВсегоСтрок = Опис.Т.Количество();
		Для Индекс = 1 По ВсегоСтрок Цикл
			Стр = Опис.Т[ВсегоСтрок - Индекс];
			Если Основное[Стр[Опис.Поле]] = Неопределено Тогда
				Опис.Т.Удалить(Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Р.ЗакупкиГод <> Неопределено Тогда
		Р.ЗакупкиГод.Переплата = Р.ЗакупкиГод.Сравнение.Итог("Переплата");
		Р.ЗакупкиГод.Вставить("ТолькоОсновное", Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДиагностикаНаСервере()

	// сведения о структуре базы и пробные цифры разделов — чтобы настроить отчёт под эту базу
	СохранитьНастройки();
	Строки = Новый Массив;
	Попытка
		СобратьДиагностику(Строки);
	Исключение
		Строки.Добавить("ОШИБКА ДИАГНОСТИКИ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Текст = СтрСоединить(Строки, Символы.ПС);

	ТД = Новый ТабличныйДокумент;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	Попытка
		ТД.Область("C1").ШиринаКолонки = 250;
	Исключение
		ТД.Область(1, 1, 1, 1).ШиринаКолонки = 250;
	КонецПопытки;
	ШрифтТекста = Новый Шрифт("Courier New", 9);
	Номер = 0;
	Для Каждого ТекстСтроки Из Строки Цикл
		Номер = Номер + 1;
		Обл = ТД.Область(Номер, 1, Номер, 1);
		Обл.Текст = ТекстСтроки;
		Обл.Шрифт = ШрифтТекста;
	КонецЦикла;
	ЭтаФорма["ДокументОтчета"] = ТД;
	Текст = ОбезличитьДляЧата(Текст); // на экране — как есть, в файл для чата — без названий
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура СобратьДиагностику(Строки)

	П = ПараметрыОтчета();
	Строки.Добавить("ДИАГНОСТИКА ЕЖЕДНЕВНОГО ОТЧЁТА");
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия);
	Строки.Добавить("Дата отчёта: " + Формат(П.День, "ДФ=dd.MM.yyyy") + "; организация: " + ?(ЗначениеЗаполнено(П.Организация), Строка(П.Организация), "все")
		+ "; группа сырья: " + ?(ЗначениеЗаполнено(П.ГруппаСырья), Строка(П.ГруппаСырья), "не задана"));

	ЗаголовокДиагностики(Строки, "1. РЕГИСТРЫ НАКОПЛЕНИЯ");
	Слова = "Денежн,Расчет,Заказ,ТоварыНаСкладах,Выпуск,Производ,Выручк,Себестоим,Материал,Продукц,ДДС,Платеж,Потребн,Обеспечен,Партии";
	Для Каждого Мета Из Метаданные.РегистрыНакопления Цикл
		Если ИмяПодходит(Мета.Имя, Слова) Тогда
			Строки.Добавить("РН." + Мета.Имя + " (" + Мета.Синоним + "), " + Строка(Мета.ВидРегистра));
			Строки.Добавить("   измерения: " + ОписаниеПолей(Мета.Измерения, Истина));
			Строки.Добавить("   ресурсы:   " + ОписаниеПолей(Мета.Ресурсы, Ложь));
			Строки.Добавить("   реквизиты: " + ОписаниеПолей(Мета.Реквизиты, Ложь));
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "2. СПРАВОЧНИКИ: технологические карты, спецификации, нормы");
	Для Каждого Мета Из Метаданные.Справочники Цикл
		Если ИмяПодходит(Мета.Имя + " " + Мета.Синоним, "Технолог,Спецификац,Рецепт,Норм,Маршрут,Карт") Тогда
			ОписатьОбъект(Строки, Мета, "Справочник");
			ПримерОбъекта(Строки, Мета, "Справочник");
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "3. ДОКУМЕНТЫ ПРОИЗВОДСТВА");
	Для Каждого Мета Из Метаданные.Документы Цикл
		Если ИмяПодходит(Мета.Имя + " " + Мета.Синоним, "Производ,Выпуск,Этап,ПередачаМатериал,Сборк,Переработ,Технолог,Маршрут,Смен,Рапорт,Варк,Сушк") Тогда
			ОписатьОбъект(Строки, Мета, "Документ");
			ПримерОбъекта(Строки, Мета, "Документ");
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "4. КАКИЕ ДОКУМЕНТЫ ДВИГАЛИ РЕГИСТРЫ ЗА 30 ДНЕЙ");
	Для Каждого ИмяРегистра Из СтрРазделить("ТоварыНаСкладах,ДенежныеСредстваБезналичные,ДенежныеСредстваНаличные", ",") Цикл
		РегистраторыПоВидам(Строки, ИмяРегистра, П);
	КонецЦикла;
	Для Каждого Мета Из Метаданные.РегистрыНакопления Цикл
		Если ИмяПодходит(Мета.Имя, "Выпуск,Продукц,Производ,Себестоим,Выручк") Тогда
			РегистраторыПоВидам(Строки, Мета.Имя, П);
		КонецЕсли;
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "4б. АРЕНДАТОРЫ");
	Попытка
		Ар = ПолучитьАренду(П, Неопределено);
		Строки.Добавить("Арендаторов: " + Ар.Таблица.Количество() + "; начислено с 1-го " + Формат(Ар.Месяц, "ЧДЦ=0; ЧН=0")
			+ ", с начала года " + Формат(Ар.СНачалаГода, "ЧДЦ=0; ЧН=0"));
		Для Каждого ТекстИсточника Из Ар.Источники Цикл
			Строки.Добавить("   " + ТекстИсточника);
		КонецЦикла;
		Для Каждого МетаДокумента Из Метаданные.Документы Цикл
			Если СтрНайти(НРег(МетаДокумента.Имя), "аренд") > 0 Тогда
				Строки.Добавить("   документ «" + МетаДокумента.Синоним + "» (" + МетаДокумента.Имя + "): шапка " + ОписаниеПолей(МетаДокумента.Реквизиты, Ложь));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Аренда: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаголовокДиагностики(Строки, "4а. ДЕПОЗИТЫ");
	Попытка
		Деп = ПолучитьДепозиты(П);
		Строки.Добавить("Итог: на начало дня " + Формат(Деп.Вчера, "ЧДЦ=0; ЧН=0") + ", на конец " + Формат(Деп.Сегодня, "ЧДЦ=0; ЧН=0")
			+ "; источник: " + ?(ПустаяСтрока(Деп.Источник), "не найден", Деп.Источник));
		Для Каждого ТекстПути Из Деп.Пути Цикл
			Строки.Добавить("   " + ТекстПути);
		КонецЦикла;
		Если Метаданные.Справочники.Найти("ДоговорыКредитовИДепозитов") <> Неопределено Тогда
			ЗапросДоговоров = Новый Запрос("ВЫБРАТЬ Д.ТипДоговора КАК Тип, КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ДоговорыКредитовИДепозитов КАК Д ГДЕ НЕ Д.ПометкаУдаления СГРУППИРОВАТЬ ПО Д.ТипДоговора");
			Выборка = ЗапросДоговоров.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Строки.Добавить("   договоров «" + Строка(Выборка.Тип) + "»: " + Выборка.Количество);
			КонецЦикла;
		КонецЕсли;
	Исключение
		Строки.Добавить("Депозиты: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаголовокДиагностики(Строки, "5. ИТОГИ РЕСУРСОВ (прошлый и текущий месяц)");
	Для Каждого ИмяРегистра Из СтрРазделить("ВыручкаИСебестоимостьПродаж,ДенежныеСредстваБезналичные", ",") Цикл
		ИтогиРесурсов(Строки, ИмяРегистра, П);
	КонецЦикла;

	ЗаголовокДиагностики(Строки, "6. ЦИФРЫ РАЗДЕЛОВ ОТЧЁТА");
	ДиагностикаРазделов(Строки, П);

КонецПроцедуры

&НаСервере
Процедура ЗаголовокДиагностики(Строки, Текст)

	Строки.Добавить("");
	Строки.Добавить("==== " + Текст + " ====");

КонецПроцедуры

&НаСервере
Функция ИмяПодходит(Имя, Слова)

	ИмяНРег = НРег(Имя);
	Для Каждого Слово Из СтрРазделить(Слова, ",") Цикл
		Если СтрНайти(ИмяНРег, НРег(Слово)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ОписаниеПолей(Коллекция, СТипами)

	Части = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Если Части.Количество() >= 60 Тогда
			Части.Добавить("…");
			Прервать;
		КонецЕсли;
		Части.Добавить(Поле.Имя + ?(СТипами, "[" + ТипыСтрокой(Поле.Тип) + "]", ""));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

&НаСервере
Функция ТипыСтрокой(ОписаниеТиповПоля)

	Части = Новый Массив;
	Для Каждого ТипПоля Из ОписаниеТиповПоля.Типы() Цикл
		Если Части.Количество() >= 3 Тогда
			Части.Добавить("+" + Формат(ОписаниеТиповПоля.Типы().Количество() - 3, "ЧГ=0"));
			Прервать;
		КонецЕсли;
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Части.Добавить(?(МетаТипа = Неопределено, Строка(ТипПоля), МетаТипа.ПолноеИмя()));
	КонецЦикла;
	Возврат СтрСоединить(Части, "|");

КонецФункции

&НаСервере
Процедура ОписатьОбъект(Строки, Мета, Вид)

	Строки.Добавить("");
	Строки.Добавить(Вид + "." + Мета.Имя + " (" + Мета.Синоним + ")");
	Строки.Добавить("   шапка: " + ОписаниеПолей(Мета.Реквизиты, Истина));
	Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
		Строки.Добавить("   ТЧ " + ТЧ.Имя + " (" + ТЧ.Синоним + "): " + ОписаниеПолей(ТЧ.Реквизиты, Ложь));
	КонецЦикла;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Вид + "." + Мета.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Строки.Добавить("   записей в базе: " + Формат(Выборка.Количество, "ЧН=0; ЧГ=0"));
		КонецЕсли;
	Исключение
		Строки.Добавить("   записей: нет доступа");
	КонецПопытки;

КонецПроцедуры

// В диагностике нужна структура, а не данные: для ссылок — вид объекта, для текста — длина.
&НаСервереБезКонтекста
Функция ВидЗначенияДляДиагностики(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "текст(" + СтрДлина(Значение) + ")";
	КонецЕсли;
	МетаЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если МетаЗначения = Неопределено Тогда
		Возврат Строка(ТипЗначения);
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаЗначения) ИЛИ Метаданные.ПланыСчетов.Содержит(МетаЗначения) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "[" + МетаЗначения.Имя + "]";

КонецФункции

&НаСервере
Процедура ПримерОбъекта(Строки, Мета, Вид)

	// один пример: последний проведённый документ или первый элемент справочника, первые строки каждой ТЧ
	Попытка
		Если Вид = "Документ" Тогда
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ." + Мета.Имя + " КАК Т ГДЕ Т.Проведен УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ";
		Иначе
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник." + Мета.Имя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления"
				+ ?(Мета.Иерархический, " И НЕ Т.ЭтоГруппа", "");
		КонецЕсли;
		ЗапросПримера = Новый Запрос(ТекстЗапроса);
		Выборка = ЗапросПримера.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Строки.Добавить("   пример: записей нет");
			Возврат;
		КонецЕсли;
		Ссылка = Выборка.Ссылка;
		Строки.Добавить("   пример: найден");
		Для Каждого ТЧ Из Мета.ТабличныеЧасти Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 8 * ИЗ " + Вид + "." + Мета.Имя + "." + ТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Таблица = Запрос.Выполнить().Выгрузить();
			Если Таблица.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Строки.Добавить("   ТЧ " + ТЧ.Имя + ", строк в примере: " + Таблица.Количество());
			Для Каждого Стр Из Таблица Цикл
				Части = Новый Массив;
				Для Каждого Колонка Из Таблица.Колонки Цикл
					Если Колонка.Имя = "Ссылка" ИЛИ Колонка.Имя = "НомерСтроки" Тогда
						Продолжить;
					КонецЕсли;
					Значение = Стр[Колонка.Имя];
					Если ЗначениеЗаполнено(Значение) И Части.Количество() < 14 Тогда
						Части.Добавить(Колонка.Имя + "=" + ВидЗначенияДляДиагностики(Значение));
					КонецЕсли;
				КонецЦикла;
				Строки.Добавить("      " + СтрСоединить(Части, "; "));
			КонецЦикла;
		КонецЦикла;
	Исключение
		Строки.Добавить("   пример: не прочитан — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура РегистраторыПоВидам(Строки, ИмяРегистра, П)

	Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Остаточный = Метаданные.РегистрыНакопления[ИмяРегистра].ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 20000
			|	Т.Регистратор КАК Регистратор" + ?(Остаточный, ",
			|	Т.ВидДвижения КАК ВидДвижения", "") + "
			|ИЗ
			|	РегистрНакопления." + ИмяРегистра + " КАК Т
			|ГДЕ
			|	Т.Период МЕЖДУ &Начало30 И &КонецДня");
		Запрос.УстановитьПараметр("Начало30", П.Начало30);
		Запрос.УстановитьПараметр("КонецДня", П.КонецДня);
		Выборка = Запрос.Выполнить().Выбрать();
		Счетчики = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			Попытка
				Имя = Выборка.Регистратор.Метаданные().Имя;
			Исключение
				Имя = "?";
			КонецПопытки;
			Ключ = Имя + ?(Остаточный, " — " + НРег(Строка(Выборка.ВидДвижения)), "");
			Счетчики.Вставить(Ключ, ЧислоИлиНоль(Счетчики[Ключ]) + 1);
		КонецЦикла;
		Строки.Добавить("");
		Строки.Добавить("РН." + ИмяРегистра + ":");
		Если Счетчики.Количество() = 0 Тогда
			Строки.Добавить("   движений нет");
		КонецЕсли;
		Для Каждого Элемент Из Счетчики Цикл
			Строки.Добавить("   " + Элемент.Ключ + ": " + Формат(Элемент.Значение, "ЧГ=0") + " док.");
		КонецЦикла;
	Исключение
		Строки.Добавить("РН." + ИмяРегистра + ": ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ИтогиРесурсов(Строки, ИмяРегистра, П)

	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		Строки.Добавить("РН." + ИмяРегистра + ": нет в конфигурации");
		Возврат;
	КонецЕсли;
	Попытка
		Поля = Новый Массив;
		Для Каждого Ресурс Из Мета.Ресурсы Цикл
			Поля.Добавить("СУММА(Т." + Ресурс.Имя + "Оборот) КАК " + Ресурс.Имя);
		КонецЦикла;
		Для Каждого Период Из СтрРазделить("Прошлый,Текущий", ",") Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ РегистрНакопления." + ИмяРегистра + ".Обороты(&Начало, &Конец) КАК Т");
			Запрос.УстановитьПараметр("Начало", ?(Период = "Текущий", П.НачалоМесяца, П.НачалоПрошлогоМесяца));
			Запрос.УстановитьПараметр("Конец", ?(Период = "Текущий", П.КонецДня, КонецМесяца(П.НачалоПрошлогоМесяца)));
			Таблица = Запрос.Выполнить().Выгрузить();
			Части = Новый Массив;
			Если Таблица.Количество() > 0 Тогда
				Для Каждого Колонка Из Таблица.Колонки Цикл
					Части.Добавить(Колонка.Имя + "=" + Формат(Таблица[0][Колонка.Имя], "ЧДЦ=0; ЧН=0; ЧГ=0"));
				КонецЦикла;
			КонецЕсли;
			Строки.Добавить("РН." + ИмяРегистра + ", обороты, " + НРег(Период) + " месяц: " + СтрСоединить(Части, "; "));
		КонецЦикла;
	Исключение
		Строки.Добавить("РН." + ИмяРегистра + ": ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДиагностикаРазделов(Строки, П)

	Р = Новый Структура("Ошибки, Выпуск, Заказы, Сырье, Продажи, Закупки, ЗакупкиГод, Маржа",
		Новый Соответствие, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);

	Строки.Добавить("Документы выпуска: " + СтрСоединить(ДокументыПроизводства(П), ", "));
	Строки.Добавить("Документы списания в производство: " + СтрСоединить(ДокументыПроизводства(П, Истина), ", "));
	Попытка
		Р.Выпуск = ПолучитьВыпуск(П);
		Строки.Добавить(СтрШаблон("Выпуск: за день %1, с начала месяца %2, в сутки %3", Р.Выпуск.ЗаДень, Р.Выпуск.ЗаМесяц, Р.Выпуск.ВСутки));
		Для Каждого Стр Из Р.Выпуск.ПоПродуктам Цикл
			Если Р.Выпуск.ПоПродуктам.Индекс(Стр) < 8 Тогда
				Строки.Добавить(СтрШаблон("   %1: месяц %2 %3, 7 дней %4", Стр.Номенклатура, Стр.ЗаМесяц, Стр.Ед, Стр.За7Дней));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Выпуск: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Продажи = ПолучитьПродажи(П);
		Строки.Добавить(СтрШаблон("Продажи: месяц %1, тот же период прошлого %2, весь прошлый %3", Р.Продажи.Месяц, Р.Продажи.ПрошлыйПериод, Р.Продажи.ПрошлыйМесяц));
		Для Каждого Стр Из Р.Продажи.ПоНоменклатуре Цикл
			Если Р.Продажи.ПоНоменклатуре.Индекс(Стр) < 8 Тогда
				Строки.Добавить(СтрШаблон("   %1: %2 %3 на %4, цена %5", Стр.Ключ, Стр.Количество, Стр.Ед, Стр.Сумма, Стр.Цена));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Продажи: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Маржа = ПолучитьМаржу(П);
		Строки.Добавить(СтрШаблон("Маржа: ресурсы себестоимости — %1; себестоимость прошлого месяца %2 (из неё косвенные %3), текущего %4 (косвенные %5)",
			Р.Маржа.РесурсСебестоимости, Р.Маржа.СебестоимостьПрошлого, Р.Маржа.КосвенныеПрошлого, Р.Маржа.СебестоимостьТекущего, Р.Маржа.КосвенныеТекущего));
	Исключение
		Строки.Добавить("Маржа: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Заказы = ПолучитьЗаказы(П, Р.Выпуск);
		Строки.Добавить(СтрШаблон("Заказы: источник — %1; открытых строк %2, заказов %3, на сумму %4", Р.Заказы.Источник,
			Р.Заказы.Открытые.Количество(), Р.Заказы.Заказов, Р.Заказы.Портфель));
		Для Каждого Стр Из Р.Заказы.Открытые Цикл
			Если Р.Заказы.Открытые.Индекс(Стр) < 8 Тогда
				Строки.Добавить(СтрШаблон("   %1 от %2: %3 — осталось %4 %5, срок %6, сумма %7", Стр.Номер, Формат(Стр.Заказ.Дата, "ДФ=dd.MM.yy"),
					Стр.Номенклатура, Стр.Осталось, Стр.Ед, Формат(Стр.Срок, "ДФ=dd.MM.yy"), Стр.Сумма));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Заказы: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Р.Сырье = ПолучитьСырье(П);
		Строки.Добавить("Сырьё: позиций " + Р.Сырье.Материалы.Количество());
		Для Каждого Стр Из Р.Сырье.Материалы Цикл
			Если Р.Сырье.Материалы.Индекс(Стр) < 12 Тогда
				Строки.Добавить(СтрШаблон("   %1: остаток %2 %3, расход в сутки %4, в пути %5", Стр.Номенклатура, Стр.Остаток, Стр.Ед, Стр.ВСутки, Стр.ВПути));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Сырьё: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Продукты = Новый Массив;
		Если Р.Выпуск <> Неопределено Тогда
			Для Каждого Стр Из Р.Выпуск.ПоПродуктам Цикл
				Если Продукты.Количество() < 6 Тогда
					Продукты.Добавить(Стр.Номенклатура);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Продукты.Количество() = 0 И Р.Продажи <> Неопределено Тогда
			Для Каждого Стр Из Р.Продажи.ПоНоменклатуре Цикл
				Если Продукты.Количество() < 6 Тогда
					Продукты.Добавить(Стр.Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Нормы = НормыИзСпецификаций(Продукты, П);
		Выбранные = Нормы["Спецификации"];
		Строки.Добавить("Нормы на 1 базовую единицу продукта (основное сырьё отмечено *):");
		Для Каждого Ном Из Продукты Цикл
			Норма = Нормы[Ном];
			Если Норма = Неопределено Тогда
				Строки.Добавить("   " + Строка(Ном) + ": спецификация не найдена");
				Продолжить;
			КонецЕсли;
			Части = Новый Массив;
			Для Каждого Элемент Из Норма Цикл
				Части.Добавить(?(ЭтоОсновноеСырье(Элемент.Значение.Статья, П), "*", "") + Строка(Элемент.Ключ) + " " + Формат(Элемент.Значение.Норма, "ЧДЦ=5") + " " + ЕдиницаНоменклатуры(Элемент.Ключ));
			КонецЦикла;
			Строки.Добавить("   " + Строка(Ном) + " [" + ЕдиницаНоменклатуры(Ном) + "; " + Строка(?(Выбранные = Неопределено, "", Выбранные[Ном])) + "]: " + СтрСоединить(Части, "; "));
		КонецЦикла;
	Исключение
		Строки.Добавить("Нормы: ошибка — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Сигналы

&НаСервере
Функция НоваяТаблицаСигналов()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Уровень", ОписаниеЧисла()); // 0 критично, 1 внимание, 2 информация, 3 хорошо
	Т.Колонки.Добавить("Раздел");
	Т.Колонки.Добавить("Заголовок");
	Т.Колонки.Добавить("Текст");
	Возврат Т;

КонецФункции

&НаСервере
Процедура Сигнал(Р, Уровень, Раздел, ТекстЗаголовка, Текст = "")

	НовСтр = Р.Сигналы.Добавить();
	НовСтр.Уровень = Уровень;
	НовСтр.Раздел = Раздел;
	НовСтр.Заголовок = ТекстЗаголовка;
	НовСтр.Текст = Текст;

КонецПроцедуры

&НаСервере
Процедура СобратьСигналы(Р, П)

	Для Каждого Ошибка Из Р.Ошибки Цикл
		Имена = Новый Структура("ЗакупкиГод, Потребность, Сырье, Маржа", "Цены закупок", "Сырьё на план", "Сырьё", "Маржа");
		Имя = Ошибка.Ключ;
		Имена.Свойство(Ошибка.Ключ, Имя);
		Сигнал(Р, 1, Имя, "Раздел «" + Имя + "» не сформирован", Ошибка.Значение);
	КонецЦикла;

	Д = Р.Деньги;
	Если Д <> Неопределено И П.НеснижаемыйОстаток > 0 И Д.Итого < П.НеснижаемыйОстаток Тогда
		Сигнал(Р, 1, "Деньги", "Денег меньше неснижаемого остатка: " + ДеньгиКратко(Д.Итого), "Порог " + ДеньгиКратко(П.НеснижаемыйОстаток) + ".");
	КонецЕсли;

	Ф = Р.Финрезультат;
	Если Ф <> Неопределено И Ф.ЗакрытыхМесяцев > 0 Тогда
		ИтогКв = Ф.Колонки[3]; // колонка «Квартал»
		Если ИтогКв.Чистая < 0 Тогда
			Сигнал(Р, 0, "Финрезультат", "Убыток за " + Ф.ИмяКвартала + ": " + ДеньгиКратко(ИтогКв.Чистая),
				?(Ф.ЕстьПрямые, "Прибыль по прямым затратам " + ДеньгиКратко(ИтогКв.ПоПрямым) + ", ", "") + "прибыль от продаж " + ДеньгиКратко(ИтогКв.ОтПродаж) + ".");
		ИначеЕсли Ф.ЕстьПрямые И ИтогКв.ПоПрямым < 0 Тогда
			Сигнал(Р, 0, "Финрезультат", "Прямые затраты больше выручки за " + Ф.ИмяКвартала, "Прибыль по прямым затратам " + ДеньгиКратко(ИтогКв.ПоПрямым) + ".");
		КонецЕсли;
	КонецЕсли;

	А = Р.Аренда;
	Если А <> Неопределено И А.Просрочено > 0 Тогда
		Сигнал(Р, 1, "Аренда", "Арендаторы просрочили оплату: " + ДеньгиКратко(А.Просрочено),
			"Арендаторов с просрочкой: " + А.СПросрочкой + ". Подробности — в разделе «Арендаторы».");
	КонецЕсли;

	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		Если Нам.Просрочено > 0 Тогда
			Доля = ?(Нам.Всего = 0, 0, Нам.Просрочено / Нам.Всего * 100);
			Первый = Нам.ПоКонтрагентам[0];
			Сигнал(Р, ?(Доля >= 30, 0, 1), "Долги", "Просроченная дебиторка " + ДеньгиКратко(Нам.Просрочено) + " — " + Формат(Доля, "ЧДЦ=0") + " % долга покупателей",
				СтрШаблон("Больше всех должен %1: %2, до %3 дн. просрочки.", Первый.Контрагент, ДеньгиКратко(Первый.Просрочено), Первый.МаксПросрочка));
		КонецЕсли;
		Старые = Нам.Корзины[3].Сумма + Нам.Корзины[4].Сумма;
		Если Старые > 0 Тогда
			Сигнал(Р, 1, "Долги", "Долги покупателей старше 60 дней: " + ДеньгиКратко(Старые),
				"Высокий риск невозврата: претензия, суд или резерв по сомнительным долгам.");
		КонецЕсли;
		Мы = Р.Долги.МыДолжны;
		Если Мы.Просрочено > 0 Тогда
			Имена = Новый Массив;
			Для Каждого Стр Из Мы.ПоКонтрагентам Цикл
				Если Стр.Просрочено > 0 И Имена.Количество() < 3 Тогда
					Имена.Добавить(Строка(Стр.Контрагент));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Долги", "Мы просрочили оплату поставщикам на " + ДеньгиКратко(Мы.Просрочено), СтрСоединить(Имена, ", "));
		КонецЕсли;
	КонецЕсли;

	С = Р.Сырье;
	Если С <> Неопределено Тогда
		Для Каждого Стр Из С.Нехватка Цикл
			Сигнал(Р, 0, "Сырьё", Строка(Стр.Номенклатура) + ": " + Стр.Пояснение,
				СтрШаблон("Остаток %1 %3, расход %2 %3 в сутки.", ФорматЧисла(Стр.Остаток), ФорматЧисла(Стр.ВСутки), Стр.Ед));
		КонецЦикла;
		Для Каждого Стр Из С.Заказать Цикл
			Сигнал(Р, 1, "Сырьё", Строка(Стр.Номенклатура) + ": пора заказывать",
				СтрШаблон("Хватит на %1 дн. вместе с поставкой. Заказать %2 %3.", Формат(Стр.ХватитСПоставкой, "ЧДЦ=1; ЧН=0"), ФорматЧисла(Стр.Заказать), Стр.Ед));
		КонецЦикла;
	КонецЕсли;

	З = Р.Заказы;
	Если З <> Неопределено Тогда
		Если З.Просроченные.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из З.Просроченные Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 %2 — %3 дн.", Стр.Номер, Стр.Клиент, Стр.Просрочка));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 0, "Заказы", "Сорван срок отгрузки: " + З.Просроченные.Количество() + " "
				+ Склонение(З.Просроченные.Количество(), "позиция", "позиции", "позиций") + " заказов", СтрСоединить(Части, "; "));
		КонецЕсли;
		Если З.НеУспеваем.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из З.НеУспеваем Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 %2 %3 %4 до %5", Стр.Номер, Стр.Номенклатура, ФорматЧисла(Стр.Осталось), Стр.Ед, Формат(Стр.Срок, "ДФ=dd.MM")));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Заказы", "Не успеваем выпустить к сроку: " + З.НеУспеваем.Количество() + " "
				+ Склонение(З.НеУспеваем.Количество(), "позиция", "позиции", "позиций"), СтрСоединить(Части, "; "));
		КонецЕсли;
	КонецЕсли;

	В = Р.Выпуск;
	ДеньВведен = В <> Неопределено И ЗначениеЗаполнено(В.ПоследнийВыпуск) И НачалоДня(В.ПоследнийВыпуск) >= П.День;
	Если В <> Неопределено И ЗначениеЗаполнено(В.ПоследнийВыпуск) И НачалоДня(В.ПоследнийВыпуск) < П.День - 2 * 86400 Тогда
		Сигнал(Р, 1, "Выпуск", "Суточные рапорты не введены с " + Формат(В.ПоследнийВыпуск, "ДФ=dd.MM"),
			"Выпуск за последние дни в базе отсутствует, цифры месяца занижены.");
	КонецЕсли;
	Если В <> Неопределено И В.План > 0 Тогда
		Процент = В.ЗаДень / В.План * 100;
		Если НЕ ДеньВведен Тогда
			// за сутки рапорта нет — оценку суток не даём
		ИначеЕсли Процент < 90 Тогда
			Сигнал(Р, ?(Процент < 75, 0, 1), "Выпуск", СтрШаблон("Выпуск за сутки %1 %% плана: %2 из %3", Формат(Процент, "ЧДЦ=0; ЧН=0"), ФорматЧисла(В.ЗаДень), ФорматЧисла(В.План)));
		ИначеЕсли Процент >= 100 Тогда
			Сигнал(Р, 3, "Выпуск", СтрШаблон("План суток выполнен: %1 %%", Формат(Процент, "ЧДЦ=0")));
		КонецЕсли;
		Если В.ПланМесяца > 0 И В.Прогноз < В.ПланМесяца * 0.97 Тогда
			Нужно = ?(В.ОсталосьДней > 0, (В.ПланМесяца - В.ЗаМесяц) / В.ОсталосьДней, 0);
			Сигнал(Р, 1, "Выпуск", СтрШаблон("Прогноз месяца %1 %% плана: %2 из %3 %4", Формат(В.Прогноз / В.ПланМесяца * 100, "ЧДЦ=0"), ФорматЧисла(В.Прогноз), ФорматЧисла(В.ПланМесяца), В.ГлавнаяЕд),
				СтрШаблон("Чтобы выполнить план, нужно %1 в сутки при текущих %2.", ФорматЧисла(Нужно), ФорматЧисла(В.ВСутки)));
		КонецЕсли;
	КонецЕсли;

	Если Д <> Неопределено Тогда
		Для Каждого Стр Из Д.Платежи Цикл
			Если Стр.Сумма >= П.КрупныйПлатеж И П.КрупныйПлатеж > 0 Тогда
				Если Стр.Вид = "приход" Тогда
					Сигнал(Р, 3, "Деньги", "Поступило " + ДеньгиКратко(Стр.Сумма) + " от " + Строка(Стр.Контрагент), Строка(Стр.Назначение));
				Иначе
					Сигнал(Р, 2, "Деньги", "Оплачено " + ДеньгиКратко(Стр.Сумма) + ": " + Строка(Стр.Контрагент), Строка(Стр.Назначение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Пр = Р.Продажи;
	Если Пр <> Неопределено И Пр.Изменение <> Неопределено Тогда
		Если Пр.Изменение <= -15 Тогда
			Сигнал(Р, 1, "Продажи", СтрШаблон("Выручка с начала месяца на %1 %% ниже, чем за тот же период прошлого месяца", Формат(-Пр.Изменение, "ЧДЦ=0")),
				ДеньгиКратко(Пр.Месяц) + " против " + ДеньгиКратко(Пр.ПрошлыйПериод) + ".");
		ИначеЕсли Пр.Изменение >= 15 Тогда
			Сигнал(Р, 3, "Продажи", СтрШаблон("Выручка с начала месяца выросла на %1 %% к прошлому месяцу", Формат(Пр.Изменение, "ЧДЦ=0")),
				ДеньгиКратко(Пр.Месяц) + " против " + ДеньгиКратко(Пр.ПрошлыйПериод) + ".");
		КонецЕсли;
	КонецЕсли;
	Если Пр <> Неопределено Тогда
		Подешевели = Новый Массив;
		Для Каждого Стр Из Пр.ПоНоменклатуре Цикл
			Если Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены <= -5 И Стр.Сумма > 0 И Подешевели.Количество() < 4 Тогда
				Подешевели.Добавить(Строка(Стр.Ключ) + " " + Формат(Стр.ИзмЦены, "ЧДЦ=1") + " %");
			КонецЕсли;
		КонецЦикла;
		Если Подешевели.Количество() > 0 Тогда
			Сигнал(Р, 1, "Продажи", "Продаём дешевле, чем в прошлом месяце", СтрСоединить(Подешевели, "; "));
		КонецЕсли;
	КонецЕсли;
	Если Р.Маржа <> Неопределено И Р.Маржа.СебестоимостьПрошлого <> 0 Тогда
		Убыточные = Новый Массив;
		Для Каждого Стр Из Р.Маржа.Прошлый Цикл
			Если Стр.Прибыль < 0 И Убыточные.Количество() < 5 Тогда
				Убыточные.Добавить(Строка(Стр.Номенклатура) + " (" + ДеньгиКратко(Стр.Прибыль) + ")");
			КонецЕсли;
		КонецЦикла;
		Если Убыточные.Количество() > 0 Тогда
			Сигнал(Р, 0, "Продажи", "Продажи дешевле прямых затрат за " + ИмяМесяца(Месяц(П.НачалоПрошлогоМесяца), Ложь), СтрСоединить(Убыточные, "; "));
		КонецЕсли;
	КонецЕсли;
	Зк = Р.Закупки;
	Если Зк <> Неопределено Тогда
		Подорожали = Новый Массив;
		Для Каждого Стр Из Зк.ПоНоменклатуре Цикл
			Если Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены >= 5 И Подорожали.Количество() < 5 Тогда
				Подорожали.Добавить(Строка(Стр.Ключ) + " +" + Формат(Стр.ИзмЦены, "ЧДЦ=1") + " %");
			КонецЕсли;
		КонецЦикла;
		Если Подорожали.Количество() > 0 Тогда
			Сигнал(Р, 1, "Закупки", "Сырьё и материалы подорожали к прошлому месяцу", СтрСоединить(Подорожали, "; "));
		КонецЕсли;
	КонецЕсли;
	Если Р.Запасы <> Неопределено Тогда
		Мало = Р.Запасы.Таблица.НайтиСтроки(Новый Структура("Статус", "мало"));
		Если Мало.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из Мало Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1: остаток %2, в заказах %3", Стр.Номенклатура, ФорматЧисла(Стр.Остаток), ФорматЧисла(Стр.ВЗаказах)));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 1, "Запасы", "Готовой продукции меньше чем на 3 дня отгрузок", СтрСоединить(Части, "; "));
		КонецЕсли;
		Лежит = Р.Запасы.Таблица.НайтиСтроки(Новый Структура("Статус", "затоваривание"));
		Если Лежит.Количество() > 0 Тогда
			Части = Новый Массив;
			Для Каждого Стр Из Лежит Цикл
				Если Части.Количество() < 4 Тогда
					Части.Добавить(СтрШаблон("%1 — на %2 дн.", Стр.Номенклатура, Формат(Стр.ДнейЗапаса, "ЧДЦ=0")));
				КонецЕсли;
			КонецЦикла;
			Сигнал(Р, 2, "Запасы", "Затоваривание готовой продукции", СтрСоединить(Части, "; "));
		КонецЕсли;
	КонецЕсли;
	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		Если Нам.ВсегоНаНачало > 0 И Нам.Всего > Нам.ВсегоНаНачало * 1.1 Тогда
			Сигнал(Р, 2, "Долги", "Долг покупателей вырос с начала месяца на " + ДеньгиКратко(Нам.Всего - Нам.ВсегоНаНачало),
				ДеньгиКратко(Нам.ВсегоНаНачало) + " → " + ДеньгиКратко(Нам.Всего) + ".");
		КонецЕсли;
	КонецЕсли;

	Пт = Р.Потребность;
	Если Пт <> Неопределено Тогда
		НаЗаказы = Новый Массив;
		НаПлан = Новый Массив;
		Для Каждого Стр Из Пт.Таблица Цикл
			Если Стр.НехваткаМесяц > 0 И НаЗаказы.Количество() < 5 Тогда
				НаЗаказы.Добавить(СтрШаблон("%1 — %2 %3", Стр.Номенклатура, ФорматЧисла(Стр.НехваткаМесяц), Стр.Ед));
			ИначеЕсли Стр.НехваткаДвухМесяцев > 0 И НаПлан.Количество() < 5 Тогда
				НаПлан.Добавить(СтрШаблон("%1 — %2 %3", Стр.Номенклатура, ФорматЧисла(Стр.НехваткаДвухМесяцев), Стр.Ед));
			КонецЕсли;
		КонецЦикла;
		Если НаЗаказы.Количество() > 0 Тогда
			Сигнал(Р, 0, "Сырьё на план", "Основного сырья не хватит на план этого месяца", СтрСоединить(НаЗаказы, "; "));
		КонецЕсли;
		Если НаПлан.Количество() > 0 Тогда
			Сигнал(Р, 1, "Сырьё на план", "На план следующего месяца не хватает сырья, докупить ≈ " + ДеньгиКратко(Пт.СуммаДокупки), СтрСоединить(НаПлан, "; "));
		КонецЕсли;
		Если Пт.БезНорм.Количество() > 0 Тогда
			Сигнал(Р, 2, "Сырьё на план", "Нет спецификации у " + Пт.БезНорм.Количество() + " " + Склонение(Пт.БезНорм.Количество(), "продукта", "продуктов", "продуктов") + " из плана",
				"Их потребность в сырье не посчитана: " + Лев(СтрСоединить(Пт.БезНорм, ", "), 300));
		КонецЕсли;
	КонецЕсли;
	Зг = Р.ЗакупкиГод;
	Если Зг <> Неопределено Тогда
		Рост = Новый Массив;
		Для Каждого Стр Из Зг.Материалы Цикл
			Если Стр.ИзмГод <> Неопределено И Стр.ИзмГод >= 15 И Рост.Количество() < 5 Тогда
				Рост.Добавить(Строка(Стр.Номенклатура) + " +" + Формат(Стр.ИзмГод, "ЧДЦ=0") + " %");
			КонецЕсли;
		КонецЦикла;
		Если Рост.Количество() > 0 Тогда
			Сигнал(Р, 2, "Цены закупок", "За год сильно подорожало сырьё", СтрСоединить(Рост, "; "));
		КонецЕсли;
		Если Зг.Переплата >= 100000 Тогда
			Сигнал(Р, 1, "Цены закупок", "За 3 месяца переплатили поставщикам ≈ " + ДеньгиКратко(Зг.Переплата) + " против лучших цен",
				"Одно и то же сырьё покупали у разных поставщиков по разной цене — см. раздел «Закупочные цены за 12 месяцев».");
		КонецЕсли;
	КонецЕсли;

	Р.Сигналы.Сортировать("Уровень");

КонецПроцедуры

#КонецОбласти

#Область ВыводВТабличныйДокумент

// Сетка: колонка 1 — названия (широкая), колонки 2–8 — числа.

&НаСервере
Функция Вывести(Р, П)

	В = Новый Структура("ТД, Строка", Новый ТабличныйДокумент, 1);
	ТД = В.ТД;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.АвтоМасштаб = Истина;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТД.ПолеСлева = 10;
	ТД.ПолеСправа = 10;
	Для К = 1 По 8 Цикл
		ШирКол = ?(К = 1, 36, 15);
		Попытка
			ТД.Область("C" + Формат(К, "ЧГ=0")).ШиринаКолонки = ШирКол;
		Исключение
			ТД.Область(1, К, 1, К).ШиринаКолонки = ШирКол;
		КонецПопытки;
	КонецЦикла;

	Организация = ?(ЗначениеЗаполнено(П.Организация), Строка(П.Организация), "Все организации");
	Ячейка(В, 1, Организация, , ЦветПриглушенный(), , 9, 8);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Ежедневный отчёт за " + Формат(П.День, "ДЛФ=DD") + ", " + НРег(Формат(П.День, "ДФ=dddd")), Истина, , , 16, 8);
	ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 26;
	СледующаяСтрока(В);
	Ячейка(В, 1, "Сформирован " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'") + ", " + Строка(Пользователи.ТекущийПользователь()), , ЦветПриглушенный(), , 9, 8);
	Черта(В, 1, 8, 2);
	СледующаяСтрока(В, 2);

	ВывестиГлавное(В, Р, П);
	ВывестиДеньги(В, Р, П);
	ВывестиДолги(В, Р, П);
	ВывестиПродажи(В, Р, П);
	ВывестиФинрезультат(В, Р, П);
	ВывестиАренду(В, Р, П);
	ВывестиЗаказы(В, Р, П);
	ВывестиВыпуск(В, Р, П);
	ВывестиЗапасы(В, Р, П);
	ВывестиСырье(В, Р, П);
	ВывестиПотребность(В, Р, П);
	ВывестиЗакупки(В, Р, П);
	ВывестиЦеныЗакупок(В, Р, П);
	ВывестиНеоплаченныеСчета(В, Р, П);

	СледующаяСтрока(В);
	Ячейка(В, 1, "Суммы в рублях регламентированного учёта по данным оперативного учёта ERP. Выпуск — приход на склад документами производства; "
		+ "расход сырья — списание со складов в производство.", , ЦветПриглушенный(), , 8, 8, Истина);
	ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
	Возврат ТД;

КонецФункции

&НаСервере
Процедура ВывестиГлавное(В, Р, П)

	ЗаголовокРаздела(В, "Главное");
	Шапка(В, "Показатель", "Значение", "", "Комментарий");
	Д = Р.Деньги;
	Если Д <> Неопределено Тогда
		Изменение = Д.Итого - Д.ИтогоВчера;
		Уровень = ?(П.НеснижаемыйОстаток > 0 И Д.Итого < П.НеснижаемыйОстаток, 1, -1);
		СтрокаГлавного(В, "Деньги на счетах и в кассе", ДеньгиКратко(Д.Итого), Уровень,
			"за день " + ?(Изменение > 0, "+", "") + ДеньгиКратко(Изменение));
		Деп = Д.Депозиты;
		ИзменениеДеп = Деп.Сегодня - Деп.Вчера;
		СтрокаГлавного(В, "Депозиты", ДеньгиКратко(Деп.Сегодня), -1,
			?(ПустаяСтрока(Деп.Ошибка), ?(ПустаяСтрока(Деп.Источник), "в базе не найдены",
			"за день " + ?(ИзменениеДеп > 0, "+", "") + ДеньгиКратко(ИзменениеДеп)), "не прочитаны: " + Деп.Ошибка));
		ИзменениеВсего = Д.ВсегоСДепозитами - Д.ВсегоСДепозитамиВчера;
		СтрокаГлавного(В, "Итого: деньги и депозиты", ДеньгиКратко(Д.ВсегоСДепозитами), -1,
			"за день " + ?(ИзменениеВсего > 0, "+", "") + ДеньгиКратко(ИзменениеВсего));
	КонецЕсли;
	Если Р.Долги <> Неопределено Тогда
		Нам = Р.Долги.НамДолжны;
		СтрокаГлавного(В, "Нам должны покупатели", ДеньгиКратко(Нам.Всего),
			?(Нам.Просрочено = 0, -1, ?(Нам.Всего > 0 И Нам.Просрочено / Нам.Всего >= 0.3, 0, 1)), "просрочено " + ДеньгиКратко(Нам.Просрочено));
		Мы = Р.Долги.МыДолжны;
		СтрокаГлавного(В, "Мы должны поставщикам", ДеньгиКратко(Мы.Всего), ?(Мы.Просрочено = 0, -1, 1), "просрочено " + ДеньгиКратко(Мы.Просрочено));
	КонецЕсли;
	Ф = Р.Финрезультат;
	Если Ф <> Неопределено И Ф.ЗакрытыхМесяцев > 0 Тогда
		ИтогКв = Ф.Колонки[3]; // колонка «Квартал»
		СтрокаГлавного(В, "Чистая прибыль, " + Ф.ИмяКвартала + " (" + Ф.ЗакрытыхМесяцев + " мес.)", ДеньгиКратко(ИтогКв.Чистая),
			?(ИтогКв.Чистая < 0, 0, -1), ?(Ф.ЕстьПрямые, "по прямым затратам " + ДеньгиКратко(ИтогКв.ПоПрямым) + ", ", "") + "от продаж " + ДеньгиКратко(ИтогКв.ОтПродаж)
			+ ", рентабельность продаж " + ?(ИтогКв.Выручка = 0, "—", Формат(ИтогКв.ОтПродаж / ИтогКв.Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"));
	КонецЕсли;
	А = Р.Аренда;
	Если А <> Неопределено И А.Таблица.Количество() > 0 Тогда
		СтрокаГлавного(В, "Аренда: начислено с 1-го числа", ДеньгиКратко(А.Месяц), ?(А.Просрочено > 0, 1, -1),
			СтрШаблон("арендаторов %1, долг %2, просрочено %3", А.Таблица.Количество(), ДеньгиКратко(А.Долг), ДеньгиКратко(А.Просрочено)));
	КонецЕсли;
	З = Р.Заказы;
	Если З <> Неопределено Тогда
		СтрокаГлавного(В, "Портфель заказов к отгрузке", ДеньгиКратко(З.Портфель),
			?(З.Просроченные.Количество() > 0, 0, ?(З.НеУспеваем.Количество() > 0, 1, -1)),
			СтрШаблон("%1 %2, просроченных позиций %3", З.Заказов, Склонение(З.Заказов, "заказ", "заказа", "заказов"), З.Просроченные.Количество()));
	КонецЕсли;
	Вып = Р.Выпуск;
	Если Вып <> Неопределено Тогда
		Ед = " " + Вып.ГлавнаяЕд;
		Если Вып.ПланМесяца > 0 Тогда
			Процент = Вып.ЗаМесяц / Вып.ПланМесяца * 100;
			ПроцентКДате = ?(Вып.ПланНаСегодня = 0, 0, Вып.ЗаМесяц / Вып.ПланНаСегодня * 100);
			СтрокаГлавного(В, "Выпуск с начала месяца", ФорматЧисла(Вып.ЗаМесяц) + Ед, ?(ПроцентКДате >= 100, 3, ?(ПроцентКДате >= 90, -1, ?(ПроцентКДате >= 75, 1, 0))),
				Формат(Процент, "ЧДЦ=0; ЧН=0") + " % плана месяца " + ФорматЧисла(Вып.ПланМесяца) + Ед + "; к сегодняшней дате " + Формат(ПроцентКДате, "ЧДЦ=0; ЧН=0")
				+ " %; последний рапорт " + ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск), Формат(Вып.ПоследнийВыпуск, "ДФ=dd.MM"), "—"));
		Иначе
			СтрокаГлавного(В, "Выпуск с начала месяца", ФорматЧисла(Вып.ЗаМесяц) + Ед, -1, "плана производства на месяц нет; последний рапорт "
				+ ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск), Формат(Вып.ПоследнийВыпуск, "ДФ=dd.MM"), "—"));
		КонецЕсли;
	КонецЕсли;
	С = Р.Сырье;
	Если С <> Неопределено Тогда
		СтрокаГлавного(В, "Сырьё: нехватка / пора заказывать", Формат(С.Нехватка.Количество(), "ЧН=0") + " / " + Формат(С.Заказать.Количество(), "ЧН=0"),
			?(С.Нехватка.Количество() > 0, 0, ?(С.Заказать.Количество() > 0, 1, 3)), "позиций из " + Формат(С.Материалы.Количество(), "ЧН=0"));
	КонецЕсли;
	Пр = Р.Продажи;
	Если Пр <> Неопределено Тогда
		СтрокаГлавного(В, "Выручка без НДС с 1-го числа", ДеньгиКратко(Пр.Месяц),
			?(Пр.Изменение = Неопределено, -1, ?(Пр.Изменение <= -15, 1, ?(Пр.Изменение >= 10, 3, -1))),
			"за день " + ДеньгиКратко(Пр.ЗаДень) + ?(Пр.Изменение = Неопределено, "", "; к тому же периоду прошлого месяца "
			+ ?(Пр.Изменение > 0, "+", "") + Формат(Пр.Изменение, "ЧДЦ=1; ЧН=0") + " %"));
	КонецЕсли;
	Если Р.Маржа <> Неопределено Тогда
		ВыручкаМ = Р.Маржа.Прошлый.Итог("Выручка");
		ПрибыльМ = Р.Маржа.Прошлый.Итог("Прибыль");
		Если ВыручкаМ <> 0 И Р.Маржа.СебестоимостьПрошлого <> 0 Тогда
			Рент = ПрибыльМ / ВыручкаМ * 100;
			СтрокаГлавного(В, "Прибыль по прямым затратам за " + ИмяМесяца(Месяц(П.НачалоПрошлогоМесяца), Ложь), ДеньгиКратко(ПрибыльМ),
				?(Рент < 0, 0, ?(Рент < 10, 1, -1)), "рентабельность " + Формат(Рент, "ЧДЦ=1; ЧН=0") + " % от выручки " + ДеньгиКратко(ВыручкаМ));
		КонецЕсли;
	КонецЕсли;
	Зк = Р.Закупки;
	Если Зк <> Неопределено Тогда
		Подорожало = 0;
		Для Каждого Стр Из Зк.ПоНоменклатуре Цикл
			Если Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены >= 5 Тогда
				Подорожало = Подорожало + 1;
			КонецЕсли;
		КонецЦикла;
		СтрокаГлавного(В, "Закупки с 1-го числа", ДеньгиКратко(Зк.Месяц), ?(Подорожало > 0, 1, -1),
			?(Подорожало > 0, "подорожали на 5 % и больше: " + Подорожало + " поз.", "заметных подорожаний нет"));
	КонецЕсли;
	Пт = Р.Потребность;
	Если Пт <> Неопределено И Пт.Таблица.Количество() > 0 Тогда
		НеХватает = 0;
		Для Каждого Стр Из Пт.Таблица Цикл
			Если Стр.НехваткаДвухМесяцев > 0 Тогда
				НеХватает = НеХватает + 1;
			КонецЕсли;
		КонецЦикла;
		СтрокаГлавного(В, "Основное сырьё на план (этот и след. месяц)", ?(НеХватает = 0, "хватает", "докупить " + ДеньгиКратко(Пт.СуммаДокупки)),
			?(Пт.Таблица.Итог("НехваткаМесяц") > 0, 0, ?(НеХватает > 0, 1, 3)),
			?(НеХватает = 0, "с учётом остатков и поставок в пути", "не хватает " + НеХватает + " поз. из " + Пт.Таблица.Количество()));
	КонецЕсли;

	СледующаяСтрока(В);
	Крит = Р.Сигналы.НайтиСтроки(Новый Структура("Уровень", 0)).Количество();
	Вним = Р.Сигналы.НайтиСтроки(Новый Структура("Уровень", 1)).Количество();
	Ячейка(В, 1, СтрШаблон("Что требует решения: критично — %1, внимание — %2", Крит, Вним), Истина, , , 11, 8);
	СледующаяСтрока(В);
	Если Р.Сигналы.Количество() = 0 Тогда
		Ячейка(В, 1, "Все показатели в норме.", , ЦветПриглушенный(), , , 8);
		СледующаяСтрока(В);
	КонецЕсли;
	Значки = СтрРазделить("‼,!,i,✓", ",");
	Для Каждого Сиг Из Р.Сигналы Цикл
		Фон = ?(Сиг.Уровень = 0, ФонКрит(), ?(Сиг.Уровень = 1, ФонВнимание(), ?(Сиг.Уровень = 3, ФонХорошо(), ЦветФонаШапки())));
		Цвет = ?(Сиг.Уровень = 0, ЦветКрит(), ?(Сиг.Уровень = 1, ЦветВнимание(), ?(Сиг.Уровень = 3, ЦветХорошо(), ЦветПриглушенный())));
		Ячейка(В, 1, Значки[Сиг.Уровень] + "  " + Сиг.Раздел, Истина, Цвет, Фон);
		Ячейка(В, 2, Сиг.Заголовок, Истина, , Фон, , 8, Истина);
		ПодогнатьВысоту(В, Сиг.Заголовок, 7 * 15);
		СледующаяСтрока(В);
		Если ЗначениеЗаполнено(Сиг.Текст) Тогда
			Ячейка(В, 1, "", , , Фон);
			Ячейка(В, 2, Сиг.Текст, , ЦветПриглушенный(), Фон, 9, 8, Истина);
			ПодогнатьВысоту(В, Сиг.Текст, 7 * 15);
			СледующаяСтрока(В);
		КонецЕсли;
		СледующаяСтрока(В, 0.25);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СтрокаГлавного(В, Название, Значение, Уровень, Комментарий)

	Цвет = ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ?(Уровень = 3, ЦветХорошо(), Неопределено)));
	Фон = ?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ?(Уровень = 3, ФонХорошо(), Неопределено)));
	Ячейка(В, 1, Название);
	Ячейка(В, 2, Значение, Истина, Цвет, Фон, 11, 3);
	ВПраво(В, 2, 3);
	Ячейка(В, 4, Комментарий, , ЦветПриглушенный(), , 9, 8);
	ЛинияСнизу(В, 1, 8);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ВывестиДеньги(В, Р, П)

	ЗаголовокРаздела(В, "Деньги");
	Если ПоказатьОшибку(В, Р, "Деньги") Тогда
		Возврат;
	КонецЕсли;
	Д = Р.Деньги;

	Подзаголовок(В, "Остатки на конец дня");
	Шапка(В, "Счёт / касса", "На " + Формат(П.День - 86400, "ДФ=dd.MM"), "На " + Формат(П.День, "ДФ=dd.MM"), "Изменение");
	Для Каждого Стр Из Д.Счета Цикл
		Ячейка(В, 1, Строка(Стр.Вид) + ": " + Строка(Стр.Счет));
		ЯчейкаЧисло(В, 2, Стр.Вчера);
		ЯчейкаЧисло(В, 3, Стр.Сегодня);
		ЯчейкаЧисло(В, 4, Стр.Сегодня - Стр.Вчера, ЦветИзменения(Стр.Сегодня - Стр.Вчера));
		ЛинияСнизу(В, 1, 4);
		СледующаяСтрока(В);
	КонецЦикла;
	СтрокаИтога(В, "Итого на счетах и в кассе", Д.ИтогоВчера, Д.Итого, Д.Итого - Д.ИтогоВчера);
	Деп = Д.Депозиты;
	Ячейка(В, 1, "Депозиты");
	ЯчейкаЧисло(В, 2, Деп.Вчера);
	ЯчейкаЧисло(В, 3, Деп.Сегодня);
	ЯчейкаЧисло(В, 4, Деп.Сегодня - Деп.Вчера, ЦветИзменения(Деп.Сегодня - Деп.Вчера));
	ЛинияСнизу(В, 1, 4);
	СледующаяСтрока(В);
	СтрокаИтога(В, "Итого с депозитами", Д.ВсегоСДепозитамиВчера, Д.ВсегоСДепозитами, Д.ВсегоСДепозитами - Д.ВсегоСДепозитамиВчера);
	Примечание(В, "Депозиты: " + ?(НЕ ПустаяСтрока(Деп.Ошибка), "не прочитаны — " + Деп.Ошибка,
		?(ПустаяСтрока(Деп.Источник), "в базе не найдены. Проверено: " + ?(Деп.Пути.Количество() = 0, "регистров с договорами депозитов нет", СтрСоединить(Деп.Пути, "; "))
			+ ". Нажмите «Диагностика» и пришлите файл.",
		"источник — " + Деп.Источник + ".")));

	СледующаяСтрока(В);
	Подзаголовок(В, "Движение денег");
	Шапка(В, "", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа");
	Ячейка(В, 1, "Поступило");
	ЯчейкаЧисло(В, 2, Д.Приход, ЦветХорошо());
	ЯчейкаЧисло(В, 3, Д.ПриходМесяц);
	ЛинияСнизу(В, 1, 3);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Оплачено");
	ЯчейкаЧисло(В, 2, Д.Расход, ЦветКрит());
	ЯчейкаЧисло(В, 3, Д.РасходМесяц);
	ЛинияСнизу(В, 1, 3);
	СледующаяСтрока(В);
	СтрокаИтога(В, "Сальдо", Д.Приход - Д.Расход, Д.ПриходМесяц - Д.РасходМесяц);
	Если Д.Перемещений > 0 Тогда
		Примечание(В, "Внутренние перемещения между своими счетами и кассой (" + Д.Перемещений + ") в приход и расход не включены.");
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Платежи за день");
	Если Д.Платежи.Количество() = 0 Тогда
		Примечание(В, "Движения по счетам и кассе за день нет.");
	Иначе
		Шапка(В, "Контрагент", "", "Статья", "", "Назначение", "", "", "Сумма");
		Для Каждого Стр Из Д.Платежи Цикл
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			Ячейка(В, 2, Стр.Вид, Истина, ?(Стр.Вид = "приход", ЦветХорошо(), ЦветПриглушенный()));
			Ячейка(В, 3, Строка(Стр.Статья), , , , 9, 4, Истина);
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.Назначение), Строка(Стр.Назначение), Строка(Стр.Документ)), , ЦветПриглушенный(), , 9, 7, Истина);
			ЯчейкаЧисло(В, 8, Стр.Сумма, ?(Стр.Вид = "приход", ЦветХорошо(), Неопределено));
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ПодогнатьВысоту(В, Строка(Стр.Назначение), 45);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Остаток денег на конец дня за 14 дней");
	Точки = Новый Массив;
	Значения = Новый Массив;
	Шапка(В, "Дата", "Остаток", "За день");
	Предыдущий = Неопределено;
	Для Каждого Стр Из Д.Динамика Цикл
		Точки.Добавить(Формат(Стр.Дата, "ДФ=dd.MM"));
		Значения.Добавить(Стр.Остаток);
		Ячейка(В, 1, Формат(Стр.Дата, "ДФ='dd.MM, ddd'"), Стр.Дата = П.День, ?(Стр.Дата = П.День, Неопределено, ЦветПриглушенный()), , 9);
		ЯчейкаЧисло(В, 2, Стр.Остаток, ?(Стр.Остаток < 0, ЦветКрит(), Неопределено), Стр.Дата = П.День);
		Если Предыдущий <> Неопределено Тогда
			ЯчейкаЧисло(В, 3, Стр.Остаток - Предыдущий, ЦветИзменения(Стр.Остаток - Предыдущий));
		КонецЕсли;
		Предыдущий = Стр.Остаток;
		ЛинияСнизу(В, 1, 3);
		СледующаяСтрока(В);
	КонецЦикла;
	Серии = Новый Массив;
	Серии.Добавить(Новый Структура("Имя, Значения", "Остаток денег, руб.", Значения));
	ВывестиГрафик(В, Точки, Серии, 12);

	Если Д.ПоСтатьям.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Движение денег с начала месяца по статьям");
		Шапка(В, "Статья движения денежных средств", "Поступило", "Оплачено", "Сальдо");
		Для Каждого Стр Из Д.ПоСтатьям Цикл
			Ячейка(В, 1, Строка(Стр.Статья), , , , , , Истина);
			ЯчейкаЧисло(В, 2, Стр.Приход, ?(Стр.Приход > 0, ЦветХорошо(), Неопределено));
			ЯчейкаЧисло(В, 3, Стр.Расход);
			ЯчейкаЧисло(В, 4, Стр.Приход - Стр.Расход, ЦветИзменения(Стр.Приход - Стр.Расход));
			РасшифровкаСтроки(В, Стр.Статья, 4);
			ЛинияСнизу(В, 1, 4);
			СледующаяСтрока(В);
		КонецЦикла;
		СтрокаИтога(В, "Итого", Д.ПриходМесяц, Д.РасходМесяц, Д.ПриходМесяц - Д.РасходМесяц);
	КонецЕсли;
	Для Каждого Вид Из СтрРазделить("Плательщики,Получатели", ",") Цикл
		Таблица = Д[Вид];
		Если Таблица.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СледующаяСтрока(В);
		Подзаголовок(В, ?(Вид = "Плательщики", "Кто больше всех заплатил нам с начала месяца", "Кому мы больше всех заплатили с начала месяца"));
		Итого = ?(Вид = "Плательщики", Д.ПриходМесяц, Д.РасходМесяц);
		Шапка(В, "Контрагент", "Сумма", "Доля");
		Для Каждого Стр Из Таблица Цикл
			Сумма = ?(Вид = "Плательщики", Стр.Приход, Стр.Расход);
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			ЯчейкаЧисло(В, 2, Сумма);
			ЯчейкаПроцента(В, 3, ?(Итого = 0, Неопределено, Сумма / Итого * 100), Ложь);
			РасшифровкаСтроки(В, Стр.Контрагент, 3);
			ЛинияСнизу(В, 1, 3);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиДолги(В, Р, П)

	ЗаголовокРаздела(В, "Долги");
	Если ПоказатьОшибку(В, Р, "Долги") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вид Из СтрРазделить("НамДолжны,МыДолжны", ",") Цикл
		Д = Р.Долги[Вид];
		Подзаголовок(В, ?(Вид = "НамДолжны", "Нам должны покупатели", "Мы должны поставщикам"));
		Если Д.Позиции.Количество() = 0 Тогда
			Примечание(В, "Долгов нет.");
			СледующаяСтрока(В);
			Продолжить;
		КонецЕсли;
		Шапка(В, "", "Всего", "Просрочено", "Доля", "Срок в " + П.Горизонт + " дн.", "На 1-е число", "Изменение", "Просрочено на 1-е");
		Ячейка(В, 1, ?(Вид = "НамДолжны", "Долг покупателей", "Наш долг"));
		ЯчейкаЧисло(В, 2, Д.Всего, , Истина);
		ЯчейкаЧисло(В, 3, Д.Просрочено, ?(Д.Просрочено > 0, ЦветКрит(), Неопределено), Истина);
		Ячейка(В, 4, ?(Д.Всего = 0, "—", Формат(Д.Просрочено / Д.Всего * 100, "ЧДЦ=0; ЧН=0") + " %"));
		ВПраво(В, 4, 4);
		ЯчейкаЧисло(В, 5, Д.ВБлижайшие);
		ЯчейкаЧисло(В, 6, Д.ВсегоНаНачало);
		ЯчейкаЧисло(В, 7, Д.Всего - Д.ВсегоНаНачало, ?(Д.Всего - Д.ВсегоНаНачало > 0, ?(Вид = "НамДолжны", ЦветВнимание(), ЦветКрит()), ЦветХорошо()));
		ЯчейкаЧисло(В, 8, Д.ПросроченоНаНачало);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
		Если Д.ЕстьСроки Тогда
			Индекс = 0;
			Для Каждого Корзина Из Д.Корзины Цикл
				Если Корзина.Сумма <> 0 Тогда
					Ячейка(В, 1, "   " + Корзина.Заголовок, , ЦветПриглушенный());
					ЯчейкаЧисло(В, 2, Корзина.Сумма, ?(Индекс >= 3, ЦветКрит(), ?(Индекс >= 1, ЦветВнимание(), Неопределено)));
					Ячейка(В, 3, Формат(Корзина.Сумма / Д.Всего * 100, "ЧДЦ=0; ЧН=0") + " %", , ЦветПриглушенный());
					ВПраво(В, 3, 3);
					СледующаяСтрока(В);
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;
		Иначе
			Примечание(В, "В регистре " + Д.Регистр + " нет сроков оплаты, поэтому просрочка не считается.");
		КонецЕсли;

		СледующаяСтрока(В, 0.5);
		Шапка(В, ?(Вид = "НамДолжны", "Покупатель", "Поставщик"), "Долг", "Просрочено", "Дней просрочки", "Ближайший срок", "Документов");
		Номер = 0;
		Для Каждого Стр Из Д.ПоКонтрагентам Цикл
			Номер = Номер + 1;
			Если Номер > 15 Тогда
				Примечание(В, "…и ещё " + (Д.ПоКонтрагентам.Количество() - 15) + ", без просрочки или с меньшим долгом.");
				Прервать;
			КонецЕсли;
			Уровень = ?(Стр.МаксПросрочка > 60, 0, ?(Стр.МаксПросрочка > 0, 1, -1));
			Ячейка(В, 1, Строка(Стр.Контрагент), , , , , , Истина);
			ЯчейкаЧисло(В, 2, Стр.Долг);
			ЯчейкаЧисло(В, 3, Стр.Просрочено, ?(Стр.Просрочено > 0, ЦветКрит(), Неопределено));
			Если Стр.МаксПросрочка > 0 Тогда
				Ячейка(В, 4, Формат(Стр.МаксПросрочка, "ЧГ=0") + " дн.", Истина, ?(Уровень = 0, ЦветКрит(), ЦветВнимание()), ?(Уровень = 0, ФонКрит(), ФонВнимание()));
			Иначе
				Ячейка(В, 4, "в срок", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 4, 4);
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.БлижайшийСрок), Формат(Стр.БлижайшийСрок, "ДФ=dd.MM.yy"), "—"));
			ВПраво(В, 5, 5);
			ЯчейкаЧисло(В, 6, Стр.Документов);
			РасшифровкаСтроки(В, Стр.Контрагент, 6);
			ЛинияСнизу(В, 1, 6);
			СледующаяСтрока(В);
		КонецЦикла;

		Если Д.Ближайшие.Количество() > 0 Тогда
			СледующаяСтрока(В, 0.5);
			Ячейка(В, 1, ?(Вид = "НамДолжны", "Ожидаемые поступления", "Платежи по срокам") + " в ближайшие " + П.Горизонт + " дн.: " + ФорматДенег(Д.ВБлижайшие) + " руб.", Истина, , , 9, 8);
			СледующаяСтрока(В);
			Для Каждого Стр Из Д.Ближайшие Цикл
				Ячейка(В, 1, Формат(Стр.Срок, "ДФ='dd.MM, ddd'") + "   " + Строка(Стр.Контрагент), , , , 9, 4);
				Ячейка(В, 5, Строка(Стр.Документ), , ЦветПриглушенный(), , 9, 7);
				ЯчейкаЧисло(В, 8, Стр.Сумма);
				ЛинияСнизу(В, 1, 8);
				СледующаяСтрока(В);
			КонецЦикла;
		КонецЕсли;
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

// Финансовый результат по бухучёту (форма «Отчёт о финансовых результатах»), по месяцам текущего квартала,
// итог квартала и прошлый квартал. Счета: 90.01 выручка (Кт), 90.03 НДС, 90.04 акцизы, 90.02 себестоимость,
// 90.07 коммерческие, 90.08 управленческие, 91.01 прочие доходы, 91.02 прочие расходы (проценты — по статьям со словом
// «процент»), 99.02 налог на прибыль. Месяц считается закрытым, если в нём закрыт счёт 90 (обороты по 90.09).
&НаСервере
Функция ПолучитьФинрезультат(П)

	Если Метаданные.ПланыСчетов.Найти("Хозрасчетный") = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет плана счетов «Хозрасчетный»";
	КонецЕсли;
	ДатаНачалаКвартала = НачалоКвартала(П.День);
	НачалоПрошлого = ДобавитьМесяц(ДатаНачалаКвартала, -3);
	Счета = Новый Массив;
	Для Каждого КодСчета Из СтрРазделить("90,91,99", ",") Цикл
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета);
		Если ЗначениеЗаполнено(Счет) Тогда
			Счета.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Если Счета.Количество() = 0 Тогда
		ВызватьИсключение "в плане счетов нет счетов 90, 91, 99";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ) КАК Месяц,
		|	Т.Счет КАК Счет,
		|	Т.Субконто1 КАК Статья,
		|	СУММА(Т.СуммаОборотДт) КАК Дт,
		|	СУММА(Т.СуммаОборотКт) КАК Кт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПрошлого, &КонецКвартала, Месяц, Счет В ИЕРАРХИИ (&Счета), , "
		+ ?(ЗначениеЗаполнено(П.Организация), "Организация = &Организация", "") + ", , ) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ),
		|	Т.Счет,
		|	Т.Субконто1";
	Запрос.УстановитьПараметр("НачалоПрошлого", НачалоПрошлого);
	Запрос.УстановитьПараметр("КонецКвартала", КонецКвартала(П.День));
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("Организация", П.Организация);
	Таблица = Запрос.Выполнить().Выгрузить();

	Месяцы = Новый Массив;
	Для Н = 0 По 2 Цикл
		Месяцы.Добавить(ДобавитьМесяц(ДатаНачалаКвартала, Н));
	КонецЦикла;
	Колонки = Новый Массив;
	Для Каждого Мес Из Месяцы Цикл
		Колонки.Добавить(НоваяКолонкаФинрезультата(Мес, Мес, ИмяМесяца(Месяц(Мес), Ложь)));
	КонецЦикла;
	Колонки.Добавить(НоваяКолонкаФинрезультата(ДатаНачалаКвартала, ДобавитьМесяц(ДатаНачалаКвартала, 2), "Квартал"));
	Колонки.Добавить(НоваяКолонкаФинрезультата(НачалоПрошлого, ДобавитьМесяц(НачалоПрошлого, 2), "Прошлый квартал"));

	Для Каждого Стр Из Таблица Цикл
		Код = СокрЛП(Стр.Счет.Код);
		Дт = ЧислоИлиНоль(Стр.Дт);
		Кт = ЧислоИлиНоль(Стр.Кт);
		ЭтоПроценты = СтрНайти(НРег(Строка(Стр.Статья)), "процент") > 0;
		Для Каждого Кол Из Колонки Цикл
			Если Стр.Месяц < Кол.НачалоПериода ИЛИ Стр.Месяц > Кол.КонецПериода Тогда
				Продолжить;
			КонецЕсли;
			Если СчетНачинаетсяС(Код, "90.01") Тогда
				Кол.Выручка = Кол.Выручка + Кт - Дт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.03") ИЛИ СчетНачинаетсяС(Код, "90.04") ИЛИ СчетНачинаетсяС(Код, "90.05") Тогда
				Кол.Выручка = Кол.Выручка - (Дт - Кт);
			ИначеЕсли СчетНачинаетсяС(Код, "90.02") Тогда
				Кол.Себестоимость = Кол.Себестоимость + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.07") Тогда
				Кол.Коммерческие = Кол.Коммерческие + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.08") Тогда
				Кол.Управленческие = Кол.Управленческие + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "90.09") Тогда
				Кол.Закрыт = Кол.Закрыт ИЛИ Дт <> 0 ИЛИ Кт <> 0;
			ИначеЕсли СчетНачинаетсяС(Код, "91.01") Тогда
				Если ЭтоПроценты Тогда
					Кол.ПроцентыКПолучению = Кол.ПроцентыКПолучению + Кт - Дт;
				Иначе
					Кол.ПрочиеДоходы = Кол.ПрочиеДоходы + Кт - Дт;
				КонецЕсли;
			ИначеЕсли СчетНачинаетсяС(Код, "91.02") Тогда
				Если ЭтоПроценты Тогда
					Кол.ПроцентыКУплате = Кол.ПроцентыКУплате + Дт - Кт;
				Иначе
					Кол.ПрочиеРасходы = Кол.ПрочиеРасходы + Дт - Кт;
				КонецЕсли;
			ИначеЕсли СчетНачинаетсяС(Код, "99.02") Тогда
				Кол.Налог = Кол.Налог + Дт - Кт;
			ИначеЕсли СчетНачинаетсяС(Код, "99") И НЕ СчетНачинаетсяС(Код, "99.02") Тогда
				Кол.Прочие99 = Кол.Прочие99 + Дт - Кт;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// прямые затраты в себестоимости продаж — из регистра «Выручка и себестоимость продаж»
	ИсточникПрямых = "";
	Попытка
		ИсточникПрямых = ДобавитьПрямыеЗатраты(Колонки, П, НачалоПрошлого);
	Исключение
		ИсточникПрямых = "";
	КонецПопытки;

	ЗакрытыхМесяцев = 0;
	Для Каждого Кол Из Колонки Цикл
		Кол.ПоПрямым = Кол.Выручка - Кол.Прямые;
		Кол.Косвенные = Кол.Себестоимость - Кол.Прямые;
		Кол.ОтПродаж = Кол.Выручка - Кол.Себестоимость - Кол.Коммерческие - Кол.Управленческие;
		Кол.ДоНалога = Кол.ОтПродаж + Кол.ПроцентыКПолучению - Кол.ПроцентыКУплате + Кол.ПрочиеДоходы - Кол.ПрочиеРасходы;
		Кол.Чистая = Кол.ДоНалога - Кол.Налог;
	КонецЦикла;
	Для Н = 0 По 2 Цикл
		Если Колонки[Н].Закрыт Тогда
			ЗакрытыхМесяцев = ЗакрытыхМесяцев + 1;
		КонецЕсли;
	КонецЦикла;
	Колонки[3].Закрыт = ЗакрытыхМесяцев > 0;
	Р = Новый Структура;
	Р.Вставить("Колонки", Колонки);
	Р.Вставить("ЗакрытыхМесяцев", ЗакрытыхМесяцев);
	Р.Вставить("ЕстьПрямые", ИсточникПрямых <> "");
	Р.Вставить("ИсточникПрямых", ИсточникПрямых);
	Р.Вставить("ИмяКвартала", Формат(Цел((Месяц(ДатаНачалаКвартала) - 1) / 3) + 1, "ЧГ=0") + " квартал " + Формат(Год(ДатаНачалаКвартала), "ЧГ=0"));
	Возврат Р;

КонецФункции

&НаСервере
Функция ДобавитьПрямыеЗатраты(Колонки, П, НачалоПериода)

	// прямые затраты по месяцам в регламентированной оценке (как в 90.02);
	// если регл. суммы пусты — в управленческой без НДС
	Рег = "ВыручкаИСебестоимостьПродаж";
	Если Метаданные.РегистрыНакопления.Найти(Рег) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Условие = УсловиеОрганизации(Рег, П);
	Для Каждого Регл Из СтрРазделить("Да,Нет", ",") Цикл
		Состав = СоставСебестоимости(Рег, Регл = "Да");
		Если Состав.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ) КАК Месяц,
			|	" + ПоляСебестоимости(Состав) + "
			|ИЗ
			|	РегистрНакопления." + Рег + ".Обороты(&НачалоПериода, &КонецКвартала, Месяц" + ?(Условие = "", "", ", " + Условие) + ") КАК Т
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ)";
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецКвартала", КонецКвартала(П.День));
		Запрос.УстановитьПараметр("Организация", П.Организация);
		Строки = Запрос.Выполнить().Выгрузить();
		Ресурсы = РазложитьСебестоимость(Строки, Состав);
		Если Строки.Итог("Прямые") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Стр Из Строки Цикл
			Для Каждого Кол Из Колонки Цикл
				Если Стр.Месяц >= Кол.НачалоПериода И Стр.Месяц <= Кол.КонецПериода Тогда
					Кол.Прямые = Кол.Прямые + Стр.Прямые;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат ?(Регл = "Да", "регл. оценка", "упр. оценка без НДС") + ": " + Ресурсы;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Функция НоваяКолонкаФинрезультата(НачалоКолонки, КонецКолонки, Заголовок)

	Кол = Новый Структура("НачалоПериода, КонецПериода, Заголовок, Закрыт", НачалоКолонки, КонецКолонки, Заголовок, Ложь);
	Для Каждого Имя Из СтрРазделить("Выручка,Себестоимость,Прямые,ПоПрямым,Косвенные,Коммерческие,Управленческие,ОтПродаж,ПроцентыКПолучению,ПроцентыКУплате,"
		+ "ПрочиеДоходы,ПрочиеРасходы,ДоНалога,Налог,Чистая,Прочие99", ",") Цикл
		Кол.Вставить(Имя, 0);
	КонецЦикла;
	Возврат Кол;

КонецФункции

// «90.01.1» начинается с «90.01», а «90.1» — нет: сравнение по сегментам кода.
&НаСервереБезКонтекста
Функция СчетНачинаетсяС(Код, Префикс)

	Возврат Код = Префикс ИЛИ Лев(Код, СтрДлина(Префикс) + 1) = Префикс + ".";

КонецФункции

&НаСервере
Процедура ВывестиФинрезультат(В, Р, П)

	ЗаголовокРаздела(В, "Финансовый результат за квартал (бухучёт)");
	Если ПоказатьОшибку(В, Р, "Финрезультат") Тогда
		Возврат;
	КонецЕсли;
	Ф = Р.Финрезультат;
	К = Ф.Колонки;
	Заголовки = Новый Массив;
	Для Каждого Кол Из К Цикл
		Заголовки.Добавить(Кол.Заголовок + ?(Кол.Заголовок = "Квартал" ИЛИ Кол.Заголовок = "Прошлый квартал" ИЛИ Кол.Закрыт, "", Символы.ПС + "не закрыт"));
	КонецЦикла;
	Шапка(В, Ф.ИмяКвартала, Заголовки[0], Заголовки[1], Заголовки[2], "Итого за квартал", "Прошлый квартал", "Изм. к прошл.");
	ВывестиСтрокуФинрезультата(В, К, "Выручка (без НДС и акцизов)", "Выручка", Ложь, Ложь);
	Если Ф.ЕстьПрямые Тогда
		ВывестиСтрокуФинрезультата(В, К, "Прямые затраты в себестоимости продаж", "Прямые", Ложь, Истина);
		ВывестиСтрокуФинрезультата(В, К, "Прибыль по прямым затратам", "ПоПрямым", Истина, Ложь);
		ВывестиСтрокуФинрезультата(В, К, "Косвенные затраты в себестоимости продаж", "Косвенные", Ложь, Истина);
	Иначе
		ВывестиСтрокуФинрезультата(В, К, "Себестоимость продаж", "Себестоимость", Ложь, Истина);
	КонецЕсли;
	ВывестиСтрокуФинрезультата(В, К, "Коммерческие расходы", "Коммерческие", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Управленческие расходы", "Управленческие", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Прибыль от продаж", "ОтПродаж", Истина, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Проценты к получению", "ПроцентыКПолучению", Ложь, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Проценты к уплате", "ПроцентыКУплате", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Прочие доходы", "ПрочиеДоходы", Ложь, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Прочие расходы", "ПрочиеРасходы", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Прибыль до налогообложения", "ДоНалога", Истина, Ложь);
	ВывестиСтрокуФинрезультата(В, К, "Налог на прибыль (текущий и отложенный)", "Налог", Ложь, Истина);
	ВывестиСтрокуФинрезультата(В, К, "Чистая прибыль", "Чистая", Истина, Ложь);

	// рентабельности
	Для Каждого Пара Из СтрРазделить("Рентабельность по прямым затратам:ПоПрямым,Рентабельность продаж:ОтПродаж,Чистая рентабельность:Чистая", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Если Части[1] = "ПоПрямым" И НЕ Ф.ЕстьПрямые Тогда
			Продолжить;
		КонецЕсли;
		Ячейка(В, 1, Части[0], , ЦветПриглушенный());
		Для Индекс = 0 По 4 Цикл
			Кол = К[Индекс];
			Ячейка(В, Индекс + 2, ?(Кол.Выручка = 0, "—", Формат(Кол[Части[1]] / Кол.Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"), , ЦветПриглушенный());
			ВПраво(В, Индекс + 2, Индекс + 2);
		КонецЦикла;
		Если К[3].Выручка <> 0 И К[4].Выручка <> 0 Тогда
			Изм = (К[3][Части[1]] / К[3].Выручка - К[4][Части[1]] / К[4].Выручка) * 100;
			Ячейка(В, 7, ?(Изм > 0, "+", "") + Формат(Изм, "ЧДЦ=1; ЧН=0") + " п.п.", , ?(Изм > 0, ЦветХорошо(), ?(Изм < 0, ЦветКрит(), Неопределено)));
			ВПраво(В, 7, 7);
		КонецЕсли;
		ЛинияСнизу(В, 1, 7);
		СледующаяСтрока(В);
	КонецЦикла;
	Если Ф.ЕстьПрямые Тогда
		Примечание(В, "Прямые затраты — материалы, доп. расходы, трудозатраты и переменные статьи в себестоимости проданного (регистр «Выручка и себестоимость продаж», "
			+ Ф.ИсточникПрямых + "). Прибыль по прямым затратам = выручка − прямые затраты. Косвенные = себестоимость продаж по счёту 90.02 − прямые: "
			+ "распределённые общепроизводственные расходы и прочее, что попало в 90.02.");
	Иначе
		Примечание(В, "Прибыль по прямым затратам не посчитана: в регистре «Выручка и себестоимость продаж» нет разбивки себестоимости за эти месяцы "
			+ "(появляется после закрытия месяца).");
	КонецЕсли;
	Примечание(В, "По данным бухучёта (счета 90, 91, 99), как в форме «Отчёт о финансовых результатах». "
		+ "Прибыль от продаж = выручка − вся себестоимость продаж − коммерческие − управленческие; прибыль до налогообложения = от продаж + проценты к получению − проценты к уплате + прочие доходы − прочие расходы; "
		+ "чистая = до налогообложения − налог на прибыль (99.02). Цифры месяца окончательные после закрытия месяца; незакрытый месяц помечен — в нём нет себестоимости и распределения расходов. "
		+ "«Изм. к прошл.» сравнивает квартал целиком с прошлым кварталом целиком, поэтому до конца квартала сравнение неполное.");

КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуФинрезультата(В, К, Название, Поле, Итоговая, Расход)

	Фон = ?(Итоговая, Новый Цвет(226, 240, 238), Неопределено);
	Ячейка(В, 1, ?(Расход, "   ", "") + Название, Итоговая, ?(Итоговая, ЦветАкцент(), Неопределено), Фон);
	Для Индекс = 0 По 4 Цикл
		Значение = К[Индекс][Поле];
		Цвет = ?(Итоговая И Значение < 0, ЦветКрит(), Неопределено);
		ЯчейкаЧисло(В, Индекс + 2, Значение, Цвет, Итоговая ИЛИ Индекс = 3, Фон);
	КонецЦикла;
	Было = К[4][Поле];
	Стало = К[3][Поле];
	Если Было <> 0 Тогда
		Изм = (Стало / Было - 1) * 100 * ?(Было < 0, -1, 1);
		ЯчейкаПроцента(В, 7, Изм, Истина, ?(Расход, ?(Изм > 0, ЦветКрит(), ЦветХорошо()), Неопределено));
	Иначе
		Ячейка(В, 7, "", , , Фон);
	КонецЕсли;
	ЛинияСнизу(В, 1, 7);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервереБезКонтекста
Функция МинДата(Д1, Д2)

	Если НЕ ЗначениеЗаполнено(Д1) Тогда
		Возврат Д2;
	ИначеЕсли НЕ ЗначениеЗаполнено(Д2) Тогда
		Возврат Д1;
	КонецЕсли;
	Возврат Мин(Д1, Д2);

КонецФункции

&НаСервереБезКонтекста
Функция МаксДата(Д1, Д2)

	Если НЕ ЗначениеЗаполнено(Д1) Тогда
		Возврат Д2;
	ИначеЕсли НЕ ЗначениеЗаполнено(Д2) Тогда
		Возврат Д1;
	КонецЕсли;
	Возврат Макс(Д1, Д2);

КонецФункции

// Неоплаченные счета за 5 лет: счета на оплату клиентам старше 30 дней, по которым не было оплаты.
// Оплаченным счёт считается, если документ оплаты (поступление на счёт, в кассу) ссылается на сам счёт,
// на заказ клиента, на основании которого он выписан, или на объект расчётов по ним. Если ссылок нет —
// счёт «вероятно оплачен», когда клиент за 90 дней после счёта заплатил не меньше 90 % его суммы.
&НаСервере
Функция ПолучитьНеоплаченныеСчета(П)

	ИмяСчета = "СчетНаОплатуКлиенту";
	МетаСчета = Метаданные.Документы.Найти(ИмяСчета);
	Если МетаСчета = Неопределено Тогда
		ВызватьИсключение "в конфигурации нет документа «Счет на оплату клиенту»";
	КонецЕсли;
	РекКлиент = РеквизитКоллекции(МетаСчета.Реквизиты, "Контрагент,Партнер");
	ТипЗаказа = ?(Метаданные.Документы.Найти("ЗаказКлиента") = Неопределено, Неопределено, Тип("ДокументСсылка.ЗаказКлиента"));
	РекОснование = "";
	Если ТипЗаказа <> Неопределено Тогда
		Для Каждого Реквизит Из МетаСчета.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипЗаказа) Тогда
				РекОснование = Реквизит.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Начало = ДобавитьМесяц(НачалоДня(П.День), -60);
	Граница = НачалоДня(П.День) - 30 * 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Счет,
		|	Д.Номер КАК Номер,
		|	Д.Дата КАК Дата,
		|	Д." + РекКлиент + " КАК Клиент,
		|	Д.СуммаДокумента КАК Сумма,
		|	" + ?(РекОснование = "", "НЕОПРЕДЕЛЕНО", "Д." + РекОснование) + " КАК Заказ
		|ИЗ
		|	Документ." + ИмяСчета + " КАК Д
		|ГДЕ
		|	НЕ Д.ПометкаУдаления
		|	И Д.Дата МЕЖДУ &Начало И &Граница
		|	И Д.СуммаДокумента > 0" + ?(ЗначениеЗаполнено(П.Организация) И МетаСчета.Реквизиты.Найти("Организация") <> Неопределено, "
		|	И Д.Организация = &Организация", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Д.Дата";
	УстановитьПараметры(Запрос, П);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Граница", Граница);
	Счета = Запрос.Выполнить().Выгрузить();
	Счета.Колонки.Добавить("Оплачен", Новый ОписаниеТипов("Булево"));
	Счета.Колонки.Добавить("Вероятно", Новый ОписаниеТипов("Булево"));
	Счета.Колонки.Добавить("ЗаЧто", Новый ОписаниеТипов("Строка"));
	Счета.Колонки.Добавить("Позиций", ОписаниеЧисла());
	Всего = Счета.Количество();

	// что искать в документах оплаты: сами счета, их заказы и объекты расчётов по ним
	Искомые = Новый Соответствие; // ссылка -> массив счетов
	Для Каждого Стр Из Счета Цикл
		ДобавитьИскомое(Искомые, Стр.Счет, Стр);
		Если ЗначениеЗаполнено(Стр.Заказ) Тогда
			ДобавитьИскомое(Искомые, Стр.Заказ, Стр);
		КонецЕсли;
	КонецЦикла;
	МетаОбъектов = Метаданные.Справочники.Найти("ОбъектыРасчетов");
	Если МетаОбъектов <> Неопределено И МетаОбъектов.Реквизиты.Найти("Объект") <> Неопределено И Всего > 0 Тогда
		Ссылки = Новый Массив;
		Для Каждого КлючИЗначение Из Искомые Цикл
			Ссылки.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
		ЗапросОбъектов = Новый Запрос("ВЫБРАТЬ О.Ссылка КАК Ссылка, О.Объект КАК Объект ИЗ Справочник.ОбъектыРасчетов КАК О ГДЕ О.Объект В (&Ссылки)");
		ЗапросОбъектов.УстановитьПараметр("Ссылки", Ссылки);
		Попытка
			Выборка = ЗапросОбъектов.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Для Каждого Стр Из Искомые[Выборка.Объект] Цикл
					ДобавитьИскомое(Искомые, Выборка.Ссылка, Стр);
				КонецЦикла;
			КонецЦикла;
		Исключение
			// без объектов расчётов — ищем только по счетам и заказам
			Ссылки = Ссылки;
		КонецПопытки;
	КонецЕсли;
	ТипыИскомых = Новый Массив;
	ТипыИскомых.Добавить(Тип("ДокументСсылка." + ИмяСчета));
	Если ТипЗаказа <> Неопределено Тогда
		ТипыИскомых.Добавить(ТипЗаказа);
	КонецЕсли;
	Если МетаОбъектов <> Неопределено Тогда
		ТипыИскомых.Добавить(Тип("СправочникСсылка.ОбъектыРасчетов"));
	КонецЕсли;

	// документы оплаты: все реквизиты шапки и строк, которые могут ссылаться на счёт, заказ или объект расчётов
	ДокументыОплаты = СтрРазделить("ПоступлениеБезналичныхДенежныхСредств,ПриходныйКассовыйОрдер,ОперацияПоПлатежнойКарте", ",");
	НайденоСсылок = 0;
	Для Каждого ИмяДокумента Из ДокументыОплаты Цикл
		МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поля = Новый Массив;
		Для Каждого Реквизит Из МетаДокумента.Реквизиты Цикл
			Если ТипПодходит(Реквизит.Тип, ТипыИскомых) Тогда
				Поля.Добавить(Новый Структура("Таблица, Поле, Условие", "Документ." + ИмяДокумента, "Т." + Реквизит.Имя, "Т.Проведен"));
			КонецЕсли;
		КонецЦикла;
		Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
			Для Каждого Реквизит Из МетаТЧ.Реквизиты Цикл
				Если ТипПодходит(Реквизит.Тип, ТипыИскомых) Тогда
					Поля.Добавить(Новый Структура("Таблица, Поле, Условие", "Документ." + ИмяДокумента + "." + МетаТЧ.Имя, "Т." + Реквизит.Имя, "Т.Ссылка.Проведен"));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Для Каждого Описание Из Поля Цикл
			Ссылки = Новый Массив;
			Для Каждого КлючИЗначение Из Искомые Цикл
				Ссылки.Добавить(КлючИЗначение.Ключ);
			КонецЦикла;
			ЗапросОплат = Новый Запрос(
				"ВЫБРАТЬ РАЗЛИЧНЫЕ " + Описание.Поле + " КАК Ссылка ИЗ " + Описание.Таблица + " КАК Т ГДЕ " + Описание.Условие + " И " + Описание.Поле + " В (&Ссылки)");
			ЗапросОплат.УстановитьПараметр("Ссылки", Ссылки);
			Попытка
				Выборка = ЗапросОплат.Выполнить().Выбрать();
			Исключение
				Продолжить;
			КонецПопытки;
			Пока Выборка.Следующий() Цикл
				Связанные = Искомые[Выборка.Ссылка];
				Если Связанные = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого Стр Из Связанные Цикл
					Если НЕ Стр.Оплачен Тогда
						Стр.Оплачен = Истина;
						НайденоСсылок = НайденоСсылок + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// без ссылок: клиент за 90 дней после счёта заплатил не меньше 90 % суммы — вероятно оплачен
	Клиенты = Новый Массив;
	Для Каждого Стр Из Счета Цикл
		Если НЕ Стр.Оплачен И ЗначениеЗаполнено(Стр.Клиент) И Клиенты.Найти(Стр.Клиент) = Неопределено Тогда
			Клиенты.Добавить(Стр.Клиент);
		КонецЕсли;
	КонецЦикла;
	Платежи = Новый ТаблицаЗначений;
	Платежи.Колонки.Добавить("Клиент");
	Платежи.Колонки.Добавить("Дата");
	Платежи.Колонки.Добавить("Сумма", ОписаниеЧисла());
	Если Клиенты.Количество() > 0 Тогда
		Для Каждого ИмяДокумента Из ДокументыОплаты Цикл
			МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
			Если МетаДокумента = Неопределено ИЛИ МетаДокумента.Реквизиты.Найти("СуммаДокумента") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			РекПлательщик = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Плательщик,Партнер");
			Если РекПлательщик = "" Тогда
				Продолжить;
			КонецЕсли;
			ЗапросПлатежей = Новый Запрос(
				"ВЫБРАТЬ Т." + РекПлательщик + " КАК Клиент, Т.Дата КАК Дата, Т.СуммаДокумента КАК Сумма
				|ИЗ Документ." + ИмяДокумента + " КАК Т
				|ГДЕ Т.Проведен И Т.Дата >= &Начало И Т." + РекПлательщик + " В (&Клиенты)");
			ЗапросПлатежей.УстановитьПараметр("Начало", Начало);
			ЗапросПлатежей.УстановитьПараметр("Клиенты", Клиенты);
			Попытка
				Выборка = ЗапросПлатежей.Выполнить().Выбрать();
			Исключение
				Продолжить;
			КонецПопытки;
			Пока Выборка.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(Платежи.Добавить(), Выборка);
			КонецЦикла;
		КонецЦикла;
		Платежи.Индексы.Добавить("Клиент");
		Для Каждого Стр Из Счета Цикл
			Если Стр.Оплачен Тогда
				Продолжить;
			КонецЕсли;
			Оплачено = 0;
			Для Каждого Платеж Из Платежи.НайтиСтроки(Новый Структура("Клиент", Стр.Клиент)) Цикл
				Если Платеж.Дата >= Стр.Дата И Платеж.Дата <= Стр.Дата + 90 * 86400 Тогда
					Оплачено = Оплачено + Платеж.Сумма;
				КонецЕсли;
			КонецЦикла;
			Стр.Вероятно = Оплачено >= Стр.Сумма * 0.9;
		КонецЦикла;
	КонецЕсли;

	Неоплаченные = Счета.СкопироватьКолонки();
	Для Каждого Стр Из Счета Цикл
		Если НЕ Стр.Оплачен И НЕ Стр.Вероятно Тогда
			ЗаполнитьЗначенияСвойств(Неоплаченные.Добавить(), Стр);
		КонецЕсли;
	КонецЦикла;

	// за что: позиции счёта, самые крупные — первыми
	Если Неоплаченные.Количество() > 0 И МетаСчета.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
		РеквизитыТЧ = МетаСчета.ТабличныеЧасти.Товары.Реквизиты;
		ПолеСуммы = ?(РеквизитыТЧ.Найти("СуммаСНДС") <> Неопределено, "Т.СуммаСНДС", ?(РеквизитыТЧ.Найти("Сумма") <> Неопределено, "Т.Сумма", "0"));
		ПолеКоличества = ?(РеквизитыТЧ.Найти("Количество") <> Неопределено, "Т.Количество", "0");
		ЗапросТоваров = Новый Запрос(
			"ВЫБРАТЬ Т.Ссылка КАК Счет, Т.Номенклатура КАК Номенклатура, " + ПолеКоличества + " КАК Количество, " + ПолеСуммы + " КАК Сумма
			|ИЗ Документ." + ИмяСчета + ".Товары КАК Т
			|ГДЕ Т.Ссылка В (&Счета)
			|УПОРЯДОЧИТЬ ПО Т.Ссылка, Сумма УБЫВ");
		ЗапросТоваров.УстановитьПараметр("Счета", Неоплаченные.ВыгрузитьКолонку("Счет"));
		Товары = ЗапросТоваров.Выполнить().Выгрузить();
		Товары.Индексы.Добавить("Счет");
		Единицы = Новый Соответствие;
		Для Каждого Стр Из Неоплаченные Цикл
			Строки = Товары.НайтиСтроки(Новый Структура("Счет", Стр.Счет));
			Стр.Позиций = Строки.Количество();
			Части = Новый Массив;
			Для Каждого Товар Из Строки Цикл
				Если Части.Количество() = 3 Тогда
					Части.Добавить("и ещё " + (Строки.Количество() - 3) + " поз.");
					Прервать;
				КонецЕсли;
				Ед = Единицы[Товар.Номенклатура];
				Если Ед = Неопределено Тогда
					Ед = ЕдиницаНоменклатуры(Товар.Номенклатура);
					Единицы.Вставить(Товар.Номенклатура, Ед);
				КонецЕсли;
				Части.Добавить(Строка(Товар.Номенклатура) + ?(ЧислоИлиНоль(Товар.Количество) = 0, "", " — " + ФорматЧисла(Товар.Количество) + ?(ЗначениеЗаполнено(Ед), " " + Ед, "")));
			КонецЦикла;
			Стр.ЗаЧто = СтрСоединить(Части, "; ");
		КонецЦикла;
	КонецЕсли;

	// по клиентам
	ПоКлиентам = Неоплаченные.Скопировать(, "Клиент, Сумма");
	ПоКлиентам.Колонки.Добавить("Счетов", ОписаниеЧисла());
	ПоКлиентам.ЗаполнитьЗначения(1, "Счетов");
	ПоКлиентам.Свернуть("Клиент", "Сумма, Счетов");
	ПоКлиентам.Сортировать("Сумма Убыв");
	Неоплаченные.Сортировать("Клиент, Дата Убыв");

	Р = Новый Структура;
	Р.Вставить("Неоплаченные", Неоплаченные);
	Р.Вставить("ПоКлиентам", ПоКлиентам);
	Р.Вставить("Всего", Всего);
	Р.Вставить("ПоСсылкам", НайденоСсылок);
	Р.Вставить("Вероятно", Счета.НайтиСтроки(Новый Структура("Оплачен, Вероятно", Ложь, Истина)).Количество());
	Р.Вставить("Сумма", Неоплаченные.Итог("Сумма"));
	Р.Вставить("Начало", Начало);
	Р.Вставить("Граница", Граница);
	Возврат Р;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьИскомое(Искомые, Ссылка, СтрокаСчета)

	Массив = Искомые[Ссылка];
	Если Массив = Неопределено Тогда
		Массив = Новый Массив;
		Искомые.Вставить(Ссылка, Массив);
	КонецЕсли;
	Массив.Добавить(СтрокаСчета);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипПодходит(ОписаниеТипа, Типы)

	Для Каждого ТипИскомого Из Типы Цикл
		Если ОписаниеТипа.СодержитТип(ТипИскомого) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ВывестиНеоплаченныеСчета(В, Р, П)

	ЗаголовокРаздела(В, "Неоплаченные счета за 5 лет: кому выставили счёт, а оплаты не было");
	Если ПоказатьОшибку(В, Р, "НеоплаченныеСчета") Тогда
		Возврат;
	КонецЕсли;
	Н = Р.НеоплаченныеСчета;
	Примечание(В, СтрШаблон("Счета на оплату клиентам с %1 по %2 (свежие, моложе 30 дней, не берутся — их ещё могут оплатить). "
		+ "Выставлено счетов: %3; оплата найдена по документам: %4; вероятно оплачены (клиент заплатил сумму счёта за 90 дней): %5; "
		+ "НЕ ОПЛАЧЕНО: %6 счетов на %7, клиентов %8.",
		Формат(Н.Начало, "ДФ=dd.MM.yyyy"), Формат(Н.Граница, "ДФ=dd.MM.yyyy"), Н.Всего, Н.ПоСсылкам, Н.Вероятно,
		Н.Неоплаченные.Количество(), ДеньгиКратко(Н.Сумма), Н.ПоКлиентам.Количество()));
	Если Н.Неоплаченные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шапка(В, "Клиент / счёт", "Дата", "Сумма", "За что", "", "", "", "Дней назад");
	Номер = 0;
	Для Каждого Кл Из Н.ПоКлиентам Цикл
		Номер = Номер + 1;
		Если Номер > 40 Тогда
			Примечание(В, "…и ещё " + (Н.ПоКлиентам.Количество() - 40) + " клиентов с меньшими суммами.");
			Прервать;
		КонецЕсли;
		Фон = Новый Цвет(226, 240, 238);
		Ячейка(В, 1, Строка(Кл.Клиент) + " (" + Кл.Счетов + ")", Истина, ЦветАкцент(), Фон, , , Истина);
		Ячейка(В, 2, "", , , Фон);
		ЯчейкаЧисло(В, 3, Кл.Сумма, , Истина, Фон);
		Ячейка(В, 4, "", , , Фон, , 8);
		РасшифровкаСтроки(В, Кл.Клиент, 8);
		СледующаяСтрока(В);
		Строки = Н.Неоплаченные.НайтиСтроки(Новый Структура("Клиент", Кл.Клиент));
		Номер2 = 0;
		Для Каждого Стр Из Строки Цикл
			Номер2 = Номер2 + 1;
			Если Номер2 > 10 Тогда
				Ячейка(В, 1, "      …и ещё " + (Строки.Количество() - 10) + " счетов", , ЦветПриглушенный(), , 8, 8);
				СледующаяСтрока(В);
				Прервать;
			КонецЕсли;
			ЯчейкаПозиции(В, "Счёт № " + СокрЛП(Стр.Номер));
			Ячейка(В, 2, Формат(Стр.Дата, "ДФ=dd.MM.yy"));
			ВПраво(В, 2, 2);
			ЯчейкаЧисло(В, 3, Стр.Сумма);
			Ячейка(В, 4, ?(ПустаяСтрока(Стр.ЗаЧто), "—", Стр.ЗаЧто), , , , 8, 7, Истина);
			ПодогнатьВысоту(В, Стр.ЗаЧто, 90);
			Ячейка(В, 8, Формат(Цел((П.День - НачалоДня(Стр.Дата)) / 86400), "ЧГ=0"), , ЦветПриглушенный());
			ВПраво(В, 8, 8);
			РасшифровкаСтроки(В, Стр.Счет, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Итого не оплачено (" + Н.Неоплаченные.Количество() + " счетов)", , Н.Сумма);
	Примечание(В, "Оплаченным счёт считается, если поступление на счёт или в кассу ссылается на этот счёт, на его заказ клиента или на объект расчётов по ним. "
		+ "Суммы — по счёту с НДС. Двойной щелчок по клиенту открывает карточку, по счёту — сам счёт.");

КонецПроцедуры

// Арендаторы: кто арендует (документы «Передача ОС в аренду», возвраты из аренды), начисления аренды
// (строки реализаций, где в номенклатуре, содержании или статье доходов есть «аренд»), оплаты
// (поступления на счёт и в кассу от арендатора), долг и просрочка (из раздела «Долги»), срок договора.
&НаСервере
Функция ПолучитьАренду(П, Долги)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Арендатор");
	Т.Колонки.Добавить("Договор");
	Т.Колонки.Добавить("Объекты", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("Передано");
	Т.Колонки.Добавить("Возвращено");
	Т.Колонки.Добавить("Месяц", ОписаниеЧисла());
	Т.Колонки.Добавить("ПрошлыйМесяц", ОписаниеЧисла());
	Т.Колонки.Добавить("СНачалаГода", ОписаниеЧисла());
	Т.Колонки.Добавить("За12", ОписаниеЧисла());
	Т.Колонки.Добавить("МесяцевНачислений", ОписаниеЧисла());
	Т.Колонки.Добавить("ПоследнееНачисление");
	Т.Колонки.Добавить("Оплачено", ОписаниеЧисла());
	Т.Колонки.Добавить("ОплаченоГод", ОписаниеЧисла());
	Т.Колонки.Добавить("ПоследняяОплата");
	Т.Колонки.Добавить("СуммаПоследнейОплаты", ОписаниеЧисла());
	Т.Колонки.Добавить("Долг", ОписаниеЧисла());
	Т.Колонки.Добавить("Просрочено", ОписаниеЧисла());
	Т.Колонки.Добавить("МаксПросрочка", ОписаниеЧисла());
	Т.Колонки.Добавить("ДоговорДо");
	Источники = Новый Массив;
	Начало12 = ДобавитьМесяц(П.НачалоМесяца, -11);
	ДатаНачалаГода = НачалоГода(П.День);

	// 1. передача ОС в аренду и возврат из аренды
	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		ИмяНРег = НРег(МетаДокумента.Имя);
		Если СтрНайти(ИмяНРег, "аренд") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭтоПередача = СтрНайти(ИмяНРег, "передача") > 0 И СтрНайти(ИмяНРег, "варенду") > 0;
		ЭтоВозврат = СтрНайти(ИмяНРег, "возврат") > 0 И СтрНайти(ИмяНРег, "изаренды") > 0;
		Если НЕ ЭтоПередача И НЕ ЭтоВозврат Тогда
			Продолжить;
		КонецЕсли;
		РекКонтрагент = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Арендатор,Партнер");
		Если РекКонтрагент = "" Тогда
			Источники.Добавить(МетаДокумента.Синоним + ": нет реквизита-контрагента");
			Продолжить;
		КонецЕсли;
		РекДоговор = РеквизитКоллекции(МетаДокумента.Реквизиты, "Договор");
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Д.Ссылка КАК Ссылка,
			|	Д.Дата КАК Дата,
			|	Д." + РекКонтрагент + " КАК Арендатор,
			|	" + ?(РекДоговор = "", "НЕОПРЕДЕЛЕНО", "Д." + РекДоговор) + " КАК Договор
			|ИЗ
			|	Документ." + МетаДокумента.Имя + " КАК Д
			|ГДЕ
			|	Д.Проведен
			|	И Д.Дата <= &КонецДня" + ?(ЗначениеЗаполнено(П.Организация) И МетаДокумента.Реквизиты.Найти("Организация") <> Неопределено, "
			|	И Д.Организация = &Организация", "") + "
			|УПОРЯДОЧИТЬ ПО
			|	Д.Дата";
		УстановитьПараметры(Запрос, П);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Источники.Добавить(МетаДокумента.Синоним + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Документов = 0;
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.Арендатор) Тогда
				Продолжить;
			КонецЕсли;
			Документов = Документов + 1;
			Стр = СтрокаАрендатора(Т, Выборка.Арендатор);
			Если ЭтоПередача Тогда
				Стр.Передано = Выборка.Дата;
				Если ЗначениеЗаполнено(Выборка.Договор) Тогда
					Стр.Договор = Выборка.Договор;
				КонецЕсли;
				Объекты = ОбъектыДокументаАренды(Выборка.Ссылка, МетаДокумента);
				Если НЕ ПустаяСтрока(Объекты) Тогда
					Стр.Объекты = ?(ПустаяСтрока(Стр.Объекты), Объекты, Стр.Объекты + "; " + Объекты);
				КонецЕсли;
			Иначе
				Стр.Возвращено = Выборка.Дата;
			КонецЕсли;
		КонецЦикла;
		Источники.Добавить(МетаДокумента.Синоним + ": документов " + Документов);
	КонецЦикла;

	// 2. начисления аренды в реализациях
	Для Каждого ИмяДокумента Из СтрРазделить("РеализацияУслугПрочихАктивов,РеализацияТоваровУслуг,АктВыполненныхРабот", ",") Цикл
		МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РекКонтрагент = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Партнер");
		Если РекКонтрагент = "" Тогда
			Продолжить;
		КонецЕсли;
		РекДоговор = РеквизитКоллекции(МетаДокумента.Реквизиты, "Договор");
		Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
			Реквизиты = МетаТЧ.Реквизиты;
			Условия = Новый Массив;
			Для Каждого ИмяПоля Из СтрРазделить("Номенклатура,СтатьяДоходов,Услуга", ",") Цикл
				Если Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
					Условия.Добавить("Т." + ИмяПоля + ".Наименование ПОДОБНО &Аренда");
				КонецЕсли;
			КонецЦикла;
			Если Реквизиты.Найти("Содержание") <> Неопределено Тогда
				Условия.Добавить("ВЫРАЗИТЬ(Т.Содержание КАК СТРОКА(300)) ПОДОБНО &Аренда");
			КонецЕсли;
			ЕстьНДС = Реквизиты.Найти("СуммаНДС") <> Неопределено;
			Если Реквизиты.Найти("СуммаСНДС") <> Неопределено И ЕстьНДС Тогда
				ВыражениеСуммы = "Т.СуммаСНДС - Т.СуммаНДС";
			ИначеЕсли Реквизиты.Найти("Сумма") <> Неопределено Тогда
				ВыражениеСуммы = ?(ЕстьНДС И МетаДокумента.Реквизиты.Найти("ЦенаВключаетНДС") <> Неопределено,
					"ВЫБОР КОГДА Т.Ссылка.ЦенаВключаетНДС ТОГДА Т.Сумма - Т.СуммаНДС ИНАЧЕ Т.Сумма КОНЕЦ", "Т.Сумма");
			Иначе
				Продолжить;
			КонецЕсли;
			Если Условия.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Т.Ссылка." + РекКонтрагент + " КАК Арендатор,
				|	" + ?(РекДоговор = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекДоговор) + " КАК Договор,
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ) КАК Месяц,
				|	МАКСИМУМ(Т.Ссылка.Дата) КАК Последняя,
				|	СУММА(" + ВыражениеСуммы + ") КАК Сумма
				|ИЗ
				|	Документ." + ИмяДокумента + "." + МетаТЧ.Имя + " КАК Т
				|ГДЕ
				|	Т.Ссылка.Проведен
				|	И Т.Ссылка.Дата МЕЖДУ &Начало12 И &КонецДня
				|	И (" + СтрСоединить(Условия, " ИЛИ ") + ")" + ?(ЗначениеЗаполнено(П.Организация) И МетаДокумента.Реквизиты.Найти("Организация") <> Неопределено, "
				|	И Т.Ссылка.Организация = &Организация", "") + "
				|СГРУППИРОВАТЬ ПО
				|	Т.Ссылка." + РекКонтрагент + ",
				|	" + ?(РекДоговор = "", "", "Т.Ссылка." + РекДоговор + ",") + "
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ)";
			УстановитьПараметры(Запрос, П);
			Запрос.УстановитьПараметр("Аренда", "%аренд%");
			Запрос.УстановитьПараметр("Начало12", Начало12);
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Источники.Добавить(МетаДокумента.Синоним + "." + МетаТЧ.Имя + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Строк = 0;
			Пока Выборка.Следующий() Цикл
				Если НЕ ЗначениеЗаполнено(Выборка.Арендатор) Тогда
					Продолжить;
				КонецЕсли;
				Строк = Строк + 1;
				Стр = СтрокаАрендатора(Т, Выборка.Арендатор);
				Сумма = ЧислоИлиНоль(Выборка.Сумма);
				Если НЕ ЗначениеЗаполнено(Стр.Договор) И ЗначениеЗаполнено(Выборка.Договор) Тогда
					Стр.Договор = Выборка.Договор;
				КонецЕсли;
				Стр.За12 = Стр.За12 + Сумма;
				Стр.МесяцевНачислений = Стр.МесяцевНачислений + 1;
				Если Выборка.Месяц = П.НачалоМесяца Тогда
					Стр.Месяц = Стр.Месяц + Сумма;
				ИначеЕсли Выборка.Месяц = П.НачалоПрошлогоМесяца Тогда
					Стр.ПрошлыйМесяц = Стр.ПрошлыйМесяц + Сумма;
				КонецЕсли;
				Если Выборка.Месяц >= ДатаНачалаГода Тогда
					Стр.СНачалаГода = Стр.СНачалаГода + Сумма;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Стр.ПоследнееНачисление) ИЛИ Выборка.Последняя > Стр.ПоследнееНачисление Тогда
					Стр.ПоследнееНачисление = Выборка.Последняя;
				КонецЕсли;
			КонецЦикла;
			Если Строк > 0 Тогда
				Источники.Добавить(МетаДокумента.Синоним + " (" + МетаТЧ.Синоним + "): строк с арендой " + Строк);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Т.Количество() > 0 Тогда
		Арендаторы = Т.ВыгрузитьКолонку("Арендатор");

		// 3. оплаты арендаторов
		Для Каждого ИмяДокумента Из СтрРазделить("ПоступлениеБезналичныхДенежныхСредств,ПриходныйКассовыйОрдер", ",") Цикл
			МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
			Если МетаДокумента = Неопределено ИЛИ МетаДокумента.Реквизиты.Найти("СуммаДокумента") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			РекКонтрагент = РеквизитКоллекции(МетаДокумента.Реквизиты, "Контрагент,Плательщик,Партнер");
			Если РекКонтрагент = "" Тогда
				Продолжить;
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Д." + РекКонтрагент + " КАК Арендатор,
				|	Д.Дата КАК Дата,
				|	Д.СуммаДокумента КАК Сумма
				|ИЗ
				|	Документ." + ИмяДокумента + " КАК Д
				|ГДЕ
				|	Д.Проведен
				|	И Д.Дата МЕЖДУ &Начало12 И &КонецДня
				|	И Д." + РекКонтрагент + " В (&Арендаторы)
				|УПОРЯДОЧИТЬ ПО
				|	Д.Дата";
			УстановитьПараметры(Запрос, П);
			Запрос.УстановитьПараметр("Начало12", Начало12);
			Запрос.УстановитьПараметр("Арендаторы", Арендаторы);
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Источники.Добавить(МетаДокумента.Синоним + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Пока Выборка.Следующий() Цикл
				Стр = Т.Найти(Выборка.Арендатор, "Арендатор");
				Если Стр = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Сумма = ЧислоИлиНоль(Выборка.Сумма);
				Если Выборка.Дата >= П.НачалоМесяца Тогда
					Стр.Оплачено = Стр.Оплачено + Сумма;
				КонецЕсли;
				Если Выборка.Дата >= ДатаНачалаГода Тогда
					Стр.ОплаченоГод = Стр.ОплаченоГод + Сумма;
				КонецЕсли;
				Стр.ПоследняяОплата = Выборка.Дата;
				Стр.СуммаПоследнейОплаты = Сумма;
			КонецЦикла;
		КонецЦикла;

		// 4. долги и просрочка — из раздела «Долги»
		Если Долги <> Неопределено И Долги.НамДолжны <> Неопределено Тогда
			Для Каждого СтрДолга Из Долги.НамДолжны.ПоКонтрагентам Цикл
				Стр = Т.Найти(СтрДолга.Контрагент, "Арендатор");
				Если Стр <> Неопределено Тогда
					Стр.Долг = СтрДолга.Долг;
					Стр.Просрочено = СтрДолга.Просрочено;
					Стр.МаксПросрочка = СтрДолга.МаксПросрочка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// 5. срок договора
		Для Каждого Стр Из Т Цикл
			Стр.ДоговорДо = РеквизитСсылки(Стр.Договор, "ДатаОкончанияДействия,ДатаОкончания,СрокДействия");
		КонецЦикла;
	КонецЕсли;

	Т.Сортировать("Месяц Убыв, За12 Убыв");
	Р = Новый Структура;
	Р.Вставить("Таблица", Т);
	Р.Вставить("Источники", Источники);
	Р.Вставить("Месяц", Т.Итог("Месяц"));
	Р.Вставить("ПрошлыйМесяц", Т.Итог("ПрошлыйМесяц"));
	Р.Вставить("СНачалаГода", Т.Итог("СНачалаГода"));
	Р.Вставить("Оплачено", Т.Итог("Оплачено"));
	Р.Вставить("Долг", Т.Итог("Долг"));
	Р.Вставить("Просрочено", Т.Итог("Просрочено"));
	Р.Вставить("СПросрочкой", 0);
	Для Каждого Стр Из Т Цикл
		Если Стр.Просрочено > 0 Тогда
			Р.СПросрочкой = Р.СПросрочкой + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;

КонецФункции

&НаСервере
Функция СтрокаАрендатора(Т, Арендатор)

	Стр = Т.Найти(Арендатор, "Арендатор");
	Если Стр = Неопределено Тогда
		Стр = Т.Добавить();
		Стр.Арендатор = Арендатор;
	КонецЕсли;
	Возврат Стр;

КонецФункции

// Что передано в аренду: основные средства из табличной части документа (через запятую, до 5).
&НаСервере
Функция ОбъектыДокументаАренды(Ссылка, МетаДокумента)

	Для Каждого МетаТЧ Из МетаДокумента.ТабличныеЧасти Цикл
		ИмяПоля = РеквизитКоллекции(МетаТЧ.Реквизиты, "ОсновноеСредство,ОбъектЭксплуатации,ОС,Номенклатура");
		Если ИмяПоля = "" Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 6 Т." + ИмяПоля + " КАК Объект ИЗ Документ." + МетаДокумента.Имя + "." + МетаТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Имена = Новый Массив;
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Имена.Количество() = 5 Тогда
					Имена.Добавить("…");
					Прервать;
				КонецЕсли;
				Имена.Добавить(Строка(Выборка.Объект));
			КонецЦикла;
		Исключение
			Продолжить;
		КонецПопытки;
		Возврат СтрСоединить(Имена, ", ");
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Процедура ВывестиАренду(В, Р, П)

	ЗаголовокРаздела(В, "Арендаторы");
	Если ПоказатьОшибку(В, Р, "Аренда") Тогда
		Возврат;
	КонецЕсли;
	А = Р.Аренда;
	Если А.Таблица.Количество() = 0 Тогда
		Примечание(В, "Арендаторов не найдено: нет проведённых документов «Передача ОС в аренду» и реализаций со словом «аренд» в номенклатуре, содержании или статье доходов за 12 месяцев."
			+ ?(А.Источники.Количество() = 0, "", " Проверено: " + СтрСоединить(А.Источники, "; ") + "."));
		Возврат;
	КонецЕсли;
	НомерМесяца = Месяц(П.НачалоПрошлогоМесяца);
	Шапка(В, "Арендатор", "Начислено с 1-го", "В " + ИмяМесяца(НомерМесяца, Истина), "С начала года", "Оплачено с 1-го", "Долг", "Просрочено", "Последняя оплата");
	Для Каждого Стр Из А.Таблица Цикл
		Ячейка(В, 1, Строка(Стр.Арендатор), Истина, , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Месяц, , Истина);
		ЯчейкаЧисло(В, 3, Стр.ПрошлыйМесяц);
		ЯчейкаЧисло(В, 4, Стр.СНачалаГода);
		ЯчейкаЧисло(В, 5, Стр.Оплачено, ?(Стр.Оплачено > 0, ЦветХорошо(), Неопределено));
		ЯчейкаЧисло(В, 6, Стр.Долг);
		Если Стр.Просрочено > 0 Тогда
			Ячейка(В, 7, ФорматДенег(Стр.Просрочено) + Символы.ПС + "до " + Стр.МаксПросрочка + " дн.", Истина, ЦветКрит(), ФонКрит(), 9, , Истина);
			ВПраво(В, 7, 7);
		Иначе
			ЯчейкаЧисло(В, 7, 0);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ПоследняяОплата) Тогда
			Ячейка(В, 8, Формат(Стр.ПоследняяОплата, "ДФ=dd.MM.yy") + Символы.ПС + ДеньгиКратко(Стр.СуммаПоследнейОплаты), , , , 9, , Истина);
		Иначе
			Ячейка(В, 8, "нет за 12 мес.", , ЦветКрит(), , 9);
		КонецЕсли;
		ВПраво(В, 8, 8);
		РасшифровкаСтроки(В, Стр.Арендатор, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 26;
		СледующаяСтрока(В);

		// подробности одной строкой под арендатором
		Части = Новый Массив;
		Если ЗначениеЗаполнено(Стр.Договор) Тогда
			ТекстДоговора = "договор " + Строка(Стр.Договор);
			Если ЗначениеЗаполнено(Стр.ДоговорДо) И ТипЗнч(Стр.ДоговорДо) = Тип("Дата") Тогда
				Осталось = Цел((НачалоДня(Стр.ДоговорДо) - П.День) / 86400);
				ТекстДоговора = ТекстДоговора + " до " + Формат(Стр.ДоговорДо, "ДФ=dd.MM.yyyy")
					+ ?(Осталось < 0, " (истёк " + (-Осталось) + " дн. назад)", ?(Осталось <= 60, " (осталось " + Осталось + " дн.)", ""));
			КонецЕсли;
			Части.Добавить(ТекстДоговора);
		КонецЕсли;
		Если НЕ ПустаяСтрока(Стр.Объекты) Тогда
			Части.Добавить("арендует: " + Стр.Объекты);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Передано) Тогда
			Части.Добавить("передано " + Формат(Стр.Передано, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Возвращено) И (НЕ ЗначениеЗаполнено(Стр.Передано) ИЛИ Стр.Возвращено > Стр.Передано) Тогда
			Части.Добавить("возврат из аренды " + Формат(Стр.Возвращено, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если Стр.МесяцевНачислений > 0 Тогда
			Части.Добавить("в среднем " + ДеньгиКратко(Стр.За12 / Стр.МесяцевНачислений) + " в месяц (за " + Стр.МесяцевНачислений + " мес.)");
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ПоследнееНачисление) Тогда
			Части.Добавить("последнее начисление " + Формат(Стр.ПоследнееНачисление, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Части.Добавить("оплачено с начала года " + ДеньгиКратко(Стр.ОплаченоГод));
		Ячейка(В, 1, "      " + СтрСоединить(Части, "; "), , ЦветПриглушенный(), , 8, 8, Истина);
		ПодогнатьВысоту(В, СтрСоединить(Части, "; "), 150);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	Ячейка(В, 1, "Итого по арендаторам (" + А.Таблица.Количество() + ")", Истина, , ЦветФонаШапки());
	ЯчейкаЧисло(В, 2, А.Месяц, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 3, А.ПрошлыйМесяц, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 4, А.СНачалаГода, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 5, А.Оплачено, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 6, А.Долг, , Истина, ЦветФонаШапки());
	ЯчейкаЧисло(В, 7, А.Просрочено, ?(А.Просрочено > 0, ЦветКрит(), Неопределено), Истина, ЦветФонаШапки());
	Ячейка(В, 8, "", , , ЦветФонаШапки());
	Черта(В, 1, 8, 1, , Ложь);
	СледующаяСтрока(В);
	Примечание(В, "Начисления — строки реализаций без НДС, где в номенклатуре, содержании или статье доходов есть слово «аренд». "
		+ "Оплачено — все поступления от арендатора на счёт и в кассу. Долг и просрочка — общие по контрагенту из раздела «Долги» (если арендатор ещё и покупатель, туда входят и его покупки). "
		+ "Источники: " + СтрСоединить(А.Источники, "; ") + ".");

КонецПроцедуры

&НаСервере
Процедура ВывестиЗаказы(В, Р, П)

	ЗаголовокРаздела(В, "Заказы и отгрузки");
	Если ПоказатьОшибку(В, Р, "Заказы") Тогда
		Возврат;
	КонецЕсли;
	З = Р.Заказы;

	Новые = З.Новые.НайтиСтроки(Новый Структура("ЗаДень", Истина));
	Отгрузки = З.Отгрузки.НайтиСтроки(Новый Структура("ЗаДень", Истина));
	Шапка(В, "", "За " + Формат(П.День, "ДФ=dd.MM"), "", "С 1-го числа", "");
	Ячейка(В, 1, "Новые заказы, руб.");
	ЯчейкаЧисло(В, 2, СуммаСтрок(Новые));
	Ячейка(В, 3, Формат(Новые.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЯчейкаЧисло(В, 4, З.Новые.Итог("Сумма"));
	Ячейка(В, 5, Формат(З.Новые.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЛинияСнизу(В, 1, 5);
	СледующаяСтрока(В);
	Ячейка(В, 1, "Отгружено, руб.");
	ЯчейкаЧисло(В, 2, СуммаСтрок(Отгрузки));
	Ячейка(В, 3, Формат(Отгрузки.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЯчейкаЧисло(В, 4, З.Отгрузки.Итог("Сумма"));
	Ячейка(В, 5, Формат(З.Отгрузки.Количество(), "ЧН=0") + " шт.", , ЦветПриглушенный());
	ЛинияСнизу(В, 1, 5);
	СледующаяСтрока(В);

	СледующаяСтрока(В);
	Подзаголовок(В, "Портфель по продуктам");
	Шапка(В, "Продукт", "Заказов", "Осталось", "Сумма", "На складе", "Выпустить", "Выпуск в сутки", "Загрузка, сут.");
	Для Каждого Гр Из ГруппыНоменклатуры(З.Продукты, "Номенклатура", "Сумма") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Заказов:ч,3:Осталось:к,4:Сумма:ч,5:СоСклада:к,6:Выпустить:к,7:ВСутки:к", 8);
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаЧисло(В, 2, Стр.Заказов);
		ЯчейкаКоличество(В, 3, Стр.Осталось, Стр.Ед);
		ЯчейкаЧисло(В, 4, Стр.Сумма);
		ЯчейкаКоличество(В, 5, Стр.СоСклада, Стр.Ед);
		ЯчейкаКоличество(В, 6, Стр.Выпустить, Стр.Ед);
		ЯчейкаКоличество(В, 7, Стр.ВСутки, Стр.Ед);
		Ячейка(В, 8, ?(Стр.Загрузка = Неопределено, ?(Стр.Выпустить > 0, "нет выпуска", "—"), Формат(Стр.Загрузка, "ЧДЦ=1; ЧН=0")));
		ВПраво(В, 8, 8);
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Итого", , , З.Портфель);
	Примечание(В, "«На складе» — сколько из портфеля закрывается готовой продукцией. «Загрузка» — сколько суток работы при среднем выпуске последней недели нужно на остальное.");

	ВывестиСписокЗаказов(В, З.Просроченные, "Просроченные отгрузки");
	ВывестиСписокЗаказов(В, З.Ближайшие, "Отгрузить в ближайшие " + П.Горизонт + " дн.");

	Если Новые.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Новые заказы за день");
		Шапка(В, "Клиент", "", "", "Номер", "Срок отгрузки", "", "", "Сумма");
		Для Каждого Стр Из Новые Цикл
			Ячейка(В, 1, Строка(Стр.Клиент), , , , , 3, Истина);
			Ячейка(В, 4, Строка(Стр.Номер));
			Ячейка(В, 5, ?(ЗначениеЗаполнено(Стр.Срок), Формат(Стр.Срок, "ДФ=dd.MM.yy"), "—"));
			ЯчейкаЧисло(В, 8, Стр.Сумма);
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;
	Если Отгрузки.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Отгрузки за день");
		Шапка(В, "Клиент", "", "", "Номер", "", "", "", "Сумма");
		Для Каждого Стр Из Отгрузки Цикл
			Ячейка(В, 1, Строка(Стр.Клиент), , , , , 3, Истина);
			Ячейка(В, 4, Строка(Стр.Номер));
			ЯчейкаЧисло(В, 8, Стр.Сумма);
			РасшифровкаСтроки(В, Стр.Документ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиСписокЗаказов(В, Таблица, Название)

	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СледующаяСтрока(В);
	Подзаголовок(В, Название + " — " + Таблица.Количество() + " " + Склонение(Таблица.Количество(), "позиция", "позиции", "позиций"));
	Шапка(В, "Клиент / продукт", "Заказ", "Срок", "Осталось", "Со склада", "Статус", "", "Сумма");
	Для Каждого Стр Из Таблица Цикл
		Уровень = ?(СтрНайти(Стр.Покрытие, "просроч") > 0, 0, ?(Стр.Покрытие = "не успеваем", 1, 3));
		Ячейка(В, 1, Строка(Стр.Клиент) + Символы.ПС + Строка(Стр.Номенклатура), , , , 9, , Истина);
		Ячейка(В, 2, Строка(Стр.Номер));
		Ячейка(В, 3, ?(ЗначениеЗаполнено(Стр.Срок), Формат(Стр.Срок, "ДФ=dd.MM"), "—"));
		ЯчейкаКоличество(В, 4, Стр.Осталось, Стр.Ед);
		ЯчейкаКоличество(В, 5, Стр.СоСклада, Стр.Ед);
		Ячейка(В, 6, Стр.Покрытие + ?(Стр.Просрочка > 0, ", " + Стр.Просрочка + " дн.", ""), Истина,
			?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())), ?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())), 9, 7, Истина);
		ЯчейкаЧисло(В, 8, Стр.Сумма);
		РасшифровкаСтроки(В, Стр.Заказ, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиВыпуск(В, Р, П)

	ЗаголовокРаздела(В, "Выпуск продукции и план производства");
	Если ПоказатьОшибку(В, Р, "Выпуск") Тогда
		Возврат;
	КонецЕсли;
	Вып = Р.Выпуск;
	Примечание(В, "Источник: " + Вып.Источник + ". Последний выпуск в базе: "
		+ ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск), Формат(Вып.ПоследнийВыпуск, "ДФ=dd.MM.yyyy"), "нет") + "."
		+ ?(ЗначениеЗаполнено(Вып.ПоследнийВыпуск) И НачалоДня(Вып.ПоследнийВыпуск) < П.День - 86400,
			" Рапорты за последние дни ещё не введены — суточные цифры будут нулевыми.", ""));
	Если Вып.ПоПродуктам.Количество() = 0 Тогда
		Примечание(В, "За месяц нет ни выпуска, ни плана производства.");
		Возврат;
	КонецЕсли;
	ДнейВМесяце = День(КонецМесяца(П.День));
	ДоляМесяца = День(П.День) / ДнейВМесяце;

	Для Каждого Полуфабрикаты Из СтрРазделить("Нет,Да", ",") Цикл
		Строки = Вып.ПоПродуктам.НайтиСтроки(Новый Структура("Полуфабрикат", Полуфабрикаты = "Да"));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Полуфабрикаты = "Да" Тогда
			СледующаяСтрока(В);
			Подзаголовок(В, "Полуфабрикаты собственного производства");
			Шапка(В, "Полуфабрикат", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "За 7 дней", "В сутки (30 дн.)");
		Иначе
			Подзаголовок(В, "Продукция: план и факт месяца");
			Шапка(В, "Продукт", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "План месяца", "% плана", "Должно быть к дате", "Осталось выпустить", "План след. месяца");
		КонецЕсли;
		Для Каждого Гр Из ГруппыНоменклатуры(Строки, "Номенклатура", "ЗаМесяц") Цикл
		ВывестиСтрокуГруппы(В, Гр, ?(Полуфабрикаты = "Да", "2:ЗаДень:к,3:ЗаМесяц:к,4:За7Дней:к", "2:ЗаДень:к,3:ЗаМесяц:к,4:ПланМесяца:к,8:ПланСледующего:к"),
			?(Полуфабрикаты = "Да", 5, 8));
		Номер = 0;
		Для Каждого Стр Из Гр.Позиции Цикл
			Номер = Номер + 1;
			Если ПрерватьГруппу(В, Гр, Номер, 20) Тогда
				Прервать;
			КонецЕсли;
			ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
			ЯчейкаКоличество(В, 2, Стр.ЗаДень, Стр.Ед);
			ЯчейкаКоличество(В, 3, Стр.ЗаМесяц, Стр.Ед);
			Если Полуфабрикаты = "Да" Тогда
				ЯчейкаКоличество(В, 4, Стр.За7Дней, Стр.Ед);
				ЯчейкаКоличество(В, 5, Стр.За30Дней / 30, Стр.Ед);
				ЛинияСнизу(В, 1, 5);
			Иначе
				ЯчейкаКоличество(В, 4, Стр.ПланМесяца, Стр.Ед);
				Если Стр.ПланМесяца > 0 Тогда
					Процент = Стр.ЗаМесяц / Стр.ПланМесяца * 100;
					Отставание = Стр.ЗаМесяц < Стр.ПланМесяца * ДоляМесяца * 0.9;
					Ячейка(В, 5, Формат(Процент, "ЧДЦ=0; ЧН=0") + " %", Истина, ?(Процент >= 100, ЦветХорошо(), ?(Отставание, ЦветКрит(), Неопределено)));
					ВПраво(В, 5, 5);
					ЯчейкаКоличество(В, 6, Стр.ПланМесяца * ДоляМесяца, Стр.Ед);
					ЯчейкаКоличество(В, 7, Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц), Стр.Ед);
				Иначе
					Ячейка(В, 5, "вне плана", , ЦветПриглушенный());
					ВПраво(В, 5, 5);
				КонецЕсли;
				ЯчейкаКоличество(В, 8, Стр.ПланСледующего, Стр.Ед);
				ЛинияСнизу(В, 1, 8);
			КонецЕсли;
			РасшифровкаСтроки(В, Стр.Номенклатура, 8);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	СледующаяСтрока(В);
	Подзаголовок(В, "Итого продукции по единицам измерения");
	Шапка(В, "Единица", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "План месяца", "% плана", "В сутки (30 дн.)", "Нужно в сутки до конца месяца");
	Для Каждого Стр Из Вып.ПоЕдиницам Цикл
		Ячейка(В, 1, ?(ЗначениеЗаполнено(Стр.Ед), Стр.Ед, "без единицы"));
		ЯчейкаКоличество(В, 2, Стр.ЗаДень, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ЗаМесяц, Стр.Ед);
		ЯчейкаКоличество(В, 4, Стр.ПланМесяца, Стр.Ед);
		Ячейка(В, 5, ?(Стр.ПланМесяца = 0, "—", Формат(Стр.ЗаМесяц / Стр.ПланМесяца * 100, "ЧДЦ=0; ЧН=0") + " %"));
		ВПраво(В, 5, 5);
		ЯчейкаКоличество(В, 6, Стр.За30Дней / 30, Стр.Ед);
		Если Стр.ПланМесяца > 0 И Вып.ОсталосьДней > 0 Тогда
			ЯчейкаКоличество(В, 7, Макс(0, Стр.ПланМесяца - Стр.ЗаМесяц) / Вып.ОсталосьДней, Стр.Ед);
		КонецЕсли;
		ЛинияСнизу(В, 1, 7);
		СледующаяСтрока(В);
	КонецЦикла;
	Если НЕ Вып.ЕстьПланПроизводства Тогда
		Примечание(В, "Документов «План производства» на этот месяц не найдено" + ?(П.ПланВСутки > 0, "; план взят из настройки «План выпуска в сутки».", "."));
	Иначе
		Примечание(В, "План — из проведённых документов «План производства» (отменённые и замещённые строки не учитываются; если продукт на одну дату есть в нескольких планах, берётся последний).");
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Выпуск по дням за 30 суток, " + Вып.ГлавнаяЕд);
	Точки = Новый Массив;
	Факт = Новый Массив;
	План = Новый Массив;
	Для Каждого Стр Из Вып.История Цикл
		Точки.Добавить(Формат(Стр.Дата, "ДФ=dd.MM"));
		Факт.Добавить(Стр.Количество);
		План.Добавить(Вып.План);
	КонецЦикла;
	Серии = Новый Массив;
	Серии.Добавить(Новый Структура("Имя, Значения", "Выпуск за сутки", Факт));
	Если Вып.План > 0 Тогда
		Серии.Добавить(Новый Структура("Имя, Значения", "План в среднем за сутки", План));
	КонецЕсли;
	ВывестиГрафик(В, Точки, Серии, 12);

КонецПроцедуры

&НаСервере
Процедура СтрокаПлана(В, Название, План, Факт)

	Процент = ?(План = 0, 0, Факт / План * 100);
	Ячейка(В, 1, Название);
	ЯчейкаЧисло(В, 2, План);
	ЯчейкаЧисло(В, 3, Факт);
	Ячейка(В, 4, Формат(Процент, "ЧДЦ=0; ЧН=0") + " %", Истина, ?(Процент >= 100, ЦветХорошо(), ?(Процент >= 90, ЦветВнимание(), ЦветКрит())));
	ВПраво(В, 4, 4);
	ЛинияСнизу(В, 1, 4);
	СледующаяСтрока(В);

КонецПроцедуры

&НаСервере
Процедура ВывестиСырье(В, Р, П)

	ЗаголовокРаздела(В, "Сырьё и нехватка");
	Если ПоказатьОшибку(В, Р, "Сырье") Тогда
		Возврат;
	КонецЕсли;
	С = Р.Сырье;
	Если С.Материалы.Количество() = 0 Тогда
		Примечание(В, "Не найдено сырья: за 30 дней ничего не списывалось в производство. Укажите группу сырья в настройках отчёта.");
		Возврат;
	КонецЕсли;
	Если С.Свойство("Скрыто") И С.Скрыто > 0 Тогда
		Примечание(В, "Показано основное сырьё — позиции, на которые приходится 90 % затрат на сырьё. Мелкие позиции (" + С.Скрыто + ") скрыты.");
	КонецЕсли;
	ВсегоРасход = 0;
	Для Каждого Стр Из С.Материалы Цикл
		ВсегоРасход = ВсегоРасход + Стр.ВСутки;
	КонецЦикла;
	Если ВсегоРасход = 0 Тогда
		Примечание(В, "За 30 дней в суточных рапортах (" + СтрСоединить(С.Документы, ", ") + ") не списывалось сырьё со статьями калькуляции «"
			+ П.СтатьиСырья + "». Проверьте настройку «Статьи калькуляции основного сырья».");
		Возврат;
	КонецЕсли;
	Шапка(В, "Материал", "Остаток", "Расход в сутки", "Хватит, дней", "В пути", "Поставка", "Статус", "Заказать");
	Для Каждого Гр Из ГруппыНоменклатуры(С.Материалы, "Номенклатура") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Остаток:к,3:ВСутки:к,5:ВПути:к", 8);
	Для Каждого Стр Из Гр.Позиции Цикл
		Уровень = ?(Стр.Статус = "нехватка", 0, ?(Стр.Статус = "заказать", 1, 3));
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура) + ?(ЗначениеЗаполнено(Стр.Пояснение), Символы.ПС + "      " + Стр.Пояснение, ""));
		ЯчейкаКоличество(В, 2, Стр.Остаток, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ВСутки, Стр.Ед);
		Ячейка(В, 4, ?(Стр.ВСутки <= 0, "—", Формат(Стр.ХватитДней, "ЧДЦ=1; ЧН=0")
			+ ?(Стр.ВПути > 0, " (" + Формат(Стр.ХватитСПоставкой, "ЧДЦ=1; ЧН=0") + ")", "")));
		ВПраво(В, 4, 4);
		ЯчейкаКоличество(В, 5, Стр.ВПути, Стр.Ед);
		Ячейка(В, 6, ?(ЗначениеЗаполнено(Стр.ДатаПоставки), Формат(Стр.ДатаПоставки, "ДФ=dd.MM"), "—"));
		ВПраво(В, 6, 6);
		Ячейка(В, 7, Стр.Статус, Истина, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())),
			?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())));
		Цена = ?(Р.Закупки = Неопределено, 0, ЧислоИлиНоль(Р.Закупки.Цены[Стр.Номенклатура]));
		Если Стр.Заказать > 0 И Цена > 0 Тогда
			Ячейка(В, 8, ФорматЧисла(Стр.Заказать) + " " + Стр.Ед + Символы.ПС + "≈ " + ДеньгиКратко(Стр.Заказать * Цена), , , , 9, , Истина);
			ВПраво(В, 8, 8);
		Иначе
			ЯчейкаКоличество(В, 8, Стр.Заказать, Стр.Ед);
		КонецЕсли;
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = ?(ЗначениеЗаполнено(Стр.Пояснение), 26, 14);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Примечание(В, СтрШаблон("Расход — среднее списание в производство за 30 дней по суточным рапортам. «Хватит» в скобках — вместе с поставкой в пути (заказы поставщикам). "
		+ "Нехватка — кончится раньше поставки или запаса меньше срока поставки (%1 дн.). «Заказать» — на срок поставки плюс %2 дн.", П.СрокПоставки, П.Горизонт));

КонецПроцедуры

#КонецОбласти

#Область ВыводАналитики

&НаСервере
Процедура ВывестиПродажи(В, Р, П)

	ЗаголовокРаздела(В, "Продажи и маржа");
	Если ПоказатьОшибку(В, Р, "Продажи") Тогда
		Возврат;
	КонецЕсли;
	Пр = Р.Продажи;
	НомерМесяца = Месяц(П.НачалоПрошлогоМесяца);
	Если Пр.Месяц = 0 И Пр.ПрошлыйМесяц = 0 Тогда
		Примечание(В, "Продаж за два месяца не найдено (" + Пр.Источник + "). Проверьте организацию в настройках или пришлите файл диагностики.");
		Возврат;
	КонецЕсли;

	Шапка(В, "Выручка без НДС", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "То же в прошлом мес.", "Изменение", "Весь " + ИмяМесяца(НомерМесяца, Ложь));
	Ячейка(В, 1, "Отгрузки покупателям");
	ЯчейкаЧисло(В, 2, Пр.ЗаДень);
	ЯчейкаЧисло(В, 3, Пр.Месяц, , Истина);
	ЯчейкаЧисло(В, 4, Пр.ПрошлыйПериод);
	ЯчейкаПроцента(В, 5, Пр.Изменение);
	ЯчейкаЧисло(В, 6, Пр.ПрошлыйМесяц);
	ЛинияСнизу(В, 1, 6);
	СледующаяСтрока(В);
	Примечание(В, "Источник: " + Пр.Источник + ". «То же в прошлом месяце» — с 1-го по " + Формат(П.КонецПрошлогоПериода, "ДФ='d MMMM'") + ": сравнение равных отрезков.");

	СледующаяСтрока(В);
	Подзаголовок(В, "По группам номенклатуры с начала месяца");
	Шапка(В, "Группа / номенклатура", "Количество", "Выручка", "Доля", "Средняя цена", "Цена в " + ИмяМесяца(НомерМесяца, Истина), "Изм. цены", "Выручка за то же в прошл.");
	Группы = ГруппыПродаж(Пр.ПоНоменклатуре);
	Для Каждого Гр Из Группы Цикл
		Фон = Новый Цвет(226, 240, 238);
		Ячейка(В, 1, Строка(Гр.Группа) + " (" + Гр.Позиции.Количество() + ")", Истина, ЦветАкцент(), Фон, , , Истина);
		Если ЗначениеЗаполнено(Гр.Ед) Тогда
			Ячейка(В, 2, ФорматЧисла(Гр.Количество) + " " + Гр.Ед, Истина, , Фон);
		Иначе
			Ячейка(В, 2, "разные ед.", , ЦветПриглушенный(), Фон);
		КонецЕсли;
		ВПраво(В, 2, 2);
		ЯчейкаЧисло(В, 3, Гр.Сумма, , Истина, Фон);
		Ячейка(В, 4, ?(Пр.Месяц = 0, "—", Формат(Гр.Сумма / Пр.Месяц * 100, "ЧДЦ=1; ЧН=0") + " %"), Истина, , Фон);
		ВПраво(В, 4, 4);
		Ячейка(В, 5, ?(Гр.Цена = 0, "", ФорматДенег(Гр.Цена)), Истина, , Фон);
		ВПраво(В, 5, 5);
		Ячейка(В, 6, ?(Гр.ЦенаПрошлМесяц = 0, "", ФорматДенег(Гр.ЦенаПрошлМесяц)), , , Фон);
		ВПраво(В, 6, 6);
		Если Гр.ИзмЦены = Неопределено Тогда
			Ячейка(В, 7, "", , , Фон);
		Иначе
			Ячейка(В, 7, ?(Гр.ИзмЦены > 0, "+", "") + Формат(Гр.ИзмЦены, "ЧДЦ=1; ЧН=0") + " %", Истина, ?(Гр.ИзмЦены > 0, ЦветХорошо(), ?(Гр.ИзмЦены < 0, ЦветКрит(), Неопределено)), Фон);
		КонецЕсли;
		ВПраво(В, 7, 7);
		ЯчейкаЧисло(В, 8, Гр.СуммаПрошл, , Истина, Фон);
		РасшифровкаСтроки(В, Гр.Группа, 8);
		СледующаяСтрока(В);
		Номер = 0;
		Для Каждого Стр Из Гр.Позиции Цикл
			Номер = Номер + 1;
			Если Номер > 15 Тогда
				Ячейка(В, 1, "      …и ещё " + (Гр.Позиции.Количество() - 15) + " поз. на " + ДеньгиКратко(Гр.СуммаОстальных), , ЦветПриглушенный(), , 8, 8);
				СледующаяСтрока(В);
				Прервать;
			КонецЕсли;
			Ячейка(В, 1, "      " + Строка(Стр.Ключ), , , , 8, , Истина);
			ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
			ЯчейкаЧисло(В, 3, Стр.Сумма);
			ЯчейкаПроцента(В, 4, ?(Пр.Месяц = 0, Неопределено, Стр.Сумма / Пр.Месяц * 100), Ложь);
			ЯчейкаЧисло(В, 5, Стр.Цена);
			ЯчейкаЧисло(В, 6, Стр.ЦенаПрошлМесяц);
			ЯчейкаПроцента(В, 7, Стр.ИзмЦены);
			ЯчейкаЧисло(В, 8, Стр.СуммаПрошл);
			РасшифровкаСтроки(В, Стр.Ключ, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Итого", , Пр.Месяц);
	Примечание(В, "Группа — папка справочника «Номенклатура», в которой лежит позиция (если папки нет — вид номенклатуры). "
		+ "Двойной щелчок по строке группы открывает папку, по позиции — карточку номенклатуры. Количество группы показано, если у всех позиций одна единица.");

	СледующаяСтрока(В);
	Подзаголовок(В, "Крупнейшие покупатели с начала месяца");
	Шапка(В, "Покупатель", "Выручка", "Доля", "То же в прошл. мес.", "Изменение");
	Номер = 0;
	Для Каждого Стр Из Пр.ПоКонтрагентам Цикл
		Номер = Номер + 1;
		Если Номер > 10 ИЛИ Стр.Сумма = 0 Тогда
			Прервать;
		КонецЕсли;
		Ячейка(В, 1, Строка(Стр.Ключ), , , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Сумма);
		ЯчейкаПроцента(В, 3, ?(Пр.Месяц = 0, Неопределено, Стр.Сумма / Пр.Месяц * 100), Ложь);
		ЯчейкаЧисло(В, 4, Стр.СуммаПрошл);
		ЯчейкаПроцента(В, 5, ?(Стр.СуммаПрошл = 0, Неопределено, (Стр.Сумма / Стр.СуммаПрошл - 1) * 100));
		РасшифровкаСтроки(В, Стр.Ключ, 5);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;
	Пропавшие = Новый Массив;
	Для Каждого Стр Из Пр.ПоКонтрагентам Цикл
		Если Стр.Сумма = 0 И Стр.СуммаПрошлМесяц >= 500000 И Пропавшие.Количество() < 8 Тогда
			Пропавшие.Добавить(Строка(Стр.Ключ) + " (" + ДеньгиКратко(Стр.СуммаПрошлМесяц) + ")");
		КонецЕсли;
	КонецЦикла;
	Если Пропавшие.Количество() > 0 Тогда
		Примечание(В, "В прошлом месяце покупали, в этом ещё нет: " + СтрСоединить(Пропавшие, ", ") + ".");
	КонецЕсли;

	// прибыль по прямым затратам
	СледующаяСтрока(В);
	Если Р.Маржа = Неопределено Тогда
		Примечание(В, "Прибыль по прямым затратам не посчитана: " + ?(Р.Ошибки["Маржа"] = Неопределено, "нет данных", Р.Ошибки["Маржа"]));
		Возврат;
	КонецЕсли;
	Если Р.Маржа.СебестоимостьПрошлого = 0 Тогда
		Примечание(В, "Прибыль по прямым затратам не показана: себестоимость продаж за " + ИмяМесяца(НомерМесяца, Ложь)
			+ " в ERP не рассчитана. Она появится после закрытия месяца (Финансовый результат и контроллинг → Закрытие месяца).");
		Возврат;
	КонецЕсли;
	ВывестиМаржу(В, Р.Маржа.Прошлый, "Прибыль по прямым затратам за " + ИмяМесяца(НомерМесяца, Ложь));
	Если Р.Маржа.СебестоимостьТекущего > 0 Тогда
		СледующаяСтрока(В);
		ВывестиМаржу(В, Р.Маржа.Текущий, "Прибыль по прямым затратам с начала месяца");
	Иначе
		Примечание(В, "Себестоимость текущего месяца ERP рассчитывает при закрытии месяца, поэтому прибыль показана за прошлый месяц.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиМаржу(В, Т, Название)

	Подзаголовок(В, Название);
	Если Т.Количество() = 0 Тогда
		Примечание(В, "Нет данных о выручке и себестоимости за этот период.");
		Возврат;
	КонецЕсли;
	Шапка(В, "Номенклатура", "Выручка без НДС", "Прямые затраты", "Прибыль по прямым", "Рентабельность");
	Для Каждого Гр Из ГруппыНоменклатуры(Т, "Номенклатура", "Выручка") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Выручка:ч,3:Прямые:ч,4:Прибыль:ч", 5);
	ВыручкаГруппы = 0;
	ПрибыльГруппы = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		ВыручкаГруппы = ВыручкаГруппы + ЧислоИлиНоль(Стр.Выручка);
		ПрибыльГруппы = ПрибыльГруппы + ЧислоИлиНоль(Стр.Прибыль);
	КонецЦикла;
	В.Строка = В.Строка - 1;
	Ячейка(В, 5, ?(ВыручкаГруппы = 0, "—", Формат(ПрибыльГруппы / ВыручкаГруппы * 100, "ЧДЦ=1; ЧН=0") + " %"), Истина, , Новый Цвет(226, 240, 238));
	ВПраво(В, 5, 5);
	В.Строка = В.Строка + 1;
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		Уровень = ?(Стр.Рентабельность = Неопределено, -1, ?(Стр.Рентабельность < 0, 0, ?(Стр.Рентабельность < 10, 1, -1)));
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаЧисло(В, 2, Стр.Выручка);
		ЯчейкаЧисло(В, 3, Стр.Прямые);
		ЯчейкаЧисло(В, 4, Стр.Прибыль, ?(Стр.Прибыль < 0, ЦветКрит(), Неопределено));
		ЯчейкаПроцента(В, 5, Стр.Рентабельность, Ложь, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), Неопределено)));
		РасшифровкаСтроки(В, Стр.Номенклатура, 5);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Выручка = Т.Итог("Выручка");
	Прибыль = Т.Итог("Прибыль");
	СтрокаИтога(В, "Итого", Выручка, Т.Итог("Прямые"), Прибыль);
	В.Строка = В.Строка - 1;
	Ячейка(В, 5, ?(Выручка = 0, "—", Формат(Прибыль / Выручка * 100, "ЧДЦ=1; ЧН=0") + " %"), Истина, , ЦветФонаШапки());
	ВПраво(В, 5, 5);
	В.Строка = В.Строка + 1;
	Косвенные = Т.Итог("Косвенные");
	Примечание(В, "Прямые затраты — материалы, доп. расходы, трудозатраты и переменные статьи затрат, вошедшие в себестоимость проданного. "
		+ "Косвенные (постоянные статьи, распределённые на продукцию) сюда не входят: за период " + ДеньгиКратко(Косвенные)
		+ "; прибыль после них " + ДеньгиКратко(Прибыль - Косвенные) + ".");

КонецПроцедуры

&НаСервере
Процедура ВывестиЗакупки(В, Р, П)

	ЗаголовокРаздела(В, "Закупки и цены сырья");
	Если ПоказатьОшибку(В, Р, "Закупки") Тогда
		Возврат;
	КонецЕсли;
	З = Р.Закупки;
	НомерМесяца = Месяц(П.НачалоПрошлогоМесяца);
	Шапка(В, "Поступления без НДС", "За " + Формат(П.День, "ДФ=dd.MM"), "С 1-го числа", "То же в прошлом мес.", "Изменение", "Весь " + ИмяМесяца(НомерМесяца, Ложь));
	Ячейка(В, 1, "Закуплено у поставщиков");
	ЯчейкаЧисло(В, 2, З.ЗаДень);
	ЯчейкаЧисло(В, 3, З.Месяц, , Истина);
	ЯчейкаЧисло(В, 4, З.ПрошлыйПериод);
	ЯчейкаПроцента(В, 5, З.Изменение);
	ЯчейкаЧисло(В, 6, З.ПрошлыйМесяц);
	ЛинияСнизу(В, 1, 6);
	СледующаяСтрока(В);

	СледующаяСтрока(В);
	Подзаголовок(В, "Основное сырьё: что и почём покупаем (с начала месяца и в прошлом месяце)");
	Шапка(В, "Номенклатура", "Количество", "Сумма", "Средняя цена", "Цена в " + ИмяМесяца(НомерМесяца, Истина), "Изм. цены", "Кол-во в " + ИмяМесяца(НомерМесяца, Истина));
	Для Каждого Гр Из ГруппыНоменклатуры(З.ПоНоменклатуре, "Ключ", "Сумма") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Количество:к,3:Сумма:ч,7:КоличествоПрошлМесяц:к", 7);
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		Рост = Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены >= 5;
		ЯчейкаПозиции(В, Строка(Стр.Ключ));
		ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
		ЯчейкаЧисло(В, 3, Стр.Сумма);
		ЯчейкаЧисло(В, 4, Стр.Цена);
		ЯчейкаЧисло(В, 5, Стр.ЦенаПрошлМесяц);
		ЯчейкаПроцента(В, 6, Стр.ИзмЦены, Истина, ?(Рост, ЦветКрит(), ?(Стр.ИзмЦены <> Неопределено И Стр.ИзмЦены <= -5, ЦветХорошо(), Неопределено)), Ложь);
		ЯчейкаКоличество(В, 7, Стр.КоличествоПрошлМесяц, Стр.Ед);
		РасшифровкаСтроки(В, Стр.Ключ, 7);
		ЛинияСнизу(В, 1, 7);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Примечание(В, "Изменение цены — средняя цена этого месяца к средней цене прошлого. Красным — подорожание от 5 %, зелёным — подешевление от 5 %.");

	СледующаяСтрока(В);
	Подзаголовок(В, "Крупнейшие поставщики с начала месяца");
	Шапка(В, "Поставщик", "Сумма", "Доля", "То же в прошл. мес.", "Изменение");
	Номер = 0;
	Для Каждого Стр Из З.ПоКонтрагентам Цикл
		Номер = Номер + 1;
		Если Номер > 10 ИЛИ Стр.Сумма = 0 Тогда
			Прервать;
		КонецЕсли;
		Ячейка(В, 1, Строка(Стр.Ключ), , , , , , Истина);
		ЯчейкаЧисло(В, 2, Стр.Сумма);
		ЯчейкаПроцента(В, 3, ?(З.Месяц = 0, Неопределено, Стр.Сумма / З.Месяц * 100), Ложь);
		ЯчейкаЧисло(В, 4, Стр.СуммаПрошл);
		ЯчейкаПроцента(В, 5, ?(Стр.СуммаПрошл = 0, Неопределено, (Стр.Сумма / Стр.СуммаПрошл - 1) * 100));
		РасшифровкаСтроки(В, Стр.Ключ, 5);
		ЛинияСнизу(В, 1, 5);
		СледующаяСтрока(В);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиЗапасы(В, Р, П)

	ЗаголовокРаздела(В, "Запасы готовой продукции");
	Если ПоказатьОшибку(В, Р, "Запасы") Тогда
		Возврат;
	КонецЕсли;
	Шапка(В, "Продукт", "Остаток", "Стоимость по цене продажи", "Отгрузки в сутки", "Дней запаса", "В заказах", "Статус");
	Для Каждого Гр Из ГруппыНоменклатуры(Р.Запасы.Таблица, "Номенклатура", "Стоимость") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Остаток:к,3:Стоимость:ч,4:ОтгрузкиВСутки:к,6:ВЗаказах:к", 7);
	Для Каждого Стр Из Гр.Позиции Цикл
		Уровень = ?(Стр.Статус = "мало", 0, ?(Стр.Статус = "в норме", 3, 1));
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаКоличество(В, 2, Стр.Остаток, Стр.Ед);
		ЯчейкаЧисло(В, 3, Стр.Стоимость);
		ЯчейкаКоличество(В, 4, Стр.ОтгрузкиВСутки, Стр.Ед);
		Ячейка(В, 5, ?(Стр.ОтгрузкиВСутки = 0, "—", Формат(Стр.ДнейЗапаса, "ЧДЦ=1; ЧН=0")));
		ВПраво(В, 5, 5);
		ЯчейкаКоличество(В, 6, Стр.ВЗаказах, Стр.Ед);
		Ячейка(В, 7, Стр.Статус, Истина, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), ЦветХорошо())),
			?(Уровень = 0, ФонКрит(), ?(Уровень = 1, ФонВнимание(), ФонХорошо())), , 8);
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	Если Р.Запасы.Прочие.Количество > 0 Тогда
		Ячейка(В, 1, "Прочие мелкие позиции: " + Р.Запасы.Прочие.Количество, , ЦветПриглушенный());
		ЯчейкаЧисло(В, 3, Р.Запасы.Прочие.Стоимость, ЦветПриглушенный());
		СледующаяСтрока(В);
	КонецЕсли;
	СтрокаИтога(В, "Всего готовой продукции", , Р.Запасы.Всего);
	Примечание(В, "Показаны крупные позиции (до 12, от 2 % стоимости запаса). Отгрузки в сутки — среднее за 30 дней по реализациям. «Мало» — запаса меньше чем на 3 дня и заказов больше остатка; «затоваривание» — запаса больше чем на 45 дней.");

КонецПроцедуры

&НаСервере
Процедура ЯчейкаПроцента(В, Колонка, Значение, СоЗнаком = Истина, ЦвТекста = Неопределено, Раскрашивать = Истина)

	Если Значение = Неопределено Тогда
		Ячейка(В, Колонка, "—", , ЦветПриглушенный());
	Иначе
		Цвет = ЦвТекста;
		Если Цвет = Неопределено И СоЗнаком И Раскрашивать Тогда
			Цвет = ?(Значение > 0, ЦветХорошо(), ?(Значение < 0, ЦветКрит(), Неопределено));
		КонецЕсли;
		Ячейка(В, Колонка, ?(СоЗнаком И Значение > 0, "+", "") + Формат(Значение, "ЧДЦ=1; ЧН=0") + " %", , Цвет);
	КонецЕсли;
	ВПраво(В, Колонка, Колонка);

КонецПроцедуры

&НаСервере
Функция ИмяМесяца(НомерМесяца, Предложный)

	Если Предложный Тогда
		Имена = СтрРазделить("январе,феврале,марте,апреле,мае,июне,июле,августе,сентябре,октябре,ноябре,декабре", ",");
	Иначе
		Имена = СтрРазделить("январь,февраль,март,апрель,май,июнь,июль,август,сентябрь,октябрь,ноябрь,декабрь", ",");
	КонецЕсли;
	Возврат Имена[НомерМесяца - 1];

КонецФункции

&НаСервере
Процедура ВывестиПотребность(В, Р, П)

	ЗаголовокРаздела(В, "Основное сырьё на план производства");
	Если ПоказатьОшибку(В, Р, "Потребность") Тогда
		Возврат;
	КонецЕсли;
	Пт = Р.Потребность;
	Примечание(В, ?(Пт.ЕстьПлан, "План — из документов «План производства»: остаток плана этого месяца (план минус уже выпущенное) и план следующего месяца.",
		"Документов «План производства» нет, поэтому план оценён по выпуску последних 30 дней.")
		+ " Нормы — из ресурсных спецификаций (та, что указана в плане, иначе последняя из суточных рапортов); количества пересчитаны в базовые единицы, полуфабрикаты разложены до сырья."
		+ " Сырьё — статьи калькуляции «" + П.СтатьиСырья + "».");

	Если Пт.Таблица.Количество() = 0 Тогда
		Примечание(В, "Потребность не посчитана: для продукции плана не нашлось спецификаций с основным сырьём.");
	Иначе
		Шапка(В, "Сырьё", "На остаток плана месяца", "На план след. месяца", "Остаток на складах", "В пути", "Не хватит в этом месяце", "Не хватит на 2 месяца", "Докупить на сумму");
		Для Каждого Гр Из ГруппыНоменклатуры(Пт.Таблица, "Номенклатура", "СуммаДокупки") Цикл
		ВывестиСтрокуГруппы(В, Гр, "2:ОстатокПлана:к,3:ПланСледующего:к,4:Остаток:к,5:ВПути:к,8:СуммаДокупки:ч", 8);
		Для Каждого Стр Из Гр.Позиции Цикл
			ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
			ЯчейкаКоличество(В, 2, Стр.ОстатокПлана, Стр.Ед);
			ЯчейкаКоличество(В, 3, Стр.ПланСледующего, Стр.Ед);
			ЯчейкаКоличество(В, 4, Стр.Остаток, Стр.Ед);
			ЯчейкаКоличество(В, 5, Стр.ВПути, Стр.Ед);
			Если Стр.НехваткаМесяц > 0 Тогда
				Ячейка(В, 6, ФорматЧисла(Стр.НехваткаМесяц) + " " + Стр.Ед, Истина, ЦветКрит(), ФонКрит());
			Иначе
				Ячейка(В, 6, "хватает", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 6, 6);
			Если Стр.НехваткаДвухМесяцев > 0 Тогда
				Ячейка(В, 7, ФорматЧисла(Стр.НехваткаДвухМесяцев) + " " + Стр.Ед, Истина, ЦветВнимание(), ФонВнимание());
			Иначе
				Ячейка(В, 7, "хватает", , ЦветХорошо());
			КонецЕсли;
			ВПраво(В, 7, 7);
			Если Стр.СуммаДокупки > 0 Тогда
				ЯчейкаЧисло(В, 8, Стр.СуммаДокупки, , Истина);
			ИначеЕсли Стр.НехваткаДвухМесяцев > 0 Тогда
				Ячейка(В, 8, "нет цены", , ЦветПриглушенный());
				ВПраво(В, 8, 8);
			КонецЕсли;
			РасшифровкаСтроки(В, Стр.Номенклатура, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
		СтрокаИтога(В, "Докупить сырья на 2 месяца", , , , );
		В.Строка = В.Строка - 1;
		Для К = 2 По 7 Цикл
			Ячейка(В, К, "", , , ЦветФонаШапки());
		КонецЦикла;
		ЯчейкаЧисло(В, 8, Пт.СуммаДокупки, , Истина, ЦветФонаШапки());
		В.Строка = В.Строка + 1;
		Примечание(В, "Сумма — по последней цене закупки без НДС.");
	КонецЕсли;

	СледующаяСтрока(В);
	Подзаголовок(В, "Продукция плана: на что считается сырьё");
	Шапка(В, "Продукт", "Остаток плана месяца", "План след. месяца", "Спецификация");
	Для Каждого Гр Из ГруппыНоменклатуры(Пт.План, "Номенклатура", "ОстатокПлана") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:ОстатокПлана:к,3:ПланСледующего:к", 8);
	Для Каждого Стр Из Гр.Позиции Цикл
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаКоличество(В, 2, Стр.ОстатокПлана, Стр.Ед);
		ЯчейкаКоличество(В, 3, Стр.ПланСледующего, Стр.Ед);
		Если Стр.Нормы = Неопределено Тогда
			Ячейка(В, 4, Стр.ИсточникНорм, , ЦветКрит(), , 9, 8);
		Иначе
			Ячейка(В, 4, Строка(Стр.Спецификация), , ЦветПриглушенный(), , 9, 8);
		КонецЕсли;
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;

	Если Пт.Затраты.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Основное сырьё в себестоимости продукта (нормы спецификации × последние цены закупки)");
		Шапка(В, "Продукт", "Сырьё на 1 ед.", "Цена продажи", "Доля сырья", "После сырья", "Главное сырьё в стоимости");
		Для Каждого Гр Из ГруппыНоменклатуры(Пт.Затраты, "Номенклатура") Цикл
		ВывестиСтрокуГруппы(В, Гр, "", 8);
		Для Каждого Стр Из Гр.Позиции Цикл
			Уровень = ?(Стр.Доля = Неопределено, -1, ?(Стр.Доля >= 90, 0, ?(Стр.Доля >= 70, 1, -1)));
			ЯчейкаПозиции(В, Строка(Стр.Номенклатура) + ?(ЗначениеЗаполнено(Стр.Ед), ", за 1 " + Стр.Ед, ""));
			ЯчейкаЧисло(В, 2, Стр.НаЕдиницу);
			ЯчейкаЧисло(В, 3, Стр.ЦенаПродажи);
			ЯчейкаПроцента(В, 4, Стр.Доля, Ложь, ?(Уровень = 0, ЦветКрит(), ?(Уровень = 1, ЦветВнимание(), Неопределено)));
			Если Стр.ЦенаПродажи > 0 Тогда
				ЯчейкаЧисло(В, 5, Стр.ЦенаПродажи - Стр.НаЕдиницу, ?(Стр.ЦенаПродажи < Стр.НаЕдиницу, ЦветКрит(), Неопределено));
			КонецЕсли;
			Ячейка(В, 6, Строка(Стр.Главное) + ?(ЗначениеЗаполнено(Стр.БезЦены), "; нет цены закупки: " + Стр.БезЦены, ""), , ЦветПриглушенный(), , 9, 8, Истина);
			ПодогнатьВысоту(В, Строка(Стр.Главное) + Строка(Стр.БезЦены), 60);
			РасшифровкаСтроки(В, Стр.Номенклатура, 8);
			ЛинияСнизу(В, 1, 8);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
		Примечание(В, "Цена продажи — средняя за месяц без НДС. «После сырья» — что остаётся с единицы на переработку, зарплату, энергию и прибыль. "
			+ "Это оценка по нормам спецификаций и последним ценам закупки — для сравнения с фактической себестоимостью после закрытия месяца.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиЦеныЗакупок(В, Р, П)

	ЗаголовокРаздела(В, "Закупочные цены за 12 месяцев");
	Если ПоказатьОшибку(В, Р, "ЗакупкиГод") Тогда
		Возврат;
	КонецЕсли;
	Зг = Р.ЗакупкиГод;
	Если Зг.Материалы.Количество() = 0 Тогда
		Примечание(В, "За 12 месяцев закупок не найдено.");
		Возврат;
	КонецЕсли;

	Подзаголовок(В, ?(Зг.Свойство("ТолькоОсновное"), "Основное сырьё: цены и их изменение за год", "Цены и их изменение за год (по сумме закупок)"));
	Шапка(В, "Материал", "Куплено за год", "Сумма за год", "Мин. цена", "Макс. цена", "Цена в начале", "Последняя цена", "Изменение");
	Для Каждого Гр Из ГруппыНоменклатуры(Зг.Материалы, "Номенклатура", "Сумма") Цикл
	ВывестиСтрокуГруппы(В, Гр, "2:Количество:к,3:Сумма:ч", 8);
	Номер = 0;
	Для Каждого Стр Из Гр.Позиции Цикл
		Номер = Номер + 1;
		Если ПрерватьГруппу(В, Гр, Номер) Тогда
			Прервать;
		КонецЕсли;
		ЯчейкаПозиции(В, Строка(Стр.Номенклатура));
		ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
		ЯчейкаЧисло(В, 3, Стр.Сумма);
		ЯчейкаЧисло(В, 4, Стр.МинЦена);
		ЯчейкаЧисло(В, 5, Стр.МаксЦена);
		Ячейка(В, 6, ФорматДенег(Стр.ПерваяЦена) + Символы.ПС + Формат(Стр.ПервыйМесяц, "ДФ='MMM yy'"), , , , 9, , Истина);
		ВПраво(В, 6, 6);
		Ячейка(В, 7, ФорматДенег(Стр.ПоследняяЦена) + Символы.ПС + Формат(Стр.ПоследнийМесяц, "ДФ='MMM yy'"), Истина, , , 9, , Истина);
		ВПраво(В, 7, 7);
		ЯчейкаПроцента(В, 8, Стр.ИзмГод, Истина, ?(Стр.ИзмГод = Неопределено, Неопределено, ?(Стр.ИзмГод > 0, ЦветКрит(), ЦветХорошо())));
		РасшифровкаСтроки(В, Стр.Номенклатура, 8);
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 24;
		ЛинияСнизу(В, 1, 8);
		СледующаяСтрока(В);
	КонецЦикла;
	КонецЦикла;
	СтрокаИтога(В, "Всего закуплено за 12 месяцев", , Зг.ЗаГод);
	Примечание(В, "Цены без НДС, средние за месяц. Изменение — последняя цена к цене первого месяца с закупками. Красным — подорожание, зелёным — подешевление.");

	// матрица: месяцы по строкам, 7 крупнейших материалов по столбцам
	СледующаяСтрока(В);
	Подзаголовок(В, "Средняя цена по месяцам, руб. за единицу");
	Колонок = Мин(7, Зг.Материалы.Количество());
	Для К = 0 По Колонок - 1 Цикл
		Ячейка(В, К + 2, Строка(Зг.Материалы[К].Номенклатура), Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8, , Истина);
		ВПраво(В, К + 2, К + 2);
	КонецЦикла;
	Ячейка(В, 1, "Месяц", Истина, ЦветПриглушенный(), ЦветФонаШапки(), 8);
	В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 36;
	СледующаяСтрока(В);
	Для Каждого НачалоМес Из Зг.Месяцы Цикл
		Ячейка(В, 1, ИмяМесяца(Месяц(НачалоМес), Ложь) + " " + Формат(Год(НачалоМес), "ЧГ=0"), НачалоМес = П.НачалоМесяца);
		Для К = 0 По Колонок - 1 Цикл
			Мат = Зг.Материалы[К];
			Цена = Мат.Помесячно[НачалоМес];
			Если Цена = Неопределено Тогда
				Ячейка(В, К + 2, "—", , ЦветПриглушенный());
			Иначе
				Цвет = Неопределено;
				Если Цена = Мат.МаксЦена И Мат.МаксЦена > Мат.МинЦена Тогда
					Цвет = ЦветКрит();
				ИначеЕсли Цена = Мат.МинЦена И Мат.МаксЦена > Мат.МинЦена Тогда
					Цвет = ЦветХорошо();
				КонецЕсли;
				Ячейка(В, К + 2, ФорматДенег(Цена), , Цвет);
			КонецЕсли;
			ВПраво(В, К + 2, К + 2);
		КонецЦикла;
		ЛинияСнизу(В, 1, Колонок + 1);
		СледующаяСтрока(В);
	КонецЦикла;
	Ячейка(В, 1, "Средняя за год", Истина, , ЦветФонаШапки());
	Для К = 0 По Колонок - 1 Цикл
		Мат = Зг.Материалы[К];
		Ячейка(В, К + 2, ФорматДенег(?(Мат.Количество = 0, 0, Мат.Сумма / Мат.Количество)), Истина, , ЦветФонаШапки());
		ВПраво(В, К + 2, К + 2);
	КонецЦикла;
	СледующаяСтрока(В);
	Примечание(В, "Красным — самая высокая цена за год, зелёным — самая низкая. Средняя за год — сумма закупок, делённая на количество.");

	// графики цены по месяцам для главных материалов: цена и средняя за год
	Для К = 0 По Мин(4, Зг.Материалы.Количество()) - 1 Цикл
		Мат = Зг.Материалы[К];
		СледующаяСтрока(В);
		Подзаголовок(В, Строка(Мат.Номенклатура) + ": цена закупки по месяцам, руб. за " + ?(ЗначениеЗаполнено(Мат.Ед), Мат.Ед, "ед."));
		Точки = Новый Массив;
		Цены = Новый Массив;
		Средние = Новый Массив;
		Средняя = ?(Мат.Количество = 0, 0, Мат.Сумма / Мат.Количество);
		Для Каждого НачалоМес Из Зг.Месяцы Цикл
			Точки.Добавить(Формат(НачалоМес, "ДФ='MMM yy'"));
			Цены.Добавить(Мат.Помесячно[НачалоМес]);
			Средние.Добавить(Средняя);
		КонецЦикла;
		Серии = Новый Массив;
		Серии.Добавить(Новый Структура("Имя, Значения", "Цена за месяц", Цены));
		Серии.Добавить(Новый Структура("Имя, Значения", "Средняя за год", Средние));
		ВывестиГрафик(В, Точки, Серии, 11);
	КонецЦикла;

	Если Зг.Сравнение.Количество() > 0 Тогда
		СледующаяСтрока(В);
		Подзаголовок(В, "Цены разных поставщиков за 3 месяца");
		Шапка(В, "Материал / поставщик", "Куплено", "Цена", "Дороже лучшей", "Переплата");
		Текущий = Неопределено;
		Для Каждого Гр Из ГруппыНоменклатуры(Зг.Сравнение, "Номенклатура", "Переплата") Цикл
		ВывестиСтрокуГруппы(В, Гр, "5:Переплата:ч", 5);
		Для Каждого Стр Из Гр.Позиции Цикл
			Если Стр.Номенклатура <> Текущий Тогда
				Текущий = Стр.Номенклатура;
				Ячейка(В, 1, "      " + Строка(Текущий), Истина, , , 8, 5, Истина);
				РасшифровкаСтроки(В, Текущий, 5);
				СледующаяСтрока(В);
			КонецЕсли;
			Ячейка(В, 1, "            " + Строка(Стр.Контрагент), , ?(Стр.Лучший, ЦветХорошо(), Неопределено), , 8, , Истина);
			ЯчейкаКоличество(В, 2, Стр.Количество, Стр.Ед);
			ЯчейкаЧисло(В, 3, Стр.Цена, ?(Стр.Лучший, ЦветХорошо(), Неопределено), Стр.Лучший);
			Если Стр.Лучший Тогда
				Ячейка(В, 4, "лучшая цена", , ЦветХорошо());
			Иначе
				Ячейка(В, 4, "+" + Формат(Стр.Отклонение, "ЧДЦ=1; ЧН=0") + " %", , ?(Стр.Отклонение >= 5, ЦветКрит(), ЦветВнимание()));
			КонецЕсли;
			ВПраво(В, 4, 4);
			ЯчейкаЧисло(В, 5, Стр.Переплата, ?(Стр.Переплата > 0, ЦветКрит(), Неопределено));
			РасшифровкаСтроки(В, Стр.Контрагент, 5);
			ЛинияСнизу(В, 1, 5);
			СледующаяСтрока(В);
		КонецЦикла;
		КонецЦикла;
		СтрокаИтога(В, "Переплата против лучших цен", , , , Зг.Переплата);
		Примечание(В, "Переплата — сколько сэкономили бы, если бы весь объём за 3 месяца купили по лучшей цене. Разные цены бывают из-за качества, сроков и доставки — сверьте условия.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПримитивыВывода

&НаСервере
Процедура СледующаяСтрока(В, Сколько = 1)

	Если Сколько < 1 Тогда
		В.ТД.Область(В.Строка, 1, В.Строка, 8).ВысотаСтроки = 5;
		В.Строка = В.Строка + 1;
	Иначе
		В.Строка = В.Строка + Сколько;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Ячейка(В, Колонка, Значение, Жирный = Ложь, ЦвТекста = Неопределено, ЦвФона = Неопределено, Размер = 9, КолонкаПо = 0, Переносить = Ложь)

	Обл = В.ТД.Область(В.Строка, Колонка, В.Строка, Макс(Колонка, КолонкаПо));
	Если КолонкаПо > Колонка Тогда
		Обл.Объединить();
	КонецЕсли;
	Обл.Текст = Строка(Значение);
	Обл.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Если ЦвТекста <> Неопределено Тогда
		Обл.ЦветТекста = ЦвТекста;
	КонецЕсли;
	Если ЦвФона <> Неопределено Тогда
		Обл.ЦветФона = ЦвФона;
	КонецЕсли;
	Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
