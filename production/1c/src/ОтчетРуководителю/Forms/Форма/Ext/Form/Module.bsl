	Строки.Добавить("");
	Строки.Добавить("$ext = [System.WindowsRuntimeSystemExtensions].GetMethods()");
	Строки.Добавить("$asTaskOp = $ext | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' } | Select-Object -First 1");
	Строки.Добавить("$asTaskAct = $ext | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncAction' } | Select-Object -First 1");
	Строки.Добавить("function Await($op, [Type]$type) { $t = $asTaskOp.MakeGenericMethod($type).Invoke($null, @($op)); $t.Wait(-1) | Out-Null; $t.Result }");
	Строки.Добавить("function AwaitAction($op) { $t = $asTaskAct.Invoke($null, @($op)); $t.Wait(-1) | Out-Null }");
	Строки.Добавить("");
	Строки.Добавить("$engine = $null");
	Строки.Добавить("foreach ($tag in @('ru', 'ru-RU')) {");
	Строки.Добавить("    if ($engine -eq $null) { $engine = [Windows.Media.Ocr.OcrEngine]::TryCreateFromLanguage((New-Object Windows.Globalization.Language($tag))) }");
	Строки.Добавить("}");
	Строки.Добавить("if ($engine -eq $null) {");
	Строки.Добавить("    Log 'ОШИБКА: в Windows не установлено распознавание текста для русского языка. Параметры - Время и язык - Язык - Русский - Параметры - Распознавание текста (или администратор: Add-WindowsCapability -Online -Name Language.OCR~~~ru-RU~0.0.1.0).'");
	Строки.Добавить("    exit 3");
	Строки.Добавить("}");
	Строки.Добавить("");
	Строки.Добавить("# ---------- поиск показателей в тексте ----------");
	Строки.Добавить("$NUM = '(\d{1,3}(?:[  ]\d{3})+(?:[.,]\d{1,2})?|\d+(?:[.,]\d{1,2})?)'");
	Строки.Добавить("$M2 = '(?:кв\.?\s*м\b\.?|кв\.?\s*м\.|м\s?2\b|м²|квадратн\w*\s+метр\w*)'");
	Строки.Добавить("$RUB = '(?:руб\w*\.?|₽|р\.)'");
	Строки.Добавить("$MONTH = '(\d{1,2}|январ[ья]|феврал[ья]|марта?|апрел[ья]|мая|май|июн[ья]|июл[ья]|августа?|сентябр[ья]|октябр[ья]|ноябр[ья]|декабр[ья])'");
	Строки.Добавить("$DATE = '«?(\d{1,2})»?\s*(?:\.|\s)\s*' + $MONTH + '\s*(?:\.|\s)\s*(\d{4})'");
	Строки.Добавить("");
	Строки.Добавить("function ToNum([string]$s) {");
	Строки.Добавить("    $t = ($s -replace '[\s ]', '') -replace ',', '.'");
	Строки.Добавить("    $v = 0.0");
	Строки.Добавить("    if ([double]::TryParse($t, [Globalization.NumberStyles]::Float, [Globalization.CultureInfo]::InvariantCulture, [ref]$v)) { return $v }");
	Строки.Добавить("    return $null");
	Строки.Добавить("}");
	Строки.Добавить("function ToDate([string]$d, [string]$m, [string]$y) {");
	Строки.Добавить("    $names = @('январ', 'феврал', 'март', 'апрел', 'ма', 'июн', 'июл', 'август', 'сентябр', 'октябр', 'ноябр', 'декабр')");
	Строки.Добавить("    $mm = 0");
	Строки.Добавить("    if ($m -match '^\d+$') { $mm = [int]$m } else {");
	Строки.Добавить("        $low = $m.ToLower()");
	Строки.Добавить("        for ($i = 0; $i -lt 12; $i++) { if ($low.StartsWith($names[$i])) { $mm = $i + 1; break } }");
	Строки.Добавить("        if ($low.StartsWith('июн')) { $mm = 6 } elseif ($low.StartsWith('июл')) { $mm = 7 }");
	Строки.Добавить("    }");
	Строки.Добавить("    if ($mm -lt 1 -or $mm -gt 12 -or [int]$d -lt 1 -or [int]$d -gt 31) { return '' }");
	Строки.Добавить("    try { return (Get-Date -Year ([int]$y) -Month $mm -Day ([int]$d)).ToString('yyyy-MM-dd') } catch { return '' }");
	Строки.Добавить("}");
	Строки.Добавить("function Quote([string]$flat, $m) {");
	Строки.Добавить("    $a = [Math]::Max(0, $m.Index - 60)");
	Строки.Добавить("    $b = [Math]::Min($flat.Length, $m.Index + $m.Length + 40)");
	Строки.Добавить("    return ('…' + $flat.Substring($a, $b - $a).Trim() + '…')");
	Строки.Добавить("}");
	Строки.Добавить("function Find([string]$text) {");
	Строки.Добавить("    $r = [ordered]@{}");
	Строки.Добавить("    $flat = ($text -replace '\s+', ' ')");
	Строки.Добавить("    $opt = [Text.RegularExpressions.RegexOptions]::IgnoreCase");
	Строки.Добавить("");
	Строки.Добавить("    # номер и дата договора");
	Строки.Добавить("    $m = [regex]::Match($flat, 'договор\w*(?:\s+аренды)?[^№]{0,60}№\s*([\w\-/.]+)', $opt)");
	Строки.Добавить("    if ($m.Success) { $r['Номер'] = $m.Groups[1].Value.TrimEnd('.') }");
	Строки.Добавить("    $head = $flat.Substring(0, [Math]::Min(800, $flat.Length))");
	Строки.Добавить("    $m = [regex]::Match($head, $DATE, $opt)");
	Строки.Добавить("    if ($m.Success) { $r['ДатаДоговора'] = ToDate $m.Groups[1].Value $m.Groups[2].Value $m.Groups[3].Value }");
	Строки.Добавить("");
	Строки.Добавить("    # площадь: сначала та, что рядом со словами «аренд», «передава», «помещени»");
	Строки.Добавить("    $best = $null");
	Строки.Добавить("    foreach ($m in [regex]::Matches($flat, 'площад\w*[^\d]{0,80}?' + $NUM + '\s*' + $M2, $opt)) {");
	Строки.Добавить("        $before = $flat.Substring([Math]::Max(0, $m.Index - 120), [Math]::Min(120, $m.Index)).ToLower()");
	Строки.Добавить("        if ($best -eq $null) { $best = $m }");
	Строки.Добавить("        if ($before -match 'аренд|передава|помещени') { $best = $m; break }");
	Строки.Добавить("    }");
	Строки.Добавить("    if ($best -ne $null) { $r['Площадь'] = ToNum $best.Groups[1].Value; $r['ЦитатаПлощадь'] = Quote $flat $best }");
	Строки.Добавить("");
	Строки.Добавить("    # ставка за 1 м²");
	Строки.Добавить("    $m = [regex]::Match($flat, $NUM + '\s*(?:\([^)]{0,150}\)\s*)?' + $RUB + '\s*(?:\d{1,2}\s*коп\w*\.?\s*)?(?:\([^)]{0,80}\)\s*)?(?:за|/|в)\s*(?:1\s*|один\s+)?' + $M2, $opt)");
	Строки.Добавить("    if ($m.Success) { $r['Ставка'] = ToNum $m.Groups[1].Value; $r['ЦитатаСтавка'] = Quote $flat $m }");
	Строки.Добавить("");
	Строки.Добавить("    # арендная плата в месяц: не ставка за м², лучше рядом со словом «месяц»");
	Строки.Добавить("    $best = $null");
	Строки.Добавить("    foreach ($m in [regex]::Matches($flat, '(?:арендн\w*\s+плат\w*|плат\w*\s+за\s+(?:аренд|пользован)\w*)[^\d]{0,150}?' + $NUM + '\s*(?:\([^)]{0,200}\)\s*)?' + $RUB, $opt)) {");
	Строки.Добавить("        $after = $flat.Substring($m.Index + $m.Length, [Math]::Min(60, $flat.Length - $m.Index - $m.Length))");
	Строки.Добавить("        if ([regex]::IsMatch($after, '^\s*(?:\d{1,2}\s*коп\w*\.?\s*)?(?:\([^)]*\)\s*)?(?:за|/|в)\s*(?:1\s*)?' + $M2, $opt)) { continue }");
	Строки.Добавить("        $near = $flat.Substring([Math]::Max(0, $m.Index - 60), [Math]::Min($flat.Length - [Math]::Max(0, $m.Index - 60), $m.Length + 200)).ToLower()");
	Строки.Добавить("        if ($best -eq $null) { $best = $m }");
	Строки.Добавить("        if ($near -match 'месяц|ежемесячн') { $best = $m; break }");
	Строки.Добавить("    }");
	Строки.Добавить("    if ($best -ne $null) {");
	Строки.Добавить("        $r['ВМесяц'] = ToNum $best.Groups[1].Value");
	Строки.Добавить("        $r['ЦитатаВМесяц'] = Quote $flat $best");
	Строки.Добавить("        $tail = $flat.Substring($best.Index, [Math]::Min(300, $flat.Length - $best.Index)).ToLower()");
	Строки.Добавить("        if ($tail -match 'без\s+(?:учета\s+|учёта\s+)?ндс|ндс\s+не\s+облага|не\s+облага\w*\s+ндс') { $r['НДС'] = 'без НДС' }");
	Строки.Добавить("        elseif ($tail -match 'в\s+том\s+числе\s+ндс|включая\s+ндс|с\s+учетом\s+ндс|с\s+учётом\s+ндс|с\s+ндс|т\.\s*ч\.\s*ндс') { $r['НДС'] = 'с НДС' }");
	Строки.Добавить("    }");
	Строки.Добавить("    if (-not $r.Contains('НДС')) {");
	Строки.Добавить("        if ($flat -match '(?i)ндс\s+не\s+облага|не\s+облага\w*\s+ндс|упрощенн\w*\s+систем') { $r['НДС'] = 'без НДС' }");
	Строки.Добавить("    }");
	Строки.Добавить("");
	Строки.Добавить("    # срок аренды: «срок … по/до <дата>»");
	Строки.Добавить("    $m = [regex]::Match($flat, 'срок\w*.{0,200}?(?<![а-яё])(?:по|до)\s+' + $DATE, $opt)");
	Строки.Добавить("    if ($m.Success) { $r['СрокДо'] = ToDate $m.Groups[1].Value $m.Groups[2].Value $m.Groups[3].Value; $r['ЦитатаСрок'] = Quote $flat $m }");
	Строки.Добавить("");
	Строки.Добавить("    # индексация, %");
	Строки.Добавить("    $m = [regex]::Match($flat, 'индексац\w*[^%]{0,150}?(\d{1,2}(?:[.,]\d{1,2})?)\s*%', $opt)");
	Строки.Добавить("    if ($m.Success) { $r['Индексация'] = ToNum $m.Groups[1].Value; $r['ЦитатаИндексация'] = Quote $flat $m }");
	Строки.Добавить("");
	Строки.Добавить("    # адрес помещения");
	Строки.Добавить("    $m = [regex]::Match($flat, 'по\s+адресу\s*:?\s*(.{10,160}?)(?:;|,\s*(?:общ|кадастр|именуем|для\s|этаж\w*\s+\d|пом\.?\s*\d)|\s\(далее|\.\s+\d+\.\d)', $opt)");
	Строки.Добавить("    if ($m.Success) { $r['Адрес'] = $m.Groups[1].Value.Trim() }");
	Строки.Добавить("    return $r");
	Строки.Добавить("}");
	Строки.Добавить("");
	Строки.Добавить("# ---------- файлы ----------");
	Строки.Добавить("foreach ($pdf in Get-ChildItem -LiteralPath $Dir -Filter '*.pdf') {");
	Строки.Добавить("    $res = [ordered]@{}");
	Строки.Добавить("    try {");
	Строки.Добавить("        $sf = Await ([Windows.Storage.StorageFile]::GetFileFromPathAsync($pdf.FullName)) ([Windows.Storage.StorageFile])");
	Строки.Добавить("        $doc = Await ([Windows.Data.Pdf.PdfDocument]::LoadFromFileAsync($sf)) ([Windows.Data.Pdf.PdfDocument])");
	Строки.Добавить("        $sb = New-Object System.Text.StringBuilder");
	Строки.Добавить("        $pages = [Math]::Min([int]$doc.PageCount, $MaxPages)");
	Строки.Добавить("        $watch = [Diagnostics.Stopwatch]::StartNew()");
	Строки.Добавить("        for ($i = 0; $i -lt $pages; $i++) {");
	Строки.Добавить("            if ($watch.Elapsed.TotalSeconds -gt $MaxSeconds) { $res['Обрезано'] = 'распознано ' + $i + ' стр. за отведённое время'; break }");
	Строки.Добавить("            $page = $doc.GetPage([uint32]$i)");
	Строки.Добавить("            $scale = [Math]::Min(2400.0 / [Math]::Max(1.0, $page.Size.Width), 3400.0 / [Math]::Max(1.0, $page.Size.Height))");
	Строки.Добавить("            $opt = New-Object Windows.Data.Pdf.PdfPageRenderOptions");
	Строки.Добавить("            $opt.DestinationWidth = [uint32][Math]::Floor($page.Size.Width * $scale)");
	Строки.Добавить("            $opt.DestinationHeight = [uint32][Math]::Floor($page.Size.Height * $scale)");
	Строки.Добавить("            $stream = New-Object Windows.Storage.Streams.InMemoryRandomAccessStream");
	Строки.Добавить("            AwaitAction ($page.RenderToStreamAsync($stream, $opt))");
	Строки.Добавить("            $stream.Seek([uint64]0)");
	Строки.Добавить("            $dec = Await ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])");
	Строки.Добавить("            $bmp = Await ($dec.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])");
	Строки.Добавить("            $ocr = Await ($engine.RecognizeAsync($bmp)) ([Windows.Media.Ocr.OcrResult])");
	Строки.Добавить("            foreach ($line in $ocr.Lines) { [void]$sb.AppendLine($line.Text) }");
	Строки.Добавить("            [void]$sb.AppendLine('')");
	Строки.Добавить("            $page.Dispose()");
	Строки.Добавить("            $stream.Dispose()");
	Строки.Добавить("        }");
	Строки.Добавить("        $text = $sb.ToString()");
	Строки.Добавить("        [IO.File]::WriteAllText($pdf.FullName + '.txt', $text, [Text.Encoding]::UTF8)");
	Строки.Добавить("        $cut = $res['Обрезано']");
	Строки.Добавить("        $res = Find $text");
	Строки.Добавить("        if ($cut) { $res['Обрезано'] = $cut }");
	Строки.Добавить("        $res['Страниц'] = [int]$doc.PageCount");
	Строки.Добавить("        $res['Символов'] = $text.Length");
	Строки.Добавить("    } catch {");
	Строки.Добавить("        $res['Ошибка'] = $_.Exception.Message");
	Строки.Добавить("    }");
	Строки.Добавить("    [IO.File]::WriteAllText($pdf.FullName + '.json', ($res | ConvertTo-Json -Depth 3), (New-Object Text.UTF8Encoding($false)))");
	Строки.Добавить("}");
	Строки.Добавить("Log 'ГОТОВО'");
	Строки.Добавить("exit 0");
	Возврат СтрСоединить(Строки, Символы.ВК + Символы.ПС);

КонецФункции
// <<< СКРИПТ РАСПОЗНАВАНИЯ

#КонецОбласти

#Область Служебные

&НаСервере
Процедура УстановитьПараметры(Запрос, П)

	Для Каждого КлючИЗначение Из П Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ИзмерениеРегистра(ИмяРегистра, Варианты)

	М = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если М = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если М.Измерения.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Возврат СокрЛП(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Функция РесурсРегистра(ИмяРегистра, Варианты)

	М = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если М = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если М.Ресурсы.Найти(СокрЛП(Имя)) <> Неопределено Тогда
			Возврат СокрЛП(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Функция УсловиеОрганизации(ИмяРегистра, П)

	Если НЕ ЗначениеЗаполнено(П.Организация) Тогда
		Возврат "";
	КонецЕсли;
	Если ИзмерениеРегистра(ИмяРегистра, "Организация") <> "" Тогда
		Возврат "Организация = &Организация";
	ИначеЕсли ИзмерениеРегистра(ИмяРегистра, "АналитикаУчетаПоПартнерам") <> "" Тогда
		Возврат "АналитикаУчетаПоПартнерам.Организация = &Организация";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция РеквизитСсылки(Ссылка, Варианты)

	// первый из перечисленных реквизитов, который есть у объекта; иначе Неопределено
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		М = Ссылка.Метаданные();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Имя = СокрЛП(Имя);
		Если М.Реквизиты.Найти(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Имя);
		Исключение
			Значение = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

