// Модуль ОБЪЕКТА внешнего отчёта «Отчёт руководителю».
// Нужен, чтобы отчёт можно было подключить в ERP через
// «НСИ и администрирование → Печатные формы, отчеты и обработки → Дополнительные отчеты и обработки».
// Если отчёт открывается только через «Файл → Открыть», этот модуль можно оставить пустым.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.Информация = "Ежедневный отчёт руководителю: деньги, долги, заказы, выпуск, нехватка сырья.";

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Отчёт руководителю";
	Команда.Идентификатор = "ОтчетРуководителю";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецЕсли
