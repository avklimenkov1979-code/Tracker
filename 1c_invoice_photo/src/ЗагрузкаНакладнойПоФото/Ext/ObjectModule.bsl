Функция ПодобратьНоменклатуру(ИННПоставщика, Артикул, Наименование, Сопоставления = Неопределено,
	Контрагент = Неопределено, Партнер = Неопределено) Экспорт

	Возврат ПодобратьНоменклатуруПодробно(ИННПоставщика, Артикул, Наименование, Сопоставления,
		Контрагент, Партнер).Номенклатура;

КонецФункции

// Подбирает номенклатуру для строки накладной.
// Порядок: запомненный выбор пользователя -> справочник "Номенклатура поставщиков" ->
// артикул -> точное наименование -> начало наименования -> похожие слова среди того,
// что покупали у этого поставщика -> похожие слова во всём справочнике ->
// единственная позиция, которую покупали у этого поставщика.
//
// Возвращаемое значение:
//  Структура - Номенклатура, Способ (Строка - как подобрано, для колонки на форме),
//              Точно (Булево - Ложь, если подобрано приблизительно и надо проверить).
//
Функция ПодобратьНоменклатуруПодробно(ИННПоставщика, Артикул, Знач Наименование, Сопоставления = Неопределено,
	Контрагент = Неопределено, Партнер = Неопределено) Экспорт

	Результат = Новый Структура("Номенклатура,Способ,Точно", Справочники.Номенклатура.ПустаяСсылка(),
		НСтр("ru = 'не найдено - выберите'"), Ложь);
	Наименование = СокрЛП(Наименование);

	Если Сопоставления = Неопределено Тогда
		Сопоставления = ЗагрузитьСопоставления();
	КонецЕсли;
	Найденная = Сопоставления.Получить(КлючСопоставления(ИННПоставщика, Артикул, Наименование));
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат ЗаполнитьРезультатПодбора(Результат, Найденная, НСтр("ru = 'выбрано ранее'"), Истина);
	КонецЕсли;

	ПоПоставщику = НайтиНоменклатуруПоставщика(Контрагент, Партнер, Артикул, Наименование);
	Если ПоПоставщику <> Неопределено И ЗначениеЗаполнено(ПоПоставщику.Номенклатура) Тогда
		Возврат ЗаполнитьРезультатПодбора(Результат, ПоПоставщику.Номенклатура,
			НСтр("ru = 'номенклатура поставщика'"), Истина);
	КонецЕсли;

	Если Не ПустаяСтрока(Артикул) Тогда
		Найденная = ЕдинственнаяНоменклатура("Номенклатура.Артикул = &Значение", СокрЛП(Артикул));
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат ЗаполнитьРезультатПодбора(Результат, Найденная, НСтр("ru = 'по артикулу'"), Истина);
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Наименование) Тогда
		Возврат Результат;
	КонецЕсли;

	Найденная = ЕдинственнаяНоменклатура("Номенклатура.Наименование = &Значение", Наименование);
	Если Не ЗначениеЗаполнено(Найденная) Тогда
		Найденная = ЕдинственнаяНоменклатура("ВЫРАЗИТЬ(Номенклатура.НаименованиеПолное КАК СТРОКА(1000)) = &Значение", Наименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат ЗаполнитьРезультатПодбора(Результат, Найденная, НСтр("ru = 'по наименованию'"), Истина);
	КонецЕсли;

	Найденная = ЕдинственнаяНоменклатура("Номенклатура.Наименование ПОДОБНО &Значение СПЕЦСИМВОЛ ""~""",
		ЭкранироватьДляПодобно(Лев(Наименование, 50)) + "%");
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат ЗаполнитьРезультатПодбора(Результат, Найденная, НСтр("ru = 'по началу наименования - проверьте'"), Ложь);
	КонецЕсли;

	// Приблизительный подбор по общим словам.
	Закупки = ЗакупкиУПоставщика(Контрагент);
	Найденная = ПохожаяПоСловам(Наименование, Закупки, Истина);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат ЗаполнитьРезультатПодбора(Результат, Найденная,
			НСтр("ru = 'похоже на прошлые закупки у поставщика - проверьте'"), Ложь);
	КонецЕсли;
	Найденная = ПохожаяПоСловам(Наименование, Закупки, Ложь);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат ЗаполнитьРезультатПодбора(Результат, Найденная, НСтр("ru = 'похожее наименование - проверьте'"), Ложь);
	КонецЕсли;
	Если Закупки.Количество() = 1 Тогда
		Для Каждого КлючИЗначение Из Закупки Цикл
			Возврат ЗаполнитьРезультатПодбора(Результат, КлючИЗначение.Ключ,
				НСтр("ru = 'единственное, что покупали у поставщика - проверьте'"), Ложь);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЗаполнитьРезультатПодбора(Результат, Номенклатура, Способ, Точно)

	Результат.Номенклатура = Номенклатура;
	Результат.Способ = Способ;
	Результат.Точно = Точно;
	Возврат Результат;

КонецФункции

// Номенклатура, которую покупали у контрагента за 3 года: Соответствие Номенклатура -> Наименование.
Функция ЗакупкиУПоставщика(Контрагент)

	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Строки
	|ГДЕ
	|	Строки.Ссылка.Проведен
	|	И Строки.Ссылка.Контрагент = &Контрагент
	|	И Строки.Ссылка.Дата >= &НачалоПериода
	|	И Строки.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(ТекущаяДатаСеанса(), -36));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Наименование);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ищет номенклатуру с наибольшим числом общих слов с наименованием из накладной.
// ТолькоЗакупки = Истина - только среди Закупок у поставщика, иначе во всём справочнике
// (покупавшиеся у поставщика позиции получают преимущество).
// Возвращает пустую ссылку, если уверенного единственного кандидата нет.
Функция ПохожаяПоСловам(Наименование, Закупки, ТолькоЗакупки)

	Пустая = Справочники.Номенклатура.ПустаяСсылка();
	ОсновыНакладной = ОсновыСлов(Наименование);
	Если ОсновыНакладной.Количество() = 0 Тогда
		Возврат Пустая;
	КонецЕсли;

	Кандидаты = Новый Соответствие;
	Если ТолькоЗакупки Тогда
		Для Каждого КлючИЗначение Из Закупки Цикл
			Кандидаты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Условия = Новый Массив;
		Запрос = Новый Запрос;
		НомерУсловия = 0;
		Для Каждого Основа Из ОсновыНакладной Цикл
			Если НомерУсловия >= 8 Тогда
				Прервать;
			КонецЕсли;
			НомерУсловия = НомерУсловия + 1;
			Для Каждого Вариант Из СтрРазделить(Основа + "," + ВРег(Лев(Основа, 1)) + Сред(Основа, 2), ",") Цикл
				ИмяПараметра = "Слово" + Формат(Условия.Количество(), "ЧН=0; ЧГ=0");
				Условия.Добавить("Номенклатура.Наименование ПОДОБНО &" + ИмяПараметра);
				Запрос.УстановитьПараметр(ИмяПараметра, "%" + Вариант + "%");
			КонецЦикла;
		КонецЦикла;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И (" + СтрСоединить(Условия, Символы.ПС + "ИЛИ ") + ")";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Кандидаты.Вставить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;

	ЛучшаяОценка = 0;
	ВтораяОценка = 0;
	Лучшая = Пустая;
	Для Каждого КлючИЗначение Из Кандидаты Цикл
		ОсновыКандидата = ОсновыСлов(КлючИЗначение.Значение);
		Если ОсновыКандидата.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Совпало = 0;
		Для Каждого Основа Из ОсновыКандидата Цикл
			Если ОсновыНакладной.Найти(Основа) <> Неопределено Тогда
				Совпало = Совпало + 1;
			КонецЕсли;
		КонецЦикла;
		Покрытие = Совпало / ОсновыКандидата.Количество();
		ИзЗакупок = Закупки.Получить(КлючИЗначение.Ключ) <> Неопределено;
		// Достаточно похоже: большая часть слов позиции есть в накладной, и совпало хотя бы 2 слова
		// (или 1, если в накладной всего 1-2 значимых слова или позицию уже покупали у поставщика).
		Если Покрытие < 0.6 Или Совпало = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Совпало < 2 И ОсновыНакладной.Количество() > 2 И Не ИзЗакупок Тогда
			Продолжить;
		КонецЕсли;
		Оценка = Совпало + Покрытие + ?(ИзЗакупок, 1, 0);
		Если Оценка > ЛучшаяОценка Тогда
			ВтораяОценка = ЛучшаяОценка;
			ЛучшаяОценка = Оценка;
			Лучшая = КлючИЗначение.Ключ;
		ИначеЕсли Оценка > ВтораяОценка Тогда
			ВтораяОценка = Оценка;
		КонецЕсли;
	КонецЦикла;

	// Два одинаково похожих варианта - не угадываем, пусть выберет человек.
	Если ЛучшаяОценка = 0 Или ЛучшаяОценка = ВтораяОценка Тогда
		Возврат Пустая;
	КонецЕсли;
	Возврат Лучшая;

КонецФункции

// Основы значимых слов: только буквы, от 4 букв, без служебных слов, первые 5 букв
// ("Выполненные работы" и "Выполнение работ" дают одинаковые основы "выпол", "работ").
Функция ОсновыСлов(Текст)

	Буквы = "абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz";
	Служебные = ",договор,договору,договора,согласно,счету,счета,оплата,оплаты,поставка,поставки,услуга,услуги,товар,товары,";
	Результат = Новый Массив;
	Исходный = НРег(Текст) + " ";
	Слово = "";
	Для Позиция = 1 По СтрДлина(Исходный) Цикл
		ОчереднойСимвол = Сред(Исходный, Позиция, 1);
		Если СтрНайти(Буквы, ОчереднойСимвол) > 0 Тогда
			Слово = Слово + ?(ОчереднойСимвол = "ё", "е", ОчереднойСимвол);
			Продолжить;
		КонецЕсли;
		Если СтрДлина(Слово) >= 4 И СтрНайти(Служебные, "," + Слово + ",") = 0 Тогда
			Основа = Лев(Слово, 5);
			Если Результат.Найти(Основа) = Неопределено Тогда
				Результат.Добавить(Основа);
			КонецЕсли;
		КонецЕсли;
		Слово = "";
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗагрузитьСопоставления() Экспорт

	Сопоставления = ХранилищеОбщихНастроек.Загрузить(КлючХранилища(), "Сопоставления");
	Если ТипЗнч(Сопоставления) <> Тип("Соответствие") Тогда
		Сопоставления = Новый Соответствие;
	КонецЕсли;
	Возврат Сопоставления;

КонецФункции

// Запоминает, какой номенклатуре соответствует строка накладной поставщика,
// чтобы при следующей загрузке от того же поставщика подставить её автоматически.
//
// Параметры:
//  ИННПоставщика - Строка
//  Строки - Массив из Структура - Артикул, Наименование, Номенклатура.
//
Процедура ЗапомнитьСопоставления(ИННПоставщика, Строки) Экспорт

	Если ПустаяСтрока(ИННПоставщика) Тогда
		Возврат;
	КонецЕсли;
	Сопоставления = ЗагрузитьСопоставления();
	Для Каждого ТекущаяСтрока Из Строки Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			Сопоставления.Вставить(КлючСопоставления(ИННПоставщика, ТекущаяСтрока.Артикул, ТекущаяСтрока.Наименование),
				ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(КлючХранилища(), "Сопоставления", Сопоставления);

КонецПроцедуры

// Возвращает значение для реквизита Товары.СтавкаНДС документа по тексту
// ставки из накладной ("22%", "20%", "10%", "0%", "Без НДС").
// Работает и со справочником СтавкиНДС (ERP 2.5.x), и с перечислением (ранние версии).
//
Функция СтавкаНДСПоТексту(ТекстСтавки) Экспорт

	МетаданныеРеквизита = Метаданные.Документы.ПриобретениеТоваровУслуг.ТабличныеЧасти.Товары.Реквизиты.Найти("СтавкаНДС");
	Если МетаданныеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипРеквизита = МетаданныеРеквизита.Тип;

	Текст = НРег(СтрЗаменить(СокрЛП(ТекстСтавки), " ", ""));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено; // ставка не прочитана - подберём из базы
	КонецЕсли;
	БезНДС = СтрНайти(Текст, "без") > 0 Или СтрНайти(Текст, "необлаг") > 0;
	Процент = ?(БезНДС, -1, ЧислоИзНачалаСтроки(Текст));
	Если Не БезНДС И Процент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено
		И ТипРеквизита.СодержитТип(Тип("СправочникСсылка.СтавкиНДС")) Тогда

		// Ставку ищем по числовому реквизиту справочника (если он есть) и по наименованию
		// в любом виде: "20%", "20 %", "НДС 20%", "НДС 20".
		ЕстьЧисло = Метаданные.Справочники.СтавкиНДС.Реквизиты.Найти("Ставка") <> Неопределено;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СтавкиНДС.Ссылка КАК Ссылка,
		|	СтавкиНДС.Наименование КАК Наименование,
		|	" + ?(ЕстьЧисло, "СтавкиНДС.Ставка", "0") + " КАК Ставка
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	НЕ СтавкиНДС.ПометкаУдаления");
		Кандидат = Неопределено;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Имя = НРег(СтрЗаменить(Выборка.Наименование, " ", ""));
			Если СтрНайти(Имя, "/") > 0 Тогда
				Продолжить; // расчётные ставки 20/120 и т.п. не нужны
			КонецЕсли;
			ИмяБезНДС = СтрНайти(Имя, "без") > 0 Или СтрНайти(Имя, "необлаг") > 0;
			Если БезНДС Тогда
				Если ИмяБезНДС Тогда
					Возврат Выборка.Ссылка;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ИмяБезНДС Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьЧисло И ТипЗнч(Выборка.Ставка) = Тип("Число") И Выборка.Ставка <> 0
				И (Выборка.Ставка = Процент Или Окр(Выборка.Ставка * 100, 2) = Процент) Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
			Если Кандидат = Неопределено И ПроцентВНаименовании(Имя, Процент) Тогда
				Кандидат = Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
		Возврат Кандидат;

	КонецЕсли;

	Если Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено
		И ТипРеквизита.СодержитТип(Тип("ПеречислениеСсылка.СтавкиНДС")) Тогда
		ИмяЗначения = ?(БезНДС, "БезНДС", "НДС" + Формат(Процент, "ЧГ=0; ЧН=0"));
		Если Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления.Найти(ИмяЗначения) <> Неопределено Тогда
			Возврат Перечисления.СтавкиНДС[ИмяЗначения];
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СозданиеДокумента

// Создаёт и записывает (без проведения) документ «Приобретение товаров и услуг».
//
// Параметры:
//  Шапка - Структура - Организация, Контрагент, Партнер, Договор, Склад,
//          НомерВходящегоДокумента, ДатаВходящегоДокумента, ЦенаВключаетНДС, Комментарий.
//  Строки - Массив из Структура - Номенклатура, Количество, Цена, Сумма,
//           СтавкаНДС (Строка - текст ставки), СуммаНДС, СуммаСНДС.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриобретениеТоваровУслуг
//
Функция СоздатьДокументПоступления(Шапка, Строки) Экспорт

	МетаДокумента = Метаданные.Документы.ПриобретениеТоваровУслуг;
	МетаТоваров = МетаДокумента.ТабличныеЧасти.Товары;

	Документ = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();

	// Стандартное заполнение ERP: валюта, налогообложение, договор, склад по умолчанию и т.д.
	ДанныеЗаполнения = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Организация,Партнер,Контрагент,Договор,Склад", ",") Цикл
		Если Шапка.Свойство(Имя) И ЗначениеЗаполнено(Шапка[Имя]) Тогда
			ДанныеЗаполнения.Вставить(Имя, Шапка[Имя]);
		КонецЕсли;
	КонецЦикла;
	Если Метаданные.Перечисления.Найти("ХозяйственныеОперации") <> Неопределено
		И Метаданные.Перечисления.ХозяйственныеОперации.ЗначенияПеречисления.Найти("ЗакупкаУПоставщика") <> Неопределено Тогда
		ДанныеЗаполнения.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика);
	КонецЕсли;
	Попытка
		Документ.Заполнить(ДанныеЗаполнения);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаНакладнойПоФото", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Значения из формы важнее значений по умолчанию.
	Для Каждого КлючИЗначение Из ДанныеЗаполнения Цикл
		УстановитьЕслиЕсть(Документ, МетаДокумента, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	УстановитьЕслиЕсть(Документ, МетаДокумента, "НомерВходящегоДокумента", Шапка.НомерВходящегоДокумента);
	УстановитьЕслиЕсть(Документ, МетаДокумента, "ДатаВходящегоДокумента", Шапка.ДатаВходящегоДокумента);
	УстановитьЕслиЕсть(Документ, МетаДокумента, "ЦенаВключаетНДС", Шапка.ЦенаВключаетНДС);

	// Привязка к заказу поставщику: ERP учтёт, что по заказу товар получен.
	Заказ = Неопределено;
	ПозицииЗаказа = Новый Соответствие;
	Если Шапка.Свойство("ЗаказПоставщику") И ЗначениеЗаполнено(Шапка.ЗаказПоставщику) Тогда
		Заказ = Шапка.ЗаказПоставщику;
		ПозицииЗаказа = ДанныеЗаказаДляСверки(Заказ);
		УстановитьЕслиЕсть(Документ, МетаДокумента, "ЗаказПоставщику", Заказ);
		Если МетаДокумента.Реквизиты.Найти("ПоступлениеПоЗаказам") <> Неопределено
			И МетаДокумента.Реквизиты.ПоступлениеПоЗаказам.Тип.СодержитТип(Тип("Булево")) Тогда
			Документ.ПоступлениеПоЗаказам = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Шапка.Свойство("Комментарий") Тогда
		УстановитьЕслиЕсть(Документ, МетаДокумента, "Комментарий", Шапка.Комментарий);
	КонецЕсли;

	// Пустые поля шапки - из прошлого поступления этого поставщика.
	ДозаполнитьШапкуПоОбразцу(Документ, ПоследнееПоступлениеПоставщика(Шапка.Контрагент, Шапка.Организация));
	СкладСтрок = Шапка.Склад;
	Если Не ЗначениеЗаполнено(СкладСтрок) И МетаДокумента.Реквизиты.Найти("Склад") <> Неопределено Тогда
		СкладСтрок = Документ.Склад;
	КонецЕсли;

	Документ.Товары.Очистить();
	ИтогСНДС = 0;
	ПолеНоменклатурыПоставщика = ПолеНоменклатурыПоставщикаВТоварах();
	Для Каждого ТекущаяСтрока Из Строки Цикл
		НоваяСтрока = Документ.Товары.Добавить();
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Номенклатура", ТекущаяСтрока.Номенклатура);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Количество", ТекущаяСтрока.Количество);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "КоличествоУпаковок", ТекущаяСтрока.Количество);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Цена", ТекущаяСтрока.Цена);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Сумма", ТекущаяСтрока.Сумма);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "СуммаНДС", ТекущаяСтрока.СуммаНДС);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "СуммаСНДС", ТекущаяСтрока.СуммаСНДС);
		Ставка = СтавкаНДСПоТексту(ТекущаяСтрока.СтавкаНДС);
		Если Ставка <> Неопределено Тогда
			УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "СтавкаНДС", Ставка);
		КонецЕсли;
		Если ЗначениеЗаполнено(СкладСтрок) Тогда
			УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Склад", СкладСтрок);
		КонецЕсли;
		// Остальные пустые колонки и ставка НДС (если её не было в накладной) - из прошлых закупок.
		ДозаполнитьСтрокуПоИстории(НоваяСтрока, ТекущаяСтрока.Номенклатура, Шапка.Контрагент, МетаТоваров);
		Если Не ПустаяСтрока(ПолеНоменклатурыПоставщика) Тогда
			ПозицияПоставщика = ЭлементНоменклатурыПоставщика(Шапка.Контрагент, Шапка.Партнер,
				ТекущаяСтрока.Артикул, ТекущаяСтрока.Наименование, ТекущаяСтрока.Номенклатура);
			Если ПозицияПоставщика <> Неопределено Тогда
				НоваяСтрока[ПолеНоменклатурыПоставщика] = ПозицияПоставщика;
			КонецЕсли;
		КонецЕсли;
		Если Заказ <> Неопределено И ПозицииЗаказа.Получить(ТекущаяСтрока.Номенклатура) <> Неопределено Тогда
			УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "ЗаказПоставщику", Заказ);
		КонецЕсли;
		ИтогСНДС = ИтогСНДС + ТекущаяСтрока.СуммаСНДС;
	КонецЦикла;
	УстановитьЕслиЕсть(Документ, МетаДокумента, "СуммаДокумента", ИтогСНДС);

	Документ.Записать(РежимЗаписиДокумента.Запись);
	Возврат Документ.Ссылка;

КонецФункции

#КонецОбласти

#Область ДозаполнениеИзБазы

// Последнее проведённое поступление от этого поставщика - образец для пустых полей шапки.
Функция ПоследнееПоступлениеПоставщика(Контрагент, Организация)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Поступления.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Поступления
	|ГДЕ
	|	Поступления.Проведен
	|	И Поступления.Контрагент = &Контрагент
	|	&УсловиеОрганизации
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступления.Дата УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации",
		?(ЗначениеЗаполнено(Организация), "И Поступления.Организация = &Организация", ""));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Пустые поля шапки (склад, подразделение, налогообложение НДС, порядок расчётов и т.п.)
// берём из прошлого поступления этого поставщика. Номера, даты, ответственный, статус,
// основания и заказы не копируются.
Процедура ДозаполнитьШапкуПоОбразцу(Документ, Образец)

	Если Образец = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НеКопировать = "Ответственный,Автор,Статус,ДокументОснование,Заказ,Сделка,Исправл,Корректир,Основание,"
		+ "Распоряжение,Входящ,НомерВходящ,ДатаВходящ,Доверенность,Номер,Дата,Идентификатор,Комментарий,Согласован";
	Для Каждого Реквизит Из Метаданные.Документы.ПриобретениеТоваровУслуг.Реквизиты Цикл
		Если НачинаетсяСОдногоИз(Реквизит.Имя, НеКопировать) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Значение = Образец[Реквизит.Имя];
			Если ЭтоСсылочноеЗначение(Значение) И ЗначениеЗаполнено(Значение)
				И Не ЗначениеЗаполнено(Документ[Реквизит.Имя]) Тогда
				Документ[Реквизит.Имя] = Значение;
			КонецЕсли;
		Исключение
			// реквизит недоступен - пропускаем
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Пустые колонки строки (статья и аналитика расходов, характеристика, склад, ставка НДС и т.п.)
// берём из последней закупки этой же номенклатуры, в первую очередь у этого же поставщика.
// Количество, цены, суммы, упаковка, заказы, серии и номера ГТД не копируются.
Процедура ДозаполнитьСтрокуПоИстории(НоваяСтрока, Номенклатура, Контрагент, МетаТоваров)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Строки
	|ГДЕ
	|	Строки.Ссылка.Проведен
	|	И Строки.Номенклатура = &Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Строки.Ссылка.Контрагент = &Контрагент
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Строки.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтараяСтрока = Выборка.Ссылка.Товары[Выборка.НомерСтроки - 1];
		НеКопировать = "Номенклатура,Назначение,Заказ,Сумма,Количество,Цена,Упаковка,КодСтроки,Идентификатор,КлючСвязи,"
			+ "Серия,Серии,СтатусУказанияСерий,НомерГТД,Партия,Сертификат,Документ,Распоряжение,Сделка,Исправл,"
			+ "Скидк,ПроцентСкидки,Акциз";
		Для Каждого Реквизит Из МетаТоваров.Реквизиты Цикл
			Если НачинаетсяСОдногоИз(Реквизит.Имя, НеКопировать) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Значение = СтараяСтрока[Реквизит.Имя];
				Если ЭтоСсылочноеЗначение(Значение) И ЗначениеЗаполнено(Значение)
					И Не ЗначениеЗаполнено(НоваяСтрока[Реквизит.Имя]) Тогда
					НоваяСтрока[Реквизит.Имя] = Значение;
				КонецЕсли;
			Исключение
				// реквизит недоступен - пропускаем
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	// Ставка НДС так и не определилась - берём из карточки номенклатуры, если она там есть.
	МетаСтавки = МетаТоваров.Реквизиты.Найти("СтавкаНДС");
	Если МетаСтавки <> Неопределено И Не ЗначениеЗаполнено(НоваяСтрока.СтавкаНДС)
		И Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтавкаНДС") <> Неопределено Тогда
		СтавкаНоменклатуры = Номенклатура.СтавкаНДС;
		Если ЗначениеЗаполнено(СтавкаНоменклатуры) И МетаСтавки.Тип.СодержитТип(ТипЗнч(СтавкаНоменклатуры)) Тогда
			НоваяСтрока.СтавкаНДС = СтавкаНоменклатуры;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция НачинаетсяСОдногоИз(Имя, ПрефиксыСтрокой)

	Для Каждого Префикс Из СтрРазделить(ПрефиксыСтрокой, ",", Ложь) Цикл
		Если СтрНачинаетсяС(Имя, Префикс) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Ссылка или значение перечисления (а не число, строка, дата, булево).
Функция ЭтоСсылочноеЗначение(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения <> Тип("Число") И ТипЗначения <> Тип("Строка") И ТипЗначения <> Тип("Дата")
		И ТипЗначения <> Тип("Булево") И ТипЗначения <> Тип("Неопределено") И ТипЗначения <> Тип("Null")
		И ТипЗначения <> Тип("ХранилищеЗначения") И ТипЗначения <> Тип("УникальныйИдентификатор");

КонецФункции

// "20%" найдено в наименовании ставки как отдельное число ("НДС 20%", "20 %"), а не часть "120%".
Функция ПроцентВНаименовании(Имя, Процент)

	ЧислоСтрокой = Формат(Процент, "ЧГ=0; ЧН=0");
	Для Каждого Вариант Из СтрРазделить(ЧислоСтрокой + "%," + ЧислоСтрокой, ",") Цикл
		Позиция = СтрНайти(Имя, Вариант);
		Пока Позиция > 0 Цикл
			Перед = ?(Позиция = 1, "", Сред(Имя, Позиция - 1, 1));
			После = Сред(Имя, Позиция + СтрДлина(Вариант), 1);
			Если СтрНайти("0123456789", Перед) = 0 Или ПустаяСтрока(Перед) Тогда
				Если Вариант <> ЧислоСтрокой Или ПустаяСтрока(После) Тогда
					Возврат Истина; // "20%" где угодно, или "20" в самом конце ("НДС 20")
				КонецЕсли;
			КонецЕсли;
			Позиция = СтрНайти(Имя, Вариант, , Позиция + 1);
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Проверки

// Проверка контрольных цифр ИНН (10 цифр - организация, 12 - ИП).
// Ловит ошибки распознавания: если перепутана хоть одна цифра, проверка не пройдёт.
Функция ИННКорректен(Знач ИНН) Экспорт

	ИНН = СокрЛП(ИНН);
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	Цифры = Новый Массив;
	Для Позиция = 1 По СтрДлина(ИНН) Цикл
		ОчереднойСимвол = Сред(ИНН, Позиция, 1);
		Если СтрНайти("0123456789", ОчереднойСимвол) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Цифры.Добавить(Число(ОчереднойСимвол));
	КонецЦикла;

	Если Цифры.Количество() = 10 Тогда
		Возврат КонтрольнаяЦифраИНН(Цифры, "2,4,10,3,5,9,4,6,8") = Цифры[9];
	КонецЕсли;
	Возврат КонтрольнаяЦифраИНН(Цифры, "7,2,4,10,3,5,9,4,6,8") = Цифры[10]
		И КонтрольнаяЦифраИНН(Цифры, "3,7,2,4,10,3,5,9,4,6,8") = Цифры[11];

КонецФункции

// Ищет уже введённые поступления с тем же номером и датой входящего документа
// от того же поставщика (по ссылке или по ИНН).
//
// Возвращаемое значение:
//  Массив из Строка - представления найденных документов.
//
Функция НайтиДублиПоступления(Контрагент, ИНН, Знач Номер, ДатаНакладной) Экспорт

	Результат = Новый Массив;
	Номер = СокрЛП(Номер);
	Если ПустаяСтрока(Номер) Или (Не ЗначениеЗаполнено(Контрагент) И ПустаяСтрока(ИНН)) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Проведен КАК Проведен
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Поступление
	|ГДЕ
	|	НЕ Поступление.ПометкаУдаления
	|	И Поступление.НомерВходящегоДокумента = &Номер
	|	И (Поступление.Контрагент = &Контрагент
	|				И &Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ИЛИ Поступление.Контрагент.ИНН = &ИНН
	|				И &ИНН <> """")
	|	И (&БезДаты
	|			ИЛИ Поступление.ДатаВходящегоДокумента МЕЖДУ &Начало И &Конец)";
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("БезДаты", Не ЗначениеЗаполнено(ДатаНакладной));
	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаНакладной));
	Запрос.УстановитьПараметр("Конец", КонецДня(ДатаНакладной));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = Строка(Выборка.Ссылка);
		Если Не Выборка.Проведен Тогда
			Представление = Представление + " " + НСтр("ru = '(не проведён)'");
		КонецЕсли;
		Результат.Добавить(Представление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Цены прошлых закупок (без НДС, за единицу) за последний год.
// Сначала у этого поставщика, если у него не покупали - у любого.
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.Номенклатура,
//                 значение: Структура(Цена, Дата, ЭтотПоставщик, Поставщик).
//
Функция ПрошлыеЦеныЗакупки(МассивНоменклатуры, Контрагент) Экспорт

	Результат = Новый Соответствие;
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Ссылка.Дата КАК Дата,
	|	Товары.Ссылка.Контрагент КАК Поставщик,
	|	ВЫБОР
	|		КОГДА Товары.Ссылка.Контрагент = &Контрагент
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЭтотПоставщик,
	|	ВЫБОР
	|		КОГДА Товары.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ (Товары.Сумма - ВЫБОР
	|				КОГДА Товары.Ссылка.ЦенаВключаетНДС
	|					ТОГДА Товары.СуммаНДС
	|				ИНАЧЕ 0
	|			КОНЕЦ) / Товары.Количество
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Проведен
	|	И Товары.Номенклатура В (&Номенклатура)
	|	И Товары.Количество > 0
	|	И Товары.Ссылка.Дата >= &НачалоПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтотПоставщик УБЫВ,
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(ТекущаяДатаСеанса(), -12));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Номенклатура) <> Неопределено Тогда
			Продолжить; // уже взяли самую свежую цену с учётом приоритета поставщика
		КонецЕсли;
		Результат.Вставить(Выборка.Номенклатура, Новый Структура("Цена,Дата,ЭтотПоставщик,Поставщик",
			Окр(Выборка.Цена, 2), Выборка.Дата, Выборка.ЭтотПоставщик = 1, Выборка.Поставщик));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область НоменклатураПоставщиков

// Справочник "Номенклатура поставщиков" (НоменклатураКонтрагентов): чья это позиция и как её искать.
// Неопределено - справочника в этой версии ERP нет или он устроен иначе.
Функция ОписаниеНоменклатурыПоставщиков()

	Мета = Метаданные.Справочники.Найти("НоменклатураКонтрагентов");
	Если Мета = Неопределено Или Мета.Реквизиты.Найти("Номенклатура") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Мета.Владельцы.Количество() > 0 Тогда
		ПолеВладельца = "Владелец";
		ПоПартнеру = Мета.Владельцы.Содержит(Метаданные.Справочники.Партнеры);
	ИначеЕсли Мета.Реквизиты.Найти("ВладелецНоменклатуры") <> Неопределено Тогда
		ПолеВладельца = "ВладелецНоменклатуры";
		ПоПартнеру = Мета.Реквизиты.ВладелецНоменклатуры.Тип.СодержитТип(Тип("СправочникСсылка.Партнеры"));
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Мета", Мета);
	Описание.Вставить("ПолеВладельца", ПолеВладельца);
	Описание.Вставить("ПоПартнеру", ПоПартнеру);
	Описание.Вставить("ЕстьАртикул", Мета.Реквизиты.Найти("Артикул") <> Неопределено);
	Описание.Вставить("ДлинаНаименования", Мета.ДлинаНаименования);
	Возврат Описание;

КонецФункции

// Позиция поставщика по артикулу или наименованию.
// Возвращает Структура(Ссылка, Номенклатура) или Неопределено.
Функция НайтиНоменклатуруПоставщика(Контрагент, Партнер, Артикул, Наименование) Экспорт

	Описание = ОписаниеНоменклатурыПоставщиков();
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Владелец = ?(Описание.ПоПартнеру, Партнер, Контрагент);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УсловиеАртикула = "";
	Если Описание.ЕстьАртикул И Не ПустаяСтрока(Артикул) Тогда
		УсловиеАртикула = "Позиции.Артикул = &Артикул ИЛИ ";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Позиции.Ссылка КАК Ссылка,
	|	Позиции.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.НоменклатураКонтрагентов КАК Позиции
	|ГДЕ
	|	Позиции." + Описание.ПолеВладельца + " = &Владелец
	|	И НЕ Позиции.ПометкаУдаления
	|	И (" + УсловиеАртикула + "Позиции.Наименование = &Наименование)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Позиции.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	Запрос.УстановитьПараметр("Наименование", НаименованиеДляСправочника(Наименование, Описание));
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаНакладнойПоФото", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Ссылка,Номенклатура", Выборка.Ссылка, Выборка.Номенклатура);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Находит или создаёт позицию поставщика и связывает её с нашей номенклатурой,
// чтобы ERP (и ЭДО) сопоставляли эту позицию сами. Неопределено - не получилось (не мешает созданию документа).
Функция ЭлементНоменклатурыПоставщика(Контрагент, Партнер, Артикул, Наименование, Номенклатура) Экспорт

	Описание = ОписаниеНоменклатурыПоставщиков();
	Владелец = ?(Описание = Неопределено, Неопределено, ?(Описание.ПоПартнеру, Партнер, Контрагент));
	Если Описание = Неопределено Или Не ЗначениеЗаполнено(Владелец) Или Не ЗначениеЗаполнено(Номенклатура)
		Или (ПустаяСтрока(Наименование) И ПустаяСтрока(Артикул)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Найденная = НайтиНоменклатуруПоставщика(Контрагент, Партнер, Артикул, Наименование);
		Если Найденная <> Неопределено Тогда
			Если Найденная.Номенклатура <> Номенклатура Тогда
				Элемент = Найденная.Ссылка.ПолучитьОбъект();
				Элемент.Номенклатура = Номенклатура;
				Элемент.Записать();
			КонецЕсли;
			Возврат Найденная.Ссылка;
		КонецЕсли;

		Элемент = Справочники[Описание.Мета.Имя].СоздатьЭлемент();
		Элемент[Описание.ПолеВладельца] = Владелец;
		Элемент.Наименование = НаименованиеДляСправочника(?(ПустаяСтрока(Наименование), Артикул, Наименование), Описание);
		УстановитьЕслиЕсть(Элемент, Описание.Мета, "Номенклатура", Номенклатура);
		УстановитьЕслиЕсть(Элемент, Описание.Мета, "Артикул", СокрЛП(Артикул));
		УстановитьЕслиЕсть(Элемент, Описание.Мета, "НаименованиеПолное", СокрЛП(Наименование));
		Элемент.Записать();
		Возврат Элемент.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаНакладнойПоФото", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Колонка строки поступления, где ERP хранит позицию поставщика ("Номенклатура поставщика").
Функция ПолеНоменклатурыПоставщикаВТоварах()

	Если Метаданные.Справочники.Найти("НоменклатураКонтрагентов") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипПозиции = Тип("СправочникСсылка.НоменклатураКонтрагентов");
	Для Каждого Реквизит Из Метаданные.Документы.ПриобретениеТоваровУслуг.ТабличныеЧасти.Товары.Реквизиты Цикл
		Если Реквизит.Тип.СодержитТип(ТипПозиции) Тогда
			Возврат Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция НаименованиеДляСправочника(Наименование, Описание)

	Если Описание.ДлинаНаименования > 0 Тогда
		Возврат Лев(СокрЛП(Наименование), Описание.ДлинаНаименования);
	КонецЕсли;
	Возврат СокрЛП(Наименование);

КонецФункции

#КонецОбласти

#Область Договор

// Договор поставщика: сначала тот, чей номер упомянут в основании накладной,
// иначе единственный договор с этим контрагентом (и организацией).
Функция ПодобратьДоговор(Контрагент, Организация, ТекстОснования) Экспорт

	Мета = Метаданные.Справочники.Найти("ДоговорыКонтрагентов");
	Если Мета = Неопределено Или Не ЗначениеЗаполнено(Контрагент)
		Или Мета.Реквизиты.Найти("Контрагент") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕстьНомер = Мета.Реквизиты.Найти("Номер") <> Неопределено;
	УсловиеОрганизации = "";
	Если ЗначениеЗаполнено(Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено Тогда
		УсловиеОрганизации = "И Договоры.Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка,
	|	" + ?(ЕстьНомер, "Договоры.Номер", """""") + " КАК Номер
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Контрагент = &Контрагент
	|	И НЕ Договоры.ПометкаУдаления
	|	" + УсловиеОрганизации;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Попытка
		Выгрузка = Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Основание = НРег(СтрЗаменить(ТекстОснования, " ", ""));
	Если Не ПустаяСтрока(Основание) Тогда
		Для Каждого Договор Из Выгрузка Цикл
			НомерДоговора = НРег(СтрЗаменить(Договор.Номер, " ", ""));
			Если СтрДлина(НомерДоговора) >= 2 И СтрНайти(Основание, НомерДоговора) > 0 Тогда
				Возврат Договор.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Выгрузка.Количество() = 1 Тогда
		Возврат Выгрузка[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СверкаСЗаказом

// Подбирает открытый заказ поставщику для накладной.
// 1) если в поле "Основание" накладной есть номер заказа - заказ с этим номером;
// 2) иначе заказ, в котором больше всего позиций из накладной (при равенстве - самый свежий).
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику - пустая ссылка, если подходящего заказа нет.
//
Функция ПодобратьЗаказПоставщику(Контрагент, Организация, МассивНоменклатуры, ТекстОснования) Экспорт

	Пустой = Документы.ЗаказПоставщику.ПустаяСсылка();
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Пустой;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтрокиЗаказа.Номенклатура) КАК Совпадений
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК СтрокиЗаказа
	|		ПО СтрокиЗаказа.Ссылка = Заказы.Ссылка
	|			И СтрокиЗаказа.Номенклатура В (&Номенклатура)
	|ГДЕ
	|	Заказы.Проведен
	|	И НЕ Заказы.ПометкаУдаления
	|	И Заказы.Контрагент = &Контрагент
	|	&УсловиеОрганизации
	|	И Заказы.Дата >= &НачалоПериода
	|	&УсловиеСтатуса
	|
	|СГРУППИРОВАТЬ ПО
	|	Заказы.Ссылка,
	|	Заказы.Номер,
	|	Заказы.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Совпадений УБЫВ,
	|	Дата УБЫВ";

	// Закрытые заказы не берём (если в этой версии ERP есть такой статус).
	УсловиеСтатуса = "";
	МетаСтатусов = Метаданные.Перечисления.Найти("СтатусыЗаказовПоставщикам");
	Если Метаданные.Документы.ЗаказПоставщику.Реквизиты.Найти("Статус") <> Неопределено
		И МетаСтатусов <> Неопределено И МетаСтатусов.ЗначенияПеречисления.Найти("Закрыт") <> Неопределено Тогда
		УсловиеСтатуса = "И Заказы.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Закрыт)";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСтатуса", УсловиеСтатуса);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации",
		?(ЗначениеЗаполнено(Организация), "И Заказы.Организация = &Организация", ""));

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(ТекущаяДатаСеанса(), -12));
	Выгрузка = Запрос.Выполнить().Выгрузить();

	// 1. Номер заказа указан в накладной.
	ЧислаОснования = ЧислаИзТекста(ТекстОснования);
	Если ЧислаОснования.Количество() > 0 Тогда
		Для Каждого Заказ Из Выгрузка Цикл
			ЧислаНомера = ЧислаИзТекста(Заказ.Номер);
			Если ЧислаНомера.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			НомерЗаказа = ЧислаНомера[ЧислаНомера.ВГраница()];
			// Числа 1-31 и 2000-2099 слишком похожи на день, месяц или год из даты основания.
			ЗначениеНомера = Число(НомерЗаказа);
			Если ЗначениеНомера <= 31 Или (ЗначениеНомера >= 2000 И ЗначениеНомера <= 2099) Тогда
				Продолжить;
			КонецЕсли;
			Если ЧислаОснования.Найти(НомерЗаказа) <> Неопределено Тогда
				Возврат Заказ.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 2. Заказ с наибольшим числом совпадающих позиций.
	Если Выгрузка.Количество() > 0 И Выгрузка[0].Совпадений > 0 Тогда
		Возврат Выгрузка[0].Ссылка;
	КонецЕсли;
	Возврат Пустой;

КонецФункции

// Данные заказа для сверки по каждой номенклатуре.
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.Номенклатура,
//                 значение: Структура(Заказано, Получено, Цена (без НДС за единицу), Наименование).
//
Функция ДанныеЗаказаДляСверки(Заказ) Экспорт

	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Результат;
	КонецЕсли;

	// Заказано
	МетаТоваровЗаказа = Метаданные.Документы.ЗаказПоставщику.ТабличныеЧасти.Товары;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура) КАК Наименование,
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.Сумма - ВЫБОР
	|			КОГДА Товары.Ссылка.ЦенаВключаетНДС
	|				ТОГДА Товары.СуммаНДС
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаБезНДС
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Заказ
	|	&УсловиеОтмены
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтмены",
		?(МетаТоваровЗаказа.Реквизиты.Найти("Отменено") <> Неопределено, "И НЕ Товары.Отменено", ""));
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Новый Структура("Заказано,Получено,Цена,Наименование",
			Выборка.Количество, 0,
			?(Выборка.Количество = 0, 0, Окр(Выборка.СуммаБезНДС / Выборка.Количество, 2)),
			Выборка.Наименование));
	КонецЦикла;

	// Уже получено по этому заказу проведёнными поступлениями.
	ПолеЗаказа = ПолеСвязиПоступленияСЗаказом();
	Если ПолеЗаказа <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	СУММА(Товары.Количество) КАК Количество
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка.Проведен
		|	И " + ПолеЗаказа + " = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура";
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеПозиции = Результат.Получить(Выборка.Номенклатура);
			Если ДанныеПозиции <> Неопределено Тогда
				ДанныеПозиции.Получено = Выборка.Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Как в этой версии ERP поступление ссылается на заказ:
// в строке товаров или в шапке. Пустая строка - связи нет.
Функция ПолеСвязиПоступленияСЗаказом()

	МетаПоступления = Метаданные.Документы.ПриобретениеТоваровУслуг;
	Если МетаПоступления.ТабличныеЧасти.Товары.Реквизиты.Найти("ЗаказПоставщику") <> Неопределено Тогда
		Возврат "Товары.ЗаказПоставщику";
	ИначеЕсли МетаПоступления.Реквизиты.Найти("ЗаказПоставщику") <> Неопределено Тогда
		Возврат "Товары.Ссылка.ЗаказПоставщику";
	КонецЕсли;
	Возврат "";

КонецФункции

// Все группы цифр из текста без ведущих нулей: "ЗП00-000123 от 01.02" -> ["123", "1", "2"]
Функция ЧислаИзТекста(Текст)

	Результат = Новый Массив;
	Текущее = "";
	Для Позиция = 1 По СтрДлина(Текст) + 1 Цикл
		ОчереднойСимвол = ?(Позиция > СтрДлина(Текст), " ", Сред(Текст, Позиция, 1));
		Если СтрНайти("0123456789", ОчереднойСимвол) > 0 Тогда
			Текущее = Текущее + ОчереднойСимвол;
		ИначеЕсли Текущее <> "" Тогда
			Результат.Добавить(Формат(Число(Текущее), "ЧГ=0; ЧН=0"));
			Текущее = "";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область НовыйПоставщик

// Создаёт партнёра и контрагента по ИНН.
// Наименование, КПП и ОГРН берутся из ЕГРЮЛ через встроенный сервис 1С:Контрагент
// (если он подключён), иначе - из распознанной накладной.
//
// Возвращаемое значение:
//  Структура - Контрагент, Партнер, Пояснение (Строка).
//
Функция СоздатьПоставщика(Знач ИНН, Знач КПП, Знач Наименование) Экспорт

	ИНН = СокрЛП(ИНН);
	КПП = СокрЛП(КПП);
	Если Не ИННКорректен(ИНН) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'ИНН %1 с ошибкой - проверьте его по накладной.'"), ИНН);
	КонецЕсли;

	Существующий = НайтиКонтрагента(ИНН, КПП);
	Если ЗначениеЗаполнено(Существующий) Тогда
		Возврат Новый Структура("Контрагент,Партнер,Пояснение", Существующий, Существующий.Партнер,
			НСтр("ru = 'Поставщик уже был в базе.'"));
	КонецЕсли;

	ЭтоИП = СтрДлина(ИНН) = 12;
	НаименованиеПолное = СокрЛП(Наименование);
	НаименованиеКраткое = НаименованиеПолное;
	ОГРН = "";
	Пояснение = НСтр("ru = 'Поставщик создан по данным накладной - при случае сверьте реквизиты.'");

	Реквизиты = РеквизитыПоИННИзСервиса1С(ИНН, ЭтоИП);
	Если Реквизиты <> Неопределено Тогда
		НаименованиеПолное = ПервоеЗаполненное(Реквизиты, "НаименованиеПолное,ПолноеНаименование,Наименование,ФИО", НаименованиеПолное);
		НаименованиеКраткое = ПервоеЗаполненное(Реквизиты, "НаименованиеСокращенное,СокращенноеНаименование,Наименование,ФИО", НаименованиеПолное);
		Если ПустаяСтрока(КПП) Тогда
			КПП = ПервоеЗаполненное(Реквизиты, "КПП", "");
		КонецЕсли;
		ОГРН = ПервоеЗаполненное(Реквизиты, "ОГРН,ОГРНИП", "");
		Пояснение = НСтр("ru = 'Поставщик создан по данным ЕГРЮЛ (сервис 1С:Контрагент).'");
	КонецЕсли;
	Если ПустаяСтрока(НаименованиеКраткое) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось определить название поставщика. Создайте его вручную.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		МетаПартнера = Метаданные.Справочники.Партнеры;
		Партнер = Справочники.Партнеры.СоздатьЭлемент();
		Партнер.Наименование = НаименованиеКраткое;
		УстановитьЕслиЕсть(Партнер, МетаПартнера, "НаименованиеПолное", НаименованиеПолное);
		УстановитьЕслиЕсть(Партнер, МетаПартнера, "Поставщик", Истина);
		УстановитьЕслиЕсть(Партнер, МетаПартнера, "ДатаРегистрации", ТекущаяДатаСеанса());
		ВидПартнера = ЗначениеПеречисления("КомпанияЧастноеЛицо", "Компания");
		Если ВидПартнера <> Неопределено Тогда
			УстановитьЕслиЕсть(Партнер, МетаПартнера, "ЮрФизЛицо", ВидПартнера);
		КонецЕсли;
		Партнер.Записать();

		// В режиме "партнёр = контрагент" ERP создаёт контрагента сама - тогда дозаполняем его.
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Контрагенты.Ссылка КАК Ссылка
		|ИЗ Справочник.Контрагенты КАК Контрагенты ГДЕ Контрагенты.Партнер = &Партнер");
		Запрос.УстановитьПараметр("Партнер", Партнер.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Контрагент = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
			Контрагент.Наименование = НаименованиеКраткое;
		КонецЕсли;

		МетаКонтрагента = Метаданные.Справочники.Контрагенты;
		УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "Партнер", Партнер.Ссылка);
		УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "НаименованиеПолное", НаименованиеПолное);
		УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "ИНН", ИНН);
		Если Не ЭтоИП Тогда
			УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "КПП", КПП);
		КонецЕсли;
		Если Не ПустаяСтрока(ОГРН) Тогда
			УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "РегистрационныйНомер", ОГРН);
			УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "ОГРН", ОГРН);
		КонецЕсли;
		ВидКонтрагента = ЗначениеПеречисления("ЮрФизЛицо", ?(ЭтоИП, "ИндивидуальныйПредприниматель", "ЮрЛицо"));
		Если ВидКонтрагента <> Неопределено Тогда
			УстановитьЕслиЕсть(Контрагент, МетаКонтрагента, "ЮрФизЛицо", ВидКонтрагента);
		КонецЕсли;
		Контрагент.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение НСтр("ru = 'Не удалось создать поставщика автоматически, создайте его вручную. Причина: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Новый Структура("Контрагент,Партнер,Пояснение", Контрагент.Ссылка, Партнер.Ссылка, Пояснение);

КонецФункции

