#КонецОбласти

#Область Яндекс

// Распознавание через Yandex Cloud:
//  1) Vision OCR читает текст и таблицы с каждой страницы;
//  2) YandexGPT раскладывает прочитанный текст по полям накладной (та же схема, что для Claude).
//
Функция РаспознатьЧерезЯндекс(Файлы, Настройки)

	Если ПустаяСтрока(Настройки.ЯндексКлючAPI) Или ПустаяСтрока(Настройки.ЯндексКаталог) Тогда
		ВызватьИсключение НСтр("ru = 'Не заданы ключ API и идентификатор каталога Yandex Cloud. Укажите их на закладке ""Настройки"".'");
	КонецЕсли;
	Если Файлы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Добавьте хотя бы одно фото или скан накладной.'");
	КонецЕсли;

	// 1. OCR
	Части = Новый Массив;
	НомерСтраницы = 0;
	Для Каждого Файл Из Файлы Цикл
		НомерСтраницы = НомерСтраницы + 1;
		Части.Добавить(ТекстСтраницыЯндексOCR(Файл, НомерСтраницы, Настройки));
	КонецЦикла;
	ТекстНакладной = СтрСоединить(Части, Символы.ПС + Символы.ПС);
	Если ПустаяСтрока(СокрЛП(ТекстНакладной)) Тогда
		ВызватьИсключение НСтр("ru = 'На фото не удалось прочитать текст. Сфотографируйте накладную ровнее и при хорошем освещении.'");
	КонецЕсли;

	// 2. YandexGPT
	ТекстJSON = РазобратьТекстЯндексGPT(ТекстНакладной, Настройки);
	Данные = ПрочитатьJSONИзСтроки(ВырезатьJSON(ТекстJSON));
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение НСтр("ru = 'YandexGPT вернул ответ не в том формате. Попробуйте ещё раз.'");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("ТекстОтвета", "=== Прочитано с фото (Vision OCR) ===" + Символы.ПС + ТекстНакладной
		+ Символы.ПС + Символы.ПС + "=== Разбор (YandexGPT) ===" + Символы.ПС + ТекстJSON);
	Результат.Вставить("Модель", Настройки.ЯндексМодель);
	Возврат Результат;

КонецФункции

Функция ТекстСтраницыЯндексOCR(Файл, НомерСтраницы, Настройки)

	ЧастиИмени = СтрРазделить(Файл.Имя, ".");
	Расширение = НРег(ЧастиИмени[ЧастиИмени.ВГраница()]);
	ТипыФайлов = Новый Соответствие;
	ТипыФайлов.Вставить("jpg", "JPEG");
	ТипыФайлов.Вставить("jpeg", "JPEG");
	ТипыФайлов.Вставить("png", "PNG");
	ТипыФайлов.Вставить("pdf", "PDF");
	ТипФайла = ТипыФайлов.Получить(Расширение);
	Если ТипФайла = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Формат файла %1 не поддерживается Яндексом. Используйте JPG, PNG или PDF (фото HEIC с iPhone сохраните как JPG).'"),
			Файл.Имя);
	КонецЕсли;
	Если Файл.ДвоичныеДанные.Размер() > 10 * 1024 * 1024 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Файл %1 больше 10 МБ - уменьшите фото.'"), Файл.Имя);
	КонецЕсли;

	Base64 = Base64Строка(Файл.ДвоичныеДанные);
	Base64 = СтрЗаменить(СтрЗаменить(Base64, Символы.ВК, ""), Символы.ПС, "");

	Языки = Новый Массив;
	Языки.Добавить("ru");
	Языки.Добавить("en");

	// Весь текст страницы (реквизиты, шапка, итоги)
	Тело = Новый Структура("mimeType,languageCodes,model,content", ТипФайла, Языки, "page", Base64);
	Ответ = ЗапросЯндекс("https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText", Тело, Настройки);
	Аннотация = АннотацияOCR(Ответ);
	ПолныйТекст = "";
	Если Аннотация <> Неопределено И ТипЗнч(Аннотация.Получить("fullText")) = Тип("Строка") Тогда
		ПолныйТекст = Аннотация.Получить("fullText");
	КонецЕсли;

	// Таблица товаров по ячейкам: так строки накладной не перемешиваются.
	ТекстТаблиц = "";
	Попытка
		Тело.model = "table";
		Ответ = ЗапросЯндекс("https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText", Тело, Настройки);
		ТекстТаблиц = ТаблицыOCRВТекст(АннотацияOCR(Ответ));
	Исключение
		// Таблицы - дополнительная подсказка; без них YandexGPT справится по полному тексту.
		ЗаписьЖурналаРегистрации("ЗагрузкаНакладнойПоФото", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Текст = СтрШаблон("=== Страница %1 (файл %2): весь текст ===", НомерСтраницы, Файл.Имя) + Символы.ПС + ПолныйТекст;
	Если Не ПустаяСтрока(ТекстТаблиц) Тогда
		Текст = Текст + Символы.ПС + СтрШаблон("=== Страница %1: таблицы по ячейкам ===", НомерСтраницы)
			+ Символы.ПС + ТекстТаблиц;
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция АннотацияOCR(Ответ)

	Результат = Ответ.Получить("result");
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Аннотация = Результат.Получить("textAnnotation");
	Возврат ?(ТипЗнч(Аннотация) = Тип("Соответствие"), Аннотация, Неопределено);

КонецФункции

// Таблицы из ответа OCR -> строки вида "| ячейка | ячейка |".
Функция ТаблицыOCRВТекст(Аннотация)

	Если Аннотация = Неопределено Или ТипЗнч(Аннотация.Получить("tables")) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Строки = Новый Массив;
	НомерТаблицы = 0;
	Для Каждого Таблица Из Аннотация.Получить("tables") Цикл
		НомерТаблицы = НомерТаблицы + 1;
		Ячейки = Таблица.Получить("cells");
		Если ТипЗнч(Ячейки) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		ПоСтрокам = Новый Соответствие;
		МаксСтрока = -1;
		МаксКолонка = -1;
		Для Каждого Ячейка Из Ячейки Цикл
			НомерСтрокиЯчейки = ЧислоИзJSON(Ячейка.Получить("rowIndex"));
			НомерКолонкиЯчейки = ЧислоИзJSON(Ячейка.Получить("columnIndex"));
			ТекстЯчейки = СтрЗаменить(СтрЗаменить(Строка(Ячейка.Получить("text")), Символы.ПС, " "), "|", "/");
			ПоСтрокам.Вставить(Формат(НомерСтрокиЯчейки, "ЧН=0; ЧГ=0") + ":" + Формат(НомерКолонкиЯчейки, "ЧН=0; ЧГ=0"), ТекстЯчейки);
			МаксСтрока = Макс(МаксСтрока, НомерСтрокиЯчейки);
			МаксКолонка = Макс(МаксКолонка, НомерКолонкиЯчейки);
		КонецЦикла;
		Строки.Добавить(СтрШаблон("Таблица %1:", НомерТаблицы));
		Для ИндексСтроки = 0 По МаксСтрока Цикл
			Значения = Новый Массив;
			Для ИндексКолонки = 0 По МаксКолонка Цикл
				ЗначениеЯчейки = ПоСтрокам.Получить(Формат(ИндексСтроки, "ЧН=0; ЧГ=0") + ":" + Формат(ИндексКолонки, "ЧН=0; ЧГ=0"));
				Значения.Добавить(?(ЗначениеЯчейки = Неопределено, "", СокрЛП(ЗначениеЯчейки)));
			КонецЦикла;
			Строки.Добавить("| " + СтрСоединить(Значения, " | ") + " |");
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция РазобратьТекстЯндексGPT(ТекстНакладной, Настройки)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role,text", "system", СистемныйПромпт() + Символы.ПС + Символы.ПС + "Данные ниже получены программой распознавания текста (OCR) с фото накладной: сначала весь текст страницы,
		|затем таблицы по ячейкам (строка таблицы = строка накладной). OCR мог ошибиться в отдельных символах -
		|сверяй ИНН (10 или 12 цифр), количество * цену = сумму.
		|Ответь только JSON-объектом, без пояснений и без разметки, строго по этой JSON-схеме:
		|" + ЗаписатьJSONВСтроку(СхемаОтвета())));
	Сообщения.Добавить(Новый Структура("role,text", "user", ТекстНакладной));

	Модель = СокрЛП(Настройки.ЯндексМодель);
	Если ПустаяСтрока(Модель) Тогда
		Модель = "yandexgpt/latest";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("modelUri", "gpt://" + СокрЛП(Настройки.ЯндексКаталог) + "/" + Модель);
	Тело.Вставить("completionOptions", Новый Структура("stream,temperature,maxTokens", Ложь, 0.1, "8000"));
	Тело.Вставить("messages", Сообщения);
	Тело.Вставить("jsonSchema", Новый Структура("schema", СхемаОтвета()));

	Адрес = "https://llm.api.cloud.yandex.net/foundationModels/v1/completion";
	Попытка
		Ответ = ЗапросЯндекс(Адрес, Тело, Настройки);
	Исключение
		// Если модель или каталог не поддерживают структурированный вывод - просим просто JSON.
		Тело.Удалить("jsonSchema");
		Тело.Вставить("jsonObject", Истина);
		Ответ = ЗапросЯндекс(Адрес, Тело, Настройки);
	КонецПопытки;

	Результат = Ответ.Получить("result");
	Если ТипЗнч(Результат) = Тип("Соответствие") И ТипЗнч(Результат.Получить("alternatives")) = Тип("Массив")
		И Результат.Получить("alternatives").Количество() > 0 Тогда
		Альтернатива = Результат.Получить("alternatives")[0];
		Сообщение = Альтернатива.Получить("message");
		Если ТипЗнч(Сообщение) = Тип("Соответствие") И ТипЗнч(Сообщение.Получить("text")) = Тип("Строка") Тогда
			Если Альтернатива.Получить("status") = "ALTERNATIVE_STATUS_TRUNCATED_FINAL" Тогда
				ВызватьИсключение НСтр("ru = 'Ответ YandexGPT не поместился в лимит. Загружайте накладную по одной-две страницы.'");
			КонецЕсли;
			Возврат Сообщение.Получить("text");
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение НСтр("ru = 'YandexGPT вернул пустой ответ. Попробуйте ещё раз.'");

КонецФункции

Функция ЗапросЯндекс(Адрес, Тело, Настройки)

	Части = РазобратьАдрес(Адрес);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Api-Key " + СокрЛП(Настройки.ЯндексКлючAPI));
	Заголовки.Вставить("x-folder-id", СокрЛП(Настройки.ЯндексКаталог));

	Соединение = Новый HTTPСоединение(Части.Хост, Части.Порт, , , Новый ИнтернетПрокси(Истина),
		Настройки.ТаймаутСекунд, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос(Части.Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(Тело), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер 1С не смог подключиться к %1: %2'"),
			Части.Хост, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния <> 200 Тогда
		Сообщение = Лев(ТекстОтвета, 500);
		Попытка
			ДанныеОшибки = ПрочитатьJSONИзСтроки(ТекстОтвета);
			Если ТипЗнч(ДанныеОшибки) = Тип("Соответствие") Тогда
				Ошибка = ДанныеОшибки.Получить("error");
				Если ТипЗнч(Ошибка) = Тип("Соответствие") И Ошибка.Получить("message") <> Неопределено Тогда
					Сообщение = Строка(Ошибка.Получить("message"));
				ИначеЕсли ДанныеОшибки.Получить("message") <> Неопределено Тогда
					Сообщение = Строка(ДанныеОшибки.Получить("message"));
				КонецЕсли;
			КонецЕсли;
		Исключение
			// оставляем сырой текст
		КонецПопытки;
		Если Ответ.КодСостояния = 401 Или Ответ.КодСостояния = 403 Тогда
			Пояснение = НСтр("ru = 'неверный ключ API или у сервисного аккаунта нет ролей ai.vision.user и ai.languageModels.user'");
		ИначеЕсли Ответ.КодСостояния = 429 Тогда
			Пояснение = НСтр("ru = 'превышен лимит запросов, повторите через минуту'");
		ИначеЕсли Ответ.КодСостояния >= 500 Тогда
			Пояснение = НСтр("ru = 'сервис временно недоступен, повторите позже'");
		Иначе
			Пояснение = НСтр("ru = 'ошибка запроса'");
		КонецЕсли;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Yandex Cloud вернул код %1 (%2): %3'"), Ответ.КодСостояния, Пояснение, Сообщение);
	КонецЕсли;
	Возврат ПрочитатьJSONИзСтроки(ТекстОтвета);

КонецФункции

// Текст от "{" до последней "}" - на случай, если модель обернула JSON в ```json ... ```.
Функция ВырезатьJSON(Текст)

	Начало = СтрНайти(Текст, "{");
	Конец = СтрНайти(Текст, "}", НаправлениеПоиска.СКонца);
	Если Начало = 0 Или Конец < Начало Тогда
		ВызватьИсключение НСтр("ru = 'YandexGPT не вернул данные накладной. Попробуйте ещё раз или сделайте фото чётче.'");
	КонецЕсли;
	Возврат Сред(Текст, Начало, Конец - Начало + 1);

КонецФункции

Функция ЧислоИзJSON(ЗначениеЯчейки)

	Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		Возврат ЗначениеЯчейки;
	КонецЕсли;
	Попытка
		Возврат Число(ЗначениеЯчейки);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

