#Область ЗагрузкаXML

// Истина, если файл - XML или ZIP (электронный УПД от поставщика или оператора ЭДО).
Функция ЭтоФайлXML(ИмяФайла) Экспорт

	Имя = НРег(ИмяФайла);
	Возврат СтрЗаканчиваетсяНа(Имя, ".xml") Или СтрЗаканчиваетсяНа(Имя, ".zip");

КонецФункции

// Читает УПД / счёт-фактуру в формате ФНС (файл ON_NSCHFDOPPR_... или ON_NSCHFDOPPOK_...).
// Распознавание не нужно: данные берутся из файла как есть, бесплатно и без ошибок.
// Возвращает ту же структуру, что и распознавание фото.
//
Функция ЗагрузитьУПДИзXML(Файлы)

	Проблемы = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Если Не ЭтоФайлXML(Файл.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ФайлXML Из ФайлыXMLИзФайла(Файл) Цикл
			Попытка
				ДокументDOM = ПрочитатьDOM(ФайлXML.ДвоичныеДанные);
			Исключение
				Проблемы.Добавить(ФайлXML.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			Если ДокументDOM.ПолучитьЭлементыПоИмени("СведТов").Количество() = 0 Тогда
				Продолжить; // подпись, квитанция или другой документ без товаров
			КонецЕсли;

			Результат = Новый Структура;
			Результат.Вставить("Данные", ДанныеИзУПД(ДокументDOM));
			Результат.Вставить("ТекстОтвета", СтрШаблон(НСтр("ru = 'Загружено из XML-файла %1 - распознавание не требовалось.'"), ФайлXML.Имя));
			Результат.Вставить("Модель", "XML");
			Возврат Результат;
		КонецЦикла;
	КонецЦикла;

	Текст = НСтр("ru = 'В выбранных файлах не найден УПД или счёт-фактура в формате налоговой (XML-файл с именем ON_NSCHFDOPPR_... или ON_NSCHFDOPPOK_...).
		|Попросите поставщика прислать УПД ""в формате XML для загрузки в 1С"".'");
	Если Проблемы.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.ПС + СтрСоединить(Проблемы, Символы.ПС);
	КонецЕсли;
	ВызватьИсключение Текст;

КонецФункции

Функция ДанныеИзУПД(ДокументDOM)

	СвСчФакт = ПервыйЭлемент(ДокументDOM, "СвСчФакт");
	Корень = ?(СвСчФакт = Неопределено, ДокументDOM, СвСчФакт);

	Номер = Атрибут(СвСчФакт, "НомерСчФ,НомерДок");
	ДатаСтрокой = Атрибут(СвСчФакт, "ДатаСчФ,ДатаДок");
	Если ПустаяСтрока(Номер) Тогда
		ДокОтгрузки = ПервыйЭлемент(ДокументDOM, "ДокПодтвОтгр");
		Номер = Атрибут(ДокОтгрузки, "НомДокОтгр,РеквНомерДок");
		Если ПустаяСтрока(ДатаСтрокой) Тогда
			ДатаСтрокой = Атрибут(ДокОтгрузки, "ДатаДокОтгр,РеквДатаДок");
		КонецЕсли;
	КонецЕсли;

	Продавец = УчастникУПД(ПервыйЭлемент(Корень, "СвПрод"));
	Покупатель = УчастникУПД(ПервыйЭлемент(Корень, "СвПокуп"));

	КодВалюты = Атрибут(СвСчФакт, "КодОКВ");
	Если ПустаяСтрока(КодВалюты) Тогда
		КодВалюты = Атрибут(ПервыйЭлемент(ДокументDOM, "ДенИзм"), "КодОКВ");
	КонецЕсли;

	// Основание (договор, заказ) - для подбора заказа поставщику по номеру.
	Основания = Новый Массив;
	Для Каждого ИмяЭлемента Из СтрРазделить("ОснПер,РеквОснПер,ОснованиеПер", ",") Цикл
		Список = ДокументDOM.ПолучитьЭлементыПоИмени(ИмяЭлемента);
		Для Индекс = 0 По Список.Количество() - 1 Цикл
			Элемент = Список.Элемент(Индекс);
			// Номер и дату добавляем, только если их ещё нет в наименовании основания.
			ТекстОснования = Атрибут(Элемент, "НаимОсн,РеквНаимДок");
			НомерОснования = Атрибут(Элемент, "НомОсн,РеквНомерДок");
			Если Не ПустаяСтрока(НомерОснования) И СтрНайти(ТекстОснования, НомерОснования) = 0 Тогда
				ТекстОснования = ТекстОснования + " № " + НомерОснования;
			КонецЕсли;
			ДатаОснования = Атрибут(Элемент, "ДатаОсн,РеквДатаДок");
			Если Не ПустаяСтрока(ДатаОснования) И СтрНайти(ТекстОснования, ДатаОснования) = 0 Тогда
				ТекстОснования = ТекстОснования + " " + НСтр("ru = 'от'") + " " + ДатаОснования;
			КонецЕсли;
			ТекстОснования = СокрЛП(ТекстОснования);
			// Одно и то же основание бывает записано в нескольких местах файла.
			ЕстьТакое = Ложь;
			Для Каждого Записанное Из Основания Цикл
				Если СтрНайти(Записанное, ТекстОснования) > 0 Или СтрНайти(ТекстОснования, Записанное) > 0 Тогда
					ЕстьТакое = Истина;
				КонецЕсли;
			КонецЦикла;
			Если Не ПустаяСтрока(ТекстОснования) И Не ЕстьТакое Тогда
				Основания.Добавить(ТекстОснования);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Строки товаров
	Позиции = Новый Массив;
	СписокСтрок = ДокументDOM.ПолучитьЭлементыПоИмени("СведТов");
	Для Индекс = 0 По СписокСтрок.Количество() - 1 Цикл
		Товар = СписокСтрок.Элемент(Индекс);
		ДопСведения = ПервыйЭлемент(Товар, "ДопСведТов");

		Количество = ЧислоИзАтрибута(Атрибут(Товар, "КолТов"));
		Цена = ЧислоИзАтрибута(Атрибут(Товар, "ЦенаТов"));
		СуммаБезНДС = ЧислоИзАтрибута(Атрибут(Товар, "СтТовБезНДС"));
		Если СуммаБезНДС = 0 Тогда
			СуммаБезНДС = Окр(Количество * Цена, 2);
		КонецЕсли;
		СуммаНДС = СуммаНДСИзУПД(Товар);
		СуммаСНДС = ЧислоИзАтрибута(Атрибут(Товар, "СтТовУчНал"));
		Если СуммаСНДС = 0 Тогда
			СуммаСНДС = СуммаБезНДС + СуммаНДС;
		КонецЕсли;
		Если Цена = 0 И Количество <> 0 Тогда
			Цена = Окр(СуммаБезНДС / Количество, 2);
		КонецЕсли;

		ЕдиницаИзмерения = Атрибут(ДопСведения, "НаимЕдИзм");
		Если ПустаяСтрока(ЕдиницаИзмерения) Тогда
			ЕдиницаИзмерения = Атрибут(Товар, "НаимЕдИзм");
		КонецЕсли;
		Если ПустаяСтрока(ЕдиницаИзмерения) Тогда
			ЕдиницаИзмерения = ЕдиницаПоОКЕИ(Атрибут(Товар, "ОКЕИ_Тов"));
		КонецЕсли;

		Позиция = Новый Соответствие;
		Позиция.Вставить("line_no", ЧислоИзАтрибута(Атрибут(Товар, "НомСтр")));
		Позиция.Вставить("article", Атрибут(ДопСведения, "АртикулТов,КодТов"));
		Позиция.Вставить("name", Атрибут(Товар, "НаимТов"));
		Позиция.Вставить("unit", ЕдиницаИзмерения);
		Позиция.Вставить("quantity", Количество);
		Позиция.Вставить("price", Цена);
		Позиция.Вставить("sum_without_vat", СуммаБезНДС);
		Позиция.Вставить("vat_rate", Атрибут(Товар, "НалСт"));
		Позиция.Вставить("vat_sum", СуммаНДС);
		Позиция.Вставить("sum_with_vat", СуммаСНДС);
		Позиции.Добавить(Позиция);
	КонецЦикла;

	// Итоги
	Итоги = ПервыйЭлемент(ДокументDOM, "ВсегоОпл");
	ИтогБезНДС = ЧислоИзАтрибута(Атрибут(Итоги, "СтТовБезНДСВсего"));
	ИтогСНДС = ЧислоИзАтрибута(Атрибут(Итоги, "СтТовУчНалВсего"));
	ИтогНДС = 0;
	Если Итоги <> Неопределено Тогда
		ИтогНДС = СуммаНДСИзУПД(Итоги, "СумНалВсего");
	КонецЕсли;

	Замечания = Новый Массив;
	Замечания.Добавить(НСтр("ru = 'Данные взяты из XML-файла УПД - распознавание не требовалось, цифры точные.'"));

	Данные = Новый Соответствие;
	Данные.Вставить("doc_kind", НСтр("ru = 'УПД (XML)'"));
	Данные.Вставить("doc_number", Номер);
	Данные.Вставить("doc_date", ДатаИзУПД(ДатаСтрокой));
	Данные.Вставить("order_basis", СтрСоединить(Основания, "; "));
	Данные.Вставить("supplier_name", Продавец.Наименование);
	Данные.Вставить("supplier_inn", Продавец.ИНН);
	Данные.Вставить("supplier_kpp", Продавец.КПП);
	Данные.Вставить("buyer_name", Покупатель.Наименование);
	Данные.Вставить("buyer_inn", Покупатель.ИНН);
	Данные.Вставить("buyer_kpp", Покупатель.КПП);
	Данные.Вставить("currency", ?(КодВалюты = "643" Или ПустаяСтрока(КодВалюты), "RUB", КодВалюты));
	Данные.Вставить("prices_include_vat", Ложь); // в УПД цена всегда без НДС
	Данные.Вставить("total_without_vat", ИтогБезНДС);
	Данные.Вставить("total_vat", ИтогНДС);
	Данные.Вставить("total_with_vat", ИтогСНДС);
	Данные.Вставить("items", Позиции);
	Данные.Вставить("warnings", Замечания);
	Возврат Данные;

КонецФункции

// Продавец или покупатель: организация (СвЮЛУч) или ИП (СвИП).
Функция УчастникУПД(Элемент)

	Результат = Новый Структура("Наименование,ИНН,КПП", "", "", "");
	Если Элемент = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ЮрЛицо = ПервыйЭлемент(Элемент, "СвЮЛУч");
	Если ЮрЛицо <> Неопределено Тогда
		Результат.Наименование = Атрибут(ЮрЛицо, "НаимОрг");
		Результат.ИНН = Атрибут(ЮрЛицо, "ИННЮЛ");
		Результат.КПП = Атрибут(ЮрЛицо, "КПП");
		Возврат Результат;
	КонецЕсли;

	Предприниматель = ПервыйЭлемент(Элемент, "СвИП");
	Если Предприниматель <> Неопределено Тогда
		Результат.ИНН = Атрибут(Предприниматель, "ИННФЛ");
		ФИО = ПервыйЭлемент(Предприниматель, "ФИО");
		Результат.Наименование = СокрЛП(НСтр("ru = 'ИП'") + " " + Атрибут(ФИО, "Фамилия") + " "
			+ Атрибут(ФИО, "Имя") + " " + Атрибут(ФИО, "Отчество"));
		Возврат Результат;
	КонецЕсли;

	// Иностранная организация и прочие варианты - берём что есть.
	Попытка
		Список = Элемент.ПолучитьЭлементыПоИмени("*");
		Для Индекс = 0 По Список.Количество() - 1 Цикл
			Вложенный = Список.Элемент(Индекс);
			Если ПустаяСтрока(Результат.Наименование) Тогда
				Результат.Наименование = Атрибут(Вложенный, "НаимОрг,НаимОргПолн");
			КонецЕсли;
			Если ПустаяСтрока(Результат.ИНН) Тогда
				Результат.ИНН = Атрибут(Вложенный, "ИННЮЛ,ИННФЛ,ИНН");
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Наименование и ИНН можно будет заполнить вручную.
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Сумма НДС строки или итога: <СумНал><СумНал>123.45</СумНал></СумНал> или <СумНал><БезНДС>без НДС</БезНДС></СумНал>.
Функция СуммаНДСИзУПД(Элемент, ИмяЭлемента = "СумНал")

	Внешний = ПервыйЭлемент(Элемент, ИмяЭлемента);
	Если Внешний = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Внутренний = ПервыйЭлемент(Внешний, "СумНал");
	Текст = ?(Внутренний = Неопределено, Внешний.ТекстовоеСодержимое, Внутренний.ТекстовоеСодержимое);
	Возврат ЧислоИзАтрибута(Текст);

КонецФункции

Функция ФайлыXMLИзФайла(Файл)

	Результат = Новый Массив;
	Если Не СтрЗаканчиваетсяНа(НРег(Файл.Имя), ".zip") Тогда
		Результат.Добавить(Файл);
		Возврат Результат;
	КонецЕсли;

	// Архив от оператора ЭДО: внутри XML документа, подписи и квитанции.
	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
	Каталог = ПолучитьИмяВременногоФайла("upd");
	Файл.ДвоичныеДанные.Записать(ИмяАрхива);
	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		Архив.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		Архив.Закрыть();
		Для Каждого Найденный Из НайтиФайлы(Каталог, "*.xml", Истина) Цикл
			Результат.Добавить(Новый Структура("Имя,ДвоичныеДанные", Найденный.Имя, Новый ДвоичныеДанные(Найденный.ПолноеИмя)));
		КонецЦикла;
	Исключение
		УдалитьФайлы(ИмяАрхива);
		УдалитьФайлы(Каталог);
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось открыть архив %1: %2'"), Файл.Имя,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьФайлы(ИмяАрхива);
	УдалитьФайлы(Каталог);

	// Файлы УПД - первыми.
	Упорядоченные = Новый Массив;
	Для Каждого ФайлXML Из Результат Цикл
		Если СтрНачинаетсяС(ВРег(ФайлXML.Имя), "ON_NSCHF") Тогда
			Упорядоченные.Добавить(ФайлXML);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ФайлXML Из Результат Цикл
		Если Не СтрНачинаетсяС(ВРег(ФайлXML.Имя), "ON_NSCHF") Тогда
			Упорядоченные.Добавить(ФайлXML);
		КонецЕсли;
	КонецЦикла;
	Возврат Упорядоченные;

КонецФункции

// Кодировку (обычно windows-1251) ЧтениеXML берёт из заголовка файла.
Функция ПрочитатьDOM(ДвоичныеДанные)

	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяФайла);
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ИмяФайла);
		Построитель = Новый ПостроительDOM;
		ДокументDOM = Построитель.Прочитать(Чтение);
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			Чтение.Закрыть();
		Исключение
			// файл мог не открыться
		КонецПопытки;
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	УдалитьФайлы(ИмяФайла);
	Возврат ДокументDOM;

КонецФункции

Функция ПервыйЭлемент(Узел, Имя)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Список = Узел.ПолучитьЭлементыПоИмени(Имя);
	Возврат ?(Список.Количество() = 0, Неопределено, Список.Элемент(0));

КонецФункции

// Значение первого заполненного атрибута из списка имён (разные версии формата УПД называют их по-разному).
Функция Атрибут(Элемент, ИменаАтрибутов)

	Если Элемент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(ИменаАтрибутов, ",") Цикл
		Если Элемент.ЕстьАтрибут(Имя) И Не ПустаяСтрока(Элемент.ПолучитьАтрибут(Имя)) Тогда
			Возврат СокрЛП(Элемент.ПолучитьАтрибут(Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЧислоИзАтрибута(Знач Текст)

	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), ",", "."), " ", "");
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0; // "без НДС" и т.п.
	КонецПопытки;

КонецФункции

// "24.11.2026" -> "2026-11-24" (так даты приходят и из распознавания фото)
Функция ДатаИзУПД(ДатаСтрокой)

	Части = СтрРазделить(СокрЛП(ДатаСтрокой), ".");
	Если Части.Количество() <> 3 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Части[2] + "-" + Части[1] + "-" + Части[0];

КонецФункции

