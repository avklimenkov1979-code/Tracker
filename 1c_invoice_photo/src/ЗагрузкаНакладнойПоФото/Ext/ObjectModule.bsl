Функция КонтрольнаяЦифраИНН(Цифры, ВесаСтрокой)

	Сумма = 0;
	Веса = СтрРазделить(ВесаСтрокой, ",");
	Для Индекс = 0 По Веса.ВГраница() Цикл
		Сумма = Сумма + Цифры[Индекс] * Число(Веса[Индекс]);
	КонецЦикла;
	Возврат Сумма % 11 % 10;

КонецФункции

// Реквизиты из ЕГРЮЛ/ЕГРИП через сервис 1С:Контрагент (Библиотека интернет-поддержки).
// Если сервис не подключён или не ответил - Неопределено, тогда берём данные из накладной.
Функция РеквизитыПоИННИзСервиса1С(ИНН, ЭтоИП)

	Если Метаданные.ОбщиеМодули.Найти("РаботаСКонтрагентами") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяФункции = ?(ЭтоИП, "РеквизитыПредпринимателяПоИНН", "РеквизитыЮридическогоЛицаПоИНН");
	Попытка
		Результат = Вычислить("РаботаСКонтрагентами." + ИмяФункции + "(ИНН)");
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаНакладнойПоФото", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Результат.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПервоеЗаполненное(Данные, ИменаСвойств, ПоУмолчанию)

	Для Каждого Имя Из СтрРазделить(ИменаСвойств, ",") Цикл
		ЗначениеЯчейки = Неопределено;
		Если Данные.Свойство(Имя, ЗначениеЯчейки) И ТипЗнч(ЗначениеЯчейки) = Тип("Строка") И Не ПустаяСтрока(ЗначениеЯчейки) Тогда
			Возврат СокрЛП(ЗначениеЯчейки);
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;

КонецФункции

Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения)

	МетаПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаПеречисления = Неопределено
		Или МетаПеречисления.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];

