// Загрузка накладной по фото (1С:ERP 2.5)
//
// Фото или скан накладной (ТОРГ-12, УПД, счёт-фактура, товарная накладная)
// отправляется в Claude API. Модель возвращает JSON строго по схеме,
// обработка находит контрагента, организацию и номенклатуру и создаёт
// документ «Приобретение товаров и услуг» (записывается без проведения).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область Настройки

Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("АдресAPI", "https://api.anthropic.com");
	Настройки.Вставить("КлючAPI", "");
	Настройки.Вставить("Модель", "claude-opus-5-5");
	// Уровень рассуждений модели: low, medium, high, xhigh, max.
	// high - хороший баланс точности чтения цифр и времени ответа.
	Настройки.Вставить("УровеньУсилий", "high");
	// При отказе основной модели запрос автоматически повторяется на резервной.
	Настройки.Вставить("РезервнаяМодель", Истина);
	Настройки.Вставить("ТаймаутСекунд", 300);
	Возврат Настройки;

КонецФункции

Функция ЗагрузитьНастройки() Экспорт

	Настройки = НастройкиПоУмолчанию();
	Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючХранилища(), "Настройки");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Сохраненные);
	КонецЕсли;
	Возврат Настройки;

КонецФункции

Процедура СохранитьНастройки(Настройки) Экспорт

	ХранилищеОбщихНастроек.Сохранить(КлючХранилища(), "Настройки", Настройки);

КонецПроцедуры

#КонецОбласти

#Область Распознавание

// Отправляет файлы в Claude API и возвращает распознанные данные накладной.
//
// Параметры:
//  Файлы - Массив из Структура - Имя (Строка), ДвоичныеДанные (ДвоичныеДанные).
//          Несколько файлов = несколько страниц одной накладной.
//  Настройки - Структура - см. НастройкиПоУмолчанию().
//
// Возвращаемое значение:
//  Структура - Данные (Соответствие - разобранный JSON по схеме СхемаОтвета()),
//              ТекстОтвета (Строка - исходный JSON для отладки),
//              Модель (Строка - какая модель фактически ответила).
//
Функция РаспознатьНакладную(Файлы, Настройки) Экспорт

	Если Не ЗначениеЗаполнено(Настройки.КлючAPI) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан ключ API. Укажите его на закладке ""Настройки"".'");
	КонецЕсли;
	Если Файлы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Добавьте хотя бы одно фото или скан накладной.'");
	КонецЕсли;

	Содержимое = Новый Массив;
	НомерСтраницы = 0;
	Для Каждого Файл Из Файлы Цикл
		НомерСтраницы = НомерСтраницы + 1;
		Если Файлы.Количество() > 1 Тогда
			Содержимое.Добавить(БлокТекста(СтрШаблон("Страница %1 (файл %2):", НомерСтраницы, Файл.Имя)));
		КонецЕсли;
		Содержимое.Добавить(БлокФайла(Файл));
	КонецЦикла;
	Содержимое.Добавить(БлокТекста(ТекстЗадания()));

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role,content", "user", Содержимое));

	ФорматОтвета = Новый Структура("type,schema", "json_schema", СхемаОтвета());

	Тело = Новый Структура;
	Тело.Вставить("model", Настройки.Модель);
	Тело.Вставить("max_tokens", 16000);
	Тело.Вставить("system", СистемныйПромпт());
	Тело.Вставить("messages", Сообщения);
	Тело.Вставить("output_config", Новый Структура("effort,format", Настройки.УровеньУсилий, ФорматОтвета));
	Если Настройки.РезервнаяМодель Тогда
		Тело.Вставить("fallbacks", "default");
	КонецЕсли;

	Ответ = ВыполнитьЗапросAPI(Тело, Настройки);

	ПричинаОстановки = Ответ.Получить("stop_reason");
	Если ПричинаОстановки = "refusal" Тогда
		ВызватьИсключение НСтр("ru = 'Модель отказалась обрабатывать изображение. Проверьте, что на фото именно накладная.'");
	ИначеЕсли ПричинаОстановки = "max_tokens" Тогда
		ВызватьИсключение НСтр("ru = 'Ответ модели не поместился в лимит. Разбейте накладную на несколько загрузок по страницам.'");
	КонецЕсли;

	ТекстJSON = "";
	Блоки = Ответ.Получить("content");
	Если ТипЗнч(Блоки) = Тип("Массив") Тогда
		Для Каждого Блок Из Блоки Цикл
			Если Блок.Получить("type") = "text" Тогда
				ТекстJSON = ТекстJSON + Блок.Получить("text");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ПустаяСтрока(ТекстJSON) Тогда
		ВызватьИсключение НСтр("ru = 'Модель вернула пустой ответ.'");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Данные", ПрочитатьJSONИзСтроки(ТекстJSON));
	Результат.Вставить("ТекстОтвета", ТекстJSON);
	Результат.Вставить("Модель", Строка(Ответ.Получить("model")));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Сопоставление

Функция НайтиКонтрагента(ИНН, КПП = "") Экспорт

	Если ПустаяСтрока(ИНН) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Контрагенты.КПП = &КПП
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("КПП", СокрЛП(КПП));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

