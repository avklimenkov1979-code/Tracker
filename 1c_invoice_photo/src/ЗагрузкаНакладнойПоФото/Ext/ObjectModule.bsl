Функция ЧислоИзНачалаСтроки(Текст)

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		ОчереднойСимвол = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", ОчереднойСимвол) > 0 Тогда
			Цифры = Цифры + ОчереднойСимвол;
		ИначеЕсли Не ПустаяСтрока(Цифры) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Цифры), Неопределено, Число(Цифры));

