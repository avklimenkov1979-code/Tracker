#Область ЗапросКAPI

Функция ВыполнитьЗапросAPI(Тело, Настройки)

	Адрес = РазобратьАдрес(Настройки.АдресAPI);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("x-api-key", СокрЛП(Настройки.КлючAPI));
	Заголовки.Вставить("anthropic-version", "2026-10-21");
	Если Настройки.РезервнаяМодель Тогда
		Заголовки.Вставить("anthropic-beta", "server-side-fallback-2026-07-01");
	КонецЕсли;

	ЗащищенноеСоединение = ?(Адрес.HTTPS, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , Новый ИнтернетПрокси(Истина),
		Настройки.ТаймаутСекунд, ЗащищенноеСоединение);

	Запрос = Новый HTTPЗапрос(Адрес.Путь + "/v1/messages", Заголовки);
	Запрос.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(Тело), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось подключиться к %1: %2'"),
			Адрес.Хост, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОписаниеОшибкиAPI(Ответ.КодСостояния, ТекстОтвета);
	КонецЕсли;

	Возврат ПрочитатьJSONИзСтроки(ТекстОтвета);

КонецФункции

Функция ОписаниеОшибкиAPI(КодСостояния, ТекстОтвета)

	Сообщение = "";
	Попытка
		Данные = ПрочитатьJSONИзСтроки(ТекстОтвета);
		Ошибка = Данные.Получить("error");
		Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
			Сообщение = Строка(Ошибка.Получить("message"));
		КонецЕсли;
	Исключение
		Сообщение = Лев(ТекстОтвета, 500);
	КонецПопытки;

	Если КодСостояния = 401 Тогда
		Пояснение = НСтр("ru = 'неверный ключ API'");
	ИначеЕсли КодСостояния = 413 Тогда
		Пояснение = НСтр("ru = 'файлы слишком большие'");
	ИначеЕсли КодСостояния = 429 Тогда
		Пояснение = НСтр("ru = 'превышен лимит запросов, повторите через минуту'");
	ИначеЕсли КодСостояния = 529 Или КодСостояния >= 500 Тогда
		Пояснение = НСтр("ru = 'сервис временно перегружен, повторите позже'");
	Иначе
		Пояснение = НСтр("ru = 'ошибка запроса'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Claude API вернул код %1 (%2): %3'"), КодСостояния, Пояснение, Сообщение);

КонецФункции

// "https://host:port/prefix" -> Структура(HTTPS, Хост, Порт, Путь)
Функция РазобратьАдрес(Знач АдресСтрокой)

	Результат = Новый Структура("HTTPS,Хост,Порт,Путь", Истина, "", Неопределено, "");
	АдресСтрокой = СокрЛП(АдресСтрокой);
	Если ПустаяСтрока(АдресСтрокой) Тогда
		АдресСтрокой = НастройкиПоУмолчанию().АдресAPI;
	КонецЕсли;

	Если СтрНачинаетсяС(НРег(АдресСтрокой), "http://") Тогда
		Результат.HTTPS = Ложь;
		АдресСтрокой = Сред(АдресСтрокой, 8);
	ИначеЕсли СтрНачинаетсяС(НРег(АдресСтрокой), "https://") Тогда
		АдресСтрокой = Сред(АдресСтрокой, 9);
	КонецЕсли;

	ПозицияПути = СтрНайти(АдресСтрокой, "/");
	Если ПозицияПути > 0 Тогда
		Результат.Путь = Сред(АдресСтрокой, ПозицияПути);
		АдресСтрокой = Лев(АдресСтрокой, ПозицияПути - 1);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Результат.Путь, "/") Цикл
		Результат.Путь = Лев(Результат.Путь, СтрДлина(Результат.Путь) - 1);
	КонецЦикла;

	ПозицияПорта = СтрНайти(АдресСтрокой, ":");
	Если ПозицияПорта > 0 Тогда
		Результат.Порт = Число(Сред(АдресСтрокой, ПозицияПорта + 1));
		АдресСтрокой = Лев(АдресСтрокой, ПозицияПорта - 1);
	КонецЕсли;
	Результат.Хост = АдресСтрокой;
	Возврат Результат;

КонецФункции

Функция БлокТекста(Текст)

	Возврат Новый Структура("type,text", "text", Текст);

КонецФункции

Функция БлокФайла(Файл)

	ЧастиИмени = СтрРазделить(Файл.Имя, ".");
	Расширение = НРег(ЧастиИмени[ЧастиИмени.ВГраница()]);

	Base64 = Base64Строка(Файл.ДвоичныеДанные);
	Base64 = СтрЗаменить(СтрЗаменить(Base64, Символы.ВК, ""), Символы.ПС, "");

	Если Расширение = "pdf" Тогда
		Если СтрДлина(Base64) > 30 * 1024 * 1024 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Файл %1 больше 30 МБ.'"), Файл.Имя);
		КонецЕсли;
		Источник = Новый Структура("type,media_type,data", "base64", "application/pdf", Base64);
		Возврат Новый Структура("type,source", "document", Источник);
	КонецЕсли;

	ТипыИзображений = Новый Соответствие;
	ТипыИзображений.Вставить("jpg", "image/jpeg");
	ТипыИзображений.Вставить("jpeg", "image/jpeg");
	ТипыИзображений.Вставить("png", "image/png");
	ТипыИзображений.Вставить("webp", "image/webp");
	ТипыИзображений.Вставить("gif", "image/gif");
	ТипMIME = ТипыИзображений.Получить(Расширение);
	Если ТипMIME = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Формат файла %1 не поддерживается. Используйте JPG, PNG, WEBP или PDF (фото HEIC с iPhone сохраните как JPG).'"),
			Файл.Имя);
	КонецЕсли;

	// Ограничение API - 5 МБ на изображение (в кодировке base64).
	Если СтрДлина(Base64) > 5 * 1024 * 1024 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Фото %1 слишком большое (%2 МБ). Нужно не больше ~3,7 МБ: уменьшите разрешение снимка или отправьте его через мессенджер (он сжимает фото), либо отсканируйте в PDF.'"),
			Файл.Имя, Формат(Файл.ДвоичныеДанные.Размер() / 1048576, "ЧДЦ=1"));
	КонецЕсли;

	Источник = Новый Структура("type,media_type,data", "base64", ТипMIME, Base64);
	Возврат Новый Структура("type,source", "image", Источник);

КонецФункции

Функция СистемныйПромпт()

	Возврат
	"Ты переносишь первичные учётные документы из изображений в систему 1С.
	|На входе - фото или сканы одной товарной накладной (ТОРГ-12, УПД, счёт-фактура, товарная накладная,
	|расходная накладная). Если файлов несколько, это страницы одного документа: объедини их таблицы
	|в один список позиций без дублей (строку, разорванную переносом страницы, считай одной позицией).
	|
	|Правила:
	|- Переписывай данные так, как они напечатаны. Ничего не придумывай. Если поле не видно или его нет,
	|  верни пустую строку или 0, а в warnings опиши, что не удалось прочитать.
	|- Числа возвращай числами, без пробелов-разделителей разрядов; десятичный разделитель в документе -
	|  запятая, в ответе - точка.
	|- Поставщик (продавец, грузоотправитель) и покупатель (грузополучатель, плательщик) - это разные
	|  стороны. ИНН - 10 или 12 цифр, КПП - 9 цифр. Если ИНН и КПП напечатаны через ""/"", раздели их.
	|- Для каждой позиции: количество, цена без НДС, сумма без НДС, ставка НДС, сумма НДС и сумма с НДС.
	|  Если в документе цены указаны с НДС, всё равно заполни суммы без НДС, НДС и с НДС по колонкам
	|  документа, а prices_include_vat поставь true.
	|- Ставку НДС пиши как в документе: ""22%"", ""20%"", ""10%"", ""5%"", ""7%"", ""0%"" или ""Без НДС"".
	|- Сверь арифметику: количество * цена = сумма, сумма строк = итог документа. Если не сходится,
	|  оставь значения из документа и опиши расхождение в warnings.
	|- Пустые и итоговые строки таблицы (""Итого"", ""Всего к оплате"") в items не включай.";

