Функция ЕдинственнаяНоменклатура(Условие, ЗначениеЯчейки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И &Условие";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	Запрос.УстановитьПараметр("Значение", ЗначениеЯчейки);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	// Неоднозначное совпадение не подставляем - пусть выберет пользователь.
	Если Выгрузка.Количество() = 1 Тогда
		Возврат Выгрузка[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

Функция ЭкранироватьДляПодобно(Знач Текст)

	Для Каждого ОчереднойСимвол Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Текст = СтрЗаменить(Текст, ОчереднойСимвол, "~" + ОчереднойСимвол);
	КонецЦикла;
	Возврат Текст;

КонецФункции

Функция ЧислоИзНачалаСтроки(Текст)

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		ОчереднойСимвол = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", ОчереднойСимвол) > 0 Тогда
			Цифры = Цифры + ОчереднойСимвол;
		ИначеЕсли Не ПустаяСтрока(Цифры) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Цифры), Неопределено, Число(Цифры));

КонецФункции

Процедура УстановитьЕслиЕсть(Приемник, МетаданныеВладельца, ИмяРеквизита, ЗначениеЯчейки)

	// Проверка по метаданным: состав реквизитов отличается между релизами ERP.
	Если МетаданныеВладельца.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Приемник[ИмяРеквизита] = ЗначениеЯчейки;
	КонецЕсли;

