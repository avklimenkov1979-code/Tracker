// Подбирает номенклатуру для строки накладной.
// Порядок: ранее запомненное сопоставление для этого поставщика ->
// артикул -> точное наименование -> полное наименование -> единственное
// совпадение по началу наименования.
//
Функция ПодобратьНоменклатуру(ИННПоставщика, Артикул, Наименование, Сопоставления = Неопределено) Экспорт

	Пустая = Справочники.Номенклатура.ПустаяСсылка();

	Если Сопоставления = Неопределено Тогда
		Сопоставления = ЗагрузитьСопоставления();
	КонецЕсли;
	Запомненная = Сопоставления.Получить(КлючСопоставления(ИННПоставщика, Артикул, Наименование));
	Если ЗначениеЗаполнено(Запомненная) Тогда
		Возврат Запомненная;
	КонецЕсли;

	Если Не ПустаяСтрока(Артикул) Тогда
		Найденная = ЕдинственнаяНоменклатура("Номенклатура.Артикул = &Значение", СокрЛП(Артикул));
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Наименование = СокрЛП(Наименование);
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Пустая;
	КонецЕсли;

	Найденная = ЕдинственнаяНоменклатура("Номенклатура.Наименование = &Значение", Наименование);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат Найденная;
	КонецЕсли;

	Найденная = ЕдинственнаяНоменклатура("ВЫРАЗИТЬ(Номенклатура.НаименованиеПолное КАК СТРОКА(1000)) = &Значение", Наименование);
	Если ЗначениеЗаполнено(Найденная) Тогда
		Возврат Найденная;
	КонецЕсли;

	Найденная = ЕдинственнаяНоменклатура("Номенклатура.Наименование ПОДОБНО &Значение СПЕЦСИМВОЛ ""~""",
		ЭкранироватьДляПодобно(Лев(Наименование, 50)) + "%");
	Возврат Найденная;

КонецФункции

Функция ЗагрузитьСопоставления() Экспорт

	Сопоставления = ХранилищеОбщихНастроек.Загрузить(КлючХранилища(), "Сопоставления");
	Если ТипЗнч(Сопоставления) <> Тип("Соответствие") Тогда
		Сопоставления = Новый Соответствие;
	КонецЕсли;
	Возврат Сопоставления;

КонецФункции

// Запоминает, какой номенклатуре соответствует строка накладной поставщика,
// чтобы при следующей загрузке от того же поставщика подставить её автоматически.
//
// Параметры:
//  ИННПоставщика - Строка
//  Строки - Массив из Структура - Артикул, Наименование, Номенклатура.
//
Процедура ЗапомнитьСопоставления(ИННПоставщика, Строки) Экспорт

	Если ПустаяСтрока(ИННПоставщика) Тогда
		Возврат;
	КонецЕсли;
	Сопоставления = ЗагрузитьСопоставления();
	Для Каждого ТекущаяСтрока Из Строки Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			Сопоставления.Вставить(КлючСопоставления(ИННПоставщика, ТекущаяСтрока.Артикул, ТекущаяСтрока.Наименование),
				ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(КлючХранилища(), "Сопоставления", Сопоставления);

КонецПроцедуры

// Возвращает значение для реквизита Товары.СтавкаНДС документа по тексту
// ставки из накладной ("22%", "20%", "10%", "0%", "Без НДС").
// Работает и со справочником СтавкиНДС (ERP 2.5.x), и с перечислением (ранние версии).
//
Функция СтавкаНДСПоТексту(ТекстСтавки) Экспорт

	МетаданныеРеквизита = Метаданные.Документы.ПриобретениеТоваровУслуг.ТабличныеЧасти.Товары.Реквизиты.Найти("СтавкаНДС");
	Если МетаданныеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипРеквизита = МетаданныеРеквизита.Тип;

	Текст = НРег(СтрЗаменить(СокрЛП(ТекстСтавки), " ", ""));
	БезНДС = ПустаяСтрока(Текст) Или СтрНайти(Текст, "без") > 0;
	Процент = ?(БезНДС, -1, ЧислоИзНачалаСтроки(Текст));
	Если Не БезНДС И Процент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено
		И ТипРеквизита.СодержитТип(Тип("СправочникСсылка.СтавкиНДС")) Тогда

		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СтавкиНДС.Ссылка КАК Ссылка,
		|	СтавкиНДС.Наименование КАК Наименование
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	НЕ СтавкиНДС.ПометкаУдаления");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Имя = НРег(СтрЗаменить(Выборка.Наименование, " ", ""));
			Если СтрНайти(Имя, "/") > 0 Тогда
				Продолжить; // расчётные ставки 20/120 и т.п. не нужны
			КонецЕсли;
			Если БезНДС И СтрНайти(Имя, "без") > 0 Тогда
				Возврат Выборка.Ссылка;
			ИначеЕсли Не БезНДС И СтрНачинаетсяС(Имя, Формат(Процент, "ЧГ=0; ЧН=0") + "%") Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;

	КонецЕсли;

	Если Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено
		И ТипРеквизита.СодержитТип(Тип("ПеречислениеСсылка.СтавкиНДС")) Тогда
		ИмяЗначения = ?(БезНДС, "БезНДС", "НДС" + Формат(Процент, "ЧГ=0; ЧН=0"));
		Если Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления.Найти(ИмяЗначения) <> Неопределено Тогда
			Возврат Перечисления.СтавкиНДС[ИмяЗначения];
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СозданиеДокумента

// Создаёт и записывает (без проведения) документ «Приобретение товаров и услуг».
//
// Параметры:
//  Шапка - Структура - Организация, Контрагент, Партнер, Договор, Склад,
//          НомерВходящегоДокумента, ДатаВходящегоДокумента, ЦенаВключаетНДС, Комментарий.
//  Строки - Массив из Структура - Номенклатура, Количество, Цена, Сумма,
//           СтавкаНДС (Строка - текст ставки), СуммаНДС, СуммаСНДС.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриобретениеТоваровУслуг
//
Функция СоздатьДокументПоступления(Шапка, Строки) Экспорт

	МетаДокумента = Метаданные.Документы.ПриобретениеТоваровУслуг;
	МетаТоваров = МетаДокумента.ТабличныеЧасти.Товары;

	Документ = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();

	// Стандартное заполнение ERP: валюта, налогообложение, договор, склад по умолчанию и т.д.
	ДанныеЗаполнения = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Организация,Партнер,Контрагент,Договор,Склад", ",") Цикл
		Если Шапка.Свойство(Имя) И ЗначениеЗаполнено(Шапка[Имя]) Тогда
			ДанныеЗаполнения.Вставить(Имя, Шапка[Имя]);
		КонецЕсли;
	КонецЦикла;
	Если Метаданные.Перечисления.Найти("ХозяйственныеОперации") <> Неопределено
		И Метаданные.Перечисления.ХозяйственныеОперации.ЗначенияПеречисления.Найти("ЗакупкаУПоставщика") <> Неопределено Тогда
		ДанныеЗаполнения.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика);
	КонецЕсли;
	Попытка
		Документ.Заполнить(ДанныеЗаполнения);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаНакладнойПоФото", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Значения из формы важнее значений по умолчанию.
	Для Каждого КлючИЗначение Из ДанныеЗаполнения Цикл
		УстановитьЕслиЕсть(Документ, МетаДокумента, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	УстановитьЕслиЕсть(Документ, МетаДокумента, "НомерВходящегоДокумента", Шапка.НомерВходящегоДокумента);
	УстановитьЕслиЕсть(Документ, МетаДокумента, "ДатаВходящегоДокумента", Шапка.ДатаВходящегоДокумента);
	УстановитьЕслиЕсть(Документ, МетаДокумента, "ЦенаВключаетНДС", Шапка.ЦенаВключаетНДС);
	Если Шапка.Свойство("Комментарий") Тогда
		УстановитьЕслиЕсть(Документ, МетаДокумента, "Комментарий", Шапка.Комментарий);
	КонецЕсли;

	Документ.Товары.Очистить();
	ИтогСНДС = 0;
	Для Каждого ТекущаяСтрока Из Строки Цикл
		НоваяСтрока = Документ.Товары.Добавить();
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Номенклатура", ТекущаяСтрока.Номенклатура);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Количество", ТекущаяСтрока.Количество);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "КоличествоУпаковок", ТекущаяСтрока.Количество);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Цена", ТекущаяСтрока.Цена);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Сумма", ТекущаяСтрока.Сумма);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "СуммаНДС", ТекущаяСтрока.СуммаНДС);
		УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "СуммаСНДС", ТекущаяСтрока.СуммаСНДС);
		Ставка = СтавкаНДСПоТексту(ТекущаяСтрока.СтавкаНДС);
		Если Ставка <> Неопределено Тогда
			УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "СтавкаНДС", Ставка);
		КонецЕсли;
		Если ЗначениеЗаполнено(Шапка.Склад) Тогда
			УстановитьЕслиЕсть(НоваяСтрока, МетаТоваров, "Склад", Шапка.Склад);
		КонецЕсли;
		ИтогСНДС = ИтогСНДС + ТекущаяСтрока.СуммаСНДС;
	КонецЦикла;
	УстановитьЕслиЕсть(Документ, МетаДокумента, "СуммаДокумента", ИтогСНДС);

	Документ.Записать(РежимЗаписиДокумента.Запись);
	Возврат Документ.Ссылка;

КонецФункции

