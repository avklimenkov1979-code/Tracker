// Форма обработки «Загрузка накладной по фото».
//
// Реквизиты и элементы формы создаются программно в ПриСозданииНаСервере,
// Готовый файл обработки собирается скриптом СОБРАТЬ.bat.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();
	НастроитьУсловноеОформление();

	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого КлючИЗначение Из Обработка.ЗагрузитьНастройки() Цикл
		ЭтотОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;

	ЭтотОбъект.ПривязатьКЗаказу = Истина;
	Заголовок = НСтр("ru = 'Загрузка накладной по фото'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьФото(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите фото или скан накладной (можно несколько страниц)'");
	ПараметрыДиалога.МножественныйВыбор = Истина;
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Фото и PDF'") + " (*.jpg;*.jpeg;*.png;*.webp;*.pdf)|*.jpg;*.jpeg;*.png;*.webp;*.pdf";

	Оповещение = Новый ОписаниеОповещения("ДобавитьФотоЗавершение", ЭтотОбъект);
	НачатьПомещениеФайловНаСервер(Оповещение, , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФотоЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Новые фото - новая накладная: старый список заменяем.
	ЭтотОбъект.Файлы.Очистить();
	Добавлено = 0;
	Для Каждого Описание Из ПомещенныеФайлы Цикл
		Если Описание.ПомещениеФайлаОтменено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ЭтотОбъект.Файлы.Добавить();
		НоваяСтрока.ИмяФайла = Описание.СсылкаНаФайл.Имя;
		НоваяСтрока.Адрес = Описание.Адрес;
		Добавлено = Добавлено + 1;
	КонецЦикла;

	// Сразу распознаём - отдельно нажимать ничего не нужно.
	Если Добавлено > 0 Тогда
		Распознать(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Распознать(Команда)

	Если ЭтотОбъект.Файлы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала добавьте фото или скан накладной.'"));
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект.Товары.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("РаспознатьПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Уже распознанные данные будут заменены. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьРаспознавание();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаспознатьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьРаспознавание();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)

	Этап = Новый Структура("ПоставщикГотов,ДублиПроверены,ЦеныПроверены,СверкаПроверена", Ложь, Ложь, Ложь, Ложь);
	ПроверитьИСоздать(Этап);

КонецПроцедуры

// Проверки перед созданием поступления. Каждый вопрос пользователю
// возвращается сюда же со следующим этапом.
&НаКлиенте
Процедура ПроверитьИСоздать(Этап)

	Ошибки = Новый Массив;
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не заполнена организация.'"));
	КонецЕсли;
	Если ЭтотОбъект.Товары.Количество() = 0 Тогда
		Ошибки.Добавить(НСтр("ru = 'Нет строк товаров.'"));
	КонецЕсли;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: не выбрана номенклатура для ""%2"".'"),
				ТекущаяСтрока.НомерПоДокументу, ТекущаяСтрока.Наименование));
		КонецЕсли;
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС));
		Возврат;
	КонецЕсли;

	// 1. Поставщика нет в базе - предлагаем создать по ИНН.
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Контрагент) И Не Этап.ПоставщикГотов Тогда
		Если Не ИННКорректенНаСервере(ЭтотОбъект.ПоставщикИНН) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Поставщик не выбран, а ИНН распознан с ошибкой (не сходится контрольная цифра).
				|Исправьте ИНН в поле ""ИНН"" по накладной или выберите контрагента вручную.'"));
			Возврат;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПоставщике", ЭтотОбъект, Этап);
		ПоказатьВопрос(Оповещение, СтрШаблон(НСтр("ru = 'Поставщика ""%1"" (ИНН %2) ещё нет в 1С.
			|Создать его автоматически?'"), ЭтотОбъект.ПоставщикНаименование, ЭтотОбъект.ПоставщикИНН),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;

	// 2. Такая накладная уже введена?
	Если Не Этап.ДублиПроверены Тогда
		Этап.ДублиПроверены = Истина;
		Дубли = НайтиДублиНаСервере();
		Если Дубли.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВопросаОДублях", ЭтотОбъект, Этап);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Похоже, эта накладная уже введена:'") + Символы.ПС
				+ СтрСоединить(Дубли, Символы.ПС) + Символы.ПС + Символы.ПС
				+ НСтр("ru = 'Всё равно создать ещё одно поступление?'"),
				РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// 3. Цены сильно отличаются от прошлых закупок?
	Если Не Этап.ЦеныПроверены Тогда
		Этап.ЦеныПроверены = Истина;
		Отличия = Новый Массив;
		Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
			Если ТекущаяСтрока.ЦенаОтличается Тогда
				Отличия.Добавить(СтрШаблон("• %1: %2 (было %3, %4%5%%)", ТекущаяСтрока.Наименование,
					Формат(ТекущаяСтрока.Цена, "ЧДЦ=2"), Формат(ТекущаяСтрока.ПрошлаяЦена, "ЧДЦ=2"),
					?(ТекущаяСтрока.ИзменениеЦены > 0, "+", ""), Формат(ТекущаяСтрока.ИзменениеЦены, "ЧДЦ=1; ЧН=0")));
			КонецЕсли;
		КонецЦикла;
		Если Отличия.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЦенах", ЭтотОбъект, Этап);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Цены отличаются от прошлых закупок:'") + Символы.ПС
				+ СтрСоединить(Отличия, Символы.ПС) + Символы.ПС + Символы.ПС
				+ НСтр("ru = 'Цены верные - создать поступление?'"),
				РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// 4. Расхождения с заказом поставщику?
	Если Не Этап.СверкаПроверена Тогда
		Этап.СверкаПроверена = Истина;
		Расхождения = Новый Массив;
		Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
			Если ТекущаяСтрока.РасхождениеСЗаказом И Расхождения.Количество() < 10 Тогда
				Расхождения.Добавить("• " + ТекущаяСтрока.Наименование + ": " + ТекущаяСтрока.Сверка);
			КонецЕсли;
		КонецЦикла;
		Если Расхождения.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВопросаОСверке", ЭтотОбъект, Этап);
			ПоказатьВопрос(Оповещение, СтрШаблон(НСтр("ru = 'Накладная не совпадает с заказом %1:'"),
				ЭтотОбъект.ЗаказПоставщику) + Символы.ПС + СтрСоединить(Расхождения, Символы.ПС)
				+ Символы.ПС + Символы.ПС + НСтр("ru = 'Всё равно создать поступление?'"),
				РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Ссылка = СоздатьДокументНаСервере();
	Исключение
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось записать документ:'") + Символы.ПС
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Создан документ'"), ПолучитьНавигационнуюСсылку(Ссылка),
		Строка(Ссылка));
	ПоказатьЗначение(, Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПоставщике(Ответ, Этап) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите контрагента вручную в поле ""Контрагент"" и снова нажмите ""2. Создать поступление"".'"));
		Возврат;
	КонецЕсли;
	Попытка
		Пояснение = СоздатьПоставщикаНаСервере();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Поставщик добавлен'"), , Пояснение);
	Этап.ПоставщикГотов = Истина;
	ПроверитьИСоздать(Этап);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОДублях(Ответ, Этап) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПроверитьИСоздать(Этап);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОСверке(Ответ, Этап) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПроверитьИСоздать(Этап);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЦенах(Ответ, Этап) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПроверитьИСоздать(Этап);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФайлы(Команда)

	ЭтотОбъект.Файлы.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНастройкиНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки сохранены'"));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРаспознавание1С(Команда)

	ОткрытьВстроенныйСервис("Распознавание");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭДО(Команда)

	ОткрытьВстроенныйСервис("ЭДО");

КонецПроцедуры

#КонецОбласти

#Область ВстроенныеСервисы1С

// Открывает стандартный сервис ERP, если он есть в этой версии 1С,
// иначе показывает, как его подключить.
&НаКлиенте
Процедура ОткрытьВстроенныйСервис(Вид)

	// Распознавание: выполняем ту же команду, что в меню
	// "Закупки - Сервис - Загрузить документы из сканов (фото)".
	Если Вид = "Распознавание" Тогда
		Ссылка = НавигационнаяСсылкаКомандыРаспознавания();
		Если Не ПустаяСтрока(Ссылка) Тогда
			Попытка
				ПерейтиПоНавигационнойСсылке(Ссылка);
				Возврат;
			Исключение
				// Покажем инструкцию ниже.
			КонецПопытки;
		КонецЕсли;
		ПоказатьПредупреждение(, ИнструкцияПодключения(Вид), , НСтр("ru = 'Где найти'"));
		Возврат;
	КонецЕсли;

	ИмяОткрываемойФормы = ФормаВстроенногоСервиса(Вид);
	Если Не ПустаяСтрока(ИмяОткрываемойФормы) Тогда
		Попытка
			ОткрытьФорму(ИмяОткрываемойФормы);
			Возврат;
		Исключение
			// Покажем инструкцию ниже.
		КонецПопытки;
	КонецЕсли;
	ПоказатьПредупреждение(, ИнструкцияПодключения(Вид), , НСтр("ru = 'Как подключить'"));

КонецПроцедуры

// Ищет команду "Загрузить документы из сканов (фото)" среди общих команд
// и команд обработок (включая расширения) по её представлению в меню.
&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКомандыРаспознавания()

	СписокКоманд = Новый Массив;
	Для Каждого МетаКоманды Из Метаданные.ОбщиеКоманды Цикл
		СписокКоманд.Добавить(МетаКоманды);
	КонецЦикла;
	Для Каждого МетаОбработки Из Метаданные.Обработки Цикл
		Для Каждого МетаКоманды Из МетаОбработки.Команды Цикл
			СписокКоманд.Добавить(МетаКоманды);
		КонецЦикла;
	КонецЦикла;

	Для Каждого МетаКоманды Из СписокКоманд Цикл
		Представление = НРег(МетаКоманды.Представление());
		Если СтрНайти(Представление, "из сканов") > 0 И СтрНайти(Представление, "загруз") > 0 Тогда
			Попытка
				Если Не ПравоДоступа("Просмотр", МетаКоманды) Тогда
					Продолжить;
				КонецЕсли;
			Исключение
				// Для части команд право "Просмотр" не проверяется - пробуем открыть.
			КонецПопытки;
			Возврат "e1cib/command/" + МетаКоманды.ПолноеИмя();
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ФормаВстроенногоСервиса(Вид)

	Если Вид = "Распознавание" Тогда
		Точные = СтрРазделить("РаспознаваниеДокументов,РаспознаваниеПервичныхДокументов", ",");
		ЧастиИмени = СтрРазделить("Распознавани,Документ", ",");
	Иначе
		Точные = СтрРазделить("ТекущиеДелаЭДО", ",");
		ЧастиИмени = СтрРазделить("ТекущиеДела,ЭДО", ",");
	КонецЕсли;

	Для Каждого Имя Из Точные Цикл
		ИмяОткрываемойФормы = ОсновнаяФормаОбработки(Метаданные.Обработки.Найти(Имя));
		Если Не ПустаяСтрока(ИмяОткрываемойФормы) Тогда
			Возврат ИмяОткрываемойФормы;
		КонецЕсли;
	КонецЦикла;

	Для Каждого МетаОбработки Из Метаданные.Обработки Цикл
		Подходит = Истина;
		Для Каждого Часть Из ЧастиИмени Цикл
			Если СтрНайти(МетаОбработки.Имя, Часть) = 0 Тогда
				Подходит = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если Подходит Тогда
			ИмяОткрываемойФормы = ОсновнаяФормаОбработки(МетаОбработки);
			Если Не ПустаяСтрока(ИмяОткрываемойФормы) Тогда
				Возврат ИмяОткрываемойФормы;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ОсновнаяФормаОбработки(МетаОбработки)

	Если МетаОбработки = Неопределено Или МетаОбработки.ОсновнаяФорма = Неопределено
		Или Не ПравоДоступа("Использование", МетаОбработки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат МетаОбработки.ОсновнаяФорма.ПолноеИмя();

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИнструкцияПодключения(Вид)

	Если Вид = "Распознавание" Тогда
		Возврат НСтр("ru = 'Встроенное распознавание 1С находится в меню:
		|Закупки - Сервис - Загрузить документы из сканов (фото).
		|
		|Если при загрузке 1С попросит логин и пароль - это логин и пароль портала 1С:ИТС
		|(их знает специалист 1С или обслуживающая фирма). Нужна действующая подписка 1С:ИТС.'");
	КонецЕсли;

	Возврат НСтр("ru = 'Обмен электронными документами (ЭДО) в этой базе не найден или не подключён.
	|
	|Как подключить:
	|1. Нужна электронная подпись организации (та же, которой сдаёте отчётность) и подписка 1С:ИТС.
	|2. В 1С наберите в поиске ""ЭДО"" и откройте ""Настройки ЭДО"" / ""Подключение к ЭДО"" - мастер проведёт по шагам.
	|3. Попросите поставщиков присылать накладные (УПД) через ЭДО. Им нужен ваш ИНН, подключение бесплатное для приёма.
	|
	|Дальше входящие накладные появятся в ""Входящих накладных по ЭДО"", и поступление создаётся одной кнопкой - без фото и без ошибок.'");

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	ПослеСменыКонтрагентаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПоставщикИННПриИзменении(Элемент)

	НайтиПоставщикаПоИННаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	ОбновитьКонтрольЦенНаСервере();
	ОбновитьСверкуСЗаказомНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаказПоставщикуПриИзменении(Элемент)

	ОбновитьСверкуСЗаказомНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Распознавание

&НаКлиенте
Процедура ВыполнитьРаспознавание()

	// Не хватает ключа или каталога - спрашиваем по одному полю, запоминаем навсегда.
	Если ЭтотОбъект.СервисРаспознавания = "Яндекс" Тогда
		Если ПустаяСтрока(ЭтотОбъект.ЯндексКлючAPI) Тогда
			ЗапроситьНастройку("ЯндексКлючAPI",
				НСтр("ru = 'Вставьте API-ключ Yandex Cloud (один раз, дальше программа его запомнит)'"));
			Возврат;
		ИначеЕсли ПустаяСтрока(ЭтотОбъект.ЯндексКаталог) Тогда
			ЗапроситьНастройку("ЯндексКаталог",
				НСтр("ru = 'Вставьте идентификатор каталога Yandex Cloud (начинается с b1g...)'"));
			Возврат;
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(ЭтотОбъект.КлючAPI) Тогда
		ЗапроситьНастройку("КлючAPI",
			НСтр("ru = 'Вставьте ключ Claude API (один раз, дальше программа его запомнит)'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Распознавание накладной... Обычно это занимает 20-90 секунд.'"));
	Попытка
		РаспознатьНаСервере();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС + Символы.ПС
			+ НСтр("ru = 'Можно воспользоваться встроенным распознаванием 1С: ссылка «Встроенное распознавание 1С» вверху формы.'"));
		Возврат;
	КонецПопытки;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНакладная;

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьНастройку(ИмяРеквизита, ТекстПодсказки)

	Оповещение = Новый ОписаниеОповещения("ВводНастройкиЗавершение", ЭтотОбъект, ИмяРеквизита);
	ПоказатьВводСтроки(Оповещение, "", ТекстПодсказки, 0, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВводНастройкиЗавершение(Значение, ИмяРеквизита) Экспорт

	Если Значение = Неопределено Или ПустаяСтрока(Значение) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Без ключа распознать здесь не получится. Как получить ключ Yandex Cloud - в файле README.md, раздел ""Ключ Яндекса"".
			|Можно также воспользоваться встроенным распознаванием 1С: ссылка «Встроенное распознавание 1С» вверху формы.'"));
		Возврат;
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизита] = СокрЛП(Значение);
	СохранитьНастройкиНаСервере();
	ВыполнитьРаспознавание();

КонецПроцедуры

&НаСервере
Процедура РаспознатьНаСервере()

	МассивФайлов = Новый Массив;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Файлы Цикл
		МассивФайлов.Добавить(Новый Структура("Имя,ДвоичныеДанные",
			ТекущаяСтрока.ИмяФайла, ПолучитьИзВременногоХранилища(ТекущаяСтрока.Адрес)));
	КонецЦикла;

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.РаспознатьНакладную(МассивФайлов, НастройкиИзФормы());
	ЭтотОбъект.ТекстОтвета = Результат.ТекстОтвета;
	ЗаполнитьПоРезультату(Результат.Данные, Обработка);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоРезультату(Данные, Обработка)

	ЭтотОбъект.НомерВходящегоДокумента = ЗначениеИзОтвета(Данные, "doc_number", "");
	ЭтотОбъект.ДатаВходящегоДокумента = ДатаИзСтроки(ЗначениеИзОтвета(Данные, "doc_date", ""));
	ЭтотОбъект.ПоставщикНаименование = ЗначениеИзОтвета(Данные, "supplier_name", "");
	ЭтотОбъект.ПоставщикИНН = ЗначениеИзОтвета(Данные, "supplier_inn", "");
	ЭтотОбъект.ПоставщикКПП = ЗначениеИзОтвета(Данные, "supplier_kpp", "");
	ЭтотОбъект.ЦенаВключаетНДС = ЗначениеИзОтвета(Данные, "prices_include_vat", Ложь);
	ЭтотОбъект.ИтогПоДокументу = ЗначениеИзОтвета(Данные, "total_with_vat", 0);
	ЭтотОбъект.ОснованиеИзНакладной = ЗначениеИзОтвета(Данные, "order_basis", "");

	ЭтотОбъект.Контрагент = Обработка.НайтиКонтрагента(ЭтотОбъект.ПоставщикИНН, ЭтотОбъект.ПоставщикКПП);
	ЭтотОбъект.Партнер = Обработка.ПартнерКонтрагента(ЭтотОбъект.Контрагент);
	НайденнаяОрганизация = Обработка.НайтиОрганизацию(ЗначениеИзОтвета(Данные, "buyer_inn", ""), ЗначениеИзОтвета(Данные, "buyer_kpp", ""));
	Если ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
		ЭтотОбъект.Организация = НайденнаяОрганизация;
	КонецЕсли;

	Сопоставления = Обработка.ЗагрузитьСопоставления();
	ЭтотОбъект.Товары.Очистить();
	ИтогПоСтрокам = 0;
	Позиции = ЗначениеИзОтвета(Данные, "items", Новый Массив);
	Для Каждого Позиция Из Позиции Цикл
		НоваяСтрока = ЭтотОбъект.Товары.Добавить();
		НоваяСтрока.НомерПоДокументу = ЗначениеИзОтвета(Позиция, "line_no", 0);
		НоваяСтрока.Артикул = ЗначениеИзОтвета(Позиция, "article", "");
		НоваяСтрока.Наименование = ЗначениеИзОтвета(Позиция, "name", "");
		НоваяСтрока.ЕдиницаИзмерения = ЗначениеИзОтвета(Позиция, "unit", "");
		НоваяСтрока.Количество = ЗначениеИзОтвета(Позиция, "quantity", 0);
		НоваяСтрока.Цена = ЗначениеИзОтвета(Позиция, "price", 0);
		НоваяСтрока.СуммаБезНДС = ЗначениеИзОтвета(Позиция, "sum_without_vat", 0);
		НоваяСтрока.СтавкаНДС = ЗначениеИзОтвета(Позиция, "vat_rate", "");
		НоваяСтрока.СуммаНДС = ЗначениеИзОтвета(Позиция, "vat_sum", 0);
		НоваяСтрока.СуммаСНДС = ЗначениеИзОтвета(Позиция, "sum_with_vat", 0);
		НоваяСтрока.Номенклатура = Обработка.ПодобратьНоменклатуру(ЭтотОбъект.ПоставщикИНН,
			НоваяСтрока.Артикул, НоваяСтрока.Наименование, Сопоставления);
		ИтогПоСтрокам = ИтогПоСтрокам + НоваяСтрока.СуммаСНДС;
	КонецЦикла;

	Замечания = Новый Массив;
	Если ЗначениеЗаполнено(ЭтотОбъект.ПоставщикИНН) И Не Обработка.ИННКорректен(ЭтотОбъект.ПоставщикИНН) Тогда
		Замечания.Добавить(НСтр("ru = '• ИНН поставщика распознан с ошибкой (не сходится контрольная цифра) - сверьте с накладной и исправьте в поле ""ИНН"".'"));
	КонецЕсли;
	Дубли = Обработка.НайтиДублиПоступления(ЭтотОбъект.Контрагент, ЭтотОбъект.ПоставщикИНН,
		ЭтотОбъект.НомерВходящегоДокумента, ЭтотОбъект.ДатаВходящегоДокумента);
	Если Дубли.Количество() > 0 Тогда
		Замечания.Добавить(НСтр("ru = '• ВНИМАНИЕ: похоже, эта накладная уже введена: '") + СтрСоединить(Дубли, "; "));
	КонецЕсли;
	КоличествоОтличий = ОбновитьКонтрольЦенНаСервере();

	ПодобратьЗаказНаСервере();
	Сверка = ОбновитьСверкуСЗаказомНаСервере();
	Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказПоставщику) Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = '• Найден заказ: %1. Поступление будет к нему привязано.'"), ЭтотОбъект.ЗаказПоставщику));
		Если Сверка.Расхождений > 0 Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = '• Расхождения с заказом в %1 строках (выделены оранжевым, см. колонку ""Сверка с заказом"").'"),
				Сверка.Расхождений));
		КонецЕсли;
		Если Сверка.НеПривезли.Количество() > 0 Тогда
			Замечания.Добавить(НСтр("ru = '• По заказу ещё не привезли: '") + СтрСоединить(Сверка.НеПривезли, "; "));
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Контрагент) Тогда
		Замечания.Добавить(НСтр("ru = '• Открытый заказ этому поставщику не найден - поступление будет без заказа (заказ можно выбрать вручную).'"));
	КонецЕсли;
	Если КоличествоОтличий > 0 Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = '• В %1 строках цена отличается от прошлой закупки больше чем на %2%% (выделены жёлтым).'"),
			КоличествоОтличий, ЭтотОбъект.ПорогЦены));
	КонецЕсли;
	Для Каждого Предупреждение Из ЗначениеИзОтвета(Данные, "warnings", Новый Массив) Цикл
		Замечания.Добавить("• " + Предупреждение);
	КонецЦикла;
	Если ЗначениеЗаполнено(ЭтотОбъект.ПоставщикИНН) И Не ЗначениеЗаполнено(ЭтотОбъект.Контрагент) Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = '• Контрагент с ИНН %1 не найден в базе.'"), ЭтотОбъект.ПоставщикИНН));
	КонецЕсли;
	Если ЭтотОбъект.ИтогПоДокументу <> 0 И Окр(ИтогПоСтрокам - ЭтотОбъект.ИтогПоДокументу, 2) <> 0 Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = '• Сумма строк %1 не совпадает с итогом документа %2.'"),
			Формат(ИтогПоСтрокам, "ЧДЦ=2"), Формат(ЭтотОбъект.ИтогПоДокументу, "ЧДЦ=2")));
	КонецЕсли;
	НеСопоставлено = 0;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			НеСопоставлено = НеСопоставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Если НеСопоставлено > 0 Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = '• Не подобрана номенклатура в %1 из %2 строк (выделены цветом) - выберите вручную, при следующей загрузке от этого поставщика выбор подставится сам.'"),
			НеСопоставлено, ЭтотОбъект.Товары.Количество()));
	КонецЕсли;
	ЭтотОбъект.Предупреждения = СтрСоединить(Замечания, Символы.ПС);

КонецПроцедуры

&НаСервере
Процедура ПослеСменыКонтрагентаНаСервере()

	ЭтотОбъект.Партнер = ПартнерКонтрагента(ЭтотОбъект.Контрагент);
	ОбновитьКонтрольЦенНаСервере();
	ПодобратьЗаказНаСервере();
	ОбновитьСверкуСЗаказомНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПодобратьЗаказНаСервере()

	МассивНоменклатуры = Новый Массив;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			МассивНоменклатуры.Добавить(ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.ЗаказПоставщику = РеквизитФормыВЗначение("Объект").ПодобратьЗаказПоставщику(
		ЭтотОбъект.Контрагент, ЭтотОбъект.Организация, МассивНоменклатуры, ЭтотОбъект.ОснованиеИзНакладной);

КонецПроцедуры

// Сравнивает строки накладной с заказом поставщику и заполняет колонки сверки.
//
// Возвращаемое значение:
//  Структура - Расхождений (Число), НеПривезли (Массив из Строка).
//
&НаСервере
Функция ОбновитьСверкуСЗаказомНаСервере()

	Результат = Новый Структура("Расхождений,НеПривезли", 0, Новый Массив);
	ДанныеЗаказа = РеквизитФормыВЗначение("Объект").ДанныеЗаказаДляСверки(ЭтотОбъект.ЗаказПоставщику);
	ЕстьЗаказ = ЗначениеЗаполнено(ЭтотОбъект.ЗаказПоставщику);
	ВНакладной = Новый Соответствие;

	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		ТекущаяСтрока.ПоЗаказу = 0;
		ТекущаяСтрока.ЦенаПоЗаказу = 0;
		ТекущаяСтрока.Сверка = "";
		ТекущаяСтрока.РасхождениеСЗаказом = Ложь;
		Если Не ЕстьЗаказ Или Не ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ВНакладной.Вставить(ТекущаяСтрока.Номенклатура, Истина);

		Позиция = ДанныеЗаказа.Получить(ТекущаяСтрока.Номенклатура);
		Если Позиция = Неопределено Тогда
			ТекущаяСтрока.Сверка = НСтр("ru = 'нет в заказе'");
			ТекущаяСтрока.РасхождениеСЗаказом = Истина;
			Результат.Расхождений = Результат.Расхождений + 1;
			Продолжить;
		КонецЕсли;

		Осталось = Макс(Позиция.Заказано - Позиция.Получено, 0);
		ТекущаяСтрока.ПоЗаказу = Осталось;
		ТекущаяСтрока.ЦенаПоЗаказу = Позиция.Цена;
		Замечания = Новый Массив;

		Если ТекущаяСтрока.Количество > Осталось + 0.0005 Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'больше заказа на %1'"),
				Формат(ТекущаяСтрока.Количество - Осталось, "ЧДЦ=3; ЧН=0")));
			ТекущаяСтрока.РасхождениеСЗаказом = Истина;
		ИначеЕсли ТекущаяСтрока.Количество < Осталось - 0.0005 Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'недовоз %1 (ещё ждём по заказу)'"),
				Формат(Осталось - ТекущаяСтрока.Количество, "ЧДЦ=3; ЧН=0")));
		КонецЕсли;

		ЦенаСейчас = ?(ТекущаяСтрока.Количество = 0, ТекущаяСтрока.Цена,
			ТекущаяСтрока.СуммаБезНДС / ТекущаяСтрока.Количество);
		Если Позиция.Цена > 0 Тогда
			Отклонение = Окр((ЦенаСейчас - Позиция.Цена) / Позиция.Цена * 100, 1);
			Если Макс(Отклонение, -Отклонение) >= 0.5 Тогда
				Замечания.Добавить(СтрШаблон(НСтр("ru = 'цена %1 заказа на %2%%'"),
					?(Отклонение > 0, НСтр("ru = 'выше'"), НСтр("ru = 'ниже'")),
					Формат(Макс(Отклонение, -Отклонение), "ЧДЦ=1")));
				ТекущаяСтрока.РасхождениеСЗаказом = Истина;
			КонецЕсли;
		КонецЕсли;

		ТекущаяСтрока.Сверка = ?(Замечания.Количество() = 0, НСтр("ru = 'совпадает'"), СтрСоединить(Замечания, "; "));
		Если ТекущаяСтрока.РасхождениеСЗаказом Тогда
			Результат.Расхождений = Результат.Расхождений + 1;
		КонецЕсли;
	КонецЦикла;

	// Что заказали, но в накладной нет.
	Для Каждого КлючИЗначение Из ДанныеЗаказа Цикл
		Осталось = КлючИЗначение.Значение.Заказано - КлючИЗначение.Значение.Получено;
		Если Осталось > 0.0005 И ВНакладной.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Результат.НеПривезли.Добавить(КлючИЗначение.Значение.Наименование + " - " + Формат(Осталось, "ЧДЦ=3; ЧН=0"));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

