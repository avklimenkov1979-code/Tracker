КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементы()

	Страницы = ДобавитьГруппу("Страницы", ЭтотОбъект, ВидГруппыФормы.Страницы);

	// --- Накладная
	СтраницаНакладная = ДобавитьГруппу("СтраницаНакладная", Страницы, ВидГруппыФормы.Страница, НСтр("ru = 'Накладная'"));

	ПодсказкаКакРаботать = Элементы.Добавить("ПодсказкаКакРаботать", Тип("ДекорацияФормы"), СтраницаНакладная);
	ПодсказкаКакРаботать.Вид = ВидДекорацииФормы.Надпись;
	ПодсказкаКакРаботать.Заголовок = НСтр("ru = 'Как работать:  1) нажмите «1. Выбрать фото накладной» и подождите до минуты;  2) проверьте строки, выделенные розовым, - выберите для них номенклатуру;  3) нажмите «2. Создать поступление».'");
	ПодсказкаКакРаботать.РастягиватьПоГоризонтали = Истина;

	ГруппаДругиеСпособы = ДобавитьГруппу("ГруппаДругиеСпособы", СтраницаНакладная, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	Надпись = Элементы.Добавить("НадписьДругиеСпособы", Тип("ДекорацияФормы"), ГруппаДругиеСпособы);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = НСтр("ru = 'Другие способы:'");
	Для Каждого ИмяКоманды Из СтрРазделить("ОткрытьРаспознавание1С,ОткрытьЭДО", ",") Цикл
		Кнопка = Элементы.Добавить("Кнопка" + ИмяКоманды, Тип("КнопкаФормы"), ГруппаДругиеСпособы);
		Кнопка.ИмяКоманды = ИмяКоманды;
		Кнопка.Вид = ВидКнопкиФормы.Гиперссылка;
	КонецЦикла;

	ГруппаВерх = ДобавитьГруппу("ГруппаВерх", СтраницаНакладная, ВидГруппыФормы.ОбычнаяГруппа, , Истина);

	ГруппаФайлы = ДобавитьГруппу("ГруппаФайлы", ГруппаВерх, ВидГруппыФормы.ОбычнаяГруппа);
	ТаблицаФайлов = Элементы.Добавить("Файлы", Тип("ТаблицаФормы"), ГруппаФайлы);
	ТаблицаФайлов.ПутьКДанным = "Файлы";
	ТаблицаФайлов.Высота = 4;
	ТаблицаФайлов.ИзменятьСоставСтрок = Истина;
	ТаблицаФайлов.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Поле = ДобавитьПоле("ФайлыИмяФайла", "Файлы.ИмяФайла", ТаблицаФайлов);
	Поле.ТолькоПросмотр = Истина;
	Кнопка = Элементы.Добавить("КнопкаОчиститьФайлы", Тип("КнопкаФормы"), ГруппаФайлы);
	Кнопка.ИмяКоманды = "ОчиститьФайлы";

	ГруппаНакладная = ДобавитьГруппу("ГруппаДанныеНакладной", ГруппаВерх, ВидГруппыФормы.ОбычнаяГруппа, НСтр("ru = 'По накладной'"));
	ГруппаНомер = ДобавитьГруппу("ГруппаНомерДата", ГруппаНакладная, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("НомерВходящегоДокумента", "НомерВходящегоДокумента", ГруппаНомер);
	ДобавитьПоле("ДатаВходящегоДокумента", "ДатаВходящегоДокумента", ГруппаНомер);
	ДобавитьПоле("ПоставщикНаименование", "ПоставщикНаименование", ГруппаНакладная).ТолькоПросмотр = Истина;
	ГруппаИНН = ДобавитьГруппу("ГруппаИННКПП", ГруппаНакладная, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	Поле = ДобавитьПоле("ПоставщикИНН", "ПоставщикИНН", ГруппаИНН);
	Поле.УстановитьДействие("ПриИзменении", "ПоставщикИННПриИзменении");
	ДобавитьПоле("ПоставщикКПП", "ПоставщикКПП", ГруппаИНН);
	ДобавитьПоле("ИтогПоДокументу", "ИтогПоДокументу", ГруппаНакладная).ТолькоПросмотр = Истина;
	ДобавитьПоле("ОснованиеИзНакладной", "ОснованиеИзНакладной", ГруппаНакладная);

	ГруппаВ1С = ДобавитьГруппу("ГруппаВ1С", ГруппаВерх, ВидГруппыФормы.ОбычнаяГруппа, НСтр("ru = 'В документ'"));
	ДобавитьПоле("Организация", "Организация", ГруппаВ1С);
	Поле = ДобавитьПоле("Контрагент", "Контрагент", ГруппаВ1С);
	Поле.УстановитьДействие("ПриИзменении", "КонтрагентПриИзменении");
	ДобавитьПоле("Партнер", "Партнер", ГруппаВ1С);
	Поле = ДобавитьПоле("Договор", "Договор", ГруппаВ1С);
	Связи = Новый Массив;
	Связи.Добавить(Новый СвязьПараметраВыбора("Отбор.Контрагент", "Контрагент"));
	Поле.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
	ДобавитьПоле("Склад", "Склад", ГруппаВ1С);
	ДобавитьПоле("ЦенаВключаетНДС", "ЦенаВключаетНДС", ГруппаВ1С, ВидПоляФормы.ПолеФлажка);
	Поле = ДобавитьПоле("ЗаказПоставщику", "ЗаказПоставщику", ГруппаВ1С);
	Поле.УстановитьДействие("ПриИзменении", "ЗаказПоставщикуПриИзменении");
	СвязиЗаказа = Новый Массив;
	СвязиЗаказа.Добавить(Новый СвязьПараметраВыбора("Отбор.Контрагент", "Контрагент"));
	Поле.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиЗаказа);
	ДобавитьПоле("ПривязатьКЗаказу", "ПривязатьКЗаказу", ГруппаВ1С, ВидПоляФормы.ПолеФлажка);

	Поле = ДобавитьПоле("Предупреждения", "Предупреждения", СтраницаНакладная);
	Поле.МногострочныйРежим = Истина;
	Поле.Высота = 3;
	Поле.ТолькоПросмотр = Истина;
	Поле.РастягиватьПоГоризонтали = Истина;

	ТаблицаТоваров = Элементы.Добавить("Товары", Тип("ТаблицаФормы"), СтраницаНакладная);
	ТаблицаТоваров.ПутьКДанным = "Товары";
	Для Каждого Колонка Из СтрРазделить("НомерПоДокументу,Артикул,Наименование,Номенклатура,ЕдиницаИзмерения,Количество,ПоЗаказу,Цена,ЦенаПоЗаказу,Сверка,ПрошлаяЦена,ИзменениеЦены,ПрошлаяЦенаОткуда,СуммаБезНДС,СтавкаНДС,СуммаНДС,СуммаСНДС", ",") Цикл
		Поле = ДобавитьПоле("Товары" + Колонка, "Товары." + Колонка, ТаблицаТоваров);
		Если Колонка = "Наименование" Тогда
			Поле.Ширина = 30;
		ИначеЕсли Колонка = "Номенклатура" Тогда
			Поле.Ширина = 30;
			Поле.АвтоОтметкаНезаполненного = Истина;
			Поле.УстановитьДействие("ПриИзменении", "ТоварыНоменклатураПриИзменении");
		ИначеЕсли СтрНайти(",ПрошлаяЦена,ИзменениеЦены,ПрошлаяЦенаОткуда,ПоЗаказу,ЦенаПоЗаказу,Сверка,", "," + Колонка + ",") > 0 Тогда
			Поле.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЦикла;

	// --- Настройки
	СтраницаНастройки = ДобавитьГруппу("СтраницаНастройки", Страницы, ВидГруппыФормы.Страница, НСтр("ru = 'Настройки'"));
	Поле = ДобавитьПоле("СервисРаспознавания", "СервисРаспознавания", СтраницаНастройки);
	Поле.СписокВыбора.Добавить("Яндекс", НСтр("ru = 'Яндекс (Yandex Cloud)'"));
	Поле.СписокВыбора.Добавить("Claude", НСтр("ru = 'Claude (Anthropic)'"));
	Поле.РежимВыбораИзСписка = Истина;
	Поле = ДобавитьПоле("ЯндексКлючAPI", "ЯндексКлючAPI", СтраницаНастройки);
	Поле.РежимПароля = Истина;
	ДобавитьПоле("ЯндексКаталог", "ЯндексКаталог", СтраницаНастройки).Подсказка =
		НСтр("ru = 'В консоли Yandex Cloud: страница каталога - Идентификатор (b1g...)'");
	Кнопка = Элементы.Добавить("КнопкаСохранитьНастройки", Тип("КнопкаФормы"), СтраницаНастройки);
	Кнопка.ИмяКоманды = "СохранитьНастройки";

	Специалисту = ДобавитьГруппу("ГруппаДляСпециалиста", СтраницаНастройки, ВидГруппыФормы.ОбычнаяГруппа,
		НСтр("ru = 'Для специалиста (обычно менять не нужно)'"));
	Специалисту.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	СтраницаНастройки = Специалисту;
	ДобавитьПоле("ЯндексМодель", "ЯндексМодель", СтраницаНастройки).Подсказка =
		НСтр("ru = 'yandexgpt/latest - YandexGPT Pro; yandexgpt-lite/latest - быстрее и дешевле, но хуже разбирает таблицы'");
	Поле = ДобавитьПоле("КлючAPI", "КлючAPI", СтраницаНастройки);
	Поле.РежимПароля = Истина;
	ДобавитьПоле("АдресAPI", "АдресAPI", СтраницаНастройки).Подсказка =
		НСтр("ru = 'https://api.anthropic.com или адрес вашего шлюза к Claude API'");
	ДобавитьПоле("Модель", "Модель", СтраницаНастройки);
	Поле = ДобавитьПоле("УровеньУсилий", "УровеньУсилий", СтраницаНастройки);
	Для Каждого Уровень Из СтрРазделить("low,medium,high,xhigh,max", ",") Цикл
		Поле.СписокВыбора.Добавить(Уровень);
	КонецЦикла;
	Поле.РежимВыбораИзСписка = Истина;
	Поле.Подсказка = НСтр("ru = 'Выше - точнее на плохих фото, но дольше и дороже. Рекомендуется high.'");
	ДобавитьПоле("РезервнаяМодель", "РезервнаяМодель", СтраницаНастройки, ВидПоляФормы.ПолеФлажка);
	ДобавитьПоле("ТаймаутСекунд", "ТаймаутСекунд", СтраницаНастройки);
	ДобавитьПоле("ПорогЦены", "ПорогЦены", СтраницаНастройки);
	Поле = ДобавитьПоле("ТекстОтвета", "ТекстОтвета", СтраницаНастройки);
	Поле.МногострочныйРежим = Истина;
	Поле.ТолькоПросмотр = Истина;
	Поле.Высота = 10;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Родитель, Вид, ТекстЗаголовка = "", Горизонтальная = Ложь)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = Вид;
	Если Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
		Группа.ОтображатьЗаголовок = Не ПустаяСтрока(ТекстЗаголовка);
		Группа.Группировка = ?(Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстЗаголовка) Тогда
		Группа.Заголовок = ТекстЗаголовка;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
Функция ДобавитьПоле(Имя, ПутьКДанным, Родитель, Вид = Неопределено)

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Вид = ?(Вид = Неопределено, ВидПоляФормы.ПолеВвода, Вид);
	Возврат Поле;

КонецФункции

&НаСервере
Процедура НастроитьУсловноеОформление()

	// Строки без подобранной номенклатуры подсвечиваются.
	Оформление = УсловноеОформление.Элементы.Добавить();
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Номенклатура");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Отбор.Использование = Истина;
	Для Каждого Колонка Из СтрРазделить("ТоварыНаименование,ТоварыНоменклатура", ",") Цикл
		ПолеОформления = Оформление.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Колонка);
	КонецЦикла;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 228, 225));

	// Цена сильно отличается от прошлой закупки - жёлтым.
	Оформление = УсловноеОформление.Элементы.Добавить();
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.ЦенаОтличается");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Отбор.Использование = Истина;
	Для Каждого Колонка Из СтрРазделить("ТоварыЦена,ТоварыПрошлаяЦена,ТоварыИзменениеЦены", ",") Цикл
		ПолеОформления = Оформление.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Колонка);
	КонецЦикла;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 236, 150));

	// Расхождение с заказом поставщику - оранжевым.
	Оформление = УсловноеОформление.Элементы.Добавить();
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.РасхождениеСЗаказом");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Отбор.Использование = Истина;
	Для Каждого Колонка Из СтрРазделить("ТоварыКоличество,ТоварыПоЗаказу,ТоварыЦенаПоЗаказу,ТоварыСверка", ",") Цикл
		ПолеОформления = Оформление.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Колонка);
	КонецЦикла;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 200, 150));

КонецПроцедуры

