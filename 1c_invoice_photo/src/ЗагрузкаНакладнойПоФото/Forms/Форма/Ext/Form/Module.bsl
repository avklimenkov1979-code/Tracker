	Реквизиты.Добавить(Новый РеквизитФормы("ПрошлаяЦенаОткуда", ТипСтрока, "Товары", НСтр("ru = 'Когда покупали'")));
	Реквизиты.Добавить(Новый РеквизитФормы("ЦенаОтличается", ТипБулево, "Товары"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоЗаказу", ТипКоличество, "Товары", НСтр("ru = 'Ждём по заказу'")));
	Реквизиты.Добавить(Новый РеквизитФормы("ЦенаПоЗаказу", ТипСумма, "Товары", НСтр("ru = 'Цена по заказу'")));
	Реквизиты.Добавить(Новый РеквизитФормы("Сверка", ТипСтрока, "Товары", НСтр("ru = 'Сверка с заказом'")));
	Реквизиты.Добавить(Новый РеквизитФормы("РасхождениеСЗаказом", ТипБулево, "Товары"));

	ИзменитьРеквизиты(Реквизиты);

КонецПроцедуры

