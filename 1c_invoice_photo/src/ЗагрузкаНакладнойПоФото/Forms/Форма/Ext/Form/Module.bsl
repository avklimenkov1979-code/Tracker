Функция ЗначениеИзОтвета(Данные, Ключ, ПоУмолчанию)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Результат = Данные.Получить(Ключ);
	Если Результат = Неопределено Или ТипЗнч(Результат) <> ТипЗнч(ПоУмолчанию) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Результат;

