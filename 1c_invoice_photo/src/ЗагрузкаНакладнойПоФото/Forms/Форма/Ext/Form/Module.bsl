// Заполняет колонки "Прошлая цена" и "Изменение, %" и отмечает строки,
// где цена отличается больше чем на порог из настроек.
// Возвращает количество таких строк.
&НаСервере
Функция ОбновитьКонтрольЦенНаСервере()

	МассивНоменклатуры = Новый Массив;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			МассивНоменклатуры.Добавить(ТекущаяСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	ПрошлыеЦены = РеквизитФормыВЗначение("Объект").ПрошлыеЦеныЗакупки(МассивНоменклатуры, ЭтотОбъект.Контрагент);

	КоличествоОтличий = 0;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		ТекущаяСтрока.ПрошлаяЦена = 0;
		ТекущаяСтрока.ИзменениеЦены = 0;
		ТекущаяСтрока.ЦенаОтличается = Ложь;
		ТекущаяСтрока.ПрошлаяЦенаОткуда = "";

		Прошлая = ПрошлыеЦены.Получить(ТекущаяСтрока.Номенклатура);
		Если Прошлая = Неопределено Или Прошлая.Цена = 0 Тогда
			ТекущаяСтрока.ПрошлаяЦенаОткуда = НСтр("ru = 'раньше не закупали'");
			Продолжить;
		КонецЕсли;

		ЦенаСейчас = ?(ТекущаяСтрока.Количество = 0, ТекущаяСтрока.Цена,
			ТекущаяСтрока.СуммаБезНДС / ТекущаяСтрока.Количество);
		ТекущаяСтрока.ПрошлаяЦена = Прошлая.Цена;
		ТекущаяСтрока.ИзменениеЦены = Окр((ЦенаСейчас - Прошлая.Цена) / Прошлая.Цена * 100, 1);
		ТекущаяСтрока.ПрошлаяЦенаОткуда = Формат(Прошлая.Дата, "ДФ=dd.MM.yyyy")
			+ ?(Прошлая.ЭтотПоставщик, "", ", " + Строка(Прошлая.Поставщик));
		ТекущаяСтрока.ЦенаОтличается = ЭтотОбъект.ПорогЦены > 0
			И Макс(ТекущаяСтрока.ИзменениеЦены, -ТекущаяСтрока.ИзменениеЦены) > ЭтотОбъект.ПорогЦены;
		Если ТекущаяСтрока.ЦенаОтличается Тогда
			КоличествоОтличий = КоличествоОтличий + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат КоличествоОтличий;

КонецФункции

&НаСервере
Функция СоздатьДокументНаСервере()

	Шапка = Новый Структура;
	Шапка.Вставить("Организация", ЭтотОбъект.Организация);
	Шапка.Вставить("Контрагент", ЭтотОбъект.Контрагент);
	Шапка.Вставить("Партнер", ЭтотОбъект.Партнер);
	Шапка.Вставить("Договор", ЭтотОбъект.Договор);
	Шапка.Вставить("Склад", ЭтотОбъект.Склад);
	Шапка.Вставить("НомерВходящегоДокумента", ЭтотОбъект.НомерВходящегоДокумента);
	Шапка.Вставить("ДатаВходящегоДокумента", ЭтотОбъект.ДатаВходящегоДокумента);
	Шапка.Вставить("ЦенаВключаетНДС", ЭтотОбъект.ЦенаВключаетНДС);
	Если ЭтотОбъект.ПривязатьКЗаказу И ЗначениеЗаполнено(ЭтотОбъект.ЗаказПоставщику) Тогда
		Шапка.Вставить("ЗаказПоставщику", ЭтотОбъект.ЗаказПоставщику);
	КонецЕсли;
	Шапка.Вставить("Комментарий", НСтр("ru = 'Загружено по фото накладной'"));

	Строки = Новый Массив;
	Для Каждого ТекущаяСтрока Из ЭтотОбъект.Товары Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		ДанныеСтроки.Вставить("Артикул", ТекущаяСтрока.Артикул);
		ДанныеСтроки.Вставить("Наименование", ТекущаяСтрока.Наименование);
		ДанныеСтроки.Вставить("Количество", ТекущаяСтрока.Количество);
		ДанныеСтроки.Вставить("СтавкаНДС", ТекущаяСтрока.СтавкаНДС);
		ДанныеСтроки.Вставить("СуммаНДС", ТекущаяСтрока.СуммаНДС);
		ДанныеСтроки.Вставить("СуммаСНДС", ТекущаяСтрока.СуммаСНДС);
		// В ERP "Сумма" строки - сумма по цене документа: с НДС, если цена включает НДС.
		Если ЭтотОбъект.ЦенаВключаетНДС Тогда
			ДанныеСтроки.Вставить("Сумма", ТекущаяСтрока.СуммаСНДС);
			ДанныеСтроки.Вставить("Цена", ?(ТекущаяСтрока.Количество = 0, 0, Окр(ТекущаяСтрока.СуммаСНДС / ТекущаяСтрока.Количество, 2)));
		Иначе
			ДанныеСтроки.Вставить("Сумма", ТекущаяСтрока.СуммаБезНДС);
			ДанныеСтроки.Вставить("Цена", ТекущаяСтрока.Цена);
		КонецЕсли;
		Строки.Добавить(ДанныеСтроки);
	КонецЦикла;

	Обработка = РеквизитФормыВЗначение("Объект");
	Ссылка = Обработка.СоздатьДокументПоступления(Шапка, Строки);
	Обработка.ЗапомнитьСопоставления(ЭтотОбъект.ПоставщикИНН, Строки);
	Возврат Ссылка;

