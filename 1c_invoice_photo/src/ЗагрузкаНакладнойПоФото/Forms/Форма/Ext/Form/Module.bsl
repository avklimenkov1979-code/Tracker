&НаСервереБезКонтекста
Функция ДатаИзСтроки(Знач Текст)

	Текст = СтрЗаменить(СокрЛП(Текст), "-", "");
	Если СтрДлина(Текст) <> 8 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Текст + "000000");
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

