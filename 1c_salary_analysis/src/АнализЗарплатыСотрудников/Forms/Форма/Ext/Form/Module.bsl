// Форма обработки «Анализ зарплаты сотрудников» (1С:ERP 2.5, зарплата ведётся в ERP).
//
// Период (по умолчанию — три полных месяца перед текущим), организация, порог отклонений, МРОТ.
// «Сформировать» — отчёт-анализ в табличном документе; «Сохранить в Excel» — в файл xlsx.
// «Диагностика» — структура зарплатных регистров базы и количество записей без фамилий и сумм
// по людям: если отчёт пустой или пишет ошибку, этот файл присылают в чат.
//
// Расчёты — в модуле объекта. Реквизиты и элементы формы создаются в ПриСозданииНаСервере,
// поэтому Form.xml почти пустой и обработка собирается в пустой базе.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();
	Заголовок = "Анализ зарплаты сотрудников";
	УстановитьПоследниеТриМесяца();
	ЭтотОбъект.ПорогИзменения = 20;
	ЭтотОбъект.МРОТ = 27093; // МРОТ с 01.01.2026, при необходимости поправьте на форме
	ЭтотОбъект.ПоФизическимЛицам = Ложь;

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Сформировать(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Заполните период анализа.");
		Возврат;
	КонецЕсли;
	Если НачалоМесяца(ЭтотОбъект.ДатаНачала) > НачалоМесяца(ЭтотОбъект.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Месяц начала позже месяца окончания.");
		Возврат;
	КонецЕсли;
	Состояние("Собираю начисления, НДФЛ и удержания по сотрудникам...");
	Попытка
		СформироватьНаСервере();
	Исключение
		ЗапомнитьОшибку("Формирование отчёта", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Отчёт не сформировался:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Диагностика» и «Сообщить об ошибке» и пришлите оба файла в чат.");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ЭтотОбъект.Результат = Обработка.СформироватьОтчет(ЭтотОбъект.ДатаНачала, ЭтотОбъект.ДатаОкончания,
		ОрганизацияИзФормы(), ЭтотОбъект.ПорогИзменения, ЭтотОбъект.МРОТ, ЭтотОбъект.ПоФизическимЛицам);
	ЭтотОбъект.ИмяРезультата = "Анализ_зарплаты_" + Формат(ЭтотОбъект.ДатаНачала, "ДФ=yyyy_MM")
		+ "_" + Формат(ЭтотОбъект.ДатаОкончания, "ДФ=yyyy_MM");

КонецПроцедуры

&НаКлиенте
Процедура АнализУчастков(Команда)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Заполните «По месяц»: анализ участков строится за 12 месяцев, заканчивая этим месяцем.");
		Возврат;
	КонецЕсли;
	Состояние("Собираю выпуск по рапортам и зарплату работников участков за 12 месяцев — 1–5 минут...");
	Попытка
		АнализУчастковНаСервере();
	Исключение
		ЗапомнитьОшибку("Анализ участков", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Анализ участков не сформировался:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Диагностика» и «Сообщить об ошибке» и пришлите оба файла в чат.");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура АнализУчастковНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ЭтотОбъект.Результат = Обработка.СформироватьАнализУчастков(ЭтотОбъект.ДатаОкончания, ОрганизацияИзФормы(), ЭтотОбъект.ПорогИзменения);
	ЭтотОбъект.ИмяРезультата = "Участки_ЗП_и_выпуск_" + Формат(ЭтотОбъект.ДатаОкончания, "ДФ=yyyy_MM");

КонецПроцедуры

&НаКлиенте
Процедура ПоследниеТриМесяца(Команда)

	УстановитьПоследниеТриМесяцаНаСервере();

КонецПроцедуры

&НаСервере
Процедура УстановитьПоследниеТриМесяцаНаСервере()

	УстановитьПоследниеТриМесяца();

КонецПроцедуры

&НаСервере
Процедура УстановитьПоследниеТриМесяца()

	// Три полных месяца перед текущим: в ноябре — август, сентябрь, октябрь.
	ТекущийМесяц = НачалоМесяца(ТекущаяДатаСеанса());
	ЭтотОбъект.ДатаНачала = ДобавитьМесяц(ТекущийМесяц, -3);
	ЭтотОбъект.ДатаОкончания = КонецМесяца(ДобавитьМесяц(ТекущийМесяц, -1));

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВExcel(Команда)

	Если ПустаяСтрока(ЭтотОбъект.ИмяРезультата) Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Сформировать».");
		Возврат;
	КонецЕсли;
	СохранитьДанные(РезультатВХранилище(), ЭтотОбъект.ИмяРезультата + ".xlsx");

КонецПроцедуры

&НаСервере
Функция РезультатВХранилище()

	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	ЭтотОбъект.Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	Возврат ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура Диагностика(Команда)

	Состояние("Проверяю зарплатные регистры базы...");
	Попытка
		Адрес = ДиагностикаНаСервере();
	Исключение
		ЗапомнитьОшибку("Диагностика", ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Диагностика не выполнилась:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + Символы.ПС + "Нажмите «Сообщить об ошибке» и пришлите файл в чат.");
		Возврат;
	КонецПопытки;
	СохранитьДанные(Адрес, "Диагностика_зарплаты_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".txt");

КонецПроцедуры

&НаСервере
Функция ДиагностикаНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Текст = Обработка.Диагностика(ЭтотОбъект.ДатаНачала, ЭтотОбъект.ДатаОкончания, ОрганизацияИзФормы());
	Возврат ПоместитьТекстВХранилище(Текст, Истина);

КонецФункции

#КонецОбласти

#Область Общее

&НаКлиенте
Процедура СообщитьОбОшибке(Команда)

	СисИнфо = Новый СистемнаяИнформация;
	Строки = Новый Массив;
	Строки.Добавить("СООБЩЕНИЕ ОБ ОШИБКЕ: Анализ зарплаты сотрудников, версия " + ВерсияПрограммы());
	Строки.Добавить("1С на компьютере: " + СисИнфо.ВерсияПриложения + " (" + СисИнфо.ТипПлатформы + "); " + СисИнфо.ВерсияОС);
	Строки.Добавить(СведенияОБазе());
	Строки.Добавить("Период: " + Формат(ЭтотОбъект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — " + Формат(ЭтотОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ "; порог " + ЭтотОбъект.ПорогИзменения + "%; МРОТ " + ЭтотОбъект.МРОТ
		+ "; по физлицам: " + ?(ЭтотОбъект.ПоФизическимЛицам, "да", "нет"));
	Строки.Добавить("");
	Строки.Добавить("ОШИБКИ");
	Строки.Добавить(?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), "  нет", ЭтотОбъект.ЖурналОшибок));
	Текст = СтрСоединить(Строки, Символы.ПС);
	СохранитьДанные(ПоместитьТекстВХранилище(Текст, Истина), "Ошибка_Анализ_зарплаты_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmm") + ".txt");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанные(Адрес, ИмяФайлаДанных)

	ПоказатьОповещениеПользователя("Сохранение файла", , ИмяФайлаДанных);
	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайлаДанных);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПоместитьТекстВХранилище(Знач Текст, Обезличить)

	// всё, что уходит в чат, обезличивается здесь: фамилии и названия -> коды, длинные номера -> звёздочки
	Если Обезличить Тогда
		Текст = РеквизитФормыВЗначение("Объект").ОбезличитьДляЧата(Текст);
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"), УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция ОрганизацияИзФормы()

	Если ЕстьОрганизации() Тогда
		Возврат ЭтотОбъект.Организация;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция СведенияОБазе()

	СисИнфо = Новый СистемнаяИнформация;
	Возврат "Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + "; 1С на сервере: " + СисИнфо.ВерсияПриложения;

КонецФункции

&НаСервереБезКонтекста
Функция ВерсияПрограммы()

	Возврат "1.7 от 27.11.2026";

КонецФункции

&НаКлиенте
Процедура ЗапомнитьОшибку(Где, Инфо)

	Запись = "[" + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "] " + Где + ":" + Символы.ПС + ПодробноеПредставлениеОшибки(Инфо);
	ЭтотОбъект.ЖурналОшибок = ?(ПустаяСтрока(ЭтотОбъект.ЖурналОшибок), Запись, ЭтотОбъект.ЖурналОшибок + Символы.ПС + Символы.ПС + Запись);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьОрганизации()

	Возврат Метаданные.Справочники.Найти("Организации") <> Неопределено;

КонецФункции

#КонецОбласти

#Область ПостроениеФормы

&НаСервере
Процедура СоздатьРеквизиты()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипПроцент = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 1, ДопустимыйЗнак.Неотрицательный));
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаНачала", ТипДата, , "С месяца"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаОкончания", ТипДата, , "По месяц"));
	Если ЕстьОрганизации() Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация (пусто — все)"));
	КонецЕсли;
	Реквизиты.Добавить(Новый РеквизитФормы("ПорогИзменения", ТипПроцент, , "Порог изменения, %"));
	Реквизиты.Добавить(Новый РеквизитФормы("МРОТ", ТипСумма, , "МРОТ (0 — не проверять)"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоФизическимЛицам", ТипБулево, , "Объединять совместительства (по физлицам)"));
	Реквизиты.Добавить(Новый РеквизитФормы("Результат", Новый ОписаниеТипов("ТабличныйДокумент"), , "Результат"));
	Реквизиты.Добавить(Новый РеквизитФормы("ИмяРезультата", ТипСтрока));
	Реквизиты.Добавить(Новый РеквизитФормы("ЖурналОшибок", ТипСтрока));
	ИзменитьРеквизиты(Реквизиты);

КонецПроцедуры

&НаСервере
Процедура СоздатьКоманды()

	ДобавитьКоманду("Сформировать", "Сформировать", "Анализ начислений, НДФЛ и удержаний по всем сотрудникам за период");
	ДобавитьКоманду("АнализУчастков", "Участки: ЗП и выпуск за год",
		"Производственные участки за 12 месяцев по «По месяц»: зарплата работников участка и выпуск по рапортам, ФОТ на тонну, перекосы");
	ДобавитьКоманду("ПоследниеТриМесяца", "Последние 3 месяца", "Три полных месяца перед текущим");
	ДобавитьКоманду("СохранитьВExcel", "Сохранить в Excel", "Сохранить отчёт в файл xlsx");
	ДобавитьКоманду("Диагностика", "Диагностика (в файл)",
		"Структура зарплатных регистров и число записей по месяцам, без фамилий: прислать в чат, если отчёт пустой");
	ДобавитьКоманду("СообщитьОбОшибке", "Сообщить об ошибке", "Собрать тексты ошибок в файл, чтобы прислать в чат");

	Кнопка = Элементы.Добавить("КнопкаСообщитьОбОшибке", Тип("КнопкаФормы"), КоманднаяПанель);
	Кнопка.ИмяКоманды = "СообщитьОбОшибке";

КонецПроцедуры

&НаСервере
Процедура ДобавитьКоманду(Имя, ТекстЗаголовка, ТекстПодсказки)

	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = ТекстЗаголовка;
	Команда.Действие = Имя;
	Если НЕ ПустаяСтрока(ТекстПодсказки) Тогда
		Команда.Подсказка = ТекстПодсказки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементы()

	ДобавитьНадпись("Подсказка", ЭтотОбъект,
		"Начисления, НДФЛ и удержания по всем сотрудникам из зарплатного учёта ERP — по месяцу регистрации. "
		+ "В отчёте: выводы, сводка по месяцам, структура ФОТ, подразделения, сотрудники с отклонениями (что проверить), "
		+ "таблица по каждому сотруднику и по видам начислений. Данные — в пределах ваших прав в 1С.");

	ГруппаПериод = ДобавитьГруппу("ГруппаПериод", ЭтотОбъект, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("ДатаНачала", "ДатаНачала", ГруппаПериод);
	ДобавитьПоле("ДатаОкончания", "ДатаОкончания", ГруппаПериод);
	Если ЕстьОрганизации() Тогда
		ДобавитьПоле("Организация", "Организация", ГруппаПериод).РастягиватьПоГоризонтали = Истина;
	КонецЕсли;

	ГруппаНастройки = ДобавитьГруппу("ГруппаНастройки", ЭтотОбъект, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьПоле("ПорогИзменения", "ПорогИзменения", ГруппаНастройки);
	ДобавитьПоле("МРОТ", "МРОТ", ГруппаНастройки);
	Поле = ДобавитьПоле("ПоФизическимЛицам", "ПоФизическимЛицам", ГруппаНастройки, ВидПоляФормы.ПолеФлажка);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;

	ГруппаКнопки = ДобавитьГруппу("ГруппаКнопки", ЭтотОбъект, ВидГруппыФормы.ОбычнаяГруппа, , Истина);
	ДобавитьКнопку("Сформировать", ГруппаКнопки).КнопкаПоУмолчанию = Истина;
	ДобавитьКнопку("АнализУчастков", ГруппаКнопки);
	ДобавитьКнопку("ПоследниеТриМесяца", ГруппаКнопки);
	ДобавитьКнопку("СохранитьВExcel", ГруппаКнопки);
	ДобавитьКнопку("Диагностика", ГруппаКнопки);

	Поле = ДобавитьПоле("Результат", "Результат", ЭтотОбъект, ВидПоляФормы.ПолеТабличногоДокумента);
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;

КонецПроцедуры

&НаСервере
Процедура ДобавитьНадпись(Имя, Родитель, Текст)

	Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = Текст;
	Надпись.РастягиватьПоГоризонтали = Истина;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Родитель, ВидГруппы, ТекстЗаголовка = "", Горизонтальная = Ложь)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппы;
	Если ВидГруппы = ВидГруппыФормы.ОбычнаяГруппа Тогда
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		Группа.ОтображатьЗаголовок = НЕ ПустаяСтрока(ТекстЗаголовка);
		Группа.Группировка = ?(Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная,
			ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстЗаголовка) Тогда
		Группа.Заголовок = ТекстЗаголовка;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
Функция ДобавитьПоле(Имя, ПутьКДанным, Родитель, ВидПоля = Неопределено)

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Вид = ?(ВидПоля = Неопределено, ВидПоляФормы.ПолеВвода, ВидПоля);
	Возврат Поле;

КонецФункции

&НаСервере
Функция ДобавитьКнопку(ИмяКомандыКнопки, Родитель)

	Кнопка = Элементы.Добавить("Кнопка" + ИмяКомандыКнопки, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = ИмяКомандыКнопки;
	Возврат Кнопка;

КонецФункции

#КонецОбласти
