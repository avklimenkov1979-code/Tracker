// Модуль объекта внешней обработки «Анализ зарплаты сотрудников» (1С:ERP 2.5, зарплата ведётся в ERP).
//
// Источник данных — регистр накопления «НачисленияУдержанияПоСотрудникам» зарплатной подсистемы ERP
// (та же, что в ЗУП 3.1), подразделение и должность — «КадроваяИсторияСотрудников». Состав полей
// регистров проверяется по метаданным, поэтому обработка не падает, если какого-то поля в базе нет.
// Форма только вызывает эти функции: СформироватьОтчет() и Диагностика().

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Регистрация

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Информация = "Анализ начислений, НДФЛ и удержаний по всем сотрудникам за последние месяцы: "
		+ "динамика ФОТ, структура, подразделения, сотрудники с отклонениями.";

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Анализ зарплаты сотрудников";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

Функция ВерсияОбработки() Экспорт

	Возврат "1.9";

КонецФункции

#КонецОбласти

#Область ФормированиеОтчета

// Формирует отчет-анализ.
//
// Параметры:
//   ДатаНачала, ДатаОкончания - Дата - любые даты внутри первого и последнего месяца периода.
//   Организация - СправочникСсылка.Организации, Неопределено - пусто: все организации.
//   ПорогИзменения - Число - порог изменения начислений в %, выше которого сотрудник отмечается.
//   МРОТ - Число - 0: проверка не выполняется.
//   ПоФизическимЛицам - Булево - объединять начисления по всем сотрудникам физлица.
//
// Возвращаемое значение:
//   ТабличныйДокумент
//
Функция СформироватьОтчет(Знач ДатаНачала, Знач ДатаОкончания, Знач Организация = Неопределено,
		Знач ПорогИзменения = 20, Знач МРОТ = 0, Знач ПоФизическимЛицам = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ВызватьИсключение "Не заполнен период анализа.";
	КонецЕсли;

	НачалоПериода = НачалоМесяца(ДатаНачала);
	КонецПериода = КонецМесяца(ДатаОкончания);
	Если НачалоПериода > КонецПериода Тогда
		ВызватьИсключение "Месяц начала периода позже месяца окончания.";
	КонецЕсли;

	Месяцы = Новый Массив;
	ТекМесяц = НачалоПериода;
	Пока ТекМесяц <= КонецПериода Цикл
		Месяцы.Добавить(ТекМесяц);
		ТекМесяц = ДобавитьМесяц(ТекМесяц, 1);
	КонецЦикла;

	Если ПорогИзменения = Неопределено Или ПорогИзменения <= 0 Тогда
		ПорогИзменения = 20;
	КонецЕсли;
	Если МРОТ = Неопределено Тогда
		МРОТ = 0;
	КонецЕсли;

	Данные = ПолучитьДанныеНачислений(НачалоПериода, КонецПериода, Организация, Месяцы, ПоФизическимЛицам);
	ДополнитьКадровымиДанными(Данные, КонецПериода);
	Аналитика = РассчитатьАналитику(Данные, Месяцы, ПорогИзменения, МРОТ);

	ТД = Новый ТабличныйДокумент;
	ТД.КлючПараметровПечати = "АнализЗарплатыСотрудников";
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТД.АвтоМасштаб = Истина;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.ТолькоПросмотр = Истина;

	Контекст = НовыйКонтекстВывода(ТД, Месяцы);
	УстановитьШириныКолонок(Контекст);

	ВывестиЗаголовокОтчета(Контекст, НачалоПериода, КонецПериода, Организация, Данные, ПорогИзменения, МРОТ);

	Если Аналитика.Сотрудники.Количество() = 0 Тогда
		ВывестиЯчейку(Контекст, 2, "За выбранный период начислений не найдено.", "Ж");
		НоваяСтрока(Контекст);
		Возврат ТД;
	КонецЕсли;

	ВывестиВыводы(Контекст, Аналитика);
	ВывестиЧтоИзменилось(Контекст, Аналитика);
	ВывестиРасшифровкуПоВыплатам(Контекст, Аналитика);
	ВывестиСводкуПоМесяцам(Контекст, Аналитика);
	ВывестиСтруктуруФОТ(Контекст, Аналитика);
	ВывестиПоПодразделениям(Контекст, Аналитика);
	ВывестиТребующихВнимания(Контекст, Аналитика);
	ВывестиДеталиПоСотрудникам(Контекст, Аналитика);
	ВывестиВидыНачислений(Контекст, Аналитика);

	Возврат ТД;

КонецФункции

#КонецОбласти

#Область Диагностика

// Текст для чата: какие зарплатные регистры есть в базе, их поля, группы начислений и сколько записей
// по месяцам. Фамилий и сумм по людям нет; перед сохранением текст ещё раз обезличивается.
Функция Диагностика(Знач ДатаНачала, Знач ДатаОкончания, Знач Организация = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -3);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецМесяца(ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -1));
	КонецЕсли;
	НачалоПериода = НачалоМесяца(ДатаНачала);
	КонецПериода = КонецМесяца(ДатаОкончания);
	СисИнфо = Новый СистемнаяИнформация;

	Строки = Новый Массив;
	Строки.Добавить("ДИАГНОСТИКА: Анализ зарплаты сотрудников, версия " + ВерсияОбработки());
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + "; 1С на сервере: " + СисИнфо.ВерсияПриложения);
	Строки.Добавить("Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " — " + Формат(КонецПериода, "ДФ=dd.MM.yyyy")
		+ "; организация: " + ?(ЗначениеЗаполнено(Организация), "выбрана", "все"));
	Строки.Добавить("");

	Строки.Добавить("ЗАРПЛАТНЫЕ РЕГИСТРЫ В БАЗЕ (имена содержат «начисл», «удерж», «зарплат», «кадров», «ндфл»)");
	Слова = СтрРазделить("начисл,удерж,зарплат,кадров,ндфл,взаиморасчетысс", ",");
	Для Каждого Коллекция Из СтрРазделить("РегистрыНакопления,РегистрыСведений,РегистрыРасчета", ",") Цикл
		Найдено = Новый Массив;
		Для Каждого МетаРегистр Из Метаданные[Коллекция] Цикл
			Имя = НРег(МетаРегистр.Имя);
			Для Каждого Слово Из Слова Цикл
				Если СтрНайти(Имя, Слово) > 0 Тогда
					Найдено.Добавить(МетаРегистр.Имя);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Строки.Добавить("  " + Коллекция + " (" + Найдено.Количество() + "): " + ?(Найдено.Количество() = 0, "нет", СтрСоединить(Найдено, ", ")));
	КонецЦикла;
	Строки.Добавить("");

	МетаРегистр = Метаданные.РегистрыНакопления.Найти("НачисленияУдержанияПоСотрудникам");
	Если МетаРегистр = Неопределено Тогда
		Строки.Добавить("!!! Регистра накопления «НачисленияУдержанияПоСотрудникам» нет — отчёт формироваться не будет.");
		Строки.Добавить("    Пришлите этот файл: по списку регистров выше подберу, откуда брать начисления.");
	Иначе
		Строки.Добавить("РЕГИСТР НачисленияУдержанияПоСотрудникам (" + МетаРегистр.ВидРегистра + ")");
		ДобавитьПоляРегистра(Строки, МетаРегистр);
		Попытка
			ДобавитьСтатистикуНачислений(Строки, МетаРегистр, НачалоПериода, КонецПериода, Организация);
		Исключение
			Строки.Добавить("  ОШИБКА запроса к регистру: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Строки.Добавить("");

	МетаПеречисление = Метаданные.Перечисления.Найти("ГруппыНачисленияУдержанияВыплаты");
	Если МетаПеречисление = Неопределено Тогда
		Строки.Добавить("Перечисления «ГруппыНачисленияУдержанияВыплаты» нет: тип строк определяется по виду расчёта.");
	Иначе
		Строки.Добавить("ГРУППЫ НАЧИСЛЕНИЯ/УДЕРЖАНИЯ (как обработка их понимает)");
		КэшТипов = Новый Соответствие;
		Для Каждого МетаЗначение Из МетаПеречисление.ЗначенияПеречисления Цикл
			Значение = Перечисления[МетаПеречисление.Имя][МетаЗначение.Имя];
			ТипСтроки = ТипСтрокиНачисления(Значение, Неопределено, "", КэшТипов);
			Строки.Добавить("  " + МетаЗначение.Имя + " («" + МетаЗначение.Синоним + "») -> "
				+ ?(ТипСтроки = "", "не учитывается", ТипСтроки));
		КонецЦикла;
	КонецЕсли;
	Строки.Добавить("");

	МетаКИ = Метаданные.РегистрыСведений.Найти("КадроваяИсторияСотрудников");
	Если МетаКИ = Неопределено Тогда
		Строки.Добавить("Регистра сведений «КадроваяИсторияСотрудников» нет: подразделение — из регистра начислений, должности не будет.");
	Иначе
		Строки.Добавить("РЕГИСТР КадроваяИсторияСотрудников (периодичность: " + МетаКИ.ПериодичностьРегистраСведений + ")");
		ДобавитьПоляРегистра(Строки, МетаКИ);
	КонецЕсли;

	ДобавитьДиагностикуУчастков(Строки, КонецПериода, Организация);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьПоляРегистра(Строки, МетаРегистр)

	Для Каждого Коллекция Из СтрРазделить("Измерения,Ресурсы,Реквизиты", ",") Цикл
		Поля = Новый Массив;
		Для Каждого МетаПоле Из МетаРегистр[Коллекция] Цикл
			Типы = Новый Массив;
			Для Каждого ТипПоля Из МетаПоле.Тип.Типы() Цикл
				МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
				Типы.Добавить(?(МетаТипа = Неопределено, Строка(ТипПоля), МетаТипа.ПолноеИмя()));
				Если Типы.Количество() >= 3 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Поля.Добавить(МетаПоле.Имя + " [" + СтрСоединить(Типы, ", ") + ?(МетаПоле.Тип.Типы().Количество() > 3, ", ...", "") + "]");
		КонецЦикла;
		Строки.Добавить("  " + Коллекция + ": " + ?(Поля.Количество() = 0, "нет", СтрСоединить(Поля, "; ")));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтатистикуНачислений(Строки, МетаРегистр, НачалоПериода, КонецПериода, Организация)

	ЕстьГруппа = ЕстьПолеРегистра(МетаРегистр, "ГруппаНачисленияУдержанияВыплаты");
	ПолеСотрудника = ?(ЕстьПолеРегистра(МетаРегистр, "Сотрудник"), "Сотрудник", "ФизическоеЛицо");
	УсловиеОрганизации = "";
	Если ЗначениеЗаполнено(Организация) И ЕстьПолеРегистра(МетаРегистр, "Организация") Тогда
		УсловиеОрганизации = Символы.ПС + "	И Н.Организация = &Организация";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(Н.Период, МЕСЯЦ) КАК Месяц,
		|	" + ?(ЕстьГруппа, "Н.ГруппаНачисленияУдержанияВыплаты", "НЕОПРЕДЕЛЕНО") + " КАК Группа,
		|	КОЛИЧЕСТВО(*) КАК Записей,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Н." + ПолеСотрудника + ") КАК Сотрудников,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Н.НачислениеУдержание) КАК Видов
		|ИЗ
		|	РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК Н
		|ГДЕ
		|	Н.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Н.Активность" + УсловиеОрганизации + "
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Н.Период, МЕСЯЦ)" + ?(ЕстьГруппа, ",
		|	Н.ГруппаНачисленияУдержанияВыплаты", "") + "
		|УПОРЯДОЧИТЬ ПО
		|	Месяц";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);

	Выборка = Запрос.Выполнить().Выбрать();
	Строки.Добавить("  Записи за период по месяцам и группам (месяц | группа | записей | сотрудников | видов расчёта):");
	Всего = 0;
	Пока Выборка.Следующий() Цикл
		Всего = Всего + Выборка.Записей;
		Строки.Добавить("    " + Формат(Выборка.Месяц, "ДФ=MM.yyyy") + " | " + ?(ЗначениеЗаполнено(Выборка.Группа), ИмяЗначенияПеречисления(Выборка.Группа), "-")
			+ " | " + Формат(Выборка.Записей, "ЧГ=0") + " | " + Формат(Выборка.Сотрудников, "ЧГ=0") + " | " + Формат(Выборка.Видов, "ЧГ=0"));
	КонецЦикла;
	Если Всего = 0 Тогда
		Строки.Добавить("  !!! За период записей нет: проверьте, что зарплата начисляется в этой базе (документы «Начисление зарплаты и взносов») и они проведены.");
	КонецЕсли;

	// Какие виды начислений есть и в какую категорию отчёта они попадают (названия видов — не персональные данные).
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 60
		|	Т.Вид КАК Вид,
		|	ПРЕДСТАВЛЕНИЕ(Т.Вид) КАК ВидПредставление,
		|	Т.Записей КАК Записей
		|ИЗ
		|	(ВЫБРАТЬ
		|		Н.НачислениеУдержание КАК Вид,
		|		КОЛИЧЕСТВО(*) КАК Записей
		|	ИЗ
		|		РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК Н
		|	ГДЕ
		|		Н.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|		И Н.Активность" + СтрЗаменить(УсловиеОрганизации, Символы.ПС + "	", Символы.ПС + "		") + "
		|	СГРУППИРОВАТЬ ПО
		|		Н.НачислениеУдержание) КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Записей УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Строки.Добавить("  Виды расчёта за период (до 60, по числу записей): вид | записей | категория в отчёте");
	Пока Выборка.Следующий() Цикл
		ИмяМетаданных = "";
		Попытка
			ИмяМетаданных = Выборка.Вид.Метаданные().Имя;
		Исключение
			ИмяМетаданных = "";
		КонецПопытки;
		Строки.Добавить("    " + Выборка.ВидПредставление + " (" + ИмяМетаданных + ") | " + Формат(Выборка.Записей, "ЧГ=0")
			+ " | " + КатегорияНачисления(Выборка.ВидПредставление));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПолучениеДанных

Функция ПолучитьДанныеНачислений(НачалоПериода, КонецПериода, Организация, Месяцы, ПоФизическимЛицам)

	МетаРегистр = Метаданные.РегистрыНакопления.Найти("НачисленияУдержанияПоСотрудникам");
	Если МетаРегистр = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет регистра накопления ""НачисленияУдержанияПоСотрудникам"". "
			+ "Обработка рассчитана на ЗУП 3.1, БП 3.0 и другие конфигурации с БЗК.";
	КонецЕсли;

	Если ПоФизическимЛицам И ЕстьПолеРегистра(МетаРегистр, "ФизическоеЛицо") Тогда
		ПолеСотрудника = "ФизическоеЛицо";
	ИначеЕсли ЕстьПолеРегистра(МетаРегистр, "Сотрудник") Тогда
		ПолеСотрудника = "Сотрудник";
	ИначеЕсли ЕстьПолеРегистра(МетаРегистр, "ФизическоеЛицо") Тогда
		ПолеСотрудника = "ФизическоеЛицо";
	Иначе
		ВызватьИсключение "В регистре ""НачисленияУдержанияПоСотрудникам"" нет измерений ""Сотрудник"" или ""ФизическоеЛицо"".";
	КонецЕсли;
	Если Не ЕстьПолеРегистра(МетаРегистр, "НачислениеУдержание") Или Не ЕстьПолеРегистра(МетаРегистр, "Сумма") Тогда
		ВызватьИсключение "В регистре ""НачисленияУдержанияПоСотрудникам"" нет полей ""НачислениеУдержание"" и ""Сумма"".";
	КонецЕсли;

	ЕстьГруппа = ЕстьПолеРегистра(МетаРегистр, "ГруппаНачисленияУдержанияВыплаты");
	ЕстьПодразделение = ЕстьПолеРегистра(МетаРегистр, "Подразделение");
	ЕстьОрганизация = ЕстьПолеРегистра(МетаРегистр, "Организация");

	// Внутренний запрос группирует движения, внешний получает представления.
	ПоляВнутр = Новый Массив;
	ПоляГруппировки = Новый Массив;
	ПоляВнеш = Новый Массив;

	ПоляВнутр.Добавить("НАЧАЛОПЕРИОДА(Н.Период, МЕСЯЦ) КАК Месяц");
	ПоляГруппировки.Добавить("НАЧАЛОПЕРИОДА(Н.Период, МЕСЯЦ)");
	ПоляВнеш.Добавить("Т.Месяц КАК Месяц");

	ПоляВнутр.Добавить("Н." + ПолеСотрудника + " КАК Сотрудник");
	ПоляГруппировки.Добавить("Н." + ПолеСотрудника);
	ПоляВнеш.Добавить("Т.Сотрудник КАК Сотрудник");
	ПоляВнеш.Добавить("ПРЕДСТАВЛЕНИЕ(Т.Сотрудник) КАК СотрудникПредставление");

	ПоляВнутр.Добавить("Н.НачислениеУдержание КАК Вид");
	ПоляГруппировки.Добавить("Н.НачислениеУдержание");
	ПоляВнеш.Добавить("Т.Вид КАК Вид");
	ПоляВнеш.Добавить("ПРЕДСТАВЛЕНИЕ(Т.Вид) КАК ВидПредставление");

	Если ЕстьГруппа Тогда
		ПоляВнутр.Добавить("Н.ГруппаНачисленияУдержанияВыплаты КАК Группа");
		ПоляГруппировки.Добавить("Н.ГруппаНачисленияУдержанияВыплаты");
		ПоляВнеш.Добавить("Т.Группа КАК Группа");
	КонецЕсли;

	Если ЕстьПодразделение Тогда
		ПоляВнутр.Добавить("Н.Подразделение КАК Подразделение");
		ПоляГруппировки.Добавить("Н.Подразделение");
		ПоляВнеш.Добавить("ПРЕДСТАВЛЕНИЕ(Т.Подразделение) КАК ПодразделениеПредставление");
	КонецЕсли;

	ПоляВнутр.Добавить("СУММА(Н.Сумма) КАК Сумма");
	ПоляВнеш.Добавить("Т.Сумма КАК Сумма");

	Условия = Новый Массив;
	Условия.Добавить("Н.Период МЕЖДУ &НачалоПериода И &КонецПериода");
	Условия.Добавить("Н.Активность");
	Если ЕстьОрганизация И ЗначениеЗаполнено(Организация) Тогда
		Условия.Добавить("Н.Организация = &Организация");
	КонецЕсли;

	Разделитель = "," + Символы.ПС + Символы.Таб;
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ" + Символы.ПС + Символы.Таб
		+ СтрСоединить(ПоляВнеш, Разделитель) + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	(ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ СтрСоединить(ПоляВнутр, Разделитель) + Символы.ПС
		+ "	ИЗ" + Символы.ПС
		+ "		РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК Н" + Символы.ПС
		+ "	ГДЕ" + Символы.ПС + Символы.Таб
		+ СтрСоединить(Условия, Символы.ПС + "		И ") + Символы.ПС
		+ "	СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ СтрСоединить(ПоляГруппировки, Разделитель) + Символы.ПС
		+ "	ИМЕЮЩИЕ" + Символы.ПС
		+ "		СУММА(Н.Сумма) <> 0) КАК Т";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);

	КоличествоМесяцев = Месяцы.Количество();
	ИндексыМесяцев = Новый Соответствие;
	Для Индекс = 0 По КоличествоМесяцев - 1 Цикл
		ИндексыМесяцев.Вставить(Месяцы[Индекс], Индекс);
	КонецЦикла;

	Сотрудники = Новый Соответствие;
	ВидыНачислений = Новый Соответствие;
	КэшТипов = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Сотрудник) Или Выборка.Сумма = NULL Тогда
			Продолжить;
		КонецЕсли;
		ИндексМесяца = ИндексыМесяцев.Получить(Выборка.Месяц);
		Если ИндексМесяца = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Группа = Неопределено;
		Если ЕстьГруппа Тогда
			Группа = Выборка.Группа;
		КонецЕсли;
		ТипСтроки = ТипСтрокиНачисления(Группа, Выборка.Вид, Выборка.ВидПредставление, КэшТипов);
		Если ТипСтроки = "" Тогда
			Продолжить; // выплаты и прочие группы в анализе не участвуют
		КонецЕсли;

		Сотр = Сотрудники.Получить(Выборка.Сотрудник);
		Если Сотр = Неопределено Тогда
			Сотр = НовоеОписаниеСотрудника(Выборка.Сотрудник, Выборка.СотрудникПредставление, КоличествоМесяцев);
			Сотрудники.Вставить(Выборка.Сотрудник, Сотр);
		КонецЕсли;

		Если ЕстьПодразделение И ЗначениеЗаполнено(Выборка.ПодразделениеПредставление)
			И Выборка.Месяц >= Сотр.МесяцПодразделения Тогда
			Сотр.Подразделение = Выборка.ПодразделениеПредставление;
			Сотр.МесяцПодразделения = Выборка.Месяц;
		КонецЕсли;

		Сумма = Выборка.Сумма;
		Если ТипСтроки = "Начислено" Тогда

			Сотр.Начислено[ИндексМесяца] = Сотр.Начислено[ИндексМесяца] + Сумма;

			ВидПредставление = СокрЛП(Выборка.ВидПредставление);
			Если ВидПредставление = "" Тогда
				ВидПредставление = "<без вида начисления>";
			КонецЕсли;
			Категория = КатегорияНачисления(ВидПредставление);

			СуммыКатегории = Сотр.ПоКатегориям.Получить(Категория);
			Если СуммыКатегории = Неопределено Тогда
				СуммыКатегории = МассивНулей(КоличествоМесяцев);
				Сотр.ПоКатегориям.Вставить(Категория, СуммыКатегории);
			КонецЕсли;
			СуммыКатегории[ИндексМесяца] = СуммыКатегории[ИндексМесяца] + Сумма;

			СуммыВида = Сотр.ПоВидам.Получить(ВидПредставление);
			Если СуммыВида = Неопределено Тогда
				СуммыВида = МассивНулей(КоличествоМесяцев);
				Сотр.ПоВидам.Вставить(ВидПредставление, СуммыВида);
			КонецЕсли;
			СуммыВида[ИндексМесяца] = СуммыВида[ИндексМесяца] + Сумма;

			ВидИнфо = ВидыНачислений.Получить(ВидПредставление);
			Если ВидИнфо = Неопределено Тогда
				ВидИнфо = Новый Структура("Представление, Категория, Суммы, Сотрудники",
					ВидПредставление, Категория, МассивНулей(КоличествоМесяцев), Новый Соответствие);
				ВидыНачислений.Вставить(ВидПредставление, ВидИнфо);
			КонецЕсли;
			ВидИнфо.Суммы[ИндексМесяца] = ВидИнфо.Суммы[ИндексМесяца] + Сумма;
			ВидИнфо.Сотрудники.Вставить(Выборка.Сотрудник, Истина);

		ИначеЕсли ТипСтроки = "НДФЛ" Тогда
			Сотр.НДФЛ[ИндексМесяца] = Сотр.НДФЛ[ИндексМесяца] + Сумма;
		ИначеЕсли ТипСтроки = "Удержано" Тогда
			Сотр.Удержано[ИндексМесяца] = Сотр.Удержано[ИндексМесяца] + Сумма;
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Сотрудники", Сотрудники);
	Результат.Вставить("ВидыНачислений", ВидыНачислений);
	Результат.Вставить("ПолеСотрудника", ПолеСотрудника);
	Результат.Вставить("ЕстьГруппа", ЕстьГруппа);
	Результат.Вставить("ИсточникПодразделения", ?(ЕстьПодразделение, "регистр начислений", ""));

	Возврат Результат;

КонецФункции

// Подразделение и должность на конец периода из кадровой истории (ЗУП 3).
// Если регистра нет или к нему нет доступа — молча пропускаем.
Процедура ДополнитьКадровымиДанными(Данные, НаДату)

	Если Данные.ПолеСотрудника <> "Сотрудник" Или Данные.Сотрудники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МетаКИ = Метаданные.РегистрыСведений.Найти("КадроваяИсторияСотрудников");
	Если МетаКИ = Неопределено Или Не ЕстьПолеРегистра(МетаКИ, "Сотрудник") Тогда
		Возврат;
	КонецЕсли;

	ЕстьПодразделение = ЕстьПолеРегистра(МетаКИ, "Подразделение");
	ЕстьДолжность = ЕстьПолеРегистра(МетаКИ, "Должность");
	Если Не ЕстьПодразделение И Не ЕстьДолжность Тогда
		Возврат;
	КонецЕсли;

	Поля = Новый Массив;
	Поля.Добавить("КИ.Сотрудник КАК Сотрудник");
	Поля.Добавить(?(ЕстьПодразделение, "ПРЕДСТАВЛЕНИЕ(КИ.Подразделение)", """""") + " КАК Подразделение");
	Поля.Добавить(?(ЕстьДолжность, "ПРЕДСТАВЛЕНИЕ(КИ.Должность)", """""") + " КАК Должность");

	СписокСотрудников = Новый Массив;
	Для Каждого КлючИЗначение Из Данные.Сотрудники Цикл
		СписокСотрудников.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ" + Символы.ПС + Символы.Таб
		+ СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&НаДату, Сотрудник В (&Сотрудники)) КАК КИ";
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Сотрудники", СписокСотрудников);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;

	ЗагруженоПодразделений = Ложь;
	Пока Выборка.Следующий() Цикл
		Сотр = Данные.Сотрудники.Получить(Выборка.Сотрудник);
		Если Сотр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Подразделение) Тогда
			Сотр.Подразделение = Выборка.Подразделение;
			ЗагруженоПодразделений = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Должность) Тогда
			Сотр.Должность = Выборка.Должность;
		КонецЕсли;
	КонецЦикла;

	Если ЗагруженоПодразделений Тогда
		Данные.ИсточникПодразделения = "кадровая история";
	КонецЕсли;

КонецПроцедуры

Функция НовоеОписаниеСотрудника(Ссылка, Представление, КоличествоМесяцев)

	Сотр = Новый Структура;
	Сотр.Вставить("Ссылка", Ссылка);
	Сотр.Вставить("Представление", ?(ЗначениеЗаполнено(Представление), Представление, Строка(Ссылка)));
	Сотр.Вставить("Подразделение", "");
	Сотр.Вставить("МесяцПодразделения", '00010101');
	Сотр.Вставить("Должность", "");
	Сотр.Вставить("Начислено", МассивНулей(КоличествоМесяцев));
	Сотр.Вставить("НДФЛ", МассивНулей(КоличествоМесяцев));
	Сотр.Вставить("Удержано", МассивНулей(КоличествоМесяцев));
	Сотр.Вставить("ПоКатегориям", Новый Соответствие);
	Сотр.Вставить("ПоВидам", Новый Соответствие);
	Возврат Сотр;

КонецФункции

// Возвращает "Начислено", "НДФЛ", "Удержано" или "" (строка в анализе не участвует).
Функция ТипСтрокиНачисления(Группа, Вид, ВидПредставление, КэшТипов)

	Если ЗначениеЗаполнено(Группа) Тогда

		Результат = КэшТипов.Получить(Группа);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Описание = НРег(ИмяЗначенияПеречисления(Группа) + " " + Строка(Группа));
		Если СтрНайти(Описание, "ндфл") > 0 Тогда
			Результат = "НДФЛ";
		ИначеЕсли СтрНайти(Описание, "начисл") > 0 Тогда
			Результат = "Начислено";
		ИначеЕсли СтрНайти(Описание, "удерж") > 0 Тогда
			Результат = "Удержано";
		Иначе
			Результат = "";
		КонецЕсли;
		КэшТипов.Вставить(Группа, Результат);
		Возврат Результат;

	КонецЕсли;

	// Группы нет — определяем по виду расчета.
	Если СтрНайти(НРег(ВидПредставление), "ндфл") > 0 Тогда
		Возврат "НДФЛ";
	КонецЕсли;
	ИмяМетаданныхВида = "";
	Попытка
		ИмяМетаданныхВида = НРег(Вид.Метаданные().Имя);
	Исключение
		ИмяМетаданныхВида = "";
	КонецПопытки;
	Если СтрНайти(ИмяМетаданныхВида, "начислен") > 0 Тогда
		Возврат "Начислено";
	ИначеЕсли СтрНайти(ИмяМетаданныхВида, "удержан") > 0 Тогда
		Возврат "Удержано";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ИмяЗначенияПеречисления(Значение)

	Попытка
		МетаПеречисление = Значение.Метаданные();
		Индекс = Перечисления[МетаПеречисление.Имя].Индекс(Значение);
		Возврат МетаПеречисление.ЗначенияПеречисления[Индекс].Имя;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Укрупненная категория начисления по наименованию вида расчета.
Функция КатегорияНачисления(ВидПредставление)

	Имя = НРег(ВидПредставление);

	Если ЕстьПодстрока(Имя, "больнич,нетрудоспособ,пособи,декрет,по беременности") Тогда
		Возврат "Больничные и пособия";
	ИначеЕсли ЕстьПодстрока(Имя, "отпуск") Тогда
		Возврат "Отпускные и компенсации отпуска";
	ИначеЕсли ЕстьПодстрока(Имя, "прем,бонус,вознагражд,13-я,13 зарплат,поощр") Тогда
		Возврат "Премии и вознаграждения";
	ИначеЕсли ЕстьПодстрока(Имя, "доплат,надбав,сверхуроч,ночн,праздн,выходн,совмещ,район,северн,вредн") Тогда
		Возврат "Доплаты и надбавки";
	ИначеЕсли ЕстьПодстрока(Имя, "оклад,тариф,по часам,по дням,сдельн,повремен,оплата по,зарплат,ставк") Тогда
		Возврат "Оклад / тариф";
	КонецЕсли;
	Возврат "Прочие начисления";

КонецФункции

Функция ПорядокКатегорий()

	Результат = Новый Массив;
	Результат.Добавить("Оклад / тариф");
	Результат.Добавить("Доплаты и надбавки");
	Результат.Добавить("Премии и вознаграждения");
	Результат.Добавить("Отпускные и компенсации отпуска");
	Результат.Добавить("Больничные и пособия");
	Результат.Добавить("Прочие начисления");
	Возврат Результат;

КонецФункции

Функция ЕстьПолеРегистра(МетаРегистр, ИмяПоля)

	Если МетаРегистр.Измерения.Найти(ИмяПоля) <> Неопределено
		Или МетаРегистр.Ресурсы.Найти(ИмяПоля) <> Неопределено
		Или МетаРегистр.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Аналитика

Функция РассчитатьАналитику(Данные, Месяцы, ПорогИзменения, МРОТ)

	КоличествоМесяцев = Месяцы.Количество();
	Последний = КоличествоМесяцев - 1;

	А = Новый Структура;
	А.Вставить("Месяцы", Месяцы);
	А.Вставить("КоличествоМесяцев", КоличествоМесяцев);
	А.Вставить("ПорогИзменения", ПорогИзменения);
	А.Вставить("МРОТ", МРОТ);
	А.Вставить("ИсточникПодразделения", Данные.ИсточникПодразделения);

	// --- По сотрудникам ---
	ТаблицаСотрудников = Новый ТаблицаЗначений;
	ТаблицаСотрудников.Колонки.Добавить("Сотр");
	ТаблицаСотрудников.Колонки.Добавить("Итого");

	Для Каждого КлючИЗначение Из Данные.Сотрудники Цикл

		Сотр = КлючИЗначение.Значение;

		Итого = СуммаМассива(Сотр.Начислено);
		ИтогоНДФЛ = СуммаМассива(Сотр.НДФЛ);
		ИтогоУдержано = СуммаМассива(Сотр.Удержано);

		ПоложительныеМесяцы = Новый Массив;
		Для Каждого Значение Из Сотр.Начислено Цикл
			Если Значение > 0 Тогда
				ПоложительныеМесяцы.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		МесяцевСНачислениями = ПоложительныеМесяцы.Количество();

		Сотр.Вставить("Итого", Итого);
		Сотр.Вставить("ИтогоНДФЛ", ИтогоНДФЛ);
		Сотр.Вставить("ИтогоУдержано", ИтогоУдержано);
		Сотр.Вставить("КВыплате", Итого - ИтогоНДФЛ - ИтогоУдержано);
		Сотр.Вставить("МесяцевСНачислениями", МесяцевСНачислениями);
		Сотр.Вставить("СреднееЗаМесяц", ?(МесяцевСНачислениями > 0, СуммаМассива(ПоложительныеМесяцы) / МесяцевСНачислениями, 0));
		Сотр.Вставить("Изменение", ?(КоличествоМесяцев > 1, ПроцентИзменения(Сотр.Начислено[0], Сотр.Начислено[Последний]), Неопределено));
		Сотр.Вставить("КоэффициентВариации", КоэффициентВариации(ПоложительныеМесяцы));

		СуммаПремий = 0;
		МассивПремий = Сотр.ПоКатегориям.Получить("Премии и вознаграждения");
		Если МассивПремий <> Неопределено Тогда
			СуммаПремий = СуммаМассива(МассивПремий);
		КонецЕсли;
		Сотр.Вставить("ДоляПремий", ?(Итого > 0, СуммаПремий / Итого * 100, 0));

		Сотр.Вставить("Отметки", ОтметкиСотрудника(Сотр, Месяцы, ПорогИзменения, МРОТ));

		СтрокаСотрудника = ТаблицаСотрудников.Добавить();
		СтрокаСотрудника.Сотр = Сотр;
		СтрокаСотрудника.Итого = Итого;

	КонецЦикла;

	ТаблицаСотрудников.Сортировать("Итого Убыв");
	Сотрудники = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаСотрудников Цикл
		Сотрудники.Добавить(СтрокаТаблицы.Сотр);
	КонецЦикла;
	А.Вставить("Сотрудники", Сотрудники);

	// --- По месяцам ---
	ФОТ = МассивНулей(КоличествоМесяцев);
	НДФЛ = МассивНулей(КоличествоМесяцев);
	Удержано = МассивНулей(КоличествоМесяцев);
	Численность = МассивНулей(КоличествоМесяцев);
	Средняя = МассивНулей(КоличествоМесяцев);
	Медианы = МассивНулей(КоличествоМесяцев);
	Минимумы = МассивНулей(КоличествоМесяцев);
	Максимумы = МассивНулей(КоличествоМесяцев);
	КВыплате = МассивНулей(КоличествоМесяцев);

	Для Индекс = 0 По Последний Цикл
		ЗначенияМесяца = Новый Массив;
		Для Каждого Сотр Из Сотрудники Цикл
			ФОТ[Индекс] = ФОТ[Индекс] + Сотр.Начислено[Индекс];
			НДФЛ[Индекс] = НДФЛ[Индекс] + Сотр.НДФЛ[Индекс];
			Удержано[Индекс] = Удержано[Индекс] + Сотр.Удержано[Индекс];
			Если Сотр.Начислено[Индекс] > 0 Тогда
				ЗначенияМесяца.Добавить(Сотр.Начислено[Индекс]);
			КонецЕсли;
		КонецЦикла;
		Численность[Индекс] = ЗначенияМесяца.Количество();
		Средняя[Индекс] = ?(Численность[Индекс] > 0, ФОТ[Индекс] / Численность[Индекс], 0);
		Медианы[Индекс] = Медиана(ЗначенияМесяца);
		Минимумы[Индекс] = МинимумМассива(ЗначенияМесяца);
		Максимумы[Индекс] = МаксимумМассива(ЗначенияМесяца);
		КВыплате[Индекс] = ФОТ[Индекс] - НДФЛ[Индекс] - Удержано[Индекс];
	КонецЦикла;

	А.Вставить("ФОТ", ФОТ);
	А.Вставить("НДФЛ", НДФЛ);
	А.Вставить("Удержано", Удержано);
	А.Вставить("Численность", Численность);
	А.Вставить("Средняя", Средняя);
	А.Вставить("Медианы", Медианы);
	А.Вставить("Минимумы", Минимумы);
	А.Вставить("Максимумы", Максимумы);
	А.Вставить("КВыплате", КВыплате);
	А.Вставить("ИтогоФОТ", СуммаМассива(ФОТ));

	// --- Структура по категориям ---
	Категории = Новый Соответствие;
	Для Каждого Категория Из ПорядокКатегорий() Цикл
		Категории.Вставить(Категория, МассивНулей(КоличествоМесяцев));
	КонецЦикла;
	Для Каждого Сотр Из Сотрудники Цикл
		Для Каждого КлючИЗначение Из Сотр.ПоКатегориям Цикл
			ДобавитьКМассиву(Категории[КлючИЗначение.Ключ], КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
	А.Вставить("Категории", Категории);

	// --- По подразделениям ---
	ТаблицаПодразделений = Новый ТаблицаЗначений;
	ТаблицаПодразделений.Колонки.Добавить("Подразделение");
	ТаблицаПодразделений.Колонки.Добавить("Суммы");
	ТаблицаПодразделений.Колонки.Добавить("Численность");
	ТаблицаПодразделений.Колонки.Добавить("Сотрудников");
	ТаблицаПодразделений.Колонки.Добавить("Итого");
	ЕстьПодразделения = Ложь;
	ИндексПодразделений = Новый Соответствие;
	Для Каждого Сотр Из Сотрудники Цикл
		ИмяПодразделения = ?(ЗначениеЗаполнено(Сотр.Подразделение), Сотр.Подразделение, "<подразделение не указано>");
		Если ЗначениеЗаполнено(Сотр.Подразделение) Тогда
			ЕстьПодразделения = Истина;
		КонецЕсли;
		СтрокаПодр = ИндексПодразделений.Получить(ИмяПодразделения);
		Если СтрокаПодр = Неопределено Тогда
			СтрокаПодр = ТаблицаПодразделений.Добавить();
			СтрокаПодр.Подразделение = ИмяПодразделения;
			СтрокаПодр.Суммы = МассивНулей(КоличествоМесяцев);
			СтрокаПодр.Численность = МассивНулей(КоличествоМесяцев);
			СтрокаПодр.Сотрудников = 0;
			ИндексПодразделений.Вставить(ИмяПодразделения, СтрокаПодр);
		КонецЕсли;
		ДобавитьКМассиву(СтрокаПодр.Суммы, Сотр.Начислено);
		Для Индекс = 0 По Последний Цикл
			Если Сотр.Начислено[Индекс] > 0 Тогда
				СтрокаПодр.Численность[Индекс] = СтрокаПодр.Численность[Индекс] + 1;
			КонецЕсли;
		КонецЦикла;
		СтрокаПодр.Сотрудников = СтрокаПодр.Сотрудников + 1;
	КонецЦикла;
	Для Каждого СтрокаПодр Из ТаблицаПодразделений Цикл
		СтрокаПодр.Итого = СуммаМассива(СтрокаПодр.Суммы);
	КонецЦикла;
	ТаблицаПодразделений.Сортировать("Итого Убыв");
	А.Вставить("Подразделения", ?(ЕстьПодразделения, ТаблицаПодразделений, Неопределено));

	// --- Виды начислений ---
	ТаблицаВидов = Новый ТаблицаЗначений;
	ТаблицаВидов.Колонки.Добавить("Вид");
	ТаблицаВидов.Колонки.Добавить("Итого");
	Для Каждого КлючИЗначение Из Данные.ВидыНачислений Цикл
		СтрокаВида = ТаблицаВидов.Добавить();
		СтрокаВида.Вид = КлючИЗначение.Значение;
		СтрокаВида.Итого = СуммаМассива(КлючИЗначение.Значение.Суммы);
	КонецЦикла;
	ТаблицаВидов.Сортировать("Итого Убыв");
	А.Вставить("ВидыНачислений", ТаблицаВидов);

	А.Вставить("Изменения", РассчитатьИзменения(А));
	А.Вставить("Выводы", СформироватьВыводы(А));

	Возврат А;

КонецФункции

Функция ОтметкиСотрудника(Сотр, Месяцы, ПорогИзменения, МРОТ)

	Отметки = Новый Массив;
	КоличествоМесяцев = Месяцы.Количество();
	Последний = КоличествоМесяцев - 1;

	Если КоличествоМесяцев > 1 Тогда
		Если Сотр.Начислено[0] <= 0 И Сотр.Начислено[Последний] > 0 Тогда
			Отметки.Добавить("Нет начислений в начале периода (прием / выход из отпуска?)");
		ИначеЕсли Сотр.Начислено[0] > 0 И Сотр.Начислено[Последний] <= 0 Тогда
			Отметки.Добавить("Нет начислений в последнем месяце (увольнение / длительное отсутствие?)");
		КонецЕсли;

		Пропуски = Новый Массив;
		Для Индекс = 1 По Последний - 1 Цикл
			Если Сотр.Начислено[Индекс] <= 0 И Сотр.Начислено[0] > 0 И Сотр.Начислено[Последний] > 0 Тогда
				Пропуски.Добавить(ИмяМесяца(Месяцы[Индекс]));
			КонецЕсли;
		КонецЦикла;
		Если Пропуски.Количество() > 0 Тогда
			Отметки.Добавить("Нет начислений: " + СтрСоединить(Пропуски, ", "));
		КонецЕсли;
	КонецЕсли;

	Если Сотр.Изменение <> Неопределено Тогда
		Если Сотр.Изменение >= ПорогИзменения Тогда
			Отметки.Добавить("Рост " + ПредставлениеПроцента(Сотр.Изменение, Истина) + " к первому месяцу за счёт: "
				+ ЗаСчетВыплат(Сотр, 0, Последний));
		ИначеЕсли Сотр.Изменение <= -ПорогИзменения Тогда
			Отметки.Добавить("Снижение " + ПредставлениеПроцента(Сотр.Изменение, Истина) + " к первому месяцу за счёт: "
				+ ЗаСчетВыплат(Сотр, 0, Последний));
		КонецЕсли;
	КонецЕсли;

	Если МРОТ > 0 Тогда
		НижеМРОТ = Новый Массив;
		Для Индекс = 0 По Последний Цикл
			Если Сотр.Начислено[Индекс] > 0 И Сотр.Начислено[Индекс] < МРОТ Тогда
				НижеМРОТ.Добавить(ИмяМесяца(Месяцы[Индекс]));
			КонецЕсли;
		КонецЦикла;
		Если НижеМРОТ.Количество() > 0 Тогда
			Отметки.Добавить("Начислено меньше МРОТ: " + СтрСоединить(НижеМРОТ, ", ")
				+ " (проверьте ставку и отработанное время)");
		КонецЕсли;
	КонецЕсли;

	// скачки к прошлому месяцу (для двух месяцев это то же, что изменение к первому)
	Скачки = Новый Массив;
	Если КоличествоМесяцев > 2 Тогда
		Для Индекс = 1 По Последний Цикл
			Было = Сотр.Начислено[Индекс - 1];
			Стало = Сотр.Начислено[Индекс];
			Если Было > 0 И Стало > 0 И Макс(Стало - Было, Было - Стало) >= 1000 Тогда
				Процент = (Стало - Было) / Было * 100;
				Если Макс(Процент, -Процент) >= ПорогИзменения Тогда
					Скачки.Добавить(ИмяМесяца(Месяцы[Индекс]) + " " + ПредставлениеПроцента(Процент, Истина)
						+ " за счёт: " + ЗаСчетВыплат(Сотр, Индекс - 1, Индекс));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Скачки.Количество() > 0 Тогда
		Отметки.Добавить("Скачки к прошлому месяцу: " + СтрСоединить(Скачки, "; "));
	КонецЕсли;

	Если Скачки.Количество() = 0 И Сотр.КоэффициентВариации <> Неопределено И Сотр.КоэффициентВариации > 30 Тогда
		Отметки.Добавить("Нестабильные начисления (разброс " + Формат(Сотр.КоэффициентВариации, "ЧДЦ=0; ЧН=0") + "%)");
	КонецЕсли;

	Если Сотр.Итого > 0 И Сотр.ДоляПремий >= 50 Тогда
		Отметки.Добавить("Премии " + Формат(Сотр.ДоляПремий, "ЧДЦ=0") + "% от начислений");
	КонецЕсли;

	Отрицательные = Новый Массив;
	Для Индекс = 0 По Последний Цикл
		Если Сотр.Начислено[Индекс] < 0 Тогда
			Отрицательные.Добавить(ИмяМесяца(Месяцы[Индекс]));
		КонецЕсли;
	КонецЦикла;
	Если Отрицательные.Количество() > 0 Тогда
		Отметки.Добавить("Отрицательные начисления (сторно/перерасчет): " + СтрСоединить(Отрицательные, ", "));
	КонецЕсли;

	Если Сотр.Итого > 0 И Сотр.ИтогоУдержано > Сотр.Итого * 0.2 Тогда
		Отметки.Добавить("Удержания " + Формат(Сотр.ИтогоУдержано / Сотр.Итого * 100, "ЧДЦ=0") + "% от начислений");
	КонецЕсли;

	Возврат Отметки;

КонецФункции

Функция СформироватьВыводы(А)

	Выводы = Новый Массив;
	Месяцы = А.Месяцы;
	КоличествоМесяцев = А.КоличествоМесяцев;
	Последний = КоличествоМесяцев - 1;
	Сотрудники = А.Сотрудники;
	ИмяПервого = ИмяМесяца(Месяцы[0]);
	ИмяПоследнего = ИмяМесяца(Месяцы[Последний]);

	Выводы.Добавить(СтрШаблон("Начислено за период: %1 руб., в среднем %2 руб. в месяц; сотрудников с начислениями: %3.",
		ФорматСуммы(А.ИтогоФОТ), ФорматСуммы(А.ИтогоФОТ / КоличествоМесяцев), Сотрудники.Количество()));

	Если КоличествоМесяцев > 1 Тогда

		Изменение = ПроцентИзменения(А.ФОТ[0], А.ФОТ[Последний]);
		Выводы.Добавить(СтрШаблон("ФОТ: %1 — %2 руб., %3 — %4 руб. (%5, %6 руб.).",
			ИмяПервого, ФорматСуммы(А.ФОТ[0]), ИмяПоследнего, ФорматСуммы(А.ФОТ[Последний]),
			ПредставлениеПроцента(Изменение, Истина), ФорматСуммы(А.ФОТ[Последний] - А.ФОТ[0], Истина)));

		Принято = 0;
		Выбыло = 0;
		Для Каждого Сотр Из Сотрудники Цикл
			Если Сотр.Начислено[0] <= 0 И Сотр.Начислено[Последний] > 0 Тогда
				Принято = Принято + 1;
			ИначеЕсли Сотр.Начислено[0] > 0 И Сотр.Начислено[Последний] <= 0 Тогда
				Выбыло = Выбыло + 1;
			КонецЕсли;
		КонецЦикла;
		Выводы.Добавить(СтрШаблон("Численность с начислениями: %1 → %2 чел. Появились в периоде: %3, нет начислений в последнем месяце: %4.",
			А.Численность[0], А.Численность[Последний], Принято, Выбыло));

		ИзменениеСредней = ПроцентИзменения(А.Средняя[0], А.Средняя[Последний]);
		ИзменениеМедианы = ПроцентИзменения(А.Медианы[0], А.Медианы[Последний]);
		Выводы.Добавить(СтрШаблон("Средняя начисленная зарплата: %1 → %2 руб. (%3); медиана: %4 → %5 руб. (%6).",
			ФорматСуммы(А.Средняя[0]), ФорматСуммы(А.Средняя[Последний]), ПредставлениеПроцента(ИзменениеСредней, Истина),
			ФорматСуммы(А.Медианы[0]), ФорматСуммы(А.Медианы[Последний]), ПредставлениеПроцента(ИзменениеМедианы, Истина)));

		// Что сильнее всего повлияло на изменение ФОТ.
		ЛучшаяКатегория = "";
		ЛучшееИзменение = 0;
		Для Каждого Категория Из ПорядокКатегорий() Цикл
			Суммы = А.Категории[Категория];
			Разница = Суммы[Последний] - Суммы[0];
			Если ЛучшаяКатегория = "" Или Макс(Разница, -Разница) > Макс(ЛучшееИзменение, -ЛучшееИзменение) Тогда
				ЛучшаяКатегория = Категория;
				ЛучшееИзменение = Разница;
			КонецЕсли;
		КонецЦикла;
		Если ЛучшееИзменение <> 0 Тогда
			Выводы.Добавить(СтрШаблон("Сильнее всего изменилась статья ""%1"": %2 руб. (%3 к %4).",
				ЛучшаяКатегория, ФорматСуммы(ЛучшееИзменение, Истина), ИмяПоследнего, ИмяПервого));
		КонецЕсли;

	Иначе
		Выводы.Добавить(СтрШаблон("Средняя начисленная зарплата: %1 руб., медиана: %2 руб.",
			ФорматСуммы(А.Средняя[0]), ФорматСуммы(А.Медианы[0])));
	КонецЕсли;

	// Неравномерность.
	МедианаПоследнего = А.Медианы[Последний];
	Если МедианаПоследнего > 0 И А.Средняя[Последний] / МедианаПоследнего > 1.3 Тогда
		Выводы.Добавить(СтрШаблон("Средняя выше медианы в %1 раза — ФОТ смещен к небольшой группе с высокими начислениями.",
			Формат(А.Средняя[Последний] / МедианаПоследнего, "ЧДЦ=1")));
	КонецЕсли;

	Если А.ИтогоФОТ > 0 Тогда
		КоличествоТоп = Макс(1, Окр(Сотрудники.Количество() * 0.1));
		СуммаТоп = 0;
		Для Индекс = 0 По Мин(КоличествоТоп, Сотрудники.Количество()) - 1 Цикл
			СуммаТоп = СуммаТоп + Сотрудники[Индекс].Итого;
		КонецЦикла;
		Выводы.Добавить(СтрШаблон("На %1 сотрудников с наибольшими начислениями (%2 чел.) приходится %3 ФОТ.",
			"10%", КоличествоТоп, ПредставлениеПроцента(СуммаТоп / А.ИтогоФОТ * 100)));

		Основная = "";
		ДоляОсновной = 0;
		Для Каждого Категория Из ПорядокКатегорий() Цикл
			Доля = СуммаМассива(А.Категории[Категория]) / А.ИтогоФОТ * 100;
			Если Доля > ДоляОсновной Тогда
				Основная = Категория;
				ДоляОсновной = Доля;
			КонецЕсли;
		КонецЦикла;
		ДоляПремий = СуммаМассива(А.Категории["Премии и вознаграждения"]) / А.ИтогоФОТ * 100;
		Выводы.Добавить(СтрШаблон("Основа ФОТ — ""%1"" (%2); премии и вознаграждения — %3.",
			Основная, ПредставлениеПроцента(ДоляОсновной), ПредставлениеПроцента(ДоляПремий)));
	КонецЕсли;

	Рост = 0;
	Снижение = 0;
	НижеМРОТ = 0;
	СОтметками = 0;
	Для Каждого Сотр Из Сотрудники Цикл
		Если Сотр.Изменение <> Неопределено Тогда
			Если Сотр.Изменение >= А.ПорогИзменения Тогда
				Рост = Рост + 1;
			ИначеЕсли Сотр.Изменение <= -А.ПорогИзменения Тогда
				Снижение = Снижение + 1;
			КонецЕсли;
		КонецЕсли;
		Если А.МРОТ > 0 Тогда
			Для Каждого Значение Из Сотр.Начислено Цикл
				Если Значение > 0 И Значение < А.МРОТ Тогда
					НижеМРОТ = НижеМРОТ + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Сотр.Отметки.Количество() > 0 Тогда
			СОтметками = СОтметками + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоМесяцев > 1 Тогда
		Выводы.Добавить(СтрШаблон("Изменение начислений больше чем на %1 (%2 к %3): рост — %4 чел., снижение — %5 чел.",
			ПредставлениеПроцента(А.ПорогИзменения), ИмяПоследнего, ИмяПервого, Рост, Снижение));
	КонецЕсли;
	Если А.МРОТ > 0 Тогда
		Если НижеМРОТ > 0 Тогда
			Выводы.Добавить(СтрШаблон("У %1 чел. в каком-либо месяце начислено меньше МРОТ (%2 руб.). Это нормально при неполной ставке "
				+ "или неполном месяце, иначе — риск нарушения ст. 133 ТК РФ.", НижеМРОТ, ФорматСуммы(А.МРОТ)));
		Иначе
			Выводы.Добавить(СтрШаблон("Начислений меньше МРОТ (%1 руб.) не обнаружено.", ФорматСуммы(А.МРОТ)));
		КонецЕсли;
	КонецЕсли;
	Выводы.Добавить(СтрШаблон("Требуют внимания: %1 чел. — список ниже, в разделе ""Сотрудники, требующие внимания"".", СОтметками));

	Возврат Выводы;

КонецФункции

#КонецОбласти

#Область ЧтоИзменилось

// Последний месяц к предыдущему: разложение изменения ФОТ (новые, ушедшие, остальные; численность и средняя)
// и главные причины — статьи, виды начислений, подразделения, сотрудники. Плюс помесячная динамика ФОТ.
Функция РассчитатьИзменения(А)

	Если А.КоличествоМесяцев < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тек = А.КоличествоМесяцев - 1;
	Пред = Тек - 1;

	Изм = Новый Структура;
	Изм.Вставить("ИмяТекущего", ИмяМесяца(А.Месяцы[Тек]));
	Изм.Вставить("ИмяПредыдущего", ИмяМесяца(А.Месяцы[Пред]));

	Шаги = Новый Массив;
	Для Индекс = 1 По Тек Цикл
		Шаги.Добавить(РазложениеШага(А, Индекс - 1, Индекс));
	КонецЦикла;
	Изм.Вставить("Шаги", Шаги);
	Шаг = Шаги[Тек - 1];
	Изм.Вставить("Шаг", Шаг);

	// статьи
	Т = НоваяТаблицаИзменений();
	Для Каждого Категория Из ПорядокКатегорий() Цикл
		Суммы = А.Категории[Категория];
		ДобавитьИзменение(Т, Категория, "", Суммы[Пред], Суммы[Тек], "");
	КонецЦикла;
	Изм.Вставить("Статьи", ОтобратьИзменения(Т, Шаг.Разница, 0));

	// виды начислений
	Т = НоваяТаблицаИзменений();
	ПоявилисьВиды = Новый Массив;
	ПропалиВиды = Новый Массив;
	Для Каждого СтрокаВида Из А.ВидыНачислений Цикл
		ВидИнфо = СтрокаВида.Вид;
		Было = ВидИнфо.Суммы[Пред];
		Стало = ВидИнфо.Суммы[Тек];
		Примечание = "";
		Если Было = 0 И Стало <> 0 Тогда
			Примечание = "новое: в " + Изм.ИмяПредыдущего + " не начислялось";
			ПоявилисьВиды.Добавить(ВидИнфо.Представление);
		ИначеЕсли Было <> 0 И Стало = 0 Тогда
			Примечание = "в " + Изм.ИмяТекущего + " не начислялось";
			ПропалиВиды.Добавить(ВидИнфо.Представление);
		КонецЕсли;
		ДобавитьИзменение(Т, ВидИнфо.Представление, ВидИнфо.Категория, Было, Стало, Примечание);
	КонецЦикла;
	Изм.Вставить("Виды", ОтобратьИзменения(Т, Шаг.Разница, 15));
	Изм.Вставить("ПоявилисьВиды", ПоявилисьВиды);
	Изм.Вставить("ПропалиВиды", ПропалиВиды);

	// подразделения
	Если А.Подразделения = Неопределено Тогда
		Изм.Вставить("Подразделения", Неопределено);
	Иначе
		Т = НоваяТаблицаИзменений();
		Для Каждого СтрокаПодр Из А.Подразделения Цикл
			ДобавитьИзменение(Т, СтрокаПодр.Подразделение, "", СтрокаПодр.Суммы[Пред], СтрокаПодр.Суммы[Тек],
				"сотрудников с начислениями: " + СтрокаПодр.Численность[Пред] + " → " + СтрокаПодр.Численность[Тек]);
		КонецЦикла;
		Изм.Вставить("Подразделения", ОтобратьИзменения(Т, Шаг.Разница, 10));
	КонецЕсли;

	// сотрудники
	Т = НоваяТаблицаИзменений();
	СильноРост = 0;
	СильноСнижение = 0;
	Для Каждого Сотр Из А.Сотрудники Цикл
		Было = Сотр.Начислено[Пред];
		Стало = Сотр.Начислено[Тек];
		Если Было = Стало Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьИзменение(Т, Сотр.Представление, Сотр.Подразделение, Было, Стало, ПричинаИзмененияСотрудника(Сотр, Пред, Тек, Изм));
		Если Было > 0 И Стало > 0 Тогда
			Процент = (Стало - Было) / Было * 100;
			Если Процент >= А.ПорогИзменения Тогда
				СильноРост = СильноРост + 1;
			ИначеЕсли Процент <= -А.ПорогИзменения Тогда
				СильноСнижение = СильноСнижение + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Изм.Вставить("Рост", ПервыеИзменения(Т, Истина, 10, Шаг.Разница));
	Изм.Вставить("Снижение", ПервыеИзменения(Т, Ложь, 10, Шаг.Разница));
	Изм.Вставить("СильноРост", СильноРост);
	Изм.Вставить("СильноСнижение", СильноСнижение);

	Изм.Вставить("Главное", ГлавноеОбИзменениях(А, Изм));
	Возврат Изм;

КонецФункции

Функция РазложениеШага(А, Пред, Тек)

	Шаг = Новый Структура;
	Шаг.Вставить("Месяц", ИмяМесяца(А.Месяцы[Тек]));
	Шаг.Вставить("МесяцДо", ИмяМесяца(А.Месяцы[Пред]));
	Шаг.Вставить("Было", А.ФОТ[Пред]);
	Шаг.Вставить("Стало", А.ФОТ[Тек]);
	Шаг.Вставить("Разница", А.ФОТ[Тек] - А.ФОТ[Пред]);
	Шаг.Вставить("Процент", ПроцентИзменения(А.ФОТ[Пред], А.ФОТ[Тек]));
	Шаг.Вставить("ЧисленностьБыло", А.Численность[Пред]);
	Шаг.Вставить("ЧисленностьСтало", А.Численность[Тек]);
	Шаг.Вставить("СредняяБыло", А.Средняя[Пред]);
	Шаг.Вставить("СредняяСтало", А.Средняя[Тек]);
	// ФОТ = численность × средняя: Δ = ΔЧ × Ср(было) + Ч(стало) × ΔСр — сумма сходится точно
	Шаг.Вставить("ЗаСчетЧисленности", (А.Численность[Тек] - А.Численность[Пред]) * А.Средняя[Пред]);
	Шаг.Вставить("ЗаСчетСредней", А.Численность[Тек] * (А.Средняя[Тек] - А.Средняя[Пред]));

	Новые = 0;
	Ушедшие = 0;
	Остальные = 0;
	КоличествоНовых = 0;
	КоличествоУшедших = 0;
	Для Каждого Сотр Из А.Сотрудники Цикл
		Было = Сотр.Начислено[Пред];
		Стало = Сотр.Начислено[Тек];
		Если Было <= 0 И Стало > 0 Тогда
			Новые = Новые + Стало - Было;
			КоличествоНовых = КоличествоНовых + 1;
		ИначеЕсли Было > 0 И Стало <= 0 Тогда
			Ушедшие = Ушедшие + Стало - Было;
			КоличествоУшедших = КоличествоУшедших + 1;
		Иначе
			Остальные = Остальные + Стало - Было;
		КонецЕсли;
	КонецЦикла;
	Шаг.Вставить("Новые", Новые);
	Шаг.Вставить("Ушедшие", Ушедшие);
	Шаг.Вставить("Остальные", Остальные);
	Шаг.Вставить("КоличествоНовых", КоличествоНовых);
	Шаг.Вставить("КоличествоУшедших", КоличествоУшедших);
	Возврат Шаг;

КонецФункции

Функция НоваяТаблицаИзменений()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Имя");
	Т.Колонки.Добавить("Доп");
	Т.Колонки.Добавить("Было");
	Т.Колонки.Добавить("Стало");
	Т.Колонки.Добавить("Разница");
	Т.Колонки.Добавить("Модуль");
	Т.Колонки.Добавить("Процент");
	Т.Колонки.Добавить("Вклад");
	Т.Колонки.Добавить("Примечание");
	Возврат Т;

КонецФункции

Процедура ДобавитьИзменение(Т, Имя, Доп, Было, Стало, Примечание)

	СтрокаИзм = Т.Добавить();
	СтрокаИзм.Имя = Имя;
	СтрокаИзм.Доп = Доп;
	СтрокаИзм.Было = Было;
	СтрокаИзм.Стало = Стало;
	СтрокаИзм.Разница = Стало - Было;
	СтрокаИзм.Модуль = Макс(Стало - Было, Было - Стало);
	СтрокаИзм.Процент = ПроцентИзменения(Было, Стало);
	СтрокаИзм.Примечание = Примечание;

КонецПроцедуры

// Строки с ненулевым изменением по убыванию модуля изменения; Количество = 0 — все.
Функция ОтобратьИзменения(Т, ОбщаяРазница, Количество)

	Результат = Т.Скопировать();
	Всего = Результат.Количество();
	Для Индекс = 1 По Всего Цикл
		СтрокаИзм = Результат[Всего - Индекс];
		Если СтрокаИзм.Разница = 0 Тогда
			Результат.Удалить(СтрокаИзм);
		КонецЕсли;
	КонецЦикла;
	Результат.Сортировать("Модуль Убыв");
	Пока Количество > 0 И Результат.Количество() > Количество Цикл
		Результат.Удалить(Результат.Количество() - 1);
	КонецЦикла;
	ЗаполнитьВклад(Результат, ОбщаяРазница);
	Возврат Результат;

КонецФункции

// Самый большой рост (Рост = Истина) или самое большое снижение по сумме.
Функция ПервыеИзменения(Т, Рост, Количество, ОбщаяРазница)

	Результат = Т.Скопировать();
	Всего = Результат.Количество();
	Для Индекс = 1 По Всего Цикл
		СтрокаИзм = Результат[Всего - Индекс];
		Если (Рост И СтрокаИзм.Разница <= 0) Или (НЕ Рост И СтрокаИзм.Разница >= 0) Тогда
			Результат.Удалить(СтрокаИзм);
		КонецЕсли;
	КонецЦикла;
	Результат.Сортировать("Модуль Убыв");
	Пока Результат.Количество() > Количество Цикл
		Результат.Удалить(Результат.Количество() - 1);
	КонецЦикла;
	ЗаполнитьВклад(Результат, ОбщаяРазница);
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьВклад(Т, ОбщаяРазница)

	Для Каждого СтрокаИзм Из Т Цикл
		СтрокаИзм.Вклад = ?(ОбщаяРазница <> 0, СтрокаИзм.Разница / ОбщаяРазница * 100, Неопределено);
	КонецЦикла;

КонецПроцедуры

Функция ПричинаИзмененияСотрудника(Сотр, Пред, Тек, Изм)

	Причины = Новый Массив;
	Было = Сотр.Начислено[Пред];
	Стало = Сотр.Начислено[Тек];
	Если Было <= 0 И Стало > 0 Тогда
		Причины.Добавить("не было начислений в " + Изм.ИмяПредыдущего + " (приём / выход из отпуска?)");
	ИначеЕсли Было > 0 И Стало <= 0 Тогда
		Причины.Добавить("нет начислений в " + Изм.ИмяТекущего + " (увольнение / отпуск за свой счёт?)");
	КонецЕсли;

	Выплаты = ЗаСчетВыплат(Сотр, Пред, Тек, 3);
	Если НЕ ПустаяСтрока(Выплаты) Тогда
		Причины.Добавить("за счёт: " + Выплаты);
	КонецЕсли;
	Возврат СтрСоединить(Причины, "; ");

КонецФункции

// За счёт каких видов начислений изменились начисления сотрудника между двумя месяцами:
// «Премия ежемесячная» +30 000 (0 → 30 000), «Оплата по окладу» −5 000 (40 000 → 35 000).
// Берётся вид с наибольшим изменением и следующие, если каждый даёт не меньше 20% общего изменения.
Функция ЗаСчетВыплат(Сотр, ИндексДо, Индекс, Количество = 2)

	Т = НоваяТаблицаИзменений();
	Для Каждого КлючИЗначение Из Сотр.ПоВидам Цикл
		ДобавитьИзменение(Т, КлючИЗначение.Ключ, "", КлючИЗначение.Значение[ИндексДо], КлючИЗначение.Значение[Индекс], "");
	КонецЦикла;
	Т.Сортировать("Модуль Убыв");
	Разница = Сотр.Начислено[Индекс] - Сотр.Начислено[ИндексДо];
	Порог = Макс(Разница, -Разница) * 0.2;
	Части = Новый Массив;
	Для Каждого СтрокаИзм Из Т Цикл
		Если СтрокаИзм.Разница = 0 Или Части.Количество() >= Количество
			Или (Части.Количество() > 0 И СтрокаИзм.Модуль < Порог) Тогда
			Прервать;
		КонецЕсли;
		Части.Добавить("«" + СтрокаИзм.Имя + "» " + ФорматСуммы(СтрокаИзм.Разница, Истина)
			+ " (" + ФорматСуммы(СтрокаИзм.Было) + " → " + ФорматСуммы(СтрокаИзм.Стало) + ")");
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция ГлавноеОбИзменениях(А, Изм)

	Главное = Новый Массив;
	Шаг = Изм.Шаг;

	Главное.Добавить(СтрШаблон("%1 к %2: ФОТ %3 → %4 руб. (%5 руб., %6).",
		Изм.ИмяТекущего, Изм.ИмяПредыдущего, ФорматСуммы(Шаг.Было), ФорматСуммы(Шаг.Стало),
		ФорматСуммы(Шаг.Разница, Истина), ПредставлениеПроцента(Шаг.Процент, Истина)));

	Главное.Добавить(СтрШаблон("Из изменения: появились в %1 (%2 чел.) %3 руб., нет начислений в %1 (%4 чел.) %5 руб., у остальных %6 руб.",
		Изм.ИмяТекущего, Шаг.КоличествоНовых, ФорматСуммы(Шаг.Новые, Истина), Шаг.КоличествоУшедших,
		ФорматСуммы(Шаг.Ушедшие, Истина), ФорматСуммы(Шаг.Остальные, Истина)));

	Главное.Добавить(СтрШаблон("Численность %1 → %2 чел. дала %3 руб., изменение средней начисленной %4 → %5 руб. — %6 руб.",
		Шаг.ЧисленностьБыло, Шаг.ЧисленностьСтало, ФорматСуммы(Шаг.ЗаСчетЧисленности, Истина),
		ФорматСуммы(Шаг.СредняяБыло), ФорматСуммы(Шаг.СредняяСтало), ФорматСуммы(Шаг.ЗаСчетСредней, Истина)));

	Части = Новый Массив;
	Для Индекс = 0 По Мин(2, Изм.Статьи.Количество()) - 1 Цикл
		СтрокаИзм = Изм.Статьи[Индекс];
		Части.Добавить("«" + СтрокаИзм.Имя + "» " + ФорматСуммы(СтрокаИзм.Разница, Истина) + " руб. (" + ПредставлениеПроцента(СтрокаИзм.Процент, Истина) + ")");
	КонецЦикла;
	Если Части.Количество() > 0 Тогда
		Главное.Добавить("Сильнее всего изменились статьи: " + СтрСоединить(Части, ", ") + ".");
	КонецЕсли;

	Части = Новый Массив;
	Для Индекс = 0 По Мин(3, Изм.Виды.Количество()) - 1 Цикл
		СтрокаИзм = Изм.Виды[Индекс];
		Части.Добавить("«" + СтрокаИзм.Имя + "» " + ФорматСуммы(СтрокаИзм.Разница, Истина) + " руб.");
	КонецЦикла;
	Если Части.Количество() > 0 Тогда
		Главное.Добавить("По видам начислений: " + СтрСоединить(Части, ", ") + ".");
	КонецЕсли;
	Если Изм.ПоявилисьВиды.Количество() > 0 Тогда
		Главное.Добавить("Новые виды начислений в " + Изм.ИмяТекущего + ": " + СписокНазваний(Изм.ПоявилисьВиды, 5) + ".");
	КонецЕсли;
	Если Изм.ПропалиВиды.Количество() > 0 Тогда
		Главное.Добавить("Не начислялись в " + Изм.ИмяТекущего + " (были в " + Изм.ИмяПредыдущего + "): " + СписокНазваний(Изм.ПропалиВиды, 5) + ".");
	КонецЕсли;

	Если Изм.Подразделения <> Неопределено И Изм.Подразделения.Количество() > 0 Тогда
		Части = Новый Массив;
		Для Индекс = 0 По Мин(2, Изм.Подразделения.Количество()) - 1 Цикл
			СтрокаИзм = Изм.Подразделения[Индекс];
			Части.Добавить("«" + СтрокаИзм.Имя + "» " + ФорматСуммы(СтрокаИзм.Разница, Истина) + " руб. (" + ПредставлениеПроцента(СтрокаИзм.Процент, Истина) + ")");
		КонецЦикла;
		Главное.Добавить("Подразделения с наибольшим изменением: " + СтрСоединить(Части, ", ") + ".");
	КонецЕсли;

	Главное.Добавить(ЛюдиСИзменением("Больше всего выросли начисления", Изм.Рост));
	Главное.Добавить(ЛюдиСИзменением("Больше всего снизились начисления", Изм.Снижение));

	Главное.Добавить(СтрШаблон("У сотрудников с начислениями в обоих месяцах изменение больше %1: рост — %2 чел., снижение — %3 чел.",
		ПредставлениеПроцента(А.ПорогИзменения), Изм.СильноРост, Изм.СильноСнижение));

	Резкие = Новый Массив;
	Для Каждого ШагМесяца Из Изм.Шаги Цикл
		Если ШагМесяца.Процент <> Неопределено И Макс(ШагМесяца.Процент, -ШагМесяца.Процент) >= А.ПорогИзменения Тогда
			Резкие.Добавить(ШагМесяца.Месяц + " " + ПредставлениеПроцента(ШагМесяца.Процент, Истина));
		КонецЕсли;
	КонецЦикла;
	Если Резкие.Количество() > 0 Тогда
		Главное.Добавить("Резкие изменения ФОТ к прошлому месяцу (больше " + ПредставлениеПроцента(А.ПорогИзменения) + "): "
			+ СтрСоединить(Резкие, ", ") + ".");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Текст Из Главное Цикл
		Если НЕ ПустаяСтрока(Текст) Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЛюдиСИзменением(Заголовок, Т)

	Если Т.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Индекс = 0 По Мин(3, Т.Количество()) - 1 Цикл
		СтрокаИзм = Т[Индекс];
		Части.Добавить(СтрокаИзм.Имя + " " + ФорматСуммы(СтрокаИзм.Разница, Истина)
			+ ?(ПустаяСтрока(СтрокаИзм.Примечание), "", " (" + СтрокаИзм.Примечание + ")"));
	КонецЦикла;
	Возврат Заголовок + ": " + СтрСоединить(Части, "; ") + ".";

КонецФункции

Функция СписокНазваний(Названия, Количество)

	Части = Новый Массив;
	Для Индекс = 0 По Мин(Количество, Названия.Количество()) - 1 Цикл
		Части.Добавить("«" + Названия[Индекс] + "»");
	КонецЦикла;
	Текст = СтрСоединить(Части, ", ");
	Если Названия.Количество() > Количество Тогда
		Текст = Текст + " и ещё " + (Названия.Количество() - Количество);
	КонецЕсли;
	Возврат Текст;

КонецФункции

Процедура ВывестиЧтоИзменилось(Контекст, А)

	Изм = А.Изменения;
	Если Изм = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВывестиЗаголовокРаздела(Контекст, "Что сильно изменилось: " + Изм.ИмяТекущего + " к " + Изм.ИмяПредыдущего,
		"«Вклад» — доля строки в изменении ФОТ за месяц. Причина у сотрудника — статьи, которые изменились у него сильнее всего.");
	Для Каждого Текст Из Изм.Главное Цикл
		ВывестиЯчейку(Контекст, 1, "•", "");
		ВывестиЯчейку(Контекст, 2, Текст, "");
		НоваяСтрока(Контекст);
	КонецЦикла;

	// помесячная динамика
	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 2, "ФОТ: изменение к предыдущему месяцу", "Ж");
	НоваяСтрока(Контекст);
	УстановитьВысотуСтроки(Контекст, 42);
	К = Контекст.КолонкаМесяцев;
	ВывестиЯчейку(Контекст, 2, "Месяц", "Ш", 4);
	Заголовки = СтрРазделить("ФОТ в прошлом месяце|ФОТ в месяце|Изменение|Изменение, %|Сотрудников: было → стало|Появились в месяце|Нет начислений в месяце|Изменение у остальных", "|");
	Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
		ВывестиЯчейку(Контекст, К + Индекс, Заголовки[Индекс], "Ш");
	КонецЦикла;
	НоваяСтрока(Контекст);
	Для Каждого Шаг Из Изм.Шаги Цикл
		Резкий = Шаг.Процент <> Неопределено И Макс(Шаг.Процент, -Шаг.Процент) >= А.ПорогИзменения;
		ВывестиЯчейку(Контекст, 2, Шаг.Месяц + " к " + Шаг.МесяцДо, ?(Резкий, "РЖ", "Р"), 4);
		ВывестиЯчейку(Контекст, К, Шаг.Было, "Р");
		ВывестиЯчейку(Контекст, К + 1, Шаг.Стало, "Р");
		ВывестиЯчейку(Контекст, К + 2, Шаг.Разница, "Р+");
		ВывестиЯчейку(Контекст, К + 3, Шаг.Процент, "Р%+" + ?(Резкий, "Ж", ""));
		ВывестиЯчейку(Контекст, К + 4, "" + Шаг.ЧисленностьБыло + " → " + Шаг.ЧисленностьСтало, "Р");
		ВывестиЯчейку(Контекст, К + 5, Шаг.Новые, "Р+");
		ВывестиЯчейку(Контекст, К + 6, Шаг.Ушедшие, "Р+");
		ВывестиЯчейку(Контекст, К + 7, Шаг.Остальные, "Р+");
		НоваяСтрока(Контекст);
	КонецЦикла;

	ВывестиТаблицуИзменений(Контекст, Изм, "По статьям", Изм.Статьи, "Статья", "");
	ВывестиТаблицуИзменений(Контекст, Изм, "По видам начислений (до 15 с наибольшим изменением)", Изм.Виды, "Вид начисления", "Категория");
	Если Изм.Подразделения <> Неопределено Тогда
		ВывестиТаблицуИзменений(Контекст, Изм, "По подразделениям (до 10)", Изм.Подразделения, "Подразделение", "");
	КонецЕсли;
	ВывестиТаблицуИзменений(Контекст, Изм, "Сотрудники: наибольший рост начислений (до 10)", Изм.Рост, "Сотрудник", "Подразделение");
	ВывестиТаблицуИзменений(Контекст, Изм, "Сотрудники: наибольшее снижение начислений (до 10)", Изм.Снижение, "Сотрудник", "Подразделение");

КонецПроцедуры

Процедура ВывестиТаблицуИзменений(Контекст, Изм, Заголовок, Т, ЗаголовокИмени, ЗаголовокДоп)

	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 2, Заголовок, "Ж");
	НоваяСтрока(Контекст);
	Если Т.Количество() = 0 Тогда
		ВывестиЯчейку(Контекст, 2, "Изменений нет.", "С");
		НоваяСтрока(Контекст);
		Возврат;
	КонецЕсли;

	К = Контекст.КолонкаМесяцев;
	ПоследняяИмени = ?(ПустаяСтрока(ЗаголовокДоп), 4, 3);
	УстановитьВысотуСтроки(Контекст, 30);
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, ЗаголовокИмени, "Ш", ПоследняяИмени);
	Если НЕ ПустаяСтрока(ЗаголовокДоп) Тогда
		ВывестиЯчейку(Контекст, 4, ЗаголовокДоп, "Ш");
	КонецЕсли;
	ВывестиЯчейку(Контекст, К, "В " + Изм.ИмяПредыдущего, "Ш");
	ВывестиЯчейку(Контекст, К + 1, "В " + Изм.ИмяТекущего, "Ш");
	ВывестиЯчейку(Контекст, К + 2, "Изменение", "Ш");
	ВывестиЯчейку(Контекст, К + 3, "Изменение, %", "Ш");
	ВывестиЯчейку(Контекст, К + 4, "Вклад в изменение ФОТ", "Ш");
	ВывестиЯчейку(Контекст, К + 5, "Примечание", "Ш", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

	Номер = 0;
	Для Каждого СтрокаИзм Из Т Цикл
		Номер = Номер + 1;
		ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
		ВывестиЯчейку(Контекст, 2, СтрокаИзм.Имя, "Р", ПоследняяИмени);
		Если НЕ ПустаяСтрока(ЗаголовокДоп) Тогда
			ВывестиЯчейку(Контекст, 4, СтрокаИзм.Доп, "Р");
		КонецЕсли;
		ВывестиЯчейку(Контекст, К, СтрокаИзм.Было, "Р");
		ВывестиЯчейку(Контекст, К + 1, СтрокаИзм.Стало, "Р");
		ВывестиЯчейку(Контекст, К + 2, СтрокаИзм.Разница, "РЖ+");
		ВывестиЯчейку(Контекст, К + 3, СтрокаИзм.Процент, "Р%+");
		ВывестиЯчейку(Контекст, К + 4, СтрокаИзм.Вклад, "Р%");
		ВывестиЯчейку(Контекст, К + 5, СтрокаИзм.Примечание, "Р", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗаСчетКакихВыплат

// Раздел «За счёт каких выплат изменилась зарплата»: по каждому сотруднику, у которого начисления менялись
// от месяца к месяцу больше чем на 1 000 руб., — строка итога и под ней строки выплат (видов начислений),
// которые менялись, с суммами по месяцам. Неизменные выплаты сворачиваются в одну строку.
Процедура ВывестиРасшифровкуПоВыплатам(Контекст, А)

	КоличествоМесяцев = А.КоличествоМесяцев;
	Если КоличествоМесяцев < 2 Тогда
		Возврат;
	КонецЕсли;
	Последний = КоличествоМесяцев - 1;

	Отбор = Новый ТаблицаЗначений;
	Отбор.Колонки.Добавить("Сотр");
	Отбор.Колонки.Добавить("Скачок");
	Отбор.Колонки.Добавить("ИндексСкачка");
	Для Каждого Сотр Из А.Сотрудники Цикл
		Скачок = 0;
		ИндексСкачка = 0;
		Для Индекс = 1 По Последний Цикл
			Разница = Сотр.Начислено[Индекс] - Сотр.Начислено[Индекс - 1];
			Если Макс(Разница, -Разница) > Скачок Тогда
				Скачок = Макс(Разница, -Разница);
				ИндексСкачка = Индекс;
			КонецЕсли;
		КонецЦикла;
		Если Скачок >= 1000 Тогда
			СтрокаОтбора = Отбор.Добавить();
			СтрокаОтбора.Сотр = Сотр;
			СтрокаОтбора.Скачок = Скачок;
			СтрокаОтбора.ИндексСкачка = ИндексСкачка;
		КонецЕсли;
	КонецЦикла;
	Отбор.Сортировать("Скачок Убыв");

	ВывестиЗаголовокРаздела(Контекст, "За счёт каких выплат изменилась зарплата (" + Отбор.Количество() + " чел.)",
		"Сотрудники, у которых начисления менялись от месяца к месяцу больше чем на 1 000 руб., по убыванию изменения. "
		+ "Под каждым — выплаты (виды начислений), которые менялись; неизменные выплаты собраны в одну строку.");
	Если Отбор.Количество() = 0 Тогда
		ВывестиЯчейку(Контекст, 2, "Изменений больше 1 000 руб. нет.", "С");
		НоваяСтрока(Контекст);
		Возврат;
	КонецЕсли;

	К = Контекст.КолонкаПослеМесяцев;
	УстановитьВысотуСтроки(Контекст, 30);
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, "Сотрудник / выплата", "Ш", 3);
	ВывестиЯчейку(Контекст, 4, "Подразделение / статья", "Ш");
	ВывестиШапкуМесяцев(Контекст, СтрРазделить("Изменение к прошлому месяцу|Изменение, %|Изменение за период", "|"));
	ВывестиЯчейку(Контекст, К + 3, "Что произошло", "Ш", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

	Номер = 0;
	Для Каждого СтрокаОтбора Из Отбор Цикл
		Сотр = СтрокаОтбора.Сотр;
		Номер = Номер + 1;
		Суммы = Сотр.Начислено;
		ВывестиЯчейку(Контекст, 1, Номер, "ИЦ");
		ВывестиЯчейку(Контекст, 2, Сотр.Представление, "И", 3);
		ВывестиЯчейку(Контекст, 4, Сотр.Подразделение, "И");
		ВывестиСуммыПоМесяцам(Контекст, Суммы, "И");
		ВывестиЯчейку(Контекст, К, Суммы[Последний] - Суммы[Последний - 1], "И+");
		ВывестиЯчейку(Контекст, К + 1, ПроцентИзменения(Суммы[Последний - 1], Суммы[Последний]), "И%+");
		ВывестиЯчейку(Контекст, К + 2, Суммы[Последний] - Суммы[0], "И+");
		Главное = ИмяМесяца(А.Месяцы[СтрокаОтбора.ИндексСкачка]) + " "
			+ ФорматСуммы(Суммы[СтрокаОтбора.ИндексСкачка] - Суммы[СтрокаОтбора.ИндексСкачка - 1], Истина)
			+ " руб. за счёт: " + ЗаСчетВыплат(Сотр, СтрокаОтбора.ИндексСкачка - 1, СтрокаОтбора.ИндексСкачка, 3);
		ВывестиЯчейку(Контекст, К + 3, Главное, "ИП", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);

		// выплаты, которые менялись, — по убыванию самого большого изменения от месяца к месяцу
		Выплаты = Новый ТаблицаЗначений;
		Выплаты.Колонки.Добавить("Имя");
		Выплаты.Колонки.Добавить("Суммы");
		Выплаты.Колонки.Добавить("Скачок");
		Неизменные = МассивНулей(КоличествоМесяцев);
		ЕстьНеизменные = Ложь;
		Для Каждого КлючИЗначение Из Сотр.ПоВидам Цикл
			СуммыВида = КлючИЗначение.Значение;
			СкачокВида = 0;
			Для Индекс = 1 По Последний Цикл
				Разница = СуммыВида[Индекс] - СуммыВида[Индекс - 1];
				СкачокВида = Макс(СкачокВида, Разница, -Разница);
			КонецЦикла;
			Если СкачокВида = 0 Тогда
				ДобавитьКМассиву(Неизменные, СуммыВида);
				ЕстьНеизменные = Истина;
			Иначе
				СтрокаВыплаты = Выплаты.Добавить();
				СтрокаВыплаты.Имя = КлючИЗначение.Ключ;
				СтрокаВыплаты.Суммы = СуммыВида;
				СтрокаВыплаты.Скачок = СкачокВида;
			КонецЕсли;
		КонецЦикла;
		Выплаты.Сортировать("Скачок Убыв");

		Для Каждого СтрокаВыплаты Из Выплаты Цикл
			СуммыВида = СтрокаВыплаты.Суммы;
			ВывестиЯчейку(Контекст, 2, "      " + СтрокаВыплаты.Имя, "Р", 3);
			ВывестиЯчейку(Контекст, 4, КатегорияНачисления(СтрокаВыплаты.Имя), "РС");
			ВывестиСуммыПоМесяцам(Контекст, СуммыВида);
			ВывестиЯчейку(Контекст, К, СуммыВида[Последний] - СуммыВида[Последний - 1], "Р+");
			ВывестиЯчейку(Контекст, К + 1, ПроцентИзменения(СуммыВида[Последний - 1], СуммыВида[Последний]), "Р%+");
			ВывестиЯчейку(Контекст, К + 2, СуммыВида[Последний] - СуммыВида[0], "Р+");
			ВывестиЯчейку(Контекст, К + 3, ПримечаниеКВыплате(СуммыВида, А.Месяцы), "Р", Контекст.ПоследняяКолонка);
			НоваяСтрока(Контекст);
		КонецЦикла;
		Если ЕстьНеизменные Тогда
			ВывестиЯчейку(Контекст, 2, "      остальные выплаты без изменений", "РС", 3);
			ВывестиЯчейку(Контекст, 4, "", "Р");
			ВывестиСуммыПоМесяцам(Контекст, Неизменные, "РС");
			ВывестиЯчейку(Контекст, К, Неопределено, "Р");
			ВывестиЯчейку(Контекст, К + 1, Неопределено, "Р");
			ВывестиЯчейку(Контекст, К + 2, Неопределено, "Р");
			ВывестиЯчейку(Контекст, К + 3, "", "Р", Контекст.ПоследняяКолонка);
			НоваяСтрока(Контекст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Что произошло с выплатой: разовая, новая, прекратилась, самый большой скачок.
Функция ПримечаниеКВыплате(Суммы, Месяцы)

	Последний = Суммы.Количество() - 1;
	Ненулевые = Новый Массив;
	Для Индекс = 0 По Последний Цикл
		Если Суммы[Индекс] <> 0 Тогда
			Ненулевые.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	Если Ненулевые.Количество() = 1 Тогда
		Части.Добавить("только в " + ИмяМесяца(Месяцы[Ненулевые[0]]) + " (разовая)");
	ИначеЕсли Суммы[0] = 0 И Суммы[Последний] <> 0 Тогда
		Части.Добавить("новая с " + ИмяМесяца(Месяцы[Ненулевые[0]]));
	ИначеЕсли Суммы[0] <> 0 И Суммы[Последний] = 0 Тогда
		Части.Добавить("не начислялась в " + ИмяМесяца(Месяцы[Последний]));
	КонецЕсли;

	Скачок = 0;
	ИндексСкачка = 0;
	Для Индекс = 1 По Последний Цикл
		Разница = Суммы[Индекс] - Суммы[Индекс - 1];
		Если Макс(Разница, -Разница) > Скачок Тогда
			Скачок = Макс(Разница, -Разница);
			ИндексСкачка = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Скачок > 0 Тогда
		Части.Добавить("больше всего в " + ИмяМесяца(Месяцы[ИндексСкачка]) + ": "
			+ ФорматСуммы(Суммы[ИндексСкачка] - Суммы[ИндексСкачка - 1], Истина) + " руб.");
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти

#Область УчасткиЗаГод

// Анализ производственных участков за 12 месяцев: зарплата работников участка и выпуск участка,
// ФОТ на единицу выпуска, выработка на работника, связь ФОТ с выпуском, перекосы с объяснением.
//
// Участок — подразделение из шапки рапорта (как в «Ежедневном отчёте»): «Отчёт производства за смену»
// и документы со словом «рапорт»; если по участку таких нет — «Производство без заказа» и завершённые
// этапы производства (чтобы один выпуск не считать дважды). В расчёт берутся только работники
// производственных участков: зарплата по подразделению начисления (или кадровой истории на конец месяца),
// подчинённые подразделения (бригады) относятся к участку-родителю.
Функция СформироватьАнализУчастков(Знач ДатаОкончания, Знач Организация = Неопределено, Знач ПорогИзменения = 20) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()), -1);
	КонецЕсли;
	Если ПорогИзменения = Неопределено Или ПорогИзменения <= 0 Тогда
		ПорогИзменения = 20;
	КонецЕсли;

	Данные = ДанныеУчастков(ДатаОкончания, Организация);
	А = РассчитатьУчастки(Данные, ПорогИзменения);

	ТД = Новый ТабличныйДокумент;
	ТД.КлючПараметровПечати = "АнализЗарплатыПоУчасткам";
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТД.АвтоМасштаб = Истина;
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.ТолькоПросмотр = Истина;
	Контекст = НовыйКонтекстВывода(ТД, Данные.Месяцы);
	УстановитьШириныКолонок(Контекст);

	ВывестиЯчейку(Контекст, 1, "Производственные участки: зарплата и выпуск за 12 месяцев", "Т");
	УстановитьВысотуСтроки(Контекст, 22);
	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, "Период: " + ИмяМесяца(Данные.Месяцы[0]) + " — " + ИмяМесяца(Данные.Месяцы[11])
		+ "; организация: " + ?(ЗначениеЗаполнено(Организация), Строка(Организация), "все"), "Ж");
	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, "Только работники производственных участков. Участок — подразделение из шапки рапорта; "
		+ "зарплата — по подразделению начисления (" + Данные.ИсточникПодразделения + "), бригады относятся к участку-родителю. "
		+ "Выпуск — все выходные изделия участка, и продукция, и полуфабрикаты; кг пересчитаны в тонны.", "С");
	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, "«Оплата труда» — оклад/тариф, доплаты и премии (без отпускных, больничных и прочего). "
		+ "Порог перекоса: " + ПредставлениеПроцента(ПорогИзменения) + ". Сформирован: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")
		+ ". Версия обработки " + ВерсияОбработки() + ".", "С");
	НоваяСтрока(Контекст);

	Если А.Участки.Количество() = 0 Тогда
		НоваяСтрока(Контекст);
		ВывестиЯчейку(Контекст, 2, "Не найдено ни выпуска в рапортах, ни производственных подразделений с начислениями за период.", "Ж");
		НоваяСтрока(Контекст);
		Для Каждого Текст Из Данные.Источники Цикл
			ВывестиЯчейку(Контекст, 2, Текст, "С");
			НоваяСтрока(Контекст);
		КонецЦикла;
		Возврат ТД;
	КонецЕсли;

	ВывестиЗаголовокРаздела(Контекст, "Главное");
	Для Каждого Текст Из А.Главное Цикл
		ВывестиЯчейку(Контекст, 1, "•", "");
		ВывестиЯчейку(Контекст, 2, Текст, "");
		НоваяСтрока(Контекст);
	КонецЦикла;

	ВывестиСводкуУчастков(Контекст, А);
	ВывестиПерекосыУчастков(Контекст, А);
	ВывестиУчасткиПомесячно(Контекст, А);
	ВывестиДетализациюУчастков(Контекст, А, Данные);
	ВывестиНесопоставленные(Контекст, Данные);

	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, "Источники выпуска: " + СтрСоединить(Данные.Источники, "; "), "С");
	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, "Работники закреплены за участками по документам: "
		+ ?(Данные.ИсточникиЗакрепления.Количество() = 0, "таких документов нет — только по подразделению", СтрСоединить(Данные.ИсточникиЗакрепления, "; ")), "С");
	НоваяСтрока(Контекст);

	Возврат ТД;

КонецФункции

Функция ДанныеУчастков(ДатаОкончания, Организация)

	ПоследнийМесяц = НачалоМесяца(ДатаОкончания);
	Месяцы = Новый Массив;
	ИндексыМесяцев = Новый Соответствие;
	Для Индекс = 0 По 11 Цикл
		ТекМесяц = ДобавитьМесяц(ПоследнийМесяц, Индекс - 11);
		Месяцы.Добавить(ТекМесяц);
		ИндексыМесяцев.Вставить(ТекМесяц, Индекс);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("Месяцы", Месяцы);
	Данные.Вставить("ИндексыМесяцев", ИндексыМесяцев);
	Данные.Вставить("Начало", Месяцы[0]);
	Данные.Вставить("Конец", КонецМесяца(ПоследнийМесяц));
	Данные.Вставить("Организация", Организация);
	Данные.Вставить("Участки", Новый Соответствие);
	Данные.Вставить("Источники", Новый Массив);
	Данные.Вставить("ИсточникПодразделения", "");
	Данные.Вставить("Представления", Новый Соответствие);
	Данные.Вставить("Несопоставленные", Новый Соответствие);
	Данные.Вставить("ИсточникиЗакрепления", Новый Массив);

	ЗаполнитьВыпускУчастков(Данные);
	ЗаполнитьЗарплатуУчастков(Данные);
	Возврат Данные;

КонецФункции

Функция НовыйУчасток(Ссылка)

	Уч = Новый Структура;
	Уч.Вставить("Ссылка", Ссылка);
	Уч.Вставить("Имя", ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка), "<участок не указан>"));
	Уч.Вставить("ФОТ", МассивНулей(12));
	Уч.Вставить("Труд", МассивНулей(12));
	Уч.Вставить("Категории", Новый Соответствие);
	Для Каждого Категория Из ПорядокКатегорий() Цикл
		Уч.Категории.Вставить(Категория, МассивНулей(12));
	КонецЦикла;
	Работники = Новый Массив;
	Для Индекс = 1 По 12 Цикл
		Работники.Добавить(Новый Соответствие);
	КонецЦикла;
	Уч.Вставить("Работники", Работники);
	Уч.Вставить("ВыпускПоЕд", Новый Соответствие); // единица -> Структура(Основной, Прочий) массивы по месяцам
	Уч.Вставить("Выпуск", МассивНулей(12));
	Уч.Вставить("Ед", "");
	Уч.Вставить("ПрочиеЕд", "");
	Уч.Вставить("Источники", Новый Соответствие);
	Уч.Вставить("ЕстьВыпуск", Ложь);
	Уч.Вставить("Группа", Неопределено);
	Уч.Вставить("Члены", Неопределено);
	Уч.Вставить("Способы", Новый Соответствие);
	Уч.Вставить("Виды", Новый Соответствие);
	Уч.Вставить("ФОТЦеха", МассивНулей(12));
	Уч.Вставить("ЧисленностьЦеха", МассивНулей(12));
	Уч.Вставить("ЦехИмя", "");
	Уч.Вставить("ЛюдиПоДокументам", МассивНулей(12));
	Возврат Уч;

КонецФункции

// Выпуск по участкам и месяцам из рапортов (логика «Ежедневного отчёта»).
Процедура ЗаполнитьВыпускУчастков(Данные)

	Основные = Новый Массив;
	Основные.Добавить("ОтчетПроизводстваЗаСмену");
	Для Каждого МетаДок Из Метаданные.Документы Цикл
		Название = НРег(МетаДок.Имя + " " + МетаДок.Синоним);
		Если Основные.Найти(МетаДок.Имя) = Неопределено И МетаДок.Имя <> "ПроизводствоБезЗаказа" И МетаДок.Имя <> "ЭтапПроизводства2_2"
			И (СтрНайти(Название, "рапорт") > 0 Или (СтрНайти(Название, "отчет") > 0 И СтрНайти(Название, "смен") > 0)) Тогда
			Основные.Добавить(МетаДок.Имя);
		КонецЕсли;
	КонецЦикла;
	Все = Новый Массив;
	Для Каждого Имя Из Основные Цикл
		Все.Добавить(Новый Структура("Имя, Основной", Имя, Истина));
	КонецЦикла;
	Все.Добавить(Новый Структура("Имя, Основной", "ПроизводствоБезЗаказа", Ложь));
	Все.Добавить(Новый Структура("Имя, Основной", "ЭтапПроизводства2_2", Ложь));

	ЕстьЕдиница = Метаданные.Справочники.Найти("Номенклатура") <> Неопределено
		И Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	ИменаЕдиниц = Новый Соответствие;

	Для Каждого Опис Из Все Цикл
		Мета = Метаданные.Документы.Найти(Опис.Имя);
		Если Мета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИмяТЧ Из СтрРазделить("ВыходныеИзделия,Продукция,Выпуск,ВыпущеннаяПродукция,Полуфабрикаты,ВыходныеПолуфабрикаты", ",") Цикл
			ТЧ = Мета.ТабличныеЧасти.Найти(ИмяТЧ);
			Если ТЧ = Неопределено Или ТЧ.Реквизиты.Найти("Номенклатура") = Неопределено
				Или (ТЧ.Реквизиты.Найти("Количество") = Неопределено И ТЧ.Реквизиты.Найти("КоличествоУпаковок") = Неопределено
					И ТЧ.Реквизиты.Найти("опти_Количество") = Неопределено) Тогда
				Продолжить;
			КонецЕсли;
			РекУчасток = "";
			Для Каждого Вариант Из СтрРазделить("Подразделение,Участок,ПодразделениеДиспетчер", ",") Цикл
				Если Мета.Реквизиты.Найти(Вариант) <> Неопределено Тогда
					РекУчасток = Вариант;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ПолеУчастка = ?(РекУчасток = "", "НЕОПРЕДЕЛЕНО", "Т.Ссылка." + РекУчасток);
			ПолеУчасткаСтроки = ?(ТЧ.Реквизиты.Найти("Подразделение") = Неопределено, "НЕОПРЕДЕЛЕНО", "Т.Подразделение");
			ПолеЕд = ?(ЕстьЕдиница, "Т.Номенклатура.ЕдиницаИзмерения", "НЕОПРЕДЕЛЕНО");
			ЕстьСтатус = Мета.Реквизиты.Найти("Статус") <> Неопределено;

			Группировка = Новый Массив;
			Группировка.Добавить("НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ)");
			Для Каждого Поле Из СтрРазделить(ПолеУчастка + "," + ПолеУчасткаСтроки + "," + ПолеЕд, ",") Цикл
				Если Поле <> "НЕОПРЕДЕЛЕНО" Тогда
					Группировка.Добавить(Поле);
				КонецЕсли;
			КонецЦикла;
			Если ЕстьСтатус Тогда
				Группировка.Добавить("Т.Ссылка.Статус");
			КонецЕсли;
			Условия = Новый Массив;
			Условия.Добавить("Т.Ссылка.Проведен");
			Условия.Добавить("Т.Ссылка.Дата МЕЖДУ &Начало И &Конец");
			Если ЗначениеЗаполнено(Данные.Организация) И Мета.Реквизиты.Найти("Организация") <> Неопределено Тогда
				Условия.Добавить("Т.Ссылка.Организация = &Организация");
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ) КАК Месяц,
				|	" + ПолеУчастка + " КАК Участок,
				|	" + ПолеУчасткаСтроки + " КАК УчастокСтроки,
				|	" + ПолеЕд + " КАК Ед,
				|	" + ?(ЕстьСтатус, "Т.Ссылка.Статус", "НЕОПРЕДЕЛЕНО") + " КАК Статус,
				|	СУММА(" + ВыражениеКоличестваВыпуска(ТЧ) + ") КАК Количество
				|ИЗ
				|	Документ." + Мета.Имя + "." + ТЧ.Имя + " КАК Т
				|ГДЕ
				|	" + СтрСоединить(Условия, Символы.ПС + "	И ") + "
				|СГРУППИРОВАТЬ ПО
				|	" + СтрСоединить(Группировка, "," + Символы.ПС + "	");
			Запрос.УстановитьПараметр("Начало", Данные.Начало);
			Запрос.УстановитьПараметр("Конец", Данные.Конец);
			Запрос.УстановитьПараметр("Организация", Данные.Организация);
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Данные.Источники.Добавить(Мета.Синоним + ": ошибка " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;

			Строк = 0;
			Пока Выборка.Следующий() Цикл
				Если ЕстьСтатус И Мета.Имя = "ЭтапПроизводства2_2" И СтрНайти(НРег(Строка(Выборка.Статус)), "заверш") = 0 Тогда
					Продолжить;
				КонецЕсли;
				Количество = ?(ТипЗнч(Выборка.Количество) = Тип("Число"), Выборка.Количество, 0);
				ИндексМесяца = Данные.ИндексыМесяцев.Получить(Выборка.Месяц);
				Если Количество = 0 Или ИндексМесяца = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Участок = Выборка.Участок;
				Если НЕ ЗначениеЗаполнено(Участок) Тогда
					Участок = Выборка.УчастокСтроки;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Участок) Тогда
					Участок = Неопределено;
				КонецЕсли;
				ИмяЕд = ИменаЕдиниц.Получить(Выборка.Ед);
				Если ИмяЕд = Неопределено Тогда
					ИмяЕд = ?(ЗначениеЗаполнено(Выборка.Ед), СокрЛП(Строка(Выборка.Ед)), "ед.");
					ИменаЕдиниц.Вставить(Выборка.Ед, ИмяЕд);
				КонецЕсли;
				Пересчет = ЕдиницаОтчета(ИмяЕд);

				Уч = Данные.Участки.Получить(Участок);
				Если Уч = Неопределено Тогда
					Уч = НовыйУчасток(Участок);
					Данные.Участки.Вставить(Участок, Уч);
				КонецЕсли;
				ПоЕд = Уч.ВыпускПоЕд.Получить(Пересчет.Имя);
				Если ПоЕд = Неопределено Тогда
					ПоЕд = Новый Структура("Основной, Прочий", МассивНулей(12), МассивНулей(12));
					Уч.ВыпускПоЕд.Вставить(Пересчет.Имя, ПоЕд);
				КонецЕсли;
				СуммыЕд = ?(Опис.Основной, ПоЕд.Основной, ПоЕд.Прочий);
				СуммыЕд[ИндексМесяца] = СуммыЕд[ИндексМесяца] + Количество * Пересчет.Коэффициент;
				Уч.Источники.Вставить(Мета.Синоним + ?(Опис.Основной, "", " (запасной)"), Опис.Основной);
				Строк = Строк + 1;
			КонецЦикла;
			Если Строк > 0 Тогда
				Данные.Источники.Добавить(Мета.Синоним + "." + ТЧ.Синоним + ?(Опис.Основной, "", " — только для участков без рапортов"));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// по каждому участку: рапорты, если они есть, иначе запасные документы; основная единица — с наибольшим выпуском
	Для Каждого КлючИЗначение Из Данные.Участки Цикл
		Уч = КлючИЗначение.Значение;
		ЕстьОсновной = Ложь;
		Для Каждого ЕдИЗначение Из Уч.ВыпускПоЕд Цикл
			Если СуммаМассива(ЕдИЗначение.Значение.Основной) <> 0 Тогда
				ЕстьОсновной = Истина;
			КонецЕсли;
		КонецЦикла;
		ЛучшаяЕд = "";
		ЛучшийИтог = 0;
		Прочие = Новый Массив;
		Для Каждого ЕдИЗначение Из Уч.ВыпускПоЕд Цикл
			СуммыЕд = ?(ЕстьОсновной, ЕдИЗначение.Значение.Основной, ЕдИЗначение.Значение.Прочий);
			Итог = СуммаМассива(СуммыЕд);
			Если ЛучшаяЕд = "" Или Итог > ЛучшийИтог Тогда
				ЛучшаяЕд = ЕдИЗначение.Ключ;
				ЛучшийИтог = Итог;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ЕдИЗначение Из Уч.ВыпускПоЕд Цикл
			СуммыЕд = ?(ЕстьОсновной, ЕдИЗначение.Значение.Основной, ЕдИЗначение.Значение.Прочий);
			Если ЕдИЗначение.Ключ = ЛучшаяЕд Тогда
				Уч.Выпуск = СуммыЕд;
			ИначеЕсли СуммаМассива(СуммыЕд) <> 0 Тогда
				Прочие.Добавить(Формат(СуммаМассива(СуммыЕд), "ЧДЦ=1; ЧН=0") + " " + ЕдИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
		Уч.Ед = ЛучшаяЕд;
		Уч.ПрочиеЕд = СтрСоединить(Прочие, ", ");
		Уч.ЕстьВыпуск = СуммаМассива(Уч.Выпуск) <> 0;
		Источники = Новый Массив;
		Для Каждого ИстИЗначение Из Уч.Источники Цикл
			Если ИстИЗначение.Значение = ЕстьОсновной Тогда
				Источники.Добавить(ИстИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
		Уч.Источники = Новый Соответствие;
		Для Каждого Имя Из Источники Цикл
			Уч.Источники.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Количество строки выпуска в базовых единицах номенклатуры (как в «Ежедневном отчёте»).
Функция ВыражениеКоличестваВыпуска(ТЧ)

	ВУпаковках = "Т.КоличествоУпаковок";
	МетаУпаковок = Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения");
	Если ТЧ.Реквизиты.Найти("Упаковка") <> Неопределено И МетаУпаковок <> Неопределено
		И МетаУпаковок.Реквизиты.Найти("Числитель") <> Неопределено И МетаУпаковок.Реквизиты.Найти("Знаменатель") <> Неопределено Тогда
		ВУпаковках = "Т.КоличествоУпаковок * ЕСТЬNULL(ВЫБОР КОГДА Т.Упаковка.Знаменатель > 0 И Т.Упаковка.Числитель > 0 "
			+ "ТОГДА Т.Упаковка.Числитель / Т.Упаковка.Знаменатель ИНАЧЕ 1 КОНЕЦ, 1)";
	КонецЕсли;
	ВБазовых = ?(ТЧ.Реквизиты.Найти("Количество") <> Неопределено, "Т.Количество", ВУпаковках);
	Если ТЧ.Реквизиты.Найти("опти_Количество") <> Неопределено Тогда
		Возврат "ВЫБОР КОГДА Т.опти_Количество <> 0 ТОГДА Т.опти_Количество ИНАЧЕ " + ВБазовых + " КОНЕЦ";
	КонецЕсли;
	Возврат ВБазовых;

КонецФункции

// кг -> т; остальные единицы как есть.
Функция ЕдиницаОтчета(ИмяЕд)

	Имя = НРег(СокрЛП(ИмяЕд));
	Если Имя = "кг" Или Лев(Имя, 5) = "килог" Тогда
		Возврат Новый Структура("Имя, Коэффициент", "т", 0.001);
	ИначеЕсли Имя = "т" Или Имя = "тн" Или Лев(Имя, 4) = "тонн" Тогда
		Возврат Новый Структура("Имя, Коэффициент", "т", 1);
	КонецЕсли;
	Возврат Новый Структура("Имя, Коэффициент", ИмяЕд, 1);

КонецФункции

// Начисления работников участков по месяцам.
Процедура ЗаполнитьЗарплатуУчастков(Данные)

	МетаРегистр = Метаданные.РегистрыНакопления.Найти("НачисленияУдержанияПоСотрудникам");
	Если МетаРегистр = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет регистра накопления ""НачисленияУдержанияПоСотрудникам"".";
	КонецЕсли;
	ПолеСотрудника = ?(ЕстьПолеРегистра(МетаРегистр, "Сотрудник"), "Сотрудник", "ФизическоеЛицо");
	ЕстьГруппа = ЕстьПолеРегистра(МетаРегистр, "ГруппаНачисленияУдержанияВыплаты");
	ЕстьПодразделение = ЕстьПолеРегистра(МетаРегистр, "Подразделение");
	ЕстьОрганизация = ЕстьПолеРегистра(МетаРегистр, "Организация");
	Данные.ИсточникПодразделения = ?(ЕстьПодразделение, "из регистра начислений", "кадровая история на конец месяца");

	ПоляВнутр = Новый Массив;
	ПоляГруппировки = Новый Массив;
	ПоляВнутр.Добавить("НАЧАЛОПЕРИОДА(Н.Период, МЕСЯЦ) КАК Месяц");
	ПоляГруппировки.Добавить("НАЧАЛОПЕРИОДА(Н.Период, МЕСЯЦ)");
	ПоляВнутр.Добавить("Н." + ПолеСотрудника + " КАК Сотрудник");
	ПоляГруппировки.Добавить("Н." + ПолеСотрудника);
	ПоляВнутр.Добавить("Н.НачислениеУдержание КАК Вид");
	ПоляГруппировки.Добавить("Н.НачислениеУдержание");
	Если ЕстьГруппа Тогда
		ПоляВнутр.Добавить("Н.ГруппаНачисленияУдержанияВыплаты КАК Группа");
		ПоляГруппировки.Добавить("Н.ГруппаНачисленияУдержанияВыплаты");
	Иначе
		ПоляВнутр.Добавить("НЕОПРЕДЕЛЕНО КАК Группа");
	КонецЕсли;
	Если ЕстьПодразделение Тогда
		ПоляВнутр.Добавить("Н.Подразделение КАК Подразделение");
		ПоляГруппировки.Добавить("Н.Подразделение");
	Иначе
		ПоляВнутр.Добавить("НЕОПРЕДЕЛЕНО КАК Подразделение");
	КонецЕсли;
	ПоляВнутр.Добавить("СУММА(Н.Сумма) КАК Сумма");
	Условия = Новый Массив;
	Условия.Добавить("Н.Период МЕЖДУ &Начало И &Конец");
	Условия.Добавить("Н.Активность");
	Если ЕстьОрганизация И ЗначениеЗаполнено(Данные.Организация) Тогда
		Условия.Добавить("Н.Организация = &Организация");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Месяц КАК Месяц,
		|	Т.Сотрудник КАК Сотрудник,
		|	ПРЕДСТАВЛЕНИЕ(Т.Сотрудник) КАК СотрудникПредставление,
		|	Т.Вид КАК Вид,
		|	ПРЕДСТАВЛЕНИЕ(Т.Вид) КАК ВидПредставление,
		|	Т.Группа КАК Группа,
		|	Т.Подразделение КАК Подразделение,
		|	Т.Сумма КАК Сумма
		|ИЗ
		|	(ВЫБРАТЬ
		|		" + СтрСоединить(ПоляВнутр, "," + Символы.ПС + "		") + "
		|	ИЗ
		|		РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК Н
		|	ГДЕ
		|		" + СтрСоединить(Условия, Символы.ПС + "		И ") + "
		|	СГРУППИРОВАТЬ ПО
		|		" + СтрСоединить(ПоляГруппировки, "," + Символы.ПС + "		") + ") КАК Т";
	Запрос.УстановитьПараметр("Начало", Данные.Начало);
	Запрос.УстановитьПараметр("Конец", Данные.Конец);
	Запрос.УстановитьПараметр("Организация", Данные.Организация);
	Таблица = Запрос.Выполнить().Выгрузить();

	// подразделение по кадровой истории, если в регистре его нет
	ПодразделенияПоМесяцам = Неопределено;
	Если НЕ ЕстьПодразделение И ПолеСотрудника = "Сотрудник" Тогда
		ПодразделенияПоМесяцам = ПодразделенияСотрудниковПоМесяцам(Таблица.ВыгрузитьКолонку("Сотрудник"), Данные.Месяцы);
	КонецЕсли;

	КэшТипов = Новый Соответствие;
	КэшУчастков = Новый Соответствие;
	Индекс = ИндексУчастков(Данные.Участки);
	ТипСотрудника = ?(Таблица.Количество() = 0, Неопределено, ТипЗнч(Таблица[0].Сотрудник));
	Закрепление = ЗакреплениеСотрудников(Данные, ТипСотрудника, Индекс);
	Данные.Вставить("ИсточникиЗакрепления", Закрепление.Источники);
	Для Каждого КлючИЗначение Из Закрепление.ПоМесяцам Цикл
		ИндексЛюдей = Число(Лев(КлючИЗначение.Ключ, СтрНайти(КлючИЗначение.Ключ, "|") - 1));
		КлючИЗначение.Значение.ЛюдиПоДокументам[ИндексЛюдей] = КлючИЗначение.Значение.ЛюдиПоДокументам[ИндексЛюдей] + 1;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИндексМесяца = Данные.ИндексыМесяцев.Получить(СтрокаТаблицы.Месяц);
		Если ИндексМесяца = Неопределено Или СтрокаТаблицы.Сумма = NULL Или СтрокаТаблицы.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипСтрокиНачисления(СтрокаТаблицы.Группа, СтрокаТаблицы.Вид, СтрокаТаблицы.ВидПредставление, КэшТипов) <> "Начислено" Тогда
			Продолжить;
		КонецЕсли;
		Подразделение = СтрокаТаблицы.Подразделение;
		Если ПодразделенияПоМесяцам <> Неопределено Тогда
			Подразделение = ПодразделенияПоМесяцам.Получить(Строка(ИндексМесяца) + "|" + XMLСтрока(СтрокаТаблицы.Сотрудник));
		КонецЕсли;
		Сумма = СтрокаТаблицы.Сумма;
		// сначала — участок, где работник указан в документах производства за этот месяц (или чаще всего за год)
		КлючСотрудника = XMLСтрока(СтрокаТаблицы.Сотрудник);
		Уч = Закрепление.ПоМесяцам.Получить(Строка(ИндексМесяца) + "|" + КлючСотрудника);
		Если Уч = Неопределено Тогда
			Уч = Закрепление.ПоГоду.Получить(КлючСотрудника);
		КонецЕсли;
		Если Уч <> Неопределено Тогда
			Уч.Способы.Вставить("работники, указанные в документах производства участка", Истина);
		Иначе
			Уч = УчастокПодразделения(Подразделение, Данные, Индекс, КэшУчастков);
		КонецЕсли;
		Если Уч = Неопределено Тогда
			ЗапомнитьНесопоставленное(Данные, Подразделение, Сумма, СтрокаТаблицы.Сотрудник);
			Продолжить;
		КонецЕсли;
		Уч.ФОТ[ИндексМесяца] = Уч.ФОТ[ИндексМесяца] + Сумма;
		Категория = КатегорияНачисления(СокрЛП(СтрокаТаблицы.ВидПредставление));
		Уч.Категории[Категория][ИндексМесяца] = Уч.Категории[Категория][ИндексМесяца] + Сумма;
		Если Категория = "Оклад / тариф" Или Категория = "Доплаты и надбавки" Или Категория = "Премии и вознаграждения" Тогда
			Уч.Труд[ИндексМесяца] = Уч.Труд[ИндексМесяца] + Сумма;
		КонецЕсли;
		Работники = Уч.Работники[ИндексМесяца];
		Было = Работники.Получить(СтрокаТаблицы.Сотрудник);
		Работники.Вставить(СтрокаТаблицы.Сотрудник, ?(Было = Неопределено, 0, Было) + Сумма);
		ИмяВида = СокрЛП(СтрокаТаблицы.ВидПредставление);
		СуммыВида = Уч.Виды.Получить(ИмяВида);
		Если СуммыВида = Неопределено Тогда
			СуммыВида = МассивНулей(12);
			Уч.Виды.Вставить(ИмяВида, СуммыВида);
		КонецЕсли;
		СуммыВида[ИндексМесяца] = СуммыВида[ИндексМесяца] + Сумма;
		Данные.Представления.Вставить(СтрокаТаблицы.Сотрудник, СтрокаТаблицы.СотрудникПредставление);
	КонецЦикла;
	РаспределитьЦеха(Данные);

КонецПроцедуры

// Ключ «индекс месяца|сотрудник» -> подразделение на конец месяца.
Функция ПодразделенияСотрудниковПоМесяцам(Сотрудники, Месяцы)

	Результат = Новый Соответствие;
	МетаКИ = Метаданные.РегистрыСведений.Найти("КадроваяИсторияСотрудников");
	Если МетаКИ = Неопределено Или НЕ ЕстьПолеРегистра(МетаКИ, "Сотрудник") Или НЕ ЕстьПолеРегистра(МетаКИ, "Подразделение") Тогда
		Возврат Результат;
	КонецЕсли;
	Список = Новый Массив;
	Уже = Новый Соответствие;
	Для Каждого Сотрудник Из Сотрудники Цикл
		Если Уже.Получить(Сотрудник) = Неопределено Тогда
			Уже.Вставить(Сотрудник, Истина);
			Список.Добавить(Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КИ.Сотрудник КАК Сотрудник,
		|	КИ.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&НаДату, Сотрудник В (&Сотрудники)) КАК КИ";
	Запрос.УстановитьПараметр("Сотрудники", Список);
	Для Индекс = 0 По Месяцы.Количество() - 1 Цикл
		Запрос.УстановитьПараметр("НаДату", КонецМесяца(Месяцы[Индекс]));
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Возврат Результат;
		КонецПопытки;
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Строка(Индекс) + "|" + XMLСтрока(Выборка.Сотрудник), Выборка.Подразделение);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Индексы для сопоставления подразделений из зарплаты (обычно «Подразделения организаций») с участками
// из рапортов (обычно «Структура предприятия»): по названию, по родителям участков, по реквизитам-связям.
Функция ИндексУчастков(Участки)

	Индекс = Новый Структура;
	Индекс.Вставить("ПоИмени", Новый Соответствие);
	Индекс.Вставить("ПоПредку", Новый Соответствие);
	Индекс.Вставить("ПоИмениПредка", Новый Соответствие);
	Индекс.Вставить("ПоСвязиУчастка", Новый Соответствие);
	Индекс.Вставить("Типы", Новый Соответствие);
	Индекс.Вставить("РеквизитыСвязи", Новый Соответствие);
	Для Каждого КлючИЗначение Из Участки Цикл
		Уч = КлючИЗначение.Значение;
		Ссылка = Уч.Ссылка;
		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Индекс.Типы.Вставить(ТипЗнч(Ссылка), Истина);
		ИмяУчастка = НормИмя(Строка(Ссылка));
		Если Индекс.ПоИмени.Получить(ИмяУчастка) = Неопределено Тогда
			Индекс.ПоИмени.Вставить(ИмяУчастка, Уч);
		КонецЕсли;
		// реквизиты участка, ссылающиеся на другие подразделения (например, подразделение организации)
		МетаУчастка = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		Если МетаУчастка <> Неопределено Тогда
			Для Каждого Рек Из МетаУчастка.Реквизиты Цикл
				Если СтрНайти(НРег(Рек.Имя), "подразделен") = 0 Тогда
					Продолжить;
				КонецЕсли;
				Связанное = Неопределено;
				Попытка
					Связанное = Ссылка[Рек.Имя];
				Исключение
					Связанное = Неопределено;
				КонецПопытки;
				// только ссылки на подразделения другого справочника (подразделение организации), не соседние участки
				Если ЗначениеЗаполнено(Связанное) И ТипЗнч(Связанное) <> ТипЗнч(Ссылка) Тогда
					Индекс.ПоСвязиУчастка.Вставить(Связанное, Уч);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// предки участка: цех, производство
		Предок = РодительСсылки(Ссылка);
		Для Уровень = 1 По 10 Цикл
			Если НЕ ЗначениеЗаполнено(Предок) Тогда
				Прервать;
			КонецЕсли;
			ДобавитьВСписок(Индекс.ПоПредку, Предок, Уч);
			ДобавитьВСписок(Индекс.ПоИмениПредка, НормИмя(Строка(Предок)), Уч);
			Предок = РодительСсылки(Предок);
		КонецЦикла;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

Процедура ДобавитьВСписок(Соответствие, Ключ, Значение)

	Список = Соответствие.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Соответствие.Вставить(Ключ, Список);
	КонецЕсли;
	Если Список.Найти(Значение) = Неопределено Тогда
		Список.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция РодительСсылки(Ссылка)

	Попытка
		Возврат Ссылка.Родитель;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Название без регистра, пробелов, знаков и «№»: «Цех № 1» = «цех №1» = «Цех 1».
Функция НормИмя(Знач Текст)

	Текст = НРег(СокрЛП(Текст));
	Текст = СтрЗаменить(Текст, "ё", "е");
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ1 = Сред(Текст, Позиция, 1);
		Если СтрНайти(" .,;:-_""'«»()№#/\" + Символы.Таб + Символы.НПП, Символ1) = 0 Тогда
			Результат = Результат + Символ1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значения реквизитов подразделения, у которых тип — справочник участков (связь подразделения организации
// со структурой предприятия).
Функция СвязанныеСсылки(Ссылка, Индекс)

	Результат = Новый Массив;
	Мета = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если Мета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Имена = Индекс.РеквизитыСвязи.Получить(Мета.ПолноеИмя());
	Если Имена = Неопределено Тогда
		Имена = Новый Массив;
		Попытка
			Для Каждого Рек Из Мета.Реквизиты Цикл
				Для Каждого ТипИЗначение Из Индекс.Типы Цикл
					Если Рек.Тип.СодержитТип(ТипИЗначение.Ключ) Тогда
						Имена.Добавить(Рек.Имя);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		Исключение
			Имена = Новый Массив;
		КонецПопытки;
		Индекс.РеквизитыСвязи.Вставить(Мета.ПолноеИмя(), Имена);
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Попытка
			Значение = Ссылка[Имя];
		Исключение
			Значение = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Участок для подразделения начисления. Способ — как сопоставили (для отчёта и диагностики).
Функция НайтиУчасток(Ссылка, Участки, Индекс, Способ)

	Уч = Участки.Получить(Ссылка);
	Если Уч <> Неопределено Тогда
		Способ = "то же подразделение";
		Возврат Уч;
	КонецЕсли;
	Уч = Индекс.ПоСвязиУчастка.Получить(Ссылка);
	Если Уч <> Неопределено Тогда
		Способ = "реквизит участка";
		Возврат Уч;
	КонецЕсли;
	Для Каждого Связанное Из СвязанныеСсылки(Ссылка, Индекс) Цикл
		Уч = Участки.Получить(Связанное);
		Если Уч <> Неопределено Тогда
			Способ = "реквизит подразделения";
			Возврат Уч;
		КонецЕсли;
	КонецЦикла;
	Уч = Индекс.ПоИмени.Получить(НормИмя(Строка(Ссылка)));
	Если Уч <> Неопределено Тогда
		Способ = "по названию";
		Возврат Уч;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция УчасткиПодПодразделением(Подразделение, Индекс)

	Список = Индекс.ПоПредку.Получить(Подразделение);
	Если Список <> Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Для Каждого Связанное Из СвязанныеСсылки(Подразделение, Индекс) Цикл
		Список = Индекс.ПоПредку.Получить(Связанное);
		Если Список <> Неопределено Тогда
			Возврат Список;
		КонецЕсли;
	КонецЦикла;
	Список = Индекс.ПоИмениПредка.Получить(НормИмя(Строка(Подразделение)));
	Возврат ?(Список = Неопределено, Новый Массив, Список);

КонецФункции

// Работники числятся в цехе, а рапорты — по его участкам: участки объединяются в одну строку цеха.
Функция ГруппаУчастков(Подразделение, Члены, Данные)

	Свободные = Новый Массив;
	Для Каждого Уч Из Члены Цикл
		Если Уч.Группа = Неопределено Тогда
			Свободные.Добавить(Уч);
		ИначеЕсли Свободные.Найти(Уч.Группа) = Неопределено Тогда
			Свободные.Добавить(Уч.Группа);
		КонецЕсли;
	КонецЦикла;
	Если Свободные.Количество() = 1 Тогда
		Возврат Свободные[0];
	КонецЕсли;
	Группа = НовыйУчасток(Подразделение);
	Имена = Новый Массив;
	Для Каждого Уч Из Свободные Цикл
		Уч.Группа = Группа;
		Имена.Добавить(Уч.Имя);
	КонецЦикла;
	Группа.Имя = Строка(Подразделение) + " (участки: " + СтрСоединить(Имена, ", ") + ")";
	Группа.Члены = Свободные;
	Данные.Участки.Вставить(Подразделение, Группа);
	Возврат Группа;

КонецФункции

// Участок подразделения: само подразделение или ближайший родитель, сопоставленные с участком рапортов
// (ссылка, реквизит-связь, название); иначе — цех, в который входят участки; иначе — производственное
// подразделение без рапортов. Неопределено — не участок (офис, службы).
Функция УчастокПодразделения(Подразделение, Данные, Индекс, Кэш)

	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Найдено = Кэш.Получить(Подразделение);
	Если Найдено <> Неопределено Тогда
		Возврат ?(Найдено = Ложь, Неопределено, Найдено);
	КонецЕсли;

	Найдено = Ложь;
	Способ = "";
	Текущее = Подразделение;
	Для Уровень = 1 По 10 Цикл
		Уч = НайтиУчасток(Текущее, Данные.Участки, Индекс, Способ);
		Если Уч <> Неопределено Тогда
			Найдено = Уч;
			Если Уровень > 1 Тогда
				Способ = Способ + " (через родителя «" + Строка(Текущее) + "»)";
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Текущее = РодительСсылки(Текущее);
		Если НЕ ЗначениеЗаполнено(Текущее) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Найдено = Ложь Тогда
		Члены = УчасткиПодПодразделением(Подразделение, Индекс);
		Если Члены.Количество() > 0 Тогда
			Найдено = ГруппаУчастков(Подразделение, Члены, Данные);
			Способ = "цех с участками";
		КонецЕсли;
	КонецЕсли;

	Если Найдено = Ложь Тогда
		Производственное = Ложь;
		Попытка
			Производственное = (Подразделение.ПроизводственноеПодразделение = Истина);
		Исключение
			Производственное = Ложь;
		КонецПопытки;
		Если Производственное Тогда
			Найдено = Данные.Участки.Получить(Подразделение);
			Если Найдено = Неопределено Тогда
				Найдено = НовыйУчасток(Подразделение);
				Данные.Участки.Вставить(Подразделение, Найдено);
			КонецЕсли;
			Способ = "производственное подразделение без рапортов";
		КонецЕсли;
	КонецЕсли;

	Если Найдено <> Ложь Тогда
		Найдено.Способы.Вставить("«" + Строка(Подразделение) + "» — " + Способ, Истина);
	КонецЕсли;
	Кэш.Вставить(Подразделение, Найдено);
	Возврат ?(Найдено = Ложь, Неопределено, Найдено);

КонецФункции

Процедура ЗапомнитьНесопоставленное(Данные, Подразделение, Сумма, Сотрудник)

	Ключ = ?(ЗначениеЗаполнено(Подразделение), Подразделение, "<не указано>");
	Запись = Данные.Несопоставленные.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Путь = Новый Массив;
		Текущее = РодительСсылки(Подразделение);
		Для Уровень = 1 По 5 Цикл
			Если НЕ ЗначениеЗаполнено(Текущее) Тогда
				Прервать;
			КонецЕсли;
			Путь.Вставить(0, Строка(Текущее));
			Текущее = РодительСсылки(Текущее);
		КонецЦикла;
		ИмяСправочника = "";
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Мета = Метаданные.НайтиПоТипу(ТипЗнч(Подразделение));
			ИмяСправочника = ?(Мета = Неопределено, "", Мета.Синоним);
		КонецЕсли;
		Запись = Новый Структура("Имя, Путь, Справочник, ФОТ, Работники",
			?(ЗначениеЗаполнено(Подразделение), Строка(Подразделение), "<подразделение не указано>"),
			СтрСоединить(Путь, " / "), ИмяСправочника, 0, Новый Соответствие);
		Данные.Несопоставленные.Вставить(Ключ, Запись);
	КонецЕсли;
	Запись.ФОТ = Запись.ФОТ + Сумма;
	Запись.Работники.Вставить(Сотрудник, Истина);

КонецПроцедуры

// Закрепление работников за участками по документам производства, где указаны работники
// (рапорты, выработка сотрудников и т. п.): в шапке — участок, в строках — сотрудник.
// За месяц работник относится к участку, где он чаще всего указан; за год — запасной вариант.
Функция ЗакреплениеСотрудников(Данные, ТипСотрудника, Индекс)

	Результат = Новый Структура("ПоМесяцам, ПоГоду, Источники", Новый Соответствие, Новый Соответствие, Новый Массив);
	Если ТипСотрудника = Неопределено Или Индекс.Типы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	СчетчикиМесяцев = Новый Соответствие;
	СчетчикиГода = Новый Соответствие;
	Для Каждого МетаДок Из Метаданные.Документы Цикл
		РекУчастка = "";
		Для Каждого Вариант Из СтрРазделить("Подразделение,Участок,ПодразделениеДиспетчер,ПодразделениеИсполнитель", ",") Цикл
			Рек = МетаДок.Реквизиты.Найти(Вариант);
			Если Рек <> Неопределено И ТипСодержитОдинИз(Рек.Тип, Индекс.Типы) Тогда
				РекУчастка = Вариант;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если РекУчастка = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ТЧ Из МетаДок.ТабличныеЧасти Цикл
			РекСотрудника = "";
			Для Каждого Рек Из ТЧ.Реквизиты Цикл
				Если Рек.Тип.СодержитТип(ТипСотрудника) Тогда
					РекСотрудника = Рек.Имя;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если РекСотрудника = "" Тогда
				Продолжить;
			КонецЕсли;
			Условия = "Т.Ссылка.Проведен И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец";
			Если ЗначениеЗаполнено(Данные.Организация) И МетаДок.Реквизиты.Найти("Организация") <> Неопределено Тогда
				Условия = Условия + " И Т.Ссылка.Организация = &Организация";
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ) КАК Месяц,
				|	Т.Ссылка." + РекУчастка + " КАК Участок,
				|	Т." + РекСотрудника + " КАК Сотрудник,
				|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК Документов
				|ИЗ
				|	Документ." + МетаДок.Имя + "." + ТЧ.Имя + " КАК Т
				|ГДЕ
				|	" + Условия + "
				|СГРУППИРОВАТЬ ПО
				|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, МЕСЯЦ),
				|	Т.Ссылка." + РекУчастка + ",
				|	Т." + РекСотрудника;
			Запрос.УстановитьПараметр("Начало", Данные.Начало);
			Запрос.УстановитьПараметр("Конец", Данные.Конец);
			Запрос.УстановитьПараметр("Организация", Данные.Организация);
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Продолжить;
			КонецПопытки;
			Строк = 0;
			Пока Выборка.Следующий() Цикл
				ИндексМесяца = Данные.ИндексыМесяцев.Получить(Выборка.Месяц);
				Если ИндексМесяца = Неопределено Или НЕ ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
					Продолжить;
				КонецЕсли;
				Уч = УчастокИзСтруктуры(Выборка.Участок, Данные.Участки);
				Если Уч = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				КлючСотрудника = XMLСтрока(Выборка.Сотрудник);
				ДобавитьСчетчик(СчетчикиМесяцев, Строка(ИндексМесяца) + "|" + КлючСотрудника, Уч, Выборка.Документов);
				ДобавитьСчетчик(СчетчикиГода, КлючСотрудника, Уч, Выборка.Документов);
				Строк = Строк + 1;
			КонецЦикла;
			Если Строк > 0 Тогда
				Результат.Источники.Добавить(МетаДок.Синоним + "." + ТЧ.Синоним);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ВыбратьЧащеВсего(СчетчикиМесяцев, Результат.ПоМесяцам);
	ВыбратьЧащеВсего(СчетчикиГода, Результат.ПоГоду);
	Возврат Результат;

КонецФункции

Функция ТипСодержитОдинИз(ОписаниеТипов, Типы)

	Для Каждого ТипИЗначение Из Типы Цикл
		Если ОписаниеТипов.СодержитТип(ТипИЗначение.Ключ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Участок по подразделению структуры предприятия: оно само или ближайший родитель с выпуском.
Функция УчастокИзСтруктуры(Подразделение, Участки)

	Текущее = Подразделение;
	Для Уровень = 1 По 10 Цикл
		Если НЕ ЗначениеЗаполнено(Текущее) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Уч = Участки.Получить(Текущее);
		Если Уч <> Неопределено И Уч.ЕстьВыпуск Тогда
			Возврат Уч;
		КонецЕсли;
		Текущее = РодительСсылки(Текущее);
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура ДобавитьСчетчик(Счетчики, Ключ, Уч, Количество)

	ПоУчасткам = Счетчики.Получить(Ключ);
	Если ПоУчасткам = Неопределено Тогда
		ПоУчасткам = Новый Соответствие;
		Счетчики.Вставить(Ключ, ПоУчасткам);
	КонецЕсли;
	Было = ПоУчасткам.Получить(Уч);
	ПоУчасткам.Вставить(Уч, ?(Было = Неопределено, 0, Было) + Количество);

КонецПроцедуры

Процедура ВыбратьЧащеВсего(Счетчики, Результат)

	Для Каждого КлючИЗначение Из Счетчики Цикл
		Лучший = Неопределено;
		Максимум = 0;
		Для Каждого УчИЗначение Из КлючИЗначение.Значение Цикл
			Если УчИЗначение.Значение > Максимум Тогда
				Лучший = УчИЗначение.Ключ;
				Максимум = УчИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
		Если Лучший <> Неопределено Тогда
			Результат.Вставить(КлючИЗначение.Ключ, Лучший);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Зарплата общих работников цеха (числятся в цехе, по документам за участком не закреплены) распределяется
// по участкам цеха пропорционально выпуску участка в месяце (при разных единицах или без выпуска — поровну).
// Строка цеха из отчёта убирается, у участков видно «в т.ч. распределено с цеха».
Процедура РаспределитьЦеха(Данные)

	Для Проход = 1 По 10 Цикл
		Группы = Новый Массив;
		Для Каждого КлючИЗначение Из Данные.Участки Цикл
			Уч = КлючИЗначение.Значение;
			Если Уч.Члены <> Неопределено И Уч.Группа = Неопределено Тогда
				Группы.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
		Если Группы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Ключ Из Группы Цикл
			Цех = Данные.Участки.Получить(Ключ);
			Члены = Цех.Члены;
			ЕдиницыОдинаковые = Истина;
			Для Каждого Член Из Члены Цикл
				Если Член.Ед <> Члены[0].Ед Тогда
					ЕдиницыОдинаковые = Ложь;
				КонецЕсли;
			КонецЦикла;
			Для Индекс = 0 По 11 Цикл
				ВыпускЦеха = 0;
				Для Каждого Член Из Члены Цикл
					ВыпускЦеха = ВыпускЦеха + Член.Выпуск[Индекс];
				КонецЦикла;
				РаботниковЦеха = 0;
				Для Каждого РабИЗначение Из Цех.Работники[Индекс] Цикл
					Если РабИЗначение.Значение > 0 Тогда
						РаботниковЦеха = РаботниковЦеха + 1;
					КонецЕсли;
				КонецЦикла;
				РаботниковЦеха = РаботниковЦеха + Цех.ЧисленностьЦеха[Индекс];
				Для Каждого Член Из Члены Цикл
					Если ЕдиницыОдинаковые И ВыпускЦеха > 0 Тогда
						Доля = Член.Выпуск[Индекс] / ВыпускЦеха;
					Иначе
						Доля = 1 / Члены.Количество();
					КонецЕсли;
					Если Доля = 0 Тогда
						Продолжить;
					КонецЕсли;
					Член.ФОТ[Индекс] = Член.ФОТ[Индекс] + Цех.ФОТ[Индекс] * Доля;
					Член.Труд[Индекс] = Член.Труд[Индекс] + Цех.Труд[Индекс] * Доля;
					Член.ФОТЦеха[Индекс] = Член.ФОТЦеха[Индекс] + Цех.ФОТ[Индекс] * Доля;
					Член.ЧисленностьЦеха[Индекс] = Член.ЧисленностьЦеха[Индекс] + РаботниковЦеха * Доля;
					Для Каждого КатИЗначение Из Цех.Категории Цикл
						Член.Категории[КатИЗначение.Ключ][Индекс] = Член.Категории[КатИЗначение.Ключ][Индекс] + КатИЗначение.Значение[Индекс] * Доля;
					КонецЦикла;
					Для Каждого ВидИЗначение Из Цех.Виды Цикл
						СуммыВида = Член.Виды.Получить(ВидИЗначение.Ключ);
						Если СуммыВида = Неопределено Тогда
							СуммыВида = МассивНулей(12);
							Член.Виды.Вставить(ВидИЗначение.Ключ, СуммыВида);
						КонецЕсли;
						СуммыВида[Индекс] = СуммыВида[Индекс] + ВидИЗначение.Значение[Индекс] * Доля;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
			ИмяЦеха = Строка(Цех.Ссылка);
			Для Каждого Член Из Члены Цикл
				Член.Группа = Неопределено;
				Если СуммаМассива(Цех.ФОТ) <> 0 Тогда
					Член.ЦехИмя = ИмяЦеха;
					Член.Способы.Вставить("часть зарплаты цеха «" + ИмяЦеха + "» — пропорционально выпуску", Истина);
				КонецЕсли;
			КонецЦикла;
			Данные.Участки.Удалить(Ключ);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Детализация по каждому участку: работники с зарплатой по месяцам и выплаты (виды начислений) участка.
Процедура ВывестиДетализациюУчастков(Контекст, А, Данные)

	ВывестиЗаголовокРаздела(Контекст, "Детализация по участкам: работники и выплаты",
		"Работники — те, чья зарплата отнесена к участку (по документам производства или по подразделению). "
		+ "«Распределено с цеха» — доля зарплаты общих работников цеха. Выплаты — виды начислений участка, по убыванию суммы за год.");
	К = Контекст.КолонкаПослеМесяцев;
	Для Каждого Уч Из А.Участки Цикл
		НоваяСтрока(Контекст);
		УстановитьВысотуСтроки(Контекст, 30);
		ВывестиЯчейку(Контекст, 1, "№", "Ш");
		ВывестиЯчейку(Контекст, 2, Уч.Имя + ": работники", "Ш", 4);
		ВывестиШапкуМесяцев(Контекст, СтрРазделить("За год|Месяцев", "|"));
		ВывестиЯчейку(Контекст, К + 2, "Примечание", "Ш", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);

		// работники участка
		Т = Новый ТаблицаЗначений;
		Т.Колонки.Добавить("Сотрудник");
		Т.Колонки.Добавить("Суммы");
		Т.Колонки.Добавить("Итого");
		Т.Колонки.Добавить("Месяцев");
		ПоСотрудникам = Новый Соответствие;
		Для Индекс = 0 По 11 Цикл
			Для Каждого РабИЗначение Из Уч.Работники[Индекс] Цикл
				СтрокаТ = ПоСотрудникам.Получить(РабИЗначение.Ключ);
				Если СтрокаТ = Неопределено Тогда
					СтрокаТ = Т.Добавить();
					СтрокаТ.Сотрудник = РабИЗначение.Ключ;
					СтрокаТ.Суммы = МассивНулей(12);
					СтрокаТ.Итого = 0;
					СтрокаТ.Месяцев = 0;
					ПоСотрудникам.Вставить(РабИЗначение.Ключ, СтрокаТ);
				КонецЕсли;
				СтрокаТ.Суммы[Индекс] = СтрокаТ.Суммы[Индекс] + РабИЗначение.Значение;
				СтрокаТ.Итого = СтрокаТ.Итого + РабИЗначение.Значение;
				СтрокаТ.Месяцев = СтрокаТ.Месяцев + ?(РабИЗначение.Значение > 0, 1, 0);
			КонецЦикла;
		КонецЦикла;
		Т.Сортировать("Итого Убыв");
		Номер = 0;
		Для Каждого СтрокаТ Из Т Цикл
			Номер = Номер + 1;
			ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
			ВывестиЯчейку(Контекст, 2, Данные.Представления.Получить(СтрокаТ.Сотрудник), "Р", 4);
			ВывестиСуммыПоМесяцам(Контекст, СтрокаТ.Суммы);
			ВывестиЯчейку(Контекст, К, СтрокаТ.Итого, "РЖ");
			ВывестиЯчейку(Контекст, К + 1, СтрокаТ.Месяцев, "РЦ");
			ВывестиЯчейку(Контекст, К + 2, ?(СтрокаТ.Месяцев < 12, "начисления не во всех месяцах", ""), "РС", Контекст.ПоследняяКолонка);
			НоваяСтрока(Контекст);
		КонецЦикла;
		Если Т.Количество() = 0 Тогда
			ВывестиЯчейку(Контекст, 2, "Работников, закреплённых за участком, нет.", "РС", 4);
			НоваяСтрока(Контекст);
		КонецЕсли;
		Если СуммаМассива(Уч.ФОТЦеха) <> 0 Тогда
			ВывестиЯчейку(Контекст, 2, "Распределено с цеха «" + Уч.ЦехИмя + "»", "РС", 4);
			ВывестиСуммыПоМесяцам(Контекст, Уч.ФОТЦеха, "РС");
			ВывестиЯчейку(Контекст, К, СуммаМассива(Уч.ФОТЦеха), "РС");
			ВывестиЯчейку(Контекст, К + 1, Неопределено, "Р");
			ВывестиЯчейку(Контекст, К + 2, "общие работники цеха, пропорционально выпуску участка", "РС", Контекст.ПоследняяКолонка);
			НоваяСтрока(Контекст);
		КонецЕсли;
		ВывестиЯчейку(Контекст, 1, "", "И");
		ВывестиЯчейку(Контекст, 2, "ФОТ участка", "И", 4);
		ВывестиСуммыПоМесяцам(Контекст, Уч.ФОТ, "И");
		ВывестиЯчейку(Контекст, К, Уч.ФОТГод, "И");
		ВывестиЯчейку(Контекст, К + 1, Неопределено, "И");
		ВывестиЯчейку(Контекст, К + 2, "", "И", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);

		// выплаты участка
		Виды = Новый ТаблицаЗначений;
		Виды.Колонки.Добавить("Вид");
		Виды.Колонки.Добавить("Суммы");
		Виды.Колонки.Добавить("Итого");
		Для Каждого ВидИЗначение Из Уч.Виды Цикл
			СтрокаВида = Виды.Добавить();
			СтрокаВида.Вид = ВидИЗначение.Ключ;
			СтрокаВида.Суммы = ВидИЗначение.Значение;
			СтрокаВида.Итого = СуммаМассива(ВидИЗначение.Значение);
		КонецЦикла;
		Виды.Сортировать("Итого Убыв");
		Если Виды.Количество() > 0 Тогда
			ВывестиЯчейку(Контекст, 2, Уч.Имя + ": выплаты", "Ш", 3);
			ВывестиЯчейку(Контекст, 4, "Статья", "Ш");
			ВывестиШапкуМесяцев(Контекст, СтрРазделить("За год|Доля", "|"));
			ВывестиЯчейку(Контекст, К + 2, "Что происходило", "Ш", Контекст.ПоследняяКолонка);
			НоваяСтрока(Контекст);
			Для Каждого СтрокаВида Из Виды Цикл
				Если СтрокаВида.Итого = 0 Тогда
					Продолжить;
				КонецЕсли;
				ВывестиЯчейку(Контекст, 2, СтрокаВида.Вид, "Р", 3);
				ВывестиЯчейку(Контекст, 4, КатегорияНачисления(СтрокаВида.Вид), "РС");
				ВывестиСуммыПоМесяцам(Контекст, СтрокаВида.Суммы);
				ВывестиЯчейку(Контекст, К, СтрокаВида.Итого, "РЖ");
				ВывестиЯчейку(Контекст, К + 1, ДелениеИлиНеопределено(СтрокаВида.Итого * 100, Уч.ФОТГод), "Р%");
				ВывестиЯчейку(Контекст, К + 2, ПримечаниеКВыплате(СтрокаВида.Суммы, А.Месяцы), "Р", Контекст.ПоследняяКолонка);
				НоваяСтрока(Контекст);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

