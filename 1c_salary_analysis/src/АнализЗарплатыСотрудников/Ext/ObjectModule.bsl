Функция РассчитатьУчастки(Данные, ПорогИзменения)

	А = Новый Структура;
	А.Вставить("Месяцы", Данные.Месяцы);
	А.Вставить("ПорогИзменения", ПорогИзменения);
	ФОТНесопоставленный = 0;
	Для Каждого КлючИЗначение Из Данные.Несопоставленные Цикл
		ФОТНесопоставленный = ФОТНесопоставленный + КлючИЗначение.Значение.ФОТ;
	КонецЦикла;
	А.Вставить("ФОТНесопоставленный", ФОТНесопоставленный);
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Уч");
	Т.Колонки.Добавить("ФОТГод");
	Перекосы = НоваяТаблицаПерекосов();

	ФОТЗавода = МассивНулей(12);
	ТрудЗавода = МассивНулей(12);
	ВыпускЗавода = МассивНулей(12);
	ФОТСТоннами = МассивНулей(12);
	ЧисленностьЗавода = МассивНулей(12);

	Для Каждого КлючИЗначение Из Данные.Участки Цикл
		Уч = КлючИЗначение.Значение;
		Если СуммаМассива(Уч.ФОТ) = 0 И НЕ Уч.ЕстьВыпуск Тогда
			Продолжить;
		КонецЕсли;
		РассчитатьУчасток(Уч, Данные, ПорогИзменения, Перекосы);
		СтрокаТ = Т.Добавить();
		СтрокаТ.Уч = Уч;
		СтрокаТ.ФОТГод = Уч.ФОТГод;
		ДобавитьКМассиву(ФОТЗавода, Уч.ФОТ);
		ДобавитьКМассиву(ТрудЗавода, Уч.Труд);
		ДобавитьКМассиву(ЧисленностьЗавода, Уч.Численность);
		Если Уч.Ед = "т" Тогда
			ДобавитьКМассиву(ВыпускЗавода, Уч.Выпуск);
			ДобавитьКМассиву(ФОТСТоннами, Уч.ФОТ);
		КонецЕсли;
	КонецЦикла;
	Т.Сортировать("ФОТГод Убыв");
	Участки = Новый Массив;
	Для Каждого СтрокаТ Из Т Цикл
		Участки.Добавить(СтрокаТ.Уч);
	КонецЦикла;
	А.Вставить("Участки", Участки);

	Завод = Новый Структура;
	Завод.Вставить("ФОТ", ФОТЗавода);
	Завод.Вставить("Труд", ТрудЗавода);
	Завод.Вставить("Выпуск", ВыпускЗавода);
	Завод.Вставить("ФОТСТоннами", ФОТСТоннами);
	Завод.Вставить("Численность", ЧисленностьЗавода);
	Завод.Вставить("ФОТГод", СуммаМассива(ФОТЗавода));
	Завод.Вставить("ВыпускГод", СуммаМассива(ВыпускЗавода));
	Завод.Вставить("ФОТнаТонну", ПоложительноеОтношение(СуммаМассива(ФОТСТоннами), СуммаМассива(ВыпускЗавода)));
	ФОТнаТоннуПоМесяцам = Новый Массив;
	Для Индекс = 0 По 11 Цикл
		ФОТнаТоннуПоМесяцам.Добавить(ПоложительноеОтношение(ФОТСТоннами[Индекс], ВыпускЗавода[Индекс]));
	КонецЦикла;
	Завод.Вставить("ФОТнаТоннуПоМесяцам", ФОТнаТоннуПоМесяцам);
	Завод.Вставить("СредняяЗП", ПоложительноеОтношение(Завод.ФОТГод, СуммаМассива(ЧисленностьЗавода)));
	А.Вставить("Завод", Завод);

	// доли участков в ФОТ и выпуске (в тоннах), перекос «дорогой / дешёвый участок»
	Для Каждого Уч Из Участки Цикл
		Уч.Вставить("ДоляФОТ", ДелениеИлиНеопределено(Уч.ФОТГод * 100, Завод.ФОТГод));
		Уч.Вставить("ДоляВыпуска", ?(Уч.Ед = "т", ДелениеИлиНеопределено(Уч.ВыпускГод * 100, Завод.ВыпускГод), Неопределено));
		Если Уч.Ед = "т" И Завод.ФОТнаТонну <> Неопределено И Уч.ФОТнаЕдГод <> Неопределено И Участки.Количество() > 1 Тогда
			Уч.Вставить("ОтклОтЗавода", ПроцентОт(Уч.ФОТнаЕдГод, Завод.ФОТнаТонну));
		Иначе
			Уч.Вставить("ОтклОтЗавода", Неопределено);
		КонецЕсли;
		Уч.Вставить("ОтклЗПОтЗавода", ПроцентОт(Уч.СредняяЗПГод, Завод.СредняяЗП));
	КонецЦикла;

	Перекосы.Сортировать("Вес Убыв");
	А.Вставить("Перекосы", Перекосы);
	А.Вставить("Главное", ГлавноеПоУчасткам(А));
	Возврат А;

КонецФункции

Процедура РассчитатьУчасток(Уч, Данные, ПорогИзменения, Перекосы)

	Месяцы = Данные.Месяцы;
	Численность = МассивНулей(12);
	ФОТнаЕд = Новый Массив;
	СредняяЗП = Новый Массив;
	Выработка = Новый Массив;
	Для Индекс = 0 По 11 Цикл
		Количество = 0;
		Для Каждого РабИЗначение Из Уч.Работники[Индекс] Цикл
			Если РабИЗначение.Значение > 0 Тогда
				Количество = Количество + 1;
			КонецЕсли;
		КонецЦикла;
		Численность[Индекс] = Количество + Уч.ЧисленностьЦеха[Индекс];
		// зарплата участка вся пришла с цеха долей, а люди указаны в рапортах участка — берём их
		Если Численность[Индекс] < 1 И Уч.ЛюдиПоДокументам[Индекс] > Численность[Индекс] Тогда
			Численность[Индекс] = Уч.ЛюдиПоДокументам[Индекс];
		КонецЕсли;
		ФОТнаЕд.Добавить(?(Уч.Выпуск[Индекс] > 0 И Уч.ФОТ[Индекс] > 0, Уч.ФОТ[Индекс] / Уч.Выпуск[Индекс], Неопределено));
		СредняяЗП.Добавить(ДелениеИлиНеопределено(Уч.ФОТ[Индекс], Количество));
		Выработка.Добавить(?(Количество > 0 И Уч.ЕстьВыпуск, Уч.Выпуск[Индекс] / Количество, Неопределено));
	КонецЦикла;
	Уч.Вставить("Численность", Численность);
	Уч.Вставить("ФОТнаЕд", ФОТнаЕд);
	Уч.Вставить("СредняяЗП", СредняяЗП);
	Уч.Вставить("Выработка", Выработка);
	Уч.Вставить("ФОТГод", СуммаМассива(Уч.ФОТ));
	Уч.Вставить("ТрудГод", СуммаМассива(Уч.Труд));
	Уч.Вставить("ВыпускГод", СуммаМассива(Уч.Выпуск));
	МесяцевСРаботниками = 0;
	Для Каждого Значение Из Численность Цикл
		Если Значение > 0 Тогда
			МесяцевСРаботниками = МесяцевСРаботниками + 1;
		КонецЕсли;
	КонецЦикла;
	Уч.Вставить("ЧисленностьСредняя", ДелениеИлиНеопределено(СуммаМассива(Численность), МесяцевСРаботниками));
	Уч.Вставить("СредняяЗПГод", ПоложительноеОтношение(Уч.ФОТГод, СуммаМассива(Численность)));
	Уч.Вставить("ВыработкаГод", ?(Уч.ЕстьВыпуск, ДелениеИлиНеопределено(Уч.ВыпускГод, СуммаМассива(Численность)), Неопределено));
	Уч.Вставить("ФОТнаЕдГод", ?(Уч.ВыпускГод > 0 И Уч.ФОТГод > 0, Уч.ФОТГод / Уч.ВыпускГод, Неопределено));

	// второе полугодие к первому
	ФОТ1 = 0; ФОТ2 = 0; Вып1 = 0; Вып2 = 0;
	Для Индекс = 0 По 11 Цикл
		Если Индекс < 6 Тогда
			ФОТ1 = ФОТ1 + Уч.ФОТ[Индекс];
			Вып1 = Вып1 + Уч.Выпуск[Индекс];
		Иначе
			ФОТ2 = ФОТ2 + Уч.ФОТ[Индекс];
			Вып2 = Вып2 + Уч.Выпуск[Индекс];
		КонецЕсли;
	КонецЦикла;
	Уч.Вставить("ИзмФОТ", ПроцентИзменения(ФОТ1, ФОТ2));
	Уч.Вставить("ИзмВыпуска", ПроцентИзменения(Вып1, Вып2));
	Уч.Вставить("ИзмФОТнаЕд", ?(Вып1 > 0 И Вып2 > 0 И ФОТ1 > 0, ПроцентИзменения(ФОТ1 / Вып1, ФОТ2 / Вып2), Неопределено));

	// ФОТ на единицу: первый и последний квартал, самый дешёвый и дорогой месяц, динамика к прошлому месяцу
	ФОТК1 = 0; ВыпК1 = 0; ФОТК4 = 0; ВыпК4 = 0;
	Для Индекс = 0 По 2 Цикл
		ФОТК1 = ФОТК1 + Уч.ФОТ[Индекс];
		ВыпК1 = ВыпК1 + Уч.Выпуск[Индекс];
		ФОТК4 = ФОТК4 + Уч.ФОТ[Индекс + 9];
		ВыпК4 = ВыпК4 + Уч.Выпуск[Индекс + 9];
	КонецЦикла;
	Уч.Вставить("ФОТнаЕдК1", ПоложительноеОтношение(ФОТК1, ВыпК1));
	Уч.Вставить("ФОТнаЕдК4", ПоложительноеОтношение(ФОТК4, ВыпК4));
	Уч.Вставить("ИзмФОТнаЕдКв", ?(Уч.ФОТнаЕдК1 = Неопределено Или Уч.ФОТнаЕдК4 = Неопределено, Неопределено,
		ПроцентИзменения(Уч.ФОТнаЕдК1, Уч.ФОТнаЕдК4)));
	МинМесяц = ""; МаксМесяц = ""; Минимум = Неопределено; Максимум = Неопределено;
	КПрошлому = Новый Массив;
	КСреднему = Новый Массив;
	ФОТКПрошлому = Новый Массив;
	ВыпускКПрошлому = Новый Массив;
	Для Индекс = 0 По 11 Цикл
		Значение = ФОТнаЕд[Индекс];
		Если Значение <> Неопределено Тогда
			Если Минимум = Неопределено Или Значение < Минимум Тогда
				Минимум = Значение;
				МинМесяц = ИмяМесяца(Месяцы[Индекс]);
			КонецЕсли;
			Если Максимум = Неопределено Или Значение > Максимум Тогда
				Максимум = Значение;
				МаксМесяц = ИмяМесяца(Месяцы[Индекс]);
			КонецЕсли;
		КонецЕсли;
		КПрошлому.Добавить(?(Индекс = 0 Или Значение = Неопределено Или ФОТнаЕд[Индекс - 1] = Неопределено, Неопределено,
			ПроцентИзменения(ФОТнаЕд[Индекс - 1], Значение)));
		КСреднему.Добавить(ПроцентОт(Значение, Уч.ФОТнаЕдГод));
		ФОТКПрошлому.Добавить(?(Индекс = 0, Неопределено, ПроцентИзменения(Уч.ФОТ[Индекс - 1], Уч.ФОТ[Индекс])));
		ВыпускКПрошлому.Добавить(?(Индекс = 0, Неопределено, ПроцентИзменения(Уч.Выпуск[Индекс - 1], Уч.Выпуск[Индекс])));
	КонецЦикла;
	Уч.Вставить("ФОТнаЕдМин", ?(Минимум = Неопределено, "", ФорматСуммы(Минимум) + " (" + МинМесяц + ")"));
	Уч.Вставить("ФОТнаЕдМакс", ?(Максимум = Неопределено, "", ФорматСуммы(Максимум) + " (" + МаксМесяц + ")"));
	Уч.Вставить("ФОТнаЕдКПрошлому", КПрошлому);
	Уч.Вставить("ФОТнаЕдКСреднему", КСреднему);
	Уч.Вставить("ФОТКПрошлому", ФОТКПрошлому);
	Уч.Вставить("ВыпускКПрошлому", ВыпускКПрошлому);
	Уч.Вставить("ПоследнийККПрошлому", КПрошлому[11]);

	Связь = Корреляция(Уч.ФОТ, Уч.Выпуск);
	Уч.Вставить("Связь", Связь);
	Уч.Вставить("ТекстСвязи", ТекстСвязи(Связь));

	// --- перекосы ---
	Если Уч.ФОТГод > 0 И НЕ Уч.ЕстьВыпуск Тогда
		ДобавитьПерекос(Перекосы, Уч, "год", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
			"ФОТ " + ФорматСуммы(Уч.ФОТГод) + " руб. за год, а выпуска в рапортах по участку нет: производственное подразделение "
			+ "без рапортов, выпуск оформляется на другое подразделение или это вспомогательный персонал.", 1000);
	КонецЕсли;
	Если Уч.ЕстьВыпуск И Уч.ФОТГод = 0 Тогда
		ДобавитьПерекос(Перекосы, Уч, "год", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
			"Выпуск " + Формат(Уч.ВыпускГод, "ЧДЦ=1; ЧН=0") + " " + Уч.Ед + " за год, а зарплаты на участке нет: работники числятся "
			+ "в другом подразделении (проверьте подразделение в кадровых документах и в рапортах).", 900);
	КонецЕсли;
	Если Уч.ИзмФОТнаЕд <> Неопределено И Макс(Уч.ИзмФОТнаЕд, -Уч.ИзмФОТнаЕд) >= ПорогИзменения Тогда
		ДобавитьПерекос(Перекосы, Уч, "2-е полугодие", Неопределено, Неопределено, Уч.ИзмФОТнаЕд, Уч.ИзмВыпуска, Уч.ИзмФОТ,
			"ФОТ на " + Уч.Ед + " за второе полугодие " + ?(Уч.ИзмФОТнаЕд > 0, "вырос", "снизился") + " на "
			+ ПредставлениеПроцента(Макс(Уч.ИзмФОТнаЕд, -Уч.ИзмФОТнаЕд)) + ": ФОТ " + ПредставлениеПроцента(Уч.ИзмФОТ, Истина)
			+ ", выпуск " + ПредставлениеПроцента(Уч.ИзмВыпуска, Истина) + " к первому полугодию. "
			+ ?(Уч.ИзмФОТнаЕд > 0, "Зарплата растёт быстрее выпуска.", "Выпуск растёт быстрее зарплаты."), 500 + Макс(Уч.ИзмФОТнаЕд, -Уч.ИзмФОТнаЕд));
	КонецЕсли;

	Если Уч.ФОТнаЕдГод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МесяцевСВыпуском = 0;
	Для Индекс = 0 По 11 Цикл
		Если Уч.Выпуск[Индекс] > 0 Тогда
			МесяцевСВыпуском = МесяцевСВыпуском + 1;
		КонецЕсли;
	КонецЦикла;
	СреднийВыпуск = ДелениеИлиНеопределено(Уч.ВыпускГод, МесяцевСВыпуском);
	СреднийФОТ = ДелениеИлиНеопределено(Уч.ФОТГод, МесяцевСРаботниками);
	Для Индекс = 0 По 11 Цикл
		Если Уч.ФОТ[Индекс] > 0 И Уч.Выпуск[Индекс] <= 0 И МесяцевСВыпуском > 0 Тогда
			ДобавитьПерекос(Перекосы, Уч, ИмяМесяца(Месяцы[Индекс]), Неопределено, Уч.ФОТнаЕдГод, Неопределено, -100, ПроцентОт(Уч.ФОТ[Индекс], СреднийФОТ),
				"Зарплата " + ФорматСуммы(Уч.ФОТ[Индекс]) + " руб., а выпуска нет: простой, ремонт или рапорты не оформлены.", 300);
			Продолжить;
		КонецЕсли;
		Значение = ФОТнаЕд[Индекс];
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Откл = ПроцентОт(Значение, Уч.ФОТнаЕдГод);
		Если Откл = Неопределено Или Макс(Откл, -Откл) < ПорогИзменения Тогда
			Продолжить;
		КонецЕсли;
		ОтклВыпуска = ПроцентОт(Уч.Выпуск[Индекс], СреднийВыпуск);
		ОтклФОТ = ПроцентОт(Уч.ФОТ[Индекс], СреднийФОТ);
		ДобавитьПерекос(Перекосы, Уч, ИмяМесяца(Месяцы[Индекс]), Значение, Уч.ФОТнаЕдГод, Откл, ОтклВыпуска, ОтклФОТ,
			ОбъяснениеПерекоса(Уч, Индекс, Откл, ОтклВыпуска, ОтклФОТ, ПорогИзменения, Данные, МесяцевСРаботниками), Макс(Откл, -Откл));
	КонецЦикла;

КонецПроцедуры

Функция ОбъяснениеПерекоса(Уч, Индекс, Откл, ОтклВыпуска, ОтклФОТ, ПорогИзменения, Данные, МесяцевСРаботниками)

	Части = Новый Массив;
	Если Откл > 0 Тогда
		Если ОтклВыпуска <> Неопределено И ОтклВыпуска <= -ПорогИзменения / 2 И ОтклФОТ <> Неопределено И ОтклФОТ > -ПорогИзменения / 2 Тогда
			Части.Добавить("выпуск ниже среднего на " + ПредставлениеПроцента(-ОтклВыпуска) + ", а ФОТ почти не снизился — оплата не зависит от выпуска (оклады, повременка) или простой");
		ИначеЕсли ОтклФОТ <> Неопределено И ОтклФОТ >= ПорогИзменения / 2 Тогда
			Части.Добавить("ФОТ выше среднего месяца на " + ПредставлениеПроцента(ОтклФОТ) + " при выпуске " + ПредставлениеПроцента(ОтклВыпуска, Истина) + " к среднему");
		Иначе
			Части.Добавить("ФОТ " + ПредставлениеПроцента(ОтклФОТ, Истина) + ", выпуск " + ПредставлениеПроцента(ОтклВыпуска, Истина) + " к среднему месяцу");
		КонецЕсли;
	Иначе
		Если ОтклВыпуска <> Неопределено И ОтклВыпуска >= ПорогИзменения / 2 Тогда
			Части.Добавить("выпуск выше среднего на " + ПредставлениеПроцента(ОтклВыпуска) + ", ФОТ " + ПредставлениеПроцента(ОтклФОТ, Истина) + " — на единицу дешевле");
		Иначе
			Части.Добавить("ФОТ ниже среднего месяца на " + ПредставлениеПроцента(-ОтклФОТ) + " при выпуске " + ПредставлениеПроцента(ОтклВыпуска, Истина) + " к среднему");
		КонецЕсли;
	КонецЕсли;

	// какая статья дала отклонение ФОТ от среднего месяца
	ЛучшаяКатегория = "";
	ЛучшаяРазница = 0;
	Для Каждого КатИЗначение Из Уч.Категории Цикл
		Среднее = ДелениеИлиНеопределено(СуммаМассива(КатИЗначение.Значение), МесяцевСРаботниками);
		Если Среднее = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Разница = КатИЗначение.Значение[Индекс] - Среднее;
		Если Макс(Разница, -Разница) > Макс(ЛучшаяРазница, -ЛучшаяРазница) Тогда
			ЛучшаяКатегория = КатИЗначение.Ключ;
			ЛучшаяРазница = Разница;
		КонецЕсли;
	КонецЦикла;
	Если ЛучшаяКатегория <> "" И Макс(ЛучшаяРазница, -ЛучшаяРазница) >= 1000 Тогда
		Части.Добавить("в ФОТ сильнее всего отличаются " + НРег(ЛучшаяКатегория) + ": " + ФорматСуммы(ЛучшаяРазница, Истина) + " руб. к среднему месяцу");
	КонецЕсли;

	// кто из работников дал отклонение (сумма в месяце против своей средней по участку)
	Если Откл > 0 Тогда
		Т = НоваяТаблицаИзменений();
		Для Каждого РабИЗначение Из Уч.Работники[Индекс] Цикл
			Всего = 0;
			Месяцев = 0;
			Для Каждого Работники Из Уч.Работники Цикл
				Сумма = Работники.Получить(РабИЗначение.Ключ);
				Если Сумма <> Неопределено И Сумма > 0 Тогда
					Всего = Всего + Сумма;
					Месяцев = Месяцев + 1;
				КонецЕсли;
			КонецЦикла;
			Если Месяцев > 1 Тогда
				ДобавитьИзменение(Т, Данные.Представления.Получить(РабИЗначение.Ключ), "", Всего / Месяцев, РабИЗначение.Значение, "");
			КонецЕсли;
		КонецЦикла;
		Т.Сортировать("Разница Убыв");
		Люди = Новый Массив;
		Для Каждого СтрокаИзм Из Т Цикл
			Если Люди.Количество() >= 2 Или СтрокаИзм.Разница < 3000 Тогда
				Прервать;
			КонецЕсли;
			Люди.Добавить(СтрокаИзм.Имя + " " + ФорматСуммы(СтрокаИзм.Разница, Истина));
		КонецЦикла;
		Если Люди.Количество() > 0 Тогда
			Части.Добавить("больше обычного получили: " + СтрСоединить(Люди, ", ") + " руб.");
		КонецЕсли;
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ") + ".";

КонецФункции

Функция НоваяТаблицаПерекосов()

	Т = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить("Участок,Месяц,Значение,Среднее,Откл,ОтклВыпуска,ОтклФОТ,Текст,Вес,Ед", ",") Цикл
		Т.Колонки.Добавить(Колонка);
	КонецЦикла;
	Возврат Т;

КонецФункции

Процедура ДобавитьПерекос(Перекосы, Уч, Месяц, Значение, Среднее, Откл, ОтклВыпуска, ОтклФОТ, Текст, Вес)

	СтрокаП = Перекосы.Добавить();
	СтрокаП.Участок = Уч.Имя;
	СтрокаП.Ед = Уч.Ед;
	СтрокаП.Месяц = Месяц;
	СтрокаП.Значение = Значение;
	СтрокаП.Среднее = Среднее;
	СтрокаП.Откл = Откл;
	СтрокаП.ОтклВыпуска = ОтклВыпуска;
	СтрокаП.ОтклФОТ = ОтклФОТ;
	СтрокаП.Текст = Текст;
	СтрокаП.Вес = Вес;

КонецПроцедуры

Функция ГлавноеПоУчасткам(А)

	Главное = Новый Массив;
	Завод = А.Завод;
	Если А.ФОТНесопоставленный > 0 Тогда
		Главное.Добавить(СтрШаблон("К участкам привязано %1 руб. зарплаты; ещё %2 руб. — в подразделениях, не сопоставленных с участками "
			+ "(офис, службы или участки под другим названием) — список в конце отчёта.",
			ФорматСуммы(Завод.ФОТГод), ФорматСуммы(А.ФОТНесопоставленный)));
	КонецЕсли;
	Главное.Добавить(СтрШаблон("Производственных участков: %1. ФОТ их работников за 12 месяцев — %2 руб., в среднем %3 чел. в месяц, средняя зарплата %4 руб.",
		А.Участки.Количество(), ФорматСуммы(Завод.ФОТГод), Формат(СуммаМассива(Завод.Численность) / 12, "ЧДЦ=0; ЧН=0"),
		ФорматСуммы(?(Завод.СредняяЗП = Неопределено, 0, Завод.СредняяЗП))));
	Если Завод.ФОТнаТонну <> Неопределено Тогда
		Первые = Новый Массив;
		Последние = Новый Массив;
		ФОТ1 = 0; Вып1 = 0; ФОТ2 = 0; Вып2 = 0;
		Для Индекс = 0 По 2 Цикл
			ФОТ1 = ФОТ1 + Завод.ФОТСТоннами[Индекс];
			Вып1 = Вып1 + Завод.Выпуск[Индекс];
			ФОТ2 = ФОТ2 + Завод.ФОТСТоннами[Индекс + 9];
			Вып2 = Вып2 + Завод.Выпуск[Индекс + 9];
		КонецЦикла;
		Текст = СтрШаблон("Выпуск участков (в тоннах) — %1 т, ФОТ на тонну — %2 руб.",
			Формат(Завод.ВыпускГод, "ЧДЦ=1; ЧН=0"), ФорматСуммы(Завод.ФОТнаТонну));
		Если Вып1 > 0 И Вып2 > 0 Тогда
			Текст = Текст + СтрШаблон(" Последний квартал к первому: ФОТ на тонну %1 → %2 руб. (%3), выпуск %4, ФОТ %5.",
				ФорматСуммы(ФОТ1 / Вып1), ФорматСуммы(ФОТ2 / Вып2), ПредставлениеПроцента(ПроцентИзменения(ФОТ1 / Вып1, ФОТ2 / Вып2), Истина),
				ПредставлениеПроцента(ПроцентИзменения(Вып1, Вып2), Истина), ПредставлениеПроцента(ПроцентИзменения(ФОТ1, ФОТ2), Истина));
		КонецЕсли;
		Главное.Добавить(Текст);
		Связь = Корреляция(Завод.ФОТСТоннами, Завод.Выпуск);
		Главное.Добавить("Связь ФОТ участков с выпуском по месяцам: " + ТекстСвязи(Связь) + ".");
	КонецЕсли;

	// самые дорогие и дешёвые на тонну (только участки в тоннах)
	Дорогие = Новый Массив;
	Дешевые = Новый Массив;
	Для Каждого Уч Из А.Участки Цикл
		Если Уч.ОтклОтЗавода <> Неопределено И Уч.ОтклОтЗавода >= 30 Тогда
			Дорогие.Добавить("«" + Уч.Имя + "» " + ФорматСуммы(Уч.ФОТнаЕдГод) + " руб./т (" + ПредставлениеПроцента(Уч.ОтклОтЗавода, Истина) + ")");
		ИначеЕсли Уч.ОтклОтЗавода <> Неопределено И Уч.ОтклОтЗавода <= -30 Тогда
			Дешевые.Добавить("«" + Уч.Имя + "» " + ФорматСуммы(Уч.ФОТнаЕдГод) + " руб./т (" + ПредставлениеПроцента(Уч.ОтклОтЗавода, Истина) + ")");
		КонецЕсли;
	КонецЦикла;
	Если Дорогие.Количество() > 0 Тогда
		Главное.Добавить("ФОТ на тонну выше среднего по участкам больше чем на 30%: " + СтрСоединить(Дорогие, ", ")
			+ ". Сравнивайте с учётом продукции: трудоёмкость у участков разная.");
	КонецЕсли;
	Если Дешевые.Количество() > 0 Тогда
		Главное.Добавить("ФОТ на тонну ниже среднего больше чем на 30%: " + СтрСоединить(Дешевые, ", ") + ".");
	КонецЕсли;

	Растут = Новый Массив;
	Для Каждого Уч Из А.Участки Цикл
		Если Уч.ИзмФОТнаЕд <> Неопределено И Уч.ИзмФОТнаЕд >= А.ПорогИзменения Тогда
			Растут.Добавить("«" + Уч.Имя + "» " + ПредставлениеПроцента(Уч.ИзмФОТнаЕд, Истина) + " (ФОТ " + ПредставлениеПроцента(Уч.ИзмФОТ, Истина)
				+ ", выпуск " + ПредставлениеПроцента(Уч.ИзмВыпуска, Истина) + ")");
		КонецЕсли;
	КонецЦикла;
	Если Растут.Количество() > 0 Тогда
		Главное.Добавить("Зарплата на единицу выпуска выросла во втором полугодии больше порога: " + СтрСоединить(Растут, "; ") + ".");
	КонецЕсли;

	НеЗависят = Новый Массив;
	Для Каждого Уч Из А.Участки Цикл
		Если Уч.Связь <> Неопределено И Уч.Связь < 0.3 Тогда
			НеЗависят.Добавить("«" + Уч.Имя + "»");
		КонецЕсли;
	КонецЦикла;
	Если НеЗависят.Количество() > 0 Тогда
		Главное.Добавить("ФОТ почти не зависит от выпуска (оклады, повременка): " + СтрСоединить(НеЗависят, ", ")
			+ ". При падении выпуска ФОТ на единицу здесь растёт сильнее всего.");
	КонецЕсли;

	Без = Новый Массив;
	Для Каждого Уч Из А.Участки Цикл
		Если НЕ Уч.ЕстьВыпуск Тогда
			Без.Добавить("«" + Уч.Имя + "»");
		КонецЕсли;
	КонецЦикла;
	Если Без.Количество() > 0 Тогда
		Главное.Добавить("Производственные подразделения с зарплатой, но без выпуска в рапортах: " + СтрСоединить(Без, ", ") + ".");
	КонецЕсли;
	Главное.Добавить("Найдено перекосов: " + А.Перекосы.Количество() + " — список ниже, самые сильные сверху.");
	Возврат Главное;

КонецФункции

Процедура ВывестиСводкуУчастков(Контекст, А)

	ВывестиЗаголовокРаздела(Контекст, "Участки за год",
		"Средняя зарплата и выработка — на одного работника с начислениями в месяц. «2-е пол. к 1-му» — изменение ФОТ на единицу выпуска. "
		+ "Связь — насколько ФОТ участка следует за выпуском по месяцам.");
	УстановитьВысотуСтроки(Контекст, 42);
	К = Контекст.КолонкаМесяцев;
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, "Участок", "Ш", 4);
	Заголовки = СтрРазделить("Работников в месяц|ФОТ за год, руб.|в т.ч. оплата труда|Выпуск за год|Ед.|ФОТ на ед. за год, руб.|ФОТ на ед.: 2-е пол. к 1-му|Средняя зарплата|Выпуск на работника в месяц|ФОТ на ед. к среднему по участкам|Доля ФОТ|Доля выпуска|ФОТ на ед.: первый квартал|ФОТ на ед.: последний квартал|Последний квартал к первому|Последний месяц к прошлому|Самый дешёвый месяц|Самый дорогой месяц", "|");
	Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
		ВывестиЯчейку(Контекст, К + Индекс, Заголовки[Индекс], "Ш");
	КонецЦикла;
	ВывестиЯчейку(Контекст, К + 18, "Связь ФОТ с выпуском", "Ш", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

	Номер = 0;
	Для Каждого Уч Из А.Участки Цикл
		Номер = Номер + 1;
		ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
		ВывестиЯчейку(Контекст, 2, Уч.Имя, "РЖ", 4);
		ВывестиЯчейку(Контекст, К, Уч.ЧисленностьСредняя, "Р1");
		ВывестиЯчейку(Контекст, К + 1, Уч.ФОТГод, "Р");
		ВывестиЯчейку(Контекст, К + 2, Уч.ТрудГод, "Р");
		ВывестиЯчейку(Контекст, К + 3, ?(Уч.ЕстьВыпуск, Уч.ВыпускГод, Неопределено), "Р");
		ВывестиЯчейку(Контекст, К + 4, Уч.Ед + ?(Уч.ПрочиеЕд = "", "", " (+" + Уч.ПрочиеЕд + ")"), "Р");
		ВывестиЯчейку(Контекст, К + 5, Уч.ФОТнаЕдГод, "РЖ");
		Сильно = Уч.ИзмФОТнаЕд <> Неопределено И Макс(Уч.ИзмФОТнаЕд, -Уч.ИзмФОТнаЕд) >= А.ПорогИзменения;
		ВывестиЯчейку(Контекст, К + 6, Уч.ИзмФОТнаЕд, "Р%+" + ?(Сильно, "!", ""));
		ВывестиЯчейку(Контекст, К + 7, Уч.СредняяЗПГод, "Р");
		ВывестиЯчейку(Контекст, К + 8, Уч.ВыработкаГод, "Р");
		Дорогой = Уч.ОтклОтЗавода <> Неопределено И Макс(Уч.ОтклОтЗавода, -Уч.ОтклОтЗавода) >= 30;
		ВывестиЯчейку(Контекст, К + 9, Уч.ОтклОтЗавода, "Р%+" + ?(Дорогой, "!", ""));
		ВывестиЯчейку(Контекст, К + 10, Уч.ДоляФОТ, "Р%");
		ВывестиЯчейку(Контекст, К + 11, Уч.ДоляВыпуска, "Р%");
		ВывестиЯчейку(Контекст, К + 12, Уч.ФОТнаЕдК1, "Р");
		ВывестиЯчейку(Контекст, К + 13, Уч.ФОТнаЕдК4, "Р");
		СильноКв = Уч.ИзмФОТнаЕдКв <> Неопределено И Макс(Уч.ИзмФОТнаЕдКв, -Уч.ИзмФОТнаЕдКв) >= А.ПорогИзменения;
		ВывестиЯчейку(Контекст, К + 14, Уч.ИзмФОТнаЕдКв, "Р%+" + ?(СильноКв, "!", ""));
		ВывестиЯчейку(Контекст, К + 15, Уч.ПоследнийККПрошлому, "Р%+");
		ВывестиЯчейку(Контекст, К + 16, Уч.ФОТнаЕдМин, "Р");
		ВывестиЯчейку(Контекст, К + 17, Уч.ФОТнаЕдМакс, "Р");
		ВывестиЯчейку(Контекст, К + 18, Уч.ТекстСвязи, "Р", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);
	КонецЦикла;

	Завод = А.Завод;
	ВывестиЯчейку(Контекст, 1, "", "И");
	ВывестиЯчейку(Контекст, 2, "Все участки", "И", 4);
	ВывестиЯчейку(Контекст, К, СуммаМассива(Завод.Численность) / 12, "И1");
	ВывестиЯчейку(Контекст, К + 1, Завод.ФОТГод, "И");
	ВывестиЯчейку(Контекст, К + 2, СуммаМассива(Завод.Труд), "И");
	ВывестиЯчейку(Контекст, К + 3, ?(Завод.ВыпускГод > 0, Завод.ВыпускГод, Неопределено), "И");
	ВывестиЯчейку(Контекст, К + 4, ?(Завод.ВыпускГод > 0, "т", ""), "И");
	ВывестиЯчейку(Контекст, К + 5, Завод.ФОТнаТонну, "И");
	ВывестиЯчейку(Контекст, К + 6, Неопределено, "И");
	ВывестиЯчейку(Контекст, К + 7, Завод.СредняяЗП, "И");
	Для Индекс = 8 По 17 Цикл
		ВывестиЯчейку(Контекст, К + Индекс, Неопределено, "И");
	КонецЦикла;
	ВывестиЯчейку(Контекст, К + 18, "", "И", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

КонецПроцедуры

Процедура ВывестиПерекосыУчастков(Контекст, А)

	Т = А.Перекосы;
	ВывестиЗаголовокРаздела(Контекст, "Перекосы: где зарплата не соответствует выпуску (" + Т.Количество() + ")",
		"Месяцы, когда ФОТ на единицу выпуска отличается от среднего за год по участку больше порога, рост ФОТ на единицу "
		+ "во втором полугодии, зарплата без выпуска и выпуск без зарплаты. Отклонения выпуска и ФОТ — к среднему месяцу участка.");
	Если Т.Количество() = 0 Тогда
		ВывестиЯчейку(Контекст, 2, "Перекосов больше порога нет.", "С");
		НоваяСтрока(Контекст);
		Возврат;
	КонецЕсли;
	К = Контекст.КолонкаМесяцев;
	УстановитьВысотуСтроки(Контекст, 42);
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, "Участок", "Ш", 3);
	ВывестиЯчейку(Контекст, 4, "Когда", "Ш");
	Заголовки = СтрРазделить("ФОТ на ед. в месяце|ФОТ на ед. за год|Отклонение ФОТ на ед.|Выпуск к среднему месяцу|ФОТ к среднему месяцу", "|");
	Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
		ВывестиЯчейку(Контекст, К + Индекс, Заголовки[Индекс], "Ш");
	КонецЦикла;
	ВывестиЯчейку(Контекст, К + 5, "Что видно и что проверить", "Ш", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

	Номер = 0;
	Для Каждого СтрокаП Из Т Цикл
		Номер = Номер + 1;
		ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
		ВывестиЯчейку(Контекст, 2, СтрокаП.Участок, "РП", 3);
		ВывестиЯчейку(Контекст, 4, СтрокаП.Месяц, "РП");
		ВывестиЯчейку(Контекст, К, СтрокаП.Значение, "Р");
		ВывестиЯчейку(Контекст, К + 1, СтрокаП.Среднее, "Р");
		ВывестиЯчейку(Контекст, К + 2, СтрокаП.Откл, "РЖ%+");
		ВывестиЯчейку(Контекст, К + 3, СтрокаП.ОтклВыпуска, "Р%+");
		ВывестиЯчейку(Контекст, К + 4, СтрокаП.ОтклФОТ, "Р%+");
		ВывестиЯчейку(Контекст, К + 5, СтрокаП.Текст, "РП", Контекст.ПоследняяКолонка);
		ВысотаТекста = Цел(СтрДлина(СтрокаП.Текст) / 150) + 1;
		Если ВысотаТекста > 1 Тогда
			УстановитьВысотуСтроки(Контекст, 12 * ВысотаТекста);
		КонецЕсли;
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиУчасткиПомесячно(Контекст, А)

	ВывестиЗаголовокРаздела(Контекст, "Участки по месяцам",
		"Оранжевым — месяцы, когда ФОТ на единицу выпуска отличается от среднего за год больше порога.");
	К = Контекст.КолонкаПослеМесяцев;

	// все участки вместе (выпуск и ФОТ на тонну — по участкам, где выпуск в тоннах)
	Завод = А.Завод;
	Если Завод.ФОТнаТонну <> Неопределено Тогда
		НоваяСтрока(Контекст);
		УстановитьВысотуСтроки(Контекст, 30);
		ВывестиЯчейку(Контекст, 2, "Все участки", "Ш", 4);
		ВывестиШапкуМесяцев(Контекст, СтрРазделить("За год|2-е пол. к 1-му", "|"));
		ВывестиЯчейку(Контекст, К + 2, "Примечание", "Ш", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);
		ФОТ1 = 0; ФОТ2 = 0; Вып1 = 0; Вып2 = 0; ВесьФОТ1 = 0; ВесьФОТ2 = 0;
		Для Индекс = 0 По 5 Цикл
			ВесьФОТ1 = ВесьФОТ1 + Завод.ФОТ[Индекс];
			ВесьФОТ2 = ВесьФОТ2 + Завод.ФОТ[Индекс + 6];
			ФОТ1 = ФОТ1 + Завод.ФОТСТоннами[Индекс];
			Вып1 = Вып1 + Завод.Выпуск[Индекс];
			ФОТ2 = ФОТ2 + Завод.ФОТСТоннами[Индекс + 6];
			Вып2 = Вып2 + Завод.Выпуск[Индекс + 6];
		КонецЦикла;
		ВывестиСтрокуУчастка(Контекст, "ФОТ участков, руб.", Завод.ФОТ, Завод.ФОТГод, ПроцентИзменения(ВесьФОТ1, ВесьФОТ2), "все участки", "Ж");
		ВывестиСтрокуУчастка(Контекст, "Выпуск, т", Завод.Выпуск, Завод.ВыпускГод, ПроцентИзменения(Вып1, Вып2), "участки с выпуском в тоннах", "Ж");
		ВывестиСтрокуУчастка(Контекст, "ФОТ на т, руб.", Завод.ФОТнаТоннуПоМесяцам, Завод.ФОТнаТонну,
			?(Вып1 > 0 И Вып2 > 0 И ФОТ1 > 0, ПроцентИзменения(ФОТ1 / Вып1, ФОТ2 / Вып2), Неопределено), "ФОТ участков в тоннах / выпуск", "Ж");
		КПрошлому = Новый Массив;
		КСреднему = Новый Массив;
		Для Индекс = 0 По 11 Цикл
			Значение = Завод.ФОТнаТоннуПоМесяцам[Индекс];
			КПрошлому.Добавить(?(Индекс = 0 Или Значение = Неопределено Или Завод.ФОТнаТоннуПоМесяцам[Индекс - 1] = Неопределено, Неопределено,
				ПроцентИзменения(Завод.ФОТнаТоннуПоМесяцам[Индекс - 1], Значение)));
			КСреднему.Добавить(ПроцентОт(Значение, Завод.ФОТнаТонну));
		КонецЦикла;
		ВывестиСтрокуПроцентов(Контекст, "   ФОТ на т к прошлому месяцу", КПрошлому, Неопределено, "", А.ПорогИзменения);
		ВывестиСтрокуПроцентов(Контекст, "   ФОТ на т к среднему за год", КСреднему, Неопределено, "оранжевым — больше порога", А.ПорогИзменения);
		ВывестиСтрокуУчастка(Контекст, "Работников", Завод.Численность, СуммаМассива(Завод.Численность) / 12, Неопределено, "за год — в среднем в месяц", "1");
	КонецЕсли;

	Для Каждого Уч Из А.Участки Цикл
		НоваяСтрока(Контекст);
		УстановитьВысотуСтроки(Контекст, 30);
		ВывестиЯчейку(Контекст, 2, Уч.Имя, "Ш", 4);
		ВывестиШапкуМесяцев(Контекст, СтрРазделить("За год|2-е пол. к 1-му", "|"));
		ВывестиЯчейку(Контекст, К + 2, "Примечание", "Ш", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);

		ВывестиСтрокуУчастка(Контекст, "ФОТ, руб.", Уч.ФОТ, Уч.ФОТГод, Уч.ИзмФОТ, "", "Ж");
		ВывестиСтрокуУчастка(Контекст, "в т.ч. оплата труда (оклад, доплаты, премии)", Уч.Труд, Уч.ТрудГод, Неопределено, "", "");
		Если СуммаМассива(Уч.ФОТЦеха) <> 0 Тогда
			ВывестиСтрокуУчастка(Контекст, "в т.ч. распределено с цеха «" + Уч.ЦехИмя + "»", Уч.ФОТЦеха, СуммаМассива(Уч.ФОТЦеха), Неопределено,
				"общие работники цеха — пропорционально выпуску участка", "С");
		КонецЕсли;
		Прочее = МассивНулей(12);
		ДобавитьКМассиву(Прочее, Уч.Категории["Отпускные и компенсации отпуска"]);
		ДобавитьКМассиву(Прочее, Уч.Категории["Больничные и пособия"]);
		ВывестиСтрокуУчастка(Контекст, "отпускные, больничные и пособия", Прочее, СуммаМассива(Прочее), Неопределено, "", "");
		Если Уч.ЕстьВыпуск Тогда
			ВывестиСтрокуУчастка(Контекст, "Выпуск, " + Уч.Ед, Уч.Выпуск, Уч.ВыпускГод, Уч.ИзмВыпуска,
				?(Уч.ПрочиеЕд = "", "", "ещё в других единицах: " + Уч.ПрочиеЕд), "Ж");
			// ФОТ на единицу с подсветкой перекосов
			ВывестиЯчейку(Контекст, 2, "ФОТ на " + Уч.Ед + ", руб.", "РЖ", 4);
			Для Индекс = 0 По 11 Цикл
				Значение = Уч.ФОТнаЕд[Индекс];
				ОтклМесяца = ПроцентОт(Значение, Уч.ФОТнаЕдГод);
				Перекос = ОтклМесяца <> Неопределено И Макс(ОтклМесяца, -ОтклМесяца) >= А.ПорогИзменения;
				ВывестиЯчейку(Контекст, Контекст.КолонкаМесяцев + Индекс, Значение, "РЖ" + ?(Перекос, "!", ""));
			КонецЦикла;
			ВывестиЯчейку(Контекст, К, Уч.ФОТнаЕдГод, "РЖ");
			ВывестиЯчейку(Контекст, К + 1, Уч.ИзмФОТнаЕд, "Р%+");
			ВывестиЯчейку(Контекст, К + 2, "самый дешёвый месяц: " + Уч.ФОТнаЕдМин + "; самый дорогой: " + Уч.ФОТнаЕдМакс, "РС", Контекст.ПоследняяКолонка);
			НоваяСтрока(Контекст);
			ВывестиСтрокуПроцентов(Контекст, "   ФОТ на " + Уч.Ед + " к прошлому месяцу", Уч.ФОТнаЕдКПрошлому, Уч.ИзмФОТнаЕдКв,
				"за год — последний квартал к первому", А.ПорогИзменения);
			ВывестиСтрокуПроцентов(Контекст, "   ФОТ на " + Уч.Ед + " к среднему за год", Уч.ФОТнаЕдКСреднему, Неопределено,
				"оранжевым — отклонение больше порога", А.ПорогИзменения);
			ВывестиСтрокуПроцентов(Контекст, "   ФОТ к прошлому месяцу", Уч.ФОТКПрошлому, Уч.ИзмФОТ, "за год — 2-е полугодие к 1-му", 0);
			ВывестиСтрокуПроцентов(Контекст, "   выпуск к прошлому месяцу", Уч.ВыпускКПрошлому, Уч.ИзмВыпуска, "за год — 2-е полугодие к 1-му", 0);
		КонецЕсли;
		ВывестиСтрокуУчастка(Контекст, "Работников (по зарплате, с долей цеха)", Уч.Численность, Уч.ЧисленностьСредняя, Неопределено,
			"за год — в среднем в месяц; доля общих работников цеха — дробная", "1");
		Если СуммаМассива(Уч.ЛюдиПоДокументам) > 0 Тогда
			ВывестиСтрокуУчастка(Контекст, "Работников в документах производства участка", Уч.ЛюдиПоДокументам,
				ДелениеИлиНеопределено(СуммаМассива(Уч.ЛюдиПоДокументам), 12), Неопределено, "люди, указанные в рапортах/выработке участка", "1");
		КонецЕсли;
		ВывестиСтрокуУчастка(Контекст, "Средняя зарплата, руб.", Уч.СредняяЗП, Уч.СредняяЗПГод, Неопределено, "", "");
		Если Уч.ЕстьВыпуск Тогда
			ВывестиСтрокуУчастка(Контекст, "Выпуск на работника, " + Уч.Ед, Уч.Выработка, Уч.ВыработкаГод, Неопределено, "", "");
		КонецЕсли;
		ВывестиЯчейку(Контекст, 2, "Связь ФОТ с выпуском: " + Уч.ТекстСвязи + ". Источники выпуска: "
			+ ?(Уч.Источники.Количество() = 0, "нет", СтрокаКлючей(Уч.Источники)) + ".", "С");
		НоваяСтрока(Контекст);
		ВывестиЯчейку(Контекст, 2, "Зарплата из подразделений: " + ?(Уч.Способы.Количество() = 0, "не найдено ни одного",
			СтрокаКлючей(Уч.Способы)) + ".", "С");
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСтрокуУчастка(Контекст, Подпись, Значения, Итог, Изменение, Примечание, Оформление)

	ВывестиЯчейку(Контекст, 2, Подпись, "Р" + ?(СтрНайти(Оформление, "Ж") > 0, "Ж", ""), 4);
	Для Индекс = 0 По 11 Цикл
		ВывестиЯчейку(Контекст, Контекст.КолонкаМесяцев + Индекс, Значения[Индекс], "Р" + Оформление);
	КонецЦикла;
	К = Контекст.КолонкаПослеМесяцев;
	ВывестиЯчейку(Контекст, К, Итог, "Р" + Оформление);
	ВывестиЯчейку(Контекст, К + 1, Изменение, "Р%+");
	ВывестиЯчейку(Контекст, К + 2, Примечание, "РС", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

КонецПроцедуры

Процедура ВывестиСтрокуПроцентов(Контекст, Подпись, Значения, Итог, Примечание, ПорогПодсветки)

	ВывестиЯчейку(Контекст, 2, Подпись, "РС", 4);
	Для Индекс = 0 По 11 Цикл
		Значение = Значения[Индекс];
		Сильно = ПорогПодсветки > 0 И Значение <> Неопределено И Макс(Значение, -Значение) >= ПорогПодсветки;
		ВывестиЯчейку(Контекст, Контекст.КолонкаМесяцев + Индекс, Значение, "Р%+" + ?(Сильно, "!", ""));
	КонецЦикла;
	К = Контекст.КолонкаПослеМесяцев;
	ВывестиЯчейку(Контекст, К, Итог, "Р%+");
	ВывестиЯчейку(Контекст, К + 1, Неопределено, "Р");
	ВывестиЯчейку(Контекст, К + 2, Примечание, "РС", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

КонецПроцедуры

Функция СтрокаКлючей(Соответствие)

	Ключи = Новый Массив;
	Для Каждого КлючИЗначение Из Соответствие Цикл
		Ключи.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ", ");

КонецФункции

// Коэффициент корреляции по месяцам, где оба значения больше нуля (не меньше 4 месяцев).
Функция Корреляция(Х, У)

	ПарыХ = Новый Массив;
	ПарыУ = Новый Массив;
	Для Индекс = 0 По Х.Количество() - 1 Цикл
		Если Х[Индекс] > 0 И У[Индекс] > 0 Тогда
			ПарыХ.Добавить(Х[Индекс]);
			ПарыУ.Добавить(У[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Количество = ПарыХ.Количество();
	Если Количество < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СреднееХ = СуммаМассива(ПарыХ) / Количество;
	СреднееУ = СуммаМассива(ПарыУ) / Количество;
	Ковариация = 0;
	ДисперсияХ = 0;
	ДисперсияУ = 0;
	Для Индекс = 0 По Количество - 1 Цикл
		Ковариация = Ковариация + (ПарыХ[Индекс] - СреднееХ) * (ПарыУ[Индекс] - СреднееУ);
		ДисперсияХ = ДисперсияХ + (ПарыХ[Индекс] - СреднееХ) * (ПарыХ[Индекс] - СреднееХ);
		ДисперсияУ = ДисперсияУ + (ПарыУ[Индекс] - СреднееУ) * (ПарыУ[Индекс] - СреднееУ);
	КонецЦикла;
	Если ДисперсияХ = 0 Или ДисперсияУ = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ковариация / Sqrt(ДисперсияХ * ДисперсияУ);

КонецФункции

Функция ТекстСвязи(Связь)

	Если Связь = Неопределено Тогда
		Возврат "мало данных (нужно 4 месяца с выпуском и зарплатой)";
	ИначеЕсли Связь >= 0.7 Тогда
		Возврат "сильная (" + Формат(Связь, "ЧДЦ=2; ЧН=0") + ") — ФОТ следует за выпуском, оплата сдельная/от выработки";
	ИначеЕсли Связь >= 0.3 Тогда
		Возврат "средняя (" + Формат(Связь, "ЧДЦ=2; ЧН=0") + ") — часть ФОТ зависит от выпуска";
	ИначеЕсли Связь > -0.3 Тогда
		Возврат "слабая (" + Формат(Связь, "ЧДЦ=2; ЧН=0") + ") — ФОТ почти не зависит от выпуска (оклады, повременка)";
	КонецЕсли;
	Возврат "обратная (" + Формат(Связь, "ЧДЦ=2; ЧН=0") + ") — при росте выпуска ФОТ снижается: проверьте отнесение зарплаты и рапорты";

КонецФункции

Функция ДелениеИлиНеопределено(Числитель, Знаменатель)

	Если Знаменатель = Неопределено Или Знаменатель = 0 Или Числитель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Числитель / Знаменатель;

КонецФункции

// Отношение, только когда числитель и знаменатель больше нуля (иначе Неопределено, без деления на 0).
Функция ПоложительноеОтношение(Числитель, Знаменатель)

	Если Числитель = Неопределено Или Знаменатель = Неопределено Или Числитель <= 0 Или Знаменатель <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Числитель / Знаменатель;

КонецФункции

// Отклонение значения от среднего в процентах.
Функция ПроцентОт(Значение, Среднее)

	Если Значение = Неопределено Или Среднее = Неопределено Или Среднее = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат (Значение / Среднее - 1) * 100;

КонецФункции

// Для диагностики: выпуск и ФОТ по участкам за 12 месяцев, без фамилий.
Процедура ДобавитьДиагностикуУчастков(Строки, ДатаОкончания, Организация)

	Строки.Добавить("");
	Строки.Добавить("УЧАСТКИ ЗА 12 МЕСЯЦЕВ (выпуск из рапортов и ФОТ работников участков)");
	Попытка
		Данные = ДанныеУчастков(ДатаОкончания, Организация);
	Исключение
		Строки.Добавить("  ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Строки.Добавить("  Источники выпуска: " + ?(Данные.Источники.Количество() = 0, "не найдены", СтрСоединить(Данные.Источники, "; ")));
	Строки.Добавить("  Подразделение работников: " + Данные.ИсточникПодразделения);
	Строки.Добавить("  Работники закреплены по документам: " + ?(Данные.ИсточникиЗакрепления.Количество() = 0, "нет таких документов",
		СтрСоединить(Данные.ИсточникиЗакрепления, "; ")));
	Строки.Добавить("  участок | ед. | выпуск за год | ФОТ за год | работников (месяцев×чел.) | источники");
	Для Каждого КлючИЗначение Из Данные.Участки Цикл
		Уч = КлючИЗначение.Значение;
		Человекомесяцев = 0;
		Для Каждого Работники Из Уч.Работники Цикл
			Человекомесяцев = Человекомесяцев + Работники.Количество();
		КонецЦикла;
		Строки.Добавить("    " + Уч.Имя + " | " + Уч.Ед + ?(Уч.ПрочиеЕд = "", "", " (+" + Уч.ПрочиеЕд + ")") + " | "
			+ Формат(СуммаМассива(Уч.Выпуск), "ЧДЦ=1; ЧН=0; ЧГ=0") + " | " + Формат(СуммаМассива(Уч.ФОТ), "ЧДЦ=0; ЧН=0; ЧГ=0")
			+ " | " + Человекомесяцев + " | " + СтрокаКлючей(Уч.Источники));
		Строки.Добавить("      зарплата из: " + ?(Уч.Способы.Количество() = 0, "не сопоставлено", СтрокаКлючей(Уч.Способы)));
	КонецЦикла;
	Строки.Добавить("  Подразделения с зарплатой, не привязанные к участкам (подразделение | родители | справочник | ФОТ | работников):");
	Для Каждого КлючИЗначение Из Данные.Несопоставленные Цикл
		Запись = КлючИЗначение.Значение;
		Строки.Добавить("    " + Запись.Имя + " | " + Запись.Путь + " | " + Запись.Справочник + " | "
			+ Формат(Запись.ФОТ, "ЧДЦ=0; ЧН=0; ЧГ=0") + " | " + Запись.Работники.Количество());
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Вывод

Функция НовыйКонтекстВывода(ТД, Месяцы)

	КоличествоМесяцев = Месяцы.Количество();

	Контекст = Новый Структура;
	Контекст.Вставить("ТД", ТД);
	Контекст.Вставить("НомерСтроки", 1);
	Контекст.Вставить("Месяцы", Месяцы);
	Контекст.Вставить("КоличествоМесяцев", КоличествоМесяцев);

	// Раскладка колонок: 1 — №, 2 — сотрудник/показатель, 3 — подразделение, 4 — должность,
	// дальше месяцы и итоговые колонки.
	Контекст.Вставить("КолонкаМесяцев", 5);
	Контекст.Вставить("КолонкаПослеМесяцев", 5 + КоличествоМесяцев);
	Контекст.Вставить("ПоследняяКолонка", 5 + КоличествоМесяцев + 7);

	Контекст.Вставить("ТипЧисло", Новый ОписаниеТипов("Число"));
	Контекст.Вставить("Линия", Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1));
	Контекст.Вставить("ЦветШапки", Новый Цвет(221, 235, 247));
	Контекст.Вставить("ЦветИтога", Новый Цвет(242, 242, 242));
	Контекст.Вставить("ЦветРоста", Новый Цвет(0, 128, 0));
	Контекст.Вставить("ЦветСнижения", Новый Цвет(192, 0, 0));
	Контекст.Вставить("ЦветЗаголовка", Новый Цвет(31, 78, 121));
	Контекст.Вставить("ЦветПодсказки", Новый Цвет(110, 110, 110));
	Контекст.Вставить("ЦветПерекоса", Новый Цвет(252, 213, 180));

	Возврат Контекст;

КонецФункции

Процедура УстановитьШириныКолонок(Контекст)

	ТД = Контекст.ТД;
	ТД.Область(, 1, , 1).ШиринаКолонки = 5;
	ТД.Область(, 2, , 2).ШиринаКолонки = 34;
	ТД.Область(, 3, , 3).ШиринаКолонки = 24;
	ТД.Область(, 4, , 4).ШиринаКолонки = 22;
	Для НомерКолонки = Контекст.КолонкаМесяцев По Контекст.ПоследняяКолонка - 1 Цикл
		ТД.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = 14;
	КонецЦикла;
	ТД.Область(, Контекст.ПоследняяКолонка, , Контекст.ПоследняяКолонка).ШиринаКолонки = 70;

КонецПроцедуры

// Оформление — набор флагов:
//   Ж — жирный, Ш — шапка таблицы, И — строка итога, Р — рамка,
//   Ц — целое число, % — процент, + — окраска по знаку, П — перенос текста,
//   З — заголовок раздела, Т — заголовок отчета, С — серый текст.
Процедура ВывестиЯчейку(Контекст, НомерКолонки, Значение, Знач Оформление = "", ДоКолонки = 0)

	ТД = Контекст.ТД;
	НомерСтроки = Контекст.НомерСтроки;

	Если ДоКолонки > НомерКолонки Тогда
		Обл = ТД.Область(НомерСтроки, НомерКолонки, НомерСтроки, ДоКолонки);
		Обл.Объединить();
	Иначе
		Обл = ТД.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	КонецЕсли;

	ЭтоПроцент = СтрНайти(Оформление, "%") > 0;
	ПоЗнаку = СтрНайти(Оформление, "+") > 0;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если ЭтоПроцент Тогда
			Обл.Текст = ПредставлениеПроцента(Значение, ПоЗнаку);
		Иначе
			Обл.СодержитЗначение = Истина;
			Обл.ТипЗначения = Контекст.ТипЧисло;
			Обл.Значение = Значение;
			Обл.Формат = ?(СтрНайти(Оформление, "Ц") > 0, "ЧДЦ=0; ЧН=0", ?(СтрНайти(Оформление, "1") > 0, "ЧДЦ=1; ЧН=-", "ЧДЦ=2; ЧН=-"));
		КонецЕсли;
		Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		Если ПоЗнаку И Значение > 0 Тогда
			Обл.ЦветТекста = Контекст.ЦветРоста;
		ИначеЕсли ПоЗнаку И Значение < 0 Тогда
			Обл.ЦветТекста = Контекст.ЦветСнижения;
		КонецЕсли;
	ИначеЕсли Значение = Неопределено Тогда
		Если ЭтоПроцент Или СтрНайти(Оформление, "Ц") > 0 Тогда
			Обл.Текст = "—";
			Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		КонецЕсли;
	Иначе
		Обл.Текст = Строка(Значение);
	КонецЕсли;

	Если СтрНайти(Оформление, "Т") > 0 Тогда
		Обл.Шрифт = Новый Шрифт(Обл.Шрифт, , 14, Истина);
		Обл.ЦветТекста = Контекст.ЦветЗаголовка;
	ИначеЕсли СтрНайти(Оформление, "З") > 0 Тогда
		Обл.Шрифт = Новый Шрифт(Обл.Шрифт, , 11, Истина);
		Обл.ЦветТекста = Контекст.ЦветЗаголовка;
	ИначеЕсли СтрНайти(Оформление, "Ж") > 0 Или СтрНайти(Оформление, "Ш") > 0 Или СтрНайти(Оформление, "И") > 0 Тогда
		Обл.Шрифт = Новый Шрифт(Обл.Шрифт, , , Истина);
	КонецЕсли;

	Если СтрНайти(Оформление, "Ш") > 0 Тогда
		Обл.ЦветФона = Контекст.ЦветШапки;
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Обл.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	ИначеЕсли СтрНайти(Оформление, "И") > 0 Тогда
		Обл.ЦветФона = Контекст.ЦветИтога;
	КонецЕсли;

	Если СтрНайти(Оформление, "П") > 0 Тогда
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Обл.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	КонецЕсли;
	Если СтрНайти(Оформление, "С") > 0 Тогда
		Обл.ЦветТекста = Контекст.ЦветПодсказки;
	КонецЕсли;
	Если СтрНайти(Оформление, "!") > 0 Тогда
		Обл.ЦветФона = Контекст.ЦветПерекоса;
	КонецЕсли;
	Если СтрНайти(Оформление, "Р") > 0 Или СтрНайти(Оформление, "Ш") > 0 Или СтрНайти(Оформление, "И") > 0 Тогда
		Обл.Обвести(Контекст.Линия, Контекст.Линия, Контекст.Линия, Контекст.Линия);
	КонецЕсли;

КонецПроцедуры

Процедура НоваяСтрока(Контекст, Количество = 1)

	Контекст.НомерСтроки = Контекст.НомерСтроки + Количество;

КонецПроцедуры

Процедура УстановитьВысотуСтроки(Контекст, Высота)

	Контекст.ТД.Область(Контекст.НомерСтроки, , Контекст.НомерСтроки).ВысотаСтроки = Высота;

КонецПроцедуры

Процедура ВывестиЗаголовокРаздела(Контекст, Текст, Пояснение = "")

	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, Текст, "З");
	НоваяСтрока(Контекст);
	Если Пояснение <> "" Тогда
		ВывестиЯчейку(Контекст, 1, Пояснение, "С");
		НоваяСтрока(Контекст);
	КонецЕсли;

КонецПроцедуры

// Шапка таблиц-сводок: показатель в колонках 2–4, месяцы, затем дополнительные колонки.
Процедура ВывестиШапкуСводки(Контекст, ЗаголовокПоказателя, ДополнительныеКолонки, ВключатьНомер = Ложь)

	УстановитьВысотуСтроки(Контекст, 30);
	Если ВключатьНомер Тогда
		ВывестиЯчейку(Контекст, 1, "№", "Ш");
	КонецЕсли;
	ВывестиЯчейку(Контекст, 2, ЗаголовокПоказателя, "Ш", 4);
	ВывестиШапкуМесяцев(Контекст, ДополнительныеКолонки);
	НоваяСтрока(Контекст);

КонецПроцедуры

Процедура ВывестиШапкуМесяцев(Контекст, ДополнительныеКолонки)

	НомерКолонки = Контекст.КолонкаМесяцев;
	Для Каждого ТекМесяц Из Контекст.Месяцы Цикл
		ВывестиЯчейку(Контекст, НомерКолонки, ИмяМесяца(ТекМесяц, Истина), "Ш");
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	Для Каждого Заголовок Из ДополнительныеКолонки Цикл
		ВывестиЯчейку(Контекст, НомерКолонки, Заголовок, "Ш");
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСуммыПоМесяцам(Контекст, Суммы, Оформление = "Р")

	НомерКолонки = Контекст.КолонкаМесяцев;
	Для Каждого Значение Из Суммы Цикл
		ВывестиЯчейку(Контекст, НомерКолонки, Значение, Оформление);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиЗаголовокОтчета(Контекст, НачалоПериода, КонецПериода, Организация, Данные, ПорогИзменения, МРОТ)

	ВывестиЯчейку(Контекст, 1, "Анализ заработной платы сотрудников", "Т");
	УстановитьВысотуСтроки(Контекст, 22);
	НоваяСтрока(Контекст);

	ВывестиЯчейку(Контекст, 1, "Период: " + ИмяМесяца(НачалоПериода) + " — " + ИмяМесяца(КонецПериода)
		+ " (" + Контекст.КоличествоМесяцев + " мес.)", "Ж");
	НоваяСтрока(Контекст);
	ВывестиЯчейку(Контекст, 1, "Организация: " + ?(ЗначениеЗаполнено(Организация), Строка(Организация), "все организации"));
	НоваяСтрока(Контекст);

	Пояснение = "Источник: регистр ""Начисления и удержания по сотрудникам"", по месяцу регистрации. "
		+ ?(Данные.ПолеСотрудника = "ФизическоеЛицо", "Совместительства объединены по физлицам. ", "")
		+ "Порог отклонений: " + Формат(ПорогИзменения, "ЧДЦ=1; ЧН=0") + "%"
		+ ?(МРОТ > 0, ", МРОТ: " + ФорматСуммы(МРОТ) + " руб.", "") + ". "
		+ "Сформирован: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + ". Версия обработки " + ВерсияОбработки() + ".";
	ВывестиЯчейку(Контекст, 1, Пояснение, "С");
	НоваяСтрока(Контекст);

	Если Не Данные.ЕстьГруппа Тогда
		ВывестиЯчейку(Контекст, 1, "В регистре нет группы начисления/удержания — тип строк определен по виду расчета.", "С");
		НоваяСтрока(Контекст);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиВыводы(Контекст, А)

	ВывестиЗаголовокРаздела(Контекст, "Ключевые выводы");
	Для Каждого Вывод Из А.Выводы Цикл
		ВывестиЯчейку(Контекст, 1, "•", "");
		ВывестиЯчейку(Контекст, 2, Вывод, "");
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСводкуПоМесяцам(Контекст, А)

	ВывестиЗаголовокРаздела(Контекст, "Сводка по месяцам",
		"Средняя, медиана, минимум и максимум — по сотрудникам, у которых в месяце есть начисления.");

	Доп = Новый Массив;
	Доп.Добавить("Итого / среднее");
	Доп.Добавить("Изменение");
	ВывестиШапкуСводки(Контекст, "Показатель", Доп);

	КоличествоМесяцев = А.КоличествоМесяцев;
	Последний = КоличествоМесяцев - 1;
	СуммаЧисленности = СуммаМассива(А.Численность);

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Начислено (ФОТ)", А.ФОТ, СуммаМассива(А.ФОТ), "Ж"));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Сотрудников с начислениями", А.Численность,
		СуммаЧисленности / КоличествоМесяцев, "Ц"));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Средняя начисленная", А.Средняя,
		?(СуммаЧисленности > 0, А.ИтогоФОТ / СуммаЧисленности, 0), ""));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Медиана", А.Медианы, Неопределено, ""));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Минимальная", А.Минимумы, Неопределено, ""));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Максимальная", А.Максимумы, Неопределено, ""));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "НДФЛ", А.НДФЛ, СуммаМассива(А.НДФЛ), ""));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "Удержано", А.Удержано, СуммаМассива(А.Удержано), ""));
	Строки.Добавить(Новый Структура("Имя, Значения, Итог, Оформление", "К выплате (начислено − НДФЛ − удержания)",
		А.КВыплате, СуммаМассива(А.КВыплате), "Ж"));

	Для Каждого Описание Из Строки Цикл
		ЭтоЦелое = СтрНайти(Описание.Оформление, "Ц") > 0;
		ОформлениеЧисел = "Р" + ?(ЭтоЦелое, "Ц", "");
		ОформлениеИмени = "Р" + ?(СтрНайти(Описание.Оформление, "Ж") > 0, "Ж", "");
		ВывестиЯчейку(Контекст, 2, Описание.Имя, ОформлениеИмени, 4);
		ВывестиСуммыПоМесяцам(Контекст, Описание.Значения, ОформлениеЧисел);
		ИтогЗначение = Описание.Итог;
		Если ЭтоЦелое И ИтогЗначение <> Неопределено Тогда
			ИтогЗначение = Окр(ИтогЗначение, 1);
			ОформлениеИтога = "Р";
		Иначе
			ОформлениеИтога = ОформлениеЧисел;
		КонецЕсли;
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев, ИтогЗначение, ОформлениеИтога + "Ж");
		Изменение = ?(КоличествоМесяцев > 1, ПроцентИзменения(Описание.Значения[0], Описание.Значения[Последний]), Неопределено);
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 1, Изменение, "Р%+");
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСтруктуруФОТ(Контекст, А)

	ВывестиЗаголовокРаздела(Контекст, "Структура начислений",
		"Категории определены по наименованию вида начисления. Состав каждой категории — в последнем разделе.");

	Доп = Новый Массив;
	Доп.Добавить("Итого");
	Доп.Добавить("Доля");
	Доп.Добавить("Изменение");
	ВывестиШапкуСводки(Контекст, "Категория", Доп);

	Последний = А.КоличествоМесяцев - 1;
	Для Каждого Категория Из ПорядокКатегорий() Цикл
		Суммы = А.Категории[Категория];
		Итого = СуммаМассива(Суммы);
		Если Итого = 0 И МаксимумМассива(Суммы) = 0 Тогда
			Продолжить;
		КонецЕсли;
		ВывестиЯчейку(Контекст, 2, Категория, "Р", 4);
		ВывестиСуммыПоМесяцам(Контекст, Суммы);
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев, Итого, "РЖ");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 1, ?(А.ИтогоФОТ <> 0, Итого / А.ИтогоФОТ * 100, Неопределено), "Р%");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 2,
			?(А.КоличествоМесяцев > 1, ПроцентИзменения(Суммы[0], Суммы[Последний]), Неопределено), "Р%+");
		НоваяСтрока(Контекст);
	КонецЦикла;

	ВывестиЯчейку(Контекст, 2, "Итого", "И", 4);
	ВывестиСуммыПоМесяцам(Контекст, А.ФОТ, "И");
	ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев, А.ИтогоФОТ, "И");
	ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 1, 100, "И%");
	ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 2,
		?(А.КоличествоМесяцев > 1, ПроцентИзменения(А.ФОТ[0], А.ФОТ[Последний]), Неопределено), "И%+");
	НоваяСтрока(Контекст);

КонецПроцедуры

Процедура ВывестиПоПодразделениям(Контекст, А)

	Если А.Подразделения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВывестиЗаголовокРаздела(Контекст, "По подразделениям",
		"Подразделение на конец периода (" + А.ИсточникПодразделения + "). Средняя — на одного сотрудника с начислениями в месяц.");

	Доп = Новый Массив;
	Доп.Добавить("Итого");
	Доп.Добавить("Доля");
	Доп.Добавить("Сотрудников");
	Доп.Добавить("Средняя в месяц");
	Доп.Добавить("Изменение");
	ВывестиШапкуСводки(Контекст, "Подразделение", Доп);

	Последний = А.КоличествоМесяцев - 1;
	Для Каждого СтрокаПодр Из А.Подразделения Цикл
		СуммаЧисленности = СуммаМассива(СтрокаПодр.Численность);
		ВывестиЯчейку(Контекст, 2, СтрокаПодр.Подразделение, "Р", 4);
		ВывестиСуммыПоМесяцам(Контекст, СтрокаПодр.Суммы);
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев, СтрокаПодр.Итого, "РЖ");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 1,
			?(А.ИтогоФОТ <> 0, СтрокаПодр.Итого / А.ИтогоФОТ * 100, Неопределено), "Р%");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 2, СтрокаПодр.Сотрудников, "РЦ");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 3,
			?(СуммаЧисленности > 0, СтрокаПодр.Итого / СуммаЧисленности, 0), "Р");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 4,
			?(А.КоличествоМесяцев > 1, ПроцентИзменения(СтрокаПодр.Суммы[0], СтрокаПодр.Суммы[Последний]), Неопределено), "Р%+");
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиТребующихВнимания(Контекст, А)

	Отобранные = Новый Массив;
	Для Каждого Сотр Из А.Сотрудники Цикл
		Если Сотр.Отметки.Количество() > 0 Тогда
			Отобранные.Добавить(Сотр);
		КонецЕсли;
	КонецЦикла;

	ВывестиЗаголовокРаздела(Контекст, "Сотрудники, требующие внимания (" + Отобранные.Количество() + ")",
		"Отметки — повод проверить начисления, а не ошибка: прием, увольнение, отпуск и премии дают такие же отклонения.");
	Если Отобранные.Количество() = 0 Тогда
		ВывестиЯчейку(Контекст, 2, "Отклонений не найдено.");
		НоваяСтрока(Контекст);
		Возврат;
	КонецЕсли;

	УстановитьВысотуСтроки(Контекст, 30);
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, "Сотрудник", "Ш");
	ВывестиЯчейку(Контекст, 3, "Подразделение", "Ш");
	ВывестиЯчейку(Контекст, 4, "Должность", "Ш");
	ВывестиШапкуМесяцев(Контекст, СтрРазделить("Итого,Изменение", ","));
	ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 2, "Что проверить", "Ш", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);

	Номер = 0;
	Для Каждого Сотр Из Отобранные Цикл
		Номер = Номер + 1;
		ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
		ВывестиЯчейку(Контекст, 2, Сотр.Представление, "РП");
		ВывестиЯчейку(Контекст, 3, Сотр.Подразделение, "РП");
		ВывестиЯчейку(Контекст, 4, Сотр.Должность, "РП");
		ВывестиСуммыПоМесяцам(Контекст, Сотр.Начислено);
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев, Сотр.Итого, "РЖ");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 1, Сотр.Изменение, "Р%+");
		ВывестиЯчейку(Контекст, Контекст.КолонкаПослеМесяцев + 2, СтрСоединить(Сотр.Отметки, "; "), "РП", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиДеталиПоСотрудникам(Контекст, А)

	ВывестиЗаголовокРаздела(Контекст, "Начисления по сотрудникам (" + А.Сотрудники.Количество() + ")",
		"Сортировка по сумме начислений за период. Среднее — по месяцам, в которых были начисления; изменение — последний месяц к первому.");

	УстановитьВысотуСтроки(Контекст, 30);
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, "Сотрудник", "Ш");
	ВывестиЯчейку(Контекст, 3, "Подразделение", "Ш");
	ВывестиЯчейку(Контекст, 4, "Должность", "Ш");
	ВывестиШапкуМесяцев(Контекст, СтрРазделить("Итого начислено,Среднее в месяц,Изменение,Доля премий,НДФЛ,Удержано,К выплате", ","));
	ВывестиЯчейку(Контекст, Контекст.ПоследняяКолонка, "Отметки", "Ш");
	НоваяСтрока(Контекст);

	К = Контекст.КолонкаПослеМесяцев;
	Номер = 0;
	Для Каждого Сотр Из А.Сотрудники Цикл
		Номер = Номер + 1;
		ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
		ВывестиЯчейку(Контекст, 2, Сотр.Представление, "Р");
		ВывестиЯчейку(Контекст, 3, Сотр.Подразделение, "Р");
		ВывестиЯчейку(Контекст, 4, Сотр.Должность, "Р");
		ВывестиСуммыПоМесяцам(Контекст, Сотр.Начислено);
		ВывестиЯчейку(Контекст, К, Сотр.Итого, "РЖ");
		ВывестиЯчейку(Контекст, К + 1, Сотр.СреднееЗаМесяц, "Р");
		ВывестиЯчейку(Контекст, К + 2, Сотр.Изменение, "Р%+");
		ВывестиЯчейку(Контекст, К + 3, ?(Сотр.Итого > 0, Сотр.ДоляПремий, Неопределено), "Р%");
		ВывестиЯчейку(Контекст, К + 4, Сотр.ИтогоНДФЛ, "Р");
		ВывестиЯчейку(Контекст, К + 5, Сотр.ИтогоУдержано, "Р");
		ВывестиЯчейку(Контекст, К + 6, Сотр.КВыплате, "Р");
		ВывестиЯчейку(Контекст, Контекст.ПоследняяКолонка, СтрСоединить(Сотр.Отметки, "; "), "Р");
		НоваяСтрока(Контекст);
	КонецЦикла;

	Последний = А.КоличествоМесяцев - 1;
	СуммаЧисленности = СуммаМассива(А.Численность);
	ВывестиЯчейку(Контекст, 1, "", "И");
	ВывестиЯчейку(Контекст, 2, "Итого", "И", 4);
	ВывестиСуммыПоМесяцам(Контекст, А.ФОТ, "И");
	ВывестиЯчейку(Контекст, К, А.ИтогоФОТ, "И");
	ВывестиЯчейку(Контекст, К + 1, ?(СуммаЧисленности > 0, А.ИтогоФОТ / СуммаЧисленности, 0), "И");
	ВывестиЯчейку(Контекст, К + 2, ?(А.КоличествоМесяцев > 1, ПроцентИзменения(А.ФОТ[0], А.ФОТ[Последний]), Неопределено), "И%+");
	ВывестиЯчейку(Контекст, К + 3, Неопределено, "И");
	ВывестиЯчейку(Контекст, К + 4, СуммаМассива(А.НДФЛ), "И");
	ВывестиЯчейку(Контекст, К + 5, СуммаМассива(А.Удержано), "И");
	ВывестиЯчейку(Контекст, К + 6, СуммаМассива(А.КВыплате), "И");
	ВывестиЯчейку(Контекст, Контекст.ПоследняяКолонка, "", "И");
	НоваяСтрока(Контекст);

