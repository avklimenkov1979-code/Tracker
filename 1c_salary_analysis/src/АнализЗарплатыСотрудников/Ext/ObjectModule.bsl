Функция СуммаМассива(Значения)

	Результат = 0;
	Для Каждого Значение Из Значения Цикл
		Результат = Результат + Значение;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МинимумМассива(Значения)

	Если Значения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Результат = Значения[0];
	Для Каждого Значение Из Значения Цикл
		Результат = Мин(Результат, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МаксимумМассива(Значения)

	Если Значения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Результат = Значения[0];
	Для Каждого Значение Из Значения Цикл
		Результат = Макс(Результат, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Медиана(Значения)

	Количество = Значения.Количество();
	Если Количество = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Значения);
	Список.СортироватьПоЗначению();
	Если Количество % 2 = 1 Тогда
		Возврат Список[(Количество - 1) / 2].Значение;
	КонецЕсли;
	Возврат (Список[Количество / 2 - 1].Значение + Список[Количество / 2].Значение) / 2;

КонецФункции

// Коэффициент вариации в процентах; Неопределено, если значений меньше двух.
Функция КоэффициентВариации(Значения)

	Количество = Значения.Количество();
	Если Количество < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Среднее = СуммаМассива(Значения) / Количество;
	Если Среднее <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СуммаКвадратов = 0;
	Для Каждого Значение Из Значения Цикл
		СуммаКвадратов = СуммаКвадратов + (Значение - Среднее) * (Значение - Среднее);
	КонецЦикла;
	Возврат Sqrt(СуммаКвадратов / Количество) / Среднее * 100;

КонецФункции

Функция ПроцентИзменения(Было, Стало)

	Если Было = Неопределено Или Стало = Неопределено Или Было <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат (Стало - Было) / Было * 100;

КонецФункции

Функция ПредставлениеПроцента(Значение, СоЗнаком = Ложь)

	Если Значение = Неопределено Тогда
		Возврат "—";
	КонецЕсли;
	Возврат ?(СоЗнаком И Значение > 0, "+", "") + Формат(Значение, "ЧДЦ=1; ЧН=0") + "%";

КонецФункции

