Процедура ВывестиНесопоставленные(Контекст, Данные)

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Запись");
	Т.Колонки.Добавить("ФОТ");
	Всего = 0;
	Для Каждого КлючИЗначение Из Данные.Несопоставленные Цикл
		СтрокаТ = Т.Добавить();
		СтрокаТ.Запись = КлючИЗначение.Значение;
		СтрокаТ.ФОТ = КлючИЗначение.Значение.ФОТ;
		Всего = Всего + СтрокаТ.ФОТ;
	КонецЦикла;
	Т.Сортировать("ФОТ Убыв");
	ВывестиЗаголовокРаздела(Контекст, "Подразделения с зарплатой, не привязанные к участкам (" + Т.Количество()
		+ ", ФОТ " + ФорматСуммы(Всего) + " руб.)",
		"Офис и службы здесь — нормально. Если здесь производственный участок или цех, его название в кадровом учёте "
		+ "не совпадает с подразделением в рапортах: пришлите «Диагностику» или названия обоих — добавлю сопоставление.");
	Если Т.Количество() = 0 Тогда
		ВывестиЯчейку(Контекст, 2, "Нет: вся зарплата привязана к участкам.", "С");
		НоваяСтрока(Контекст);
		Возврат;
	КонецЕсли;
	К = Контекст.КолонкаМесяцев;
	УстановитьВысотуСтроки(Контекст, 30);
	ВывестиЯчейку(Контекст, 1, "№", "Ш");
	ВывестиЯчейку(Контекст, 2, "Подразделение (из зарплаты)", "Ш", 4);
	ВывестиЯчейку(Контекст, К, "ФОТ за год", "Ш");
	ВывестиЯчейку(Контекст, К + 1, "Работников", "Ш");
	ВывестиЯчейку(Контекст, К + 2, "Где в структуре (родители), справочник", "Ш", Контекст.ПоследняяКолонка);
	НоваяСтрока(Контекст);
	Номер = 0;
	Для Каждого СтрокаТ Из Т Цикл
		Номер = Номер + 1;
		Если Номер > 30 Тогда
			ВывестиЯчейку(Контекст, 2, "… и ещё " + (Т.Количество() - 30) + " подразделений", "С", 4);
			НоваяСтрока(Контекст);
			Прервать;
		КонецЕсли;
		Запись = СтрокаТ.Запись;
		ВывестиЯчейку(Контекст, 1, Номер, "РЦ");
		ВывестиЯчейку(Контекст, 2, Запись.Имя, "Р", 4);
		ВывестиЯчейку(Контекст, К, Запись.ФОТ, "Р");
		ВывестиЯчейку(Контекст, К + 1, Запись.Работники.Количество(), "РЦ");
		ВывестиЯчейку(Контекст, К + 2, ?(Запись.Путь = "", "—", Запись.Путь) + ?(Запись.Справочник = "", "", " · " + Запись.Справочник),
			"Р", Контекст.ПоследняяКолонка);
		НоваяСтрока(Контекст);
	КонецЦикла;

